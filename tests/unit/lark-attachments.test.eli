(module dj.tests.unit.lark-attachments
  (import "../../src/core/native.eli" nativeGet)
  (import "../../packages/lark/src/messages.eli" parseLarkMessage)
  (import "../../packages/lark/src/resources.eli" officeResourceLink messageResourcePath)
  (import "../../src/attachments/notification.eli" notificationBody codexAttachmentInputs imageDimensions)
  (import "../../src/adapters/agent/desktop.eli" codexInputRequest)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)

  (withUnitCase "T40.lark-attachments.unit" (async (unused)
    (let* ((parsed (parseLarkMessage "post" (JSON/stringify (js-object :en_us (js-object :content
      (js-array (js-array (js-object :tag "text" :text "🎺 ")
        (js-object :tag "a" :text "Read" :href "https://demo.larksuite.com/docx/doc_example#中文")
        (js-object :tag "media" :file_key "file_video" :image_key "img_cover"))))))))
      (resources (nativeGet parsed "resources"))
      (body (notificationBody (nativeGet parsed "text") (nativeGet parsed "links") resources))
      (path (str (js-call globalThis.process :cwd) "/test-image.png"))
      (image (js-object :kind "image" :mime_type "image/png" :size_bytes 128 :state "ready" :local_path path))
      (unread (Object/assign (js-object) image (js-object :state "unavailable")))
      (pdf (Object/assign (js-object) image (js-object :kind "document" :mime_type "application/pdf")))
      (native (codexAttachmentInputs (js-array image unread pdf))))
      (js-call (expect (nativeGet parsed "text")) :toBe "🎺 Read[media]")
      (js-call (expect body) :toBe "🎺 [Read](<https://demo.larksuite.com/docx/doc_example#%E4%B8%AD%E6%96%87>)[附件 1] [附件 2]")
      (js-call (expect (nativeGet (aref resources 0) "resource_type")) :toBe "file")
      (js-call (expect (nativeGet (aref resources 1) "resource_type")) :toBe "image")
      (js-call (expect (officeResourceLink "lark" "https://demo.larksuite.com.example.org/docx/doc_example")) :toBe nil)
      (js-call (expect (lambda () (messageResourcePath "om_message" "../private" "file"))) :toThrow)
      (js-call (expect (js-length native)) :toBe 1)
      (js-call (expect (imageDimensions (Buffer/from "GIF89a0000"))) :toEqual
        (js-object :width 12336 :height 12336))
      (let* ((request (codexInputRequest "thread-example" body t "client-example" native))
             (input (nativeGet (nativeGet request "parameters") "input")))
        (js-call (expect (aref input 1)) :toEqual (js-object :type "localImage" :path path)))))))
