(module dj.tests.unit.lark-acceptance
  (import "../../src/core/native.eli" nativeGet)
  (import "../../tools/lark-acceptance.eli" validateLarkRequest validateLarkBinding executeLarkAcceptance)
  (import "../support/lark-acceptance.eli" larkTestBinding larkTestRequest createLarkAcceptanceFixture)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.lark-acceptance.unit" (async (unused)
    (let* ((binding (larkTestBinding)) (request (larkTestRequest "stimulus-lark"))
           (runtime (createLarkAcceptanceFixture request)))
      (js-call (expect (Object/isFrozen (validateLarkBinding binding))) :toBe t)
      (let ((bad (Object/assign (js-object) binding (js-object :authorized false))))
        (js-call (expect (lambda () (validateLarkBinding bad))) :toThrow))
      (let ((bad (Object/assign (js-object) request (js-object :operation "unapproved"))))
        (js-call (expect (lambda () (validateLarkRequest bad))) :toThrow))
      (js-call (expect (nativeGet (await (executeLarkAcceptance request binding runtime)) "ok")) :toBe t)
      (await (executeLarkAcceptance request binding runtime))
      (js-call (expect (nativeGet (nativeGet (nativeGet runtime "state") "writes") "length")) :toBe 1)
      (let* ((bad (createLarkAcceptanceFixture request "bad-user")) (failed false))
        (try (await (executeLarkAcceptance request binding bad)) (catch error (setq failed t)))
        (js-call (expect failed) :toBe t)
        (js-call (expect (nativeGet (nativeGet (nativeGet bad "state") "writes") "length")) :toBe 0))
      (let* ((broken (createLarkAcceptanceFixture request "write-error")) (failed false))
        (try (await (executeLarkAcceptance request binding broken)) (catch error (setq failed t)))
        (js-call (expect failed) :toBe t)
        (try (await (executeLarkAcceptance request binding broken)) (catch error nil))
        (js-call (expect (nativeGet (nativeGet (nativeGet broken "state") "writes") "length")) :toBe 1))
      (js-call (expect (nativeGet (await (executeLarkAcceptance (larkTestRequest "observe-reply-lark") binding
        (createLarkAcceptanceFixture (larkTestRequest "observe-reply-lark")))) "ok")) :toBe t))))
)
