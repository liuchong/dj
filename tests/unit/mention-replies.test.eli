(module dj.tests.unit.mention-replies
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connections/replies.eli" normalizeReplyRoutes selectReplyRoute)
  (import "../../src/core/rules.eli" validatePredicate evaluatePredicate)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.mention-replies.unit" (async (unused)
    (let* ((source (js-object :connection_id "source" :platform "lark" :brand "lark" :tenant_ref "one" :identity "bot" :identity_revision 1))
      (user (Object/assign (js-object) source (js-object :connection_id "user" :identity "user")))
      (policy (js-object))
      (context (js-object :repository (js-object :get (lambda (table key)
        (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user))))))
      (route (js-object :source_connection_id "source" :mention_id "native-human" :reply_connection_id "user"))
      (event (js-object :connection_id "source" :identity_revision 1 :conversation (js-object :connection_id "source" :native_chat_id "chat")
        :mentions (js-array (js-object :id "native-human"))))
      (predicate (js-object :field "mentions.id" :op "in" :value (js-array "native-human" "native-bot"))))
      (js-call (expect (nativeGet (validatePredicate predicate) "ok")) :toBe t)
      (js-call (expect (evaluatePredicate predicate event)) :toBe "true")
      (js-call (expect (evaluatePredicate predicate (js-object :mentions (js-array) :content (js-object :text "@native-human")))) :toBe "false")
      (js-call (expect (evaluatePredicate predicate (js-object))) :toBe "indeterminate")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route route)) "ok")) :toBe false)
      (js-call (expect (nativeGet (normalizeReplyRoutes context nil) "ok")) :toBe false)
      (let ((sparse (new globalThis.Array 2)))
        (put sparse 0 route)
        (js-call (expect (nativeGet (normalizeReplyRoutes context sparse) "ok")) :toBe false))
      (put user :tenant_ref "other")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route)) "ok")) :toBe false)
      (put user :tenant_ref "one")
      (put policy :reply_routes (nativeGet (normalizeReplyRoutes context (js-array route)) "data"))
      (let ((chosen (selectReplyRoute context event "target")))
        (js-call (expect (nativeGet chosen "identity")) :toBe "user")
        (js-call (expect (nativeGet (nativeGet chosen "destination") "native_chat_id")) :toBe "chat"))
      (put user :identity_revision 2)
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "status")) :toBe "stale_reference")
      (put user :identity_revision 1)
      (put event :mentions (js-array (js-object :id "native-bot")))
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "connection_id")) :toBe "source"))))
)
