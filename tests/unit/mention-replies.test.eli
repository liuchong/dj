(module dj.tests.unit.mention-replies
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connections/replies.eli" normalizeReplyRoutes selectReplyRoute)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../../src/core/rules.eli" validatePredicate evaluatePredicate)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.mention-replies.unit" (async (unused)
    (let* ((source (js-object :connection_id "source" :platform "lark" :brand "lark" :tenant_ref "one" :identity "bot" :identity_revision 1))
      (user (Object/assign (js-object) source (js-object :connection_id "user" :identity "user")))
      (policy (js-object))
      (context (js-object :repository (js-object :get (lambda (table key)
        (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user))))))
      (route (js-object :source_connection_id "source" :mention_id "native-human" :reply_connection_id "user"))
      (event (js-object :connection_id "source" :identity_revision 1 :conversation (js-object :connection_id "source" :native_chat_id "chat")
        :mentions (js-array (js-object :id "native-human"))))
      (predicate (js-object :field "mentions.id" :op "in" :value (js-array "native-human" "native-bot"))))
      (js-call (expect (nativeGet (validatePredicate predicate) "ok")) :toBe t)
      (js-call (expect (evaluatePredicate predicate event)) :toBe "true")
      (js-call (expect (evaluatePredicate predicate (js-object :mentions (js-array) :content (js-object :text "@native-human")))) :toBe "false")
      (js-call (expect (evaluatePredicate predicate (js-object))) :toBe "indeterminate")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route route)) "ok")) :toBe false)
      (js-call (expect (nativeGet (normalizeReplyRoutes context nil) "ok")) :toBe false)
      (let ((sparse (new globalThis.Array 2)))
        (put sparse 0 route)
        (js-call (expect (nativeGet (normalizeReplyRoutes context sparse) "ok")) :toBe false))
      (put user :tenant_ref "other")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route)) "ok")) :toBe false)
      (put user :tenant_ref "one")
      (put policy :reply_routes (nativeGet (normalizeReplyRoutes context (js-array route)) "data"))
      (let ((chosen (selectReplyRoute context event "target")))
        (js-call (expect (nativeGet chosen "identity")) :toBe "user")
        (js-call (expect (nativeGet (nativeGet chosen "destination") "native_chat_id")) :toBe "chat"))
      (put user :identity_revision 2)
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "status")) :toBe "stale_reference")
      (put user :identity_revision 1)
      (put event :mentions (js-array (js-object :id "native-bot")))
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "status")) :toBe "unmapped_target"))))
  (withUnitCase "T38.reply-identity-evidence.unit" (async ()
    (let* ((source (js-object :connection_id "source" :platform "lark" :brand "lark" :identity "bot"
        :identity_revision 1 :event_app_id "source-app" :event_subject_id "native-bot"))
      (user (js-object :connection_id "user" :platform "lark" :brand "lark" :identity "user" :identity_revision 1))
      (policy (js-object :reply_routes (js-array)))
      (context (js-object :repository (js-object :get (lambda (table key)
        (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user))))))
      (event (js-object :connection_id "source" :identity_revision 1 :event_kind "message.created"
        :conversation (js-object :connection_id "source" :native_chat_id "chat")
        :mentions (js-array (js-object :id "native-bot" :name "same-name")))))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put event :mentions (js-array (js-object :id "unknown" :name "same-name")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "unmapped_target")
      (put policy :reply_routes (nativeGet (normalizeReplyRoutes context (js-array
        (js-object :source_connection_id "source" :mention_id "native-human" :reply_connection_id "user"))) "data"))
      (put event :mentions (js-array (js-object :id "native-bot") (js-object :id "native-human")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "ambiguous_target")
      (put event :mentions (js-array))
      (put event :interaction (js-object :state "resolved" :target_id "native-human" :target_message_id "parent"))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "user")
      (put event :mentions (js-array (js-object :id "native-bot")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put event :mentions (js-array)) (put event :chat_type "p2p")
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put source :identity_revision 2)
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "stale_reference")
      (put source :identity_revision 1)
      (let* ((flat (flattenLarkEvent (js-object :header (js-object :event_type "im.message.receive_v1" :app_id "source-app")
        :event (js-object :sender (js-object :sender_id (js-object :open_id "human") :sender_type "user")
          :message (js-object :message_id "message" :chat_id "chat" :chat_type "group" :message_type "text"
            :create_time "1767225600000" :content "{\"text\":\"@_user_1 hello\"}"
            :mentions (js-array (js-object :id (js-object :open_id "native-bot") :name "same-name" :key "@_user_1")))))))
        (normalized (normalizeLarkEvent source flat)))
        (js-call (expect (nativeGet (aref (nativeGet normalized "mentions") 0) "key")) :toBe "@_user_1")))))
)
