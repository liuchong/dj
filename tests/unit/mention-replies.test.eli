(module dj.tests.unit.mention-replies
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/messaging/reply-context.eli" resolveReply)
  (import "../../src/policy/handles.eli" createHandleAuthority issueHandle)
  (import "../../src/connections/replies.eli" normalizeReplyRoutes)
  (import "../../src/dispatch/events.eli" equivalentEventKinds eventIdentity)
  (import "../../src/dispatch/evidence.eli" selectReplyRoute)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../../src/triggers/predicate.eli" validatePredicate evaluatePredicate)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.mention-replies.unit" (async (unused)
    (let* ((source (js-object :connection_id "source" :platform "lark" :brand "lark" :tenant_ref "one" :identity "bot" :identity_revision 1))
      (user (Object/assign (js-object) source (js-object :connection_id "user" :identity "user")))
      (policy (js-object))
      (context (js-object :repository (js-object :get (lambda (table key)
        (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user))))))
      (route (js-object :source_connection_id "source" :mention_id "native-human" :reply_connection_id "user"))
      (event (js-object :connection_id "source" :identity_revision 1 :conversation (js-object :connection_id "source" :native_chat_id "chat")
        :mentions (js-array (js-object :id "native-human"))))
      (predicate (js-object :field "mentions.id" :op "in" :value (js-array "native-human" "native-bot"))))
      (js-call (expect (nativeGet (validatePredicate predicate) "ok")) :toBe t)
      (js-call (expect (evaluatePredicate predicate event)) :toBe "true")
      (js-call (expect (evaluatePredicate predicate (js-object :mentions (js-array) :content (js-object :text "@native-human")))) :toBe "false")
      (js-call (expect (evaluatePredicate predicate (js-object))) :toBe "indeterminate")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route route)) "ok")) :toBe false)
      (js-call (expect (nativeGet (normalizeReplyRoutes context nil) "ok")) :toBe false)
      (let ((sparse (new globalThis.Array 2)))
        (put sparse 0 route)
        (js-call (expect (nativeGet (normalizeReplyRoutes context sparse) "ok")) :toBe false))
      (put user :tenant_ref "other")
      (js-call (expect (nativeGet (normalizeReplyRoutes context (js-array route)) "ok")) :toBe false)
      (put user :tenant_ref "one")
      (put policy :reply_routes (nativeGet (normalizeReplyRoutes context (js-array route)) "data"))
      (let ((chosen (selectReplyRoute context event "target")))
        (js-call (expect (nativeGet chosen "identity")) :toBe "user")
        (js-call (expect (nativeGet (nativeGet chosen "destination") "native_chat_id")) :toBe "chat"))
      (put user :identity_revision 2)
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "status")) :toBe "stale_reference")
      (put user :identity_revision 1)
      (put event :mentions (js-array (js-object :id "native-bot")))
      (js-call (expect (nativeGet (selectReplyRoute context event "target") "status")) :toBe "unmapped_target"))))
  (withUnitCase "T38.reply-identity-evidence.unit" (async ()
    (let* ((source (js-object :connection_id "source" :platform "lark" :brand "lark" :identity "bot"
        :identity_revision 1 :event_app_id "source-app" :event_subject_id "native-bot"))
      (user (js-object :connection_id "user" :platform "lark" :brand "lark" :identity "user" :identity_revision 1))
      (policy (js-object :reply_routes (js-array)))
      (context (js-object :repository (js-object :get (lambda (table key)
        (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user))))))
      (event (js-object :connection_id "source" :identity_revision 1 :event_kind "message.created"
        :conversation (js-object :connection_id "source" :native_chat_id "chat")
        :mentions (js-array (js-object :id "native-bot" :name "same-name")))))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put event :mentions (js-array (js-object :id "unknown" :name "same-name")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "unmapped_target")
      (put policy :reply_routes (nativeGet (normalizeReplyRoutes context (js-array
        (js-object :source_connection_id "source" :mention_id "native-human" :reply_connection_id "user"))) "data"))
      (put event :mentions (js-array (js-object :id "native-bot") (js-object :id "native-human")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "ambiguous_target")
      (put event :mentions (js-array))
      (put event :interaction (js-object :state "resolved" :target_id "native-human" :target_message_id "parent"))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "user")
      (put event :mentions (js-array (js-object :id "native-bot")))
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put event :mentions (js-array)) (put event :chat_type "p2p")
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "source")
      (put source :identity_revision 2)
      (js-call (expect (nativeGet (selectReplyRoute context event "session") "status")) :toBe "stale_reference")
      (put source :identity_revision 1)
      (let* ((flat (flattenLarkEvent (js-object :header (js-object :event_type "im.message.receive_v1" :app_id "source-app")
        :event (js-object :sender (js-object :sender_id (js-object :open_id "human") :sender_type "user")
          :message (js-object :message_id "message" :chat_id "chat" :chat_type "group" :message_type "text"
            :create_time "1767225600000" :content "{\"text\":\"@_user_1 hello\"}"
            :mentions (js-array (js-object :id (js-object :open_id "native-bot") :name "same-name" :key "@_user_1")))))))
        (normalized (normalizeLarkEvent source flat)))
        (js-call (expect (nativeGet (aref (nativeGet normalized "mentions") 0) "key")) :toBe "@_user_1"))
      ;; Interaction specificity tiers: direct reply > thread root/mention > thread participation,
      ;; while genuine same-tier conflicts still fail closed as ambiguous_target.
      (let* ((peer-row nil)
        (dual-ctx (Object/assign (js-object) context (js-object
          :ports (js-object :clock (js-object :utcNow (lambda () "2026-01-01T00:00:00.000Z")))
          :store (js-object :db (js-object :query (lambda (sql)
            (js-object :all (lambda (&rest ignored)
              (if peer-row (js-array (js-object :payload (JSON/stringify peer-row))) (js-array))))))))))
        (bot-thread (js-object :connection_id "source" :identity_revision 1 :event_kind "message.created"
          :native_message_id "m-tier" :source_time "2026-01-01T00:00:00.000Z" :chat_type "group"
          :conversation (js-object :connection_id "source" :native_chat_id "chat" :native_thread_id "t1")
          :mentions (js-array)
          :interaction (js-object :state "resolved" :kind "thread" :target_id "native-bot" :target_message_id "root-bot"))))
        (put user :event_subject_id "native-user")
        (setq peer-row (Object/assign (JSON/parse (JSON/stringify bot-thread))
          (js-object :connection_id "user"
            :interaction (js-object :state "resolved" :kind "thread" :basis "thread_participation"
              :target_id "native-user" :target_message_id "prev-user"))))
        (let ((picked (selectReplyRoute dual-ctx bot-thread "session")))
          (js-call (expect (nativeGet picked "status")) :toBe "ready")
          (js-call (expect (nativeGet picked "connection_id")) :toBe "source"))
        (put (nativeGet peer-row "interaction") :kind "reply")
        (Reflect/deleteProperty (nativeGet peer-row "interaction") "basis")
        (let ((picked (selectReplyRoute dual-ctx bot-thread "session")))
          (js-call (expect (nativeGet picked "status")) :toBe "ready")
          (js-call (expect (nativeGet picked "connection_id")) :toBe "user"))
        (put (nativeGet bot-thread "interaction") :kind "reply")
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "status")) :toBe "ambiguous_target")
        (put (nativeGet bot-thread "interaction") :kind "thread")
        (put (nativeGet peer-row "interaction") :kind "thread")
        (put (nativeGet peer-row "interaction") :basis "thread_mention")
        (put (nativeGet peer-row "interaction") :target_message_id "root-bot")
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "connection_id")) :toBe "source")
        (put bot-thread :interaction nil)
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "connection_id")) :toBe "user")
        ;; Native self identity, not source order or display name, distinguishes
        ;; a recipient from another connection's private-message sender echo.
        (put bot-thread :chat_type "p2p") (put peer-row :chat_type "p2p")
        (put bot-thread :sender (js-object :id "human" :kind "human"))
        (put peer-row :sender (js-object :id "native-user" :kind "human"))
        (let ((picked (selectReplyRoute dual-ctx bot-thread "session")))
          (js-call (expect (nativeGet picked "connection_id")) :toBe "source")
          (js-call (expect (nativeGet picked "basis")) :toBe "private_recipient"))
        (put bot-thread :sender (js-object :id "source-app" :kind "bot"))
        (put peer-row :sender (js-object :id "foreign-bot" :kind "bot"))
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "connection_id")) :toBe "user")
        (put bot-thread :sender (js-object :id "human" :kind "human"))
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "status")) :toBe "ambiguous_target")
        (setq peer-row nil)
        (put bot-thread :connection_id "user")
        (put bot-thread :sender (js-object :id "native-user" :kind "human"))
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "connection_id")) :toBe "user")
        ;; Equivalent event kinds & unified snapshot event_key across message.created(T1) and message.edited(T1),
        ;; plus shared @key slot matching across distinct per-app open_ids.
        (js-call (expect (equivalentEventKinds "message.created")) :toEqual (js-array "message.created" "message.edited"))
        (js-call (expect (equivalentEventKinds "message.edited")) :toEqual (js-array "message.created" "message.edited"))
        (js-call (expect (equivalentEventKinds "message.pinned")) :toEqual (js-array "message.pinned" "message.pinned"))
        (let* ((t0 "2026-01-01T00:00:00.000Z")
               (t1 (Date/parse "2026-01-01T00:01:00.000Z"))
               (t2 (Date/parse "2026-01-01T00:02:00.000Z"))
               (created-t0 (js-object :connection_id "source" :event_kind "message.created" :native_message_id "m-ed"
                 :source_time t0 :conversation (js-object :connection_id "source" :native_chat_id "chat")))
               (edited-t1 (js-object :connection_id "source" :event_kind "message.edited" :native_message_id "m-ed"
                 :source_time "2026-01-01T00:01:00.000Z" :native_message_update_time t1
                 :conversation (js-object :connection_id "source" :native_chat_id "chat")))
               (late-http-t1 (js-object :connection_id "user" :event_kind "message.created" :native_message_id "m-ed"
                 :source_time t0 :native_message_update_time t1
                 :conversation (js-object :connection_id "user" :native_chat_id "chat")))
               (edited-t2 (Object/assign (js-object) edited-t1 (js-object :native_message_update_time t2))))
          (js-call (expect (nativeGet (eventIdentity dual-ctx late-http-t1) "event_key"))
            :toBe (nativeGet (eventIdentity dual-ctx edited-t1) "event_key"))
          (js-call (expect (= (nativeGet (eventIdentity dual-ctx created-t0) "event_key")
            (nativeGet (eventIdentity dual-ctx edited-t1) "event_key"))) :toBe false)
          (js-call (expect (= (nativeGet (eventIdentity dual-ctx edited-t2) "event_key")
            (nativeGet (eventIdentity dual-ctx edited-t1) "event_key"))) :toBe false))
        (put bot-thread :chat_type "group")
        (put bot-thread :sender (js-object :id "human" :kind "human"))
        (setq peer-row (Object/assign (JSON/parse (JSON/stringify bot-thread)) (js-object :connection_id "source")))
        (put bot-thread :native_message_mentions (js-array
          (js-object :key "@_user_1" :id "native-user")
          (js-object :key "@_user_2" :id "native-bot-in-user-app")))
        (put peer-row :native_message_mentions (js-array
          (js-object :key "@_user_1" :id "native-user-in-bot-app")
          (js-object :key "@_user_2" :id "native-bot")))
        (js-call (expect (nativeGet (selectReplyRoute dual-ctx bot-thread "session") "status")) :toBe "ambiguous_target")
        ;; Edited and first-seen-already-edited @all events preserve source_default reply routing,
        ;; while dual bot+user @all views deterministically prefer the unique bot connection.
        (setq peer-row nil)
        (let* ((t-edit-ms (Date/parse "2026-01-01T00:01:00.000Z"))
               (edited-all (js-object :connection_id "source" :identity_revision 1 :event_kind "message.edited"
                 :native_message_id "m-all-1" :source_time "2026-01-01T00:01:00.000Z"
                 :native_message_update_time t-edit-ms :chat_type "group"
                 :conversation (js-object :connection_id "source" :native_chat_id "chat")
                 :mentions (js-array) :mentions_all t))
               (late-all (js-object :connection_id "user" :identity_revision 1 :event_kind "message.created"
                 :native_message_id "m-all-2" :source_time "2026-01-01T00:00:00.000Z"
                 :native_message_update_time t-edit-ms :chat_type "group"
                 :conversation (js-object :connection_id "user" :native_chat_id "chat")
                 :mentions (js-array) :mentions_all t))
               (edited-no-all (js-object :connection_id "source" :identity_revision 1 :event_kind "message.edited"
                 :native_message_id "m-no-all" :source_time "2026-01-01T00:01:00.000Z"
                 :native_message_update_time t-edit-ms :chat_type "group"
                 :conversation (js-object :connection_id "source" :native_chat_id "chat")
                 :mentions (js-array)))
               (picked-edited (selectReplyRoute dual-ctx edited-all "session"))
               (picked-late (selectReplyRoute dual-ctx late-all "session")))
          (js-call (expect (nativeGet picked-edited "status")) :toBe "ready")
          (js-call (expect (nativeGet picked-edited "connection_id")) :toBe "source")
          (js-call (expect (nativeGet picked-edited "basis")) :toBe "source_default")
          (js-call (expect (nativeGet picked-late "status")) :toBe "ready")
          (js-call (expect (nativeGet picked-late "connection_id")) :toBe "user")
          (js-call (expect (nativeGet picked-late "basis")) :toBe "source_default")
          (js-call (expect (nativeGet (selectReplyRoute dual-ctx edited-no-all "session") "status")) :toBe "unmapped_target")
          (setq peer-row (Object/assign (js-object) edited-all
            (js-object :native_message_id "m-all-2")))
          (let ((picked-dual (selectReplyRoute dual-ctx late-all "session")))
            (js-call (expect (nativeGet picked-dual "status")) :toBe "ready")
            (js-call (expect (nativeGet picked-dual "connection_id")) :toBe "source")
            (js-call (expect (nativeGet picked-dual "basis")) :toBe "source_default"))
          (let* ((bot2 (Object/assign (js-object) source (js-object :connection_id "bot2")))
                 (two-bot-ctx (Object/assign (js-object) dual-ctx (js-object :repository (js-object :get (lambda (table key)
                   (cond ((= table "session_rules") policy) ((= key "source") source) ((= key "user") user) ((= key "bot2") bot2))))))))
            (setq peer-row (Object/assign (js-object) edited-all
              (js-object :connection_id "bot2" :conversation (js-object :connection_id "bot2" :native_chat_id "chat"))))
            (js-call (expect (nativeGet (selectReplyRoute two-bot-ctx edited-all "session") "status")) :toBe "ambiguous_target"))
          (setq peer-row nil))))))
  (withUnitCase "T40.reply-context-expiry.unit" (async (unused)
    (let* ((owner (js-object :principal_id "recipient" :authorization_revision 1))
           (viewer (js-object :principal_id "observer" :authorization_revision 1))
           (records (new globalThis.Map))
           (now "2026-01-02T00:00:00.000Z")
           (reply (js-object :recipient_principal_id "recipient" :identity_revision 1 :expires_at now))
           (context (js-object :principal owner :config (js-object :principals (js-array owner viewer))
             :ports (js-object :clock (js-object :utcNow (lambda () now)))
             :handles (createHandleAuthority (js-object :records records))
             :repository (js-object :handleRecords records :get (lambda (table id)
               (when (and (= table "reply_contexts") (= id "reply")) reply)))))
           (expired (nativeGet (issueHandle context "reply_context" owner "reply" (js-object :identity_revision 1) now) "ref"))
           (mismatched (nativeGet (issueHandle context "reply_context" owner "reply" (js-object :identity_revision 2) now) "ref"))
           (wrong-kind (nativeGet (issueHandle context "message" owner "message" (js-object) now) "ref")))
      (let ((expired-result (resolveReply context expired)))
        (js-call (expect (nativeGet (nativeGet expired-result "error") "code")) :toBe "reply_context_expired")
        (put context :principal viewer)
        (js-call (expect (resolveReply context expired)) :toEqual expired-result)
        (put owner :authorization_revision 2)
        (put context :principal owner)
        (js-call (expect (resolveReply context expired)) :toEqual expired-result))
      (put context :principal viewer)
      (let ((missing (resolveReply context "missing")))
        (js-call (expect (nativeGet (nativeGet missing "error") "code")) :toBe "stale_reference")
        (js-call (expect (resolveReply context wrong-kind)) :toEqual missing)
        (js-call (expect (resolveReply context mismatched)) :toEqual missing))
      (put viewer :disabled t)
      (js-call (expect (nativeGet (nativeGet (resolveReply context expired) "error") "code")) :toBe "forbidden")
      (put context :principal (js-object :principal_id "unconfigured"))
      (js-call (expect (nativeGet (nativeGet (resolveReply context expired) "error") "code")) :toBe "forbidden"))))
)
