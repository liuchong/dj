(module dj.tests.unit.swift-hosts
  (import "../../tools/connector-entries.eli" connectorEntry)
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (withCase "T38.swift-hosts.unit" (lambda () nil) (lambda (ignored)
    (js-call (expect (lambda () (connectorEntry "unknown"))) :toThrow globalThis.TypeError)
    (js-call (expect (connectorEntry "pi")) :toBe (connectorEntry "pi"))
    (js-call (expect (connectorEntry "cursor")) :toContain "require(\"vscode\")")
    (let ((helper (resolve "dist/native/dj-process-info")) (index 0)
          (invalid (js-array (js-array) (js-array "0") (js-array "-1")
                            (js-array "2147483648") (js-array "1.5") (js-array "bad"))))
      (while (< index (js-length invalid))
        (let ((result (Bun/spawnSync (js-call (js-array helper) :concat (aref invalid index))
                       (js-object :stdout "pipe" :stderr "pipe"))))
          (js-call (expect (nativeGet result "exitCode")) :toBe 2)
          (js-call (expect (nativeGet (nativeGet result "stdout") "byteLength")) :toBe 0))
        (setq index (1+ index)))))
    (lambda (ignored) nil)))
