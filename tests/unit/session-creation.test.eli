(module dj.tests.unit.session-creation
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" hashValue)
  (import "../../src/lifecycle/workspaces.eli" creationWorkspace)
  (import "../../src/adapters/agent/antigravity.eli" cascadeCreationId cascadeModel)
  (import "../../src/adapters/agent/cursor-native.eli" cursorConstructorSelector)
  (import "node:vm" runInNewContext)
  (import "../support/case.eli" withUnitCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (withUnitCase "T38.native-create-boundaries.unit" (lambda (unused)
    (let* ((base (resolve "base-workspace")) (directory (resolve "other-workspace"))
           (endpoint (js-object :tool "opencode" :instance_id "native" :instance_epoch "current"
             :workspace_ref "base" :workspace_refs (js-array "base") :directory base))
           (ref (str "opencode-workspace-" (hashValue directory)))
           (args (js-object :workspace_ref ref :directory directory)))
      (js-call (expect (nativeGet (creationWorkspace endpoint args nil) "ok")) :toBe false)
      (js-call (expect (nativeGet (creationWorkspace endpoint (js-object :workspace_ref "base") nil) "ok")) :toBe t)
      (put endpoint :workspace_scope "instance")
      (js-call (expect (nativeGet (creationWorkspace endpoint args nil) "ok")) :toBe t)
      (js-call (expect (nativeGet (creationWorkspace endpoint
        (js-object :workspace_ref "base" :directory directory) nil) "ok")) :toBe false)
      (js-call (expect (nativeGet (creationWorkspace endpoint
        (js-object :workspace_ref ref :directory "relative") nil) "ok")) :toBe false)
      (js-call (expect (nativeGet (creationWorkspace endpoint
        (js-object :workspace_ref ref :directory (str directory "/../other-workspace")) nil) "ok")) :toBe false)
      (let ((rows (js-array (js-object :directory directory))) (queries 0))
        (let ((db (js-object :query (lambda (sql)
          (js-call (expect (js-call sql :includes "instance_epoch=?")) :toBe t)
          (js-object :all (lambda (values)
            (setq queries (1+ queries))
            (js-call (expect values) :toEqual (js-array "native" "current" ref)) rows))))))
          (js-call (expect (nativeGet (creationWorkspace endpoint (js-object :workspace_ref ref) db) "ok")) :toBe t)
          (js-call rows :push (js-object :directory (resolve "conflict-workspace")))
          (js-call (expect (nativeGet (creationWorkspace endpoint (js-object :workspace_ref ref) db) "ok")) :toBe false)
          (js-call (expect queries) :toBe 2))))
    (let* ((select (runInNewContext (str "(" cursorConstructorSelector ")")))
           (first (runInNewContext "(class CurrentNative{constructor(){this.agentRepositoryProxy={}}})"))
           (other (runInNewContext "(class AnotherNative{constructor(){this.agentRepositoryProxy={}}})")))
      (js-call (expect (funcall select first)) :toBe first)
      (js-call (expect (funcall select (lambda () nil))) :toBe nil)
      (js-call (expect (lambda () (funcall select first other))) :toThrow "cursor_native_shape"))
    (let ((id (cascadeCreationId "original-key")))
      (js-call (expect id) :toBe (cascadeCreationId "original-key"))
      (js-call (nativeGet (expect id) "not") :toBe (cascadeCreationId "other-key"))
      (js-call (expect (js-call (new globalThis.RegExp "^[a-f0-9]{8}-[a-f0-9]{4}-5[a-f0-9]{3}-a[a-f0-9]{3}-[a-f0-9]{12}$") :test id)) :toBe t))
    (js-call (expect (cascadeModel nil)) :toBe nil)
    (js-call (expect (cascadeModel (js-object :model_id "1417"))) :toBe 1417)
    (js-call (expect (cascadeModel (js-object :model_id "MODEL_EXACT_NATIVE"))) :toBe "MODEL_EXACT_NATIVE")
    (js-call (js-array "0" "-1" "Gemini display name" "MODEL_UNSPECIFIED") :forEach
      (lambda (id) (js-call (expect (lambda () (cascadeModel (js-object :model_id id)))) :toThrow)))
    (js-call (expect (lambda () (cascadeModel (js-object :model_id "1417" :variant "other")))) :toThrow))))
