(module dj.tests.unit.supervision
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/sessions/supervision.eli" backoffSeconds)
  (import "../../src/policy/authorize.eli" authorize)
  (import "../../src/delivery/scheduler.eli" effectiveBusyPolicy)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.supervision-backoff.unit" (lambda ()
    (js-call (expect (backoffSeconds (js-object :check_seconds 30 :failures 0))) :toBe 30)
    (js-call (expect (backoffSeconds (js-object :check_seconds 30 :failures 1))) :toBe 60)
    (js-call (expect (backoffSeconds (js-object :check_seconds 30 :failures 100))) :toBe 900)
    (js-call (expect (backoffSeconds (js-object :check_seconds 3600 :failures 0))) :toBe 900)))
  (withUnitCase "T38.supervision-binding.unit" (lambda ()
    (let* ((target (js-object :tool "codex" :native_namespace "local" :native_session_id "exact"))
      (principal (js-object :principal_id "recipient" :kind "recipient" :authorization_revision 1
        :target_constraint (Object/assign (js-object) target) :grants (js-array))))
      (js-call (expect (nativeGet (authorize principal "session.supervise" target 1) "allowed")) :toBe t)
      (js-call (expect (nativeGet (authorize principal "session.send" target 1) "allowed")) :toBe false)
      (js-call (js-array "tool" "native_namespace" "native_session_id") :forEach (lambda (field)
        (let ((other (Object/assign (js-object) target)))
          (put other field "different")
          (js-call (expect (nativeGet (authorize principal "session.supervise" other 1) "allowed")) :toBe false))))
      (js-call (expect (nativeGet (authorize principal "session.supervise" target 2) "allowed")) :toBe false)
      (put principal :disabled t)
      (js-call (expect (nativeGet (authorize principal "session.supervise" target 1) "allowed")) :toBe false)
      (put principal :disabled false)
      (put (nativeGet principal "target_constraint") :native_session_id (js-array "exact" "other"))
      (js-call (expect (nativeGet (authorize principal "session.supervise" target 1) "allowed")) :toBe false))))
  (withUnitCase "T38.supervision-busy-policy.unit" (lambda ()
    (let ((context (js-object :config (js-object :message_delivery (js-object :busy "steer")))))
      (js-call (expect (effectiveBusyPolicy context (js-object :supervision_key "exact"))) :toBe "queue")
      (js-call (expect (effectiveBusyPolicy context (js-object))) :toBe "steer")))))
