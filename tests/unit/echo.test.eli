(module dj.tests.unit.echo
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connections/echo.eli" sameNativeConversation)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.native-echo-scope.unit" (async (unused)
    (let* ((source (js-object :connection_id "received" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity_revision 1))
      (sent (js-object :connection_id "sent" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity_revision 1))
      (context (js-object :repository (js-object :get (lambda (table key) (if (= key "received") source sent)))))
      (outgoing (js-object :connection_id "sent" :identity_revision 1 :destination (js-object :native_chat_id "chat" :native_thread_id "thread")))
      (event (js-object :connection_id "received" :identity_revision 1 :conversation (js-object :native_chat_id "chat" :native_thread_id "thread"))))
      (js-call (expect (sameNativeConversation context outgoing event t)) :toBe t)
      (put sent :platform "telegram") (put source :platform "telegram")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :platform "lark") (put source :platform "lark")
      (put sent :brand "feishu")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :brand "lark") (put sent :tenant_ref "other")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :tenant_ref "tenant") (put sent :identity_revision 2)
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :identity_revision 1) (put (nativeGet event "conversation") :native_chat_id "other-chat")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put (nativeGet event "conversation") :native_chat_id "chat") (put (nativeGet event "conversation") :native_thread_id "other-thread")
      (js-call (expect (sameNativeConversation context outgoing event t)) :toBe false)
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe t))))
)
