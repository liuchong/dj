(module dj.tests.unit.echo
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/messaging/echo.eli" sameNativeConversation pendingEchoMatches confirmedEchoMatches reserveOutboundEcho)
  (import "../../src/connections/echo.eli" echoState)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.native-echo-scope.unit" (async (unused)
    (let* ((source (js-object :connection_id "received" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity_revision 1))
      (sent (js-object :connection_id "sent" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity_revision 1))
      (context (js-object :repository (js-object :get (lambda (table key) (if (= key "received") source sent)))))
      (outgoing (js-object :connection_id "sent" :identity_revision 1 :destination (js-object :native_chat_id "chat" :native_thread_id "thread")))
      (event (js-object :connection_id "received" :identity_revision 1 :conversation (js-object :native_chat_id "chat" :native_thread_id "thread"))))
      (js-call (expect (sameNativeConversation context outgoing event t)) :toBe t)
      (put sent :platform "telegram") (put source :platform "telegram")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :platform "lark") (put source :platform "lark")
      (put sent :brand "feishu")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :brand "lark") (put sent :tenant_ref "other")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :tenant_ref "tenant") (put sent :identity_revision 2)
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put sent :identity_revision 1) (put (nativeGet event "conversation") :native_chat_id "other-chat")
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe false)
      (put (nativeGet event "conversation") :native_chat_id "chat") (put (nativeGet event "conversation") :native_thread_id "other-thread")
      (js-call (expect (sameNativeConversation context outgoing event t)) :toBe false)
      (js-call (expect (sameNativeConversation context outgoing event)) :toBe t))))
  (withUnitCase "T38.topic-echo-reservation.unit" (lambda (unused)
    (let* ((connection (js-object :connection_id "line" :platform "lark" :brand "lark" :identity_revision 1))
      (context (js-object :repository (js-object :get (lambda (table id) connection))))
      (outgoing (js-object :connection_id "line" :identity_revision 1 :native_reply_to "origin"
        :destination (js-object :native_chat_id "chat" :native_thread_id nil)))
      (event (js-object :connection_id "line" :identity_revision 1 :root_message_id "origin"
        :conversation (js-object :native_chat_id "chat" :native_thread_id "new-topic"))))
      (js-call (expect (pendingEchoMatches context outgoing event)) :toBe t)
      (put event :root_message_id "unrelated")
      (js-call (expect (pendingEchoMatches context outgoing event)) :toBe false)
      (put event :reply_to (js-object :id "origin"))
      (js-call (expect (pendingEchoMatches context outgoing event)) :toBe t)
      (put (nativeGet event "conversation") :native_chat_id "other-chat")
      (js-call (expect (pendingEchoMatches context outgoing event)) :toBe false)
      (put (nativeGet event "conversation") :native_chat_id "chat") (put event :identity_revision 2)
      (js-call (expect (pendingEchoMatches context outgoing event)) :toBe false))))
  (withUnitCase "T38.confirmed-echo-namespace.unit" (lambda (unused)
    (let* ((source (js-object :connection_id "receive" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity_revision 1))
      (sent (Object/assign (js-object) source (js-object :connection_id "send")))
      (context (js-object :repository (js-object :get (lambda (table id) (if (= id "receive") source sent)))))
      (outgoing (js-object :connection_id "send" :identity_revision 1 :destination (js-object :native_chat_id "bot-view")))
      (event (js-object :connection_id "receive" :identity_revision 1 :conversation (js-object :native_chat_id "user-view"))))
      ;; The caller has already matched the native ID, which is not a chat ID.
      (js-call (expect (confirmedEchoMatches context outgoing event)) :toBe t)
      (put sent :tenant_ref "other")
      (js-call (expect (confirmedEchoMatches context outgoing event)) :toBe false)
      (put sent :tenant_ref "tenant") (put source :platform "slack") (put sent :platform "slack")
      (js-call (expect (confirmedEchoMatches context outgoing event)) :toBe false)
      (put (nativeGet event "conversation") :native_chat_id "bot-view")
      (js-call (expect (confirmedEchoMatches context outgoing event)) :toBe t)
      (put event :identity_revision 2)
      (js-call (expect (confirmedEchoMatches context outgoing event)) :toBe false))))
  (withUnitCase "T38.echo-trigger-boundary.unit" (lambda (unused)
    (js-call (expect (echoState (js-object) (js-object :event_kind "message.pinned"))) :toBe "clear")
    (js-call (expect (echoState (js-object) (js-object :conversation (js-object :kind "resource")))) :toBe "clear")
    (js-call (expect (lambda () (reserveOutboundEcho
      (js-object :store (js-object :inTransaction (lambda () false))) (js-object) "now"))) :toThrow globalThis.TypeError)))

)
