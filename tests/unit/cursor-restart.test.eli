(module dj.tests.unit.cursor-restart
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/cursor-native.eli" cursorRenderer)
  (import "../support/case.eli" withUnitCase)
  (import "node:vm" runInNewContext)
  (import "bun:test" expect)
  (withUnitCase "T38.cursor-restart-snapshot.unit" (async (unused)
    (let* ((loaded (new globalThis.Map))
           (repo (js-object :localRepo (js-object :_loadedAgents loaded)
             :getAgentHeader (lambda (id) (js-object :name (js-object :value id)
               :status (js-object :value (if (= id "running") "in_progress" "unknown"))))))
           (host (js-object :agentRepositoryProxy (js-object :delegate repo)))
           (run (runInNewContext (str "(" cursorRenderer ")") (js-object :Map globalThis.Map))))
      (js-call loaded :set "running" (js-object :_composerDataHandle
        (js-object :data (js-object :workspaceIdentifier (js-object :id "workspace")))))
      (js-call loaded :set "unclassified" (js-object))
      (let ((result (await (js-call run :call (js-array host) (js-object :operation "restart_snapshot")))))
        (js-call (expect (nativeGet result "coverage")) :toBe "partial")
        (js-call (expect (nativeGet result "scope")) :toBe "application")
        (js-call (expect (nativeGet (aref (nativeGet result "items") 0) "native_session_id")) :toBe "running")
        (js-call (expect (nativeGet (aref (nativeGet result "items") 0) "runtime_state")) :toBe "busy")
        (js-call (expect (nativeGet (aref (nativeGet result "items") 1) "runtime_state")) :toBe "unknown")
        (js-call (expect (nativeGet (aref (nativeGet result "items") 1) "workspace_id")) :toBe nil))
      (let ((i 0)) (while (< i 210) (js-call loaded :set (str "s" i) (js-object)) (setq i (1+ i))))
      (let ((result (await (js-call run :call (js-array host) (js-object :operation "restart_snapshot")))))
        (js-call (expect (js-length (nativeGet result "items"))) :toBe 200)))))
)
