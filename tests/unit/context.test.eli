(module dj.tests.unit.context
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark-http.eli" formatLarkMessage)
  (import "../../src/messaging/context.eli" matchesAddress projectMessage policyFor)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (withCase "T38.context-boundaries.unit" (lambda () nil) (lambda (ignored)
    (let* ((address (js-object :connection_id "account-a" :native_chat_id "chat-a" :native_thread_id nil :thread_kind "main"))
      (message (js-object :connection_id "account-a" :native_message_id "native-1" :conversation address
        :sender (js-object :id "human-a" :kind "human") :content (js-object :kind "text" :text "🤖中文" :truncated false))))
      (let ((root (formatLarkMessage (js-object :message_id "root-message" :chat_id "chat-a" :thread_id "native-thread"
        :msg_type "text" :body (js-object :content (JSON/stringify (js-object :text "root")))) nil)))
        (js-call (expect (nativeGet root "thread_id")) :toBe "native-thread"))
      (js-call (expect (matchesAddress address message)) :toBe t)
      (js-call (expect (matchesAddress (Object/assign (js-object) address (js-object :connection_id "account-b")) message)) :toBe false)
      (js-call (expect (matchesAddress (Object/assign (js-object) address (js-object :native_chat_id "chat-b")) message)) :toBe false)
      (js-call (expect (matchesAddress (Object/assign (js-object) address (js-object :native_thread_id "thread-b")) message)) :toBe false)
      (let ((first (projectMessage (js-object) message 4)))
        (js-call (expect (nativeGet (nativeGet first "content") "text")) :toBe "🤖")
        (js-call (expect (nativeGet first "next_offset_bytes")) :toBe 4)
        (js-call (expect (nativeGet first "complete")) :toBe false)
        (let ((second (projectMessage (js-object) message 4 (nativeGet first "next_offset_bytes"))))
          (js-call (expect (nativeGet (nativeGet second "content") "text")) :toBe "中")
          (js-call (expect (nativeGet second "next_offset_bytes")) :toBe 7)))
      (let ((merged (policyFor (js-array
        (js-object :context_policy (js-object :mode "recent" :max_events 10 :max_bytes 16384))
        (js-object :context_policy (js-object :mode "recent" :max_events 4 :max_bytes 2048))))))
        (js-call (expect (nativeGet merged "before")) :toBe 3)
        (js-call (expect (nativeGet merged "max_bytes")) :toBe 2048))
      (js-call (expect (nativeGet (policyFor (js-array
        (js-object :context_policy (js-object :mode "recent" :max_events 10))
        (js-object :context_policy (js-object :mode "current" :max_events 1)))) "before")) :toBe 0)
      (js-call (expect (lambda () (projectMessage (js-object) message 4 1))) :toThrow))) (lambda (x) nil))
)
