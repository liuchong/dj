(module dj.tests.unit.lark-api
  (import "../../src/core/native.eli" nativeGet)
  (import "../../packages/lark/src/index.eli" createLarkClient apiUrl)
  (import "../../packages/lark/src/http.eli" createHttp)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (import "ajv/dist/2020.js" :default Ajv2020)
  (withUnitCase "T38.lark-api.unit" (async (unused)
    (js-call (js-array "https://outside.invalid/open-apis/im/v1/chats" "//outside.invalid/open-apis/test"
      "/open-apis/../auth" "/open-apis/im/../auth" "/open-apis/im/%2e%2e/auth" "/open-apis/im%2fsecret"
      "/open-apis/test#fragment" "/open-apis/test\\evil" "/open-apis/test\nheader")
      :forEach (lambda (path) (js-call (expect (lambda () (apiUrl "lark" path))) :toThrow)))
    (js-call (expect (apiUrl "feishu" "/open-apis/docx/v1/documents" (js-object :page_token "a b+中文")))
      :toBe "https://open.feishu.cn/open-apis/docx/v1/documents?page_token=a+b%2B%E4%B8%AD%E6%96%87")
    (let* ((calls 0) (auth 0)
      (http (createHttp "lark" (js-object :monoNow (lambda () (performance/now))
        :fetch (async (url options)
          (js-call (expect (nativeGet (nativeGet options "headers") "authorization")) :toBe "Bearer private")
          (setq calls (1+ calls)) (new globalThis.Response "12345678"))))))
      (try
        (let ((denied false))
          (try (await (js-call http :request (js-object :path "/open-apis/test" :headers (js-object :authorization "override")) "private" (js-object)))
            (catch error (setq denied t)))
          (js-call (expect denied) :toBe t) (js-call (expect calls) :toBe 0))
        (let ((exceeded false))
          (try (await (js-call http :request (js-object :path "/open-apis/test" :response_mode "text" :max_response_bytes 4) "private" (js-object)))
            (catch error (setq exceeded t)))
          (js-call (expect exceeded) :toBe t) (js-call (expect calls) :toBe 1))
        (let* ((client (createLarkClient (js-object :identity "user" :credential_ref "fixture" :user_identity (js-object :app_id "app" :open_id "expected"))
          (js-object :monoNow (lambda () (performance/now)) :credentials (js-object :resolve (lambda (ref)
            (js-object :app_id "app" :app_secret "private" :user_access_token "user-private")))
            :fetch (async (url options) (setq auth (1+ auth))
              (Response/json (js-object :code 0 :data (js-object :open_id "wrong")))))))
          (denied false))
          (try (await (js-call client :request (js-object :path "/open-apis/test") (js-object)))
            (catch error (setq denied t)))
          (js-call (expect denied) :toBe t)
          ;; A mismatched user cannot fall back to a bot token or call the API.
          (js-call (expect auth) :toBe 1) (js-call client :close))
        (finally (js-call http :close))))
    (let* ((aborted false)
      (http (createHttp "lark" (js-object :monoNow (lambda () (performance/now))
        :fetch (async (url options)
          (await (new globalThis.Promise (lambda (done reject)
            (js-call (nativeGet options "signal") :addEventListener "abort" (lambda ()
              (setq aborted t) (funcall reject (new globalThis.Error "cancelled"))) (js-object :once t)))))))))
      (done false))
      (try
        (try (await (js-call http :request (js-object :path "/open-apis/test" :timeout_ms 5) nil (js-object)))
          (catch error (setq done t)))
        (js-call (expect done) :toBe t) (js-call (expect aborted) :toBe t)
        (js-call (expect (js-call http :pendingWork)) :toBe 0)
        (finally (js-call http :close))))
    (let ((ajv (new Ajv2020 (js-object :strict t :allowUnionTypes t))))
      (js-call (js-array "lark.api.read" "lark.api.call" "lark.api.get") :forEach (lambda (operation)
        (let ((descriptor (js-call operationCatalog :get operation)))
          (js-call ajv :compile (nativeGet descriptor "input_schema"))
          (js-call ajv :compile (nativeGet descriptor "output_schema")))))))))
