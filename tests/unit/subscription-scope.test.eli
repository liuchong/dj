(module dj.tests.unit.subscription-scope
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" sourceContainer)
  (import "../../src/triggers/sources.eli" matchesSource)
  (import "../../src/triggers/predicate.eli" defaultSubscriptionPredicate evaluatePredicate)
  (import "../../src/application/schema.eli" normalizeArgs validateRequest)
  (import "../../src/application/help.eli" defaultValues)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.subscription-source-boundaries.unit" (lambda (ignored)
    (let* ((args (normalizeArgs "subscription.preview" (js-object :spec (js-object :agent_id "a"))))
      (default-rule (aref (nativeGet (nativeGet args "spec") "rules") 0))
      (source (js-object :connection_id "account" :scope "connection" :include_threads t))
      (event (js-object :connection_id "account" :conversation (js-object :native_chat_id "any-chat" :native_thread_id "any-thread"))))
      (js-call (expect (nativeGet (validateRequest "subscription.preview" args) "ok")) :toBe t)
      (js-call (expect (nativeGet default-rule "id")) :toBe "default")
      (js-call (expect (nativeGet default-rule "enabled")) :toBe t)
      (js-call (expect (nativeGet default-rule "sources")) :toEqual (js-array))
      (js-call (expect (nativeGet default-rule "predicate")) :toEqual (defaultSubscriptionPredicate))
      (js-call (expect (nativeGet (aref (nativeGet (nativeGet (defaultValues "subscription.preview" (js-object)) "spec") "rules") 0) "predicate"))
        :toEqual (nativeGet default-rule "predicate"))
      (let* ((chosen (js-object :field "chat_type" :op "eq" :value "p2p"))
        (explicit (normalizeArgs "subscription.preview" (js-object :spec (js-object :agent_id "a"
          :rules (js-array (js-object :id "dm" :enabled t :event_kinds (js-array "message.created") :predicate chosen))))))
        (explicit-rule (aref (nativeGet (nativeGet explicit "spec") "rules") 0)))
        (js-call (expect (nativeGet explicit-rule "predicate")) :toEqual chosen)
        (js-call (expect (nativeGet explicit-rule "event_kinds")) :toEqual (js-array "message.created"))
        (js-call (expect (evaluatePredicate chosen (js-object :chat_type "group" :addressed_self t))) :toBe "false"))
      (js-call (expect (sourceContainer source)) :toBe "")
      (js-call (expect (matchesSource source t event)) :toBe t)
      (js-call (expect (matchesSource (Object/assign (js-object) source (js-object :connection_id "other")) t event)) :toBe false)
      (js-call (expect (matchesSource (js-object :connection_id "account" :native_chat_id "other-chat") t event)) :toBe false)
      (let ((invalid (js-object :spec (js-object :agent_id "a" :rules (js-array
        (js-object :id "bad" :enabled t :predicate (defaultSubscriptionPredicate)
          :sources (js-array (js-object :connection_id "account" :conversation_ref "chat"))))))))
        (js-call (expect (nativeGet (validateRequest "subscription.preview" invalid) "ok")) :toBe false)))))
)
