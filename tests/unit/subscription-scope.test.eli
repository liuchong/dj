(module dj.tests.unit.subscription-scope
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" sourceContainer)
  (import "../../src/core/rules.eli" matchesSource)
  (import "../../src/application/schema.eli" normalizeArgs validateRequest)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.subscription-source-boundaries.unit" (lambda (ignored)
    (let* ((args (normalizeArgs "subscription.preview" (js-object :spec (js-object :agent_id "a" :selector (js-object)))))
      (source (js-object :connection_id "account" :scope "connection" :include_threads t))
      (event (js-object :connection_id "account" :conversation (js-object :native_chat_id "any-chat" :native_thread_id "any-thread"))))
      (js-call (expect (nativeGet (validateRequest "subscription.preview" args) "ok")) :toBe t)
      (js-call (expect (nativeGet (nativeGet (nativeGet args "spec") "selector") "sources")) :toEqual (js-array))
      (js-call (expect (sourceContainer source)) :toBe "")
      (js-call (expect (matchesSource source t event)) :toBe t)
      (js-call (expect (matchesSource (Object/assign (js-object) source (js-object :connection_id "other")) t event)) :toBe false)
      (js-call (expect (matchesSource (js-object :connection_id "account" :native_chat_id "other-chat") t event)) :toBe false)
      (let ((invalid (js-object :spec (js-object :agent_id "a" :selector (js-object :sources (js-array
        (js-object :connection_id "account" :conversation_ref "chat")))))))
        (js-call (expect (nativeGet (validateRequest "subscription.preview" invalid) "ok")) :toBe false)))))
)
