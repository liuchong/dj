(module dj.tests.unit.dispatch-contexts
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/dispatch/events.eli" eventIdentity contextIdentity eventOrder)
  (import "../../src/dispatch/contexts.eli" bindingSelection)
  (import "../../src/dispatch/notifications.eli" notificationKey)
  (import "../../src/application/schema.eli" validateRequest)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defun setup ()
    (let* ((connections (new globalThis.Map))
      (bot (js-object :connection_id "bot" :platform "lark" :brand "lark" :tenant_ref "tenant" :identity "bot" :identity_revision 2))
      (user (Object/assign (js-object) bot (js-object :connection_id "user" :identity "user")))
      (other (Object/assign (js-object) bot (js-object :connection_id "other" :tenant_ref "different")))
      (context (js-object :repository (js-object :get (lambda (table id) (js-call connections :get id)))))
      (event (js-object :connection_id "bot" :event_kind "message.created" :event_id "event-a" :native_message_id "message"
        :source_time "2026-01-01T00:00:00.000Z" :source_key "message:created"
        :conversation (js-object :native_chat_id "chat" :native_thread_id nil) :content (js-object :text "first"))))
      (js-call connections :set "bot" bot) (js-call connections :set "user" user) (js-call connections :set "other" other)
      (js-object :context context :event event :connections connections)))
  (withUnitCase "T38.dispatch-event-identity.unit" (lambda (unused)
    (let* ((f (setup)) (context (nativeGet f "context")) (event (nativeGet f "event"))
      (view (Object/assign (js-object) event (js-object :connection_id "user" :event_id "event-b" :received_at "later"
        :content (js-object :text "different view formatting")))))
      (js-call (expect (nativeGet (eventIdentity context event) "event_key")) :toBe (nativeGet (eventIdentity context view) "event_key"))
      (js-call (expect (notificationKey context (js-object) event "session-a" "push")) :toBe (notificationKey context (js-object) view "session-a" "push"))
      (js-call (nativeGet (expect (notificationKey context (js-object) event "session-a" "push")) "not") :toBe (notificationKey context (js-object) view "session-b" "push"))
      (js-call (nativeGet (expect (notificationKey context (js-object) event "session-a" "push")) "not") :toBe (notificationKey context (js-object) view "session-a" "pull"))
      (put view :connection_id "other")
      (js-call (nativeGet (expect (nativeGet (eventIdentity context event) "event_key")) "not") :toBe (nativeGet (eventIdentity context view) "event_key"))
      (put view :connection_id "user") (put view :event_kind "message.reaction.added") (put view :source_key "reaction-one")
      (js-call (nativeGet (expect (nativeGet (eventIdentity context event) "event_key")) "not") :toBe (nativeGet (eventIdentity context view) "event_key"))
      (let ((again (Object/assign (js-object) view (js-object :source_key "reaction-two"))))
        (js-call (nativeGet (expect (nativeGet (eventIdentity context again) "event_key")) "not") :toBe (nativeGet (eventIdentity context view) "event_key"))))))
  (withUnitCase "T38.dispatch-binding-scope.unit" (lambda (unused)
    (let* ((f (setup)) (context (nativeGet f "context")) (event (nativeGet f "event"))
      (separate (Object/assign (js-object) event (js-object :native_message_id "unrelated"))))
      (js-call (nativeGet (expect (nativeGet (contextIdentity context event) "context_id")) "not") :toBe (nativeGet (contextIdentity context separate) "context_id"))
      (put event :root_message_id "root") (put separate :root_message_id "root")
      (js-call (expect (nativeGet (contextIdentity context event) "context_id")) :toBe (nativeGet (contextIdentity context separate) "context_id"))
      (let* ((binding (js-object :binding_id "identity" :context_id "interaction" :connection_id "bot" :identity_revision 2))
        (selected (bindingSelection context event binding)))
        (js-call (expect (nativeGet selected "connection_id")) :toBe "bot")
        (js-call (expect (nativeGet selected "identity_binding_id")) :toBe "identity")
        (put (js-call (nativeGet f "connections") :get "bot") :identity_revision 3)
        (js-call (expect (nativeGet (bindingSelection context event binding) "status")) :toBe "stale_reference")))))
  (withUnitCase "T38.dispatch-exact-sequence.unit" (lambda (unused)
    (let* ((f (setup)) (context (nativeGet f "context")) (event (nativeGet f "event"))
      (prior (Object/assign (js-object) event (js-object :connection_id "user" :ingress_seq "9007199254740993"))))
      (put event :ingress_seq "9007199254740994")
      (put context :store (js-object :db (js-object :query (lambda (sql) (js-object :all (lambda (&rest args)
        (js-array (js-object :payload (JSON/stringify event)) (js-object :payload (JSON/stringify prior)))))))))
      (js-call (expect (eventOrder context event)) :toBe "00009007199254740993"))))
  (withUnitCase "T38.dispatch-transfer-contract.unit" (lambda (unused)
    (let ((args (js-object :context_id "interaction" :expected_binding_id "identity" :connection_id "bot"
      :explicit t :reason "Explicit user request" :idempotency_key "transfer")))
      (js-call (expect (nativeGet (validateRequest "dispatch.context.transfer" args) "ok")) :toBe t)
      (put args :explicit false)
      (js-call (expect (nativeGet (validateRequest "dispatch.context.transfer" args) "ok")) :toBe false)
      (put args :explicit t) (Reflect/deleteProperty args "expected_binding_id")
      (js-call (expect (nativeGet (validateRequest "dispatch.context.transfer" args) "ok")) :toBe false))))
)
