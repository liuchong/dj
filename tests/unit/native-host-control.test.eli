(module dj.tests.unit.native-host-control
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connectors/pi-sessions.eli" createPiSessions)
  (import "../../src/connectors/codex.eli" toolResult)
  (import "../../src/lifecycle/workspaces.eli" creationWorkspace)
  (import "../../src/core/types.eli" hashValue)
  (import "../support/case.eli" withUnitCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (withUnitCase "T38.pi-native-creation-unknown.unit" (async (unused)
    (let* ((calls 0) (directory (resolve "fixture-pi-host"))
           (context (js-object :cwd directory :model (js-object :provider "fixture" :id "fixed")
             :sessionManager (js-object :getSessionId (lambda () "original"))))
           (api (js-object :getThinkingLevel (lambda () "high")))
           (sdk (js-object :createAgentSession (async (options) (setq calls (1+ calls))
             (throw (new globalThis.Error "native outcome uncertain")))))
           (sessions (createPiSessions api context sdk)) (failed false))
      (try (await (js-call sessions :create "key" directory "Title" nil false)) (catch error (setq failed t)))
      (js-call (expect failed) :toBe t)
      (js-call (expect (await (js-call sessions :create "key" directory "Title" nil false))) :toBeNull)
      (js-call (expect calls) :toBe 1)
      (js-call (expect (await (js-call sessions :create "absent" directory "Title" nil t))) :toBeNull)
      (js-call (expect (js-call sessions :list)) :toEqual (js-array "original"))
      (js-call sessions :close))))
  (withUnitCase "T38.native-host-result-boundaries.unit" (async (unused)
    (js-call (expect (lambda () (toolResult (js-object :success false)))) :toThrow)
    (js-call (expect (lambda () (toolResult (js-object :success t :contentItems (js-array))))) :toThrow)
    (js-call (expect (lambda () (toolResult (js-object :success t :contentItems
      (js-array (js-object :type "inputText" :text "{}") (js-object :type "inputText" :text "{}")))))) :toThrow)
    (js-call (expect (toolResult (js-object :success t :contentItems
      (js-array (js-object :type "inputText" :text "{\"threadId\":\"native\"}"))))) :toEqual (js-object :threadId "native"))
    (let* ((directory (resolve "fixture-claude-other"))
           (instance (js-object :tool "claude" :workspace_scope "instance" :directory (resolve "fixture-base") :workspace_ref "base"))
           (args (js-object :workspace_ref (str "claude-workspace-" (hashValue directory)) :directory directory)))
      (js-call (expect (nativeGet (creationWorkspace instance args nil) "ok")) :toBe t)
      (put args :workspace_ref "base")
      (js-call (expect (nativeGet (creationWorkspace instance args nil) "ok")) :toBe false))))
)
