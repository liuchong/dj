(module dj.tests.unit.controller
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/controller/model.eli" projectStatus)
  (import "../../src/controller/platform/darwin/service.eli" parseLaunchStatus createServiceController)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (withCase "T38.controller-states.unit" (lambda () nil) (lambda (ignored)
    (let ((loaded (js-object :known t :loaded t :pid 123)) (absent (js-object :known t :loaded false))
      (ready (js-object :ok t :data (js-object :state "ready"))))
      (js-call (expect (nativeGet (projectStatus t loaded ready) "state")) :toBe "running")
      (js-call (expect (nativeGet (projectStatus t loaded (js-object :ok false)) "state")) :toBe "unresponsive")
      (js-call (expect (nativeGet (projectStatus t absent (js-object :ok false)) "state")) :toBe "stopped")
      (js-call (expect (nativeGet (projectStatus false absent nil) "state")) :toBe "uninstalled")
      (js-call (expect (nativeGet (projectStatus t (js-object :known false) nil) "state")) :toBe "error")
      (js-call (expect (nativeGet (projectStatus t absent ready) "can_start")) :toBe false)
      (js-call (expect (nativeGet (projectStatus t absent ready) "can_stop")) :toBe false)
      (js-call (expect (nativeGet (parseLaunchStatus (js-object :code 0 :stdout "\tpid = 987\n")) "pid")) :toBe 987)
      (js-call (expect (nativeGet (parseLaunchStatus (js-object :code 1 :stderr "permission denied")) "known")) :toBe false))) (lambda (ignored) nil))
  (withCase "T38.controller-coalescing.unit" (lambda () nil) (async (ignored)
    (let* ((calls (js-array)) (loaded false)
      (controller (createServiceController (js-object :uid 501 :launch_agent "fixture.plist")
        (js-object :now (lambda () 0) :inspectPlist (async () t)
          :probe (async () (js-object :ok loaded :data (js-object :state "ready")))
          :run (async (name args)
            (js-call calls :push (aref args 0))
            (when (= (aref args 0) "bootstrap") (setq loaded t))
            (js-object :code (if (and (= (aref args 0) "print") (not loaded)) 113 0) :stdout (if loaded "pid = 123\n" "")))))))
      (await (Promise/all (js-call (js-array 1 2 3 4 5) :map (lambda (n) (js-call controller :refresh)))))
      (js-call (expect (js-length calls)) :toBe 1)
      (await (Promise/all (js-call (js-array 1 2 3 4 5) :map (lambda (n) (js-call controller :action "start")))))
      (js-call (expect (js-length (js-call calls :filter (lambda (s) (= s "enable"))))) :toBe 1)
      (js-call (expect (js-length (js-call calls :filter (lambda (s) (= s "bootstrap"))))) :toBe 1))) (lambda (ignored) nil))
  (withCase "T38.controller-deadline.unit" (lambda () nil) (async (ignored)
    (let* ((now 0) (ready false) (controller (createServiceController (js-object :uid 501 :launch_agent "fixture.plist")
      (js-object :now (lambda () now) :inspectPlist (async () t)
        :probe (async () (js-object :ok ready :data (js-object :state "ready")))
        :run (async (name args) (js-object :code (if (and (= (aref args 0) "print") (not ready)) 113 0)))))))
      (js-call (expect (nativeGet (await (js-call controller :action "start")) "state")) :toBe "starting")
      (setq now 30001)
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "error")
      (setq ready t)
      (let ((recovered (await (js-call controller :refresh))))
        (js-call (expect (nativeGet recovered "state")) :toBe "running")
        (js-call (expect (nativeGet recovered "detail")) :toBe ""))
      (setq ready false)
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "stopped"))) (lambda (ignored) nil)))
