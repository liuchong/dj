(module dj.tests.unit.native-inboxes
  (import "bun:test" expect)
  (import "../support/case.eli" withUnitCase)
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/delivery/envelope.eli" encodeAgentInput)
  (import "../../src/adapters/agent/antigravity.eli" cascadeMessage cascadeWorkspace cascadeState)
  (import "../../src/service/config.eli" validateStructure)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (withUnitCase "T38.native-inbox-boundaries.unit" (lambda (unused)
    ;; This is the actual scheduler argument shape, not a CLI/launch codec.
    (let ((envelope (js-object :schema_version 1 :kind "external_message"
                      :content (js-object :type "text" :text "original session") :allowed_actions (js-array))))
      (js-call (js-array "claude" "antigravity") :forEach (lambda (tool)
        (let* ((input (encodeAgentInput tool envelope "dispatch-test"))
               (wire (JSON/parse (nativeGet input "wire"))))
          (js-call (expect (JSON/parse (nativeGet wire "text"))) :toEqual envelope)
          (js-call (expect (nativeGet input "frame_bytes")) :toBe (Buffer/byteLength (nativeGet input "wire") "utf8"))))))
    (let* ((step (js-object :plannerResponse (js-object :messageId "native-answer"
                    :response "visible answer" :thinking "private thinking")))
           (message (cascadeMessage step)))
      (js-call (expect (nativeGet message "native_message_id")) :toBe "native-answer")
      (js-call (expect (nativeGet message "text")) :toBe "visible answer")
      (js-call (expect (js-call (JSON/stringify message) :includes "private thinking")) :toBe false)
      (js-call (expect (cascadeMessage (js-object :plannerResponse
        (js-object :messageId "thinking-only" :thinking "private")))) :toBe nil)
      (js-call (expect (cascadeMessage (js-object :plannerResponse (js-object :response "no native ID")))) :toBe nil))
    (let ((message (cascadeMessage (js-object :metadata (js-object :modelApiContentId "native-user")
                     :userInput (js-object :items (js-array (js-object :text "one") (js-object :text "two")))))))
      (js-call (expect (nativeGet message "native_message_id")) :toBe "native-user")
      (js-call (expect (nativeGet message "text")) :toBe "one\ntwo"))
    (js-call (expect (cascadeState "CASCADE_RUN_STATUS_IDLE")) :toBe "idle")
    (js-call (expect (cascadeState "CASCADE_RUN_STATUS_RUNNING")) :toBe "busy")
    (js-call (expect (cascadeState "NEW_UNRECOGNIZED_STATUS")) :toBe "unknown")
    (let* ((directory (resolve "workspace-native-fixture")) (endpoint (js-object :directory directory))
           (uri (js-call (pathToFileURL directory) :toString)))
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces
        (js-array (js-object :workspaceFolderAbsoluteUri uri))))) :toBe t)
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces
        (js-array (js-object :workspaceFolderAbsoluteUri (str uri "-other")))))) :toBe false))
    (let ((base (js-object :schema_version 1 :service (js-object :service_id "native-boundaries")
                  :principals (js-array) :managed_profiles (js-array))))
      (js-call (js-array "claude" "antigravity") :forEach (lambda (tool)
        (let* ((endpoint (js-object :tool tool :ownership "existing" :instance_id "fixture"
                  :native_namespace "fixture" :endpoint_ref "native" :workspace_ref "workspace" :directory "."
                  :process_binding (js-object :pid 123 :process_birth "1:2" :process_helper_ref "libexec/dj-process-info")))
               (config (JSON/parse (JSON/stringify base))))
          (if (= tool "claude")
            (Object/assign endpoint (js-object :socket_path "native.sock" :registry_path "session.json" :native_session_id "original"))
            (progn (put endpoint :base_url "https://127.0.0.1:12345") (put endpoint :credential_ref "credential.json")
              (put (nativeGet endpoint "process_binding") :certificate_sha256 (js-call "a" :repeat 64))))
          (put config :agent_endpoints (js-array endpoint))
          (js-call (expect (nativeGet (validateStructure config) "ok")) :toBe t)
          (js-call (js-array "no_process_binding" "bad_pid" "mixed_transport" "argv_profile") :forEach (lambda (change)
            (let* ((copy (JSON/parse (JSON/stringify config))) (item (aref (nativeGet copy "agent_endpoints") 0)) (rejected false))
              (cond
                ((= change "no_process_binding") (Reflect/deleteProperty item "process_binding"))
                ((= change "bad_pid") (put (nativeGet item "process_binding") :pid 0))
                ((= change "mixed_transport") (put item :manifest_path "other.json"))
                (t (put copy :managed_profiles (js-array (js-object :tool tool :argv (js-array "agent"))))))
              (try (setq rejected (not (nativeGet (validateStructure copy) "ok"))) (catch invalid (setq rejected t)))
              (js-call (expect rejected) :toBe t)))))))))))
