(module dj.tests.unit.native-inboxes
  (import "bun:test" expect)
  (import "../support/case.eli" withUnitCase)
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/delivery/envelope.eli" encodeAgentInput renderEnvelope)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort cascadeMessage cascadeWorkspace cascadeState cascadeModelValid cascadeConfigValid)
  (import "../../src/service/config.eli" validateStructure)
  (import "../../src/adapters/agent/local-endpoint-resolver.eli" processRows)
  (import "../../src/service/runtime.eli" dispatchBurstLimit)
  (import "../../src/adapters/agent/desktop.eli" codexRuntime)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (withUnitCase "T38.native-inbox-boundaries.unit" (async (unused)
    (let ((processes (processRows " 123 45 501 /Example App.app/Contents/Resources/bin/language_server\nmalformed\n")))
      (js-call (expect (js-length processes)) :toBe 1)
      (js-call (expect (nativeGet (aref processes 0) "pid")) :toBe 123)
      (js-call (expect (nativeGet (aref processes 0) "executable")) :toBe "/Example App.app/Contents/Resources/bin/language_server"))
    (js-call (expect (dispatchBurstLimit nil)) :toBe 4)
    (js-call (expect (dispatchBurstLimit (js-object :message_during_run "unsupported" :max_dispatch_burst 32))) :toBe 4)
    (js-call (js-array 0 -1 1.5 "32" globalThis.NaN) :forEach (lambda (value)
      (js-call (expect (dispatchBurstLimit (js-object :message_during_run "supported" :max_dispatch_burst value))) :toBe 4)))
    (js-call (expect (dispatchBurstLimit (js-object :message_during_run "supported" :max_dispatch_burst 1000))) :toBe 32)
    (js-call (expect (dispatchBurstLimit (js-object :message_during_run "supported" :max_dispatch_burst 8))) :toBe 8)
    ;; Terminal native errors remain receivable even with partial history.
    ;; Pending input, approval and active turns must still take precedence.
    (let ((state (js-object :resumeState "resumed" :requests (js-array)
             :threadRuntimeStatus (js-object :type "systemError")
             :turnHistory (js-object :kind "canonical" :history (js-object :isComplete false
               :entitiesByKey (js-object) :islands (js-array))))))
      (js-call (expect (codexRuntime state)) :toBe "idle")
      (put state :requests (js-array (js-object :id "approval")))
      (js-call (expect (codexRuntime state)) :toBe "waiting_permission")
      (put state :requests (js-array))
      (put state :unconfirmedTurnSubmissions (js-array (js-object :terminal false)))
      (js-call (expect (codexRuntime state)) :toBe "busy")
      (put state :unconfirmedTurnSubmissions (js-array (js-object :terminal t)))
      (put state :resumeState "resuming")
      (js-call (expect (codexRuntime state)) :toBe "busy")
      (put state :resumeState "notResumed")
      (js-call (expect (codexRuntime state)) :toBe "unknown")
      (put state :resumeState "resumed")
      (put state :threadRuntimeStatus (js-object :type "unrecognized"))
      (js-call (expect (codexRuntime state)) :toBe "unknown")
      (put state :threadRuntimeStatus (js-object :type "systemError"))
      (put state :turnHistory nil)
      (put state :turns (js-array (js-object :status "inProgress")))
      (js-call (expect (codexRuntime state)) :toBe "busy"))
    ;; This is the actual scheduler argument shape, not a CLI/launch codec.
    (let ((envelope (js-object :schema_version 1 :kind "external_message"
                      :content (js-object :type "text" :text "original session") :allowed_actions (js-array))))
      (js-call (js-array "claude" "antigravity") :forEach (lambda (tool)
        (let* ((input (encodeAgentInput tool envelope "dispatch-test"))
               (wire (JSON/parse (nativeGet input "wire"))))
          (js-call (expect (nativeGet wire "text")) :toBe (renderEnvelope envelope))
          (js-call (expect (nativeGet input "frame_bytes")) :toBe (Buffer/byteLength (nativeGet input "wire") "utf8"))))))
    (let* ((step (js-object :plannerResponse (js-object :messageId "native-answer"
                    :response "visible answer" :thinking "private thinking")))
           (message (cascadeMessage step)))
      (js-call (expect (nativeGet message "native_message_id")) :toBe "native-answer")
      (js-call (expect (nativeGet message "text")) :toBe "visible answer")
      (js-call (expect (js-call (JSON/stringify message) :includes "private thinking")) :toBe false)
      (js-call (expect (cascadeMessage (js-object :plannerResponse
        (js-object :messageId "thinking-only" :thinking "private")))) :toBe nil)
      (js-call (expect (cascadeMessage (js-object :plannerResponse (js-object :response "no native ID")))) :toBe nil))
    (let ((message (cascadeMessage (js-object :metadata (js-object :modelApiContentId "native-user")
                     :userInput (js-object :items (js-array (js-object :text "one") (js-object :text "two")))))))
      (js-call (expect (nativeGet message "native_message_id")) :toBe "native-user")
      (js-call (expect (nativeGet message "text")) :toBe "one\ntwo"))
    (js-call (expect (cascadeState "CASCADE_RUN_STATUS_IDLE")) :toBe "idle")
    (js-call (expect (cascadeState "CASCADE_RUN_STATUS_RUNNING")) :toBe "busy")
    (js-call (expect (cascadeState "NEW_UNRECOGNIZED_STATUS")) :toBe "unknown")
    (js-call (expect (cascadeModelValid "MODEL_PLACEHOLDER_M427")) :toBe t)
    (js-call (expect (cascadeModelValid 1427)) :toBe t)
    (js-call (expect (cascadeModelValid "MODEL_UNSPECIFIED")) :toBe false)
    (js-call (expect (cascadeModelValid 0)) :toBe false)
    (js-call (expect (cascadeConfigValid (js-object :plannerConfig (js-object :requestedModel "MODEL_PLACEHOLDER_M427")))) :toBe t)
    (js-call (expect (cascadeConfigValid (js-object :plannerConfig (js-object :planModel "MODEL_UNSPECIFIED")))) :toBe false)
    (js-call (expect (not (not (cascadeConfigValid nil)))) :toBe false)
    (let* ((directory (resolve "workspace-native-fixture")) (endpoint (js-object :directory directory))
           (uri (js-call (pathToFileURL directory) :toString)))
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces
        (js-array (js-object :workspaceFolderAbsoluteUri uri))))) :toBe t)
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces
        (js-array (js-object :workspaceFolderAbsoluteUri (str uri "-other")))))) :toBe false)
      (put endpoint :workspace_scope "instance")
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces
        (js-array (js-object :workspaceFolderAbsoluteUri (str uri "-other")))))) :toBe t)
      (js-call (expect (cascadeWorkspace endpoint (js-object :workspaces (js-array)))) :toBe t))
    (let ((base (js-object :schema_version 1 :service (js-object :service_id "native-boundaries")
                  :principals (js-array) :managed_profiles (js-array))))
      (js-call (js-array "claude" "antigravity") :forEach (lambda (tool)
        (let* ((endpoint (js-object :tool tool :ownership "existing" :instance_id "fixture"
                  :native_namespace "fixture" :endpoint_ref "native" :workspace_ref "workspace" :directory "."
                  :process_binding (js-object :pid 123 :process_birth "1:2" :process_helper_ref "libexec/dj-process-info")))
               (config (JSON/parse (JSON/stringify base))))
          (if (= tool "claude")
            (Object/assign endpoint (js-object :socket_path "native.sock" :registry_path "session.json" :native_session_id "original"))
            (progn (put endpoint :base_url "https://127.0.0.1:12345")
              (put (nativeGet endpoint "process_binding") :certificate_sha256 (js-call "a" :repeat 64))))
          (put config :agent_endpoints (js-array endpoint))
          (js-call (expect (nativeGet (validateStructure config) "ok")) :toBe t)
          (let* ((scoped (JSON/parse (JSON/stringify config)))
                 (scoped-item (aref (nativeGet scoped "agent_endpoints") 0))
                 (accepted false))
            (put scoped-item :workspace_scope "instance")
            (try (setq accepted (nativeGet (validateStructure scoped) "ok")) (catch invalid (setq accepted false)))
            (js-call (expect accepted) :toBe (= tool "antigravity")))
          (js-call (js-array "no_process_binding" "bad_pid" "mixed_transport" "argv_profile") :forEach (lambda (change)
            (let* ((copy (JSON/parse (JSON/stringify config))) (item (aref (nativeGet copy "agent_endpoints") 0)) (rejected false))
              (cond
                ((= change "no_process_binding") (Reflect/deleteProperty item "process_binding"))
                ((= change "bad_pid") (put (nativeGet item "process_binding") :pid 0))
                ((= change "mixed_transport") (put item :manifest_path "other.json"))
                (t (put copy :managed_profiles (js-array (js-object :tool tool :argv (js-array "agent"))))))
              (try (setq rejected (not (nativeGet (validateStructure copy) "ok"))) (catch invalid (setq rejected t)))
              (js-call (expect rejected) :toBe t))))))))
    (let* ((sent 0) (model-usage "MODEL_PLACEHOLDER_M427")
           (endpoint (js-object :instance_id "ag" :native_namespace "native" :directory "/workspace" :workspace_ref "ws" :workspace_scope "instance"))
           (binding (js-object :instance_id "ag" :native_namespace "native" :native_session_id "original" :instance_epoch "epoch"))
           (envelope (js-object :schema_version 1 :kind "external_message" :content (js-object :type "text" :text "notice") :allowed_actions (js-array)))
           (port (createAntigravityPort (js-object :endpoints (js-array endpoint))
             (js-object :antigravity_rpc (async (ep method payload context)
               (cond
                 ((= method "GetAllCascadeTrajectories") (js-object :instance_epoch "epoch" :data
                   (js-object :trajectorySummaries (js-object :original
                     (js-object :status "CASCADE_RUN_STATUS_RUNNING" :stepCount 2000 :lastUserInputStepIndex 10)))))
                 ((= method "GetTrajectoryTurns") (js-object :instance_epoch "epoch" :data
                   (js-object :turns (js-array (js-object :startStepIndex 10 :firstStep (js-object :userInput (js-object :items (js-array))))))))
                 ((= method "GetCascadeTrajectorySteps") (js-object :instance_epoch "epoch" :data
                   (js-object :steps (js-array (js-object :metadata (if model-usage (js-object :modelUsage (js-object :model model-usage)) (js-object)))))))
                 (t (setq sent (1+ sent)) (js-object :instance_epoch "epoch" :data (js-object)))))))))
      (try
        (js-call (expect (nativeGet (await (js-call port :submit binding envelope "steer" "u1" (js-object))) "state")) :toBe "accepted")
        (js-call (expect sent) :toBe 1)
        (setq model-usage nil)
        (let ((blocked (await (js-call port :submit binding envelope "steer" "u2" (js-object)))))
          (js-call (expect (nativeGet blocked "state")) :toBe "failed")
          (js-call (expect (nativeGet blocked "definite_not_sent")) :toBe t)
          (js-call (expect sent) :toBe 1))
        (finally (await (js-call port :close))))))))
