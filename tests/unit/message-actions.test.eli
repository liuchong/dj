(module dj.tests.unit.message-actions
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/rules.eli" evaluatePredicate defaultSubscriptionPredicate)
  (import "../../src/adapters/im/lark-reactions.eli" classifyReactionResponse)
  (import "../../src/messaging/actions.eli" reactionPage)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../support/case.eli" withUnitCase)
  (import "ajv/dist/2020.js" :default Ajv2020)
  (import "bun:test" expect)
  (withUnitCase "T38.message-actions.unit" (lambda (unused)
    (let* ((ajv (new Ajv2020 (js-object :strict t :allowUnionTypes t)))
      (names (js-array "message.recall" "message.edit" "message.reaction.add" "message.reaction.remove" "message.reaction.list" "message.action.get")))
      (js-call names :forEach (lambda (name)
        (let* ((descriptor (js-call operationCatalog :get name))
          (validate (js-call ajv :compile (nativeGet descriptor "input_schema"))))
          (js-call (expect (nativeGet descriptor "handler_group")) :toBe "message_actions")
          (unless (= name "message.action.get")
            (js-call (expect (funcall validate (js-object :idempotency_key "key"))) :toBe false))
          ;; All tools expose a resolvable output schema, including durable states.
          (js-call ajv :compile (nativeGet descriptor "output_schema")))))
      (let* ((validate (js-call ajv :compile (nativeGet (js-call operationCatalog :get "message.recall") "input_schema")))
        (good (js-object :event_id "event" :idempotency_key "once")))
        (js-call (expect (funcall validate good)) :toBe t)
        (js-call (expect (funcall validate (Object/assign (js-object) good (js-object :context_ref "context")))) :toBe false)
        (js-call (expect (funcall validate (js-object :event_id "event"))) :toBe false))
      (let ((scope (js-object :address (js-object :connection_id "account") :identity_revision 1 :native_message_id "message")))
        (js-call (expect (lambda () (reactionPage (js-object :items (js-array) :has_more t) scope))) :toThrow)
        (js-call (expect (lambda () (reactionPage (js-object :items (js-object) :has_more false) scope))) :toThrow)
        (js-call (expect (nativeGet (reactionPage (js-object :items (js-array) :has_more false) scope) "has_more")) :toBe false)))))
  (withUnitCase "T38.reaction-response-marker.unit" (lambda (unused)
    (let* ((user (js-object :connection_id "user" :platform "lark" :identity "user" :event_app_id "app" :user_identity (js-object :open_id "me" :app_id "app")))
      (bot (js-object :connection_id "bot" :platform "lark" :identity "bot" :event_app_id "app"))
      (application (js-object :config (js-object :connections (js-array user bot))))
      (make-event (lambda (author kind actor self emoji)
        (js-object :event_kind "message.reaction.added" :addressed_self false
          :sender (js-object :id author :kind kind) :chat_type "group"
          :interaction (js-object :kind "reaction" :addressed_self t)
          :reaction (js-object :emoji_type emoji :operator (js-object :id actor :kind "human" :is_self self)))))
      (normal (defaultSubscriptionPredicate))
      (pin (js-object :all (js-array (js-object :field "event_kind" :op "eq" :value "message.reaction.added")
        (js-object :field "reaction.emoji_type" :op "eq" :value "Pin")))))
      (js-call (js-array (js-array "other" "human" user t) (js-array "app" "bot" bot false)) :forEach (lambda (row)
        (let ((event (classifyReactionResponse (aref row 2) (funcall make-event (aref row 0) (aref row 1) "me" (aref row 3) "YES") application)))
          (js-call (expect (evaluatePredicate normal event)) :toBe "false")
          (put (nativeGet event "reaction") :emoji_type "Pin")
          (js-call (expect (evaluatePredicate pin event)) :toBe "true"))))
      (let ((self (classifyReactionResponse user (funcall make-event "me" "human" "me" t "YES") application))
        (other (classifyReactionResponse bot (funcall make-event "app" "bot" "colleague" false "YES") application)))
        (js-call (expect (evaluatePredicate normal self)) :toBe "true")
        (js-call (expect (evaluatePredicate normal other)) :toBe "true"))
      (js-call (expect (evaluatePredicate normal (js-object :event_kind "message.created" :addressed_self t
        :sender (js-object :id "me" :kind "human") :text "self mention marker"))) :toBe "true")
      (let* ((foreign (Object/assign (js-object) user (js-object :event_app_id "different")))
        (event (classifyReactionResponse bot (funcall make-event "app" "bot" "me" false "YES")
          (js-object :config (js-object :connections (js-array foreign))))))
        (js-call (expect (nativeGet (nativeGet event "interaction") "addressed_self")) :toBe t)))))
)
