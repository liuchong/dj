  (defun mCaptureRuntime (binding variant)
    (let ((clock 0) (sleeps 0) (reads 0) (pid-reads (new globalThis.Map)))
      (js-object :uid 7 :capture_id "unit-capture" :now (lambda ()
        (if (and (= variant "rollback") (>= clock 100)) -1 clock))
        :sleep (async (ms)
          (setq sleeps (1+ sleeps))
          (setq clock (+ clock (cond
            ((and (= variant "early") (= sleeps 1)) (/ ms 2))
            ((and (= variant "late") (= sleeps 1)) (+ ms 50))
            ((= variant "gap") (+ ms 250))
            (t ms)))))
        :reader (js-object
          :read (lambda (pid)
            (setq reads (1+ reads))
            (js-call pid-reads :set pid (1+ (or (js-call pid-reads :get pid) 0)))
            (let ((root (js-call (nativeGet binding "roots") :find (lambda (r) (= (nativeGet r "pid") pid)))))
              (if root
                (let ((row (Object/assign (js-object) root
                    (js-object :ppid (if (and (= variant "nested") (= pid 104)) 101 0)
                      :uid 7 :exit_abstime "0" :rss_bytes 64 :physical_footprint_bytes 128))))
                  (when (and (= variant "root-after-exec") (= pid 101) (> reads 4))
                    (put row :executable (resolve "changed-during-enumeration")))
                  (when (and (= pid 101) (>= clock 100))
                    (cond
                      ((= variant "root-exit") (setq row nil))
                      ((= variant "root-birth") (put row :start_abstime "11"))
                      ((= variant "root-exec") (put row :executable (resolve "changed-executable")))
                      ((= variant "uid") (put row :uid 8))
                      ((= variant "permission") (throw (new globalThis.Error "permission_unavailable")))
                      ((= variant "unsafe") (put row :physical_footprint_bytes (nativeGet NativeNumber "NaN")))))
                  row)
                (if (or (and (= variant "child-exit") (>= clock 100))
                    (and (js-call (js-array "parent-after-exit" "parent-list-exit" "parent-list-denied") :includes variant)
                      (= pid 201) (>= clock 100) (>= (js-call pid-reads :get pid) 4))) nil
                  (js-object :pid pid
                    :ppid (cond ((and (js-call (js-array "parent-after-exit" "parent-list-exit" "parent-list-denied") :includes variant) (= pid 202)) (if (>= clock 100) 1 201))
                      ((and (= variant "orphan") (>= clock 100)) 1)
                      ((and (= variant "child-reuse") (>= clock 100)) 1)
                      ((and (= variant "cross") (>= clock 100)) 104)
                      ((and (= variant "nested") (= pid 202)) 104) (t 101))
                    :uid 7 :executable (resolve "capture-child")
                    :start_abstime (if (and (js-call (js-array "child-reuse" "child-rejoin") :includes variant) (>= clock 100)) "2002" (str pid))
                    :exit_abstime "0" :rss_bytes 128 :physical_footprint_bytes 256)))))
          :children (lambda (pid)
            (when (and (js-call (js-array "parent-list-exit" "parent-list-denied") :includes variant) (= pid 201) (>= clock 100))
              (let ((failure (new globalThis.Error "test_children_failure")))
                (put failure :code (if (= variant "parent-list-exit") "ESRCH" "EACCES")) (throw failure)))
            (cond
              ((and (= variant "child-rejoin") (= pid 101)) (js-array 201))
              ((and (js-call (js-array "parent-after-exit" "parent-list-exit" "parent-list-denied") :includes variant) (= clock 0))
                (cond ((= pid 101) (js-array 201)) ((= pid 201) (js-array 202)) (t (js-array))))
              ((and (= variant "nested") (= pid 101)) (js-array 104))
              ((and (= variant "nested") (= pid 104)) (js-array 202))
              ((and (= variant "dynamic") (= pid 101) (>= clock 100)) (js-array 201))
              ((and (js-call (js-array "orphan" "child-exit" "child-reuse" "cross") :includes variant)
                (= pid 101) (= clock 0)) (js-array 201))
              ((and (= variant "cross") (= pid 104) (>= clock 100)) (js-array 201))
              ((and (js-call (js-array "too-many" "truncated") :includes variant) (= pid 101))
                (let ((items (js-array)) (n 0) (count (if (= variant "truncated") 33 29)))
                  (while (< n count) (js-call items :push (+ 201 n)) (setq n (1+ n))) items))
              (t (js-array))))))))

