  (withUnitCase
    "T70.resources.unit.physical-total"
    (async
      (unused)
      (let ((summary (summarizeResources (resourceFixture))))
        (js-call (expect (nativeGet summary "dj_peak_physical_footprint_bytes")) :toBe 3072)
        (js-call
          (expect (nativeGet summary "external_agent_peak_physical_footprint_bytes"))
          :toBe
          4096)
        (js-call (expect (nativeGet summary "total_peak_physical_footprint_bytes")) :toBe 7168))
      ;; 1. Behind-schedule catch-up producer (yields every 16 events) + non-reentrant consumer + exact drain.
      (let*
        ((queued 0)
          (drained 0)
          (clock-offset 0)
          (res1
            (await
              (runCapacitySchedule
                (js-object
                  :total_events
                  36
                  :pace_ms
                  1
                  :catchup_yield_every
                  16
                  :consumer_interval_ms
                  4
                  :drain_poll_ms
                  2
                  :deadline_ms
                  2000
                  :now
                  (lambda () (+ (performance/now) clock-offset))
                  :ingest_event
                  (async
                    (idx)
                    (when (= idx 0) (setq clock-offset 50))
                    (setq queued (1+ queued)))
                  :run_tick
                  (async
                    ()
                    (await
                      (new
                        globalThis.Promise
                        (lambda (resolve reject) (nativeSetTimeout resolve 12))))
                    (let ((take (Math/min queued 18)))
                      (setq queued (- queued take) drained (+ drained take)))
                    (js-object :ok t))
                  :is_drained
                  (lambda
                    ()
                    (js-object
                      :done
                      (and (= drained 36) (= queued 0))
                      :native_inputs
                      drained
                      :remaining
                      queued))
                  :snapshot_pending
                  (lambda
                    ()
                    (js-object :done false :native_inputs drained :remaining queued)))))))
        (js-call (expect (nativeGet res1 "completed")) :toBe t)
        (js-call (expect (nativeGet res1 "cancel_reason")) :toBe nil)
        (js-call (expect (nativeGet res1 "ingested_events")) :toBe 36)
        (js-call (expect drained) :toBe 36)
        (js-call (expect (nativeGet res1 "max_concurrent_ticks")) :toBe 1)
        (js-call (expect (>= (nativeGet res1 "tick_skipped_count") 1)) :toBe t)
        (js-call (expect (>= (nativeGet res1 "catchup_yields") 2)) :toBe t)
        (js-call (expect (>= (nativeGet res1 "ingest_wall_ms") 0)) :toBe t)
        (js-call (expect (>= (nativeGet res1 "drain_wall_ms") 0)) :toBe t)
        (js-call (expect (nativeGet res1 "in_flight_at_exit")) :toBe false)
        (let ((ticks-at-exit (nativeGet res1 "tick_count")))
          (await
            (new
              globalThis.Promise
              (lambda (resolve reject) (nativeSetTimeout resolve 12))))
          (js-call (expect (nativeGet res1 "tick_count")) :toBe ticks-at-exit)
          (js-call (expect drained) :toBe 36)))
      ;; 2. Consumer exception propagation stops producer and cleans up timers in finally.
      (let*
        ((ingested 0)
          (ticks 0)
          (res2
            (await
              (runCapacitySchedule
                (js-object
                  :total_events
                  200
                  :pace_ms
                  3
                  :catchup_yield_every
                  16
                  :consumer_interval_ms
                  4
                  :drain_poll_ms
                  2
                  :deadline_ms
                  2000
                  :ingest_event
                  (async (idx) (setq ingested (1+ ingested)))
                  :run_tick
                  (async
                    ()
                    (setq ticks (1+ ticks))
                    (when (>= ticks 2)
                      (throw (new globalThis.Error "synthetic_consumer_failure")))
                    (js-object :ok t))
                  :is_drained
                  (lambda () (js-object :done false :remaining ingested))
                  :snapshot_pending
                  (lambda () (js-object :done false :remaining ingested)))))))
        (js-call (expect (nativeGet res2 "completed")) :toBe false)
        (js-call (expect (nativeGet res2 "cancel_reason")) :toBe "consumer_error")
        (js-call
          (expect (nativeGet (nativeGet res2 "consumer_error") "message"))
          :toBe
          "synthetic_consumer_failure")
        (js-call (expect (nativeGet res2 "tick_error_count")) :toBe 1)
        (js-call (expect (< (nativeGet res2 "ingested_events") 200)) :toBe t)
        (js-call (expect (nativeGet res2 "in_flight_at_exit")) :toBe false)
        (let ((ingested-at-exit ingested) (ticks-at-exit ticks))
          (await
            (new
              globalThis.Promise
              (lambda (resolve reject) (nativeSetTimeout resolve 12))))
          (js-call (expect ingested) :toBe ingested-at-exit)
          (js-call (expect ticks) :toBe ticks-at-exit)))
      ;; 3. Internal deadline cancels run, awaits in-flight tick in finally, and records backlog snapshot.
      (let*
        ((ingested 0)
          (in-flight-settled false)
          (res3
            (await
              (runCapacitySchedule
                (js-object
                  :total_events
                  500
                  :pace_ms
                  4
                  :catchup_yield_every
                  16
                  :consumer_interval_ms
                  5
                  :drain_poll_ms
                  2
                  :deadline_ms
                  25
                  :ingest_event
                  (async (idx) (setq ingested (1+ ingested)))
                  :run_tick
                  (async
                    ()
                    (await
                      (new
                        globalThis.Promise
                        (lambda (resolve reject) (nativeSetTimeout resolve 30))))
                    (setq in-flight-settled t)
                    (js-object :ok t))
                  :is_drained
                  (lambda () (js-object :done false :remaining ingested))
                  :snapshot_pending
                  (lambda () (js-object :done false :remaining ingested)))))))
        (js-call (expect (nativeGet res3 "completed")) :toBe false)
        (js-call (expect (nativeGet res3 "cancel_reason")) :toBe "internal_deadline")
        (js-call (expect (< (nativeGet res3 "ingested_events") 500)) :toBe t)
        (js-call (expect in-flight-settled) :toBe t)
        (js-call (expect (nativeGet res3 "in_flight_at_exit")) :toBe false)
        (js-call
          (expect (> (nativeGet (nativeGet res3 "final_snapshot") "remaining") 0))
          :toBe
          t)
        (let ((ingested-at-exit ingested))
          (await
            (new
              globalThis.Promise
              (lambda (resolve reject) (nativeSetTimeout resolve 12))))
          (js-call (expect ingested) :toBe ingested-at-exit)))
      ;; 4. On-time pacing when consumer ticks frequently complete during producer wait:
      ;;    consumer tick completion must not wake producer early before start + index * pace_ms.
      (let*
        ((t0 (performance/now))
          (ingest-offsets (js-array))
          (queued 0)
          (drained 0)
          (res4
            (await
              (runCapacitySchedule
                (js-object
                  :total_events
                  6
                  :pace_ms
                  12
                  :catchup_yield_every
                  16
                  :consumer_interval_ms
                  3
                  :drain_poll_ms
                  2
                  :deadline_ms
                  1000
                  :ingest_event
                  (async
                    (idx)
                    (js-call ingest-offsets :push (- (performance/now) t0))
                    (setq queued (1+ queued)))
                  :run_tick
                  (async
                    ()
                    (when (< drained queued)
                      (setq drained queued))
                    (js-object :ok t))
                  :is_drained
                  (lambda
                    ()
                    (js-object
                      :done
                      (and (= queued 6) (= drained 6))
                      :remaining
                      (- queued drained)))
                  :snapshot_pending
                  (lambda
                    ()
                    (js-object :done false :remaining (- queued drained))))))))
        (js-call (expect (nativeGet res4 "completed")) :toBe t)
        (js-call (expect (nativeGet res4 "ingested_events")) :toBe 6)
        (js-call (expect (nativeGet res4 "catchup_yields")) :toBe 0)
        (js-call (expect (>= (nativeGet res4 "tick_count") 8)) :toBe t)
        (let ((idx 0))
          (while (< idx 6)
            (js-call
              (expect (>= (nativeGet ingest-offsets idx) (* idx 12)))
              :toBe
              t)
            (setq idx (1+ idx)))))))
  (js-call
    (js-array "rss-only" "incomplete" "gap" "pid-reuse" "unowned")
    :forEach
    (lambda
      (variant)
      (withUnitCase
        (str "T70.resources.unit.reject-" variant)
        (lambda
          (unused)
          (let*
            ((report (resourceFixture))
              (sample (aref (nativeGet report "samples") 1))
              (process (aref (nativeGet sample "processes") 0)))
            (cond
              ((= variant "rss-only")
                (Reflect/deleteProperty process "physical_footprint_bytes"))
              ((= variant "incomplete") (put report :complete false))
              ((= variant "gap") (put sample :elapsed_ms 1000))
              ((= variant "pid-reuse") (Reflect/deleteProperty process "start_abstime"))
              ((= variant "unowned") (put process :ownership_verified false)))
            (js-call (expect (lambda () (summarizeResources report))) :toThrow)))))))
