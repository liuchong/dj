  (defun mCaptureBinding ()
    (js-object :schema_version 1 :authorized t :roots
      (js-array
        (js-object :pid 101 :start_abstime "9007199254740993" :executable (resolve "capture-a") :category "dj" :roles (js-array "dj"))
        (js-object :pid 102 :start_abstime "2" :executable (resolve "capture-b") :category "dj" :roles (js-array "lark_websocket"))
