  (withUnitCase "T70.resources.unit.capture-controller"
    (async (unused)
      (let* ((buffer (new globalThis.Uint8Array 144)) (view (new globalThis.DataView (nativeGet buffer "buffer"))))
        (js-call view :setBigUint64 64 (NativeBigInt "1024") t)
        (js-call view :setBigUint64 72 (NativeBigInt "2048") t)
        (js-call view :setBigUint64 80 (NativeBigInt "9007199254740993") t)
        (let ((decoded (decodeNativeUsage buffer)))
          (js-call (expect (nativeGet decoded "rss_bytes")) :toBe 1024)
          (js-call (expect (nativeGet decoded "physical_footprint_bytes")) :toBe 2048)
          (js-call (expect (nativeGet decoded "start_abstime")) :toBe "9007199254740993")
          (js-call (expect (nativeGet decoded "exit_abstime")) :toBe "0"))
        (js-call (expect (lambda () (decodeNativeUsage (new globalThis.Uint8Array 143)))) :toThrow)
        (js-call (expect (lambda () (decodeNativeUsage "bad"))) :toThrow)
        (js-call view :setBigUint64 72 (NativeBigInt "9007199254740992") t)
        (js-call (expect (lambda () (decodeNativeUsage buffer))) :toThrow))
      (let ((make-request (lambda () (js-object :schema_version 1 :operation "measure-owned-deployment"
        :request_id "request-1" :run_id "run-1"
        :parameters (js-object :run_id "run-1" :duration_ms 60000 :interval_ms 100)))))
        (js-call (expect (nativeGet (validateCaptureRequest (funcall make-request)) "run_id")) :toBe "run-1")
        (js-call (js-array "operation" "request_id" "run_id" "duration_ms" "interval_ms" "association" "schema") :forEach
          (lambda (variant)
            (let ((request (funcall make-request)))
              (cond ((= variant "operation") (put request :operation "wrong"))
                ((= variant "request_id") (put request :request_id "bad id"))
                ((= variant "run_id") (put request :run_id (js-call "x" :repeat 257)))
                ((= variant "schema") (put request :schema_version 2))
                ((= variant "duration_ms") (put (nativeGet request "parameters") :duration_ms 59999))
                ((= variant "interval_ms") (put (nativeGet request "parameters") :interval_ms 99))
                (t (put (nativeGet request "parameters") :run_id "other")))
              (js-call (expect (lambda () (validateCaptureRequest request))) :toThrow)))))
      (js-call (expect (driverStdoutLimit "measure-owned-deployment")) :toBe 8388608)
      (js-call (expect (driverStdoutLimit "stimulus-lark")) :toBe 1048576)
      (js-call (js-array "unauthorized" "empty" "17" "sparse" "duplicate" "zero-birth" "big-birth" "relative"
        "wrong-role" "duplicate-role" "missing-role" "bad-pid" "bad-object") :forEach
        (lambda (variant)
          (let* ((binding (mCaptureBinding)) (roots (nativeGet binding "roots")) (first (aref roots 0)))
            (cond
              ((= variant "unauthorized") (put binding :authorized false))
              ((= variant "empty") (put binding :roots (js-array)))
              ((= variant "17") (put roots :length 17))
              ((= variant "sparse") (Reflect/deleteProperty roots "1"))
              ((= variant "duplicate") (put (aref roots 1) :pid 101))
              ((= variant "zero-birth") (put first :start_abstime "0"))
              ((= variant "big-birth") (put first :start_abstime "18446744073709551616"))
              ((= variant "relative") (put first :executable "relative"))
              ((= variant "wrong-role") (put first :roles (js-array "external_agent")))
              ((= variant "duplicate-role") (put first :roles (js-array "dj" "dj")))
              ((= variant "missing-role") (put first :roles (js-array "mcp_proxy")))
              ((= variant "bad-pid") (put first :pid 2147483648))
              (t (put roots 0 nil)))
            (js-call (expect (lambda () (validateCaptureBinding binding))) :toThrow))))
      (let* ((raw (mCaptureBinding)) (binding (validateCaptureBinding raw)))
        (put (aref (nativeGet raw "roots") 0) :pid 999)
        (js-call (expect (nativeGet (aref (nativeGet binding "roots") 0) "pid")) :toBe 101)
        (js-call (expect (Object/isFrozen binding)) :toBe t)
        (js-call (expect (Object/isFrozen (nativeGet binding "roots"))) :toBe t))
      ;; Pure ports are intentional test doubles, never supplied by the actual CLI.
      (let ((binding (mCaptureBinding)))
        (let* ((report (await (captureOwnedDeployment binding (mCaptureRuntime binding "normal"))))
               (samples (nativeGet report "samples")) (summary (summarizeResources report)))
          (js-call (expect (nativeGet report "complete")) :toBe t)
          (js-call (expect (js-length samples)) :toBe 601)
          (js-call (expect (nativeGet (aref samples 0) "elapsed_ms")) :toBe 0)
          (js-call (expect (nativeGet (aref samples 600) "elapsed_ms")) :toBe 60000)
          (js-call (expect (nativeGet summary "dj_peak_physical_footprint_bytes")) :toBe 384)
          (js-call (expect (nativeGet summary "external_agent_peak_physical_footprint_bytes")) :toBe 128))
        (let ((variants (js-array "early" "late" "dynamic" "orphan" "child-exit" "child-reuse" "nested" "parent-after-exit" "parent-list-exit" "child-rejoin")) (i 0))
          (while (< i (js-length variants))
            (let* ((variant (aref variants i)) (report (await (captureOwnedDeployment binding (mCaptureRuntime binding variant))))
                   (samples (nativeGet report "samples")) (first (nativeGet (aref samples 0) "processes"))
                   (last (nativeGet (aref samples (- (js-length samples) 1)) "processes")))
              (js-call (expect (nativeGet report "complete")) :toBe t)
              (summarizeResources report)
              (cond
                ((= variant "early") (js-call (expect (nativeGet (aref samples 1) "elapsed_ms")) :toBe 100))
                ((= variant "late") (js-call (expect (nativeGet (aref samples 1) "elapsed_ms")) :toBe 150))
                ((= variant "dynamic")
                  (js-call (expect (js-length first)) :toBe 4)
                  (js-call (expect (js-length last)) :toBe 5))
                ((= variant "orphan") (js-call (expect (js-length last)) :toBe 5))
                ((js-call (js-array "child-exit" "child-reuse") :includes variant)
                  (js-call (expect (js-length first)) :toBe 5)
                  (js-call (expect (js-length last)) :toBe 4))
                ((js-call (js-array "parent-after-exit" "parent-list-exit") :includes variant)
                  (js-call (expect (js-length first)) :toBe 6)
                  (js-call (expect (js-length last)) :toBe 5)
                  (js-call (expect (js-call last :some (lambda (p) (= (nativeGet p "pid") 201)))) :toBe false)
                  (js-call (expect (js-call last :some (lambda (p) (= (nativeGet p "pid") 202)))) :toBe t))
                ((= variant "child-rejoin")
                  (js-call (expect (js-length last)) :toBe 5)
                  (js-call (expect (nativeGet (js-call first :find (lambda (p) (= (nativeGet p "pid") 201))) "start_abstime")) :toBe "201")
                  (js-call (expect (nativeGet (js-call last :find (lambda (p) (= (nativeGet p "pid") 201))) "start_abstime")) :toBe "2002"))
                ((= variant "nested")
                  (js-call (expect (js-length last)) :toBe 5)
                  (let ((summary (summarizeResources report)))
                    (js-call (expect (nativeGet summary "dj_peak_physical_footprint_bytes")) :toBe 384)
                    (js-call (expect (nativeGet summary "external_agent_peak_physical_footprint_bytes")) :toBe 384)))))
            (setq i (1+ i))))
        (let ((variants (js-array "gap" "rollback" "root-exit" "root-birth" "root-exec" "root-after-exec" "parent-list-denied" "uid" "permission" "unsafe" "too-many" "truncated" "cross")) (i 0))
          (while (< i (js-length variants))
            (let ((caught false))
              (try (await (captureOwnedDeployment binding (mCaptureRuntime binding (aref variants i))))
                (catch failure (setq caught t)))
              (js-call (expect caught) :toBe t))
            (setq i (1+ i)))))
      (let ((stream (new globalThis.ReadableStream (js-object :start (lambda (controller)
          (js-call controller :enqueue (new globalThis.Uint8Array 65537)) (js-call controller :close)))))
            (caught false))
        (try (await (readCaptureRequest stream)) (catch failure (setq caught t)))
        (js-call (expect caught) :toBe t))))
