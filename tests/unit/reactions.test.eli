(module dj.tests.unit.reactions
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/adapters/im/lark-reactions.eli" normalizeLarkReaction normalizePolledReaction pollLarkReactions)
  (import "../../src/adapters/im/lark-reaction-policy.eli" reactionPollPolicy createReactionReadBudget reactionReadBudget)
  (import "../../src/adapters/im/lark-reaction-cache.eli" createReactionObservationCache)
  (import "../../src/adapters/im/lark-http.eli" createLarkHttpTransport)
  (import "../../src/service/config.eli" validateStructure)
  (import "../../src/core/rules.eli" validatePredicate evaluatePredicate)
  (import "../../src/connections/replies.eli" selectReplyRoute)
  (import "../../src/connections/echo.eli" reactionEchoState echoState)
  (import "../../src/delivery/envelope.eli" renderEnvelope)
  (import "../support/fixtures.eli" createdEvent)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defconst config (js-object :connection_id "lark" :identity "user" :identity_revision 1 :event_app_id "cli_test"
    :platform "lark" :brand "lark" :user_identity (js-object :open_id "ou_self")))
  (defun wire (&optional emoji)
    (js-object :header (js-object :app_id "cli_test" :event_id "event-reaction" :event_type "im.message.reaction.created_v1")
      :event (js-object :message_id "original" :reaction_type (js-object :emoji_type (or emoji "Pin"))
        :action_time "1767225600000" :operator_type "user" :user_id (js-object :open_id "ou_self"))))
  (withUnitCase "T38.reaction-trigger.unit" (async (unused)
    (let* ((original (createdEvent "lark" "original" "原文\n正文" "thread"))
      (event (normalizeLarkReaction config (wire) original))
      (predicate (js-object :all (js-array (js-object :field "reaction.emoji_type" :op "in" :value (js-array "Pin" "Fire"))
        (js-object :field "reaction.operator.is_self" :op "eq" :value t)))))
      (js-call (expect (nativeGet event "source_key")) :toMatch (new globalThis.RegExp "^reaction:[0-9a-f]{64}$"))
      (let* ((record (js-object :reaction_id "native-pin" :action_time (nativeGet (nativeGet (wire) "event") "action_time")
          :reaction_type (js-object :emoji_type "Pin") :operator (js-object :operator_id "ou_self" :operator_type "user")))
        (polled (normalizePolledReaction config original record)))
        (js-call (expect (nativeGet polled "source_key")) :toBe (nativeGet event "source_key"))
        (js-call (expect (nativeGet polled "receive_transport")) :toBe "poll")
        (js-call (expect (nativeGet (nativeGet polled "reaction") "native_event_id")) :toBe "")
        (js-call (expect (nativeGet (nativeGet polled "reaction") "native_reaction_id")) :toBe "native-pin")
        (put record :action_time "1767225601001")
        (js-call (expect (= (nativeGet (normalizePolledReaction config original record) "source_key") (nativeGet polled "source_key"))) :toBe false)
        (put record :action_time "bad-time")
        (js-call (expect (lambda () (normalizePolledReaction config original record))) :toThrow)
        (put record :action_time "1767225601000")
        (let* ((checkpoint (js-object :activation_at "2026-01-01T00:00:00.000Z"))
          (page 0) (corrupt false)
          (app (js-object :ports (js-object :clock (js-object :utcNow (lambda () "2026-01-01T00:00:02.000Z")))
            :store (js-object :db (js-object :query (lambda (sql) (js-object :get (lambda (&rest args)
              (if (js-call sql :startsWith "SELECT 1") (js-object :found 1)
                (js-object :seq "1" :message_id "original" :payload (JSON/stringify (Object/assign (js-object) original (js-object :identity_revision 1))))))))))))
          (port (js-object :nativeRequest (async (path method body ctx)
            (setq page (1+ page))
            (js-object :status 200 :wire (js-object :code 0 :data (js-object :items (js-array record)
              :has_more (or (= page 1) corrupt) :page_token (if (or (= page 1) corrupt) "next-page" nil))))))))
          (let ((first (await (pollLarkReactions config app port checkpoint (js-object)))))
            (js-call (expect (js-length (nativeGet first "events"))) :toBe 1)
            (js-call (expect (nativeGet checkpoint "reaction_page_token")) :toBe "next-page"))
          (let ((saved (JSON/stringify checkpoint)))
            (setq corrupt t)
            (await (js-call (nativeGet (expect (pollLarkReactions config app port checkpoint (js-object))) "rejects") :toThrow))
            (js-call (expect (JSON/stringify checkpoint)) :toBe saved))
          (setq corrupt false)
          (await (pollLarkReactions config app port checkpoint (js-object)))
          (js-call (expect (nativeGet checkpoint "reaction_message_id")) :toBe nil)
          (js-call (expect (nativeGet checkpoint "reaction_page_token")) :toBe nil)))
      (js-call (expect (nativeGet event "native_message_id")) :toBe "original")
      (js-call (expect (nativeGet event "event_kind")) :toBe "message.reaction.added")
      (js-call (expect (nativeGet event "addressed_self")) :toBe false)
      (js-call (expect (nativeGet (nativeGet event "sender") "id")) :toBe "human-1")
      (js-call (expect (nativeGet (nativeGet (nativeGet event "reaction") "operator") "is_self")) :toBe t)
      (js-call (expect (nativeGet (validatePredicate predicate) "ok")) :toBe t)
      (js-call (expect (evaluatePredicate predicate event)) :toBe "true")
      (js-call (expect (evaluatePredicate predicate (normalizeLarkReaction config (wire "Fire") original))) :toBe "true")
      (js-call (expect (evaluatePredicate predicate (normalizeLarkReaction config (wire "pin") original))) :toBe "false")
      (js-call (expect (evaluatePredicate predicate (normalizeLarkReaction config (wire "📌") original))) :toBe "false")
      (js-call (expect (evaluatePredicate predicate original)) :toBe "false")
      (js-call (expect (lambda () (normalizeLarkReaction config (Object/assign (wire) (js-object :header
        (js-object :app_id "foreign" :event_id "event" :event_type "im.message.reaction.created_v1"))) original))) :toThrow)
      (js-call (expect (lambda () (normalizeLarkReaction config (wire) (createdEvent "lark" "different" "body")))) :toThrow)
      (let ((invalid (wire)))
        (put (nativeGet invalid "event") :operator_type "unknown")
        (js-call (expect (lambda () (normalizeLarkReaction config invalid original))) :toThrow))
      (let* ((other (Object/assign (js-object) config (js-object :connection_id "reply-bot" :identity "bot")))
        (policy (js-object :reply_routes (js-array (js-object :source_connection_id "lark" :mention_id "mentioned-bot"
          :reply_connection_id "reply-bot" :source_identity_revision 1 :reply_identity_revision 1))))
        (context (js-object :repository (js-object :get (lambda (table id)
          (cond ((= table "session_rules") policy) ((= id "lark") config) ((= id "reply-bot") other)))))))
        (put event :identity_revision 1) (put event :mentions (js-array (js-object :id "mentioned-bot")))
        (js-call (expect (nativeGet (selectReplyRoute context event "session") "connection_id")) :toBe "lark")
        (let ((ordinary (Object/assign (js-object) event (js-object :event_kind "message.created"))))
          (js-call (expect (nativeGet (selectReplyRoute context ordinary "session") "connection_id")) :toBe "reply-bot"))
        (let* ((marks (js-array))
          (db (js-object :query (lambda (sql) (js-object :all (lambda (&rest ignored) (js-call marks :map (lambda (mark) (js-object :payload (JSON/stringify mark))))))))))
          (put context :store (js-object :db db))
          (js-call (expect (echoState context event)) :toBe "clear")
          (put (nativeGet event "reaction") :emoji_type "Get")
          (js-call marks :push (js-object :connection_id "lark" :identity_revision 1 :attempted_create t :acknowledgement t
            :create_requested_at "2026-01-01T00:00:00.000Z"))
          (js-call (expect (reactionEchoState context event)) :toBe "held")
          (put (aref marks 0) :native_action_time "1767225600")
          (js-call (expect (reactionEchoState context event)) :toBe "echo")
          (put (nativeGet event "reaction") :action_time "1767225630000")
          (js-call (expect (reactionEchoState context event)) :toBe "clear")
          (put (aref marks 0) :preexisting t)
          (put (nativeGet event "reaction") :action_time "1767225600000")
          (js-call (expect (reactionEchoState context event)) :toBe "clear")))
      (let ((rendered (renderEnvelope (js-object :schema_version 1 :kind "external_message" :allowed_actions (js-array)
        :content (nativeGet event "content") :reaction (nativeGet event "reaction")))))
        (js-call (expect (js-call rendered :includes "原文\n正文")) :toBe t)
        (js-call (expect (js-call rendered :includes "emoji_type")) :toBe t)
        (js-call (expect (js-call rendered :includes "ou_self")) :toBe t)))))
  (withUnitCase "T38.reaction-read-budget.unit" (async (unused)
    (let* ((mono 0) (clock (js-object :monoNow (lambda () mono)))
      (policy (reactionPollPolicy (js-object))) (budget (createReactionReadBudget clock policy))
      (a (js-call budget :tryAcquire)) (b nil) (c nil))
      (js-call (expect (nativeGet policy "requests_per_second")) :toBe 10)
      (js-call (expect (nativeGet policy "new_poll_ms")) :toBe 200)
      (js-call (expect (js-call budget :tryAcquire)) :toBe nil)
      (setq mono 100 b (js-call budget :tryAcquire) mono 200)
      (js-call (expect (js-call budget :tryAcquire)) :toBe nil)
      (js-call a :release) (js-call a :release)
      (setq c (js-call budget :tryAcquire))
      (js-call (expect (nativeGet (js-call budget :status) "active")) :toBe 2)
      (js-call b :release) (js-call c :release)
      (setq mono 1000 a (js-call budget :tryAcquire))
      (js-call (expect (js-call budget :tryAcquire)) :toBe nil)
      (js-call a :release) (js-call budget :pause 3)
      (setq mono 3999)
      (js-call (expect (js-call budget :tryAcquire)) :toBe nil)
      (setq mono 4100 a (js-call budget :tryAcquire))
      (js-call (expect (nativeGet (js-call budget :status) "active")) :toBe 1)
      (js-call a :release)
      (let ((first (js-call budget :join)) (second (js-call budget :join)))
        (setq mono 4200)
        (js-call (expect (js-call budget :tryAcquire second)) :toBe nil)
        (js-call (expect (js-call budget :tryAcquire)) :toBe nil)
        (js-call budget :leave first)
        (setq a (js-call budget :tryAcquire second))
        (js-call (expect (nativeGet (js-call budget :status) "waiting")) :toBe 0)
        (js-call a :release))
      (let* ((host (js-object :clock clock))
        (one (reactionReadBudget (js-object :brand "lark" :identity "user") host "app"))
        (two (reactionReadBudget (js-object :brand "lark" :identity "bot"
          :reaction_poll (js-object :requests_per_second 2 :max_concurrency 1)) host "app")))
        (js-call (expect one) :toBe two)
        (js-call (expect (nativeGet (js-call one :status) "requests_per_second")) :toBe 2)
        (js-call (expect (= one (reactionReadBudget (js-object :brand "lark") host "other-app"))) :toBe false)
        (js-call (expect (= one (reactionReadBudget (js-object :brand "feishu") host "app"))) :toBe false)))
    ;; The actual transport applies native cooldown to another connection of the
    ;; same app, and releases capacity/cancels without ever issuing another GET.
    (let* ((mono 0) (reads 0)
      (host (js-object :clock (js-object :monoNow (lambda () mono))
        :credentials (js-object :resolve (lambda (ref) (js-object :app_id "fixture-app" :app_secret "fixture")))
        :http (js-object :fetch (async (address options)
          (if (js-call address :includes "/tenant_access_token/")
            (Response/json (js-object :code 0 :tenant_access_token "fixture-token" :expire 3600))
            (progn (setq reads (1+ reads))
              (if (= reads 1)
                (Response/json (js-object :code 99991400) (js-object :status 429
                  :headers (js-object :x-ogw-ratelimit-reset "2" :retry-after "5")))
                (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false))))))))))
      (cfg (js-object :brand "lark" :identity "bot" :credential_ref "fixture"))
      (one (createLarkHttpTransport cfg host)) (two (createLarkHttpTransport cfg host))
      (path "/open-apis/im/v1/messages/fixture/reactions?page_size=50"))
      (try
        (let ((first (await (js-call one :request path "GET" nil (js-object)))))
          (js-call (expect (nativeGet first "status")) :toBe 429)
          (js-call (expect (nativeGet first "retry_after")) :toBe 5))
        (let ((next (js-call two :request path "GET" nil (js-object))))
          (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
          (js-call (expect reads) :toBe 1)
          (setq mono 5100)
          (js-call (expect (nativeGet (await next) "status")) :toBe 200))
        (let ((abort (new globalThis.AbortController)))
          (js-call abort :abort)
          (await (js-call (nativeGet (expect (js-call two :request path "GET" nil
            (js-object :abort_signal (nativeGet abort "signal")))) "rejects") :toThrow)))
        (js-call (expect reads) :toBe 2)
        (finally (js-call one :close) (js-call two :close))))
    (let* ((connection (js-object :connection_id "fixture" :platform "lark" :brand "lark" :identity "bot"
        :source_delivery "events" :event_app_id "fixture-app" :event_subject_id "fixture-bot"
        :credential_ref "fixture" :watches (js-array) :reaction_poll (reactionPollPolicy (js-object))))
      (cfg (js-object :schema_version 1 :service (js-object :service_id "fixture") :principals (js-array)
        :managed_profiles (js-array) :connections (js-array connection))))
      (js-call (expect (nativeGet (validateStructure cfg) "ok")) :toBe t)
      (js-call (js-array (js-array "requests_per_second" 11) (js-array "max_concurrency" 3)
        (js-array "recent_messages" 129) (js-array "new_poll_ms" 0) (js-array "unknown_setting" 1))
        :forEach (lambda (entry)
          (put connection :reaction_poll (js-object))
          (Reflect/set (nativeGet connection "reaction_poll") (aref entry 0) (aref entry 1))
          (js-call (expect (nativeGet (validateStructure cfg) "ok")) :toBe false))))))
  (withUnitCase "T38.reaction-observation.unit" (async (unused)
    (let* ((ms 10000) (clock (js-object :utcNow (lambda () (js-call (new globalThis.Date ms) :toISOString))))
      (cache (createReactionObservationCache clock (reactionPollPolicy (js-object))))
      (snapshot (lambda (signature present)
        (js-object :message_id "old-message" :signature signature :has_reactions present :activity ms))))
      ;; Claims coalesce in-flight reads; only record makes a successful observation reusable.
      (js-call (expect (js-call cache :claim "old-message")) :toBe t)
      (js-call (expect (js-call cache :claim "old-message")) :toBe nil)
      (js-call (expect (js-call cache :fresh "old-message")) :toBe nil)
      (js-call cache :release "old-message") (js-call cache :release "old-message")
      (js-call (expect (js-call cache :claim "old-message")) :toBe t)
      (js-call cache :release "old-message")
      (js-call cache :record (funcall snapshot "pin-a" t))
      (js-call (expect (js-call cache :fresh "old-message")) :toBe t)
      (js-call (expect (js-call cache :unchanged "old-message" "pin-a")) :toBe t)
      (js-call (expect (js-call cache :unchanged "old-message" "pin-b")) :toBe false)
      (js-call (expect (js-call cache :nextActive)) :toBe nil)
      (setq ms 11999)
      (js-call (expect (js-call cache :fresh "old-message")) :toBe t)
      (setq ms 12000)
      (js-call (expect (js-call cache :fresh "old-message")) :toBe nil)
      (js-call (expect (js-call cache :nextActive)) :toBe "old-message")
      ;; Removing the last reaction retains a short interest window for a later re-add.
      (js-call cache :record (funcall snapshot "empty" false))
      (setq ms 14000)
      (js-call (expect (js-call cache :nextActive)) :toBe "old-message")
      (js-call cache :record (funcall snapshot "pin-b" t))
      (js-call (expect (js-call cache :unchanged "old-message" "pin-b")) :toBe t)
      (setq ms 13000)
      (js-call (expect (js-call cache :fresh "old-message")) :toBe nil)
      (js-call (expect (js-call cache :nextActive)) :toBe "old-message")
      (setq ms 16000)
      (js-call cache :record (funcall snapshot "empty-again" false))
      (setq ms 76000)
      (js-call (expect (js-call cache :nextActive)) :toBe nil)
      (js-call cache :clear)
      (js-call (expect (nativeGet (js-call cache :status) "entries")) :toBe 0)
      (js-call (expect (nativeGet (js-call cache :status) "saved_reads")) :toBe 0)
      (js-call cache :seed "known-old" 0)
      (js-call (expect (js-call cache :nextActive)) :toBe "known-old")
      (js-call cache :drop "known-old")
      (js-call (expect (js-call cache :nextActive)) :toBe nil)
      (let ((i 0))
        (while (< i 530)
          (js-call cache :record (js-object :message_id (str "m-" i) :signature "empty" :has_reactions false :activity 0))
          (setq i (1+ i))))
      (js-call (expect (nativeGet (js-call cache :status) "entries")) :toBe 512)
      (js-call (expect (js-call cache :fresh "m-0")) :toBe nil)
      (js-call (expect (js-call cache :fresh "m-529")) :toBe t)
      (js-call (expect (nativeGet (js-call cache :status) "in_flight")) :toBe 0)
      ;; Only the configured most recently active set gets the extra scan lane.
      (setq cache (createReactionObservationCache clock
        (Object/assign (reactionPollPolicy (js-object)) (js-object :engaged_messages 2))))
      (js-call cache :seed "cold" 0) (js-call cache :seed "warm" 1000) (js-call cache :seed "hot" 2000)
      (js-call (expect (js-call cache :nextActive)) :toBe "hot")
      (js-call cache :record (js-object :message_id "hot" :signature "same" :has_reactions t :activity 2000))
      (js-call (expect (js-call cache :nextActive)) :toBe "warm")
      (js-call cache :record (js-object :message_id "warm" :signature "same" :has_reactions t :activity 1000))
      (js-call (expect (js-call cache :nextActive)) :toBe nil)
      (setq ms 86000)
      (js-call (expect (js-call cache :nextActive)) :toBe "hot"))))
)
