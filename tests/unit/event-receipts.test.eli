(module dj.tests.unit.event-receipts
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark-event-inbox.eli" receiptEnvelope receiptRetrySeconds receiptError)
  (import "../../src/core/types.eli" hashValue)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (withCase "T38.event-receipt-envelope.unit" (lambda () nil) (lambda (ignored)
    (let* ((body (js-object :content "正文\nnext" :is_mentioned t))
      (wire (js-object :header (js-object :event_id "id" :event_type "type" :app_id "app"
        :create_time "1767225600000" :tenant_key "tenant" :token "private") :event body))
      (safe (receiptEnvelope wire)))
      (js-call (expect (nativeGet safe "event")) :toBe body)
      (js-call (expect (nativeGet (nativeGet wire "header") "token")) :toBe "private")
      (js-call (expect (object-has? (nativeGet safe "header") "token")) :toBe false)
      (put (nativeGet wire "header") :token "renewed")
      (js-call (expect (hashValue (receiptEnvelope wire))) :toBe (hashValue safe))
      (put (nativeGet wire "header") :event_type "changed")
      (js-call (expect (= (hashValue (receiptEnvelope wire)) (hashValue safe))) :toBe false))) (lambda (ignored) nil))
  (withCase "T38.event-receipt-backoff.unit" (lambda () nil) (lambda (ignored)
    (js-call (expect (js-call (js-array 1 2 3 8 9 100000) :map receiptRetrySeconds))
      :toEqual (js-array 2 4 8 256 300 300))) (lambda (ignored) nil))
  (withCase "T38.event-receipt-errors.unit" (lambda () nil) (lambda (ignored)
    (js-call (expect (receiptError (new globalThis.Error "secret URL or body"))) :toBe "event_processing_failed")
    (js-call (expect (receiptError (new globalThis.TypeError "private payload"))) :toBe "event_invalid")
    (js-call (expect (receiptError (new globalThis.RangeError "private payload"))) :toBe "event_capacity_exceeded")
    (js-call (expect (receiptError (js-object :native_code 99991663))) :toBe "native_99991663")
    (js-call (expect (receiptError (js-object :domain_result (js-object :error (js-object :code "storage_unavailable"))))) :toBe "storage_unavailable")
    (js-call (expect (receiptError (js-object :domain_result (js-object :error (js-object :code "secret=https://private"))))) :toBe "event_processing_failed")) (lambda (ignored) nil)))
