(module dj.tests.unit.working
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/delivery/working.eli" trackWorking finishWorking projectWorking projectAcknowledgement)
  (import "../../src/core/errors.eli" success failure)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.working.unit" (async (unused)
    (let* ((mark (js-object :mark_id "shared" :revision 4 :state "active" :reaction_id "native-reaction" :next_due_at "later"))
      (item (js-object :delivery_id "delivery" :mark_id "shared" :state "active"))
      (replaces 0)
      (context (js-object :ports (js-object :clock (js-object :utcNow (lambda () "now")))
        :repository (js-object :get (lambda (table id)
          (cond ((= table "work_items") item) ((= table "work_marks") mark)
            (t (throw (new globalThis.Error "transport delivery must not be modified")))))
          :replace (lambda (table record expected)
            (setq replaces (1+ replaces))
            (when (= table "work_marks") (js-call (expect expected) :toBe 4))
            (success record))))))
      (finishWorking context "delivery" "no_reply")
      (js-call (expect (nativeGet item "state")) :toBe "completed")
      (js-call (expect (nativeGet mark "state")) :toBe "active")
      (js-call (expect (nativeGet mark "reaction_id")) :toBe "native-reaction")
      (js-call (expect (nativeGet mark "next_due_at")) :toBe "now")
      (finishWorking context "delivery" "completed")
      (js-call (expect replaces) :toBe 2))))
  (withUnitCase "T38.no-marker-completion.unit" (lambda (unused)
    (let* ((principal (js-object :principal_id "recipient" :kind "agent" :authorization_revision 1
        :grants (js-array (js-object :action "delivery.inspect" :resources (js-array "self")))))
      (context (js-object :principal principal :config (js-object :principals (js-array principal))
        :ports (js-object :im_ports (new globalThis.Map (js-array (js-array "connection" (js-object :acknowledgement_emoji "eyes")))))
        :repository (js-object :get (lambda (table id) (throw (new globalThis.Error "unmarked delivery must not query a reaction"))))))
      (delivery (js-object :delivery_id "resource-delivery" :recipient_principal_id "recipient" :state "accepted"))
      (result (projectWorking context delivery)))
      (js-call (expect (nativeGet result "ok")) :toBe t)
      (js-call (expect (nativeGet (nativeGet result "data") "state")) :toBe "not_marked")
      (js-call (expect (nativeGet (nativeGet result "data") "cleanup_state")) :toBe "done")
      (js-call (expect (nativeGet delivery "state")) :toBe "accepted")
      (js-call (expect (nativeGet (projectWorking context (Object/assign (js-object) delivery (js-object :recipient_principal_id "other"))) "ok")) :toBe false)
      (js-call (nativeGet principal "grants") :push (js-object :action "message.reply" :resources (js-array "connection")))
      (let* ((mark (js-object :mark_id "ack" :connection_id "connection" :acknowledgement t :principal_id "recipient" :state "posting"
          :destination (js-object :connection_id "connection")))
        (pending (projectAcknowledgement context mark)))
        ;; Accepted intent is not native confirmation. A foreign owner cannot inspect it.
        (js-call (expect (nativeGet (nativeGet pending "data") "native_acknowledged")) :toBe false)
        (js-call (expect (nativeGet (nativeGet pending "data") "emoji_type")) :toBe "eyes")
        (put mark :acknowledged t) (put mark :state "done")
        (js-call (expect (nativeGet (nativeGet (projectAcknowledgement context mark) "data") "native_acknowledged")) :toBe t)
        (put mark :principal_id "other")
        (js-call (expect (nativeGet (projectAcknowledgement context mark) "ok")) :toBe false)
        (put mark :principal_id "recipient") (put mark :acknowledgement false)
        (js-call (expect (nativeGet (projectAcknowledgement context mark) "ok")) :toBe false)))))
  (withUnitCase "T38.acknowledged-lease.unit" (lambda (unused)
    (let* ((item (js-object :delivery_id "early" :mark_id "settled" :state "completed" :reason "no_reply"))
      (reply (js-object :delivery_id "early" :destination (js-object :connection_id "lark")))
      (port (js-object :reaction (lambda (&rest ignored) (throw (new globalThis.Error "no native effect expected")))))
      (context (js-object :ports (js-object :im_ports (new globalThis.Map (js-array (js-array "lark" port))))
        :store (js-object :db (js-object :query (lambda (sql) (js-object :get (lambda (id) (js-object :payload (JSON/stringify reply)))))))
        :repository (js-object :get (lambda (table id)
          (cond ((= table "connections") (js-object :platform "lark"))
            ((= table "work_items") item)
            (t (throw (new globalThis.Error "settled lease must not inspect another marker")))))
          :insert (lambda (&rest ignored) (throw (new globalThis.Error "late acceptance must not recreate Working")))))))
      (trackWorking context (js-object :delivery_id "early" :origin "subscription_event" :state "accepted"))
      (js-call (expect (nativeGet item "state")) :toBe "completed")
      (js-call (expect (nativeGet item "reason")) :toBe "no_reply"))))
)
