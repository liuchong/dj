(module dj.tests.unit.slack
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/slack-normalize.eli" slackMessageId splitSlackMessageId normalizeSlackMessage)
  (import "../../src/connections/replies.eli" sameReplyNetwork)
  (import "../../packages/slack/src/index.eli" createSlackClient apiUrl)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defasync rejected (work)
    (try (await (funcall work)) false (catch error t)))
  (withUnitCase "T38.slack-normalization.unit" (lambda (unused)
    (let ((id (slackMessageId "CEXAMPLE" "1793400000.000001")))
      (js-call (expect id) :toBe "CEXAMPLE:1793400000.000001")
      (js-call (expect (splitSlackMessageId id)) :toEqual (js-object :channel "CEXAMPLE" :ts "1793400000.000001"))
      (js-call (expect (splitSlackMessageId "DABC:1234567890123456.000009")) :toEqual
        (js-object :channel "DABC" :ts "1234567890123456.000009")))
    (js-call (js-array "CABC:1.1" "CABC:1e9" "CABC:1.000001:other" "cabc:1.000001" "CABC:NaN" 123 nil)
      :forEach (lambda (id) (js-call (expect (lambda () (splitSlackMessageId id))) :toThrow)))
    (js-call (expect (lambda () (slackMessageId "CABC" 1793400000.000001))) :toThrow)
    (let* ((config (js-object :connection_id "user" :platform "slack" :brand "slack" :tenant_ref "TONE" :identity "user" :event_subject_id "UOWNER"))
      (event (normalizeSlackMessage config (js-object :ts "1793400000.000002" :thread_ts "1793400000.000001"
        :user "UCOLLEAGUE" :text "<@UOWNER|Owner> 中文\nthread") "CEXAMPLE")))
      (js-call (expect (nativeGet event "addressed_self")) :toBe t)
      (js-call (expect (nativeGet event "root_message_id")) :toBe "CEXAMPLE:1793400000.000001")
      (js-call (expect (nativeGet (nativeGet event "conversation") "native_thread_id")) :toBe "1793400000.000001")
      (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe "<@UOWNER|Owner> 中文\nthread")
      (js-call (expect (nativeGet (aref (nativeGet (nativeGet event "sender") "identities") 0) "scope")) :toBe "workspace:TONE")
      (let ((other (Object/assign (js-object) config (js-object :connection_id "bot" :identity "bot"))))
        (js-call (expect (sameReplyNetwork config other)) :toBe t)
        (put other :tenant_ref "TTWO") (js-call (expect (sameReplyNetwork config other)) :toBe false)
        (put other :tenant_ref nil) (js-call (expect (not (sameReplyNetwork config other))) :toBe t))
      (let ((bot (normalizeSlackMessage (Object/assign (js-object) config (js-object :identity "bot"))
        (js-object :ts "1793400000.000003" :user "UOWNER" :text "self") "DABC")))
        (js-call (expect (nativeGet (nativeGet bot "sender") "kind")) :toBe "bot")
        (js-call (expect (nativeGet bot "chat_type")) :toBe "p2p")))))
  (withUnitCase "T40.slack-identity.unit" (async (unused)
    (js-call (expect (apiUrl "chat.postMessage")) :toBe "https://slack.com/api/chat.postMessage")
    (js-call (js-array "https://outside.invalid/api" "//outside.invalid" "chat.postMessage?x=1" "chat/../auth" "chat.postMessage\nheader")
      :forEach (lambda (method) (js-call (expect (lambda () (apiUrl method))) :toThrow)))
    (let* ((config (js-object :credential_ref "fixture" :tenant_ref "TONE" :event_app_id "AONE" :event_subject_id "UOWNER" :identity "user"))
      (credential (js-object :team_id "TONE" :app_id "AONE" :access_token "fixture-token" :app_token "fixture-app-token"))
      (wire (js-object :ok t :team_id "TONE" :user_id "UOWNER"))
      (calls 0) (auth 0) (mode "normal")
      (client (createSlackClient config (js-object :monoNow (lambda () 0)
        :credentials (js-object :resolve (lambda (ref) credential))
        :fetch (async (url options)
          (setq calls (1+ calls))
          (js-call (expect (nativeGet options "redirect")) :toBe "error")
          (cond ((= url "https://slack.com/api/auth.test") (setq auth (1+ auth)) (Response/json wire))
            ((= mode "large") (new globalThis.Response (js-call "x" :repeat 1048577)))
            ((= url "https://slack.com/api/apps.connections.open") (Response/json (js-object :ok t :url "wss://outside.invalid/socket")))
            (t (Response/json (js-object :ok t)))))))))
      (try
        (put credential :team_id "TOTHER")
        (js-call (expect (await (rejected (async () (await (js-call client :request "chat.postMessage" (js-object) (js-object))))))) :toBe t)
        (js-call (expect calls) :toBe 0)
        (put credential :team_id "TONE") (put wire :user_id "UOTHER")
        (js-call (expect (await (rejected (async () (await (js-call client :request "chat.postMessage" (js-object) (js-object))))))) :toBe t)
        (js-call (expect calls) :toBe 1)
        (put wire :user_id "UOWNER") (put wire :bot_id "BBOT")
        (js-call (expect (await (rejected (async () (await (js-call client :request "chat.postMessage" (js-object) (js-object))))))) :toBe t)
        (js-call (expect calls) :toBe 2)
        (Reflect/deleteProperty wire "bot_id")
        (await (js-call client :request "chat.postMessage" (js-object :text "ok") (js-object)))
        (js-call (expect auth) :toBe 3)
        (await (js-call client :request "chat.postMessage" (js-object) (js-object)))
        (js-call (expect auth) :toBe 3)
        (put credential :access_token "rotated-fixture-token")
        (await (js-call client :request "chat.postMessage" (js-object) (js-object)))
        (js-call (expect auth) :toBe 4)
        (js-call (expect (await (rejected (async () (await (js-call client :socketUrl (js-object))))))) :toBe t)
        (setq mode "large")
        (js-call (expect (await (rejected (async () (await (js-call client :request "chat.postMessage" (js-object) (js-object))))))) :toBe t)
        (js-call client :close)
        (js-call (expect (await (rejected (async () (await (js-call client :request "chat.postMessage" (js-object) (js-object))))))) :toBe t)
        (js-call (expect (js-call client :pendingWork)) :toBe 0)
        (finally (js-call client :close))))))
)
