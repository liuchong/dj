(module dj.tests.unit.tasks
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/desktop.eli" codexInputRequest)
  (import "../../src/delivery/scheduler.eli" effectiveBusyPolicy)
  (import "../../src/application/schema.eli" normalizedPolicy)
  (import "../../src/core/types.eli" hashValue)
  (import "../../src/tasks/service.eli" inspectionScope)
  (import "../../src/tasks/commands.eli" commandPrincipal taskOutboundAllowed renderChildren)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T38.task-inspection.unit" (lambda ()
    (let* ((principal (js-object :principal_id "owner" :kind "operator" :authorization_revision 1 :grants
        (js-array (js-object :action "*" :resources (js-array "*")))))
      (binding (js-object :connection_id "im-one" :identity_revision 1))
      (identity (js-object :platform "lark" :scope "app:test:open_id" :id "native-user"))
      (user (js-object :principal_id "owner" :identities (js-array identity) :connections (js-array binding)))
      (policy (js-object :administrators (js-array) :users (js-array user)))
      (connection (js-object :connection_id "im-one" :platform "lark" :event_app_id "test" :identity_revision 1))
      (event (js-object :connection_id "im-one" :identity_revision 1 :sender (js-object :id "native-user" :identities (js-array identity))))
      (context (js-object :config (js-object :principals (js-array principal) :task_inspection policy) :principal principal
        :repository (js-object :get (lambda (table key) (if (= table "events") event connection)))))
      (record (js-object :principal_id "owner" :task_command_event_id "event" :task_command_policy_hash (hashValue (js-object :policy policy :scope (inspectionScope context))))))
      (js-call (expect (nativeGet (inspectionScope context) "administrator")) :toBe false)
      (js-call (expect (nativeGet (inspectionScope context) "connection_ids")) :toEqual (js-array "im-one"))
      (js-call (expect (nativeGet (commandPrincipal context event) "principal_id")) :toBe "owner")
      (js-call (expect (taskOutboundAllowed context record)) :toBeTruthy)
      (put binding :identity_revision 2)
      (js-call (expect (inspectionScope context)) :toBe nil)
      (js-call (expect (taskOutboundAllowed context record)) :toBeFalsy)
      (put binding :identity_revision 1)
      (put principal :disabled t)
      (js-call (expect (inspectionScope context)) :toBe nil)
      (put principal :disabled false)
      (put policy :administrators (js-array "owner"))
      (js-call (expect (nativeGet (inspectionScope context) "administrator")) :toBe t)
      (js-call (expect (taskOutboundAllowed context record)) :toBeFalsy)
      (put policy :administrators (js-array))
      (put event :sender (js-object :id "stranger"))
      (js-call (expect (commandPrincipal context event)) :toBe nil)
      (put policy :users (js-array))
      (js-call (expect (inspectionScope context)) :toBe nil)
      (let ((text (renderChildren (js-array
        (js-object :session_key "a" :parent_session_key "root" :title "A" :tool "tool")
        (js-object :session_key "b" :parent_session_key "root" :title "B" :tool "tool")
        (js-object :session_key "a1" :parent_session_key "a" :title "A1" :tool "tool")) "root" 1)))
        (js-call (expect (< (js-call text :indexOf "A1") (js-call text :indexOf "B"))) :toBe t)))))
  (withUnitCase "T31.message-consumption.unit" (lambda ()
    (let* ((busy (codexInputRequest "original-thread" "message" t "client-message"))
      (idle (codexInputRequest "original-thread" "message" false "client-message"))
      (context (js-object :config (js-object))))
      (js-call (expect (nativeGet busy "method")) :toBe "thread-follower-steer-turn")
      (js-call (expect (nativeGet busy "version")) :toBe 1)
      (js-call (expect (nativeGet (nativeGet busy "parameters") "conversationId")) :toBe "original-thread")
      (js-call (expect (nativeGet (nativeGet busy "parameters") "clientUserMessageId")) :toBe "client-message")
      (js-call (expect (nativeGet (aref (nativeGet (nativeGet busy "parameters") "input") 0) "text")) :toBe "message")
      (js-call (expect (nativeGet idle "method")) :toBe "thread-follower-start-turn")
      (js-call (expect (nativeGet (nativeGet (nativeGet (nativeGet idle "parameters") "turnStart") "context") "inheritThreadSettings")) :toBe t)
      (js-call (expect (nativeGet (normalizedPolicy (js-object)) "busy")) :toBe "steer")
      (js-call (expect (effectiveBusyPolicy context (js-object :delivery_policy (js-object :busy "queue")))) :toBe "queue")
      (put (nativeGet context "config") :message_delivery (js-object :busy "steer"))
      (js-call (expect (effectiveBusyPolicy context (js-object :delivery_policy (js-object :busy "queue")))) :toBe "steer"))))

)
