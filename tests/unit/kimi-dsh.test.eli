(module dj.tests.unit.kimi-dsh
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/existing-local.eli" localOrigin)
  (import "../../src/adapters/agent/kimi-dsh.eli" nativeRuntime nativeCapabilities)
  (import "../../src/adapters/agent/kimi-dsh-protocol.eli" nativeTextParts)
  (import "../../src/delivery/envelope.eli" encodeAgentInput)
  (import "../../src/interfaces/skill.eli" skillDestination skillConfig)
  (import "../support/case.eli" withUnitCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (withUnitCase "T38.kimi-dsh.unit" (lambda ()
    (js-call (expect (nativeGet (localOrigin "http://127.0.0.1:12345") "port")) :toBe "12345")
    (js-call (expect (nativeGet (localOrigin "ws://127.0.0.1:12345/control" t) "pathname")) :toBe "/control")
    (js-call (js-array "http://example.test:12345" "http://localhost:12345" "http://127.0.0.1:12345/other"
      "http://user@127.0.0.1:12345" "http://127.0.0.1:12345/?secret=x" "https://127.0.0.1:12345") :forEach
      (lambda (url) (js-call (expect (lambda () (localOrigin url))) :toThrow)))
    (js-call (expect (nativeRuntime "kimi-web" (js-object :busy false :pending_interaction "none"))) :toBe "idle")
    (js-call (expect (nativeRuntime "kimi-web" (js-object :busy false :pending_interaction "approval"))) :toBe "waiting_permission")
    (js-call (expect (nativeRuntime "kimi-web" (js-object :busy false :archived t))) :toBe "offline")
    (js-call (expect (nativeRuntime "dsh-desktop" (js-object :running false :agentAvailable t :formatStatus "current"))) :toBe "idle")
    (js-call (expect (nativeRuntime "dsh-desktop" (js-object :running false))) :toBe "unknown")
    (js-call (expect (nativeRuntime "dsh-web" (js-object :running false :native_protocol "legacy"))) :toBe "idle")
    (js-call (expect (nativeRuntime "dsh-web" (js-object :running false :native_protocol "typert"))) :toBe "unknown")
    (js-call (expect (nativeRuntime "dsh-web" (js-object :running false :native_protocol "legacy" :agentAvailable false))) :toBe "offline")
    (js-call (expect (nativeRuntime "dsh-desktop" (js-object :running false :agentAvailable t :formatStatus "migration-required"))) :toBe "offline")
    (js-call (expect (nativeGet (nativeCapabilities "kimi-desktop") "message_during_run")) :toBe "unsupported")
    (js-call (expect (nativeGet (nativeCapabilities "kimi-web") "message_during_run")) :toBe "supported")
    (js-call (expect (nativeGet (nativeCapabilities "dsh-desktop") "instance_start")) :toBe "unsupported")
    (js-call (expect (nativeTextParts (js-array (js-object :type "reasoning" :text "private")
      (js-object :type "text" :text "<hook_result>injection") (js-object :type "text" :text "visible")))) :toBe "visible")
    (js-call (expect (nativeTextParts (js-array (js-object :kind "thinking" :text "private") (js-object :kind "text" :text "work-visible")) t)) :toBe "work-visible")
    (js-call (js-array "kimi" "dsh") :forEach (lambda (tool)
      (let* ((encoded (encodeAgentInput tool (js-object :schema_version 1 :kind "external_message"
        :content (js-object :text "原文\n第二行") :allowed_actions (js-array)) "dispatch"))
        (body (nativeGet (JSON/parse (nativeGet encoded "wire")) "text")))
        (js-call (expect (js-call body :includes "# notification\n")) :toBe t)
        (js-call (expect (js-call body :includes "原文\n第二行")) :toBe t)
        (js-call (expect (nativeGet encoded "frame_bytes")) :toBe (Buffer/byteLength (nativeGet encoded "wire") "utf8")))))
    (let ((home (resolve ".local/skill-fixture")))
      (js-call (expect (skillDestination (js-object :target "kimi" :scope "user") home)) :toBe (resolve home ".agents/skills/dj"))
      (js-call (expect (skillDestination (js-object :target "dsh" :scope "user") home)) :toBe (resolve home ".dsh/skills/dj")))
    (js-call (expect (nativeGet (nativeGet (nativeGet (nativeGet (skillConfig "kimi" "dj" "own-profile") "data") "config") "mcpServers") "dj")) :toBeDefined)
    (js-call (expect (nativeGet (nativeGet (skillConfig "dsh" "dj" "own-profile") "data") "config")) :toBe nil))))
