(module dj.tests.unit.resources
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/resources/service.eli" parseResource resourceAddress recoveryEvent)
  (import "../../src/messaging/topics.eli" topicOf sameTopic)
  (import "../../src/core/rules.eli" matchesSource evaluatePredicate)
  (import "../../src/adapters/im/lark-resource-events.eli" peopleIn normalizeResourceEvents recipientNoticeAllowed)
  (import "../../src/adapters/im/lark-resources.eli" ensureUserNotices)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "../../src/policy/authorize.eli" authorize)
  (withCase "T38.resource-boundaries.unit" (lambda () nil) (lambda (ignored)
    (let* ((connection (js-object :connection_id "accountOne" :brand "lark"))
      (resource (parseResource connection "https://test.larksuite.com/base/baseOne?table=tableOne&record=recordOne"))
      (address (resourceAddress resource)))
      (js-call (expect (nativeGet resource "table_id")) :toBe "tableOne")
      (js-call (expect (nativeGet address "native_chat_id")) :toBe undefined)
      (js-call (js-array "https://test.larksuite.com.evil.example/base/a" "http://test.larksuite.com/base/a"
        "https://test.feishu.cn/base/a" "https://user@test.larksuite.com/base/a" "https://test.larksuite.com/base/a?table=../bad") :forEach
        (lambda (url) (js-call (expect (lambda () (parseResource connection url))) :toThrow)))
      (let ((event (js-object :connection_id "accountOne" :native_message_id "changeOne" :conversation address :root_message_id "baseOne")))
        (js-call (expect (matchesSource address false event)) :toBe t)
        (js-call (expect (matchesSource (Object/assign (js-object) address (js-object :table_id "otherTable")) false event)) :toBe false)
        (js-call (expect (nativeGet (topicOf event) "kind")) :toBe "resource_record")))
    (let* ((address (js-object :connection_id "a" :native_chat_id "chat" :native_thread_id nil))
      (root (js-object :connection_id "a" :native_message_id "root" :conversation address))
      (reply (js-object :connection_id "a" :native_message_id "reply" :conversation address :root_message_id "root" :reply_to (js-object :id "root"))))
      (js-call (expect (sameTopic reply root)) :toBe t)
      (js-call (expect (nativeGet (topicOf reply) "kind")) :toBe "reply_chain")
      (js-call (expect (= (nativeGet (topicOf reply) "topic_key") (nativeGet (topicOf (Object/assign (js-object) reply
        (js-object :connection_id "b" :conversation (Object/assign (js-object) address (js-object :connection_id "b"))))) "topic_key"))) :toBe false))
    (let ((people (peopleIn (js-array (js-object :id "ou_person" :name "Person") (js-object :id "ou_person") (js-object :text "@ou_not_a_person_field")))))
      (js-call (expect (js-length people)) :toBe 1)
      (js-call (expect (evaluatePredicate (js-object :field "people.id" :op "eq" :value "ou_person") (js-object :people people :mentions (js-array)))) :toBe "true")
      (js-call (expect (evaluatePredicate (js-object :field "mentions.id" :op "eq" :value "ou_person") (js-object :people people :mentions (js-array)))) :toBe "false"))) (lambda (x) nil))
  (withCase "T38.resource-recovery-guards.unit" (lambda () nil) (lambda (ignored)
    (let* ((resource (js-object :connection_id "accountOne" :kind "bitable" :token "baseOne" :table_id "tableOne" :record_id "recordOne"))
      (record (js-object :record_id "recordOne" :fields (js-object :owner (js-array (js-object :id "ou_person")) :title "Issue")))
      (first (recoveryEvent resource record "2026-01-01T00:00:00.000Z"))
      (same (recoveryEvent (Object/assign (js-object) resource (js-object :url "https://test.larksuite.com/wiki/wikiOne" :title "Entry"))
        record "2026-01-01T01:00:00.000Z")))
      (js-call (expect (nativeGet first "source_key")) :toBe (nativeGet same "source_key"))
      (js-call (expect (nativeGet (nativeGet first "sender") "kind")) :toBe "unknown")
      (js-call (expect (js-length (nativeGet first "mentions"))) :toBe 0)
      (js-call (expect (nativeGet (aref (nativeGet first "people") 0) "id")) :toBe "ou_person")
      (let ((changed (recoveryEvent resource (Object/assign (js-object) record (js-object :fields (js-object :title "Changed"))) "2026-01-01T00:00:00.000Z")))
        (js-call (expect (= (nativeGet changed "source_key") (nativeGet first "source_key"))) :toBe false))
      (js-call (expect (lambda () (recoveryEvent resource (js-object :record_id "other" :fields (js-object)) "now"))) :toThrow)
      (js-call (expect (lambda () (recoveryEvent resource (js-object :record_id "recordOne" :fields (js-array)) "now"))) :toThrow)
      (js-call (expect (lambda () (recoveryEvent resource nil "now"))) :toThrow)
      (let* ((principal (js-object :principal_id "recipient" :kind "agent" :authorization_revision 1
          :grants (js-array (js-object :action "*" :resources (js-array "*")))))
        (denied (authorize principal "resource.recover" (resourceAddress resource) 1)))
        (js-call (expect (nativeGet denied "allowed")) :toBe false)))) (lambda (x) nil))
  (withCase "T38.user-document-notices.unit" (lambda () nil) (async (unused)
    (let* ((config (js-object :connection_id "one" :event_app_id "app" :identity "user" :user_identity (js-object :open_id "ou_me")))
      (wire (js-object :header (js-object :event_type "drive.notice.comment_add_v1" :event_id "notice" :app_id "app" :create_time "1767225600000")
        :event (js-object :notice_meta (js-object :file_type "docx" :file_token "docOne" :notice_type "add_reply"
          :from_user_id (js-object :open_id "ou_me") :to_user_id (js-object :open_id "ou_me"))
          :comment_id "commentOne" :reply_id "replyOne" :is_mentioned t)))
      (event (aref (normalizeResourceEvents config wire) 0)))
      (js-call (expect (recipientNoticeAllowed config event)) :toBe t)
      (js-call (expect (nativeGet (aref (nativeGet event "mentions") 0) "id")) :toBe "ou_me")
      (js-call (expect (js-length (normalizeResourceEvents (Object/assign (js-object) config (js-object :user_identity (js-object :open_id "ou_other"))) wire))) :toBe 0)
      (js-call (expect (js-length (normalizeResourceEvents (Object/assign (js-object) config (js-object :identity "bot")) wire))) :toBe 0)
      (put (nativeGet wire "header") :app_id "other")
      (js-call (expect (lambda () (normalizeResourceEvents config wire))) :toThrow)
      (put (nativeGet wire "header") :app_id "app") (put (nativeGet wire "event") :is_mentioned false)
      (let ((ordinary (aref (normalizeResourceEvents config wire) 0)))
        (js-call (expect (nativeGet ordinary "addressed_self")) :toBe false)
        (js-call (expect (js-length (nativeGet ordinary "mentions"))) :toBe 0)))
    (let ((calls 0) (posts 0))
      (let ((state (await (ensureUserNotices (js-object :request (async (path method body ctx)
        (setq calls (1+ calls)) (when (= method "POST") (setq posts (1+ posts)))
        (js-object :status 403 :wire (js-object :code 99991672)))) nil))))
        (js-call (expect (nativeGet state "state")) :toBe "blocked")
        (js-call (expect calls) :toBe 1) (js-call (expect posts) :toBe 0)))
    (let ((posts 0))
      (let ((state (await (ensureUserNotices (js-object :request (async (path method body ctx)
        (if (= method "GET") (js-object :status 200 :wire (js-object :code 0 :data (js-object :is_subscribe false)))
          (progn (setq posts (1+ posts)) (throw (new globalThis.Error "response lost")))))) nil))))
        (js-call (expect (nativeGet state "state")) :toBe "native_unknown")
        (js-call (expect posts) :toBe 1)))) (lambda (unused) nil))
)
