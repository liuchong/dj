(module dj.tests.unit.resources
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/resources/service.eli" parseResource resourceAddress)
  (import "../../src/messaging/topics.eli" topicOf sameTopic)
  (import "../../src/core/rules.eli" matchesSource evaluatePredicate)
  (import "../../src/adapters/im/lark-resource-events.eli" peopleIn)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (withCase "T38.resource-boundaries.unit" (lambda () nil) (lambda (ignored)
    (let* ((connection (js-object :connection_id "accountOne" :brand "lark"))
      (resource (parseResource connection "https://test.larksuite.com/base/baseOne?table=tableOne&record=recordOne"))
      (address (resourceAddress resource)))
      (js-call (expect (nativeGet resource "table_id")) :toBe "tableOne")
      (js-call (expect (nativeGet address "native_chat_id")) :toBe undefined)
      (js-call (js-array "https://test.larksuite.com.evil.example/base/a" "http://test.larksuite.com/base/a"
        "https://test.feishu.cn/base/a" "https://user@test.larksuite.com/base/a" "https://test.larksuite.com/base/a?table=../bad") :forEach
        (lambda (url) (js-call (expect (lambda () (parseResource connection url))) :toThrow)))
      (let ((event (js-object :connection_id "accountOne" :native_message_id "changeOne" :conversation address :root_message_id "baseOne")))
        (js-call (expect (matchesSource address false event)) :toBe t)
        (js-call (expect (matchesSource (Object/assign (js-object) address (js-object :table_id "otherTable")) false event)) :toBe false)
        (js-call (expect (nativeGet (topicOf event) "kind")) :toBe "resource_record")))
    (let* ((address (js-object :connection_id "a" :native_chat_id "chat" :native_thread_id nil))
      (root (js-object :connection_id "a" :native_message_id "root" :conversation address))
      (reply (js-object :connection_id "a" :native_message_id "reply" :conversation address :root_message_id "root" :reply_to (js-object :id "root"))))
      (js-call (expect (sameTopic reply root)) :toBe t)
      (js-call (expect (nativeGet (topicOf reply) "kind")) :toBe "reply_chain")
      (js-call (expect (= (nativeGet (topicOf reply) "topic_key") (nativeGet (topicOf (Object/assign (js-object) reply
        (js-object :connection_id "b" :conversation (Object/assign (js-object) address (js-object :connection_id "b"))))) "topic_key"))) :toBe false))
    (let ((people (peopleIn (js-array (js-object :id "ou_person" :name "Person") (js-object :id "ou_person") (js-object :text "@ou_not_a_person_field")))))
      (js-call (expect (js-length people)) :toBe 1)
      (js-call (expect (evaluatePredicate (js-object :field "people.id" :op "eq" :value "ou_person") (js-object :people people :mentions (js-array)))) :toBe "true")
      (js-call (expect (evaluatePredicate (js-object :field "mentions.id" :op "eq" :value "ou_person") (js-object :people people :mentions (js-array)))) :toBe "false"))) (lambda (x) nil)))
