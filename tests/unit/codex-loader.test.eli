(module dj.tests.unit.codex-loader
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/codex-loader.eli" requestCodexLoad)
  (import "../support/case.eli" withUnitCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (withUnitCase "T38.codex-loader-target.unit" (async ()
    (let ((ids (js-array nil 42 "" "codex://threads/example" "../other" "a\nthread")))
      (let ((index 0)) (while (< index (js-length ids))
        (let ((reason nil))
          (try (await (requestCodexLoad (js-object) (aref ids index) (js-object)))
            (catch error (setq reason (nativeGet error "code"))))
          (js-call (expect reason) :toBe "receiver_load_target_invalid"))
        (setq index (1+ index)))))))
  (withUnitCase "T38.codex-loader-helper.unit" (async ()
    (let ((reason nil))
      (try (await (requestCodexLoad (js-object) "00000000-0000-4000-8000-000000000032" (js-object)))
        (catch error (setq reason (nativeGet error "code"))))
      (js-call (expect reason) :toBe "receiver_loader_unconfigured"))
    (let* ((child (Bun/spawn (js-array (resolve "dist/native/dj-codex-loader"))
        (js-object :stdin "pipe" :stdout "pipe" :stderr "pipe")))
      (body (JSON/stringify (js-object :pid (nativeGet globalThis.process "pid")
        :birth "1:1" :thread "00000000-0000-4000-8000-000000000032"))))
      (js-call (nativeGet child "stdin") :end body)
      (let ((out (JSON/parse (await (js-call (new globalThis.Response (nativeGet child "stdout")) :text)))))
        (js-call (expect (nativeGet out "ok")) :toBe false)
        (js-call (expect (nativeGet out "reason")) :toBe "receiver_load_target_invalid")
        (js-call (expect (await (nativeGet child "exited"))) :toBe 1))))))
