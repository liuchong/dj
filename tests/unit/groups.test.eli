(module dj.tests.unit.groups
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/routing/group-selection.eli" distributionPolicy chooseGroupMember quotaEligible)
  (import "../../src/registry/availability.eli" availabilityScope quotaObservation)
  (import "../../src/core/availability.eli" quotaFailure)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort)
  (import "../../src/application/schema.eli" validateRequest)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (withUnitCase "T33.group-selection.unit" (lambda ()
    (let* ((members (js-array (js-object :agent_id "c" :priority 1) (js-object :agent_id "a" :priority 2)
      (js-object :agent_id "b" :priority 1)))
      (config (js-object :group_distribution (js-object :algorithm "priority" :eligibility (js-object :quota "require_available")))))
      (js-call (expect (nativeGet (chooseGroupMember members "round_robin" "c" 0) "agent_id")) :toBe "a")
      (js-call (expect (nativeGet (chooseGroupMember members "round_robin" "a" 0) "agent_id")) :toBe "b")
      (js-call (expect (nativeGet (chooseGroupMember members "priority" nil 0) "agent_id")) :toBe "b")
      (js-call (expect (nativeGet (chooseGroupMember members "random" nil 2) "agent_id")) :toBe "c")
      (js-call (expect (lambda () (chooseGroupMember members "random" nil 3))) :toThrow)
      (js-call (expect (chooseGroupMember (js-array) "round_robin" nil 0)) :toBeFalsy)
      (let ((p (distributionPolicy config (js-object :algorithm "random"))))
        (js-call (expect (nativeGet p "algorithm")) :toBe "random")
        (js-call (expect (nativeGet (nativeGet p "eligibility") "quota")) :toBe "require_available"))
      (js-call (expect (nativeGet (aref members 0) "agent_id")) :toBe "c")
      (js-call (expect (quotaEligible "exclude_exhausted" "unknown")) :toBe t)
      (js-call (expect (quotaEligible "exclude_exhausted" "exhausted")) :toBe false)
      (js-call (expect (quotaEligible "require_available" "unknown")) :toBe false)
      (js-call (expect (quotaEligible "require_available" "available")) :toBe t)
      (js-call (expect (quotaEligible "ignore" "exhausted")) :toBe t)
      (js-call (expect (nativeGet (validateRequest "subscription.preview" (js-object :spec
        (js-object :agent_id "a" :group_id "g"))) "ok")) :toBe false))))
  (withUnitCase "T33.group-quota-evidence.unit" (lambda ()
    (let* ((session (js-object :instance_id "app" :instance_epoch "epoch" :native_namespace "local"
        :native_session_id "one" :model_selection (js-object :provider_id "p" :model_id "m" :observed_at "earlier")))
      (other (Object/assign (js-object) session (js-object :native_session_id "two" :model_selection
        (js-object :provider_id "p" :model_id "m" :observed_at "later")))))
      (js-call (expect (availabilityScope session)) :toBe (availabilityScope other))
      (put other :instance_epoch "changed")
      (js-call (expect (= (availabilityScope session) (availabilityScope other))) :toBe false)
      (js-call (expect (quotaFailure 429)) :toBeFalsy)
      (js-call (expect (quotaFailure "timeout")) :toBeFalsy)
      (js-call (expect (nativeGet (quotaFailure "insufficient_quota") "state")) :toBe "exhausted")
      (js-call (expect (nativeGet (quotaFailure "rate_limit_exceeded") "state")) :toBe "unknown")
      (js-call (expect (nativeGet (quotaObservation (js-object :state "available" :reset_at "2025-12-31T00:00:00.000Z")
        session "2026-01-01T00:00:00.000Z") "state")) :toBe "unknown")
      (let ((row (quotaObservation (js-object :state "available" :reset_at "2026-01-01T00:00:10.000Z")
        session "2026-01-01T00:00:00.000Z")))
        (js-call (expect (nativeGet row "valid_until")) :toBe "2026-01-01T00:00:10.000Z")))))
  (withUnitCase "T33.group-native-quota.unit" (async ()
    (let* ((fraction 0.5) (model "exact") (epoch "epoch")
      (target (js-object :instance_id "ag" :native_namespace "local" :instance_epoch "epoch"
        :model_selection (js-object :model_id "exact")))
      (port (createAntigravityPort (js-object :endpoints (js-array (js-object :instance_id "ag" :native_namespace "local")))
        (js-object :antigravity_rpc (async (endpoint method args context)
          (js-call (expect method) :toBe "GetUserStatus")
          (js-object :instance_epoch epoch :data (js-object :userStatus (js-object :cascadeModelConfigData
            (js-object :clientModelConfigs (js-array (js-object :modelId model
              :quotaInfo (js-object :remainingFraction fraction :resetTime "2026-01-02T00:00:00.000Z"))))))))))))
      (js-call (expect (nativeGet (await (js-call port :availability target (js-object))) "state")) :toBe "available")
      (setq fraction 0)
      (js-call (expect (nativeGet (await (js-call port :availability target (js-object))) "state")) :toBe "unknown")
      (setq model "different")
      (js-call (expect (nativeGet (await (js-call port :availability target (js-object))) "reason")) :toBe "model_quota_unknown")
      (setq epoch "another")
      (let ((rejected false))
        (try (await (js-call port :availability target (js-object))) (catch mismatch (setq rejected t)))
        (js-call (expect rejected) :toBe t))))))
