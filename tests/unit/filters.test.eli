(module dj.tests.unit.filters
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/filtering/policy.eli" validateFilterRules evaluateTriggerFilters)
  (import "../../src/people/registry.eli" validatePeople resolvePerson validatePersonReferences)
  (import "../../src/connections/manager.eli" createConnectionManager)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defun rule (id predicate &optional enabled)
    (js-object :id id :enabled (not (= enabled false)) :effect "suppress_trigger" :predicate predicate))
  (defun sample (sender text)
    (js-object :connection_id "lark" :sender (js-object :id sender) :content (js-object :text text :truncated false)))
  (withUnitCase "T38.message-filters.unit" (async (unused)
    (let* ((who (rule "person" (js-object :field "sender.id" :op "in" :value (js-array "blocked"))))
      (text (rule "text" (js-object :field "text" :op "contains" :value "🚫字面.*")))
      (rules (js-array who text))
      (policy (js-object :revision 2 :rules rules))
      (context (js-object :repository (js-object :get (lambda (table key) policy)))))
      (js-call (expect (nativeGet (validateFilterRules rules) "ok")) :toBe t)
      (js-call (expect (nativeGet (validateFilterRules (js-array)) "ok")) :toBe t)
      (js-call (expect (nativeGet (validateFilterRules (js-array who who)) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules nil) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array nil)) "ok")) :toBe false)
      (let ((bad (Object/assign (js-object) who (js-object :effect "hide_message"))))
        (js-call (expect (nativeGet (validateFilterRules (js-array bad)) "ok")) :toBe false))
      (let ((bad (Object/assign (js-object) who (js-object :enabled "yes"))))
        (js-call (expect (nativeGet (validateFilterRules (js-array bad)) "ok")) :toBe false))
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "empty" (js-object :not (js-object :field "text" :op "contains" :value ""))))) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "wrong-type" (js-object :field "addressed_self" :op "eq" :value "yes")))) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "huge" (js-object :field "text" :op "contains" :value (js-call "字" :repeat 22000))))) "ok")) :toBe false)
      (let ((many (js-array)) (index 0))
        (while (< index 64)
          (js-call many :push (rule (str "r" index) (js-object :field "sender.id" :op "eq" :value "person")))
          (setq index (1+ index)))
        (js-call (expect (nativeGet (validateFilterRules many) "ok")) :toBe t)
        (js-call many :push (rule "r64" (js-object :all (js-array))))
        (js-call (expect (nativeGet (validateFilterRules many) "ok")) :toBe false))
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "blocked" "ordinary")) "suppressed")) :toBe t)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "contains 🚫字面.* here")) "suppressed")) :toBe t)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "🚫字面ABC")) "suppressed")) :toBe false)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "ordinary")) "suppressed")) :toBe false)
      (let ((incomplete (sample "other" "ordinary")))
        (put (nativeGet incomplete "content") :truncated t)
        (let ((result (evaluateTriggerFilters context incomplete)))
          (js-call (expect (nativeGet result "suppressed")) :toBe t)
          (js-call (expect (nativeGet result "indeterminate_rule_ids")) :toEqual (js-array "text"))))
      (setq policy (js-object :revision 3 :rules (js-array
        (rule "disabled" (js-object :all (js-array)) false))))
      (let ((result (evaluateTriggerFilters context (sample "blocked" "🚫字面.*"))))
        (js-call (expect (nativeGet result "policy_revision")) :toBe 3)
        (js-call (expect (nativeGet result "suppressed")) :toBe false)
        (js-call (expect (Object/isFrozen result)) :toBe t)
        (js-call (expect (Object/isFrozen (nativeGet result "matched_rule_ids"))) :toBe t))
      (setq policy (js-object :revision 4 :rules (js-array (rule "exact" (js-object :all (js-array
        (js-object :field "connection_id" :op "eq" :value "other-connection")
        (js-object :field "sender.id" :op "eq" :value "blocked")))))))
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "blocked" "ordinary")) "suppressed")) :toBe false)
      (let* ((a (js-object :platform "lark" :scope "app:a:open_id" :id "ou_a"))
        (b (js-object :platform "lark" :scope "app:b:open_id" :id "ou_b"))
        (tenant (js-object :platform "lark" :scope "tenant:t1:user_id" :id "u1"))
        (people (js-array (js-object :id "person-1" :identities (js-array a b tenant))))
        (person-rules (js-array (rule "global" (js-object :field "sender.person_id" :op "eq" :value "person-1")))))
        (js-call (expect (nativeGet (validatePeople people) "ok")) :toBe t)
        (js-call (expect (nativeGet (validatePeople (js-array (js-object :id "empty" :identities (js-array)))) "ok")) :toBe false)
        (js-call (expect (nativeGet (validatePeople (js-array (aref people 0) (js-object :id "person-2" :identities (js-array a)))) "ok")) :toBe false)
        (js-call (expect (nativeGet (validatePeople (js-array (js-object :id "person-2" :identities (js-array
          (js-object :platform "lark" :scope "" :id "u1"))))) "ok")) :toBe false)
        (js-call (expect (resolvePerson people (js-array a))) :toBe "person-1")
        (js-call (expect (resolvePerson people (js-array b))) :toBe "person-1")
        (js-call (expect (resolvePerson people (js-array tenant))) :toBe "person-1")
        (js-call (expect (resolvePerson people (js-array (js-object :platform "lark" :scope "app:b:open_id" :id "ou_a")))) :toBe "")
        (js-call (expect (resolvePerson people (js-array (js-object :platform "feishu" :scope "app:a:open_id" :id "ou_a")))) :toBe "")
        (js-call (expect (resolvePerson people (js-array (js-object :platform "lark" :scope "tenant:t2:user_id" :id "u1")))) :toBe "")
        (js-call (expect (nativeGet (validatePersonReferences person-rules people) "ok")) :toBe t)
        (js-call (expect (nativeGet (validatePersonReferences person-rules (js-array)) "ok")) :toBe false)
        (setq policy (js-object :revision 5 :rules person-rules :people people))
        (let ((item (sample "unrelated-raw-id" "visible body")))
          (put (nativeGet item "sender") :identities (js-array b))
          (put item :connection_id "any-new-connection")
          (js-call (expect (nativeGet (evaluateTriggerFilters context item) "suppressed")) :toBe t)
          (put (nativeGet item "sender") :identities (js-array))
          (js-call (expect (nativeGet (evaluateTriggerFilters context item) "suppressed")) :toBe false))
        (let* ((second (js-object :platform "lark" :scope "app:c:open_id" :id "ou_c"))
          (ambiguous (js-array (aref people 0) (js-object :id "person-2" :identities (js-array second)))))
          (js-call (expect (resolvePerson ambiguous (js-array a second))) :toBe nil))))
      (let* ((started 0) (a-closed 0) (b-closed 0) (sent (js-array))
        (a (js-object :initialize (lambda (context) (setq started (1+ started)))
          :send (async (record key context) (js-call sent :push (str "a:" (nativeGet record "connection_id"))) (js-object :state "accepted"))
          :receive (async (connection cursor budget context) (js-object :items (js-array (js-object :connection_id "account-b"))))
          :close (async () (setq a-closed (1+ a-closed)) (js-object :state (if (= a-closed 1) "draining" "stopped")))))
        (b (js-object :initialize (lambda (context) (setq started (1+ started)))
          :send (async (record key context) (js-call sent :push (str "b:" (nativeGet record "connection_id"))) (js-object :state "accepted"))
          :close (async () (setq b-closed (1+ b-closed)) (js-object :state "stopped"))))
        (configs (js-array
          (js-object :connection_id "account-a" :platform "lark" :brand "lark" :account_ref "user-a"
            :tenant_ref "tenant-1" :identity "user" :identity_revision 1 :user_identity (js-object :app_id "app-a"))
          (js-object :connection_id "account-b" :platform "lark" :brand "lark" :account_ref "user-b"
            :tenant_ref "tenant-1" :identity "bot" :identity_revision 1 :event_app_id "app-b")
          (js-object :connection_id "chat-app" :platform "telegram" :account_ref "user-b" :identity "bot")))
        (injected (new globalThis.Map (js-array (js-array "account-a" a) (js-array "account-b" b) (js-array "chat-app" b))))
        (manager (createConnectionManager configs (js-object) injected))
        (people (js-array (js-object :id "person-one" :identities (js-array
          (js-object :platform "lark" :scope "app:app-a:open_id" :id "ou_a")
          (js-object :platform "lark" :scope "app:app-b:open_id" :id "ou_b"))))))
        (js-call manager :assemble)
        (js-call manager :initialize (js-object))
        (js-call manager :initialize (js-object))
        (js-call (expect started) :toBe 2)
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :platform "lark")) "error") "code")) :toBe "ambiguous_target")
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :connection_id "account-a" :account_ref "user-b")) "error") "code")) :toBe "not_found")
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :platform "telegram" :account_ref "user-b")) "data") "connection_id")) :toBe "chat-app")
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :connection_id "account-a" :identity_revision 2)) "error") "code")) :toBe "not_found")
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :person_id "person-one") people) "error") "code")) :toBe "ambiguous_target")
        (js-call (expect (nativeGet (nativeGet (js-call manager :route (js-object :person_id "person-one" :connection_id "account-b") people) "data") "person_identities")) :toEqual
          (js-array (js-object :platform "lark" :scope "app:app-b:open_id" :id "ou_b")))
        (await (js-call manager :dispatch "account-a" "send" (js-array (js-object :connection_id "account-a") "key-a" (js-object))))
        (await (js-call manager :dispatch "account-b" "send" (js-array (js-object :connection_id "account-b") "key-b" (js-object))))
        (js-call (expect sent) :toEqual (js-array "a:account-a" "b:account-b"))
        (await (js-call (nativeGet (expect (js-call manager :dispatch "account-a" "send" (js-array (js-object :connection_id "account-b")))) "rejects") :toThrow globalThis.TypeError))
        (await (js-call (nativeGet (expect (js-call manager :dispatch "account-a" "receive" (js-array (js-object :connection_id "account-a")))) "rejects") :toThrow globalThis.TypeError))
        (await (js-call (nativeGet (expect (js-call manager :dispatch "account-a" "send"
          (js-array (js-object :connection_id "account-a" :identity_revision 2)))) "rejects") :toThrow globalThis.TypeError))
        (js-call (expect (js-length sent)) :toBe 2)
        (js-call (expect (nativeGet (await (js-call manager :close)) "state")) :toBe "draining")
        (js-call (expect (nativeGet (await (js-call manager :close)) "state")) :toBe "stopped")
        (await (js-call manager :close))
        (js-call (expect a-closed) :toBe 2)
        (js-call (expect b-closed) :toBe 1)
        (js-call (expect (nativeGet (js-call manager :route (js-object :connection_id "account-a")) "ok")) :toBe false)
        (js-call (expect (lambda () (createConnectionManager (js-array (aref configs 0) (aref configs 0)) (js-object) injected))) :toThrow globalThis.TypeError)))))
