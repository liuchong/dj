(module dj.tests.unit.filters
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/filtering/policy.eli" validateFilterRules evaluateTriggerFilters)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defun rule (id predicate &optional enabled)
    (js-object :id id :enabled (not (= enabled false)) :effect "suppress_trigger" :predicate predicate))
  (defun sample (sender text)
    (js-object :connection_id "lark" :sender (js-object :id sender) :content (js-object :text text :truncated false)))
  (withUnitCase "T38.message-filters.unit" (lambda (unused)
    (let* ((who (rule "person" (js-object :field "sender.id" :op "in" :value (js-array "blocked"))))
      (text (rule "text" (js-object :field "text" :op "contains" :value "🚫字面.*")))
      (rules (js-array who text))
      (policy (js-object :revision 2 :rules rules))
      (context (js-object :repository (js-object :get (lambda (table key) policy)))))
      (js-call (expect (nativeGet (validateFilterRules rules) "ok")) :toBe t)
      (js-call (expect (nativeGet (validateFilterRules (js-array)) "ok")) :toBe t)
      (js-call (expect (nativeGet (validateFilterRules (js-array who who)) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules nil) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array nil)) "ok")) :toBe false)
      (let ((bad (Object/assign (js-object) who (js-object :effect "hide_message"))))
        (js-call (expect (nativeGet (validateFilterRules (js-array bad)) "ok")) :toBe false))
      (let ((bad (Object/assign (js-object) who (js-object :enabled "yes"))))
        (js-call (expect (nativeGet (validateFilterRules (js-array bad)) "ok")) :toBe false))
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "empty" (js-object :not (js-object :field "text" :op "contains" :value ""))))) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "wrong-type" (js-object :field "addressed_self" :op "eq" :value "yes")))) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateFilterRules (js-array
        (rule "huge" (js-object :field "text" :op "contains" :value (js-call "字" :repeat 22000))))) "ok")) :toBe false)
      (let ((many (js-array)) (index 0))
        (while (< index 64)
          (js-call many :push (rule (str "r" index) (js-object :field "sender.id" :op "eq" :value "person")))
          (setq index (1+ index)))
        (js-call (expect (nativeGet (validateFilterRules many) "ok")) :toBe t)
        (js-call many :push (rule "r64" (js-object :all (js-array))))
        (js-call (expect (nativeGet (validateFilterRules many) "ok")) :toBe false))
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "blocked" "ordinary")) "suppressed")) :toBe t)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "contains 🚫字面.* here")) "suppressed")) :toBe t)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "🚫字面ABC")) "suppressed")) :toBe false)
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "other" "ordinary")) "suppressed")) :toBe false)
      (let ((incomplete (sample "other" "ordinary")))
        (put (nativeGet incomplete "content") :truncated t)
        (let ((result (evaluateTriggerFilters context incomplete)))
          (js-call (expect (nativeGet result "suppressed")) :toBe t)
          (js-call (expect (nativeGet result "indeterminate_rule_ids")) :toEqual (js-array "text"))))
      (setq policy (js-object :revision 3 :rules (js-array
        (rule "disabled" (js-object :all (js-array)) false))))
      (let ((result (evaluateTriggerFilters context (sample "blocked" "🚫字面.*"))))
        (js-call (expect (nativeGet result "policy_revision")) :toBe 3)
        (js-call (expect (nativeGet result "suppressed")) :toBe false)
        (js-call (expect (Object/isFrozen result)) :toBe t)
        (js-call (expect (Object/isFrozen (nativeGet result "matched_rule_ids"))) :toBe t))
      (setq policy (js-object :revision 4 :rules (js-array (rule "exact" (js-object :all (js-array
        (js-object :field "connection_id" :op "eq" :value "other-connection")
        (js-object :field "sender.id" :op "eq" :value "blocked")))))))
      (js-call (expect (nativeGet (evaluateTriggerFilters context (sample "blocked" "ordinary")) "suppressed")) :toBe false)))))
