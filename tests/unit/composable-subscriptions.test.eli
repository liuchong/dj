(module dj.tests.unit.composable-subscriptions
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/rules.eli" validatePredicate evaluatePredicate predicateUsesPerson)
  (import "../../src/filtering/policy.eli" evaluateSubscriptionPredicate)
  (import "../support/case.eli" withUnitCase)
  (import "bun:test" expect)
  (defun leaf (field value) (js-object :field field :op "eq" :value value))
  (withUnitCase "T38.composable-subscriptions.unit" (async (unused)
    (let* ((event (js-object :native_message_id "message-a" :conversation (js-object :native_chat_id "chat-a")
        :sender (js-object :id "bot-a" :kind "bot") :mentions (js-array) :content (js-object :text "hello")))
      (not-thread (js-object :not (leaf "thread.id" "excluded"))))
      (js-call (js-array (leaf "mentions.any" t) (leaf "conversation.native_chat_id" "chat-a")
        (leaf "native_message_id" "message-a") (leaf "sender.person_id" "registered")) :forEach (lambda (predicate)
          (js-call (expect (nativeGet (validatePredicate predicate) "ok")) :toBe t)))
      (js-call (expect (nativeGet (validatePredicate (leaf "mentions.any" "true")) "ok")) :toBe false)
      (js-call (expect (evaluatePredicate (leaf "mentions.any" false) event)) :toBe "true")
      (js-call (expect (evaluatePredicate not-thread event)) :toBe "true")
      (js-call (expect (evaluatePredicate (js-object :not (leaf "reply_to.id" "excluded")) event)) :toBe "true")
      (put (nativeGet event "conversation") :native_thread_id "excluded")
      (js-call (expect (evaluatePredicate not-thread event)) :toBe "false")
      (put (nativeGet event "conversation") :native_thread_id nil)
      (put event :mentions (js-array (js-object :id "someone-else")))
      (js-call (expect (evaluatePredicate (leaf "mentions.any" t) event)) :toBe "true")
      (Reflect/deleteProperty event "mentions")
      (js-call (expect (evaluatePredicate (js-object :not (leaf "mentions.any" t)) event)) :toBe "indeterminate")
      (put event :addressed_self t)
      (js-call (expect (evaluatePredicate (leaf "mentions.any" t) event)) :toBe "true")
      (js-call (expect (evaluatePredicate (leaf "native_message_id" "message-a") event)) :toBe "true")
      (js-call (expect (evaluatePredicate (leaf "conversation.native_chat_id" "chat-a") event)) :toBe "true")
      (js-call (expect (evaluatePredicate (js-object :not (leaf "sender.kind" "bot")) event)) :toBe "false")
      (let* ((alias (js-object :platform "lark" :scope "app:example:open_id" :id "ou_a"))
        (people (js-array (js-object :id "person-a" :identities (js-array alias))))
        (policy (js-object :people people :rules (js-array)))
        (context (js-object :repository (js-object :get (lambda (table id) (if (= table "message_filter_policies") policy nil)))))
        (predicate (js-object :any (js-array (leaf "sender.person_id" "person-a") (leaf "sender.id" "unrelated"))))
        (memo (new globalThis.Map)))
        (put (nativeGet event "sender") :identities (js-array alias))
        (js-call (expect (predicateUsesPerson predicate)) :toBe t)
        (js-call (expect (evaluateSubscriptionPredicate context predicate event memo)) :toBe "true")
        (put policy :people (js-array))
        (js-call (expect (evaluateSubscriptionPredicate context predicate event memo)) :toBe "false")
        (js-call (expect (nativeGet memo "size")) :toBe 0)
        (js-call (expect (nativeGet (nativeGet event "sender") "person_id")) :toBeUndefined)))))
)
