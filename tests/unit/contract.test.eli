        (lambda
          (edge)
          (withUnitCase
            (str "T26.bounds.unit.scope-" field "-" edge)
            (lambda
              (unused)
              (let
                ((values (js-array))
                  (max (if (= field "tools") 32 100))
                  (index 0)
                  (scope (js-object)))
                (while (< index (+ max (if (= edge "over") 1 0)))
                  (js-call values :push (str "test-" index))
                  (setq index (1+ index)))
                (put scope field values)
                (js-call
                  (expect
                    (nativeGet (validateRequest "session.list" (js-object :scope scope)) "ok"))
                  :toBe
                  (= edge "at"))))))))))
