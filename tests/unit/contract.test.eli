(module dj.tests.unit.contract
  (import "../../src/core/native.eli" NativeBigInt nativeGet)
  (import "bun:test" expect)
  (import "../support/case.eli" withUnitCase)
  (import "../../src/application/schema.eli" validateRequest)
  (import "../../src/interfaces/gepo.eli" handleGepoRequest)
  (import "../../src/interfaces/skill.eli" skillDestination skillConfig)
  (import "../../src/interfaces/hooks.eli" hookIdentity hookConfig pullHook shellWord readHookInput)
  (import "node:path" resolve)
  (import "../../src/core/errors.eli" success failure)
  (import "../../src/core/instructions.eli" validateInstructionPolicy renderTask composeInstructions)
  (import "../../src/policy/handles.eli" createHandleAuthority)
  (import "../../src/core/types.eli" sliceUtf8 encodeSeq)
  (import "../../src/delivery/snapshot.eli" packEnvelope unpackEnvelope)
  (import "../../src/adapters/agent/desktop.eli" codexRuntime cursorRuntime)
  (import "../../src/adapters/agent/opencode-http.eli" createOpenCodePort)
  (import "../../src/adapters/agent/pi-native.eli" createPiNativePort)
  (import "../../src/connectors/pi.eli" activatePiReceiver)
  (import "../../src/adapters/agent/cursor-native.eli" cursorRenderer)
  (import "node:vm" runInNewContext)
  (import "../../src/adapters/im/lark-http.eli" formatLarkMessage)
  (import "../../src/adapters/im/lark-wire.eli" encodeLarkFrame decodeLarkFrame)
  (import "../../src/adapters/im/lark-events.eli" normalizeLarkEvent)
  (import "../../src/adapters/im/lark-inbox.eli" normalizeInboxMessage)
  (import "../../src/adapters/agent/json-rpc.eli" createJsonRpcChannel)
  (import "../../src/service/recovery.eli" managedStopConfirmed)
  (import "../../src/service/config.eli" validateStructure)
  (import "../../src/adapters/agent/cursor-control.eli" cursorCreationId activateCursorControl)
  (import "node:zlib" deflateRawSync)
  (withUnitCase "T64.managed-stop-recovery.unit"
    (lambda (unused)
      (let* ((instance (js-object :ownership "managed" :state "stopping" :instance_id "old-instance"
                        :instance_epoch "old-epoch" :launch_token "old-launch"))
             (stop (js-object :action "stop" :state "stopped" :evidence_level "native_protocol"
                     :instance_id "old-instance" :instance_epoch "old-epoch" :launch_token "old-launch")))
        (js-call (expect (managedStopConfirmed instance stop)) :toBe t)
        (js-call (js-array (js-object :instance_id "new-instance") (js-object :instance_epoch "new-epoch")
                  (js-object :launch_token "new-launch") (js-object :state "unknown")
                  (js-object :action "start") (js-object :evidence_level "manual"))
          :forEach (lambda (changed)
            (js-call (expect (managedStopConfirmed instance (Object/assign (js-object) stop changed))) :toBe false)))
        (js-call (expect (managedStopConfirmed (Object/assign (js-object) instance
                  (js-object :state "stopped")) nil)) :toBe t)
        (js-call (expect (managedStopConfirmed (Object/assign (js-object) instance
                  (js-object :ownership "existing" :state "stopped")) stop)) :toBe false))))
  (withUnitCase "T38.cli-rpc.unit"
    (async (unused)
      (let* ((controller nil) (writes (js-array)) (events 0)
             (stdout (new globalThis.ReadableStream (js-object :start (lambda (c) (setq controller c)))))
             (stderr (new globalThis.ReadableStream (js-object :start (lambda (c) (js-call c :close)))))
             (child (js-object :stdout stdout :stderr stderr
               :exited (new globalThis.Promise (lambda (resolve reject) nil))
               :stdin (js-object :write (lambda (text) (js-call writes :push (JSON/parse text))))))
             (channel (createJsonRpcChannel child (js-object :monoNow (lambda () (performance/now)))
               (lambda (wire permission) (when permission (setq events (1+ events))))))
             (first (js-call channel :request "initialize" (js-object)
                      (js-object :deadline (+ (performance/now) 1000)))))
        (js-call controller :enqueue (js-call (new globalThis.TextEncoder) :encode
          (str (JSON/stringify (js-object :id (nativeGet (aref writes 0) "id") :result (js-object :ready t))) "\n")))
        (js-call (expect (nativeGet (await first) "ready")) :toBe t)
        (js-call controller :enqueue (js-call (new globalThis.TextEncoder) :encode
          (str (JSON/stringify (js-object :jsonrpc "2.0" :id "permission-1"
            :method "session/request_permission" :params (js-object :sessionId "s1"))) "\n")))
        (await (Promise/resolve)) (await (Promise/resolve))
        (js-call (expect events) :toBe 1)
        (js-call (expect (js-call channel :pendingRequests)) :toBe 1)
        (js-call (expect (js-length writes)) :toBe 1)
        (let ((pending (js-call channel :request "session/prompt" (js-object)
                         (js-object :deadline (+ (performance/now) 1000)))))
          (js-call controller :close)
          (await (js-call (nativeGet (expect pending) "rejects") :toThrow "rpc_closed_unknown")))
        (js-call (expect (js-call channel :isClosed)) :toBe t))))
  (withUnitCase "T38.lark-wire.unit"
    (lambda (unused)
      (let* ((frame (js-object :SeqID "9007199254740993" :LogID "18446744073709551615" :service 7 :method 1
               :headers (js-array (js-object :key "type" :value "event")) :payload (Buffer/from "native payload")))
             (wire (encodeLarkFrame frame)) (decoded (decodeLarkFrame wire)))
        (js-call (expect (nativeGet decoded "SeqID")) :toBe "9007199254740993")
        (js-call (expect (nativeGet decoded "LogID")) :toBe "18446744073709551615")
        (js-call (expect (js-call (nativeGet decoded "payload") :toString)) :toBe "native payload")
        (js-call (expect (lambda () (decodeLarkFrame (js-call wire :subarray 0 (- (nativeGet wire "length") 1))))) :toThrow))
      (let* ((config (js-object :connection_id "test" :identity "bot" :event_subject_id "ou_self"))
             (wire (js-object :type "im.message.receive_v1" :message_id "om_test" :chat_id "oc_test" :sender_id "ou_human"
               :sender_type "user" :create_time "1790000000000" :content "@self text" :mentions (js-array))))
        (js-call (expect (nativeGet (normalizeLarkEvent config wire) "addressed_self")) :toBe false)
        (js-call (expect (nativeGet (normalizeLarkEvent config wire) "receive_transport")) :toBeUndefined)
        (put wire :mentions (js-array (js-object :id "ou_self")))
        (js-call (expect (nativeGet (normalizeLarkEvent config wire) "addressed_self")) :toBe t))
      (let ((message (formatLarkMessage (js-object :message_id "wire-1" :msg_type "text"
              :body (js-object :content "{\"text\":\"native text\"}")) nil)))
        (js-call (expect (nativeGet message "content")) :toBe "native text")
        (js-call (expect (nativeGet message "thread_id")) :toBe nil))
      (let* ((config (js-object :connection_id "user" :identity "user" :event_app_id "app"
                :event_subject_id "self"))
        (message (js-object :message_id "native" :chat_id "chat" :content "first\nsecond"
          :create_time "1790000000000" :sender (js-object :id "human" :id_type "open_id" :sender_type "user")
          :thread_id "thread" :root_id "root" :parent_id "parent"
          :mentions (js-array (js-object :id "self" :id_type "open_id")
            (js-object :id "unrelated" :id_type "user_id"))))
        (event (normalizeInboxMessage config message "p2p_chat" normalizeLarkEvent)))
        (js-call (expect (nativeGet event "receive_transport")) :toBe "poll")
        (js-call (expect (nativeGet event "source_key")) :toBe "native:created")
        (js-call (expect (nativeGet event "chat_type")) :toBe "p2p")
        (js-call (expect (nativeGet event "addressed_self")) :toBe t)
        (js-call (expect (js-length (nativeGet event "mentions"))) :toBe 1)
        (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe "first\nsecond")
        (js-call (expect (nativeGet (nativeGet event "conversation") "native_thread_id")) :toBe "thread")
        (js-call (expect (nativeGet event "root_message_id")) :toBe "root")
        (js-call (expect (nativeGet (nativeGet event "reply_to") "id")) :toBe "parent")
        (put message :sender (js-object :id "peer-app" :id_type "app_id" :sender_type "app"))
        (let ((bot (normalizeInboxMessage config message "group" normalizeLarkEvent)))
          (js-call (expect (nativeGet (nativeGet bot "sender") "kind")) :toBe "bot")
          (js-call (expect (nativeGet bot "chat_type")) :toBe "group")))
      (js-call (expect (nativeGet (formatLarkMessage
        (js-object :msg_type "text" :body (js-object :content "invalid-json")) nil) "content")) :toBe "[text] invalid-json")
      (js-call (expect (nativeGet (formatLarkMessage
        (js-object :msg_type "text" :body (js-object :content "{\"text\":\"thread\"}"))
        "exact-thread") "thread_id")) :toBe "exact-thread")))
  (withUnitCase "T38.desktop-runtime.unit"
    (async (unused)
      (let* ((renderer (runInNewContext (str "(" cursorRenderer ")") (js-object :Map globalThis.Map)))
             (loaded (new globalThis.Map)) (released 0) (loads 0)
             (header (js-object :source "local"))
             (local (js-object :_loadedAgents loaded :agentMap (new globalThis.Map
                       (js-array (js-array "known" (js-object :workspaceIdentifier (js-object :id "allowed")))))
                      :loadAgent (async (id)
                        (setq loads (1+ loads))
                        ;; Even if a native load unexpectedly resolves into a
                        ;; different workspace, no row or message may escape.
                        (js-call loaded :set id (js-object :_composerDataHandle
                          (js-object :data (js-object :workspaceIdentifier (js-object :id "changed")))))
                        (js-object :dispose (lambda () (setq released (1+ released)))))))
             (host (js-array (js-object :agentRepositoryProxy (js-object :delegate
                       (js-object :localRepo local :getAgentHeader (lambda (id) header)))))))
        (await (js-call (nativeGet (expect (js-call renderer :call host
          (js-object :operation "probe" :thread "known" :workspace "allowed"))) "rejects") :toThrow "cursor_native_no_owner"))
        (js-call (expect released) :toBe 1)
        (await (js-call (nativeGet (expect (js-call renderer :call host
          (js-object :operation "probe" :thread "" :workspace "allowed"))) "rejects") :toThrow "cursor_native_target"))
        (await (js-call (nativeGet (expect (js-call renderer :call host
          (js-object :operation "probe" :thread (js-call "x" :repeat 1025) :workspace "allowed"))) "rejects") :toThrow "cursor_native_target"))
        (js-call (expect loads) :toBe 1))
      (let ((id (cursorCreationId "ws" "key")))
        (js-call (expect (js-call (new globalThis.RegExp "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-8[0-9a-f]{3}-[0-9a-f]{12}$") :test id)) :toBe t)
        (js-call (expect (cursorCreationId "ws" "key")) :toBe id)
        (js-call (nativeGet (expect (cursorCreationId "other-ws" "key")) "not") :toBe id)
        (js-call (nativeGet (expect (cursorCreationId "ws" "other-key")) "not") :toBe id))
      (let* ((extension (js-object :subscriptions (js-array)))
             (disabled (js-object :workspace (js-object :getConfiguration (lambda (name)
               (js-object :get (lambda (key fallback) fallback)))))))
        (js-call (expect (await (activateCursorControl disabled extension))) :toBe nil)
        (js-call (expect (js-length (nativeGet extension "subscriptions"))) :toBe 0))
      (let ((config (js-object :schema_version 1 :service (js-object :service_id "ipc-only")
                      :principals (js-array) :managed_profiles (js-array))))
        (js-call (expect (nativeGet (validateStructure config) "ok")) :toBe t)
        (js-call (js-array "codex" "cursor" "opencode" "pi") :forEach
          (lambda (tool)
            (js-call (js-array false t) :forEach (lambda (auto-start)
              (put config :managed_profiles (js-array (js-object :profile_id "legacy-argv" :tool tool
                :revision 1 :argv (js-array "agent") :workspace_refs (js-array "workspace")
                :auto_start auto-start :launch_principal_id "operator")))
              (js-call (expect (nativeGet (validateStructure config) "ok")) :toBe false))))))
      ;; A native endpoint cannot silently become another tool, process or bridge.
      (let* ((native (js-object :tool "cursor" :ownership "existing" :instance_id "native"
                :native_namespace "native" :endpoint_ref "native" :workspace_ref "workspace"
                :directory "." :window_id 1 :native_api (js-object :inspector_url "http://127.0.0.1:9229"
                  :process_id 123 :process_origin 1234 :workspace_id "workspace")))
             (base (js-object :schema_version 1 :service (js-object :service_id "native-config")
                :principals (js-array) :managed_profiles (js-array) :agent_endpoints (js-array native))))
        (js-call (expect (nativeGet (validateStructure base) "ok")) :toBe t)
        (let ((automatic (JSON/parse (JSON/stringify base))))
          (Object/assign (nativeGet (aref (nativeGet automatic "agent_endpoints") 0) "native_api")
            (js-object :manage_inspector t :process_birth "1:2" :process_helper_ref "libexec/dj-process-info"))
          (js-call (expect (nativeGet (validateStructure automatic) "ok")) :toBe t))
        (js-call (js-array "manifest_path" "control_manifest_path" "wrong_tool" "missing_origin" "remote_url" "auto_without_metadata" "auto_custom_port") :forEach
          (lambda (change)
            (let* ((config (JSON/parse (JSON/stringify base)))
                   (endpoint (aref (nativeGet config "agent_endpoints") 0)) (rejected false))
              (cond
                ((= change "auto_without_metadata")
                  (put (nativeGet endpoint "native_api") :manage_inspector t))
                ((= change "auto_custom_port")
                  (Object/assign (nativeGet endpoint "native_api") (js-object :manage_inspector t
                    :process_birth "1:2" :process_helper_ref "libexec/dj-process-info"
                    :inspector_url "http://127.0.0.1:9230")))
                ((= change "wrong_tool") (put endpoint :tool "codex"))
                ((= change "missing_origin") (js-call globalThis.Reflect :deleteProperty (nativeGet endpoint "native_api") "process_origin"))
                ((= change "remote_url") (put (nativeGet endpoint "native_api") :inspector_url "http://198.51.100.9:9229"))
                (t (put endpoint change "bridge.json")))
              (try
                (setq rejected (not (nativeGet (validateStructure config) "ok")))
                (catch invalid (setq rejected t)))
              (js-call (expect rejected) :toBe t)))))
      (js-call (expect (codexRuntime (js-object :threadRuntimeStatus (js-object :type "idle")))) :toBe "idle")
      (js-call (expect (codexRuntime (js-object :threadRuntimeStatus (js-object :type "active")))) :toBe "busy")
      (js-call (expect (codexRuntime (js-object :threadRuntimeStatus (js-object :type "idle")
        :requests (js-array (js-object :id "approval"))))) :toBe "waiting_permission")
      (js-call (expect (codexRuntime (js-object :threadRuntimeStatus (js-object :type "idle")
        :unconfirmedTurnSubmissions (js-array (js-object :terminal false))))) :toBe "busy")
      (js-call (expect (codexRuntime (js-object :resumeState "resumed"
        :turns (js-array (js-object :status "inProgress"))))) :toBe "busy")
      (js-call (expect (codexRuntime (js-object :resumeState "resumed"
        :turnHistory (js-object :kind "canonical" :history
          (js-object :isComplete false :islands (js-array) :entitiesByKey (js-object)))))) :toBe "unknown")
      (js-call (expect (codexRuntime (js-object))) :toBe "unknown")
      (js-call (expect (cursorRuntime (js-object :status "running"))) :toBe "busy")
      (js-call (expect (cursorRuntime (js-object :status "completed"))) :toBe "idle")
      (js-call (expect (cursorRuntime (js-object :status "unrecognized"))) :toBe "unknown")))
  (withUnitCase "T38.envelope-snapshot.unit"
    (lambda (unused)
      (js-call (expect (nativeGet (validateInstructionPolicy
        (js-object :prompt (js-call "x" :repeat 8192))) "ok")) :toBe t)
      (js-call (js-array (js-object) (js-object :prompt (js-call "x" :repeat 8193))
          (js-object :prompt (js-call "汉" :repeat 2731))
          (js-object :task_template "{{unknown}}") (js-object :task_template "{{__proto__}}")
          (js-object :task_template "{{message.text}") (js-object :task_template "message.text}}")
          (js-object :task_template (js-call "{{event.id}}" :repeat 33)))
        :forEach (lambda (policy)
          (js-call (expect (nativeGet (validateInstructionPolicy policy) "ok")) :toBe false)))
      (let* ((event (js-object :event_id "event-id" :sender (js-object :id "sender-id")
                      :conversation (js-object :native_chat_id "chat-id" :native_thread_id nil)))
             (contribution (js-object :subscription_id "sub-id" :revision 7
               :instruction_policy (js-object :prompt "literal {{unknown}}" :task_template "task={{message.text}}")))
             (body "external {{event.id}}")
             (items (composeInstructions (js-array contribution) event body)))
        (js-call (expect (nativeGet (aref items 0) "prompt")) :toBe "literal {{unknown}}")
        (js-call (expect (nativeGet (aref items 0) "task")) :toBe "task=external {{event.id}}")
        (js-call (expect (nativeGet (renderTask "{{source.chat_id}}/{{source.thread_id}}/{{sender.id}}/{{subscription.id}}"
          event contribution body) "text")) :toBe "chat-id//sender-id/sub-id")
        (js-call (expect (nativeGet (renderTask (js-call "{{message.text}}" :repeat 32)
          event contribution (js-call "x" :repeat 1024)) "overflow")) :toBe false)
        (js-call (expect (nativeGet (renderTask (js-call "{{message.text}}" :repeat 32)
          event contribution (js-call "x" :repeat 1025)) "overflow")) :toBe t)
        (let* ((high (String/fromCharCode 55357)) (low (String/fromCharCode 56832))
               (rendered (renderTask (str (js-call "x" :repeat 32764) high "{{message.text}}")
                           event contribution low)))
          (js-call (expect (nativeGet rendered "overflow")) :toBe false)
          (js-call (expect (Buffer/byteLength (nativeGet rendered "text") "utf8")) :toBe 32768))
        (js-call (expect (js-length (composeInstructions (js-array (js-object)) event body))) :toBe 0)
        (let ((envelope (js-object :schema_version 1 :kind "external_message"
                :allowed_actions (js-array) :content (js-object :text body) :instructions items)))
          (js-call (expect (nativeGet (unpackEnvelope (packEnvelope envelope)) "instructions")) :toEqual items)))
      (let ((spec (js-object :agent_id "agent" :selector (js-object :sources
              (js-array (js-object :conversation_ref "source")))
              :instruction_policy (js-object :prompt "trusted"))))
        (js-call (expect (nativeGet (validateRequest "subscription.preview" (js-object :spec spec)) "ok")) :toBe t)
        (put spec :instruction_policy (js-object :task_template "{{unknown}}"))
        (js-call (expect (nativeGet (validateRequest "subscription.preview" (js-object :spec spec)) "ok")) :toBe false))
      (let* ((envelope (js-object :schema_version 1 :kind "external_message"
        :allowed_actions (js-array "reply") :reply_context_id nil
        :content (js-object :text (js-call "中文🙂" :repeat 4096) :optional nil :enabled false :zero 0)))
        (packed (packEnvelope envelope)))
        (js-call (expect (unpackEnvelope packed)) :toEqual envelope)
        (js-call (expect (unpackEnvelope envelope)) :toEqual envelope)
        (js-call (expect (js-length (JSON/stringify packed))) :toBeLessThan (/ (js-length (JSON/stringify envelope)) 2))
        (js-call (expect (lambda () (unpackEnvelope (Object/assign (js-object) packed (js-object :sha256 "bad"))))) :toThrow)
        (js-call (expect (lambda () (unpackEnvelope (Object/assign (js-object) packed (js-object :raw_bytes 1))))) :toThrow)
        (js-call (expect (lambda () (unpackEnvelope (Object/assign (js-object) packed (js-object :data "invalid!"))))) :toThrow)
        (js-call (expect (lambda () (unpackEnvelope (Object/assign (js-object) packed (js-object :codec "unsupported"))))) :toThrow)
        (let* ((large (js-call "x" :repeat 1048577))
          (bomb (js-object :codec "deflate-raw-v1" :raw_bytes 1048576 :sha256 "bad"
            :data (js-call (deflateRawSync (Buffer/from large "utf8")) :toString "base64"))))
          (js-call (expect (lambda () (packEnvelope (Object/assign (js-object) envelope (js-object :content (js-object :text large)))))) :toThrow)
          (js-call (expect (lambda () (unpackEnvelope bomb))) :toThrow)))))
  (withUnitCase "T38.native-access.unit"
    (async (unused)
      (let ((value (js-object :explicit_null nil :explicit_false false :zero 0 :empty "")))
        (js-call (expect (undefined? (nativeGet nil "missing"))) :toBe t)
        (js-call (expect (nativeGet nil "missing" "fallback")) :toBe "fallback")
        (js-call (expect (undefined? (nativeGet value "missing"))) :toBe t)
        (js-call (expect (nativeGet value "missing" "fallback")) :toBe "fallback")
        (js-call (expect (nativeGet value "explicit_null" "fallback")) :toBe nil)
        (js-call (expect (nativeGet value "explicit_false" "fallback")) :toBe false)
        (js-call (expect (nativeGet value "zero" "fallback")) :toBe 0)
        (js-call (expect (nativeGet value "empty" "fallback")) :toBe ""))
      (let* ((requests 0)
             (endpoint (js-object :endpoint_ref "native" :instance_id "instance" :instance_epoch "epoch"
                         :native_namespace "namespace" :base_url "http://127.0.0.1:1" :directory "work"))
             (session (Object/assign (js-object) endpoint (js-object :native_session_id "session")))
             (port (createOpenCodePort (js-object :endpoints (js-array endpoint) :existing_only t)
                     (js-object :http (js-object :fetch (async (url options) (setq requests (1+ requests))))))))
        (let ((cases (js-array (js-object :native_session_id "foreign" :before "opaque")
                      (js-object :native_session_id "session" :before "")
                      (js-object :native_session_id "session" :before 7)
                      (js-object :native_session_id "session" :before (js-call "x" :repeat 8193))))
              (index 0))
          (while (< index (js-length cases))
            (let ((rejected false))
              (try (await (js-call port :readMessages session (aref cases index)
                       (js-object :max_records 10 :max_bytes 1024) (js-object)))
                (catch error (setq rejected (= (nativeGet error "name") "TypeError"))))
              (js-call (expect rejected) :toBe t))
            (setq index (1+ index))))
        (js-call (expect requests) :toBe 0)
        (await (js-call port :close)))
      (let* ((handlers (new globalThis.Map))
             (api (js-object :on (lambda (name handler) (js-call handlers :set name handler))
                    :sendUserMessage (lambda (text) (throw (new globalThis.Error "must not submit")))))
             (receiver (activatePiReceiver api)))
        (js-call (expect (lambda () (activatePiReceiver (js-object)))) :toThrow)
        (js-call (expect (js-call (Array/from (js-call handlers :keys)) :sort))
          :toEqual (js-array "agent_end" "agent_start" "session_shutdown" "session_start"))
        (await (funcall (js-call handlers :get "session_start") (js-object) (js-object :mode "print")))
        (await (js-call receiver :close))
        (await (js-call receiver :close)))
      (let* ((port (createPiNativePort (js-object :endpoints (js-array)) (js-object)))
             (session (js-object :native_session_id "original"))
             (cursors (js-array (js-object :native_session_id "other" :after_id "entry")
                        (js-object :native_session_id "original" :after_id "")
                        (js-object :native_session_id "original" :after_id 1)
                        (js-object :native_session_id "original" :after_id (js-call "x" :repeat 257))))
             (index 0))
        (while (< index (js-length cursors))
          (let ((rejected false))
            (try (await (js-call port :readMessages session (aref cursors index) (js-object) (js-object)))
              (catch error (setq rejected (= (nativeGet error "name") "TypeError"))))
            (js-call (expect rejected) :toBe t))
          (setq index (1+ index)))
        (await (js-call port :close)))))
  (withUnitCase
    "T26.strict-input.unit"
    (async
      (unused)
      (let* ((input (js-object :hook_event_name "UserPromptSubmit" :session_id "native" :turn_id "turn"))
             (options (js-object :target "codex" :client_profile "not-read-by-pure-test" :agent "bound" :subscription "sub"))
             (keys (js-array)) (wrong false)
             (invoke (async (operation args)
               (cond ((= operation "agent.whoami") (success (js-object :kind "agent" :bound_agent_id "bound")))
                 ((= operation "agent.get") (success (js-object :state "registered" :tool "codex"
                   :native_session_id (if wrong "foreign" "native"))))
                 (t (js-call keys :push (nativeGet args "idempotency_key"))
                   (success (js-object :empty false :item (js-object :inbox_id "inbox"
                     :claim_ref "opaque-claim" :envelope (js-object :content (js-object :text "{{not evaluated}}"))))))))))
        (js-call (expect (nativeGet (hookIdentity "codex" input) "session")) :toBe "native")
        (js-call (js-array (js-object :agent_id "child") (js-object :is_background_agent t)
          (js-object :hook_event_name "Stop") (js-object :turn_id "")) :forEach (lambda (patch)
            (js-call (expect (lambda () (hookIdentity "codex" (Object/assign (js-object) input patch)))) :toThrow)))
        (let ((cursor (js-object :hook_event_name "stop" :conversation_id "native" :generation_id "turn" :status "completed" :loop_count 0)))
          (js-call (expect (nativeGet (hookIdentity "cursor" cursor) "turn")) :toBe "turn")
          (js-call (js-array (js-object :loop_count 1) (js-object :loop_count "0") (js-object :status "error")) :forEach
            (lambda (patch) (js-call (expect (lambda () (hookIdentity "cursor" (Object/assign (js-object) cursor patch)))) :toThrow))))
        (let ((output (await (pullHook options input invoke))))
          (js-call (expect (nativeGet (nativeGet output "hookSpecificOutput") "hookEventName")) :toBe "UserPromptSubmit")
          (js-call (expect (js-call (nativeGet (nativeGet output "hookSpecificOutput") "additionalContext") :includes "{{not evaluated}}")) :toBe t))
        (await (pullHook options input invoke))
        (js-call (expect (aref keys 0)) :toBe (aref keys 1))
        (await (pullHook options (Object/assign (js-object) input (js-object :turn_id "other")) invoke))
        (js-call (expect (= (aref keys 0) (aref keys 2))) :toBe false)
        (setq wrong t)
        (await (js-call (nativeGet (expect (pullHook options input invoke)) "rejects") :toThrow "native session mismatch"))
        (js-call (expect (js-length keys)) :toBe 3)
        (js-call (expect (shellWord "a'b$(ignored)")) :toBe "'a'\"'\"'b$(ignored)'")
        (js-call (expect (lambda () (hookConfig (Object/assign (js-object) options (js-object :target "claude")) "dj"))) :toThrow)
        (await (js-call (nativeGet (expect (readHookInput (js-call (new globalThis.Blob
          (js-array (new globalThis.Uint8Array 1048577))) :stream))) "rejects") :toThrow "callback input limit"))
        (await (js-call (nativeGet (expect (readHookInput (js-call (new globalThis.Blob
          (js-array (new globalThis.Uint8Array (js-array 255)))) :stream))) "rejects") :toThrow)))
      (let* ((handles (createHandleAuthority))
             (handle (js-call handles :issue "inbox_claim" "recipient" "inbox-entry"
                       (js-object :authorization_revision 2) "2026-01-01T00:01:00.000Z"))
             (ref (nativeGet handle "ref")))
        (js-call (expect (nativeGet (js-call handles :resolve ref "inbox_claim" "recipient" 2
          "2026-01-01T00:00:00.000Z") "ok")) :toBe t)
        (js-call (expect (nativeGet (js-call handles :resolve ref "message" "recipient" 2
          "2026-01-01T00:00:00.000Z") "ok")) :toBe false)
        (js-call (expect (nativeGet (js-call handles :resolve ref "inbox_claim" "foreign" 2
          "2026-01-01T00:00:00.000Z") "ok")) :toBe false)
        (js-call (expect (nativeGet (js-call handles :resolve ref "inbox_claim" "recipient" 3
          "2026-01-01T00:00:00.000Z") "ok")) :toBe false)
        (js-call (expect (nativeGet (js-call handles :resolve ref "inbox_claim" "recipient" 2
          "2026-01-01T00:01:00.000Z") "ok")) :toBe false)
        (js-call (expect (nativeGet (js-call handles :resolve "inbox-entry" "inbox_claim" "recipient" 2
          "2026-01-01T00:00:00.000Z") "ok")) :toBe false))
      (js-call (js-array 0 301 1.5 "60") :forEach (lambda (seconds)
        (js-call (expect (nativeGet (validateRequest "subscription.pull"
          (js-object :subscription_id "sub" :lease_seconds seconds :idempotency_key "pull")) "ok")) :toBe false)))
      (js-call (js-array 1 300) :forEach (lambda (seconds)
        (js-call (expect (nativeGet (validateRequest "subscription.pull"
          (js-object :subscription_id "sub" :lease_seconds seconds :idempotency_key "pull")) "ok")) :toBe t)))
      (js-call (expect (nativeGet (validateRequest "subscription.ack"
        (js-object :claim_ref "claim" :disposition "done" :idempotency_key "ack")) "ok")) :toBe false)
      (js-call (expect (nativeGet (validateRequest "subscription.ack"
        (js-object :claim_ref "claim" :disposition "consumed")) "ok")) :toBe false)
      (let ((home (resolve ".local/tests/unit-home")) (project (resolve ".local/tests/unit-project")))
        (js-call (expect (skillDestination (js-object :target "codex" :scope "user") home)) :toBe
          (resolve home ".agents/skills/dj"))
        (js-call (expect (skillDestination (js-object :target "cursor" :scope "project" :project project) home)) :toBe
          (resolve project ".cursor/skills/dj"))
        (js-call (js-array "__proto__" "constructor" "toString" "../cursor" "Cursor") :forEach
          (lambda (target)
            (js-call (expect (lambda () (skillDestination (js-object :target target :scope "user") home))) :toThrow)
            (js-call (expect (lambda () (skillConfig target "dj" "private-profile"))) :toThrow)))
        (js-call (expect (lambda () (skillDestination (js-object :target "codex" :scope "project") home))) :toThrow)
        (js-call (expect (lambda () (skillDestination
          (js-object :target "codex" :scope "user" :project project) home))) :toThrow)
        (let* ((profile "profile with \"quotes\" and\nnewline")
               (config (nativeGet (skillConfig "codex" "dj" profile) "data"))
               (parsed (js-call (nativeGet globalThis.Bun "TOML") :parse (nativeGet config "config"))))
          (js-call (expect (aref (nativeGet (nativeGet (nativeGet parsed "mcp_servers") "dj") "args") 5)) :toBe profile)
          (js-call (expect (nativeGet config "client_config_modified")) :toBe false))
        (js-call (expect (nativeGet (nativeGet (skillConfig "pi" "dj" "private-profile") "data") "config")) :toBe nil))
      (let* ((calls (js-array)) (visible (js-array "session.send"))
             (core (js-object :authenticate (lambda (token)
                       (if (= token "unit-token") (success (js-object :principal_id "unit")) (failure "unauthorized")))
                     :transportState (lambda () "ready")
                     :execute (async (principal operation args)
                       (js-call calls :push (js-object :operation operation :arguments args))
                       (success (if (= operation "service.status")
                         (js-object :visible_operations visible) args)))))
             (headers (js-object :authorization "Bearer unit-token" :content-type "application/json")))
        ;; Metadata may inspect visible capabilities, but must never invoke the
        ;; described mutation. Empty permissions must stay an empty tree.
        (let ((response (await (handleGepoRequest
                (new globalThis.Request "http://localhost/session/send" (js-object :headers headers)) core))))
          (js-call (expect (nativeGet response "status")) :toBe 200)
          (js-call (expect (js-length calls)) :toBe 1)
          (js-call (expect (nativeGet (aref calls 0) "operation")) :toBe "service.status"))
        (setq visible (js-array))
        (let ((response (await (handleGepoRequest
                (new globalThis.Request "http://localhost/.gepo" (js-object :headers headers)) core))))
          (js-call (expect (nativeGet response "status")) :toBe 200)
          (js-call (expect (js-call (await (js-call response :text)) :includes "/session")) :toBe false))
        (let ((response (await (handleGepoRequest
                (new globalThis.Request "http://localhost/session/send"
                  (js-object :method "POST" :headers headers :body "{}")) core))))
          (js-call (expect (nativeGet response "status")) :toBe 404)
          (js-call (expect (js-length calls)) :toBe 3))
        (let ((response (await (handleGepoRequest
                (new globalThis.Request "http://localhost/.gepo") core))))
          (js-call (expect (nativeGet response "status")) :toBe 401)
          (js-call (expect (js-length calls)) :toBe 3)))
      (js-call
        (expect (nativeGet (validateRequest "service.status" (js-object)) "ok"))
        :toBe
        t)
      (js-call
        (expect
          (nativeGet (validateRequest "service.status" (js-object :principal "operator")) "ok"))
        :toBe
        false)
      (js-call (expect (nativeGet (validateRequest "service.status" nil) "ok")) :toBe false)
      (js-call
        (expect
          (nativeGet
            (validateRequest
              "session.get"
