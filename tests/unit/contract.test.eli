  (withUnitCase
    "T38.utf8-seq.unit"
    (lambda
      (unused)
      (let ((first (sliceUtf8 "中😀A" 0 3)) (second (sliceUtf8 "中😀A" 3 4)))
        (js-call (expect (nativeGet first "text")) :toBe "中")
        (js-call (expect (nativeGet first "next_offset_bytes")) :toBe 3)
        (js-call (expect (nativeGet second "text")) :toBe "😀")
        (js-call (expect (nativeGet (sliceUtf8 "中😀A" 1 3) "ok")) :toBe false)
        (js-call
          (expect (encodeSeq (NativeBigInt "9007199254740993")))
          :toBe
          "9007199254740993"))))
