              :schema_version
              1
              :kind
              "external_message"
              :delivery_id
              "dlv-1"
              :source
              (js-object :kind "api")
              :allowed_actions
              (js-array)
              :content
              (js-object :type "text" :text text)))
          (decoded (JSON/parse (encodeEnvelope envelope))))
        (js-call (expect (nativeGet decoded "kind")) :toBe "external_message")
        (js-call (expect (nativeGet (nativeGet decoded "content") "text")) :toBe text)
        (js-call (expect (js-length (nativeGet decoded "allowed_actions"))) :toBe 0)
        (js-call (expect (object-has? decoded :role)) :toBe false))))
