(module
  dj.tests.unit.pi-observer
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" stableSessionKey)
  (import "../../tools/pi-observer.eli" validatePiObserverRequest validatePiObserverBinding observePiLog)
  (import "../../tools/native-observer-controller.eli" executeNativeObservation readPiSnapshot)
  (import "../support/direct-control.eli" runDirectControl)
  (import
    "../support/pi-observer.eli"
    piTestRequest
    piTestBinding
    piTestHeader
    piTestEnvelope
    piTestUser
    piTestAssistant
    piTestNoise
    piTestSnapshot
    nativeTestBinding)
  (import "../support/case.eli" withUnitCase)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defasync
    poReject
    (thunk)
    (let* ((failed false)) (try (await (funcall thunk)) (catch failure (setq failed t))) failed))
  (withUnitCase
    "T38.pi-observer.unit"
    (async
      (unused)
      (let* ((r (piTestRequest "observe-native-start")) (b (piTestBinding))
             (u (piTestUser "user-multiple" nil "subscription_event"))
             (before (piTestAssistant "invalid-before" "missing-parent"))
             (first (piTestAssistant "z-first-assistant" "user-multiple"))
             (second (piTestAssistant "a-second-assistant" "user-multiple"))
             (after (piTestAssistant "invalid-after" "missing-parent"))
             (response (observePiLog r b (piTestSnapshot (js-array u before first second after)))))
        (js-call (expect (nativeGet (nativeGet response "data") "native_event_id")) :toBe "z-first-assistant"))
      (let* ((r (piTestRequest "observe-direct-input")) (b (piTestBinding))
             (u (piTestUser "user-many-blocks" nil "direct")))
        (put (nativeGet u "message") :content
          (Array/from (js-object :length 8193) (lambda (unused index)
            (js-object :type "text" :text (if (= index 0) (JSON/stringify (piTestEnvelope "direct")) "")))))
        (js-call (expect (nativeGet (observePiLog r b (piTestSnapshot (js-array u))) "ok")) :toBe t))
      (let*
        ((b (validatePiObserverBinding (piTestBinding)))
          (r (validatePiObserverRequest (piTestRequest "observe-direct-input"))))
        (js-call (expect (Object/isFrozen b)) :toBe t)
        (js-call (expect (Object/isFrozen (nativeGet b "targets"))) :toBe t)
        (js-call (expect (Object/isFrozen (aref (nativeGet b "targets") 0))) :toBe t)
        (js-call (expect (Object/isFrozen (nativeGet r "parameters"))) :toBe t))
      (let*
        ((b (piTestBinding)))
        (put b :authorized false)
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put b :schema_version 2)
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put b :targets (js-array))
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put b :targets (new globalThis.Array 17))
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put b :targets (js-array (aref (nativeGet b "targets") 0) (aref (nativeGet b "targets") 0)))
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put (aref (nativeGet b "targets") 0) :cwd "relative")
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put (aref (nativeGet b "targets") 0) :log_path "relative.jsonl")
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put (aref (nativeGet b "targets") 0) :log_path (resolve "file.txt"))
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding)))
        (put (aref (nativeGet b "targets") 0) :native_session_id "bad id")
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
        ((b (piTestBinding))
          (targets
            (Array/from
              (js-object :length 16)
              (lambda
                (unused i)
                (js-object
                  :native_session_id
                  (str "sess_" i)
                  :cwd
                  (resolve "pi-work")
                  :log_path
                  (resolve (str "pi_" i ".jsonl")))))))
        (put b :targets targets)
        (js-call (expect (nativeGet (nativeGet (validatePiObserverBinding b) "targets") "length")) :toBe 16)
        (js-call
          targets
          :push
          (js-object :native_session_id "sess_16" :cwd (resolve "pi-work") :log_path (resolve "pi_16.jsonl")))
        (js-call (expect (lambda () (validatePiObserverBinding b))) :toThrow))
      (let*
