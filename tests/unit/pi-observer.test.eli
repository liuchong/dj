          (b (piTestBinding))
          (u (piTestUser "user-1" nil "direct"))
          (a (piTestAssistant "assistant-1" "user-1"))
          (rows (js-array u a))
          (response (observePiLog r b (piTestSnapshot rows)))
          (data (nativeGet response "data")))
        (js-call (expect (nativeGet response "ok")) :toBe t)
        (js-call (expect (nativeGet response "request_id")) :toBe "req-po")
        (js-call (expect (nativeGet data "native_session_id")) :toBe "pi-session")
        (js-call (expect (nativeGet data "native_message_id")) :toBe "user-1")
        (js-call (expect (nativeGet data "native_event_id")) :toBe "user-1")
        (js-call (expect (nativeGet data "observed_delivery_id")) :toBe "delivery-po")
        (js-call (expect (nativeGet data "observation_source")) :toBe "pi_session_jsonl_v3")
        (js-call (expect (nativeGet data "session_format_version")) :toBe 3)
        (js-call (expect (nativeGet data "history_coverage")) :toBe "bounded_tail")
        (js-call (expect (nativeGet data "instance_identity_source")) :toBe "authorized_session_log_binding")
        (js-call (expect (js-call (JSON/stringify response) :includes "body-hidden")) :toBe false)
        (js-call (expect (js-call (JSON/stringify response) :includes "private native answer")) :toBe false)
        (js-call (expect (js-call (JSON/stringify response) :includes "pi-observer-workspace")) :toBe false))
