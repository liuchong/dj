(module dj.tests.unit.message-recovery
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/application/schema.eli" validateRequest)
  (import "../../src/policy/authorize.eli" authorize)
  (import "../../src/lifecycle/gates.eli" supportsNativeEpochRefresh)
  (import "../../src/adapters/agent/desktop.eli" createDesktopPort)
  (import "../../src/adapters/agent/opencode-http.eli" createOpenCodePort)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort)
  (import "../../src/adapters/agent/claude-desktop.eli" createClaudeDesktopPort)
  (import "../../src/adapters/agent/claude-inbox.eli" createClaudeInboxPort)
  (import "../../src/adapters/agent/kimi-dsh.eli" createKimiDshPort)
  (import "../../src/adapters/agent/pi-native.eli" createPiNativePort)
  (import "../../src/adapters/agent/local-endpoint-resolver.eli"
    tcpListenerAddresses unixListenerPaths createLocalEndpointResolver)
  (import "../../src/adapters/agent/electron-recovery.eli"
    electronToolSpec createElectronEndpointRequest)
  (import "../../src/adapters/agent/desktop-transport.eli" desktopError)
  (import "../support/case.eli" withUnitCase)
  (import "node:fs" mkdirSync writeFileSync chmodSync rmSync)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)

  (withUnitCase "T38.message-recovery-guards.unit" (lambda (ignored)
    (let* ((args (js-object :connection_id "account" :native_message_ids (js-array "one") :reason "explicit recovery" :idempotency_key "key"))
      (agent (js-object :principal_id "a" :kind "agent" :authorization_revision 1 :grants (js-array (js-object :action "*" :resources (js-array "*")))))
      (operator (Object/assign (js-object) agent (js-object :kind "operator")))
      (resource (js-object :connection_id "account")))
      (js-call (expect (nativeGet (validateRequest "message.recover" args) "ok")) :toBe t)
      (js-call (expect (nativeGet (validateRequest "message.recover" (Object/assign (js-object) args
        (js-object :native_message_ids (js-call (new globalThis.Array 17) :fill "one")))) "ok")) :toBe false)
      (js-call (expect (nativeGet (authorize agent "message.recover" resource 1) "allowed")) :toBe false)
      (js-call (expect (nativeGet (authorize operator "message.recover" resource 1) "allowed")) :toBe t))))

  (withUnitCase "T38.native-epoch-refresh-scope.unit" (lambda (ignored)
    (let ((capable-port (js-object :probeInstance (async () nil) :probe (async () nil)
            :capabilities (js-object :instance_epoch_refresh "supported")))
          (minimal-port (js-object :probeInstance (async () nil) :probe (async () nil)))
          (no-instance-probe (js-object :probe (async () nil)))
          (disabled-port (js-object :probeInstance (async () nil) :probe (async () nil)
            :capabilities (js-object :instance_epoch_refresh "unsupported"))))
      (js-call (js-array "codex" "cursor" "opencode" "antigravity" "claude" "kimi" "dsh" "pi" "future-agent") :forEach
        (lambda (tool)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "existing") capable-port)) :toBe t)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "existing") minimal-port)) :toBe t)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "managed") capable-port)) :toBe false)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "existing") no-instance-probe)) :toBe false)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "existing") disabled-port)) :toBe false)
          (js-call (expect (supportsNativeEpochRefresh (js-object :tool tool :ownership "existing") nil)) :toBe false)))
      (js-call (expect (supportsNativeEpochRefresh nil capable-port)) :toBe false)
      (let ((ports (js-array
              (createDesktopPort "codex" (js-object :endpoints (js-array)) (js-object))
              (createDesktopPort "cursor" (js-object :endpoints (js-array)) (js-object))
              (createOpenCodePort (js-object :endpoints (js-array)) (js-object))
              (createAntigravityPort (js-object :endpoints (js-array)) (js-object))
              (createClaudeDesktopPort (js-object :endpoints (js-array)) (js-object))
              (createClaudeInboxPort (js-object :endpoints (js-array)) (js-object))
              (createKimiDshPort "kimi" (js-object :endpoints (js-array)) (js-object))
              (createKimiDshPort "dsh" (js-object :endpoints (js-array)) (js-object))
              (createPiNativePort (js-object :endpoints (js-array)) (js-object)))))
        (js-call ports :forEach (lambda (port)
          (js-call (expect (nativeGet (nativeGet port "capabilities") "instance_epoch_refresh")) :toBe "supported")
          (js-call (expect (supportsNativeEpochRefresh (js-object :ownership "existing") port)) :toBe t)))))))

  (withUnitCase "T38.shared-endpoint-resolver.unit" (async (ignored)
    (let ((listeners (tcpListenerAddresses "p100\nn127.0.0.1:4100\nn[::1]:4200\nn0.0.0.0:4300\nn127.0.0.1:4100\n"))
          (sockets (unixListenerPaths "p100\nn/tmp/a.sock\nn127.0.0.1:80\nn/tmp/b.sock\n")))
      (js-call (expect (js-length listeners)) :toBe 2)
      (js-call (expect (nativeGet (aref listeners 0) "address")) :toBe "127.0.0.1:4100")
      (js-call (expect (nativeGet (aref listeners 1) "address")) :toBe "[::1]:4200")
      (js-call (expect (js-call sockets :has "/tmp/a.sock")) :toBe t)
      (js-call (expect (js-call sockets :has "/tmp/b.sock")) :toBe t))

    ;; Seeded verify, stale cache eviction, single-flight discovery deduplication and PID-reuse race guard.
    (let* ((generation 1) (discover-calls 0) (pid-race false)
           (configured (js-object :instance_id "inst-1" :pid 10))
           (resolver (createLocalEndpointResolver
             (js-object
               :seed (lambda (ep helpers) (js-object :endpoint (js-call helpers :cloneEndpoint ep)))
               :verify (async (live context)
                 (when pid-race (throw (desktopError "native_process_changed")))
                 (unless (= (nativeGet (nativeGet live "endpoint") "pid") (if (= generation 1) 10 20))
                   (throw (desktopError "native_process_changed")))
                 (str "epoch-" generation))
               :discover (async (ep context helpers)
                 (setq discover-calls (1+ discover-calls))
                 (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 15))))
                 (let ((copy (js-call helpers :cloneEndpoint ep)))
                   (put copy :pid 20)
                   (js-object :endpoint copy :credential (js-object :token "mem-only"))))))))
      (let ((first (await (funcall resolver configured (js-object)))))
        (js-call (expect (nativeGet first "verified")) :toBe "epoch-1")
        (js-call (expect discover-calls) :toBe 0))
      (setq generation 2)
      (let ((concurrent (await (Promise/all (js-array
              (funcall resolver configured (js-object))
              (funcall resolver configured (js-object))
              (funcall resolver configured (js-object)))))))
        (js-call (expect discover-calls) :toBe 1)
        (js-call (expect (nativeGet (aref concurrent 0) "verified")) :toBe "epoch-2")
        (js-call (expect (nativeGet (nativeGet (aref concurrent 0) "credential") "token")) :toBe "mem-only")
        ;; Original configured object must remain untouched.
        (js-call (expect (nativeGet configured "pid")) :toBe 10))
      ;; Post-discovery PID-reuse failure must reject and avoid caching untrusted credentials.
      (js-call resolver :clear)
      (setq pid-race t)
      (let ((rejected false))
        (try (await (funcall resolver configured (js-object))) (catch err (setq rejected t)))
        (js-call (expect rejected) :toBe t)))

    ;; Shared Electron window/process recovery boundaries: live process never rebinds; dead/PID-reused rebinds unique window.
    (let ((claude-spec (electronToolSpec "claude")) (cursor-spec (electronToolSpec "cursor")))
      (js-call (expect (js-call claude-spec :window_matches (js-object :url "https://claude.ai/chat/1"))) :toBe t)
      (js-call (expect (js-call claude-spec :window_matches (js-object :url "https://evil.example/"))) :toBe false)
      (js-call (expect (js-call cursor-spec :window_matches (js-object :url "vscode-file://vscode-app/workbench.html"))) :toBe t))

    (let* ((root (resolve ".local/t" (str "u-" (js-call (randomUUID) :slice 0 8))))
           (helper (resolve root "helper"))
           (uid (js-call globalThis.process :getuid))
           (alive-birth "birth-1")
           (rebind-calls 0))
      (mkdirSync root (js-object :recursive t :mode 448))
      (writeFileSync helper "#!/bin/sh\nexit 0\n" (js-object :mode 448))
      (chmodSync helper 448)
      (try
        (let* ((endpoint (js-object :tool "claude" :instance_id "claude-el" :window_id 1
                 :native_api (js-object :inspector_url "http://127.0.0.1:9229/" :process_id 500
                   :process_birth "birth-1" :process_origin 10 :process_helper_ref helper)))
               (request (createElectronEndpointRequest
                 (async (ep payload context)
                   (unless (and (= (nativeGet (nativeGet ep "native_api") "process_id") (if (= alive-birth "birth-1") 999 501))
                                (not (nativeGet context "expected_epoch")))
                     (throw (desktopError "desktop_target_changed")))
                   (js-object :instance_epoch "epoch-rebound" :data (js-object :ok t)))
                 (js-object
                   :electron_discovery_command (async (file args context)
                     (cond
                       ((= file helper)
                         (let ((pid (Number/parseInt (aref args 0) 10)))
                           (if (= pid 500)
                             (if (= alive-birth "birth-1")
                               (JSON/stringify (js-object :pid 500 :uid uid :birth "birth-1" :caught t :executable "/Applications/Claude.app/Contents/MacOS/Claude"))
                               (throw (desktopError "native_process_unavailable")))
                             (JSON/stringify (js-object :pid 501 :uid uid :birth "birth-2" :caught t :executable "/Applications/Claude.app/Contents/MacOS/Claude")))))
                       ((= file "ps")
                         (str "501 1 " uid " /Applications/Claude.app/Contents/MacOS/Claude\n"))
                       (t "")))
                   :electron_inspect (async (candidate context)
                     (setq rebind-calls (1+ rebind-calls))
                     (js-object :data (js-object :origin 20 :windows (js-array
                       (js-object :id 3 :url "https://claude.ai/new")))))))))
          ;; While PID 500 with birth-1 is still alive, desktop_target_changed must NOT rebind!
          (let ((failed false))
            (try (await (funcall request endpoint (js-object :operation "probe") (js-object :deadline (+ (performance/now) 2000))))
              (catch err (setq failed t)))
            (js-call (expect failed) :toBe t)
            (js-call (expect rebind-calls) :toBe 0))
          ;; Once PID 500 is gone, unique PID 501 + unique claude.ai window rebinds in memory without mutating endpoint.
          (setq alive-birth "gone")
          (let ((res (await (funcall request endpoint (js-object :operation "probe") (js-object :deadline (+ (performance/now) 2000))))))
            (js-call (expect (nativeGet res "instance_epoch")) :toBe "epoch-rebound")
            (js-call (expect rebind-calls) :toBe 1)
            (js-call (expect (nativeGet endpoint "window_id")) :toBe 1)))
        (finally (rmSync root (js-object :recursive t :force t)))))))
)
