(module dj.tests.unit.fixed-routes
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/service/config.eli" validateStructure)
  (import "../../src/service/fixed-routes.eli" routeDesiredHash routeRetrySeconds)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (defun config ()
    (js-object :schema_version 1 :service (js-object :service_id "fixed-route-test")
      :principals (js-array
        (js-object :principal_id "operator" :kind "operator" :authorization_revision 1 :grants (js-array (js-object :action "*" :resources (js-array "*"))))
        (js-object :principal_id "recipient" :kind "agent" :authorization_revision 1
          :target_constraint (js-object :tool "opencode" :native_namespace "ns" :native_session_id "s1")))
      :connections (js-array (js-object :connection_id "bot-a" :platform "lark" :brand "lark" :identity "bot" :credential_ref "secrets/bot-a" :watches (js-array)
        :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_a" :event_subject_id "ou_a"))
      :agent_endpoints (js-array (js-object :tool "opencode" :instance_id "existing" :native_namespace "ns" :ownership "existing" :endpoint_ref "test:existing"))
      :fixed_routes (js-array (js-object :id "fixed" :owner_principal_id "operator" :recipient_principal_id "recipient"
        :target (js-object :instance_id "existing" :native_session_id "s1") :sources (js-array (js-object :connection_id "bot-a"))))))
  (defun line (value) (aref (nativeGet value "fixed_routes") 0))
  (withCase "T38.fixed-routes-config.unit" (lambda () nil) (lambda (ignored)
    (js-call (expect (nativeGet (validateStructure (config)) "ok")) :toBe t)
    (js-call (js-array
      (lambda (c) (js-call (nativeGet c "fixed_routes") :push (line c)))
      (lambda (c) (put (line c) :recipient_principal_id "missing"))
      (lambda (c) (put (line c) :owner_principal_id "recipient"))
      (lambda (c) (put (aref (nativeGet c "principals") 1) :disabled t))
      (lambda (c) (put (nativeGet (line c) "target") :instance_id "missing"))
      (lambda (c) (put (nativeGet (line c) "target") :native_session_id "another"))
      (lambda (c) (put (line c) :sources (js-array)))
      (lambda (c) (put (aref (nativeGet (line c) "sources") 0) :connection_id "missing"))
      (lambda (c) (put (aref (nativeGet (line c) "sources") 0) :native_thread_id "without-chat"))
      (lambda (c) (Object/assign (aref (nativeGet (line c) "sources") 0)
        (js-object :native_chat_id "chat" :native_thread_id "thread" :include_threads t)))
      (lambda (c) (put (line c) :unknown_field t))
      (lambda (c) (put (line c) :event_kinds (js-array "made.up")))
      (lambda (c) (put (line c) :predicate (js-object :field "unknown" :op "eq" :value "x")))
      (lambda (c) (put (line c) :instruction_policy (js-object :prompt (js-call "中" :repeat 3000))))
      (lambda (c) (put (line c) :instruction_policy (js-object :task_template "{{unknown}}")))
      (lambda (c) (put (line c) :delivery_policy (js-object :busy "invented"))))
      :forEach (lambda (mutate)
        (let ((value (config))) (funcall mutate value)
          (let ((rejected false))
            (try (setq rejected (not (nativeGet (validateStructure value) "ok")))
              (catch error (setq rejected (= (nativeGet error "name") "TypeError"))))
            (js-call (expect rejected) :toBe t)))))) (lambda (ignored) nil))
  (withCase "T38.fixed-routes-fingerprint.unit" (lambda () nil) (lambda (ignored)
    (let* ((value (config)) (one (line value)) (hash (routeDesiredHash value one)))
      (js-call (expect (routeDesiredHash (JSON/parse (JSON/stringify value)) (JSON/parse (JSON/stringify one)))) :toBe hash)
      (put value :config_root "different-root")
      (js-call (expect (routeDesiredHash value one)) :toBe hash)
      (put one :predicate (js-object :all (js-array)))
      (js-call (expect (= (routeDesiredHash value one) hash)) :toBe false)
      (let ((changed (routeDesiredHash value one)))
        (put (aref (nativeGet value "principals") 1) :authorization_revision 2)
        (js-call (expect (= (routeDesiredHash value one) changed)) :toBe false)))) (lambda (ignored) nil))
  (withCase "T38.fixed-routes-backoff.unit" (lambda () nil) (lambda (ignored)
    (js-call (expect (js-call (js-array 1 2 3 7 100000) :map routeRetrySeconds)) :toEqual (js-array 5 10 20 300 300))) (lambda (ignored) nil)))
