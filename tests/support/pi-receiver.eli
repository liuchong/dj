(module dj.tests.support.pi-receiver
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connectors/pi.eli" activatePiReceiver)
  (import "node:fs/promises" readdir writeFile)
  (import "node:path" join)
  ;; A Node-only native SDK fixture, never a Pi/Agent CLI or model process.
  (defasync runPiReceiverFixture ()
    (let* ((root (nativeGet (nativeGet globalThis.process "env") "DJ_PI_FIXTURE_ROOT"))
           (handlers (new globalThis.Map)) (inputs (js-array))
           (branch (js-array
             (js-object :type "message" :id "pi-native-user" :message (js-object :role "user" :content "中文😀 original"))
             (js-object :type "message" :id "pi-native-answer" :message (js-object :role "assistant" :content "original reply"))))
           (context (js-object :mode "tui" :cwd (js-call globalThis.process :cwd)
             :isIdle (lambda () t) :hasPendingMessages (lambda () false)
             :sessionManager (js-object :getSessionId (lambda () "pi-original-session")
               :getSessionName (lambda () "Original Pi fixture") :getBranch (lambda () branch))))
           (pi (js-object :on (lambda (name handler) (js-call handlers :set name handler))
             :sendUserMessage (async (text)
               (funcall (js-call handlers :get "agent_start") (js-object) context)
               (js-call inputs :push text)
               (js-call branch :push (js-object :type "message" :id (str "pi-native-input-" (js-length inputs))
                 :message (js-object :role "user" :content text)))
               (await (writeFile (join root "inputs.json") (JSON/stringify inputs) (js-object :mode 384)))
               (funcall (js-call handlers :get "agent_end") (js-object) context))))
           (receiver (activatePiReceiver pi (js-object :root root))))
      (await (funcall (js-call handlers :get "session_start") (js-object :reason "startup") context))
      (let* ((files (await (readdir root)))
             (manifest (js-call files :find (lambda (file) (js-call file :endsWith ".json")))))
        (await (writeFile (join root "ready.json") (JSON/stringify (js-object :manifest (join root manifest))) (js-object :mode 384))))
      (js-call (nativeGet globalThis.process "stdin") :once "data" (async (bytes)
        (await (js-call receiver :close))
        (js-call (nativeGet globalThis.process "stdin") :destroy)))
      (js-call (nativeGet globalThis.process "stdin") :resume)))
  (when (nativeGet (nativeGet globalThis.process "env") "DJ_PI_FIXTURE_ROOT")
    (runPiReceiverFixture))
  (export runPiReceiverFixture))
