      (cond
        ((= mode "echo")
          (js-call (nativeGet globalThis.process "stdout") :write
            (JSON/stringify (js-object :argv (js-call argv :slice 3)))))
        ((= mode "overflow") (await (js-call NativeBun :write (nativeGet NativeBun "stdout") (js-call "x" :repeat 2097153))))
