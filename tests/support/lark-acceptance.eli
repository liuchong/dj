(module dj.tests.support.lark-acceptance
  (import "../../src/core/native.eli" nativeGet)
  (defun larkTestBinding ()
    (js-object :schema_version 1 :authorized t :credential_ref "user-oauth.json"
      :operations (js-array "stimulus-lark" "observe-reply-lark")
      :expected_app_id "cli_test" :expected_user_open_id "ou_user" :state_ref "lark-intents.sqlite"
      :targets (js-array (js-object :connection_id "lark-source" :chat_id "oc_chat" :thread_id nil :thread_root_message_id nil)
        (js-object :connection_id "lark-source" :chat_id "oc_chat" :thread_id "omt_thread" :thread_root_message_id "om_root"))))
  (defun larkTestRequest (operation &optional thread)
    (let ((p (js-object :connection_id "lark-source" :chat_id "oc_chat" :thread_id (if thread "omt_thread" nil) :run_id "run-li")))
      (if (= operation "stimulus-lark")
        (put p :text "DJ acceptance run-li: use DJ message.reply to return this exact marker.")
        (Object/assign p (js-object :native_message_ids (js-array "om_reply") :reply_to_message_id "om_source")))
      (js-object :schema_version 1 :request_id "req-li" :operation operation :run_id "run-li" :parameters p)))
  (defun larkTestMessage (id chat thread parent text)
    (js-object :message_id id :chat_id chat :thread_id thread :parent_id parent :msg_type "text" :deleted false
      :sender (js-object :id "ou_user" :id_type "open_id" :sender_type "user")
      :body (js-object :content (JSON/stringify (js-object :text text)))))
  (defun larkTestWire (data &optional identity dry) (js-object :status 200 :wire (js-object :code 0 :data data)))
  (defun createLarkAcceptanceFixture (request &optional variant)
    (let* ((records (new globalThis.Map)) (p (nativeGet request "parameters"))
      (state (js-object :clock 0 :calls (js-array) :writes (js-array) :events (js-array) :on_write nil)))
      (js-object :state state :now (lambda () (nativeGet state "clock"))
        :readIntent (lambda (key) (js-call records :get key))
        :createIntent (lambda (key row) (if (js-call records :has key) false (progn (js-call records :set key row) t)))
        :updateIntent (lambda (key row) (js-call records :set key row) t)
        :request (async (path method body timeout)
          (js-call (nativeGet state "calls") :push (js-object :path path :method method))
          (cond
            ((= path "/open-apis/authen/v1/user_info") (larkTestWire (js-object :open_id (if (= variant "bad-user") "ou_other" "ou_user"))))
            ((= method "POST")
              (when (nativeGet state "on_write") (funcall (nativeGet state "on_write") body))
              (js-call (nativeGet state "writes") :push body)
              (when (= variant "write-error") (throw (new globalThis.Error "native connection lost")))
              (larkTestWire (js-object :message_id "om_created" :chat_id "oc_chat")))
            ((js-call path :startsWith "/open-apis/im/v1/messages/mget")
              (let* ((root (js-call path :includes "om_root"))
                (row (larkTestMessage (if root "om_root" "om_created") "oc_chat" (nativeGet p "thread_id")
                  (if root nil (if (nativeGet p "thread_id") "om_root" nil)) (nativeGet p "text"))))
                (larkTestWire (js-object :items (js-array row)))))
            (t (larkTestWire (js-object :items (js-array (larkTestMessage "om_reply" "oc_chat" (nativeGet p "thread_id") "om_source" "DJ acceptance run-li")) :has_more false))))))))
  (export larkTestBinding larkTestRequest larkTestMessage larkTestWire createLarkAcceptanceFixture))
