(module dj.tests.support.lark-http
  (import "../../src/core/native.eli" nativeGet)
  (defun createLarkHttp (clock variant)
    (let ((calls (js-array)) (attempt 0) (sent (js-array)))
      (js-object :calls calls :sent sent :killed (js-array)
        :credentials (js-object :resolve (lambda (ref)
          (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "fixture-user-token")))
        :http (js-object :fetch (async (address options)
          (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
            (post (= (nativeGet options "method") "POST"))
            (body (when (nativeGet options "body") (JSON/parse (nativeGet options "body")))))
            (if (= path "/open-apis/authen/v1/user_info")
              (Response/json (if (= variant "missing-oauth") (js-object :code 99991663)
                (js-object :code 0 :data (js-object :open_id "ou_user"))))
              (progn
                (setq attempt (1+ attempt))
                (js-call calls :push (js-object :url address :body body :at (js-call clock :utcNow) :mono (js-call clock :monoNow)))
                (if post
                  (progn (js-call sent :push body)
                    (when (= variant "send-response-loss") (throw (new globalThis.Error "native response lost")))
                    (Response/json (js-object :code 0 :data (js-object :message_id "om_fixture_reply" :chat_id "c1"))))
                  (let* ((page (js-call (nativeGet url "searchParams") :get "page_token"))
                    (message (js-object :message_id "m1" :msg_type "text" :chat_id "c1" :create_time "1767225603000"
                      :body (js-object :content "{\"text\":\"observed text\"}")
                      :sender (js-object :id "human-1" :sender_type "user" :name "fixture human")))
                    (messages (js-array message)) (more false) (token nil))
                    (cond
                      ((= variant "same-timestamp-two-pages") (if page (put message :message_id "m2") (setq more t token "second")))
                      ((= variant "empty-page-with-more") (unless page (setq messages (js-array) more t token "second")))
                      ((= variant "expired-token") (if page (put message :message_id "m2") (setq more t token "second")))
                      ((= variant "repeated-token") (setq more t token "same-token"))
                      ((= variant "partial-budget") (setq more t token (str "page-" attempt)))
                      ((= variant "thread-new-reply-old-root") (put message :thread_id "t1") (put message :root_id "old-root") (put message :message_id "new-thread-reply"))
                      ((= variant "non-text") (put message :msg_type "image"))
                      ((= variant "deleted") (put message :deleted t))
                      ((= variant "updated-first-seen") (put message :updated t) (put message :body (js-object :content "{\"text\":\"edited observed value\"}")))
                      ((= variant "initial-cutoff") (js-call messages :push (Object/assign (js-object) message (js-object :message_id "old-history" :create_time "1767225599000")))))
                    (cond
                      ((= variant "missing-scope") (Response/json (js-object :code 99991663)))
                      ((and (= variant "rate-limit-backoff") (= attempt 1)) (Response/json (js-object :code 99991400) (js-object :status 429 :headers (js-object :retry-after "2"))))
                      ((= variant "malformed-output") (new globalThis.Response "{incomplete"))
                      ((= variant "oversized-output") (new globalThis.Response (js-call "x" :repeat 1048577)))
                      (t (Response/json (js-object :code 0 :data (js-object :items messages :has_more more :page_token token))))))))))))))
)
  (export createLarkHttp))
