(module dj.tests.support.direct-control
  (import "../../src/core/native.eli" nativeGet nativeTypeOf)
  (import "./real.eli" waitStarted approvedDriver)
  (import "bun:test" expect)
  (defasync runDirectControl (f tool &optional actions)
    (let* ((target (nativeGet (nativeGet (nativeGet f "profile") "targets") tool))
           (runtime (or actions (js-object :waitStarted waitStarted :approvedDriver approvedDriver))))
      (unless (and (js-call (js-array "opencode" "pi") :includes tool)
        (= (nativeGet target "authorized") t) (= (nativeGet target "allow_model_work") t)
        (= (nativeTypeOf (nativeGet target "session_key")) "string") (> (js-length (nativeGet target "session_key")) 0)
        (= (nativeTypeOf (nativeGet target "native_session_id")) "string") (> (js-length (nativeGet target "native_session_id")) 0))
        (throw (new globalThis.Error "direct_control_target_required")))
      (let* ((connections (await (js-call f :ok "connection.list" (js-object))))
             (session (await (js-call f :ok "session.get" (js-object :session_key (nativeGet target "session_key"))))))
        (js-call (expect (js-length (nativeGet connections "items"))) :toBe 0)
        (unless (and (= (nativeGet session "tool") tool)
          (= (nativeGet session "native_session_id") (nativeGet target "native_session_id"))
          (= (nativeGet session "session_key") (nativeGet target "session_key")))
          (throw (new globalThis.Error "direct_control_target_changed")))
        (let* ((accepted (await (js-call f :ok "session.send" (js-object :session_ref (nativeGet session "session_ref")
                  :content (js-object :type "text" :text (str "DJ direct control " (nativeGet f "run_id") "; respond in this native session."))
                  :idempotency_key (str (nativeGet f "run_id") "-direct")))))
               (started (await (funcall (nativeGet runtime "waitStarted") f (nativeGet accepted "delivery_id"))))
               (delivery (nativeGet started "delivery"))
               (native (await (funcall (nativeGet runtime "approvedDriver") f "observe-direct-input"
                 (js-object :tool tool :native_session_id (nativeGet target "native_session_id")
                   :delivery_id (nativeGet accepted "delivery_id") :run_id (nativeGet f "run_id"))))))
          (js-call (expect (nativeGet delivery "origin")) :toBe "direct")
          (js-call (expect (nativeGet delivery "event_id")) :toBe nil)
          (js-call (expect (nativeGet delivery "reply_context_id")) :toBe nil)
          (js-call (expect (nativeGet native "native_session_id")) :toBe (nativeGet target "native_session_id"))
          (js-call (expect (nativeGet native "observed_delivery_id")) :toBe (nativeGet accepted "delivery_id"))
          (await (js-call f :evidence (js-object :delivery_id (nativeGet accepted "delivery_id")
            :started_receipt (nativeGet started "receipt") :native_observation native)))
          (js-object :delivery delivery :native native)))))
  (export runDirectControl))
