(module dj.tests.support.harness-receiver
  (import "../../src/core/native.eli" nativeGet)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  ;; Synthetic native-protocol server, never an AI/model process.
  (defasync runReceiver ()
    (let* ((root (nativeGet (nativeGet globalThis.process "env") "DJ_HARNESS_FIXTURE_ROOT"))
      (state-path (resolve root "state.json"))
      (rows (js-array (js-object :sessionId "session-original" :cwd root :running false :agentAvailable t :title "Original")))
      (events (js-array)) (server nil))
      (setq server (Bun/serve (js-object :hostname "127.0.0.1" :port 0 :fetch (async (req)
        (let ((path (nativeGet (new globalThis.URL (nativeGet req "url")) "pathname")))
          (if (js-call path :startsWith "/api/session/") (new globalThis.Response "missing" (js-object :status 404))
            (let* ((request (await (js-call req :json))) (args (nativeGet request "payload"))
              (method (nativeGet request "method")) (value nil))
              (cond ((= method "session.list") (setq value (js-object :items rows)))
                ((= method "session.create")
                  (js-call rows :push (js-object :sessionId (nativeGet args "sessionId") :cwd (nativeGet args "cwd") :running false :agentAvailable t :title "New"))
                  (setq value (js-object :sessionId (nativeGet args "sessionId"))))
                ((= method "session.rename")
                  (put (js-call rows :find (lambda (row) (= (nativeGet row "sessionId") (nativeGet args "sessionId")))) :title (nativeGet args "title"))
                  (setq value (js-object)))
                ((= method "session.prompt")
                  (js-call events :push (js-object :event (js-object :seq (1+ (js-length events)) :type "user/message"
                    :data (js-object :source (js-object :kind "user") :content (nativeGet args "content")))))
                  (await (writeFile (resolve root "received.json") (JSON/stringify events)))
                  (let ((state (JSON/parse (await (readFile state-path "utf8")))))
                    (when (nativeGet state "drop") (throw (new globalThis.Error "synthetic-after-write-drop"))))
                  (setq value (js-object :accepted t)))
                ((= method "session.history") (setq value (js-object :events events :hasMore false)))
                (t (throw (new globalThis.Error "unexpected synthetic method"))))
              (Response/json (js-object :type "server-response" :rpcId (nativeGet request "rpcId") :result (js-object :ok t :value value))))))))))
      (await (writeFile (resolve root "receiver.json") (JSON/stringify (js-object :port (nativeGet server "port") :pid (nativeGet globalThis.process "pid")))))
      server))
  (when (js-call (nativeGet globalThis.process "argv") :includes "web") (runReceiver))
  (export runReceiver))
