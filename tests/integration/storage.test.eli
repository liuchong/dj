          ;;    after freeing 1 capacity in next transaction, retry admits 2nd delivery (total = 10000) without duplicate decision/contribution.
          (successful (js-call store :transaction (js-object) (lambda (tx)
            (js-call repository :insert "sessions" (js-object :session_key "mt-sess-b" :tool "must-neighbor-0"
              :native_namespace "mt-ns" :native_session_id "s-2" :instance_id "mt-inst" :instance_epoch "epoch-1"
              :runtime_state "idle" :tombstone false :catalog_seq 2))
            (js-call repository :insert "routes" (js-object :route_id "mt-route-b" :canonical_target_key "mt-target-b"
              :session_key "mt-sess-b" :next_delivery_seq "0" :claim_epoch 0))
            (js-call repository :insert "agents" (js-object :agent_id "mt-agent-b" :route_id "mt-route-b"
              :owner_principal_id "O" :recipient_principal_id "O2" :canonical_target_key "mt-target-b"
              :state "registered" :revision 1))
            (js-call repository :insert "subscriptions" (js-object :subscription_id "mt-sub-3"
              :owner_principal_id "O" :agent_id "mt-agent-b" :state "active" :revision 1))
            (js-call repository :insert "subscription_versions" (js-object :subscription_id "mt-sub-3"
              :revision 1 :state "active" :start_seq 0 :cutover_seq nil :agent_id "mt-agent-b"
              :owner_principal_id "O" :context_policy "message_only"
              :delivery_policy (js-object :busy "queue" :ttl_seconds 300)
              :resolved_sources (js-array (js-object :connection_id "mt-conn" :native_chat_id "chat-1"
                :native_thread_id nil :include_threads t :event_kinds (js-array "message")))
              :predicate (js-object :op "contains" :field "text" :value "match")))
            (js-call db :run
              "INSERT INTO subscription_sources(subscription_id,revision,connection_id,native_chat_id,thread_key,include_threads,event_kind) VALUES (?,?,?,?,?,?,?)"
              (js-array "mt-sub-3" 1 "mt-conn" "chat-1" "null" 1 "message"))
            (js-call repository :insert "sessions" (js-object :session_key "mt-sess-fill" :tool "must-neighbor-0"
              :native_namespace "mt-ns" :native_session_id "s-fill" :instance_id "mt-inst" :instance_epoch "epoch-1"
              :runtime_state "idle" :tombstone false :catalog_seq 3))
            (js-call repository :insert "routes" (js-object :route_id "mt-route-fill" :canonical_target_key "mt-target-fill"
              :session_key "mt-sess-fill" :next_delivery_seq "9996" :claim_epoch 0))
            (js-call db :run
              "WITH RECURSIVE cnt(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM cnt WHERE x < 9996) INSERT INTO operations(operation_id,principal_id,operation,key_hash,request_hash,state,created_at,result_expires_at,payload) SELECT 'fill-op-'||x,'O','session.send','kh-'||x,'rh-'||x,'succeeded','2026-01-01T00:00:00.000Z','2026-01-02T00:00:00.000Z','{\"operation_id\":\"fill-op-'||x||'\"}' FROM cnt")
            (js-call db :run
              "WITH RECURSIVE cnt(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM cnt WHERE x < 9996) INSERT INTO deliveries(delivery_id,route_id,origin,principal_id,operation_id,agent_id,event_id,delivery_seq,state,revision,expires_at,payload) SELECT 'fill-del-'||x,'mt-route-fill','direct','O','fill-op-'||x,NULL,NULL,x,'ready',1,'2026-01-02T00:00:00.000Z','{\"delivery_id\":\"fill-del-'||x||'\",\"route_id\":\"mt-route-fill\",\"origin\":\"direct\",\"state\":\"ready\",\"revision\":1}' FROM cnt")
            (seed-event "mt-ev-cap" 9 "human" "match cap" "ready")
            (success t))))
          (let ((global-sql "SELECT COUNT(*) AS n FROM deliveries WHERE state IN ('ready','deferred','blocked','submitting','unknown')")
            (global-queries 0)
            (cap-del-single 0)
            (cap-del-replaces 0)
            (cap-many-calls (js-array))
            (original-insert (nativeGet repository "insert"))
            (original-insert-many (nativeGet repository "insertMany"))
            (original-replace (nativeGet repository "replace"))
            (original-many-if-absent (nativeGet repository "insertManyIfAbsent"))
            (original-query (js-call (nativeGet db "query") :bind db)))
            (js-call (expect (nativeGet (js-call (js-call db :query global-sql) :get) "n")) :toBe 9999)
