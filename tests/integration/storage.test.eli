                  (put g-db :query (lambda (sql) (when (= sql g-active-sql) (setq reads (1+ reads))) (js-call original-query :call g-db sql)))
                  (successful (await (matchTurn g-context (js-array "g-commit-a" "g-commit-b"))))
                  (js-call (expect reads) :toBe 1)
                  (finally (put g-db :query original-query)))))
