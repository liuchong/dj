                      (js-call (expect (lambda () (js-call p :delivery "route-4"))) :toThrow)
                      (js-call (expect (lambda () (js-call p :capacity "route-4"))) :toThrow)
                      (js-call (expect (lambda () (js-call p :created (js-object :event_id "l2-ev-cap" :route_id "route-6")))) :toThrow)
                      (let ((s1 (js-call repository :get "deliveries" "l2-norm-done-1"))
                        (s2 (js-call repository :get "deliveries" "l2-norm-done-2")))
