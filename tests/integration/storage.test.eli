          ;; deserializing envelope_snapshot, round-trips falsy/structured cursors, and preserves envelope_snapshot on cursor update.
          (successful (js-call store :transaction (js-object) (lambda (tx)
            (let ((att (js-call repository :get "attempts" "observe-attempt"))
              (del (js-call repository :get "deliveries" "observe-delivery")))
              (put att :envelope_snapshot "base64-frozen-envelope-snapshot-payload")
              (put att :observation_cursor 0)
              (successful (js-call repository :replace "attempts" att))
              (put del :state "submitting")
              (js-call repository :replace "deliveries" del)))))
