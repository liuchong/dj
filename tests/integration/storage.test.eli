                        (js-call
                          (expect (nativeGet (nativeGet (aref inputs 2) "envelope") "delivery_id"))
                          :toBe
                          d-seq3-v4-low)
                        (funcall expectPrefixV4 (nativeGet (aref inputs 1) "key") "dispatch")
                        (funcall
                          expectPrefixV4
                          (nativeGet (nativeGet (aref inputs 1) "envelope") "reply_context_id")
                          "reply_context"))
                      ;; Verify attempt_id, receipt_id, and internal reply_context_record_id are UUIDv7:
                      (let
                        ((detail-seq2
                            (await
                              (callOk
                                f
                                "O"
                                "delivery.get"
                                (js-object :delivery_id d-seq2-v7))))
                          (raw-db
                            (new
                              Database
                              (resolve (nativeGet f "root") "state/dj.sqlite")
                              (js-object :readonly t))))
                        (try
