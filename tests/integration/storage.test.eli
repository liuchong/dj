          (legacy-route-keyset-sql
            "SELECT DISTINCT r.route_id AS key FROM routes r JOIN deliveries d ON d.route_id=r.route_id WHERE r.route_id>? AND r.unknown_delivery_id IS NULL AND d.state IN ('ready','deferred','blocked') ORDER BY r.route_id LIMIT ?")
