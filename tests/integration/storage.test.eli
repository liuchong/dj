              (js-call (expect (nativeGet d0 "blocked_reason" nil)) :toBe nil)
              (js-call (expect (nativeGet r0 "col")) :toBe "1")
              (js-call (expect (nativeGet r0 "json_val")) :toBe "1"))
            (js-call (expect (nativeGet (js-call (js-call db :query
              "SELECT COUNT(*) AS n FROM deliveries WHERE event_id='mt-ev-0'") :get) "n")) :toBe 1)
            (js-call (expect (nativeGet (js-call (js-call db :query
              "SELECT COUNT(*) AS n FROM match_decisions WHERE event_id='mt-ev-0'") :get) "n")) :toBe 2)
            (js-call (expect (nativeGet (js-call (js-call db :query
              "SELECT COUNT(*) AS n FROM contributions") :get) "n")) :toBe 2))
          ;; 2) Prepare throw after slot 1 already queued: resolves all waiting futures and performs 0 writes.
