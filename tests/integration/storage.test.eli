                          :toBe
                          d-seq2-v7)
                        ;; Insert a concurrent delivery whose key <= current cursor (d-seq2-v7):
                        (js-call f :enqueueId "delivery" d-concurrent-low)
                        (await
                          (callOk
                            f
                            "S"
                            "session.send"
                            (js-object
                              :agent_id
                              (nativeGet agent-v7 "agent_id")
                              :content
                              (js-object :type "text" :text "concurrent-before-cursor")
                              :idempotency_key
                              "send-concurrent-low")))
                        (await (js-call f :tick))
                        ;; Resuming old cursor advances to > d-seq2-v7 (does not require seeing d-concurrent-low):
                        (let
                          ((dl-p3
                              (await
                                (callOk
                                  f
                                  "O"
                                  "delivery.list"
                                  (js-object :limit 10 :cursor (nativeGet dl-p2 "next_cursor"))))))
                          (js-call
                            (expect
                              (js-call
                                (nativeGet dl-p3 "items")
                                :map
                                (lambda (d) (nativeGet d "delivery_id"))))
                            :toEqual
                            (js-array d-seq1-v4-high))
                          (js-call (expect (nativeGet dl-p3 "complete")) :toBe t))
                        ;; Fresh delivery.list query traverses all 4 mixed rows in complete key order:
                        (let ((collected (js-array)) (cursor nil) (done false))
                          (while (not done)
                            (let
                              ((page
                                  (await
                                    (callOk
                                      f
                                      "O"
                                      "delivery.list"
                                      (if cursor
                                        (js-object :limit 1 :cursor cursor)
                                        (js-object :limit 1))))))
                              (js-call
                                (nativeGet page "items")
                                :forEach
                                (lambda (d) (js-call collected :push (nativeGet d "delivery_id"))))
                              (setq cursor (nativeGet page "next_cursor"))
                              (setq done (nativeGet page "complete"))))
                          (js-call
                            (expect collected)
                            :toEqual
                            (js-array d-seq3-v4-low d-concurrent-low d-seq2-v7 d-seq1-v4-high))))
                      ;; Drain observe on d-concurrent-low before testing pendingRows wrap-around:
                      (await (js-call f :tick))
                      ;; 5. Background pendingRows keyset wrap-around from high v4 key to smaller v7 key:
                      (let
                        ((d-unk-v4-high "delivery_ffffffff-ffff-4fff-bfff-fffffffffff9"))
                        (put (nativeGet peer "behavior") :submit "throw")
                        (js-call f :enqueueId "delivery" d-unk-v4-high)
                        (let*
                          ((sent-unk-high
                              (await
                                (callOk
                                  f
                                  "S"
                                  "session.send"
                                  (js-object
                                    :agent_id
                                    (nativeGet agent-v4-high "agent_id")
                                    :content
                                    (js-object :type "text" :text "unknown-v4-high")
                                    :idempotency_key
                                    "send-unk-high"))))
                            (sent-unk-v7
                              (await
                                (callOk
                                  f
                                  "S"
                                  "session.send"
                                  (js-object
                                    :agent_id
                                    (nativeGet agent-v7 "agent_id")
                                    :content
                                    (js-object :type "text" :text "unknown-v7")
                                    :idempotency_key
                                    "send-unk-v7"))))
                            (d-unk-v7 (nativeGet sent-unk-v7 "delivery_id")))
                          (js-call (expect (nativeGet sent-unk-high "delivery_id")) :toBe d-unk-v4-high)
                          (funcall expectPrefixV7 d-unk-v7 "delivery")
                          (js-call (expect (< d-unk-v7 d-unk-v4-high)) :toBe t)
                          (await (js-call f :tick))
                          (js-call
                            (expect
                              (nativeGet
                                (await
                                  (callOk
                                    f
                                    "O"
                                    "delivery.get"
                                    (js-object :delivery_id d-unk-v4-high)))
                                "state"))
                            :toBe
                            "unknown")
                          (js-call
                            (expect
                              (nativeGet
                                (await
                                  (callOk f "O" "delivery.get" (js-object :delivery_id d-unk-v7)))
                                "state"))
                            :toBe
                            "unknown")
                          (put (nativeGet peer "behavior") :submit "accepted")
                          (put
                            peer
                            :lookup
                            (async
                              (binding key ref context)
                              (js-object
                                :state
                                "accepted"
                                :kind
                                "accepted"
                                :evidence_level
                                "native_protocol"
                                :dispatch_key
                                key
                                :native_ref
                                (str "reconciled-" key))))
                          (put
                            peer
                            :observe
                            (async
                              (binding ref cursor budget context)
                              (js-object
                                :items
                                (js-array
                                  (js-object
                                    :kind
                                    "settled"
                                    :evidence_level
                                    "native_protocol"
                                    :native_ref
                                    ref
                                    :native_receipt_key
                                    (str "settled-" ref)))
                                :next_cursor
                                nil
                                :complete
                                t)))
                          ;; First reconcile high v4 key so delivery_reconcile cursor sits at d-unk-v4-high:
                          (await
                            (callOk
                              f
                              "S"
                              "delivery.reconcile"
                              (js-object :delivery_id d-unk-v4-high :idempotency_key "rec-high")))
                          (await (js-call f :tick))
                          (js-call
                            (expect
                              (nativeGet
                                (await
                                  (callOk
                                    f
                                    "O"
                                    "delivery.get"
                                    (js-object :delivery_id d-unk-v4-high)))
                                "state"))
                            :toBe
                            "accepted")
                          ;; Now request reconcile on smaller v7 key; next tick wraps delivery_reconcile from ""
                          ;; while observe advances to d-unk-v4-high:
                          (await
                            (callOk
                              f
                              "S"
                              "delivery.reconcile"
                              (js-object :delivery_id d-unk-v7 :idempotency_key "rec-v7")))
                          (await (js-call f :tick))
                          (let
                            ((after-rec-v7
                                (await
                                  (callOk f "O" "delivery.get" (js-object :delivery_id d-unk-v7)))))
                            (js-call (expect (nativeGet after-rec-v7 "state")) :toBe "accepted"))
                          ;; Next tick wraps observe from d-unk-v4-high back to "" and drains d-unk-v7:
                          (await (js-call f :tick))
                          (let*
                            ((after-obs-v7
                                (await
                                  (callOk f "O" "delivery.get" (js-object :delivery_id d-unk-v7))))
                              (receipts (nativeGet after-obs-v7 "receipts")))
                            (js-call
                              (expect
                                (js-call
                                  receipts
                                  :some
                                  (lambda (r) (= (nativeGet r "kind") "settled"))))
                              :toBe
                              t)
                            (js-call
                              receipts
                              :forEach
                              (lambda (r) (funcall expectPrefixV7 (nativeGet r "receipt_id") "receipt"))))
                          ;; 6. Duplicate entity ID collision hits SQLite unique constraint and rolls back transaction:
                          (js-call f :enqueueId "delivery" d-unk-v7)
                          (let
                            ((collision
                                (await
                                  (js-call
                                    f
                                    :call
                                    (nativeGet f "S")
                                    "session.send"
                                    (js-object
                                      :agent_id
                                      (nativeGet agent-v7 "agent_id")
                                      :content
                                      (js-object :type "text" :text "must-not-overwrite")
                                      :idempotency_key
                                      "send-collision-key"))))
                              (op-check
                                (await
                                  (js-call
                                    f
                                    :call
                                    (nativeGet f "S")
                                    "operation.get"
                                    (js-object
                                      :operation
                                      "session.send"
                                      :idempotency_key
                                      "send-collision-key"))))
                              (raw-db
                                (new
                                  Database
                                  (resolve (nativeGet f "root") "state/dj.sqlite")
                                  (js-object :readonly t))))
                            (try
                              (let
                                ((persisted
                                    (JSON/parse
                                      (nativeGet
                                        (js-call
                                          (js-call
                                            raw-db
                                            :query
                                            "SELECT payload FROM deliveries WHERE delivery_id=?")
                                          :get
                                          d-unk-v7)
                                        "payload"))))
                                (js-call (expect (nativeGet collision "ok")) :toBe false)
                                (js-call
                                  (expect (nativeGet (nativeGet collision "error") "code"))
                                  :toBe
                                  "storage_unavailable")
                                (js-call (expect (nativeGet op-check "ok")) :toBe false)
                                (js-call
                                  (expect (nativeGet (nativeGet op-check "error") "code"))
                                  :toBe
                                  "not_found")
                                (js-call
                                  (expect
                                    (nativeGet (nativeGet persisted "content") "text"))
                                  :toBe
                                  "unknown-v7"))
                              (finally (js-call raw-db :close)))))))))))))))
    closeFixture))
