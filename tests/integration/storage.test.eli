                    (let ((i 0)) (while (< i fill)
                      (js-call sentinels :push (enqueueWrite g-context (lambda () (setq sentinel-calls (1+ sentinel-calls)) (success t))))
                      (setq i (1+ i))))
                    (setq group-promise (js-call (js-call (matchTurn g-context ids) :then
