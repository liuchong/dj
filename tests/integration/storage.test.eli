                  (js-call (expect (nativeGet page-1 "state")) :toBe "ready")
                  (js-call (expect (nativeGet page-1 "complete")) :toBe false)
                  (js-call (expect paged-existing-lookups) :toBe 1)
                  (js-call (expect paged-unlock-sql) :toBe 0)
