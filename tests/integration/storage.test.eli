                    (js-call (expect (js-length (nativeGet (nativeGet (nativeGet g-context "runtime") "write_batch") "pending"))) :toBe 64)
                    (put NativeGlobal :queueMicrotask old-microtask)
                    (setq flushed t) (funcall (aref held 0))
                    (await (Promise/all sentinels)) (await group-promise)
