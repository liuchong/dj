                            (let
                              ((unauth-del
                                  (await
                                    (js-call
                                      f
                                      :call
                                      (nativeGet f "X")
                                      "delivery.get"
                                      (js-object :delivery_id d-seq2-v7))))
                                (unauth-msg
                                  (await
                                    (js-call
                                      f
                                      :call
                                      (nativeGet f "X")
                                      "message.get"
