          (js-call repository :insert "subscription_versions" (js-object :subscription_id "observe-sub"
            :revision 1 :start_seq 0 :cutover_seq nil :state "active"))
          (js-call repository :insert "deliveries" (js-object :delivery_id "observe-sub-delivery"
            :route_id "observe-route" :origin "subscription_event" :principal_id nil :operation_id nil
            :agent_id "observe-agent" :event_id "observe-event" :delivery_seq "2" :state "accepted"
