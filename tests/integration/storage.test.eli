            (js-call (expect (nativeGet (aref (nativeGet auth-direct "receipts") 0) "attempt_id")) :toBe "observe-attempt")
            (js-call (expect (nativeGet auth-sub "session_key")) :toBe "observe-session")
            (js-call (expect (nativeGet (nativeGet auth-sub "source") "kind")) :toBe "im")
            (js-call (expect (js-length (nativeGet auth-sub "contributions"))) :toBe 1)
            (js-call (expect (nativeGet (aref (nativeGet auth-sub "contributions") 0) "state")) :toBe "effective")
            (js-call (expect (js-length (nativeGet auth-sub "receipts"))) :toBe 1)
            (js-call (expect (nativeGet (aref (nativeGet auth-sub "receipts") 0) "receipt_id")) :toBe "observe-sub-receipt"))
          (let ((unauth-direct (projectDelivery unauth-context direct-record))
