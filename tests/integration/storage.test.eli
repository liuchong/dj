                              (js-call (expect (nativeGet unauth-msg "ok")) :toBe false)
                              (js-call
                                (expect (nativeGet (nativeGet unauth-msg "error") "code"))
                                :toBe
                                "forbidden")
                              (js-call (expect (nativeGet raw-record-reply "ok")) :toBe false)
                              (js-call
                                (expect (nativeGet (nativeGet raw-record-reply "error") "code"))
