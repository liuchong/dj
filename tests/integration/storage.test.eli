            (funcall original-replace table record expected)))
          (put repository :replaceProgress (lambda (table record &optional expected)
            (setq progress-replace-calls (1+ progress-replace-calls))
            (if (and (= table "deliveries") (= (nativeGet record "reconcile_requested") false))
              (failure "revision_conflict")
              (funcall original-replace-progress table record expected))))
          (let ((clear-failed (await (reconcileDelivery context "observe-delivery"))))
            (js-call (expect (nativeGet clear-failed "ok")) :toBe false)
            (js-call (expect (nativeGet (nativeGet clear-failed "error") "code")) :toBe "revision_conflict")
            (js-call (expect full-replace-calls) :toBe 0)
            (js-call (expect progress-replace-calls) :toBe 3)
            (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "state")) :toBe "unknown")
            (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "reconcile_requested")) :toBe t)
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM receipts WHERE attempt_id='observe-attempt'") :get) "n")) :toBe 0))
          (put repository :replaceProgress (lambda (table record &optional expected)
            (setq progress-replace-calls (1+ progress-replace-calls))
            (funcall original-replace-progress table record expected)))
          (setq progress-replace-calls 0)
          (successful (await (reconcileDelivery context "observe-delivery")))
          (js-call (expect full-replace-calls) :toBe 0)
          (js-call (expect progress-replace-calls) :toBe 3)
          (put repository :replace original-replace)
          (put repository :replaceProgress original-replace-progress))
        (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "state")) :toBe "accepted")
        (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "reconcile_requested")) :toBe false)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM receipts WHERE attempt_id='observe-attempt'") :get) "n")) :toBe 1)
        ;; Background projectDelivery (without context.principal) returns minimalDelivery with 0 repository.get reads;
        ;; caller-bound projectDelivery preserves full authorization, event visibility, and receipt isolation.
        (successful (js-call store :transaction (js-object) (lambda (tx)
