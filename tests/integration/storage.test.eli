            :platform "telegram" :allowed_chats (js-array "chat-1") :revision 1 :identity_revision 1 :state "online"))
          (js-call repository :insert "events" (js-object :event_id "observe-event" :connection_id "observe-conn"
            :source_key "observe-src-1" :conversation_key "telegram:observe-conn:chat-1:main"
            :conversation (js-object :connection_id "observe-conn" :native_chat_id "chat-1" :native_thread_id nil :thread_kind "main")
            :native_message_id "msg-1" :event_kind "message" :ingress_seq 1 :identity_revision 1
            :received_at "2026-01-01T00:00:00Z" :body_expires_at "2026-01-02T00:00:00Z" :tombstone false
            :content (js-object :kind "text" :text "hello")))
