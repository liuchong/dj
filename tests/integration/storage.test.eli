              (funcall original-get table key)))
            (let ((before-changes (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")))
              (successful (await (observeDelivery context "observe-delivery" (js-object))))
              (js-call (expect (nativeGet table-gets "deliveries")) :toBe 1)
              (js-call (expect (nativeGet table-gets "attempts")) :toBe 0)
              (js-call (expect (nativeGet table-gets "bindings")) :toBe 0)
              (js-call (expect (nativeGet table-gets "instances")) :toBe 0)
              (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe before-changes))
            (put repository :get original-get))
          (successful (js-call store :transaction (js-object) (lambda (tx)
            (let ((del (js-call repository :get "deliveries" "observe-delivery")))
              (put del :state "accepted")
              (js-call repository :replace "deliveries" del)))))
          (let ((attempt-gets 0)
            (obs-full-replaces 0)
            (obs-progress-replaces 0)
            (original-replace (nativeGet repository "replace"))
            (original-replace-progress (nativeGet repository "replaceProgress")))
            (put repository :get (lambda (table key)
              (when (= table "attempts") (setq attempt-gets (1+ attempt-gets)))
              (funcall original-get table key)))
            (put repository :replace (lambda (table record &optional expected)
