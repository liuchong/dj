              (when (= table "routes") (setq route-gets (1+ route-gets)))
              (when (= table "subscriptions") (setq sub-full-gets (1+ sub-full-gets)))
              (when (= table "match_decisions") (setq md-gets (1+ md-gets)))
              (when (= table "contributions") (setq contrib-gets (1+ contrib-gets)))
              (funcall original-get table key)))
            (put repository :getSubscriptionState (lambda (id)
