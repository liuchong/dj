              :revision (nativeGet direct-record "revision") :operation_id "observe-operation"))
            (js-call (expect unauth-sub) :toEqual (js-object
              :delivery_id "observe-sub-delivery" :origin "subscription_event" :state "accepted"
              :revision 1 :operation_id nil)))
          (put repository :get original-get)
          (successful (js-call store :transaction (js-object) (lambda (tx)
            (let ((ev (js-call repository :get "events" "observe-event")))
