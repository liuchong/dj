                    (js-call (expect group-done) :toBe t)
                    (js-call (expect sentinel-calls) :toBe fill)
                    (js-call (expect (nativeGet (nativeGet group-result "error") "code")) :toBe "unavailable")
                    (js-call (expect (nativeGet (js-call (js-call g-db :query
