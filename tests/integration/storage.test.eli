              (js-call repository :insert "bindings" (js-object :binding_id "p1-bind-1" :route_id "route-seq-big"
                :instance_id "inst-1" :instance_epoch "epoch-1" :expires_at "2026-01-02T00:00:00.000Z"))
              (js-call repository :insert "deliveries" (js-object :delivery_id "p1-sub-del" :route_id "route-seq-big"
                :origin "subscription_event" :principal_id nil :operation_id nil :agent_id "agent-1" :event_id "ins-ev-1"
                :delivery_seq "9007199254740993" :state "ready" :revision 2 :expires_at "2026-01-02T00:00:00.000Z"
