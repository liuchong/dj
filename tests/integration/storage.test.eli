  (withCase
    "T40.mixed-entity-ids.sqlite"
    (async
      ()
      (let ((queued-ids (new globalThis.Map)))
        (let
          ((f
              (await
                (createFixture
                  "mixed-entity-ids"
                  "one"
                  (js-object
                    :configure
                    (lambda
                      (config ports)
                      (let ((real-next (nativeGet (nativeGet ports "ids") "next")))
                        (put
                          (aref (nativeGet config "principals") 3)
                          :target_constraint
                          (js-object
                            :tool
                            "opencode"
                            :native_namespace
                            "ns-opencode"
                            :native_session_id
                            "s2"))
                        (put
                          ports
                          :ids
                          (js-object
                            :next
                            (lambda
                              (prefix)
                              (let ((queue (js-call queued-ids :get prefix)))
                                (if (and queue (> (js-length queue) 0))
                                  (js-call queue :shift)
                                  (funcall real-next prefix)))))))))))))
          (put
            f
            :enqueueId
            (lambda
              (prefix id)
              (let ((queue (or (js-call queued-ids :get prefix) (js-array))))
                (js-call queue :push id)
                (js-call queued-ids :set prefix queue))))
          f)))
    (async
      (f)
      (let*
        ((v7-pattern
            (new
              globalThis.RegExp
              "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"))
          (v4-pattern
            (new
              globalThis.RegExp
              "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"))
          (expectPrefixV7
            (lambda
              (value prefix)
              (let ((head (str prefix "_")))
                (js-call (expect (js-call value :startsWith head)) :toBe t)
                (js-call
                  (expect (js-call v7-pattern :test (js-call value :slice (js-length head))))
                  :toBe
                  t))))
          (expectPrefixV4
            (lambda
              (value prefix)
              (let ((head (str prefix "_")))
                (js-call (expect (js-call value :startsWith head)) :toBe t)
                (js-call
                  (expect (js-call v4-pattern :test (js-call value :slice (js-length head))))
                  :toBe
                  t))))
          (peer (nativeGet f "opencode"))
          (sessions (nativeGet peer "sessions"))
          (discovered
            (nativeGet
              (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live")))
              "items"))
          (cand-s1
            (js-call discovered :find (lambda (x) (= (nativeGet x "native_session_id") "s1"))))
          (cand-s2
            (js-call discovered :find (lambda (x) (= (nativeGet x "native_session_id") "s2")))))
        (funcall expectPrefixV4 (nativeGet cand-s1 "candidate_ref") "candidate")
        ;; 1. Register agent-v7 (s1, real nextHostId) and agent-v4-high (s2, historical v4 high keys):
        (let*
          ((agent-v7
              (await
                (callOk
                  f
                  "O"
                  "agent.register"
                  (js-object
                    :candidate_ref
                    (nativeGet cand-s1 "candidate_ref")
                    :display_name
                    "agent-v7"
                    :binding_mode
                    "existing"
                    :recipient_principal_id
                    "A"
                    :idempotency_key
                    "reg-agent-v7"))))
            (agent-v4-high-id "agent_ffffffff-ffff-4fff-bfff-fffffffffff1")
            (route-v4-high-id "route_ffffffff-ffff-4fff-bfff-fffffffffff1"))
          (funcall expectPrefixV7 (nativeGet agent-v7 "agent_id") "agent")
          (funcall expectPrefixV7 (nativeGet agent-v7 "route_id") "route")
          (funcall expectPrefixV7 (nativeGet (nativeGet agent-v7 "binding") "binding_id") "binding")
          (js-call f :enqueueId "agent" agent-v4-high-id)
          (js-call f :enqueueId "route" route-v4-high-id)
          (let*
            ((agent-v4-high
                (await
                  (callOk
                    f
                    "O"
                    "agent.register"
                    (js-object
                      :candidate_ref
                      (nativeGet cand-s2 "candidate_ref")
                      :display_name
                      "agent-v4-high"
                      :binding_mode
                      "existing"
                      :recipient_principal_id
                      "B"
                      :idempotency_key
                      "reg-agent-v4-high"))))
              (agents-p1 (await (callOk f "O" "agent.list" (js-object :limit 1))))
              (agents-p2
                (await
                  (callOk
                    f
                    "O"
                    "agent.list"
                    (js-object :limit 1 :cursor (nativeGet agents-p1 "next_cursor"))))))
            (js-call (expect (nativeGet agent-v4-high "agent_id")) :toBe agent-v4-high-id)
            (js-call (expect (nativeGet agent-v4-high "route_id")) :toBe route-v4-high-id)
            (funcall expectPrefixV4 (nativeGet agents-p1 "next_cursor") "cursor")
            (js-call
              (expect (nativeGet (aref (nativeGet agents-p1 "items") 0) "agent_id"))
              :toBe
              (nativeGet agent-v7 "agent_id"))
            (js-call
              (expect (nativeGet (aref (nativeGet agents-p2 "items") 0) "agent_id"))
              :toBe
              agent-v4-high-id)
            ;; 2. Create mixed v4-high + v7 subscriptions on agent-v7 and verify subscription.list & matcher:
            (let*
              ((sub-v4-high-id "subscription_ffffffff-ffff-4fff-bfff-fffffffffff1")
                (conv
                  (await
                    (callOk
                      f
                      "A"
                      "conversation.resolve"
                      (js-object :connection_id "lark" :chat_id "c1" :thread_id nil)))))
              (funcall expectPrefixV4 (nativeGet conv "conversation_ref") "conversation")
              (js-call f :enqueueId "subscription" sub-v4-high-id)
              (let*
                ((sub-v4-high (await (subscribe f agent-v7 "lark" 60 "A")))
                  (sub-v7 (await (subscribe f agent-v7 "lark" 120 "A")))
                  (subs-p1 (await (callOk f "O" "subscription.list" (js-object :limit 1))))
                  (subs-p2
                    (await
                      (callOk
                        f
                        "O"
                        "subscription.list"
                        (js-object :limit 1 :cursor (nativeGet subs-p1 "next_cursor"))))))
                (js-call (expect (nativeGet sub-v4-high "subscription_id")) :toBe sub-v4-high-id)
                (funcall expectPrefixV7 (nativeGet sub-v7 "subscription_id") "subscription")
                (js-call
                  (expect (nativeGet (aref (nativeGet subs-p1 "items") 0) "subscription_id"))
                  :toBe
                  (nativeGet sub-v7 "subscription_id"))
                (js-call
                  (expect (nativeGet (aref (nativeGet subs-p2 "items") 0) "subscription_id"))
                  :toBe
                  sub-v4-high-id)
                ;; 3. Enqueue 3 deliveries on agent-v7 route while busy:
                ;;    seq 1 = v4 high, seq 2 = real v7 (via subscription event), seq 3 = v4 low.
                ;;    Verify dispatch order follows delivery_seq, NOT lexicographical delivery_id!
                (put (aref sessions 0) :runtime_state "busy")
                (let
                  ((d-seq1-v4-high "delivery_ffffffff-ffff-4fff-bfff-fffffffffff1")
                    (d-seq3-v4-low "delivery_00000000-0000-4000-8000-000000000003")
                    (d-concurrent-low "delivery_00000000-0000-4000-8000-000000000005"))
                  (js-call f :enqueueId "delivery" d-seq1-v4-high)
                  (let
                    ((sent-seq1
                        (await
                          (callOk
                            f
                            "S"
                            "session.send"
                            (js-object
                              :agent_id
                              (nativeGet agent-v7 "agent_id")
                              :content
                              (js-object :type "text" :text "seq-1-v4-high")
                              :idempotency_key
                              "send-seq-1")))))
                    (js-call (expect (nativeGet sent-seq1 "delivery_id")) :toBe d-seq1-v4-high))
                  (let
                    ((ingested
                        (successful
                          (await
                            (js-call
                              f
                              :ingest
                              (createdEvent "lark" "m-mixed-1" "seq-2-v7-event"))))))
                    (funcall expectPrefixV7 (nativeGet ingested "event_id") "event")
                    (await (js-call f :tick))
                    (js-call f :enqueueId "delivery" d-seq3-v4-low)
                    (let*
                      ((sent-seq3
                          (await
                            (callOk
                              f
                              "S"
                              "session.send"
