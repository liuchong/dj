                    (js-call (expect (js-length (nativeGet (nativeGet (nativeGet g-context "runtime") "write_batch") "pending"))) :toBe 0)
                    (finally
                      (put NativeGlobal :queueMicrotask old-microtask)
                      (unless flushed (js-call held :forEach (lambda (fn) (funcall fn))))
                      (await (Promise/all sentinels))
                      (when group-promise (await group-promise))))
                  (let ((reads 0) (id (aref ids (if (= fill 60) 4 0))))
                    (try
                      (put g-db :query (lambda (sql) (when (= sql g-active-sql) (setq reads (1+ reads))) (js-call original-query :call g-db sql)))
                      (successful (await (matchTurn g-context (js-array id))))
                      (js-call (expect reads) :toBe 1)
