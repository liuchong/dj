              (js-call (expect (- (js-length (nativeGet runtime "routing_samples")) samples-before)) :toBe 3)))
          ;; 4) Unknown write exception rolls back the entire write-batch transaction and publishes 0 metrics.
          (let ((samples-before (js-length (nativeGet runtime "routing_samples")))
            (original-replace (nativeGet repository "replace")))
