            ;; P1a: repository.replaceProgress(table, record, expectedRevision?)
            ;; - Only supports deliveries (state, revision), attempts (state, definite_not_sent), routes (binding_id, claim_owner, unknown_delivery_id) + full payload
            ;; - Requires active sync transaction; rejects unsupported tables and revision guard on non-revisioned tables with TypeError before SQL
            ;; - Guards all remaining declared typed columns with `column IS ?` (handling NULL, booleans, and >2^53 text integers)
