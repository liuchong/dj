                  (js-call (expect narrow-head-calls) :toBe 1)
                  (js-call (expect payload-head-calls) :toBe 0)
                  (js-call (expect (nativeGet claimed-r2 "route_id")) :toBe "r2")
                  (js-call (expect (nativeGet claimed-r2 "delivery_id")) :toBe "r2-d3")
                  (js-call (expect (nativeGet claimed-r2 "claim_owner")) :toBe "idx-owner")
                  (js-call (expect (nativeGet claimed-r2 "claim_epoch")) :toBe "1")))
              (finally
                (put db :query orig-db-query)))
            (successful (js-call store :transaction (js-object) (lambda (tx)
              (js-call repository :delete "claims" "r2")
              (js-call db :run
                "UPDATE routes SET claim_epoch=0,claim_owner=NULL,payload=json_set(payload,'$.claim_epoch',0,'$.claim_owner',NULL) WHERE route_id='r2'")
              (js-call repository :delete "deliveries" "r-acc-d1")
              (js-call repository :delete "operations" "op-r-acc-1")
              (js-call repository :delete "routes" "r-acc")
              (js-call repository :delete "routes" "r-empty")
              (js-object :ok t :data nil))))))
        ;; Match the production predicate exactly, including absent/false flags.
        (js-call db :run "CREATE TEMP TABLE pending_probe(delivery_id TEXT PRIMARY KEY,state TEXT,payload TEXT)")
        (js-call db :run "CREATE INDEX temp.pending_probe_requested ON pending_probe(delivery_id) WHERE json_extract(payload,'$.reconcile_requested')=1")
        (js-call db :run "CREATE INDEX temp.pending_probe_observe ON pending_probe(delivery_id) WHERE state='accepted' AND COALESCE(json_extract(payload,'$.native_drained'),0)=0")
        (js-call db :run "INSERT INTO pending_probe VALUES ('a','accepted','{}'),('b','accepted','{\"reconcile_requested\":true,\"native_drained\":false}'),('c','accepted','{\"reconcile_requested\":false,\"native_drained\":true}'),('d','unknown','{\"reconcile_requested\":true}')")
        (let ((requested (lambda (after)
          (js-call (js-call db :query "SELECT delivery_id FROM pending_probe WHERE delivery_id>? AND json_extract(payload,'$.reconcile_requested')=1 ORDER BY delivery_id LIMIT 1") :all after)))
          (observe (lambda () (js-call (js-call db :query "SELECT delivery_id FROM pending_probe WHERE state='accepted' AND COALESCE(json_extract(payload,'$.native_drained'),0)=0 ORDER BY delivery_id") :all))))
          (js-call (expect (requested "")) :toEqual (js-array (js-object :delivery_id "b")))
          (js-call (expect (requested "b")) :toEqual (js-array (js-object :delivery_id "d")))
          (js-call (expect (observe)) :toEqual (js-array (js-object :delivery_id "a") (js-object :delivery_id "b")))
          (js-call db :run "UPDATE pending_probe SET payload=json_set(payload,'$.reconcile_requested',json('false'),'$.native_drained',json('true')) WHERE delivery_id='b'")
          (js-call (expect (requested "")) :toEqual (js-array (js-object :delivery_id "d")))
          (js-call (expect (observe)) :toEqual (js-array (js-object :delivery_id "a"))))
        ;; Verify 5-state route head partial index skips accepted history while preserving unknown/submitting head barriers.
        (js-call db :run "CREATE TEMP TABLE head_probe(delivery_id TEXT PRIMARY KEY,route_id TEXT,delivery_seq INTEGER,state TEXT)")
        (js-call db :run "CREATE INDEX temp.head_probe_index ON head_probe(route_id,delivery_seq) WHERE state IN ('ready','deferred','blocked','submitting','unknown')")
        (js-call db :run "INSERT INTO head_probe VALUES ('r1-1','r1',1,'accepted'),('r1-2','r1',2,'unknown'),('r1-3','r1',3,'ready'),('r2-1','r2',1,'accepted'),('r2-2','r2',2,'submitting'),('r2-3','r2',3,'ready')")
        (let ((head-of (lambda (route)
          (js-call (js-call db :query "SELECT delivery_id,state FROM head_probe WHERE route_id=? AND state IN ('ready','deferred','blocked','submitting','unknown') ORDER BY delivery_seq LIMIT 1") :get route))))
          (js-call (expect (head-of "r1")) :toEqual (js-object :delivery_id "r1-2" :state "unknown"))
          (js-call (expect (head-of "r2")) :toEqual (js-object :delivery_id "r2-2" :state "submitting"))
          (js-call db :run "UPDATE head_probe SET state='accepted' WHERE delivery_id='r1-2'")
          (js-call (expect (head-of "r1")) :toEqual (js-object :delivery_id "r1-3" :state "ready")))
        ;; K3 populated-store migration & UNIQUE(route_id,delivery_seq) / delivery.list plan verification:
        (js-call db :run "CREATE INDEX deliveries_route_pending ON deliveries(route_id,delivery_seq,state)")
        (js-call (expect (funcall has-index "deliveries_route_pending")) :toBe 1)
        (migrate db)
        (migrate db)
        (js-call (expect (funcall has-index "deliveries_route_pending")) :toBe 0)
        (js-call (expect (funcall has-index "deliveries_route_head")) :toBe 1)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries") :get) "n")) :toBe 26)
        (js-call (expect (lambda ()
          (js-call db :run
            "INSERT INTO deliveries(delivery_id,route_id,origin,principal_id,operation_id,agent_id,event_id,delivery_seq,state,revision,expires_at,payload) VALUES ('dup-seq-del','r1','direct','O','op-r1-1',NULL,NULL,1,'ready',1,'2026-01-02T00:00:00Z','{}')")))
          :toThrow "UNIQUE constraint failed")
        (let ((list-all-plan (funcall explain-plan
            "SELECT payload FROM deliveries WHERE delivery_id>? ORDER BY delivery_id LIMIT ?" "" 50))
          (list-state-plan (funcall explain-plan
            "SELECT payload FROM deliveries WHERE state=? AND delivery_id>? ORDER BY delivery_id LIMIT ?" "ready" "" 50)))
          (js-call (expect (js-call list-all-plan :includes "deliveries_route_pending")) :toBe false)
          (js-call (expect (js-call list-all-plan :includes "TEMP B-TREE")) :toBe false)
          (js-call (expect (js-call list-state-plan :includes "deliveries_state")) :toBe t)
          (js-call (expect (js-call list-state-plan :includes "deliveries_route_pending")) :toBe false)
          (js-call (expect (js-call list-state-plan :includes "TEMP B-TREE")) :toBe false))))
    close)
  (import "../../src/catalog/records.eli" createMetadataQuota writeSessionVersion attachBinding)
  (import "../../src/catalog/refresh.eli" contentIndexBytes)
  (defun quotaRecord (id)
    (js-object :session_key id :tool "opencode" :native_namespace "quota"
      :native_session_id id :instance_id "quota-instance" :instance_epoch "epoch"
      :runtime_state "idle" :tombstone false :title "quota boundary"))
  (withCase "T16.observation-checkpoint.sqlite" setup
    (async (store)
      (let* ((repository (createRepository store)) (cursor nil) (lookup-observation nil)
        (principal (js-object :principal_id "O" :kind "operator" :authorization_revision 1 :grants (js-array)))
        (ports (js-object :clock (createClock) :ids (js-object :next (lambda (prefix) (str prefix "-" (randomUUID)))) :agent_ports (new globalThis.Map)))
        (context (js-object :store store :repository repository :ports ports :runtime (js-object)
          :principal principal :config (js-object :principals (js-array principal))))
        (db (nativeGet store "db"))
        (binding (js-object :tool "opencode" :native_namespace "observe"
          :native_session_id "native" :instance_id "observe-instance" :instance_epoch "epoch")))
        (js-call (nativeGet ports "agent_ports") :set "opencode"
          (js-object
            :capabilities (js-object :start_idle "supported" :max_input_frame_bytes 65536)
            :observe (async (binding ref checkpoint budget native)
              (js-object :items (js-array) :next_cursor cursor :complete t))
            :lookup (async (binding key ref native) lookup-observation)))
        (successful (js-call store :transaction (js-object) (lambda (tx)
          (js-call repository :insert "tools" (js-object :tool_id "opencode" :configured t))
          (js-call repository :insert "instances" (js-object :instance_id "observe-instance"
            :tool "opencode" :native_namespace "observe" :instance_epoch "epoch"
            :ownership "existing" :state "ready" :revision 1))
          (successful (writeSessionVersion context (Object/assign (js-object) binding
            (js-object :session_key "observe-session" :runtime_state "idle" :tombstone false))))
          (js-call repository :insert "routes" (js-object :route_id "observe-route"
            :session_key "observe-session" :canonical_target_key "observe-target"
            :next_delivery_seq "1" :claim_epoch 0))
          (js-call repository :insert "operations" (js-object :operation_id "observe-operation"
            :principal_id "O" :operation "session.send" :key_hash "k" :request_hash "r"
            :state "accepted" :created_at "2026-01-01T00:00:00Z" :result_expires_at "2026-01-02T00:00:00Z"))
          (js-call repository :insert "deliveries" (js-object :delivery_id "observe-delivery"
            :route_id "observe-route" :origin "direct" :principal_id "O" :operation_id "observe-operation"
            :delivery_seq "1" :state "accepted" :revision 1 :expires_at "2026-01-02T00:00:00Z"
            :attempt_id "observe-attempt" :native_ref "native-receipt"))
          (js-call repository :insert "attempts" (js-object :attempt_id "observe-attempt"
            :delivery_id "observe-delivery" :dispatch_key "observe-dispatch" :state "accepted"
            :definite_not_sent false :binding binding))
          (js-object :ok t :data nil))))
        (let ((before (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")))
          (successful (await (observeDelivery context "observe-delivery" (js-object))))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe before)
          (setq cursor "next-native-page")
          (successful (await (observeDelivery context "observe-delivery" (js-object))))
          (js-call (expect (nativeGet (js-call repository :get "attempts" "observe-attempt") "observation_cursor")) :toBe cursor)
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe (1+ before))
          (successful (await (observeDelivery context "observe-delivery" (js-object))))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe (1+ before)))
        ;; Normalized attempts resolve the original immutable binding by ID,
        ;; even after the route points to a different live binding.
        (successful (js-call store :transaction (js-object) (lambda (tx)
          (js-call repository :insert "bindings" (Object/assign (js-object) binding
            (js-object :binding_id "frozen-binding" :route_id "observe-route" :expires_at "2026-01-02T00:00:00Z")))
          (let ((attempt (js-call repository :get "attempts" "observe-attempt"))
            (route (js-call repository :get "routes" "observe-route")))
            (Reflect/deleteProperty attempt "binding")
            (put attempt :binding_id "frozen-binding")
            (successful (js-call repository :replace "attempts" attempt))
            (put route :binding_id "different-current-binding")
            (js-call repository :replace "routes" route)))))
        (let ((before (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")))
          (successful (await (observeDelivery context "observe-delivery" (js-object))))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe before))
        ;; Reconcile runs recordReceipt + reconcile_requested clear in one write-batch item via replaceProgress:
        ;; receipt failure keeps reconcile_requested=true; flag-clear failure rolls back the receipt; 0 full replace calls.
        (successful (js-call store :transaction (js-object) (lambda (tx)
          (let ((delivery (js-call repository :get "deliveries" "observe-delivery"))
            (attempt (js-call repository :get "attempts" "observe-attempt")))
            (put delivery :state "unknown")
            (put delivery :reconcile_requested t)
            (put attempt :state "unknown")
            (successful (js-call repository :replace "deliveries" delivery))
            (js-call repository :replace "attempts" attempt)))))
        (setq lookup-observation (js-object
          :state "accepted" :kind "accepted" :evidence_level "native_protocol"
          :dispatch_key "wrong-dispatch-key"))
        (let ((bad-reconcile (await (reconcileDelivery context "observe-delivery"))))
          (js-call (expect (nativeGet bad-reconcile "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet bad-reconcile "error") "code")) :toBe "stale_reference")
          (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "state")) :toBe "unknown")
          (js-call (expect (nativeGet (js-call repository :get "deliveries" "observe-delivery") "reconcile_requested")) :toBe t)
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM receipts WHERE attempt_id='observe-attempt'") :get) "n")) :toBe 0))
        (setq lookup-observation (js-object
          :state "accepted" :kind "accepted" :evidence_level "native_protocol"
          :dispatch_key "observe-dispatch" :native_receipt_key "reconciled-receipt-1"))
        (let ((full-replace-calls 0)
          (progress-replace-calls 0)
          (original-replace (nativeGet repository "replace"))
          (original-replace-progress (nativeGet repository "replaceProgress")))
          (put repository :replace (lambda (table record &optional expected)
