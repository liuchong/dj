                      (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe before-changes)
                      (js-call (expect (nativeGet (js-call repository :get "deliveries" "p1-sub-del") "state")) :toBe "submitting")))))
