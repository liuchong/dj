                  :reason_codes (js-array "literal_predicate")))) :toBe t)
              (js-call (expect (js-call repository :insertIfAbsent "match_decisions"
                (js-object :event_id "ins-ev-1" :subscription_id "sub-1" :revision 1 :result "no_match"
                  :reason_codes (js-array "overwritten")))) :toBe false)
