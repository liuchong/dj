                  (js-object :delivery_id "no-such-del" :route_id "route-1" :origin "subscription_event"
                    :agent_id "agent-1" :event_id "ins-ev-1" :delivery_seq "10" :state "accepted" :revision 3
                    :expires_at "2026-01-02T00:00:00.000Z"))))
