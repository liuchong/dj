                    (js-call (expect sub-states-batch-gets) :toBe 0)
                    (js-call (expect full-replaces) :toBe 0)
                    (js-call (expect route-progress-replaces) :toBe 1)
                    (js-call (expect del-progress-replaces) :toBe 1)
                    (js-call (expect (nativeGet frozen "read")) :toBe undefined)
                    (js-call (expect (nativeGet frozen "reader")) :toBe undefined)
                    (let ((env (nativeGet frozen "envelope"))
                      (att (js-call repository :get "attempts" (nativeGet frozen "attempt_id"))))
                      (js-call (expect (js-length (nativeGet env "matched"))) :toBe 2)
                      (js-call (expect (not (nativeNullish (nativeGet env "reply_context_id")))) :toBe t)
                      (js-call (expect (nativeGet env "allowed_actions")) :toEqual (js-array "reply"))
                      (js-call (expect (nativeGet att "read")) :toBe undefined)
                      (js-call (expect (nativeGet att "reader")) :toBe undefined))
                    ;; Settle p3-sub-del so observe-route is ready for K2b >128 multi-page contribution streaming tests:
                    (successful (recordReceipt claim-ctx (nativeGet frozen "attempt_id")
                      (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                        :dispatch_key "p3-sub-dispatch" :native_receipt_key "p3-rec-1")))))
                ;; 3) K2b >128 contributions on a single delivery (135 contributions: 131 active/effective, 1 paused -> revoked,
                ;;    1 revision mismatch -> revoked, 1 expired -> expired, 1 disabled owner -> revoked):
                ;;    - 3a: Streaming :iterate/:next/:return stops early on matched-bytes > native_frame_max_bytes (6 next calls < 135),
                ;;          closes iterator via rows.return(), and holds delivery as blocked (limit_exceeded) without submitting any prefix;
                ;;    - 3b: Normal streaming processes all 135 rows without LIMIT 128 truncation (131 matched > 128), writes back
                ;;          expired/revoked on the 4 ineffective rows, and performs 0 subscription queries via get/getSubscriptionState/getSubscriptionStates.
                (successful (js-call store :transaction (js-object) (lambda (tx)
                  (js-call repository :insert "events" (js-object :event_id "observe-event-k2b" :connection_id "observe-conn"
                    :source_key "observe-src-k2b" :conversation_key "telegram:observe-conn:chat-1:main"
                    :conversation (js-object :connection_id "observe-conn" :native_chat_id "chat-1" :native_thread_id nil :thread_kind "main")
                    :native_message_id "msg-k2b" :event_kind "message" :ingress_seq 3 :identity_revision 1
                    :received_at "2026-01-01T00:00:00Z" :body_expires_at "2026-01-02T00:00:00Z" :tombstone false
                    :content (js-object :type "text" :text "hello k2b")))
                  (js-call repository :insert "routing_work" (js-object :event_id "observe-event-k2b"
                    :ingress_seq 3 :state "done" :revision 1))
                  (let ((pad3 (lambda (n) (if (< n 10) (str "00" n) (if (< n 100) (str "0" n) (str n)))))
                    (si 1))
                    (while (<= si 135)
                      (let ((sub-id (str "k2b-sub-" (funcall pad3 si)))
                        (owner-id (if (= si 135) "X" "O"))
                        (sub-state (if (= si 132) "paused" "active"))
                        (sub-rev (if (= si 133) 2 1)))
                        (js-call repository :insert "subscriptions" (js-object :subscription_id sub-id
                          :owner_principal_id owner-id :agent_id "observe-agent" :state sub-state :revision sub-rev))
                        (js-call repository :insert "subscription_versions" (js-object :subscription_id sub-id
                          :revision 1 :start_seq 0 :cutover_seq nil :state "active"))
                        (when (= si 133)
                          (js-call repository :insert "subscription_versions" (js-object :subscription_id sub-id
                            :revision 2 :start_seq 0 :cutover_seq nil :state "active"))))
                      (setq si (1+ si)))
                    (js-call repository :insert "deliveries" (js-object :delivery_id "k2b-del-135"
                      :route_id "observe-route" :origin "subscription_event" :principal_id nil :operation_id nil
                      :agent_id "observe-agent" :event_id "observe-event-k2b" :delivery_seq "5" :state "ready"
                      :revision 2 :expires_at "2026-01-02T00:00:00Z" :dispatch_key "k2b-dispatch-135"))
                    (setq si 1)
                    (while (<= si 135)
                      (let ((sub-id (str "k2b-sub-" (funcall pad3 si)))
                        (exp-at (if (= si 134) "1970-01-01T00:00:00Z" "2026-01-02T00:00:00Z")))
                        (js-call repository :insert "contributions" (js-object :delivery_id "k2b-del-135"
                          :subscription_id sub-id :revision 1 :state "active" :expires_at exp-at
                          :context_policy (js-object :mode "current" :max_events 1 :max_bytes 4096)
                          :delivery_policy (js-object :busy "queue" :ttl_seconds 300))))
                      (setq si (1+ si))))
                  (success t))))
                (let ((c-overflow (successful (claimRoute claim-ctx "observe-route")))
                  (overflow-next-calls 0) (overflow-all-calls 0) (overflow-return-called false)
                  (big-suffix (js-call "x" :repeat 200000))
                  (original-query (js-call (nativeGet db "query") :bind db)))
                  (put db :query (lambda (sql)
                    (let ((stmt (funcall original-query sql)))
                      (if (js-call sql :startsWith "SELECT c.payload,c.subscription_id AS contribution_subscription_id,")
                        (let ((orig-iterate (js-call (nativeGet stmt "iterate") :bind stmt))
                          (orig-all (js-call (nativeGet stmt "all") :bind stmt)))
                          (js-object
                            :all (lambda (&rest args)
                              (setq overflow-all-calls (1+ overflow-all-calls))
                              (js-call orig-all :apply stmt args))
                            :iterate (lambda (&rest args)
                              (let ((iter (js-call orig-iterate :apply stmt args)))
                                (js-object
                                  :next (lambda ()
                                    (setq overflow-next-calls (1+ overflow-next-calls))
                                    (let ((step (js-call iter :next)))
                                      (if (nativeGet step "done")
                                        step
                                        (let* ((val (nativeGet step "value"))
                                          (item (JSON/parse (nativeGet val "payload")))
                                          (big-id (str (nativeGet val "contribution_subscription_id") "-" big-suffix)))
                                          (put item :subscription_id big-id)
                                          (js-object :done false :value (js-object
                                            :payload (JSON/stringify item)
                                            :contribution_subscription_id big-id
                                            :current_subscription_id big-id
                                            :current_owner_principal_id (nativeGet val "current_owner_principal_id")
                                            :current_state (nativeGet val "current_state")
                                            :current_revision (nativeGet val "current_revision")))))))
                                  :return (lambda ()
                                    (setq overflow-return-called t)
                                    (if (nativeGet iter "return")
                                      (js-call iter :return)
                                      (js-object :done t :value undefined))))))))
                        stmt))))
                  (let ((held-over (successful (beginSubmission claim-ctx "k2b-del-135" c-overflow
                      (js-object :runtime_state "idle" :live_receiver t
                        :native_session_id "native" :native_namespace "observe" :instance_epoch "epoch")))))
                    (put db :query original-query)
                    (js-call (expect (nativeGet held-over "submitted")) :toBe false)
                    (js-call (expect (nativeGet held-over "state")) :toBe "blocked")
                    (js-call (expect (nativeGet held-over "reason")) :toBe "limit_exceeded")
                    (js-call (expect overflow-all-calls) :toBe 0)
                    ;; 6 * ~200KiB > 1048576 (native_frame_max_bytes), so iteration stops on the 6th row (< 135) and closes via return():
                    (js-call (expect overflow-next-calls) :toBe 6)
                    (js-call (expect overflow-return-called) :toBe t)
                    (js-call (expect (js-call repository :get "claims" "observe-route")) :toBe nil)))
                ;; 3b) Restore ready state on k2b-del-135 and stream all 135 contributions (>128 effective):
                (put (nativeGet (js-call (nativeGet ports "agent_ports") :get "opencode") "capabilities") :max_input_frame_bytes 1048576)
                (successful (js-call store :transaction (js-object) (lambda (tx)
                  (let ((d135 (js-call repository :get "deliveries" "k2b-del-135")))
                    (put d135 :state "ready")
                    (Reflect/deleteProperty d135 "blocked_reason")
                    (funcall original-replace "deliveries" d135)))))
                (let ((c-135 (successful (claimRoute claim-ctx "observe-route")))
                  (stream-next-calls 0) (stream-all-calls 0) (stream-return-called false)
                  (sess-135 0) (agent-135 0) (conn-135 0) (sub-full-135 0) (sub-single-135 0) (sub-batch-135 0)
                  (original-get-sub-state (nativeGet repository "getSubscriptionState"))
                  (original-get-sub-states (nativeGet repository "getSubscriptionStates"))
                  (original-query (js-call (nativeGet db "query") :bind db)))
                  (put repository :get (lambda (table key)
                    (when (= table "sessions") (setq sess-135 (1+ sess-135)))
                    (when (= table "agents") (setq agent-135 (1+ agent-135)))
                    (when (= table "connections") (setq conn-135 (1+ conn-135)))
                    (when (= table "subscriptions") (setq sub-full-135 (1+ sub-full-135)))
                    (funcall original-get table key)))
                  (put repository :getSubscriptionState (lambda (id)
                    (setq sub-single-135 (1+ sub-single-135))
                    (funcall original-get-sub-state id)))
                  (put repository :getSubscriptionStates (lambda (ids)
                    (setq sub-batch-135 (1+ sub-batch-135))
                    (funcall original-get-sub-states ids)))
                  (put db :query (lambda (sql)
                    (let ((stmt (funcall original-query sql)))
                      (if (js-call sql :startsWith "SELECT c.payload,c.subscription_id AS contribution_subscription_id,")
                        (let ((orig-iterate (js-call (nativeGet stmt "iterate") :bind stmt))
                          (orig-all (js-call (nativeGet stmt "all") :bind stmt)))
                          (js-object
                            :all (lambda (&rest args)
                              (setq stream-all-calls (1+ stream-all-calls))
                              (js-call orig-all :apply stmt args))
                            :iterate (lambda (&rest args)
                              (let ((iter (js-call orig-iterate :apply stmt args)))
                                (js-object
                                  :next (lambda ()
                                    (setq stream-next-calls (1+ stream-next-calls))
                                    (js-call iter :next))
                                  :return (lambda ()
                                    (setq stream-return-called t)
                                    (if (nativeGet iter "return")
                                      (js-call iter :return)
                                      (js-object :done t :value undefined))))))))
                        stmt))))
                  (let ((frozen-135 (successful (beginSubmission claim-ctx "k2b-del-135" c-135
                      (js-object :runtime_state "idle" :live_receiver t
                        :native_session_id "native" :native_namespace "observe" :instance_epoch "epoch")))))
                    (put repository :get original-get)
                    (put repository :getSubscriptionState original-get-sub-state)
                    (put repository :getSubscriptionStates original-get-sub-states)
                    (put db :query original-query)
                    (js-call (expect (nativeGet frozen-135 "submitted")) :toBe t)
                    (js-call (expect stream-all-calls) :toBe 0)
                    (js-call (expect stream-next-calls) :toBe 136)
                    (js-call (expect stream-return-called) :toBe t)
                    (js-call (expect sess-135) :toBe 1)
                    (js-call (expect agent-135) :toBe 1)
                  (js-call (expect conn-135) :toBe 3)
                    (js-call (expect sub-full-135) :toBe 0)
                    (js-call (expect sub-single-135) :toBe 0)
                    (js-call (expect sub-batch-135) :toBe 0)
                    (let ((matched-135 (nativeGet (nativeGet frozen-135 "envelope") "matched"))
                      (saved-d135 (js-call repository :get "deliveries" "k2b-del-135"))
                      (c132 (js-call repository :get "contributions" (js-object :delivery_id "k2b-del-135" :subscription_id "k2b-sub-132" :revision 1)))
                      (c133 (js-call repository :get "contributions" (js-object :delivery_id "k2b-del-135" :subscription_id "k2b-sub-133" :revision 1)))
                      (c134 (js-call repository :get "contributions" (js-object :delivery_id "k2b-del-135" :subscription_id "k2b-sub-134" :revision 1)))
                      (c135 (js-call repository :get "contributions" (js-object :delivery_id "k2b-del-135" :subscription_id "k2b-sub-135" :revision 1))))
                      (js-call (expect (js-length matched-135)) :toBe 131)
                      (js-call (expect (nativeGet (aref matched-135 0) "subscription_id")) :toBe "k2b-sub-001")
                      (js-call (expect (nativeGet (aref matched-135 130) "subscription_id")) :toBe "k2b-sub-131")
                      (js-call (expect (js-length (nativeGet saved-d135 "frozen_contributions"))) :toBe 131)
                      (js-call (expect (nativeGet c132 "state")) :toBe "revoked")
                      (js-call (expect (nativeGet c133 "state")) :toBe "revoked")
                      (js-call (expect (nativeGet c134 "state")) :toBe "expired")
                      (js-call (expect (nativeGet c135 "state")) :toBe "revoked"))))))
              (put repository :replace original-replace)
              (put repository :replaceProgress original-replace-progress))))))
    close)
  (withCase "T40.metadata-quota-rollback.sqlite" setup
    (lambda (store)
      (let* ((repository (createRepository store))
        (context (js-object :store store :repository repository))
        (db (nativeGet store "db")))
        (successful (js-call store :transaction (js-object) (lambda (tx)
          (js-call repository :insert "tools" (js-object :tool_id "opencode" :configured t))
          (js-call repository :insert "instances" (js-object :instance_id "quota-instance"
            :tool "opencode" :native_namespace "quota" :instance_epoch "epoch"
            :ownership "existing" :state "ready" :revision 1))
          (js-call db :run "WITH RECURSIVE numbers(n) AS (VALUES(1) UNION ALL SELECT n+1 FROM numbers WHERE n<99999) INSERT INTO sessions(session_key,tool_id,native_namespace,native_session_id,instance_id,instance_epoch,runtime_state,tombstone,catalog_seq,payload) SELECT 'seed-'||n,'opencode','quota','seed-'||n,'quota-instance','epoch','idle',0,0,json_object('session_key','seed-'||n,'tombstone',json('false')) FROM numbers")
          (js-object :ok t :data nil))))
        (let ((rolled (js-call store :transaction (js-object) (lambda (tx)
          (let ((quota (createMetadataQuota context)))
            (successful (writeSessionVersion context (quotaRecord "rolled-one") quota))
            (writeSessionVersion context (quotaRecord "rolled-two") quota))))))
          (js-call (expect (nativeGet (nativeGet rolled "error") "code")) :toBe "capacity_exceeded")
          (js-call (expect (js-call repository :get "sessions" "rolled-one")) :toBe nil))
        (successful (js-call store :transaction (js-object) (lambda (tx)
          (let ((quota (createMetadataQuota context)))
            (js-call (expect (nativeGet quota "live_count")) :toBe 99999)
            (successful (writeSessionVersion context (quotaRecord "boundary") quota))
            (js-call (expect (nativeGet quota "live_count")) :toBe 100000)
            ;; Updating an existing live row consumes no additional capacity.
            (writeSessionVersion context (quotaRecord "boundary") quota)))))
        (let ((over (js-call store :transaction (js-object) (lambda (tx)
          (writeSessionVersion context (quotaRecord "overflow") (createMetadataQuota context))))))
          (js-call (expect (nativeGet (nativeGet over "error") "code")) :toBe "capacity_exceeded"))
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM sessions WHERE tombstone=0") :get) "n")) :toBe 100000)
        (js-call (expect (contentIndexBytes context)) :toBe
          (nativeGet (js-call (js-call db :query "SELECT COALESCE(SUM(pgsize),0) AS bytes FROM dbstat WHERE aggregate=TRUE AND (name='message_versions' OR name GLOB 'message_versions_*' OR name='session_messages' OR name='messages_session_key' OR name='text_documents' OR name='text_documents_session' OR name GLOB 'text_index*')") :get) "bytes"))))
    close)
  (withCase "T40.repository-revision.sqlite" setup
    (lambda (store)
      (let ((repository (createRepository store)))
        (let ((written (js-call store :transaction (js-object)
          (lambda (tx)
            (js-call repository :insert "tools" (js-object :tool_id "revision-probe" :configured false))
            (let ((updated (js-call repository :replace "tools" (js-object :tool_id "revision-probe" :configured t))))
              (js-call (expect (nativeGet updated "ok")) :toBe t))
            (js-call repository :insert "connections"
              (js-object :connection_id "revision-probe" :revision 1 :state "configured"))
            (js-call repository :replace "connections"
              (js-object :connection_id "revision-probe" :revision 2 :state "configured") 1)))))
          (js-call (expect (nativeGet written "ok")) :toBe t))
        (let ((stale (js-call store :transaction (js-object)
          (lambda (tx) (js-call repository :replace "connections"
            (js-object :connection_id "revision-probe" :revision 3 :state "wrong") 1)))))
          (js-call (expect (nativeGet stale "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet stale "error") "code")) :toBe "revision_conflict")
          (js-call (expect (nativeGet (js-call repository :get "connections" "revision-probe") "revision")) :toBe 2)))) close)
  (withCase
    "T40.wal-fault.sqlite"
    setup
    (lambda
      (store)
      (let* ((db (nativeGet store "db"))
             (database-path (nativeGet (js-call (js-call db :query "PRAGMA database_list") :get) "file")))
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA journal_mode") :get) "journal_mode"))
          :toBe
          "wal")
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA synchronous") :get) "synchronous"))
          :toBe
          2)
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA foreign_keys") :get) "foreign_keys"))
          :toBe
          1)
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA busy_timeout") :get) "timeout"))
          :toBe
          0)
        (js-call
          (expect (nativeGet store "sqlite_version"))
          :toBe
          (nativeGet
            (js-call (js-call db :query "SELECT sqlite_version() AS version") :get)
            "version"))
        (let ((checkpoint (js-call store :checkpoint)))
          (js-call (expect (nativeGet checkpoint "ok")) :toBe t)
          (js-call (expect (nativeGet (nativeGet checkpoint "data") "mode")) :toBe "PASSIVE"))
        (let ((capacity (js-call store :admissionStatus)))
          (js-call (expect (nativeGet capacity "ok")) :toBe t)
          (js-call (expect (nativeGet (nativeGet capacity "data") "live_bytes")) :toBeGreaterThan 0))
        ;; Y-A1: this connection carries temp_store=MEMORY (2); a separate raw connection
        ;; can still choose FILE (1), and reopening the same database re-applies MEMORY.
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA temp_store") :get) "temp_store"))
          :toBe
          2)
        (let ((raw (new Database database-path (js-object :readonly t))))
          (try
            (js-call raw :run "PRAGMA temp_store=FILE")
            (let ((statement (js-call raw :query "PRAGMA temp_store")))
              (try
                (js-call (expect (nativeGet (js-call statement :get) "temp_store")) :toBe 1)
                (finally (js-call statement :finalize))))
            (finally (js-call raw :close))))
        (js-call
          (expect
            (nativeGet (js-call (js-call db :query "PRAGMA temp_store") :get) "temp_store"))
          :toBe
          2)
        (let ((reopened (successful (openStore (storageConfig database-path)))))
          (try
            (js-call
              (expect
                (nativeGet
                  (js-call (js-call (nativeGet reopened "db") :query "PRAGMA temp_store") :get)
                  "temp_store"))
              :toBe
              2)
            (js-call
              (expect
                (nativeGet
                  (js-call (js-call (nativeGet reopened "db") :query "PRAGMA user_version") :get)
                  "user_version"))
              :toBe
              1)
            (js-call
              (expect
                (nativeGet
                  (js-call
                    (js-call (nativeGet reopened "db") :query "SELECT COUNT(*) AS n FROM counters")
                    :get)
                  "n"))
              :toBeGreaterThan
              0)
            (finally (js-call reopened :close))))
        ;; Y-A2: a failed MEMORY set or a mismatched readback must close this new connection and
        ;; return storage_unavailable, then a clean open must work again.
        (let* ((original-run (nativeGet (nativeGet Database "prototype") "run"))
               (original-query (nativeGet (nativeGet Database "prototype") "query")))
          (try
            (put (nativeGet Database "prototype") :run
              (funcall
                (new globalThis.Function "orig"
                  "return function(sql){ if (sql === 'PRAGMA temp_store=MEMORY') throw new Error('injected temp_store set'); return orig.apply(this, arguments); }")
                original-run))
            (let ((failed (openStore (storageConfig database-path))))
              (js-call (expect (nativeGet failed "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet failed "error") "code")) :toBe "storage_unavailable"))
            (finally
              (put (nativeGet Database "prototype") :run original-run)))
          (try
            (put (nativeGet Database "prototype") :query
              (funcall
                (new globalThis.Function "orig"
                  "return function(sql){ if (sql === 'PRAGMA temp_store') return { get: function(){ return { temp_store: 1 }; } }; return orig.apply(this, arguments); }")
                original-query))
            (let ((failed (openStore (storageConfig database-path))))
              (js-call (expect (nativeGet failed "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet failed "error") "code")) :toBe "storage_unavailable"))
            (finally
              (put (nativeGet Database "prototype") :query original-query)))
          (let ((healthy (successful (openStore (storageConfig database-path)))))
            (try
              (js-call
                (expect
                  (nativeGet
                    (js-call (js-call (nativeGet healthy "db") :query "PRAGMA temp_store") :get)
                    "temp_store"))
                :toBe
                2)
              (js-call
                (expect
                  (nativeGet
                    (js-call
                      (js-call (nativeGet healthy "db") :query "SELECT COUNT(*) AS n FROM counters")
                      :get)
                    "n"))
                :toBeGreaterThan
                0)
              (finally (js-call healthy :close)))))
        (js-call
          db
          :run
          "CREATE TABLE test_probe(id TEXT PRIMARY KEY, payload TEXT NOT NULL)")
        (let
          (
            (failed
              (js-call
                store
                :transaction
                (js-object)
                (lambda
                  (tx)
                  (js-call
                    db
                    :run
                    "INSERT INTO test_probe VALUES (?, ?)"
                    (js-array "rolled-back" "secret"))
                  (throw (new globalThis.Error "injected before commit"))))))
          (js-call (expect (nativeGet failed "ok")) :toBe false))
        (js-call
          (expect
            (nativeGet
              (js-call (js-call db :query "SELECT COUNT(*) AS n FROM test_probe") :get)
              "n"))
          :toBe
          0)))
    close)
