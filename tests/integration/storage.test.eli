            (samples-before (js-length (nativeGet runtime "routing_samples" (js-array)))))
            (js-call faults :install "routing.before_checkpoint_commit" (async (work)
              (let ((id (nativeGet work "event_id")))
                (when (= id "mt-ev-1")
                  (await (new globalThis.Promise (lambda (resolve reject) (nativeSetTimeout resolve 12)))))
                (when (= id "mt-ev-2")
                  (successful (js-call store :transaction (js-object) (lambda (tx)
                    (let ((w2 (js-call repository :get "routing_work" "mt-ev-2")))
                      (put w2 :last_revision 99)
                      (js-call repository :replace "routing_work" w2))))))
                (js-call prepare-order :push id))))
            (let ((turn-res (successful (await (matchTurn mt-context
