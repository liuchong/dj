            (js-call faults :install "routing.before_checkpoint_commit" (async (work)
              (when (= (nativeGet work "event_id") "mt-ev-2")
                (await (new globalThis.Promise (lambda (resolve reject) (nativeSetTimeout resolve 5))))
                (throw (new globalThis.Error "injected prepare failure")))))
            (let ((failed-turn (await (matchTurn mt-context (js-array "mt-ev-1" "mt-ev-2")))))
              (js-call (expect (nativeGet failed-turn "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet failed-turn "error") "code")) :toBe "unavailable")
              (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries") :get) "n")) :toBe before-del)
              (js-call (expect (nativeGet (js-call repository :get "routing_work" "mt-ev-1") "state")) :toBe "ready")))
          ;; 3) Out-of-order prepare + single-item revision_conflict isolation + not_found/done/bot coexistence.
