              (js-call (expect (lambda ()
                (js-call repository :replaceProgress "events" (js-object :event_id "ins-ev-1")))) :toThrow)
              (js-call (expect (lambda ()
                (js-call repository :replaceProgress "attempts" (js-object :attempt_id "missing-att") 1))) :toThrow)
              (js-call (expect (lambda ()
                (js-call repository :replaceProgress "routes" (js-object :route_id "route-1") 1))) :toThrow)
