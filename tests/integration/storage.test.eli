  (withCase
    "T40.wal-fault.sqlite.exact-sequence"
    setup
    (lambda
      (store)
      (let ((db (nativeGet store "db")))
        (js-call db :run "CREATE TABLE sequence_probe(value TEXT PRIMARY KEY)")
