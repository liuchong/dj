                  (js-call (expect (nativeGet row "col")) :toBe "9223372036854775807")
                  (js-call (expect (nativeGet row "json_val")) :toBe "9223372036854775807"))))
            ;; R3: withEventPlans complete-in-one-turn hint (initial_ready, finish revert on non-done, existing_delivery_seen):
            (successful (inTransaction context (lambda (tx)
              ;; 1) complete-in-one-turn = true + finish("done") with only new deliveries -> needsUnlock = false, stays ready/revision 2:
              (withEventPlans context (js-object :event_id "ins-ev-1") (lambda (p)
                (js-call (expect (nativeGet p "initial_ready")) :toBe t)
                (let ((d-new (js-object :delivery_id "plan-ready-1" :route_id "route-2"
                    :origin "subscription_event" :agent_id "agent-1" :event_id "ins-ev-1"
                    :delivery_seq "1" :state "ready" :blocked_reason nil :revision 2
                    :expires_at "2026-01-02T00:00:00.000Z")))
                  (js-call repository :insert "deliveries" d-new)
                  (js-call p :created d-new)
                  (js-call (expect (js-call p :finish "done")) :toBe false)
                  (js-call (expect (nativeGet (js-call repository :get "deliveries" "plan-ready-1") "state")) :toBe "ready")
                  (js-call (expect (nativeGet (js-call repository :get "deliveries" "plan-ready-1") "revision")) :toBe 2))) t)
              ;; 2) complete-in-one-turn = true + finish("blocked"): reverts newly created delivery to blocked/routing_incomplete/revision 1,
              ;;    leaves pre-existing ready delivery ("ins-del-1" on route-1 and "plan-existing-ready") untouched, and returns false:
              (withEventPlans context (js-object :event_id "ins-ev-1") (lambda (p)
                (let ((d-revert (js-object :delivery_id "plan-revert-1" :route_id "route-3"
                    :origin "subscription_event" :agent_id "agent-1" :event_id "ins-ev-1"
                    :delivery_seq "1" :state "ready" :blocked_reason nil :revision 2
                    :expires_at "2026-01-02T00:00:00.000Z")))
                  (js-call repository :insert "deliveries" d-revert)
                  (js-call p :created d-revert)
                  (js-call (expect (js-call p :finish "blocked")) :toBe false)
                  (let ((reverted (js-call repository :get "deliveries" "plan-revert-1"))
                    (untouched (js-call repository :get "deliveries" "ins-del-1"))
                    (direct-ready (js-call repository :get "deliveries" "plan-existing-ready")))
                    (js-call (expect (nativeGet reverted "state")) :toBe "blocked")
                    (js-call (expect (nativeGet reverted "blocked_reason")) :toBe "routing_incomplete")
                    (js-call (expect (nativeGet reverted "revision")) :toBe 1)
                    (js-call (expect (nativeGet untouched "state")) :toBe "ready")
                    (js-call (expect (nativeGet untouched "revision")) :toBe 2)
                    (js-call (expect (nativeGet direct-ready "state")) :toBe "ready")))) t)
              ;; 3) Reading an already-persisted delivery via p.delivery sets existing_delivery_seen so finish("done") returns true:
              (withEventPlans context (js-object :event_id "ins-ev-1") (lambda (p)
