                      :conversation_key "telegram:l2-conn:chat-1:main"
                      :conversation (js-object :connection_id "l2-conn" :native_chat_id "chat-1" :native_thread_id nil :thread_kind "main")
                      :native_message_id "l2-msg-plan" :event_kind "message" :ingress_seq 402 :identity_revision 1
                      :sender (js-object :kind "human" :native_sender_id "u1")
                      :received_at "2026-01-01T00:00:00.000Z" :body_expires_at "2026-01-02T00:00:00.000Z"
                      :tombstone false :content (js-object :type "text" :text "l2 buffered plan")))
                    (l2-v1 (js-object :subscription_id "l2-sub-1" :revision 1 :state "active" :start_seq 0 :cutover_seq nil
                      :agent_id "l2-agent" :owner_principal_id "O" :context_policy "message_only"
                      :delivery_policy (js-object :busy "queue" :ttl_seconds 300)))
                    (l2-v2 (js-object :subscription_id "l2-sub-2" :revision 1 :state "active" :start_seq 0 :cutover_seq nil
                      :agent_id "l2-agent" :owner_principal_id "O" :context_policy "message_only"
                      :delivery_policy (js-object :busy "queue" :ttl_seconds 300))))
                    (funcall original-insert "connections" (js-object :connection_id "l2-conn" :platform "telegram"
                      :allowed_chats (js-array "chat-1")
                      :revision 1 :identity_revision 1 :state "online"))
                    (funcall original-insert "routes" (js-object :route_id "l2-route-plan" :canonical_target_key "l2-target-plan"
                      :session_key "sess-1" :next_delivery_seq "0" :claim_epoch 0))
                    (funcall original-insert "agents" (js-object :agent_id "l2-agent" :route_id "l2-route-plan"
                      :owner_principal_id "O" :recipient_principal_id "A2" :canonical_target_key "l2-target-plan"
                      :state "registered" :revision 1))
                    (funcall original-insert "subscriptions" (js-object :subscription_id "l2-sub-1"
                      :owner_principal_id "O" :agent_id "l2-agent" :state "active" :revision 1))
                    (funcall original-insert "subscriptions" (js-object :subscription_id "l2-sub-2"
                      :owner_principal_id "O" :agent_id "l2-agent" :state "active" :revision 1))
                    (funcall original-insert "subscription_versions" l2-v1)
                    (funcall original-insert "subscription_versions" l2-v2)
                    (funcall original-insert "events" l2-ev)
                    (setq single-del-inserts 0 batch-del-inserts (js-array) del-replaces 0)
                    (withEventPlans l2-ctx l2-ev (lambda (planning)
                      (let ((tx-l2 (js-object :context l2-ctx :db db))
                        (pending-c (js-array)))
                        ;; Omitted / nil pendingContributions when planning.defer_insert === true throws TypeError BEFORE sequence allocation:
                        (js-call (expect (lambda ()
                          (planContribution tx-l2 l2-ev l2-v1 (js-object :result "match") nil planning nil))) :toThrow)
                        (js-call (expect (lambda ()
                          (planContribution tx-l2 l2-ev l2-v1 (js-object :result "match") nil planning))) :toThrow)
                        (js-call (expect (nativeGet (js-call repository :get "routes" "l2-route-plan") "next_delivery_seq")) :toBe "0")
                        ;; Valid pendingContributions: 1st sub creates buffered delivery (seq "1", 0 DB rows); 2nd sub reuses same delivery (seq still "1"):
                        (let ((d-first (successful (planContribution tx-l2 l2-ev l2-v1 (js-object :result "match") nil planning pending-c)))
                          (d-second (successful (planContribution tx-l2 l2-ev l2-v2 (js-object :result "match") nil planning pending-c))))
                          (js-call (expect d-first) :toBe d-second)
                          (js-call (expect (nativeGet d-first "delivery_seq")) :toBe "1")
                          (js-call (expect (nativeGet (js-call repository :get "routes" "l2-route-plan") "next_delivery_seq")) :toBe "1")
                          (js-call (expect (js-length pending-c)) :toBe 2)
                          (js-call (expect single-del-inserts) :toBe 0)
                          (js-call (expect (js-length batch-del-inserts)) :toBe 0)
                          (js-call (expect (nativeGet (js-call (js-call db :query
                            "SELECT COUNT(*) AS n FROM deliveries WHERE event_id='l2-ev-plan'") :get) "n")) :toBe 0)
                          ;; finish("done") flushes the 1 buffered delivery via insertMany BEFORE insertManyIfAbsent("contributions", pending-c):
                          (js-call (expect (js-call planning :finish "done")) :toBe false)
                          (js-call (expect single-del-inserts) :toBe 0)
                          (js-call (expect del-replaces) :toBe 0)
                          (js-call (expect batch-del-inserts) :toEqual (js-array (js-array "deliveries" 1 1)))
                          (js-call (expect (js-call repository :insertManyIfAbsent "contributions" pending-c)) :toBe 2)
                          (let ((saved-d (js-call repository :get "deliveries" (nativeGet d-first "delivery_id"))))
                            (js-call (expect (nativeGet saved-d "state")) :toBe "ready")
                            (js-call (expect (nativeGet saved-d "revision")) :toBe 2)
                            (js-call (expect (nativeGet saved-d "blocked_reason" nil)) :toBe nil)
                            (js-call (expect (nativeGet (js-call (js-call db :query
                              "SELECT COUNT(*) AS n FROM contributions WHERE delivery_id=?") :get (nativeGet d-first "delivery_id")) "n")) :toBe 2))))
                      (success t)) t t)
                    ;; Clean up l2 test rows:
                    (js-call db :run "DELETE FROM contributions WHERE subscription_id IN ('l2-sub-1','l2-sub-2')")
                    (js-call db :run "DELETE FROM deliveries WHERE event_id IN ('l2-ev-cap','l2-ev-plan')")
                    (js-call db :run "DELETE FROM events WHERE event_id IN ('l2-ev-cap','l2-ev-plan')")
                    (js-call db :run "DELETE FROM subscription_versions WHERE subscription_id IN ('l2-sub-1','l2-sub-2')")
                    (js-call db :run "DELETE FROM subscriptions WHERE subscription_id IN ('l2-sub-1','l2-sub-2')")
                    (js-call repository :delete "agents" "l2-agent")
                    (js-call repository :delete "routes" "l2-route-plan")
                    (js-call repository :delete "routes" "l2-route-cap")
                    (js-call repository :delete "connections" "l2-conn"))
                  (finally
                    (put repository :insert original-insert)
                    (put repository :insertMany original-insert-many)
                    (put repository :replace original-replace))))
              (success t))))))))
    close)
  (withCase "T40.write-batch-isolation.sqlite" setup
    (async (store)
      (let* ((repository (createRepository store))
        (context (js-object :store store :repository repository :runtime (js-object)))
        (pending (js-array)) (index 0))
        (while (< index 3)
          (let ((key (str "isolated-" index)))
            (js-call pending :push (enqueueWrite context (lambda ()
              (js-call repository :insert "tools" (js-object :tool_id key :configured t))
              (if (= key "isolated-1") (failure "forbidden") (success key))))))
          (setq index (1+ index)))
        (let ((results (await (Promise/all pending))))
          (js-call (expect (nativeGet (aref results 0) "ok")) :toBe t)
          (js-call (expect (nativeGet (nativeGet (aref results 1) "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet (aref results 2) "ok")) :toBe t))
        (js-call (expect (js-call repository :get "tools" "isolated-1")) :toBe nil)
        (js-call (expect (nativeGet (js-call (js-call (nativeGet store "db") :query "SELECT COUNT(*) AS n FROM tools") :get) "n")) :toBe 2)
        (let* ((must-batch (js-array
            (enqueueWrite context (lambda ()
              (js-call repository :insert "tools" (js-object :tool_id "must-neighbor-0" :configured t))
              (success "must-neighbor-0")))
            (enqueueWrite context (lambda ()
              (js-call repository :insert "tools" (js-object :tool_id "must-rolled-back" :configured t))
              (must (failure "revision_conflict"))
              (success "unreachable")))
            (enqueueWrite context (lambda ()
              (js-call repository :insert "tools" (js-object :tool_id "must-neighbor-2" :configured t))
              (success "must-neighbor-2")))))
          (must-results (await (Promise/all must-batch))))
          (js-call (expect (nativeGet (aref must-results 0) "ok")) :toBe t)
          (js-call (expect (nativeGet (aref must-results 1) "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet (aref must-results 1) "error") "code")) :toBe "revision_conflict")
          (js-call (expect (nativeGet (aref must-results 2) "ok")) :toBe t)
          (js-call (expect (js-call repository :get "tools" "must-rolled-back")) :toBe nil)
          (js-call (expect (nativeGet (js-call repository :get "tools" "must-neighbor-0") "tool_id")) :toBe "must-neighbor-0")
          (js-call (expect (nativeGet (js-call repository :get "tools" "must-neighbor-2") "tool_id")) :toBe "must-neighbor-2")
          (js-call (expect (nativeGet (js-call (js-call (nativeGet store "db") :query "SELECT COUNT(*) AS n FROM tools") :get) "n")) :toBe 4))
        ;; Ordered matchTurn & E1/E2 single-event planning regressions:
        ;; 1) E1+E2: single event with 2 matching subscriptions on same route reads connections once in prepare,
        ;;    once in commit, and reads routes once in commit via withEventPlans;
        ;; 2) Prepare throw resolves all waiting slots without hanging and performs 0 writes;
        ;; 3) Out-of-order prepare still commits in ingress_seq order; single-item revision_conflict rolls back
        ;;    only that event while neighbors commit and publish metrics; not_found/done/bot no-match coexist;
        ;; 4) Unknown write exception rolls back entire batch and publishes 0 metrics.
        (let* ((db (nativeGet store "db"))
          (faults (createFaults))
          (clock (createClock))
          (principal-o (js-object :principal_id "O" :kind "operator" :authorization_revision 1
            :target_constraint (js-object :tool "must-neighbor-0")
            :grants (js-array (js-object :action "*" :resources (js-array "*")))))
          (principal-o2 (js-object :principal_id "O2" :kind "agent" :authorization_revision 1
            :target_constraint (js-object :tool "must-neighbor-0")
            :grants (js-array (js-object :action "*" :resources (js-array "*")))))
          (ports (js-object :clock clock :measurement clock :faults faults
            :ids (js-object :next (lambda (prefix) (str prefix "-" (randomUUID))))))
          (runtime (js-object))
          (mt-context (js-object :store store :repository repository :ports ports :runtime runtime
            :principal principal-o :config (js-object :principals (js-array principal-o principal-o2))))
          (seed-event (lambda (id seq kind text state)
            (js-call repository :insert "events" (js-object :event_id id :connection_id "mt-conn"
              :source_key (str "src-" id) :conversation_key "telegram:mt-conn:chat-1:main"
              :conversation (js-object :connection_id "mt-conn" :native_chat_id "chat-1" :native_thread_id nil :thread_kind "main")
              :native_message_id (str "msg-" id) :event_kind "message" :ingress_seq seq :identity_revision 1
              :sender (js-object :kind kind :native_sender_id "u1")
              :received_at "2026-01-01T00:00:00.000Z" :body_expires_at "2026-01-02T00:00:00.000Z"
              :tombstone false :content (js-object :type "text" :text text)))
            (js-call repository :insert "routing_work" (js-object :event_id id :ingress_seq seq
              :state state :revision 1)))))
          (successful (js-call store :transaction (js-object) (lambda (tx)
            (js-call repository :insert "connections" (js-object :connection_id "mt-conn" :platform "telegram"
              :allowed_chats (js-array "chat-1")
              :revision 1 :identity_revision 1 :state "online"))
            (js-call repository :insert "instances" (js-object :instance_id "mt-inst" :tool "must-neighbor-0"
              :native_namespace "mt-ns" :instance_epoch "epoch-1" :ownership "existing" :state "ready" :revision 1))
            (js-call repository :insert "sessions" (js-object :session_key "mt-sess" :tool "must-neighbor-0"
              :native_namespace "mt-ns" :native_session_id "s-1" :instance_id "mt-inst" :instance_epoch "epoch-1"
              :runtime_state "idle" :tombstone false :catalog_seq 1))
            (js-call repository :insert "routes" (js-object :route_id "mt-route" :canonical_target_key "mt-target"
              :session_key "mt-sess" :next_delivery_seq "0" :claim_epoch 0))
            (js-call repository :insert "agents" (js-object :agent_id "mt-agent" :route_id "mt-route"
              :owner_principal_id "O" :recipient_principal_id "O" :canonical_target_key "mt-target"
              :state "registered" :revision 1))
            (let ((si 1))
              (while (<= si 2)
                (let ((sub-id (str "mt-sub-" si)))
                  (js-call repository :insert "subscriptions" (js-object :subscription_id sub-id
                    :owner_principal_id "O" :agent_id "mt-agent" :state "active" :revision 1))
                  (js-call repository :insert "subscription_versions" (js-object :subscription_id sub-id
                    :revision 1 :state "active" :start_seq 0 :cutover_seq nil :agent_id "mt-agent"
                    :owner_principal_id "O" :context_policy "message_only"
                    :delivery_policy (js-object :busy "queue" :ttl_seconds 300)
                    :resolved_sources (js-array (js-object :connection_id "mt-conn" :native_chat_id "chat-1"
                      :native_thread_id nil :include_threads t :event_kinds (js-array "message")))
                    :predicate (js-object :all (js-array
                      (js-object :op "contains" :field "text" :value "match")
                      (js-object :not (js-object :field "sender.kind" :op "eq" :value "bot"))))))
                  (js-call db :run
                    "INSERT INTO subscription_sources(subscription_id,revision,connection_id,native_chat_id,thread_key,include_threads,event_kind) VALUES (?,?,?,?,?,?,?)"
                    (js-array sub-id 1 "mt-conn" "chat-1" "null" 1 "message")))
                (setq si (1+ si))))
            (seed-event "mt-ev-0" 1 "human" "match zero" "ready")
            (seed-event "mt-done" 2 "human" "match done" "done")
            (seed-event "mt-bot" 3 "bot" "match bot" "ready")
            (seed-event "mt-ev-1" 4 "human" "match one" "ready")
            (seed-event "mt-ev-2" 5 "human" "match two" "ready")
            (seed-event "mt-ev-3" 6 "human" "match three" "ready")
            (seed-event "mt-ev-4" 7 "human" "match four" "ready")
            (seed-event "mt-ev-5" 8 "human" "match five" "ready")
            (success t))))
          ;; 1) E1+E2 + R1-R4 + P2c + W1-W3 + K2a + L2: single event with 2 subscriptions on same route reads connections 2x (1 prepare + 1 commit),
          ;;    routes 1x, subscriptions 0x via full get, 0x via single-key getSubscriptionState, and 1x via batch getSubscriptionStates
          ;;    (["mt-sub-1","mt-sub-2"], 1 batch IN SQL), buffers new delivery in withEventPlans(..., true) and flushes via insertMany("deliveries")
          ;;    BEFORE insertManyIfAbsent("match_decisions") and insertManyIfAbsent("contributions") (0 single-row delivery insert, 0 insertIfAbsent,
          ;;    0 route/delivery replace, 0 secondary unlock SQL), inserting delivery directly as ready/revision 2/blocked_reason nil.
          (let ((conn-gets 0) (route-gets 0) (sub-full-gets 0) (sub-state-gets 0) (sub-states-batch-calls (js-array))
            (sub-batch-sql-calls 0) (md-gets 0) (contrib-gets 0)
            (del-single-inserts 0) (del-many-calls (js-array)) (del-batch-sql-calls 0) (batch-write-order (js-array))
            (route-replaces 0) (del-replaces 0) (if-absent-calls 0) (many-if-absent-calls (js-array))
            (md-batch-sql-calls 0) (contrib-batch-sql-calls 0) (unlock-sql-calls 0)
            (original-get (nativeGet repository "get"))
            (original-get-sub-state (nativeGet repository "getSubscriptionState"))
            (original-get-sub-states (nativeGet repository "getSubscriptionStates"))
            (original-insert (nativeGet repository "insert"))
            (original-insert-many (nativeGet repository "insertMany"))
            (original-replace (nativeGet repository "replace"))
            (original-if-absent (nativeGet repository "insertIfAbsent"))
            (original-many-if-absent (nativeGet repository "insertManyIfAbsent"))
            (original-query (js-call (nativeGet db "query") :bind db)))
            (put repository :get (lambda (table key)
