            (try
              (put g-db :query (lambda (sql) (setq g-queries (1+ g-queries)) (js-call original-query :call g-db sql)))
              (successful (inTransaction g-context (lambda (tx)
                (js-call (js-array
                    (js-object :store store :count -1 :active t)
                    (js-object :store store :count 1.5 :active t)
                    (js-object :store store :count "3" :active t)
                    (js-object :store store :count (nativeGet NativeNumber "NaN") :active t)
                    (js-object :store store :active t)
                    (js-object :store (js-object) :count nil :active t)
                    (js-object :store store :count nil :active false)
                    (js-array) 123)
                  :forEach (lambda (bad)
                    (funcall g-check-type (lambda ()
                      (withEventPlans g-context g-event (lambda (planning)
                        (setq g-work-calls (1+ g-work-calls)) (success t)) nil t bad)))))
                (funcall g-check-type (lambda () (withEventPlans g-context g-event
                  (lambda (planning) (setq g-work-calls (1+ g-work-calls)) (success t)) nil false g-state)))
                (js-call (expect g-work-calls) :toBe 0)
                (js-call (expect g-queries) :toBe 0)
                (success t))))
              (successful (inTransaction g-context (lambda (tx)
                (withEventPlans g-context g-event (lambda (planning)
                  (setq g-escaped planning)
                  (successful (js-call planning :capacity "eg-route"))
                  (js-call planning :finish "done") (success t)) nil t g-state))))
              (js-call (expect (nativeGet g-state "count")) :toBe
                (nativeGet (js-call (js-call original-query :call g-db
                  "SELECT COUNT(*) AS n FROM deliveries WHERE state IN ('ready','deferred','blocked','submitting','unknown')") :get) "n"))
              (js-call (expect (lambda () (js-call g-escaped :capacity "eg-route"))) :toThrow)
              (successful (inTransaction g-context (lambda (tx)
                (put g-state :count 5)
                (let ((result (withEventPlans g-context g-event (lambda (planning) (failure "revision_conflict")) nil t g-state)))
                  (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "revision_conflict"))
                (js-call (expect (nativeGet g-state "count")) :toBe nil)
                (put g-state :count 5)
                (funcall g-check-type (lambda () (withEventPlans g-context g-event
                  (lambda (planning) (Promise/resolve (success t))) nil t g-state)))
                (js-call (expect (nativeGet g-state "count")) :toBe nil)
                (put g-state :count 5)
                (funcall g-check-type (lambda () (withEventPlans g-context g-event
                  (lambda (planning) (success t)) nil t g-state)))
                (js-call (expect (nativeGet g-state "count")) :toBe nil)
