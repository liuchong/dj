            (put repository :getSubscriptionStates original-get-sub-states)
            (put repository :insert original-insert)
            (put repository :insertMany original-insert-many)
            (put repository :replace original-replace)
            (put repository :insertIfAbsent original-if-absent)
            (put repository :insertManyIfAbsent original-many-if-absent)
            (put db :query original-query)
            (js-call (expect conn-gets) :toBe 2)
            (js-call (expect route-gets) :toBe 1)
            (js-call (expect sub-full-gets) :toBe 0)
            (js-call (expect sub-state-gets) :toBe 0)
            (js-call (expect sub-states-batch-calls) :toEqual (js-array (js-array "mt-sub-1" "mt-sub-2")))
            (js-call (expect sub-batch-sql-calls) :toBe 1)
            (js-call (expect md-gets) :toBe 0)
            (js-call (expect contrib-gets) :toBe 0)
            (js-call (expect del-single-inserts) :toBe 0)
            (js-call (expect del-many-calls) :toEqual (js-array (js-array "deliveries" 1 1)))
            (js-call (expect del-batch-sql-calls) :toBe 1)
            (js-call (expect if-absent-calls) :toBe 0)
            (js-call (expect many-if-absent-calls)
              :toEqual (js-array (js-array "match_decisions" 2 2) (js-array "contributions" 2 2)))
            (js-call (expect batch-write-order)
              :toEqual (js-array "deliveries" "match_decisions" "contributions"))
            (js-call (expect md-batch-sql-calls) :toBe 1)
            (js-call (expect contrib-batch-sql-calls) :toBe 1)
            (js-call (expect route-replaces) :toBe 0)
            (js-call (expect del-replaces) :toBe 0)
            (js-call (expect unlock-sql-calls) :toBe 0)
            (let ((d0 (JSON/parse (nativeGet (js-call (js-call db :query
                "SELECT payload FROM deliveries WHERE event_id='mt-ev-0'") :get) "payload")))
