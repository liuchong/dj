  (defun storageConfig
    (database)
    (js-object
      :database
      database
      :journal_mode
      "WAL"
      :synchronous
      "FULL"
      :foreign_keys
      t
      :busy_timeout
      0))
  (defasync setupStorage
    ()
    (let*
      ((root (resolve ".local/tests" (str "storage-fault-" (randomUUID))))
        (database (resolve root "dj.sqlite")))
      (await (mkdir root (js-object :recursive t :mode 448)))
      (js-object
        :root
        root
        :database
        database
        :store
        (successful (openStore (storageConfig database)))
        :second
        nil)))
  (defun closeStorage
    (f)
    (when f
      (when (nativeGet f "second") (js-call (nativeGet f "second") :close))
      (when (nativeGet f "store") (js-call (nativeGet f "store") :close))))
  (withCase
    "T40.wal-fault.sqlite.write-lock"
    setupStorage
    (lambda
      (f)
      (let*
        ((store (nativeGet f "store"))
