                        (js-call (expect (nativeGet (js-call repository :get "routes" "route-seq-big") "claim_owner")) :toBe "owner-p1"))))))
              (success t))))
            ;; Read-only EXPLAIN proof outside open write tx: narrow progress UPDATEs omit immutable indexed columns from SET,
            ;; eliminating IdxInsert/IdxDelete on routes and attempts and reducing deliveries bytecode vs full replace:
            (let* ((opcodes (lambda (sql)
                (let* ((stmt (js-call db :query (str "EXPLAIN " sql)))
                  (rows (js-call stmt :all)))
                  (js-call stmt :finalize)
                  (js-call rows :map (lambda (r) (nativeGet r "opcode"))))))
              (has-idx-maint (lambda (ops)
                (js-call ops :some (lambda (op) (or (= op "IdxInsert") (= op "IdxDelete"))))))
              (full-del-ops (opcodes "UPDATE deliveries SET route_id=?,origin=?,principal_id=?,operation_id=?,agent_id=?,event_id=?,delivery_seq=?,state=?,revision=?,expires_at=?,payload=? WHERE delivery_id=?"))
              (narrow-del-ops (opcodes "UPDATE deliveries SET state=?,revision=?,payload=? WHERE delivery_id=? AND route_id IS ? AND origin IS ? AND principal_id IS ? AND operation_id IS ? AND agent_id IS ? AND event_id IS ? AND delivery_seq IS ? AND expires_at IS ?"))
              (narrow-att-ops (opcodes "UPDATE attempts SET state=?,definite_not_sent=?,payload=? WHERE attempt_id=? AND delivery_id IS ? AND outbound_id IS ? AND lifecycle_id IS ? AND dispatch_key IS ?"))
              (narrow-rt-ops (opcodes "UPDATE routes SET binding_id=?,claim_owner=?,unknown_delivery_id=?,payload=? WHERE route_id=? AND canonical_target_key IS ? AND session_key IS ? AND next_delivery_seq IS ? AND claim_epoch IS ?")))
              (js-call (expect (< (js-length narrow-del-ops) (js-length full-del-ops))) :toBe t)
              (js-call (expect (has-idx-maint narrow-att-ops)) :toBe false)
              (js-call (expect (has-idx-maint narrow-rt-ops)) :toBe false))
            ;; Outer transaction rollback + SAVEPOINT isolation for replaceProgress:
            (let ((rolled (inTransaction context (lambda (tx)
