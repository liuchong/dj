                      :owner_principal_id "O" :context_policy "message_only"
                      :delivery_policy (js-object :busy "queue" :ttl_seconds 300)
                      :resolved_sources (js-array (js-object :connection_id "mt-conn" :native_chat_id "chat-1"
                        :native_thread_id nil :include_threads t :event_kinds (js-array "message")))
                      :predicate (js-object :op "contains" :field "text" :value "match")))
                    (js-call db :run
