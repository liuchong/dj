                (js-call (expect (nativeGet cap-d1 "revision")) :toBe 1))
              (js-call (expect (nativeGet (js-call (js-call db :query
                "SELECT COUNT(*) AS n FROM match_decisions WHERE event_id='mt-ev-cap'") :get) "n")) :toBe 3)
              (js-call (expect (nativeGet (js-call (js-call db :query
