                      :target_constraint (js-object :tool "batch-0")
                      :grants (js-array (js-object :action "*" :resources (js-array "*")))))
                    (principal-a2 (js-object :principal_id "A2" :kind "agent" :authorization_revision 1
                      :target_constraint (js-object :tool "batch-0")
                      :grants (js-array (js-object :action "*" :resources (js-array "*")))))
                    (l2-ctx (js-object :store store :repository repository :runtime (js-object) :principal principal-o
                      :ports (js-object :clock (createClock) :ids (js-object :next (lambda (prefix) (str prefix "-" (randomUUID)))))
                      :config (js-object :principals (js-array principal-o principal-a2))))
