            (put repository :replace (lambda (table record &optional expected)
              (when (= table "routes") (setq route-replaces (1+ route-replaces)))
              (when (= table "deliveries") (setq del-replaces (1+ del-replaces)))
              (funcall original-replace table record expected)))
            (put repository :insertIfAbsent (lambda (table record)
              (setq if-absent-calls (1+ if-absent-calls))
              (funcall original-if-absent table record)))
            (put repository :insertManyIfAbsent (lambda (table records)
              (let ((inserted (funcall original-many-if-absent table records)))
                (js-call many-if-absent-calls :push (js-array table (js-length records) inserted))
                (js-call batch-write-order :push table)
                inserted)))
            (put db :query (lambda (sql)
              (when (js-call sql :startsWith "SELECT subscription_id,owner_principal_id,state,revision FROM subscriptions WHERE subscription_id IN (")
                (setq sub-batch-sql-calls (1+ sub-batch-sql-calls)))
              (when (js-call sql :startsWith "INSERT INTO deliveries(")
                (setq del-batch-sql-calls (1+ del-batch-sql-calls)))
              (when (js-call sql :startsWith "INSERT INTO match_decisions(")
                (setq md-batch-sql-calls (1+ md-batch-sql-calls)))
              (when (js-call sql :startsWith "INSERT INTO contributions(")
                (setq contrib-batch-sql-calls (1+ contrib-batch-sql-calls)))
              (when (js-call sql :includes "UPDATE deliveries SET state='ready',revision=revision+1")
                (setq unlock-sql-calls (1+ unlock-sql-calls)))
              (funcall original-query sql)))
            (successful (await (matchBatch mt-context "mt-ev-0")))
