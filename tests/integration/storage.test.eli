              (js-call repository :replace "events" ev)))))
          (let ((tombstoned-sub (projectDelivery auth-context sub-record)))
            (js-call (expect tombstoned-sub) :toEqual (js-object
              :delivery_id "observe-sub-delivery" :origin "subscription_event" :state "accepted"
              :revision 1 :operation_id nil)))
          ;; E3: observeDelivery exits early with 0 attempt/binding/instance reads when delivery is not accepted,
