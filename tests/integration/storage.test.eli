                    :expires_at "2026-01-02T00:00:00.000Z")))) :toThrow "FOREIGN KEY constraint failed")
              (success t))))
            ;; R2: allocateSequence updates column and JSON payload in 1 SQL statement with 0 repository.replace("routes"),
            ;; preserves >2^53 text sequence, rolls back on tx failure, and guards signed-64 max overflow.
            (let ((route-replaces 0)
              (original-replace (nativeGet repository "replace")))
              (put repository :replace (lambda (table record &optional expected)
                (when (= table "routes") (setq route-replaces (1+ route-replaces)))
                (funcall original-replace table record expected)))
              (successful (inTransaction context (lambda (tx)
                (let ((big-route (js-object :route_id "route-seq-big" :canonical_target_key "target-seq-big"
                    :session_key "sess-1" :next_delivery_seq "9007199254740992" :claim_epoch 0)))
                  (js-call repository :insert "routes" big-route)
                  (let ((seq1 (allocateSequence context big-route))
                    (seq2 (allocateSequence context big-route)))
