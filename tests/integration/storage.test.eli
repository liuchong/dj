    "T40.wal-fault.sqlite.backup-wal"
    setupStorage
    (lambda
      (f)
      (let*
        ((store (nativeGet f "store"))
          (db (nativeGet store "db"))
          (backup (resolve (nativeGet f "root") "consistent.sqlite")))
        (js-call db :run "PRAGMA wal_autocheckpoint=0")
        (js-call
          db
          :run
          "CREATE TABLE backup_probe(id TEXT PRIMARY KEY, value TEXT NOT NULL)")
        (js-call db :run "INSERT INTO backup_probe VALUES ('before-backup','中文😀')")
        (successful (js-call store :backup backup))
        (js-call
          db
          :run
          "INSERT INTO backup_probe VALUES ('after-backup','must-not-appear')")
        (let ((restored (successful (openStore (storageConfig backup)))))
          (try
            (let ((copy (nativeGet restored "db")))
              ;; Y-A1: a backup restored through openStore re-applies temp_store=MEMORY.
              (js-call
                (expect
                  (nativeGet (js-call (js-call copy :query "PRAGMA temp_store") :get) "temp_store"))
                :toBe
                2)
              (js-call
                (expect
                  (js-call
                    (js-call
                      copy
                      :query
                      "SELECT id,value FROM backup_probe ORDER BY id")
                    :all))
                :toEqual
                (js-array (js-object :id "before-backup" :value "中文😀")))
              (js-call
                (expect
                  (nativeGet
                    (js-call (js-call copy :query "PRAGMA integrity_check") :get)
                    "integrity_check"))
                :toBe
                "ok"))
            (finally (js-call restored :close))))
        (let ((again (js-call store :backup backup)))
          (js-call (expect (nativeGet again "ok")) :toBe false))
        (js-call
          (expect
            (nativeGet
              (js-call
                (js-call db :query "SELECT COUNT(*) AS n FROM backup_probe")
                :get)
              "n"))
          :toBe
          2)))
    closeStorage)
