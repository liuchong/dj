                  "SELECT CAST(next_delivery_seq AS TEXT) AS col, json_extract(payload,'$.next_delivery_seq') AS json_val, typeof(json_extract(payload,'$.next_delivery_seq')) AS json_type FROM routes WHERE route_id='route-seq-big'") :get)))
                (js-call (expect (nativeGet row "col")) :toBe "9007199254740994")
                (js-call (expect (nativeGet row "json_val")) :toBe "9007199254740994")
                (js-call (expect (nativeGet row "json_type")) :toBe "text")
                (js-call (expect (nativeGet (js-call repository :get "routes" "route-seq-big") "next_delivery_seq"))
