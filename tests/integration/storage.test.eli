(module dj.tests.integration.storage
  (import "../../src/core/native.eli" NativeNumber NativeBigInt NativeGlobal nativeGet nativeNullish nativeSetTimeout)
  (import "bun:test" expect)
  (import "node:fs/promises" mkdir)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:sqlite" Database)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli"
    createFixture
    closeFixture
    callOk
    successful
    createClock
    createdEvent
    indexSessions
    getSession
    bindRecipient
    subscribe)
  (import "../support/faults.eli" createFaults)
  (import "../../src/storage/sqlite.eli" openStore)
  (import "../../src/storage/repository.eli" createRepository)
  (import "../../src/storage/schema.eli" migrate)
  (import "../../src/application/write-batch.eli" enqueueWrite)
  (import "../../src/application/context.eli" inTransaction must)
  (import "../../src/delivery/read-scope.eli" withContributionReads)
  (import "../../src/delivery/planning-scope.eli" withEventPlans)
  (import "../../src/delivery/service.eli" queueCapacity projectDelivery planContribution allocateSequence)
  (import "../../src/delivery/scheduler.eli" claimRoute releaseClaim beginSubmission recordReceipt observeDelivery reconcileDelivery selectHead)
  (import "../../src/policy/handles.eli" createHandleAuthority)
  (import "../../src/routing/matcher.eli" matchBatch matchTurn)
  (import "../../src/core/errors.eli" success failure)
  (defasync setup
    ()
    (let ((root (resolve ".local/tests" (str "storage-" (randomUUID)))))
      (await (mkdir root (js-object :recursive t :mode 448)))
      (successful
        (openStore
          (js-object
            :database
            (resolve root "test.sqlite")
            :journal_mode
            "WAL"
            :synchronous
            "FULL"
            :foreign_keys
            t
            :busy_timeout
            0)))))
  (defun close (store) (when store (js-call store :close)))
  (withCase "T40.write-batch-commit.sqlite" setup
    (async (store)
      (let* ((repository (createRepository store)) (commits 0) (visible false)
        (original (nativeGet store "transaction"))
        (context (js-object :store store :repository repository :runtime (js-object)))
        (pending (js-array)) (index 0))
        ;; Y-A3: a single item's UPDATE touches 64 existing 4KiB rows. Its domain
        ;; rollback restores every value while both neighboring items commit together.
        (let* ((db (nativeGet store "db")) (pad (js-call "x" :repeat 4096))
               (batch-commits 0) (committed false) (pending-large (js-array))
               (original-transaction (nativeGet store "transaction")))
          (js-call db :run "CREATE TABLE y_large_domain(id INTEGER PRIMARY KEY,value TEXT NOT NULL)")
          (successful (inTransaction context (lambda (tx)
            (js-call (js-call db :query "WITH RECURSIVE ids(id) AS (VALUES(0) UNION ALL SELECT id+1 FROM ids WHERE id<63) INSERT INTO y_large_domain SELECT id,? FROM ids") :run pad)
            (success t))))
          (put store :transaction (lambda (expected mutate)
            (setq batch-commits (1+ batch-commits))
            (let ((result (funcall original-transaction expected mutate)))
              (setq committed t) result)))
          (try
            (js-call pending-large :push (js-call (enqueueWrite context (lambda ()
              (js-call (js-call db :query "UPDATE y_large_domain SET value=? WHERE id=0") :run (str "before:" pad))
              (success "before"))) :then (lambda (result)
                (js-call (expect committed) :toBe t) result)))
            (js-call pending-large :push (js-call (enqueueWrite context (lambda ()
              (js-call (js-call db :query "UPDATE y_large_domain SET value=?") :run (str "rolled-back:" pad))
              (must (failure "revision_conflict")))) :then (lambda (result)
                (js-call (expect committed) :toBe t) result)))
            (js-call pending-large :push (js-call (enqueueWrite context (lambda ()
              (js-call (js-call db :query "UPDATE y_large_domain SET value=? WHERE id=63") :run (str "after:" pad))
              (success "after"))) :then (lambda (result)
                (js-call (expect committed) :toBe t) result)))
            (let ((results (await (Promise/all pending-large))))
              (js-call (expect (nativeGet (aref results 0) "ok")) :toBe t)
              (js-call (expect (nativeGet (aref results 1) "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet (aref results 1) "error") "code")) :toBe "revision_conflict")
              (js-call (expect (nativeGet (aref results 2) "ok")) :toBe t))
            (finally (put store :transaction original-transaction)))
          (js-call (expect batch-commits) :toBe 1)
          (let ((rows (js-call (js-call db :query "SELECT id,value FROM y_large_domain ORDER BY id") :all)))
            (js-call (expect (js-length rows)) :toBe 64)
            (js-call rows :forEach (lambda (row)
              (js-call (expect (nativeGet row "value")) :toBe
                (if (= (nativeGet row "id") 0) (str "before:" pad)
                  (if (= (nativeGet row "id") 63) (str "after:" pad) pad))))))
          (js-call (expect (nativeGet (js-call (js-call db :query "PRAGMA temp_store") :get) "temp_store")) :toBe 2))
        (put store :transaction (lambda (expected mutate)
          (setq commits (1+ commits))
          (let ((result (funcall original expected mutate))) (setq visible t) result)))
        (while (< index 8)
          (let ((key (str "batch-" index)))
            (js-call pending :push (js-call (enqueueWrite context (lambda ()
              (inTransaction context (lambda (tx)
                (js-call repository :insert "tools" (js-object :tool_id key :configured t))
                (success key))))) :then (lambda (result)
                  (js-call (expect visible) :toBe t)
                  (successful result)))))
          (setq index (1+ index)))
        (js-call (expect commits) :toBe 0)
        (js-call (expect (js-length (await (Promise/all pending)))) :toBe 8)
        (js-call (expect commits) :toBe 1)
        (js-call (expect (nativeGet (js-call (js-call (nativeGet store "db") :query "SELECT COUNT(*) AS n FROM tools") :get) "n")) :toBe 8)
        ;; Transaction-scoped contribution reads: caches only 4 read-only tables up to 256 entries,
        ;; freezes returned objects, rejects routes/outside-tx/async work, revokes reader in finally,
        ;; and observes fresh values across transactions. Also verifies precomputed SQL for composite keys & revision locks.
        (put store :transaction original)
        (js-call (expect (lambda () (withContributionReads context (lambda (read) (success t))))) :toThrow)
        (successful (inTransaction context (lambda (tx)
          (js-call repository :insert "instances" (js-object :instance_id "inst-1" :tool "batch-0"
            :native_namespace "ns-1" :instance_epoch "epoch-1" :ownership "existing" :state "ready" :revision 1))
          (js-call repository :insert "sessions" (js-object :session_key "sess-1" :tool "batch-0"
            :native_namespace "ns-1" :native_session_id "s-1" :instance_id "inst-1" :instance_epoch "epoch-1"
            :runtime_state "idle" :tombstone false :catalog_seq 1))
          (js-call repository :insert "routes" (js-object :route_id "route-1" :canonical_target_key "target-1"
            :session_key "sess-1" :next_delivery_seq "1" :claim_epoch 0))
          (js-call repository :insert "agents" (js-object :agent_id "agent-1" :route_id "route-1"
            :owner_principal_id "O" :recipient_principal_id "A" :canonical_target_key "target-1"
            :state "registered" :revision 1))
          (js-call repository :insert "subscriptions" (js-object :subscription_id "sub-1"
            :owner_principal_id "O" :agent_id "agent-1" :state "active" :revision 1))
          (let ((ci 0))
            (while (< ci 255)
              (js-call repository :insert "connections" (js-object :connection_id (str "conn-" ci)
                :revision 1 :state "online" :identity_revision 1))
              (setq ci (1+ ci))))
          (js-call repository :insert "poll_checkpoints" (js-object :connection_id "conn-0"
            :conversation_key "chat-1" :generation 1 :next_due_at "2026-01-01T00:00:00Z"))
          (success t))))
        (let ((get-calls 0) (escaped-read nil) (original-get (nativeGet repository "get")))
          (put repository :get (lambda (table key)
            (setq get-calls (1+ get-calls))
            (funcall original-get table key)))
          (successful (inTransaction context (lambda (tx)
            (js-call (expect (lambda () (withContributionReads context (async (read) (success t))))) :toThrow)
            (withContributionReads context (lambda (read)
              (setq escaped-read read)
              (let ((a1 (funcall read "agents" "agent-1"))
                (a2 (funcall read "agents" "agent-1"))
                (s1 (funcall read "subscriptions" "sub-1"))
                (s2 (funcall read "subscriptions" "sub-1"))
                (se1 (funcall read "sessions" "sess-1"))
                (se2 (funcall read "sessions" "sess-1"))
                (c0 (funcall read "connections" "conn-0"))
                (c0-again (funcall read "connections" "conn-0")))
                (js-call (expect a1) :toBe a2)
                (js-call (expect s1) :toBe s2)
                (js-call (expect se1) :toBe se2)
                (js-call (expect c0) :toBe c0-again)
                (js-call (expect (Object/isFrozen a1)) :toBe t)
                (js-call (expect (Object/isFrozen s1)) :toBe t)
                (js-call (expect (lambda () (put s1 :state "paused"))) :toThrow)
                (js-call (expect get-calls) :toBe 4)
                (js-call (expect (lambda () (funcall read "routes" "route-1"))) :toThrow)
                (let ((ci 1))
                  (while (< ci 253)
                    (funcall read "connections" (str "conn-" ci))
                    (setq ci (1+ ci))))
                ;; 3 (agent+sub+session) + 253 connections = 256 cached entries; 257th falls back to immediate get.
                (let ((before-overcap get-calls))
                  (funcall read "connections" "conn-253")
                  (funcall read "connections" "conn-253")
                  (js-call (expect (- get-calls before-overcap)) :toBe 2)
                  (funcall read "agents" "agent-1")
                  (funcall read "connections" "conn-0")
                  (js-call (expect (- get-calls before-overcap)) :toBe 2)))
              (success t))))))
          (js-call (expect (lambda () (funcall escaped-read "agents" "agent-1"))) :toThrow)
          (put repository :get original-get))
        (successful (inTransaction context (lambda (tx)
          (let ((sub (js-call repository :get "subscriptions" "sub-1"))
            (conn (js-call repository :get "connections" "conn-0"))
            (cp (js-call repository :get "poll_checkpoints"
              (js-object :connection_id "conn-0" :conversation_key "chat-1"))))
            (put sub :state "paused")
            (put sub :revision 2)
            (successful (js-call repository :replace "subscriptions" sub 1))
            (let ((conflict (js-call repository :replace "subscriptions" sub 1)))
              (js-call (expect (nativeGet conflict "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet conflict "error") "code")) :toBe "revision_conflict"))
            (put conn :identity_revision 2)
            (put conn :revision 2)
            (successful (js-call repository :replace "connections" conn 1))
            (put cp :generation 2)
            (successful (js-call repository :replace "poll_checkpoints" cp))
            (js-call (expect (nativeGet (js-call repository :get "poll_checkpoints"
              (js-object :connection_id "conn-0" :conversation_key "chat-1")) "generation")) :toBe 2)
            (js-call repository :delete "poll_checkpoints"
              (js-object :connection_id "conn-0" :conversation_key "chat-1"))
            (js-call (expect (js-call repository :get "poll_checkpoints"
              (js-object :connection_id "conn-0" :conversation_key "chat-1"))) :toBe nil))
          (success t))))
        (successful (inTransaction context (lambda (tx)
          (withContributionReads context (lambda (read)
            (js-call (expect (nativeGet (funcall read "subscriptions" "sub-1") "state")) :toBe "paused")
            (js-call (expect (nativeGet (funcall read "subscriptions" "sub-1") "revision")) :toBe 2)
            (js-call (expect (nativeGet (funcall read "connections" "conn-0") "identity_revision")) :toBe 2)
            (success t))))))
        ;; P2: repository.getSubscriptionState (exact 4-column projection, missing -> nil, invalid ID -> TypeError)
        ;; and withContributionReads(context, work, subscriptionStateOnly?) narrow mode vs default full mode:
        (let ((full-sub-gets 0) (narrow-sub-gets 0) (escaped-narrow-read nil)
          (original-get (nativeGet repository "get"))
          (original-get-sub-state (nativeGet repository "getSubscriptionState")))
          (js-call (expect (lambda () (js-call repository :getSubscriptionState ""))) :toThrow)
          (js-call (expect (lambda () (js-call repository :getSubscriptionState nil))) :toThrow)
          (js-call (expect (lambda () (js-call repository :getSubscriptionState 123))) :toThrow)
          (js-call (expect (lambda () (js-call repository :getSubscriptionState (js-object)))) :toThrow)
          (js-call (expect (js-call repository :getSubscriptionState "no-such-subscription")) :toBe nil)
          (let ((state-only (js-call repository :getSubscriptionState "sub-1"))
            (full-sub (js-call repository :get "subscriptions" "sub-1")))
            (js-call (expect (js-call (Object/keys state-only) :sort))
              :toEqual (js-array "owner_principal_id" "revision" "state" "subscription_id"))
            (js-call (expect state-only)
              :toEqual (js-object :subscription_id "sub-1" :owner_principal_id "O" :state "paused" :revision 2))
            (js-call (expect (nativeGet state-only "agent_id")) :toBe undefined)
            (js-call (expect (nativeGet full-sub "agent_id")) :toBe "agent-1"))
          (put repository :get (lambda (table key)
            (when (= table "subscriptions") (setq full-sub-gets (1+ full-sub-gets)))
            (funcall original-get table key)))
          (put repository :getSubscriptionState (lambda (id)
            (setq narrow-sub-gets (1+ narrow-sub-gets))
            (funcall original-get-sub-state id)))
          (successful (inTransaction context (lambda (tx)
            (js-call (expect (lambda () (withContributionReads context (lambda (read) (success t)) "invalid"))) :toThrow)
            (js-call (expect (lambda () (withContributionReads context (lambda (read) (success t)) 1))) :toThrow)
            ;; Default (omitted / false) uses full repository.get("subscriptions"):
            (withContributionReads context (lambda (read)
              (let ((s-default (funcall read "subscriptions" "sub-1")))
                (js-call (expect (nativeGet s-default "agent_id")) :toBe "agent-1"))) false)
            (js-call (expect full-sub-gets) :toBe 1)
            (js-call (expect narrow-sub-gets) :toBe 0)
            ;; Explicit narrow mode (true) uses getSubscriptionState for subscriptions and caches/freezes up to 256:
            (withContributionReads context (lambda (read)
              (setq escaped-narrow-read read)
              (let ((s1 (funcall read "subscriptions" "sub-1"))
                (s2 (funcall read "subscriptions" "sub-1"))
                (a1 (funcall read "agents" "agent-1"))
                (missing (funcall read "subscriptions" "no-such-subscription")))
                (js-call (expect s1) :toBe s2)
                (js-call (expect (Object/isFrozen s1)) :toBe t)
                (js-call (expect (nativeGet s1 "agent_id")) :toBe undefined)
                (js-call (expect s1)
                  :toEqual (js-object :subscription_id "sub-1" :owner_principal_id "O" :state "paused" :revision 2))
                (js-call (expect (nativeGet a1 "route_id")) :toBe "route-1")
                (js-call (expect missing) :toBe nil))) t)
            (js-call (expect full-sub-gets) :toBe 1)
            (js-call (expect narrow-sub-gets) :toBe 2)
            (success t))))
          (js-call (expect (lambda () (funcall escaped-narrow-read "subscriptions" "sub-1"))) :toThrow)
          ;; Mutate sub-1 owner/state/revision in a new transaction and verify narrow mode observes fresh columns:
          (successful (inTransaction context (lambda (tx)
            (let ((sub (funcall original-get "subscriptions" "sub-1")))
              (put sub :owner_principal_id "O2")
              (put sub :state "active")
              (put sub :revision 3)
              (successful (js-call repository :replace "subscriptions" sub 2)))
            (withContributionReads context (lambda (read)
              (js-call (expect (funcall read "subscriptions" "sub-1"))
                :toEqual (js-object :subscription_id "sub-1" :owner_principal_id "O2" :state "active" :revision 3))
              (success t)) t))))
          (successful (inTransaction context (lambda (tx)
            (let ((sub (funcall original-get "subscriptions" "sub-1")))
              (put sub :owner_principal_id "O")
              (put sub :state "paused")
              (put sub :revision 2)
              (js-call repository :replace "subscriptions" sub 3)))))
          (put repository :get original-get)
          (put repository :getSubscriptionState original-get-sub-state))
        ;; Single-event planning scope (withEventPlans): requires synchronous tx + string event_id,
        ;; caches up to 128 routes/deliveries per event with live fallback beyond 128,
        ;; lazily reads global 5-state count once and increments only on created(delivery),
        ;; rejects mismatched event_id or duplicate route delivery, and revokes methods on exit.
        (let ((ev1 (js-object :event_id "plan-ev-1" :received_at "2026-01-01T00:00:00.000Z"))
          (ev2 (js-object :event_id "plan-ev-2" :received_at "2026-01-01T00:00:00.000Z"))
          (escaped-plan nil)
          (route-gets 0)
          (original-get (nativeGet repository "get")))
          (js-call (expect (lambda () (withEventPlans context ev1 (lambda (p) (success t))))) :toThrow)
          (successful (inTransaction context (lambda (tx)
            (js-call (expect (lambda () (withEventPlans context (js-object) (lambda (p) (success t))))) :toThrow)
            (js-call (expect (lambda () (withEventPlans context ev1 (async (p) (success t))))) :toThrow)
            (let ((ri 2))
              (while (<= ri 130)
                (js-call repository :insert "routes" (js-object :route_id (str "route-" ri)
                  :canonical_target_key (str "target-" ri) :session_key "sess-1"
                  :next_delivery_seq "1" :claim_epoch 0))
                (setq ri (1+ ri))))
            (js-call repository :insert "operations" (js-object :operation_id "plan-op-1" :principal_id "O"
              :operation "session.send" :key_hash "plan-op-1" :request_hash "plan-op-1" :state "accepted"
              :created_at "2026-01-01T00:00:00Z" :result_expires_at "2026-01-02T00:00:00Z"))
            (js-call repository :insert "deliveries" (js-object :delivery_id "plan-existing-ready"
              :route_id "route-1" :origin "direct" :principal_id "O" :operation_id "plan-op-1"
              :delivery_seq "1" :state "ready" :revision 1 :expires_at "2026-01-02T00:00:00Z"))
            (success t))))
          (put repository :get (lambda (table key)
            (when (= table "routes") (setq route-gets (1+ route-gets)))
            (funcall original-get table key)))
          (successful (inTransaction context (lambda (tx)
            (withEventPlans context ev1 (lambda (planning)
              (setq escaped-plan planning)
              (js-call (expect (Object/isFrozen planning)) :toBe t)
              (js-call (expect (nativeGet planning "event_id")) :toBe "plan-ev-1")
              (let ((r1a (js-call planning :route "route-1"))
                (r1b (js-call planning :route "route-1")))
                (js-call (expect r1a) :toBe r1b)
                (js-call (expect route-gets) :toBe 1)
                ;; Mutable working route belongs to this event item (not frozen like read-scope).
                (put r1a :next_delivery_seq "2")
                (js-call (expect (nativeGet (js-call planning :route "route-1") "next_delivery_seq")) :toBe "2"))
              (let ((ri 2))
                (while (<= ri 128)
                  (js-call planning :route (str "route-" ri))
                  (js-call planning :delivery (str "route-" ri))
                  (setq ri (1+ ri))))
              (js-call (expect route-gets) :toBe 128)
              ;; 129th route exceeds 128 cap and falls back to live get every time; first 128 stay cached.
              (js-call planning :route "route-129")
              (js-call planning :route "route-129")
              (js-call (expect route-gets) :toBe 130)
              (js-call planning :route "route-1")
              (js-call (expect route-gets) :toBe 130)
              ;; Delivery lookup + created(delivery) + lazy global count increment:
              (js-call (expect (js-call planning :delivery "route-1")) :toBe nil)
              (successful (js-call planning :capacity "route-1"))
              (let ((created-del (js-object :delivery_id "plan-del-1" :route_id "route-1"
                :origin "subscription_event" :event_id "plan-ev-1" :delivery_seq "2"
                :state "blocked" :blocked_reason "routing_incomplete" :revision 1)))
                (js-call (expect (lambda () (js-call planning :created
                  (js-object :delivery_id "wrong-ev" :route_id "route-2" :event_id "plan-ev-2")))) :toThrow)
                (js-call (expect (js-call planning :created created-del)) :toBe created-del)
                (js-call (expect (js-call planning :delivery "route-1")) :toBe created-del)
                (js-call (expect (lambda () (js-call planning :created created-del))) :toThrow))
              ;; planContribution rejects mismatched planning.event_id:
              (js-call (expect (lambda ()
                (planContribution tx ev2 (js-object :agent_id "agent-1" :subscription_id "sub-1" :revision 2
                  :delivery_policy (js-object :ttl_seconds 60)) (js-object) nil planning))) :toThrow)
              (success t))))))
          (js-call (expect (lambda () (js-call escaped-plan :route "route-1"))) :toThrow)
          (js-call (expect (lambda () (js-call escaped-plan :delivery "route-1"))) :toThrow)
          (js-call (expect (lambda () (js-call escaped-plan :capacity "route-1"))) :toThrow)
          (js-call (expect (lambda () (js-call escaped-plan :created (js-object :event_id "plan-ev-1" :route_id "route-2")))) :toThrow)
          (js-call (expect (lambda () (js-call escaped-plan :finish "done"))) :toThrow)
          ;; Next event scope re-reads fresh route from DB (uncommitted in-memory mutation from ev1 did not persist).
          (successful (inTransaction context (lambda (tx)
            (withEventPlans context ev2 (lambda (planning2)
              (js-call (expect (nativeGet planning2 "initial_ready")) :toBe false)
              (js-call (expect (nativeGet (js-call planning2 :route "route-1") "next_delivery_seq")) :toBe "1")
              (js-call (expect (js-call planning2 :delivery "route-1")) :toBe nil)
              (js-call (expect (js-call planning2 :finish "ready")) :toBe false)
              (js-call (expect (js-call planning2 :finish "done")) :toBe t)
              (success t))))))
          (put repository :get original-get)
          ;; R1 (repository.insertIfAbsent), R2 (allocateSequence single-SQL column+payload sync), and R3 (withEventPlans initial_ready + finish):
          (let ((db (nativeGet store "db")))
            (js-call (expect (lambda ()
              (js-call repository :insertIfAbsent "match_decisions"
                (js-object :event_id "ins-ev-1" :subscription_id "sub-1" :revision 1 :result "match")))) :toThrow)
            (successful (inTransaction context (lambda (tx)
              (js-call (expect (lambda ()
                (js-call repository :insertIfAbsent "tools" (js-object :tool_id "not-allowed" :configured t)))) :toThrow)
              (js-call (expect (lambda ()
                (js-call repository :insertIfAbsent "routes" (js-object :route_id "route-1")))) :toThrow)
              (js-call (expect (lambda ()
                (js-call repository :insertIfAbsent "deliveries" (js-object :delivery_id "plan-existing-ready")))) :toThrow)
              (js-call repository :insert "events" (js-object :event_id "ins-ev-1" :connection_id "conn-0"
                :source_key "ins-src-1" :conversation_key "chat-1" :native_message_id "ins-msg-1"
                :event_kind "message" :ingress_seq 100 :received_at "2026-01-01T00:00:00.000Z"
                :body_expires_at "2026-01-02T00:00:00.000Z" :tombstone false))
              (js-call repository :insert "deliveries" (js-object :delivery_id "ins-del-1" :route_id "route-1"
                :origin "subscription_event" :agent_id "agent-1" :event_id "ins-ev-1" :delivery_seq "10"
                :state "ready" :revision 2 :expires_at "2026-01-02T00:00:00.000Z"))
              (js-call repository :insert "subscription_versions" (js-object :subscription_id "sub-1"
                :revision 1 :start_seq 0 :cutover_seq nil :state "active"))
              (js-call repository :insert "subscription_versions" (js-object :subscription_id "sub-1"
                :revision 2 :start_seq 0 :cutover_seq nil :state "active"))
              (js-call repository :insert "subscription_versions" (js-object :subscription_id "sub-1"
                :revision 3 :start_seq 0 :cutover_seq nil :state "active"))
              ;; Test-only CHECK probes on this isolated SQLite store (production schema is not modified to fit tests)
              ;; to prove ON CONFLICT(pk...) DO NOTHING does not swallow CHECK violations like INSERT OR IGNORE would:
              (js-call db :run "ALTER TABLE match_decisions ADD COLUMN test_check INTEGER CHECK(result IN ('match','no_match','indeterminate'))")
              (js-call db :run "ALTER TABLE contributions ADD COLUMN test_check INTEGER CHECK(state IN ('active','effective','expired','revoked'))")
              ;; Composite PK deduplication without overwriting existing payload:
