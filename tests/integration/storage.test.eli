                (js-call (expect (nativeGet saved-md "reason_codes")) :toEqual (js-array "literal_predicate")))
              (js-call (expect (js-call repository :insertIfAbsent "match_decisions"
                (js-object :event_id "ins-ev-1" :subscription_id "sub-1" :revision 2 :result "no_match"))) :toBe t)
              (js-call (expect (js-call repository :insertIfAbsent "contributions"
