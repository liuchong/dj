              (js-call (expect (nativeGet (nativeGet (aref turn-res 4) "error") "code")) :toBe "revision_conflict")
              (js-call (expect (nativeGet (aref turn-res 5) "ok")) :toBe t)
              ;; Delivery sequence strictly follows works order (mt-ev-1 -> seq "2", mt-ev-3 -> seq "3"), and mt-ev-2 rolled back.
              (let ((d1 (JSON/parse (nativeGet (js-call (js-call db :query
                  "SELECT payload FROM deliveries WHERE event_id='mt-ev-1'") :get) "payload")))
                (d2-row (js-call (js-call db :query "SELECT payload FROM deliveries WHERE event_id='mt-ev-2'") :get))
                (d3 (JSON/parse (nativeGet (js-call (js-call db :query
                  "SELECT payload FROM deliveries WHERE event_id='mt-ev-3'") :get) "payload"))))
                (js-call (expect d2-row) :toBe nil)
                (js-call (expect (nativeGet d1 "delivery_seq")) :toBe "2")
                (js-call (expect (nativeGet d3 "delivery_seq")) :toBe "3")
                (js-call (expect (= (NativeBigInt (nativeGet d3 "delivery_seq"))
                  (+ (NativeBigInt (nativeGet d1 "delivery_seq")) (NativeBigInt 1)))) :toBe t))
