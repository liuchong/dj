              (js-call (expect (aref prepare-order 3)) :toBe "mt-ev-1")
              (js-call (expect (nativeGet (aref turn-res 0) "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet (aref turn-res 0) "error") "code")) :toBe "not_found")
              (js-call (expect (nativeGet (aref turn-res 1) "ok")) :toBe t)
              (js-call (expect (nativeGet (aref turn-res 2) "ok")) :toBe t)
              (js-call (expect (nativeGet (js-call repository :get "routing_work" "mt-bot") "state")) :toBe "done")
              (js-call (expect (js-call (js-call db :query "SELECT 1 FROM deliveries WHERE event_id='mt-bot'") :get)) :toBe nil)
              (js-call (expect (nativeGet (aref turn-res 3) "ok")) :toBe t)
              ;; N-A5: a non-fatal per-event revision_conflict stays inside success(results);
              ;; routeEvents therefore keeps ok=true and the second matching group stays eligible by more.
