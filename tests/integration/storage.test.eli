                        (js-call (expect (nativeGet s1 "revision")) :toBe 2)
                        (js-call (expect (nativeGet s1 "blocked_reason" nil)) :toBe nil)
                        (js-call (expect (nativeGet s2 "state")) :toBe "ready")
                        (js-call (expect (nativeGet s2 "revision")) :toBe 2)
                        (js-call (expect (nativeGet s2 "blocked_reason" nil)) :toBe nil)))
                    (success t)) false t)
                  ;; 2) Buffered scope with completeInOneTurn=true + finish("blocked"):
                  ;;    reads pre-existing ready delivery on route-4 (not modified in memory by finish("blocked")),
                  ;;    and normalizes newly created ready/rev2 delivery on route-6 to blocked/routing_incomplete/rev1 with 0 replace calls:
                  (setq batch-del-inserts (js-array))
                  (withEventPlans context (js-object :event_id "l2-ev-cap") (lambda (p)
                    (let ((existing-d1 (js-call p :delivery "route-4"))
                      (d3 (js-object :delivery_id "l2-norm-blk-3" :route_id "route-6"
                        :origin "subscription_event" :agent_id "agent-1" :event_id "l2-ev-cap"
                        :delivery_seq "1" :state "ready" :blocked_reason nil :revision 2
                        :expires_at "2026-01-02T00:00:00.000Z")))
                      (js-call (expect (nativeGet existing-d1 "delivery_id")) :toBe "l2-norm-done-1")
                      (js-call p :created d3)
                      (js-call (expect (js-call p :finish "blocked")) :toBe false)
                      (js-call (expect single-del-inserts) :toBe 0)
                      (js-call (expect del-replaces) :toBe 0)
