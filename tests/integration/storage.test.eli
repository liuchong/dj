                        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT total_changes() AS n") :get) "n")) :toBe before-changes)
                        (js-call (expect (nativeGet (js-call repository :get "attempts" "p1-att-1") "state")) :toBe "failed"))))))
              ;; 3) routes replaceProgress: updates binding_id, claim_owner, unknown_delivery_id + payload; rejects invariant mutation:
              (let ((rt (js-call repository :get "routes" "route-seq-big")))
