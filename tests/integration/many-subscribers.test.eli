(module dj.tests.integration.many-subscribers
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk subscribe createdEvent)
  (import "bun:test" expect)
  (defasync setup (&optional fixed)
    (await (createFixture "many-subscribers" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (when fixed
        (put config :fixed_routes (js-call (js-array "s1" "s2") :map (lambda (session)
          (js-object :id session :owner_principal_id "O" :recipient_principal_id "A"
            :target (js-object :instance_id "oc-existing" :native_session_id session)
            :rules (js-array (js-object :id "default" :enabled t
              :sources (js-array (js-object :connection_id "lark"))
              :event_kinds (js-array "message.created")
              :predicate (js-object :all (js-array)))))))))
      (let ((principal (aref (nativeGet config "principals") 2)))
        (Reflect/deleteProperty principal "target_constraint")
        (put principal :grants (js-array (js-object :action "*" :resources (js-array "*")))))
      (let ((inspect-peer (js-call (nativeGet config "principals") :find (lambda (p) (= (nativeGet p "principal_id") "B"))))
            (isolated-peer (js-call (nativeGet config "principals") :find (lambda (p) (= (nativeGet p "principal_id") "S")))))
        (when inspect-peer
          (Reflect/deleteProperty inspect-peer "target_constraint")
          (put inspect-peer :grants (js-array
            (js-object :action "agent.inspect" :resources (js-array "*"))
            (js-object :action "subscription.manage" :resources (js-array "*"))
            (js-object :action "subscription.consume" :resources (js-array "*")))))
        (when isolated-peer
          (Reflect/deleteProperty isolated-peer "target_constraint")
          (put isolated-peer :grants (js-array
            (js-object :action "agent.inspect" :resources (js-array (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s-isolated")))
            (js-object :action "subscription.manage" :resources (js-array "*"))
            (js-object :action "subscription.consume" :resources (js-array "*"))))))
      (let ((sessions (nativeGet (js-call (nativeGet ports "agent_ports") :get "opencode") "sessions")))
        (js-call sessions :push
          (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s-pull"
            :instance_id "oc-existing" :instance_epoch "epoch-1" :title "pull-peer" :workspace_ref "ws-test"
            :visibility (js-array "live") :runtime_state "idle" :live_receiver t
            :model_selection (js-object :provider_id undefined :model_id undefined :variant undefined))
          (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s-inspect"
            :instance_id "oc-existing" :instance_epoch "epoch-1" :title "inspect-peer" :workspace_ref "ws-test"
            :visibility (js-array "live") :runtime_state "idle" :live_receiver t
            :model_selection (js-object :provider_id undefined :model_id undefined :variant undefined))
          (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s-isolated"
            :instance_id "oc-existing" :instance_epoch "epoch-1" :title "isolated-peer" :workspace_ref "ws-test"
            :visibility (js-array "live") :runtime_state "idle" :live_receiver t
            :model_selection (js-object :provider_id undefined :model_id undefined :variant undefined)))))))))
  (defasync register (f session &optional display-name)
    (let* ((page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live"))))
      (candidate (js-call (nativeGet page "items") :find (lambda (row) (= (nativeGet row "native_session_id") session)))))
      (await (callOk f "A" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name (or display-name (str "receiver-" session)) :binding_mode "existing" :idempotency_key (str "register-" session))))))
  (withCase "T33.many-subscribers.integration" setup (async (f)
    (let* ((a (await (register f "s1" "Unrelated archived prompt\nResume an old timer")))
      (b (await (register f "s2" (js-call "x" :repeat 200)))) (c (await (register f "s-pull")))
      (who (await (callOk f "A" "agent.whoami" (js-object))))
      (sa (await (subscribe f a "lark"))) (sb (await (subscribe f b "lark")))
      (source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object :agent_id (nativeGet c "agent_id")
        :rules (js-array (js-object :id "default" :enabled t
          :sources (js-array (js-object :conversation_ref (nativeGet source "conversation_ref") :include_threads false))
          :event_kinds (js-array "message.created") :predicate (js-object :all (js-array))))
        :delivery_mode "pull" :start "now")))))
      (pull (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "pull-sub"))))
      (peer (nativeGet f "opencode")))
      (js-call (expect (js-length (nativeGet who "bound_agent_ids"))) :toBe 3)
      (js-call (expect (nativeGet who "bound_agent_ids")) :toContain (nativeGet a "agent_id"))
      (js-call (expect (nativeGet who "bound_agent_ids")) :toContain (nativeGet b "agent_id"))
      (await (js-call f :ingest (createdEvent "lark" "shared-event" "shared body")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 2)
      (js-call (nativeGet peer "inputs") :forEach (lambda (input)
        (let* ((envelope (nativeGet input "envelope")) (hints (nativeGet envelope "subscriber_hints"))
          (others (nativeGet hints "subscribers")))
          (js-call (expect (nativeGet hints "basis")) :toBe "same_event")
          (js-call (expect (js-length others)) :toBe 2)
          (js-call (expect (js-call others :filter (lambda (o) (object-has? o :display_name)))) :toEqual
            (js-call others :filter (lambda (o) (= (nativeGet o "native_session_id") "s-pull"))))
          (js-call (expect (js-call others :some (lambda (o) (= (nativeGet o "native_session_id") (nativeGet (nativeGet envelope "recipient") "native_session_id"))))) :toBe false))))
      (let* ((claimed (await (callOk f "A" "subscription.pull" (js-object :agent_id (nativeGet c "agent_id") :idempotency_key "claim-shared"))))
        (item (nativeGet claimed "item")) (hints (nativeGet (nativeGet item "envelope") "subscriber_hints")))
        (js-call (expect (nativeGet claimed "empty")) :toBe false)
        (js-call (expect (js-length (nativeGet hints "subscribers"))) :toBe 2)
        (js-call (expect (js-call (nativeGet hints "subscribers") :every
          (lambda (o) (not (object-has? o :display_name))))) :toBe t)
        (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet item "claim_ref") :disposition "consumed" :idempotency_key "ack-shared"))))
      (await (callOk f "A" "subscription.delete" (js-object :agent_id (nativeGet a "agent_id")
        :expected_revision (nativeGet sa "revision") :idempotency_key "unsubscribe-only-a")))
      (await (callOk f "A" "subscription.delete" (js-object :agent_id (nativeGet c "agent_id")
        :expected_revision (nativeGet pull "revision") :idempotency_key "unsubscribe-only-c")))
      (await (js-call f :ingest (createdEvent "lark" "after-unsubscribe" "only b")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 3)
      (js-call (expect (nativeGet (nativeGet (aref (nativeGet peer "inputs") 2) "envelope") "subscriber_hints")) :toBeUndefined)
      (js-call (expect (nativeGet (await (callOk f "A" "subscription.get" (js-object :agent_id (nativeGet b "agent_id")))) "state")) :toBe "active")
      ;; Cross-principal subscriber_hints allows agent.inspect visibility while
      ;; preserving isolation and post-filter has_more for restricted principals.
      (let* ((page (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))))
             (c-inspect (js-call (nativeGet page "items") :find (lambda (row) (= (nativeGet row "native_session_id") "s-inspect"))))
             (c-isolated (js-call (nativeGet page "items") :find (lambda (row) (= (nativeGet row "native_session_id") "s-isolated"))))
             (ag-inspect (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet c-inspect "candidate_ref")
               :display_name "inspect-peer" :binding_mode "existing" :recipient_principal_id "B" :idempotency_key "reg-inspect"))))
             (ag-isolated (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet c-isolated "candidate_ref")
               :display_name "isolated-peer" :binding_mode "existing" :recipient_principal_id "S" :idempotency_key "reg-isolated")))))
        (await (subscribe f ag-inspect "lark" 60 "B"))
        (await (subscribe f ag-isolated "lark" 60 "S"))
        (await (js-call f :ingest (createdEvent "lark" "cross-principal-event" "shared across principals")))
        (await (js-call f :tick))
        (let* ((recent (js-call (nativeGet peer "inputs") :slice 3))
               (for-inspect (js-call recent :find (lambda (item) (= (nativeGet (nativeGet (nativeGet item "envelope") "recipient") "native_session_id") "s-inspect"))))
               (for-isolated (js-call recent :find (lambda (item) (= (nativeGet (nativeGet (nativeGet item "envelope") "recipient") "native_session_id") "s-isolated")))))
          (js-call (expect (js-length (nativeGet (nativeGet (nativeGet for-inspect "envelope") "subscriber_hints") "subscribers"))) :toBe 2)
          (js-call (expect (nativeGet (nativeGet (nativeGet for-inspect "envelope") "subscriber_hints") "has_more")) :toBe false)
          (js-call (expect (nativeGet (nativeGet for-isolated "envelope") "subscriber_hints")) :toBeUndefined)))
      ;; Paginated agent.discover (>20 candidates with undefined optional fields)
      ;; must serialize pending snapshot items cleanly across pages.
      (let ((extra 0))
        (while (< extra 54)
          (js-call (nativeGet peer "sessions") :push
            (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id (str "s-page-" extra)
              :instance_id "oc-existing" :instance_epoch "epoch-1" :title (str "paged-" extra) :workspace_ref "ws-test"
              :visibility (js-array "live") :runtime_state "idle" :live_receiver t
              :model_selection (js-object :provider_id undefined :model_id undefined :variant undefined)))
          (setq extra (1+ extra)))
        (let* ((first-page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live" :limit 20))))
               (second-page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live" :cursor (nativeGet first-page "next_cursor") :limit 20))))
               (third-page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live" :cursor (nativeGet second-page "next_cursor") :limit 20)))))
          (js-call (expect (js-length (nativeGet first-page "items"))) :toBe 20)
          (js-call (expect (js-length (nativeGet second-page "items"))) :toBe 20)
          (js-call (expect (> (js-length (nativeGet third-page "items")) 15)) :toBe t)
          (js-call (expect (nativeGet third-page "complete")) :toBe t)))
      (let ((config (JSON/parse (JSON/stringify (nativeGet f "config")))))
        (put config :subscriber_hints false)
        (js-call (expect (nativeGet (await (js-call (nativeGet f "core") :reloadConfig config)) "ok")) :toBe t))
      (await (js-call f :ingest (createdEvent "lark" "hints-off" "body")))
      (await (js-call f :tick))
      (js-call (expect (nativeGet (nativeGet (aref (nativeGet peer "inputs") (- (js-length (nativeGet peer "inputs")) 1)) "envelope") "subscriber_hints")) :toBeUndefined)
      (let ((forbidden (await (js-call f :call (nativeGet f "X") "agent.register" (js-object :candidate_ref "unknown" :display_name "x" :binding_mode "existing" :idempotency_key "cannot-bind")))))
        (js-call (expect (nativeGet forbidden "ok")) :toBe false)))) closeFixture)
  (withCase "T38.many-fixed-targets.integration" (async () (await (setup t))) (async (f)
    (let ((turn 0)) (while (< turn 6) (await (js-call f :tick)) (setq turn (1+ turn))))
    (js-call (expect (js-length (nativeGet (await (callOk f "A" "agent.whoami" (js-object))) "bound_agent_ids"))) :toBe 2)
    (await (js-call f :ingest (createdEvent "lark" "fixed-shared" "shared")))
    (await (js-call f :tick))
    (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2)) closeFixture))
