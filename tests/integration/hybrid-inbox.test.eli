(module dj.tests.integration.hybrid-inbox
  (import "../../src/core/native.eli" nativeGet NativeGlobal NativeNumber nativeSetTimeout)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../../packages/lark/src/wire.eli" encodeLarkFrame decodeLarkFrame)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)

  (defconst socketFactory (js-object))
  (defun receiver (url) (funcall (nativeGet socketFactory "make") url))
  (defasync advance (f count &optional native-wait-ms)
    (let ((i 0))
      (while (< i count)
        (js-call (nativeGet f "clock") :advance 1000)
        (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done (or native-wait-ms 0)))))
        (let ((result (await (js-call f :tick))))
          (js-call (expect (nativeGet result "ok")) :toBe t))
        (setq i (1+ i)))))
  (defasync setup ()
    (let* ((original globalThis.WebSocket) (clock nil) (f nil)
      (sockets (new globalThis.Map)) (messages (new globalThis.Map))
      (marks (new globalThis.Map)) (calls (js-array)) (replies (js-array))
      (state (js-object :acks 0 :reaction_seq 0 :enabled false :root nil
        :user_only_ids (new globalThis.Set) :bot_lag_ids (new globalThis.Map) :app_open_id nil))
      (project-message (lambda (message bot)
        (when message
          (let* ((id (nativeGet message "message_id"))
                 (source (if (and bot (js-call (nativeGet state "bot_lag_ids") :has id))
                           (js-call (nativeGet state "bot_lag_ids") :get id)
                           message))
                 (map-id (nativeGet state "app_open_id")))
            (unless (and bot (js-call (nativeGet state "user_only_ids") :has id))
              (if (not map-id)
                source
                (let* ((sender (nativeGet source "sender"))
                       (next-sender (if (= (nativeGet sender "sender_type") "user")
                                      (Object/assign (js-object) sender (js-object :id (funcall map-id (nativeGet sender "id") bot)))
                                      sender))
                       (next-mentions (js-call (nativeGet source "mentions" (js-array)) :map (lambda (m)
                         (Object/assign (js-object) m (js-object :id (funcall map-id (nativeGet m "id") bot)))))))
                  (Object/assign (js-object) source (js-object :sender next-sender :mentions next-mentions))))))))))
      (put state :pins (js-object :user (js-array) :bot (js-array)))
      (put socketFactory :make (lambda (address)
        (let* ((url (new globalThis.URL address)) (app (js-call (nativeGet url "searchParams") :get "app"))
          (socket (new globalThis.EventTarget)))
          (js-call sockets :set app socket) (put socket :readyState 1)
          (put socket :send (lambda (bytes)
            (let ((frame (decodeLarkFrame bytes)))
              (when (= (js-call (nativeGet frame "payload") :toString "utf8") "{\"code\":200}")
                ;; ACK must follow the durable native receipt, before enrichment or Core consumption.
                (let ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t))))
                  (try
                    (js-call (expect (> (nativeGet (js-call (js-call db :query
                      "SELECT COUNT(*) AS n FROM lark_event_receipts") :get) "n") 0)) :toBe t)
                    (finally (js-call db :close))))
                (put state :acks (1+ (nativeGet state "acks")))))))
          (put socket :close (lambda (&rest ignored)
            (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close"))))
          (nativeSetTimeout (lambda () (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0)
          socket)))
      (put NativeGlobal :WebSocket receiver)
      (try
        (setq f (await (createFixture "hybrid-inbox-flow" "one" (js-object :configure (lambda (config ports)
          (setq clock (nativeGet ports "clock"))
          (put config :managed_profiles (js-array))
          (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
          (let ((user (aref (nativeGet config "connections") 0)))
            (Object/assign user (js-object :source_delivery "events" :event_scope "all_authorized"
              :pin_poll_seconds 2
              :event_app_id "cli_user" :event_subject_id "ou_self"
              :user_identity (js-object :app_id "cli_user" :open_id "ou_self")))
            (js-call (nativeGet config "connections") :push (js-object :connection_id "lark-bot"
              :platform "lark" :brand "lark" :identity "bot" :source_delivery "events"
              :pin_poll_seconds 2
              :event_scope "all_authorized" :event_app_id "cli_bot" :event_subject_id "ou_bot"
              :credential_ref "test:lark-bot" :watches (js-array)))
            (put ports :credentials (js-object :resolve (lambda (ref)
              (js-object :app_id (if (= ref "test:lark-bot") "cli_bot" "cli_user")
                :app_secret "fixture" :user_access_token "user-token"))))
            (put ports :http (js-object :fetch (async (address options)
              (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
                (query (nativeGet url "searchParams")) (method (nativeGet options "method" "GET"))
                (body (and (nativeGet options "body") (JSON/parse (nativeGet options "body"))))
                (bot (= (nativeGet (nativeGet options "headers") "authorization") "Bearer bot-token"))
                (key (if bot "bot" "user"))
                (reaction (js-call path :match (new globalThis.RegExp "/messages/([^/]+)/reactions(?:/([^/]+))?$")))
                (detail (js-call path :match (new globalThis.RegExp "/messages/([^/]+)$")))
                (reply (js-call path :match (new globalThis.RegExp "/messages/([^/]+)/reply$")))
                (selected (js-array)))
                (js-call calls :push (if (= path "/open-apis/im/v1/messages/mget")
                  (js-object :key key :path path :method method :query_ids (js-call query :getAll "message_ids"))
                  (js-object :key key :path path :method method)))
                (cond
                  ((js-call path :endsWith "/ws/endpoint")
                    (Response/json (js-object :code 0 :data (js-object
                      :URL (str "wss://fixture.larksuite.com/ws?service_id=1&app=" (nativeGet body "AppID"))
                      :ClientConfig (js-object :PingInterval 90)))))
                  ((js-call path :endsWith "/authen/v1/user_info")
                    (Response/json (js-object :code 0 :data (js-object :open_id "ou_self"))))
                  ((js-call path :endsWith "/tenant_access_token/internal")
                    (Response/json (js-object :code 0 :tenant_access_token "bot-token" :expire 3600)))
                  (reaction
                    (let* ((message-id (aref reaction 1)) (mark-key (str key ":" message-id))
                      (existing (js-call marks :get mark-key)))
                      (cond
                        ((= method "GET") (Response/json (js-object :code 0 :data
                          (js-object :items (if existing (js-array existing) (js-array)) :has_more false))))
                        ((= method "POST")
                          (put state :reaction_seq (1+ (nativeGet state "reaction_seq")))
                          (let ((mark (js-object :reaction_id (str "reaction-" (nativeGet state "reaction_seq"))
                            :reaction_type (nativeGet body "reaction_type")
                            :operator (js-object :operator_type (if bot "app" "user")
                              :operator_id (if bot "cli_bot" "ou_self")))))
                            (js-call marks :set mark-key mark)
                            (Response/json (js-object :code 0 :data mark))))
                        (t
                          (js-call (expect (aref reaction 2)) :toBe (nativeGet existing "reaction_id"))
                          (js-call marks :delete mark-key) (Response/json (js-object :code 0 :data (js-object)))))))
                  (reply
                    (js-call replies :push (js-object :key key :message_id (aref reply 1) :body body))
                    (Response/json (js-object :code 0 :data (js-object :message_id "reply-native"
                      :chat_id (nativeGet (js-call messages :get (aref reply 1)) "chat_id")))))
                  ((= path "/open-apis/im/v1/messages/mget")
                    (js-call (expect (js-call query :get "user_id_type")) :toBe "open_id")
                    (let* ((keys (js-call query :getAll "message_ids"))
                           (items (js-call keys :map (lambda (id) (funcall project-message (js-call messages :get id) bot)))))
                      (if (js-call keys :includes (nativeGet state "edit_denied_id" ""))
                        (Response/json (js-object :code 230013) (js-object :status 403))
                        (Response/json (js-object :code 0 :data (js-object :items
                          (js-call items :filter (lambda (message) message))))))))
                  (detail (Response/json (js-object :code 0 :data (js-object
                    :items (js-call (let ((item (funcall project-message (js-call messages :get (aref detail 1)) bot)))
                                      (if item (js-array item) (js-array)))
                             :concat (nativeGet (nativeGet state "embedded" (js-object)) (aref detail 1) (js-array))) :has_more false))))
                  ((= path "/open-apis/im/v1/chats")
                    (Response/json (js-object :code 0 :data (js-object
                      :items (js-call (js-array (js-object :chat_id "c1")) :concat (nativeGet state "extra_chats" (js-array)))
                      :has_more false))))
                  ((= path "/open-apis/im/v1/pins")
                    (if (nativeGet state "pin_fail") (Response/json (js-object :code 99991663))
                      (let* ((pins (nativeGet (nativeGet state "pins") key (js-array)))
                        (visible (js-call pins :filter (lambda (pin)
                          (and (= (nativeGet pin "chat_id") (js-call query :get "chat_id"))
                            (>= (NativeNumber (nativeGet pin "create_time")) (NativeNumber (js-call query :get "start_time")))
                            (<= (NativeNumber (nativeGet pin "create_time")) (NativeNumber (js-call query :get "end_time")))))))
                        (offset (if (js-call query :get "page_token") 1 0))
                        (more (and (nativeGet state "pin_paginate") (= offset 0) (> (js-length visible) 1))))
                        (Response/json (js-object :code 0 :data (js-object :items
                          (if (nativeGet state "pin_paginate") (js-call visible :slice offset (1+ offset)) visible)
                          :has_more (if more t false) :page_token (if more "pin-page-two" nil)))))))
                  ((or (= path "/open-apis/search/v2/message") (= path "/open-apis/im/v1/messages"))
                    (when (nativeGet state "enabled")
                      (js-call messages :forEach (lambda (message)
                        (let* ((chat (nativeGet message "chat_id")) (private (= chat "user-dm"))
                          (stamp (/ (NativeNumber (nativeGet message "create_time")) 1000))
                          (start (NativeNumber (if bot (js-call query :get "start_time") (nativeGet body "start_time"))))
                          (end (NativeNumber (if bot (js-call query :get "end_time") (nativeGet body "end_time")))))
                          (when (and (>= stamp start) (< stamp end)
                            (if bot (= chat (js-call query :get "container_id"))
                              (and (not (= chat "bot-dm")) (= private (= (nativeGet body "chat_type") "p2p_chat")))))
                            (let ((projected (if bot (funcall project-message message bot) (nativeGet message "message_id"))))
                              (when projected (js-call selected :push projected))))))))
                    (Response/json (js-object :code 0 :data (js-object :items selected :has_more false))))
                  ;; User document-notice setup is unrelated to IM collection.
                  (t (Response/json (js-object :code 99991663))))))))
            (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort user ports))
            (let ((bot (js-call (nativeGet config "connections") :find (lambda (c) (= (nativeGet c "connection_id") "lark-bot")))))
              (js-call (nativeGet ports "im_ports") :set "lark-bot" (createLarkEventPort bot ports)))))))))
        (put state :root (nativeGet f "root"))
        (put f :original_socket original) (put f :messages messages) (put f :marks marks)
        (put f :wire_sockets sockets) (put f :hybrid_state state) (put f :native_calls calls) (put f :replies replies)
        (await (advance f 2)) f
        (catch error
          (when f (await (closeFixture f)))
          (put NativeGlobal :WebSocket original) (throw error)))))
  (defasync restartNative (f)
    (let ((stopped false) (i 0))
      (while (and (not stopped) (< i 16))
        (let ((result (await (js-call (nativeGet f "core") :stop "fixture_native_restart"
          (+ (js-call (nativeGet f "clock") :monoNow) 1000)))))
          (setq stopped (= (nativeGet (nativeGet result "data") "state") "stopped")))
        (unless stopped (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
          (js-call (nativeGet f "clock") :advance 1000))
        (setq i (1+ i)))
      (js-call (expect stopped) :toBe t))
    (js-call (nativeGet (nativeGet f "config") "connections") :forEach (lambda (connection)
      (when (= (nativeGet connection "platform") "lark")
        (js-call (nativeGet (nativeGet f "ports") "im_ports") :set (nativeGet connection "connection_id")
          (createLarkEventPort connection (nativeGet f "ports"))))))
    (await (js-call f :restart)))
  (defasync cleanup (f)
    (when f (try (await (closeFixture f))
      (finally (put NativeGlobal :WebSocket (nativeGet f "original_socket"))))))
  (defun emit (f app id)
    (let* ((bot (= app "cli_bot"))
      (message (js-call (nativeGet f "messages") :get id))
      (map-id (nativeGet (nativeGet f "hybrid_state") "app_open_id"))
      (sender (nativeGet message "sender"))
      (sender-id (if (and map-id (= (nativeGet sender "sender_type") "user"))
                   (funcall map-id (nativeGet sender "id") bot)
                   (nativeGet sender "id")))
      (wire (js-object :header (js-object :event_id (str app ":" id) :event_type "im.message.receive_v1" :app_id app)
        :event (js-object :sender (js-object :sender_id (js-object :open_id sender-id)
          :sender_type (if (= (nativeGet sender "sender_type") "user") "user" "app"))
          :message (Object/assign (js-object) message (js-object :message_type "text" :chat_type
            (if (= (nativeGet message "chat_id") "c1") "group" "p2p")
            :content (nativeGet (nativeGet message "body") "content")
            :mentions (js-call (nativeGet message "mentions") :map (lambda (m)
              (let ((mention (js-object :id (js-object :open_id
                      (if map-id (funcall map-id (nativeGet m "id") bot) (nativeGet m "id"))))))
                (when (nativeGet m "key") (put mention :key (nativeGet m "key")))
                mention))))))))
      (bytes (encodeLarkFrame (js-object :seq 1 :service 1 :method 1
        :headers (js-array (js-object :key "type" :value "event") (js-object :key "message_id" :value (str app ":" id)))
        :payload (Buffer/from (JSON/stringify wire) "utf8")))))
      (js-call (js-call (nativeGet f "wire_sockets") :get app) :dispatchEvent
        (new globalThis.MessageEvent "message" (js-object :data bytes)))))

  (withCase "T41.lark-edited-mentions.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (clock (nativeGet f "clock"))
           (state (nativeGet f "hybrid_state"))
           (messages (nativeGet f "messages")) (inputs (nativeGet (nativeGet f "opencode") "inputs"))
           (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
           (sub nil) (filter nil)
           (timestamp (lambda () (str (Date/parse (js-call clock :utcNow)))))
           (edit (lambda (id text mentions)
             (let ((message (js-call messages :get id)))
               (put message :body (js-object :content (JSON/stringify (js-object :text text))))
               (put message :updated t) (put message :update_time (funcall timestamp))
               (put message :mentions (js-call mentions :map (lambda (person index)
                 (js-object :key (str "@_user_" (1+ index)) :id person :id_type "open_id"))))))))
      (try
        (put state :app_open_id (lambda (id bot)
          (cond
            ((= id "ou_self") (if bot "ou_self_in_bot_app" "ou_self"))
            ((= id "ou_bot") (if bot "ou_bot" "ou_bot_in_user_app"))
            ((= id "ou_other") (if bot "ou_other_in_bot_app" "ou_other"))
            ((= id "ou_blocked") (if bot "ou_blocked_in_bot_app" "ou_blocked"))
            ((= id "ou_sample_blocked") (if bot "ou_sample_blocked_in_bot_app" "ou_sample_blocked"))
            (t id))))
        (let ((p (await (callOk f "A" "subscription.preview" (js-object
                   :expected_revision 0 :spec (js-object :agent_id (nativeGet agent "agent_id")))))))
          (setq sub (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet p "preview_id")
            :expected_revision 0 :idempotency_key "edit-subscribe")))))
        (let ((p (await (callOk f "O" "message.filter.get" (js-object)))))
          (setq filter (await (callOk f "O" "message.filter.update" (js-object :expected_revision (nativeGet p "revision")
            :idempotency_key "edit-filter" :rules (js-array (js-object :id "blocked-author" :enabled t
              :effect "suppress_trigger" :predicate (js-object :field "sender.id" :op "in"
                :value (js-array "ou_blocked" "ou_blocked_in_bot_app")))))))))
        (js-call messages :set "before-activation" (js-object :message_id "before-activation" :chat_id "c1"
          :create_time (str (- (Date/parse (funcall timestamp)) 10000))
          :msg_type "text" :body (js-object :content "{\"text\":\"before activation\"}")
          :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array)))
        (emit f "cli_user" "before-activation") (emit f "cli_bot" "before-activation")
        (js-call (js-array "new-at" "both-at" "blocked-at" "denied-at" "late-at") :forEach (lambda (id)
          (js-call messages :set id (js-object :message_id id :chat_id "c1" :create_time (funcall timestamp)
            :msg_type "text" :body (js-object :content "{\"text\":\"@Name rendered as plain text\"}")
            :sender (js-object :id (if (= id "blocked-at") "ou_blocked" "ou_other") :id_type "open_id" :sender_type "user")
            :mentions (js-array)))
          (emit f "cli_user" id) (unless (= id "late-at") (emit f "cli_bot" id))))
        (put state :edit_denied_id "denied-at")
        (await (advance f 5))
        (js-call (expect (js-length inputs)) :toBe 0)
        (funcall edit "before-activation" "edited a historical message" (js-array "ou_self"))
        (funcall edit "new-at" "added a native user mention" (js-array "ou_self"))
        (funcall edit "both-at" "added both mentions" (js-array "ou_self" "ou_bot"))
        (funcall edit "blocked-at" "blocked sender added a mention" (js-array "ou_self" "ou_bot"))
        (funcall edit "denied-at" "API refuses this message" (js-array "ou_self"))
        (funcall edit "late-at" "second connection first sees this edit" (js-array "ou_self" "ou_bot"))
        (put state :enabled t)
        (await (advance f 35))
        (js-call (expect (js-length inputs)) :toBe 3)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT count(*) AS n FROM events WHERE event_kind='message.edited'") :get) "n")) :toBe 7)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT count(*) AS n FROM events WHERE native_message_id='late-at' AND event_kind='message.created' AND json_extract(payload,'$.native_message_update_time') IS NOT NULL") :get) "n")) :toBe 1)
        (js-call (expect (js-length (js-call inputs :filter (lambda (input)
          (= (nativeGet (nativeGet (nativeGet input "envelope") "source") "native_message_id") "late-at"))))) :toBe 1)
        (let* ((both (js-call inputs :find (lambda (input)
                 (= (nativeGet (nativeGet (nativeGet input "envelope") "source") "native_message_id") "both-at"))))
               (both-env (nativeGet both "envelope"))
               (both-reply (await (js-call f :call (nativeGet f "A") "message.reply_context"
                 (js-object :delivery_id (nativeGet both-env "delivery_id"))))))
          (js-call (expect (js-call (js-array "ambiguous_target" "unmapped_target") :includes
            (nativeGet (nativeGet both-env "reply_route") "status"))) :toBe t)
          (js-call (expect (nativeGet both-env "reply_context_id")) :toBe nil)
          (js-call (expect (nativeGet both-reply "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet both-reply "error") "code")) :toBe "reply_identity_unresolved")
          (js-call (expect (nativeGet (nativeGet (nativeGet both-reply "error") "details") "reason")) :toBe "ambiguous_target"))
        (let* ((only-user (js-call inputs :find (lambda (input)
          (= (nativeGet (nativeGet (nativeGet input "envelope") "source") "native_message_id") "new-at"))))
          (envelope (nativeGet only-user "envelope")))
          (js-call (expect (nativeGet (nativeGet envelope "reply_route") "connection_id")) :toBe "lark")
          (js-call (expect (nativeGet envelope "reply_context_id")) :toBeTruthy)
          (js-call (expect (js-call (nativeGet envelope "trigger_reasons") :some
            (lambda (r) (= (nativeGet r "code") "edit_mention")))) :toBe t))
        (funcall edit "new-at" "modified wording only" (js-array "ou_self"))
        (await (advance f 22))
        (js-call (expect (js-length inputs)) :toBe 3)
        (funcall edit "new-at" "removed the mention" (js-array))
        (await (advance f 22))
        (js-call (expect (js-length inputs)) :toBe 3)
        (funcall edit "new-at" "added the native mention again" (js-array "ou_self"))
        (await (advance f 24))
        (js-call (expect (js-length inputs)) :toBe 4)
        (let* ((last (aref inputs 3))
               (event-id (nativeGet (nativeGet last "envelope") "event_id"))
               (view (await (callOk f "A" "message.context" (js-object :event_id event-id :before 10)))))
          (js-call (expect (nativeGet (nativeGet (nativeGet view "anchor") "content") "text"))
            :toBe "added the native mention again")
          (js-call (expect (js-call (nativeGet view "messages") :some (lambda (item)
            (= (nativeGet item "native_message_id") "new-at")))) :toBe false))
        (await (restartNative f))
        (await (advance f 20))
        (js-call (expect (js-length inputs)) :toBe 4)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT count(*) AS n FROM events WHERE event_kind='message.edited'") :get) "n")) :toBe 13)
        (put state :edit_denied_id "")
        (await (advance f 20))
        (js-call (expect (js-length inputs)) :toBe 5)
        (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 4) "envelope") "source") "native_message_id")) :toBe "denied-at")
        ;; 1) Existing @Bot message later edited to @Bot @User turns ambiguous and preserves initial bot binding.
        (js-call messages :set "bot-then-both" (js-object :message_id "bot-then-both" :chat_id "c1"
          :create_time (funcall timestamp) :msg_type "text"
          :body (js-object :content "{\"text\":\"@Bot initial\"}")
          :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user")
          :mentions (js-array (js-object :key "@_user_1" :id "ou_bot" :id_type "open_id"))))
        (emit f "cli_user" "bot-then-both") (emit f "cli_bot" "bot-then-both")
        (await (advance f 6))
        (js-call (expect (js-length inputs)) :toBe 6)
        (let* ((first-bot (nativeGet (aref inputs 5) "envelope"))
               (ctx-id (nativeGet (nativeGet first-bot "dispatch_context") "context_id")))
          (js-call (expect (nativeGet (nativeGet first-bot "reply_route") "connection_id")) :toBe "lark-bot")
          (js-call (expect (nativeGet first-bot "reply_context_id")) :toBeTruthy)
          (funcall edit "bot-then-both" "@Bot @User added user mention" (js-array "ou_bot" "ou_self"))
          (await (advance f 20))
          (js-call (expect (js-length inputs)) :toBe 7)
          (let* ((second-both (nativeGet (aref inputs 6) "envelope"))
                 (second-reply (await (js-call f :call (nativeGet f "A") "message.reply_context"
                   (js-object :delivery_id (nativeGet second-both "delivery_id")))))
                 (ctx-row (JSON/parse (nativeGet (js-call (js-call db :query
                   "SELECT payload FROM dispatch_contexts WHERE context_id=?") :get ctx-id) "payload")))
                 (bound (JSON/parse (nativeGet (js-call (js-call db :query
                   "SELECT payload FROM dispatch_bindings WHERE binding_id=?")
                   :get (nativeGet ctx-row "binding_id")) "payload"))))
            (js-call (expect (nativeGet (nativeGet second-both "source") "native_message_id")) :toBe "bot-then-both")
            (js-call (expect (js-call (js-array "ambiguous_target" "unmapped_target") :includes
              (nativeGet (nativeGet second-both "reply_route") "status"))) :toBe t)
            (js-call (expect (nativeGet second-both "reply_context_id")) :toBe nil)
            (js-call (expect (nativeGet second-reply "ok")) :toBe false)
            (js-call (expect (nativeGet (nativeGet second-reply "error") "code")) :toBe "reply_identity_unresolved")
            (js-call (expect (nativeGet (nativeGet (nativeGet second-reply "error") "details") "reason")) :toBe "ambiguous_target")
            (js-call (expect (nativeGet bound "connection_id")) :toBe "lark-bot")))
        ;; 2) Wording-only edit on a reply to bot must not re-trigger default subscription.
        (js-call messages :set "reply-parent" (js-object :message_id "reply-parent" :chat_id "c1"
          :create_time (funcall timestamp) :msg_type "text"
          :body (js-object :content "{\"text\":\"bot original message\"}")
          :sender (js-object :id "cli_bot" :id_type "app_id" :sender_type "app") :mentions (js-array)))
        (emit f "cli_user" "reply-parent") (emit f "cli_bot" "reply-parent")
        (await (advance f 4))
        (js-call (expect (js-length inputs)) :toBe 7)
        (js-call messages :set "reply-edit-only" (js-object :message_id "reply-edit-only" :chat_id "c1"
          :create_time (funcall timestamp) :msg_type "text"
          :parent_id "reply-parent" :root_id "reply-parent"
          :body (js-object :content "{\"text\":\"reply initial wording\"}")
          :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array)))
        (emit f "cli_user" "reply-edit-only") (emit f "cli_bot" "reply-edit-only")
        (await (advance f 5))
        (js-call (expect (js-length inputs)) :toBe 8)
        (funcall edit "reply-edit-only" "reply edited wording only" (js-array))
        (await (advance f 20))
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM events WHERE native_message_id='reply-edit-only' AND event_kind='message.edited'") :get) "n")) :toBe 2)
        (js-call (expect (js-length inputs)) :toBe 8)
        ;; 3) >20 recent messages: newest edit is scanned in the first newest-first batch.
        (let ((si 1))
          (while (<= si 22)
            (let ((sid (str "sweep-" (js-call (str si) :padStart 2 "0"))))
              (js-call messages :set sid (js-object :message_id sid :chat_id "c1"
                :create_time (funcall timestamp) :msg_type "text"
                :body (js-object :content (JSON/stringify (js-object :text sid)))
                :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array)))
              (emit f "cli_user" sid) (emit f "cli_bot" sid)
              (await (advance f 1)))
            (setq si (1+ si))))
        (js-call messages :set "sweep-newest" (js-object :message_id "sweep-newest" :chat_id "c1"
          :create_time (funcall timestamp) :msg_type "text"
          :body (js-object :content "{\"text\":\"sweep newest\"}")
          :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array)))
        (emit f "cli_user" "sweep-newest") (emit f "cli_bot" "sweep-newest")
        (await (advance f 3))
        (let ((before-mget (js-length (nativeGet f "native_calls"))))
          (funcall edit "sweep-newest" "sweep newest now mentions user" (js-array "ou_self"))
          (await (advance f 22))
          (js-call (expect (js-length inputs)) :toBe 9)
          (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 8) "envelope") "source") "native_message_id")) :toBe "sweep-newest")
          (let* ((new-calls (js-call (nativeGet f "native_calls") :slice before-mget))
                 (first-sweep-mget (js-call new-calls :find (lambda (c)
                   (and (= (nativeGet c "path") "/open-apis/im/v1/messages/mget")
                        (js-call (nativeGet c "query_ids" (js-array)) :some (lambda (qid) (js-call qid :startsWith "sweep-"))))))))
            (js-call (expect first-sweep-mget) :toBeTruthy)
            (js-call (expect (js-call (nativeGet first-sweep-mget "query_ids") :includes "sweep-newest")) :toBe t)))
        ;; 4) Weak-view-first notification arrives with reply_context_id:null; after peer edit coalesces,
        ;; message.reply_context recovers reply_context_id and replies via bot.
        (let* ((extra-rule (js-object :id "user-sees-bot-edit" :enabled t
                 :event_kinds (js-array "message.edited")
                 :predicate (js-object :all (js-array
                   (js-object :field "connection_id" :op "eq" :value "lark")
                   (js-object :field "mentions.id" :op "eq" :value "ou_bot_in_user_app")))))
               (rules (js-call (nativeGet sub "rules") :concat (js-array extra-rule)))
               (p (await (callOk f "A" "subscription.preview" (js-object
                 :expected_revision (nativeGet sub "revision")
                 :spec (js-object :agent_id (nativeGet agent "agent_id") :rules rules))))))
          (setq sub (await (callOk f "A" "subscription.set" (js-object
            :preview_id (nativeGet p "preview_id")
            :expected_revision (nativeGet sub "revision")
            :idempotency_key "edit-weak-sub")))))
        (let ((weak-initial (js-object :message_id "weak-first" :chat_id "c1" :create_time (funcall timestamp)
                :msg_type "text" :body (js-object :content "{\"text\":\"before bot edit\"}")
                :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array))))
          (js-call messages :set "weak-first" weak-initial)
          (emit f "cli_user" "weak-first") (emit f "cli_bot" "weak-first")
          (await (advance f 4))
          (js-call (nativeGet state "bot_lag_ids") :set "weak-first" (JSON/parse (JSON/stringify weak-initial)))
          (funcall edit "weak-first" "user sees @Bot first" (js-array "ou_bot"))
          (await (advance f 20))
          (js-call (expect (js-length inputs)) :toBe 10)
          (let* ((weak-env (nativeGet (aref inputs 9) "envelope"))
                 (weak-did (nativeGet weak-env "delivery_id")))
            (js-call (expect (nativeGet (nativeGet weak-env "source") "native_message_id")) :toBe "weak-first")
            (js-call (expect (nativeGet (nativeGet weak-env "reply_route") "status")) :toBe "unmapped_target")
            (js-call (expect (nativeGet weak-env "reply_context_id")) :toBe nil)
            (let ((unresolved (await (js-call f :call (nativeGet f "A") "message.reply_context"
                    (js-object :delivery_id weak-did)))))
              (js-call (expect (nativeGet unresolved "ok")) :toBe false)
              (js-call (expect (nativeGet (nativeGet unresolved "error") "code")) :toBe "reply_identity_unresolved")
              (js-call (expect (nativeGet (nativeGet (nativeGet unresolved "error") "details") "reason")) :toBe "unmapped_target"))
            (js-call (nativeGet state "bot_lag_ids") :delete "weak-first")
            (await (advance f 20))
            (js-call (expect (js-length inputs)) :toBe 10)
            (let* ((recovered (await (callOk f "A" "message.reply_context" (js-object :delivery_id weak-did))))
                   (reply-ref (nativeGet recovered "reply_context_id")))
              (js-call (expect reply-ref) :toBeTruthy)
              (js-call (expect (nativeGet recovered "allowed_actions")) :toEqual (js-array "reply"))
              (await (callOk f "A" "message.reply" (js-object
                :reply_context_id reply-ref
                :content (js-object :type "text" :text "weak view recovered")
                :idempotency_key "weak-first-reply")))
              (await (advance f 4 20))
              (let ((sent (js-call (nativeGet f "replies") :find (lambda (r) (= (nativeGet r "message_id") "weak-first")))))
                (js-call (expect sent) :toBeTruthy)
                (js-call (expect (nativeGet sent "key")) :toBe "bot")))))
        ;; 5) Sanitized user-HTTP-only missed-capture sample with scoped sender.person_id blacklist before/after control.
        (let ((sample-people (js-array (js-object :id "person_blocked_sample"
                :identities (js-array (js-object :platform "lark" :scope "app:cli_user:open_id" :id "ou_sample_blocked")))))
              (blocked-author-rule (js-object :id "blocked-author" :enabled t
                :effect "suppress_trigger" :predicate (js-object :field "sender.id" :op "in"
                  :value (js-array "ou_blocked" "ou_blocked_in_bot_app"))))
              (sample-rule (js-object :id "sample-blocked-author" :enabled t
                :effect "suppress_trigger" :predicate (js-object :field "sender.person_id" :op "eq"
                  :value "person_blocked_sample"))))
          (setq filter (await (callOk f "O" "message.filter.update" (js-object
            :expected_revision (nativeGet filter "revision")
            :idempotency_key "sample-blacklist-on"
            :people sample-people
            :rules (js-array blocked-author-rule sample-rule)))))
          (js-call (nativeGet state "user_only_ids") :add "sample-blocked-edit")
          (js-call messages :set "sample-blocked-edit" (js-object :message_id "sample-blocked-edit" :chat_id "c1"
            :create_time (funcall timestamp) :msg_type "text"
            :body (js-object :content "{\"text\":\"plain group message\"}")
            :sender (js-object :id "ou_sample_blocked" :id_type "open_id" :sender_type "user")
            :mentions (js-array)))
          (await (advance f 10))
          (let ((created-row (js-call (js-call db :query
                  "SELECT e.event_id,e.payload,m.result FROM events e JOIN match_decisions m ON m.event_id=e.event_id WHERE e.native_message_id='sample-blocked-edit' AND e.event_kind='message.created' LIMIT 1") :get)))
            (js-call (expect created-row) :toBeTruthy)
            (js-call (expect (nativeGet (JSON/parse (nativeGet created-row "payload")) "receive_transport")) :toBe "poll")
            (js-call (expect (nativeGet created-row "result")) :toBe "no_match"))
          (js-call (expect (js-length inputs)) :toBe 10)
          (js-call (expect (js-call (nativeGet f "marks") :has "user:sample-blocked-edit")) :toBe false)
          (funcall edit "sample-blocked-edit" "edited with @self" (js-array "ou_self"))
          (await (advance f 22 20))
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM events WHERE connection_id='lark' AND native_message_id='sample-blocked-edit'") :get) "n")) :toBe 2)
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM events WHERE native_message_id='sample-blocked-edit' AND event_kind='message.edited'") :get) "n")) :toBe 1)
          (js-call (expect (js-length inputs)) :toBe 10)
          (js-call (expect (js-call (nativeGet f "marks") :has "user:sample-blocked-edit")) :toBe false)
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM work_marks WHERE json_extract(payload,'$.native_message_id')='sample-blocked-edit'") :get) "n")) :toBe 0)
          ;; Control: same user-HTTP-only path with blacklist disabled delivers once & marks Typing.
          (put sample-rule :enabled false)
          (setq filter (await (callOk f "O" "message.filter.update" (js-object
            :expected_revision (nativeGet filter "revision")
            :idempotency_key "sample-blacklist-off"
            :people sample-people
            :rules (js-array blocked-author-rule sample-rule)))))
          (js-call (nativeGet state "user_only_ids") :add "sample-control-edit")
          (js-call messages :set "sample-control-edit" (js-object :message_id "sample-control-edit" :chat_id "c1"
            :create_time (funcall timestamp) :msg_type "text"
            :body (js-object :content "{\"text\":\"plain control message\"}")
            :sender (js-object :id "ou_sample_blocked" :id_type "open_id" :sender_type "user")
            :mentions (js-array)))
          (await (advance f 10))
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT m.result FROM events e JOIN match_decisions m ON m.event_id=e.event_id WHERE e.native_message_id='sample-control-edit' AND e.event_kind='message.created' LIMIT 1") :get) "result")) :toBe "no_match")
          (js-call (expect (js-length inputs)) :toBe 10)
          (funcall edit "sample-control-edit" "control edited with @self" (js-array "ou_self"))
          (await (advance f 22 20))
          (js-call (expect (js-length inputs)) :toBe 11)
          (let ((ctrl-env (nativeGet (aref inputs 10) "envelope")))
            (js-call (expect (nativeGet (nativeGet ctrl-env "source") "native_message_id")) :toBe "sample-control-edit")
            (js-call (expect (nativeGet (nativeGet ctrl-env "reply_route") "connection_id")) :toBe "lark")
            (js-call (expect (nativeGet ctrl-env "reply_context_id")) :toBeTruthy)
            (js-call (expect (js-call (nativeGet ctrl-env "trigger_reasons") :some
              (lambda (r) (= (nativeGet r "code") "edit_mention")))) :toBe t)
            (js-call (expect (js-call (nativeGet f "marks") :has "user:sample-control-edit")) :toBe t)
            (js-call (expect (nativeGet (js-call (js-call db :query
              "SELECT COUNT(*) AS n FROM work_marks WHERE json_extract(payload,'$.native_message_id')='sample-control-edit'") :get) "n")) :toBe 1)))
        (finally (js-call db :close))))) cleanup)

  (withCase "T41.hybrid-inbox-flow.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (state (nativeGet f "hybrid_state"))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (inputs (nativeGet (nativeGet f "opencode") "inputs")))
      (try
        (let ((preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object
          :agent_id (nativeGet agent "agent_id")
          :rules (js-array (js-object :id "default" :enabled t
            :event_kinds (js-array "message.created")
            :predicate (js-object :any (js-array (js-object :field "addressed_self" :op "eq" :value t)
              (js-object :field "chat_type" :op "eq" :value "p2p")))))))))))
          (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "hybrid-subscribe"))))
        (let ((policy (await (callOk f "O" "message.filter.get" (js-object)))))
          (await (callOk f "O" "message.filter.update" (js-object :expected_revision (nativeGet policy "revision")
            :idempotency_key "hybrid-filter" :rules (js-array (js-object :id "blocked-author" :enabled t
              :effect "suppress_trigger" :predicate (js-object :field "sender.id" :op "eq" :value "ou_blocked")))))))
        (js-call (js-array
          (js-array "shared" "c1" "ou_other" "user" t)
          (js-array "user-private" "user-dm" "cli_other_bot" "app" false)
          (js-array "bot-private" "bot-dm" "ou_other" "user" false)
          (js-array "unmentioned" "c1" "cli_other_bot" "app" false)
          (js-array "blocked" "c1" "ou_blocked" "user" t)) :forEach (lambda (item)
            (let ((id (aref item 0)))
              (js-call (nativeGet f "messages") :set id (js-object :message_id id :chat_id (aref item 1)
                :create_time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))) :msg_type "text"
                :body (js-object :content (JSON/stringify (js-object :text (str id "\nsecond line"))))
                :sender (js-object :id (aref item 2) :id_type "open_id" :sender_type (aref item 3))
                :mentions (if (aref item 4) (js-array (js-object :id "ou_self" :id_type "open_id")
                  (js-object :id "ou_bot" :id_type "open_id")) (js-array))
                :thread_id (when (= id "shared") "thread-one")
                :root_id (when (= id "shared") "root-one") :parent_id (when (= id "shared") "parent-one"))))))
        ;; Same message: WS first on bot, HTTP first on user. No direct Core.ingest.
        ;; Under 0031, both views of "shared" are stored in events while coalescing into one notification.
        (emit f "cli_bot" "shared") (emit f "cli_bot" "bot-private")
        (await (advance f 3)) (put state :enabled t)
        (await (advance f 55))
        (js-call (expect (js-length inputs)) :toBe 3)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM deliveries WHERE state='coalesced'") :get) "n")) :toBe 1)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM events") :get) "n")) :toBe 8)
        (js-call (expect (js-call (js-call db :query
          "SELECT connection_id,source_key FROM events GROUP BY connection_id,source_key HAVING COUNT(*)>1") :all)) :toEqual (js-array))
        (let ((rows (js-call (js-call db :query "SELECT connection_id,native_message_id,payload FROM events") :all)))
          (js-call rows :forEach (lambda (row)
            (let* ((event (JSON/parse (nativeGet row "payload"))) (id (nativeGet row "native_message_id"))
              (ws (and (= (nativeGet row "connection_id") "lark-bot") (js-call (js-array "shared" "bot-private") :includes id))))
              (js-call (expect (nativeGet event "receive_transport")) :toBe (if ws "websocket" "poll"))
              (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe (str id "\nsecond line"))
              (when (= id "shared")
                (js-call (expect (nativeGet (nativeGet event "conversation") "native_thread_id")) :toBe "thread-one")
                (js-call (expect (nativeGet (nativeGet event "reply_to") "id")) :toBe "parent-one"))))))
        ;; The shared fixture explicitly @s two distinct configured identities.
        ;; Notifications arrive, but no arbitrary reply/Working identity is chosen.
        (js-call inputs :forEach (lambda (input)
          (let ((envelope (nativeGet input "envelope")))
            (when (= (nativeGet (nativeGet envelope "source") "native_message_id") "shared")
              (js-call (expect (js-call (js-array "ambiguous_target" "unmapped_target") :includes (nativeGet (nativeGet envelope "reply_route") "status"))) :toBe t)
              (js-call (expect (nativeGet envelope "reply_context_id")) :toBe nil)))))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 2)
        ;; Late WebSocket duplicates and repeated HTTP windows never create more work.
        (emit f "cli_user" "shared") (emit f "cli_user" "user-private")
        (emit f "cli_bot" "shared") (await (advance f 12))
        (js-call (expect (nativeGet state "acks")) :toBe 5)
        (js-call (expect (js-length inputs)) :toBe 3)
        (let ((i 0))
          (while (< i (js-length inputs))
            (let* ((envelope (nativeGet (aref inputs i) "envelope"))
              (source (nativeGet envelope "source")) (message (nativeGet source "native_message_id")))
              (if (= message "user-private")
                (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
                  :content (js-object :type "text" :text "completed") :idempotency_key "hybrid-reply")))
                (await (callOk f "A" "delivery.complete" (js-object :delivery_id (nativeGet envelope "delivery_id")
                  :reason "no_reply" :idempotency_key (str "hybrid-complete-" i))))))
            (setq i (1+ i))))
        ;; GET reaction readbacks now share the real transport budget; let its
        ;; short native wait timers run as well as advancing the injected clock.
        (await (advance f 12 30))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (js-length (nativeGet f "replies"))) :toBe 1)
        (js-call (expect (nativeGet (aref (nativeGet f "replies") 0) "key")) :toBe "user")
        (js-call (expect (nativeGet (aref (nativeGet f "replies") 0) "message_id")) :toBe "user-private")
        (js-call inputs :forEach (lambda (item)
          (js-call (expect (js-call (js-array "blocked" "unmentioned") :includes
            (nativeGet (nativeGet (nativeGet item "envelope") "source") "native_message_id"))) :toBe false)))
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM work_items WHERE state='completed'") :get) "n")) :toBe 2)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM work_marks WHERE state='done'") :get) "n")) :toBe 2)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM outbound WHERE state='accepted'") :get) "n")) :toBe 1)
        ;; Four hours offline must not require 240 one-minute polling windows.
        (let ((before (Date/parse (js-call (nativeGet f "clock") :utcNow))))
          (js-call (js-array 5400000 10800000 14390000) :forEach (lambda (offset)
            (let ((id (str "offline-" offset)))
              (js-call (nativeGet f "messages") :set id (js-object :message_id id :chat_id "c1"
                :create_time (str (+ before offset)) :msg_type "text"
                :body (js-object :content (JSON/stringify (js-object :text id)))
                :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user")
                :mentions (js-array (js-object :id "ou_self" :id_type "open_id")
                  (js-object :id "ou_bot" :id_type "open_id")))))))
          (js-call (nativeGet f "clock") :advance 14400000)
          (let* ((connections (nativeGet (await (callOk f "O" "connection.list" (js-object))) "items"))
            (user (js-call connections :find (lambda (row) (= (nativeGet row "connection_id") "lark")))))
            (js-call (expect (nativeGet (nativeGet user "source_health") "state")) :toBe "catching_up"))
          (await (advance f 80))
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM events WHERE native_message_id LIKE 'offline-%'") :get) "n")) :toBe 6)
          (let* ((connections (nativeGet (await (callOk f "O" "connection.list" (js-object))) "items"))
            (user (js-call connections :find (lambda (row) (= (nativeGet row "connection_id") "lark")))))
            (js-call (expect (nativeGet (nativeGet user "source_health") "lag_seconds")) :toBeLessThan 15)
            (js-call (expect (nativeGet (nativeGet user "source_health") "state")) :toBe "online")
            (js-call (expect (nativeGet (nativeGet user "source_health") "ready")) :toBe t))
          (await (restartNative f))
          (await (advance f 20))
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM events WHERE native_message_id LIKE 'offline-%'") :get) "n")) :toBe 6))
        (finally (js-call db :close))))) cleanup)
  (withCase "T41.hybrid-inbox-forward-resume.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (state (nativeGet f "hybrid_state"))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (inputs (nativeGet (nativeGet f "opencode") "inputs")) (subscription nil))
      (try
        (let ((preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object
          :agent_id (nativeGet agent "agent_id")
          :rules (js-array (js-object :id "default" :enabled t
            :event_kinds (js-array "message.reaction.added")
            :predicate (js-object :all (js-array
              (js-object :field "connection_id" :op "eq" :value "lark")
              (js-object :field "reaction.emoji_type" :op "eq" :value "Pin")))))))))))
          (setq subscription (await (callOk f "A" "subscription.set"
            (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "forward-pin-create")))))
        (setq subscription (await (callOk f "A" "subscription.pause" (js-object
          :agent_id (nativeGet subscription "agent_id") :expected_revision (nativeGet subscription "revision")
          :idempotency_key "forward-pin-pause"))))
        (let* ((stamp (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))
          (message (lambda (id chat) (js-object :message_id id :chat_id chat :create_time stamp :msg_type "text"
            :body (js-object :content (JSON/stringify (js-object :text id)))
            :sender (js-object :id "ou_other" :id_type "open_id" :sender_type "user") :mentions (js-array)))))
          (let ((wrapper (funcall message "merged-wrapper" "c1")))
            (put wrapper :msg_type "merge_forward")
            (js-call (nativeGet f "messages") :set "merged-wrapper" wrapper))
          (js-call (nativeGet f "messages") :set "after-forward" (funcall message "after-forward" "c1"))
          (put state :embedded (js-object :merged-wrapper
            (js-array (Object/assign (funcall message "embedded-only" "different-chat")
              (js-object :upper_message_id "merged-wrapper"))))))
        (put state :enabled t)
        (await (advance f 35))
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM events WHERE connection_id='lark' AND native_message_id IN ('merged-wrapper','after-forward')") :get) "n")) :toBe 2)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM events WHERE native_message_id='embedded-only'") :get) "n")) :toBe 0)
        (js-call (expect (js-length inputs)) :toBe 0)
        (setq subscription (await (callOk f "A" "subscription.resume" (js-object
          :agent_id (nativeGet subscription "agent_id") :expected_revision (nativeGet subscription "revision")
          :idempotency_key "forward-pin-resume"))))
        (js-call (nativeGet f "marks") :set "user:after-forward" (js-object :reaction_id "new-pin"
          :reaction_type (js-object :emoji_type "Pin")
          :operator (js-object :operator_type "user" :operator_id "ou_self")
          :action_time (str (Date/parse (js-call (nativeGet f "clock") :utcNow)))))
        (await (advance f 35))
        (js-call (expect (js-length inputs)) :toBe 1)
        (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 0) "envelope") "source") "native_message_id")) :toBe "after-forward")
        (let ((probe (await (callOk f "O" "connection.probe" (js-object :connection_id "lark")))))
          (js-call (expect (nativeGet (nativeGet probe "source_health") "ready")) :toBe t))
        (await (restartNative f)) (await (advance f 10))
        (js-call (expect (js-length inputs)) :toBe 1)
        (finally (js-call db :close))))) cleanup)

  (withCase "T41.chat-pins.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (state (nativeGet f "hybrid_state"))
      (clock (nativeGet f "clock")) (messages (nativeGet f "messages"))
      (inputs (nativeGet (nativeGet f "opencode") "inputs"))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (pin (lambda (message actor type stamp) (js-object :chat_id "c1" :message_id message
        :operator_id actor :operator_id_type type :create_time (str stamp))))
      (stamp (lambda () (Date/parse (js-call clock :utcNow)))))
      (try
        (let ((ticket (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec
          (js-object :agent_id (nativeGet agent "agent_id")
            :rules (js-array (js-object :id "default" :enabled t
              :event_kinds (js-array "message.pinned")
              :predicate (js-object :all (js-array))))))))))
          (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet ticket "preview_id") :expected_revision 0 :idempotency_key "chat-pins-sub"))))
        (let ((policy (await (callOk f "O" "message.filter.get" (js-object)))))
          (await (callOk f "O" "message.filter.update" (js-object :expected_revision (nativeGet policy "revision")
            :idempotency_key "chat-pins-robots" :rules (js-array (js-object :id "robots" :enabled t :effect "suppress_trigger"
              :predicate (js-object :field "trigger.kind" :op "eq" :value "bot")))))))
        (js-call (js-array "pin-seed" "pinned-old" "pinned-another") :forEach (lambda (id)
          (js-call messages :set id (js-object :message_id id :chat_id "c1" :msg_type "text"
            :create_time (str (- (funcall stamp) 86400000))
            :sender (js-object :id "cli_author_bot" :id_type "app_id" :sender_type "app")
            :mentions (js-array (js-object :id "ou_self" :id_type "open_id") (js-object :id "ou_bot" :id_type "open_id"))
            :body (js-object :content (JSON/stringify (js-object :text (str "old marked body " id))))))))
        ;; A current native message discovers the group, but is not a Pin.
        (put (js-call messages :get "pin-seed") :create_time (str (funcall stamp)))
        (emit f "cli_user" "pin-seed") (emit f "cli_bot" "pin-seed")
        (put (nativeGet state "pins") :user (js-array (funcall pin "pinned-old" "ou_self" "open_id" 1)))
        (put (nativeGet state "pins") :bot (js-array (funcall pin "pinned-old" "ou_other" "open_id" 1)))
        (await (advance f 10)) (js-call (expect (js-length inputs)) :toBe 0)
        (put state :pin_paginate t)
        (put (nativeGet state "pins") :user (js-array (funcall pin "pinned-old" "ou_self" "open_id" (funcall stamp))
          (funcall pin "pinned-another" "ou_self" "open_id" (funcall stamp))))
        (put (nativeGet state "pins") :bot (js-array (funcall pin "pinned-old" "ou_other" "open_id" (funcall stamp))
          (funcall pin "pinned-another" "ou_other" "open_id" (funcall stamp))))
        (await (advance f 22)) (js-call (expect (js-length inputs)) :toBe 4)
        (js-call inputs :forEach (lambda (input)
          (let* ((envelope (nativeGet input "envelope")) (source (nativeGet envelope "source"))
            (readback (JSON/parse (nativeGet (js-call (js-call db :query "SELECT payload FROM events WHERE event_id=?")
              :get (nativeGet envelope "event_id")) "payload"))))
            (js-call (expect (nativeGet readback "event_kind")) :toBe "message.pinned")
            (js-call (expect (nativeGet readback "receive_transport")) :toBe "poll")
            (js-call (expect (nativeGet (nativeGet envelope "sender") "kind")) :toBe "bot")
            (js-call (expect (nativeGet (nativeGet (nativeGet envelope "pin") "operator") "kind")) :toBe "human")
            (js-call (expect (nativeGet envelope "trigger_reasons")) :toEqual
              (js-array (js-object :code "chat_pin" :label "消息被 Pin 到对话")))
            (js-call (expect (js-call (js-array "lark" "lark-bot") :includes (nativeGet (nativeGet envelope "reply_route") "connection_id"))) :toBe t)
            (js-call (expect (> (js-length (nativeGet envelope "mentions")) 0)) :toBe t))))
        (let* ((envelope (nativeGet (aref inputs 0) "envelope"))
          (readback (await (callOk f "A" "message.get" (js-object :event_id (nativeGet envelope "event_id"))))))
          (js-call (expect (nativeGet readback "trigger_reasons")) :toEqual (nativeGet envelope "trigger_reasons")))
        ;; Overlap, replayed pages and restart keep the same action exactly once.
        (await (advance f 12)) (js-call (expect (js-length inputs)) :toBe 4)
        (await (restartNative f)) (await (advance f 12)) (js-call (expect (js-length inputs)) :toBe 4)
        ;; Bot action suppressed, while the bot-authored content stays visible.
        (put state :pin_paginate false)
        (put (nativeGet state "pins") :user (js-array (funcall pin "pinned-old" "cli_actor" "app_id" (funcall stamp))))
        (put (nativeGet state "pins") :bot (js-array (funcall pin "pinned-old" "cli_actor" "app_id" (funcall stamp))))
        (await (advance f 12)) (js-call (expect (js-length inputs)) :toBe 4)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM events WHERE event_kind='message.pinned'") :get) "n")) :toBe 6)
        ;; API outage must not move the watermark past an unseen Pin.
        (put state :pin_fail t)
        (put (nativeGet state "pins") :user (js-array (funcall pin "pinned-old" "ou_self" "open_id" (funcall stamp))))
        (put (nativeGet state "pins") :bot (js-array (funcall pin "pinned-old" "ou_other" "open_id" (funcall stamp))))
        (await (advance f 8)) (js-call (expect (js-length inputs)) :toBe 4)
        (put state :pin_fail false)
        (await (advance f 22)) (js-call (expect (js-length inputs)) :toBe 6)
        ;; Re-Pin has a new official timestamp, even for the same old message.
        (put (nativeGet state "pins") :user (js-array (funcall pin "pinned-old" "ou_self" "open_id" (funcall stamp))))
        (put (nativeGet state "pins") :bot (js-array (funcall pin "pinned-old" "ou_other" "open_id" (funcall stamp))))
        (await (advance f 15)) (js-call (expect (js-length inputs)) :toBe 8)
        (finally (js-call db :close))))) cleanup)

  (withCase "T41.late-join-and-cross-app-echo.integration" (async ()
    (let ((original globalThis.WebSocket) (f nil) (state (js-object :extra_chats (js-array))))
      ;; Setup with asymmetrically configured tenant_ref ("lark" has tenant_ref, "lark-bot" omits it), matching production.
      (setq f (await (setup)))
      (put (aref (nativeGet (nativeGet f "config") "connections") 0) :tenant_ref "authorized-tenant")
      (put (nativeGet f "hybrid_state") :extra_chats (js-array))
      f))
    (async (f)
      (let* ((agent (await (bindRecipient f))) (state (nativeGet f "hybrid_state"))
        (clock (nativeGet f "clock")) (messages (nativeGet f "messages"))
        (marks (nativeGet f "marks"))
        (inputs (nativeGet (nativeGet f "opencode") "inputs"))
        (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
        (emit-reaction (lambda (app msg-id emoji actor-open-id stamp-ms event-id)
          (let* ((wire (js-object
              :header (js-object :event_id event-id :event_type "im.message.reaction.created_v1" :app_id app)
              :event (js-object :message_id msg-id :reaction_type (js-object :emoji_type emoji)
                :operator_type "user" :user_id (js-object :open_id actor-open-id) :action_time (str stamp-ms))))
            (bytes (encodeLarkFrame (js-object :seq 1 :service 1 :method 1
              :headers (js-array (js-object :key "type" :value "event") (js-object :key "message_id" :value event-id))
              :payload (Buffer/from (JSON/stringify wire) "utf8")))))
            (js-call (js-call (nativeGet f "wire_sockets") :get app) :dispatchEvent
              (new globalThis.MessageEvent "message" (js-object :data bytes)))))))
        (try
          (let ((rules (await (callOk f "O" "session.rules.get" (js-object :agent_id (nativeGet agent "agent_id"))))))
            (await (callOk f "O" "session.rules.update" (js-object
              :agent_id (nativeGet agent "agent_id")
              :expected_revision (nativeGet rules "revision")
              :text "Cross-app router rules"
              :reply_routes (js-array
                (js-object :source_connection_id "lark-bot" :mention_id "ou_self_in_bot" :reply_connection_id "lark")
                (js-object :source_connection_id "lark-bot" :mention_id "ou_bot" :reply_connection_id "lark-bot")
                (js-object :source_connection_id "lark" :mention_id "ou_self" :reply_connection_id "lark"))
              :idempotency_key "cross-app-rules"))))
          (let ((preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object
            :agent_id (nativeGet agent "agent_id")
            :rules (js-array (js-object :id "default" :enabled t
              :event_kinds (js-array "message.created" "message.reaction.added" "message.pinned")
              :predicate (js-object :any (js-array
                (js-object :all (js-array
                  (js-object :field "event_kind" :op "eq" :value "message.created")
                  (js-object :any (js-array
                    (js-object :field "mentions.id" :op "in" :value (js-array "ou_self" "ou_self_in_bot" "ou_bot"))
                    (js-object :field "addressed_self" :op "eq" :value t)))))
                (js-object :all (js-array
                  (js-object :field "event_kind" :op "eq" :value "message.reaction.added")
                  (js-object :any (js-array
                    (js-object :field "reaction.emoji_type" :op "in" :value (js-array "Pin"))
                    (js-object :all (js-array
                      (js-object :field "connection_id" :op "eq" :value "lark-bot")
                      (js-object :field "interaction.target_id" :op "eq" :value "ou_self_in_bot")))))))
                (js-object :field "event_kind" :op "eq" :value "message.pinned")))))))))))
            (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "cross-app-sub"))))
          (put state :enabled t)
          ;; Simulate 3 days of normal online operation: existing pollers are caught up to day 3,
          ;; while "joined-later" already has 1-day-old history/pins/reactions on Lark before bot joins it.
          (js-call clock :advance 259200000)
          (await (advance f 15))
          (let ((old-ms (- (Date/parse (js-call clock :utcNow)) 86400000)))
            (js-call messages :set "old-prejoin" (js-object :message_id "old-prejoin" :chat_id "joined-later"
              :create_time (str old-ms) :msg_type "text"
              :body (js-object :content (JSON/stringify (js-object :text "old pre-join @user")))
              :sender (js-object :id "ou_self_in_bot" :id_type "open_id" :sender_type "user")
              :mentions (js-array (js-object :id "ou_self_in_bot" :id_type "open_id"))))
            (put (nativeGet state "pins") :bot (js-array (js-object :chat_id "joined-later" :message_id "old-prejoin"
              :operator_id "ou_colleague" :operator_id_type "open_id" :create_time (str (+ old-ms 5000)))))
            (js-call marks :set "bot:old-prejoin" (js-object :reaction_id "old-pin-rid"
              :reaction_type (js-object :emoji_type "Pin")
              :operator (js-object :operator_type "user" :operator_id "ou_self_in_bot")
              :action_time (str (+ old-ms 10000)))))
          ;; Now bot joins joined-later (discovered by /chats + live WebSocket message).
          (put state :extra_chats (js-array (js-object :chat_id "joined-later")))
          (await (advance f 35))
          (js-call (expect (js-length inputs)) :toBe 0)
          (let ((now-ms (Date/parse (js-call clock :utcNow))))
            (js-call messages :set "live-after-join" (js-object :message_id "live-after-join" :chat_id "joined-later"
              :create_time (str now-ms) :msg_type "text"
              :body (js-object :content (JSON/stringify (js-object :text "@self handle whitelist")))
              :sender (js-object :id "ou_self_in_bot" :id_type "open_id" :sender_type "user")
              :mentions (js-array (js-object :id "ou_self_in_bot" :id_type "open_id"))))
            (emit f "cli_bot" "live-after-join")
            (await (advance f 18 20))
            ;; Only live-after-join is delivered; pre-join history/pins/reactions in joined-later did NOT flood.
            (js-call (expect (js-length inputs)) :toBe 1)
            (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 0) "envelope") "source") "native_message_id")) :toBe "live-after-join")
            ;; DJ posted a Typing working reaction on "lark" (user); simulate cross-app WS + HTTP observation on "lark-bot" with 34ms skew!
            (let* ((user-mark (js-call marks :get "user:live-after-join"))
              (mark-row (js-call (js-call db :query "SELECT payload FROM work_marks WHERE json_extract(payload,'$.native_message_id')='live-after-join' LIMIT 1") :get))
              (persisted-mark (and mark-row (JSON/parse (nativeGet mark-row "payload"))))
              (typing-rid (or (nativeGet user-mark "reaction_id") (nativeGet persisted-mark "reaction_id")))
              (typing-ms (Date/parse (js-call clock :utcNow))))
              (js-call (expect (not (not typing-rid))) :toBe t)
              (put user-mark :action_time (str typing-ms))
              (js-call marks :set "bot:live-after-join" (js-object :reaction_id typing-rid
                :reaction_type (js-object :emoji_type "Typing")
                :operator (js-object :operator_type "user" :operator_id "ou_self_in_bot")
                :action_time (str typing-ms)))
              (await (advance f 12 20))
              (funcall emit-reaction "cli_bot" "live-after-join" "Typing" "ou_self_in_bot" (+ typing-ms 34) "ws-typing-echo-1")
              (await (advance f 12 20))
              ;; Zero self-triggered Typing echo notifications!
              (js-call (expect (js-length inputs)) :toBe 1))
            ;; Now user adds ONE Pin reaction, seen by bot WS (+26ms, no rid), bot HTTP (rid), and user HTTP (rid).
            (let ((pin-ms (Date/parse (js-call clock :utcNow))))
              (funcall emit-reaction "cli_bot" "live-after-join" "Pin" "ou_self_in_bot" (+ pin-ms 26) "ws-pin-1")
              (js-call marks :set "bot:live-after-join" (js-object :reaction_id "shared-pin-rid-1"
                :reaction_type (js-object :emoji_type "Pin")
                :operator (js-object :operator_type "user" :operator_id "ou_self_in_bot")
                :action_time (str pin-ms)))
              (js-call marks :set "user:live-after-join" (js-object :reaction_id "shared-pin-rid-1"
                :reaction_type (js-object :emoji_type "Pin")
                :operator (js-object :operator_type "user" :operator_id "ou_self")
                :action_time (str pin-ms)))
              (await (advance f 25 20))
              ;; All 3 views (bot WS, bot HTTP, user HTTP) coalesce into 1 Pin notification (total inputs = 2, not 4 or 5)!
              (js-call (expect (js-length inputs)) :toBe 2)))
          (finally (js-call db :close))))) cleanup))
