(module dj.tests.integration.hybrid-inbox
  (import "../../src/core/native.eli" nativeGet NativeGlobal NativeNumber nativeSetTimeout)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../../src/adapters/im/lark-wire.eli" encodeLarkFrame decodeLarkFrame)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)

  (defconst socketFactory (js-object))
  (defun receiver (url) (funcall (nativeGet socketFactory "make") url))
  (defasync advance (f count)
    (let ((i 0))
      (while (< i count)
        (js-call (nativeGet f "clock") :advance 1000)
        (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
        (let ((result (await (js-call f :tick))))
          (js-call (expect (nativeGet result "ok")) :toBe t))
        (setq i (1+ i)))))
  (defasync setup ()
    (let* ((original globalThis.WebSocket) (clock nil) (f nil)
      (sockets (new globalThis.Map)) (messages (new globalThis.Map))
      (marks (new globalThis.Map)) (calls (js-array)) (replies (js-array))
      (state (js-object :acks 0 :reaction_seq 0 :enabled false :root nil)))
      (put socketFactory :make (lambda (address)
        (let* ((url (new globalThis.URL address)) (app (js-call (nativeGet url "searchParams") :get "app"))
          (socket (new globalThis.EventTarget)))
          (js-call sockets :set app socket) (put socket :readyState 1)
          (put socket :send (lambda (bytes)
            (let ((frame (decodeLarkFrame bytes)))
              (when (= (js-call (nativeGet frame "payload") :toString "utf8") "{\"code\":200}")
                ;; ACK must follow durable inbox insertion, before Core consumption.
                (let ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t))))
                  (try
                    (js-call (expect (> (nativeGet (js-call (js-call db :query
                      "SELECT COUNT(*) AS n FROM im_event_inbox") :get) "n") 0)) :toBe t)
                    (finally (js-call db :close))))
                (put state :acks (1+ (nativeGet state "acks")))))))
          (put socket :close (lambda (&rest ignored)
            (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close"))))
          (nativeSetTimeout (lambda () (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0)
          socket)))
      (put NativeGlobal :WebSocket receiver)
      (try
        (setq f (await (createFixture "hybrid-inbox-flow" "one" (js-object :configure (lambda (config ports)
          (setq clock (nativeGet ports "clock"))
          (put config :managed_profiles (js-array))
          (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
          (let ((user (aref (nativeGet config "connections") 0)))
            (Object/assign user (js-object :source_delivery "events" :event_scope "all_authorized"
              :event_app_id "cli_user" :event_subject_id "ou_self"
              :user_identity (js-object :app_id "cli_user" :open_id "ou_self")))
            (js-call (nativeGet config "connections") :push (js-object :connection_id "lark-bot"
              :platform "lark" :brand "lark" :identity "bot" :source_delivery "events"
              :event_scope "all_authorized" :event_app_id "cli_bot" :event_subject_id "ou_bot"
              :credential_ref "test:lark-bot" :watches (js-array)))
            (put ports :credentials (js-object :resolve (lambda (ref)
              (js-object :app_id (if (= ref "test:lark-bot") "cli_bot" "cli_user")
                :app_secret "fixture" :user_access_token "user-token"))))
            (put ports :http (js-object :fetch (async (address options)
              (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
                (query (nativeGet url "searchParams")) (method (nativeGet options "method" "GET"))
                (body (and (nativeGet options "body") (JSON/parse (nativeGet options "body"))))
                (bot (= (nativeGet (nativeGet options "headers") "authorization") "Bearer bot-token"))
                (key (if bot "bot" "user"))
                (reaction (js-call path :match (new globalThis.RegExp "/messages/([^/]+)/reactions(?:/([^/]+))?$")))
                (detail (js-call path :match (new globalThis.RegExp "/messages/([^/]+)$")))
                (reply (js-call path :match (new globalThis.RegExp "/messages/([^/]+)/reply$")))
                (selected (js-array)))
                (js-call calls :push (js-object :key key :path path :method method))
                (cond
                  ((js-call path :endsWith "/ws/endpoint")
                    (Response/json (js-object :code 0 :data (js-object
                      :URL (str "wss://fixture.larksuite.com/ws?service_id=1&app=" (nativeGet body "AppID"))
                      :ClientConfig (js-object :PingInterval 90)))))
                  ((js-call path :endsWith "/authen/v1/user_info")
                    (Response/json (js-object :code 0 :data (js-object :open_id "ou_self"))))
                  ((js-call path :endsWith "/tenant_access_token/internal")
                    (Response/json (js-object :code 0 :tenant_access_token "bot-token" :expire 3600)))
                  (reaction
                    (let* ((message-id (aref reaction 1)) (mark-key (str key ":" message-id))
                      (existing (js-call marks :get mark-key)))
                      (cond
                        ((= method "GET") (Response/json (js-object :code 0 :data
                          (js-object :items (if existing (js-array existing) (js-array)) :has_more false))))
                        ((= method "POST")
                          (put state :reaction_seq (1+ (nativeGet state "reaction_seq")))
                          (let ((mark (js-object :reaction_id (str "reaction-" (nativeGet state "reaction_seq"))
                            :reaction_type (nativeGet body "reaction_type")
                            :operator (js-object :operator_type (if bot "app" "user")
                              :operator_id (if bot "cli_bot" "ou_self")))))
                            (js-call marks :set mark-key mark)
                            (Response/json (js-object :code 0 :data mark))))
                        (t
                          (js-call (expect (aref reaction 2)) :toBe (nativeGet existing "reaction_id"))
                          (js-call marks :delete mark-key) (Response/json (js-object :code 0 :data (js-object)))))))
                  (reply
                    (js-call replies :push (js-object :key key :message_id (aref reply 1) :body body))
                    (Response/json (js-object :code 0 :data (js-object :message_id "reply-native"
                      :chat_id (nativeGet (js-call messages :get (aref reply 1)) "chat_id")))))
                  (detail (Response/json (js-object :code 0 :data (js-object
                    :items (js-array (js-call messages :get (aref detail 1))) :has_more false))))
                  ((= path "/open-apis/im/v1/chats")
                    (Response/json (js-object :code 0 :data (js-object :items (js-array (js-object :chat_id "c1")) :has_more false))))
                  ((or (= path "/open-apis/search/v2/message") (= path "/open-apis/im/v1/messages"))
                    (when (nativeGet state "enabled")
                      (js-call messages :forEach (lambda (message)
                        (let* ((chat (nativeGet message "chat_id")) (private (= chat "user-dm"))
                          (stamp (/ (NativeNumber (nativeGet message "create_time")) 1000))
                          (start (NativeNumber (if bot (js-call query :get "start_time") (nativeGet body "start_time"))))
                          (end (NativeNumber (if bot (js-call query :get "end_time") (nativeGet body "end_time")))))
                          (when (and (>= stamp start) (< stamp end)
                            (if bot (= chat (js-call query :get "container_id"))
                              (and (not (= chat "bot-dm")) (= private (= (nativeGet body "chat_type") "p2p_chat")))))
                            (js-call selected :push (if bot message (nativeGet message "message_id"))))))))
                    (Response/json (js-object :code 0 :data (js-object :items selected :has_more false))))
                  ;; User document-notice setup is unrelated to IM collection.
                  (t (Response/json (js-object :code 99991663))))))))
            (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort user ports))
            (let ((bot (js-call (nativeGet config "connections") :find (lambda (c) (= (nativeGet c "connection_id") "lark-bot")))))
              (js-call (nativeGet ports "im_ports") :set "lark-bot" (createLarkEventPort bot ports)))))))))
        (put state :root (nativeGet f "root"))
        (put f :original_socket original) (put f :messages messages) (put f :marks marks)
        (put f :wire_sockets sockets) (put f :hybrid_state state) (put f :native_calls calls) (put f :replies replies)
        (await (advance f 2)) f
        (catch error
          (when f (await (closeFixture f)))
          (put NativeGlobal :WebSocket original) (throw error)))))
  (defasync cleanup (f)
    (when f (try (await (closeFixture f))
      (finally (put NativeGlobal :WebSocket (nativeGet f "original_socket"))))))
  (defun emit (f app id)
    (let* ((message (js-call (nativeGet f "messages") :get id))
      (wire (js-object :header (js-object :event_id (str app ":" id) :event_type "im.message.receive_v1" :app_id app)
        :event (js-object :sender (js-object :sender_id (js-object :open_id (nativeGet (nativeGet message "sender") "id"))
          :sender_type (if (= (nativeGet (nativeGet message "sender") "sender_type") "user") "user" "app"))
          :message (Object/assign (js-object) message (js-object :message_type "text" :chat_type
            (if (= (nativeGet message "chat_id") "c1") "group" "p2p")
            :content (nativeGet (nativeGet message "body") "content")
            :mentions (js-call (nativeGet message "mentions") :map
              (lambda (m) (js-object :id (js-object :open_id (nativeGet m "id"))))))))))
      (bytes (encodeLarkFrame (js-object :seq 1 :service 1 :method 1
        :headers (js-array (js-object :key "type" :value "event") (js-object :key "message_id" :value (str app ":" id)))
        :payload (Buffer/from (JSON/stringify wire) "utf8")))))
      (js-call (js-call (nativeGet f "wire_sockets") :get app) :dispatchEvent
        (new globalThis.MessageEvent "message" (js-object :data bytes)))))

  (withCase "T41.hybrid-inbox-flow.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (state (nativeGet f "hybrid_state"))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (inputs (nativeGet (nativeGet f "opencode") "inputs")))
      (try
        (let ((preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object
          :agent_id (nativeGet agent "agent_id") :selector (js-object :event_kinds (js-array "message.created"))
          :predicate (js-object :any (js-array (js-object :field "addressed_self" :op "eq" :value t)
            (js-object :field "chat_type" :op "eq" :value "p2p")))))))))
          (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "hybrid-subscribe"))))
        (let ((policy (await (callOk f "O" "message.filter.get" (js-object)))))
          (await (callOk f "O" "message.filter.update" (js-object :expected_revision (nativeGet policy "revision")
            :idempotency_key "hybrid-filter" :rules (js-array (js-object :id "blocked-author" :enabled t
              :effect "suppress_trigger" :predicate (js-object :field "sender.id" :op "eq" :value "ou_blocked")))))))
        (js-call (js-array
          (js-array "shared" "c1" "ou_other" "user" t)
          (js-array "user-private" "user-dm" "cli_other_bot" "app" false)
          (js-array "bot-private" "bot-dm" "ou_other" "user" false)
          (js-array "unmentioned" "c1" "cli_other_bot" "app" false)
          (js-array "blocked" "c1" "ou_blocked" "user" t)) :forEach (lambda (item)
            (let ((id (aref item 0)))
              (js-call (nativeGet f "messages") :set id (js-object :message_id id :chat_id (aref item 1)
                :create_time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))) :msg_type "text"
                :body (js-object :content (JSON/stringify (js-object :text (str id "\nsecond line"))))
                :sender (js-object :id (aref item 2) :id_type "open_id" :sender_type (aref item 3))
                :mentions (if (aref item 4) (js-array (js-object :id "ou_self" :id_type "open_id")
                  (js-object :id "ou_bot" :id_type "open_id")) (js-array))
                :thread_id (when (= id "shared") "thread-one")
                :root_id (when (= id "shared") "root-one") :parent_id (when (= id "shared") "parent-one"))))))
        ;; Same message: WS first on bot, HTTP first on user. No direct Core.ingest.
        (emit f "cli_bot" "shared") (emit f "cli_bot" "bot-private")
        (await (advance f 3)) (put state :enabled t)
        (await (advance f 55))
        (js-call (expect (js-length inputs)) :toBe 4)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM events") :get) "n")) :toBe 8)
        (js-call (expect (js-call (js-call db :query
          "SELECT connection_id,source_key FROM events GROUP BY connection_id,source_key HAVING COUNT(*)>1") :all)) :toEqual (js-array))
        (let ((rows (js-call (js-call db :query "SELECT connection_id,native_message_id,payload FROM events") :all)))
          (js-call rows :forEach (lambda (row)
            (let* ((event (JSON/parse (nativeGet row "payload"))) (id (nativeGet row "native_message_id"))
              (ws (and (= (nativeGet row "connection_id") "lark-bot") (js-call (js-array "shared" "bot-private") :includes id))))
              (js-call (expect (nativeGet event "receive_transport")) :toBe (if ws "websocket" "poll"))
              (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe (str id "\nsecond line"))
              (when (= id "shared")
                (js-call (expect (nativeGet (nativeGet event "conversation") "native_thread_id")) :toBe "thread-one")
                (js-call (expect (nativeGet (nativeGet event "reply_to") "id")) :toBe "parent-one"))))))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 4)
        ;; Late WebSocket duplicates and repeated HTTP windows never create more work.
        (emit f "cli_user" "shared") (emit f "cli_user" "user-private")
        (emit f "cli_bot" "shared") (await (advance f 12))
        (js-call (expect (nativeGet state "acks")) :toBe 5)
        (js-call (expect (js-length inputs)) :toBe 4)
        (let ((i 0))
          (while (< i (js-length inputs))
            (let* ((envelope (nativeGet (aref inputs i) "envelope"))
              (source (nativeGet envelope "source")) (message (nativeGet source "native_message_id")))
              (if (= message "user-private")
                (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
                  :content (js-object :type "text" :text "completed") :idempotency_key "hybrid-reply")))
                (await (callOk f "A" "delivery.complete" (js-object :delivery_id (nativeGet envelope "delivery_id")
                  :reason "no_reply" :idempotency_key (str "hybrid-complete-" i))))))
            (setq i (1+ i))))
        (await (advance f 12))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (js-length (nativeGet f "replies"))) :toBe 1)
        (js-call (expect (nativeGet (aref (nativeGet f "replies") 0) "key")) :toBe "user")
        (js-call (expect (nativeGet (aref (nativeGet f "replies") 0) "message_id")) :toBe "user-private")
        (js-call inputs :forEach (lambda (item)
          (js-call (expect (js-call (js-array "blocked" "unmentioned") :includes
            (nativeGet (nativeGet (nativeGet item "envelope") "source") "native_message_id"))) :toBe false)))
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM work_items WHERE state='completed'") :get) "n")) :toBe 4)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM work_marks WHERE state='done'") :get) "n")) :toBe 4)
        (js-call (expect (nativeGet (js-call (js-call db :query
          "SELECT COUNT(*) AS n FROM outbound WHERE state='accepted'") :get) "n")) :toBe 1)
        (finally (js-call db :close))))) cleanup))
