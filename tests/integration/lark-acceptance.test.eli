(module dj.tests.integration.lark-acceptance
  (import "../../src/core/native.eli" nativeGet)
  (import "../../tools/lark-acceptance.eli" executeLarkAcceptance larkIntentIdentity)
  (import "../../tools/lark-acceptance-controller.eli" loadLarkBinding openLarkIntentStore)
  (import "../support/lark-acceptance.eli" larkTestBinding larkTestRequest createLarkAcceptanceFixture)
  (import "../support/case.eli" withCase)
  (import "node:fs" mkdirSync writeFileSync rmSync)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (withCase "T38.lark-acceptance.integration" (lambda () nil) (async (unused)
    (let* ((root (resolve ".local/tests" (str "native-lark-" (randomUUID))))
           (binding (larkTestBinding)) (request (larkTestRequest "stimulus-lark"))
           (runtime (createLarkAcceptanceFixture request)) (store nil) (other nil))
      (try
        (mkdirSync root (js-object :recursive t :mode 448))
        (writeFileSync (resolve root "binding.json") (JSON/stringify binding) (js-object :mode 384))
        (writeFileSync (resolve root "user-oauth.json") (JSON/stringify (js-object :app_id "cli_test")) (js-object :mode 384))
        (js-call (expect (nativeGet (await (loadLarkBinding root "binding.json")) "credential_ref")) :toBe "user-oauth.json")
        (setq store (await (openLarkIntentStore root "intents.sqlite")))
        (setq other (await (openLarkIntentStore root "intents.sqlite")))
        (Object/assign runtime store)
        (put (nativeGet runtime "state") :on_write (lambda (body)
          (let ((row (js-call other :readIntent (nativeGet (larkIntentIdentity request binding) "intent_key"))))
            (js-call (expect (nativeGet row "state")) :toBe "unknown")
            (js-call (expect (nativeGet row "native_message_id")) :toBe nil))))
        (await (executeLarkAcceptance request binding runtime))
        (await (executeLarkAcceptance request binding runtime))
        (js-call (expect (nativeGet (nativeGet (nativeGet runtime "state") "writes") "length")) :toBe 1)
        (js-call (expect (nativeGet (js-call other :readIntent (nativeGet (larkIntentIdentity request binding) "intent_key")) "state")) :toBe "confirmed")
        (finally (when other (js-call other :close)) (when store (js-call store :close))
          (rmSync root (js-object :recursive t :force t)))))) (lambda (unused) nil)))
