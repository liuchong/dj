(module dj.tests.integration.native-host-control
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connectors/codex.eli" activateCodexControl)
  (import "../../src/adapters/agent/desktop.eli" createDesktopPort)
  (import "bun:sqlite" Database)
  (import "node:net" createServer)
  (import "../../src/adapters/agent/electron-control.eli" renderer)
  (import "../../src/adapters/agent/pi-native.eli" createPiNativePort)
  (import "../../src/connectors/pi.eli" activatePiReceiver)
  (import "../../src/adapters/agent/desktop-transport.eli" cursorRequest)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk)
  (import "node:vm" runInNewContext)
  (import "node:fs/promises" mkdir readdir rm readFile writeFile)
  (import "node:path" resolve join)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (withCase "T53.desktop-host-control.integration" (lambda () nil)
    (async (unused)
      (progn
        (let* ((sessions (new globalThis.Map)) (sent (js-array))
               (api (js-object :start (async (options)
                 (js-call (expect (nativeGet options "message")) :toBe "")
                 (js-call sessions :set (nativeGet options "sessionId") (js-object :id (nativeGet options "sessionId")
                   :cwd (nativeGet options "cwd") :title (nativeGet options "title")))
                 (js-object :sessionId (nativeGet options "sessionId")))
                 :getSession (async (id) (js-call sessions :get id))
                 :getAll (async () (Array/from (js-call sessions :values)))
                 :updateSession (async (id args) (Object/assign (js-call sessions :get id) args))
                 :sendMessage (async (id text images tools attachments priority gates key)
                   (js-call sent :push (js-object :id id :text text :key key)))))
               (run (runInNewContext (str "(" renderer ")") (js-object :window (js-object :claude.web (js-object :LocalSessions api))))))
          (await (funcall run (js-object :tool "claude" :operation "create" :key "claude-create" :native_id "claude-new"
            :directory "/fixture/claude" :title "Claude created")))
          (await (funcall run (js-object :tool "claude" :operation "rename" :thread "claude-new" :title "Claude renamed")))
          (await (funcall run (js-object :tool "claude" :operation "submit" :thread "claude-new" :text "中文😀" :dispatch_key "native-input")))
          (js-call (expect (nativeGet sessions "size")) :toBe 1)
          (js-call (expect (nativeGet (js-call sessions :get "claude-new") "title")) :toBe "Claude renamed")
          (js-call (expect (aref sent 0)) :toEqual (js-object :id "claude-new" :text "中文😀" :key "native-input"))))
      (let ((f (await (createFixture "native-host-mixed" "one" (js-object :configure (lambda (config ports)
        (let ((common (js-object :tool "claude" :ownership "existing" :directory (resolve "fixture-native-host") :workspace_ref "ws-native")))
          (js-call (nativeGet config "agent_endpoints") :push
            (Object/assign (js-object) common (js-object :instance_id "claude-inbox" :native_namespace "claude-cli"
              :endpoint_ref "claude-inbox" :instance_epoch "cli-current" :socket_path (resolve "fixture-cli.sock")
              :registry_path (resolve "fixture-cli.json") :native_session_id "cli-session"
              :process_binding (js-object :pid 1 :process_birth "fixture" :process_helper_ref (resolve "fixture-helper"))))
            (Object/assign (js-object) common (js-object :instance_id "claude-desktop" :native_namespace "claude-desktop"
              :endpoint_ref "claude-desktop" :instance_epoch "desktop-current" :window_id 1
              :native_api (js-object :inspector_url "http://127.0.0.1:9229/" :process_id 1 :process_origin 1)))))))))))
        (try
          (let ((cli (await (callOk f "O" "instance.get" (js-object :instance_id "claude-inbox"))))
                (desktop (await (callOk f "O" "instance.get" (js-object :instance_id "claude-desktop")))))
            (js-call (expect (nativeGet (nativeGet cli "capabilities") "session_create")) :toBe "unsupported")
            (js-call (expect (nativeGet (nativeGet desktop "capabilities") "session_create")) :toBe "supported"))
          (finally (await (closeFixture f)))))
)
    (lambda (unused) nil))
  (withCase "T53.pi-host-control.integration"
    (async ()
      (let* ((root (resolve ".local/tests" (str "pi-host-" (randomUUID)))))
        (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((handlers (new globalThis.Map)) (original-name "Original") (original-inputs (js-array)) (child-inputs (js-array))
             (manager (js-object :getSessionId (lambda () "original-pi") :getSessionName (lambda () original-name)
               :getBranch (lambda () (js-array))))
             (model (js-object :provider "fixture" :id "native"))
             (context (js-object :mode "tui" :cwd (resolve ".") :model model :modelRegistry (js-object)
               :sessionManager manager :isIdle (lambda () t) :hasPendingMessages (lambda () false)))
             (pi (js-object :on (lambda (name handler) (js-call handlers :set name handler))
               :getThinkingLevel (lambda () "high") :setSessionName (lambda (name) (setq original-name name))
               :sendUserMessage (async (text) (js-call original-inputs :push text))))
             (sdk-calls 0) (child-name "")
             (sdk (js-object :createAgentSession (async (options)
               (setq sdk-calls (1+ sdk-calls))
               (js-call (expect (nativeGet options "cwd")) :toBe (resolve "."))
               (js-call (expect (nativeGet options "model")) :toBe model)
               (js-object :session (js-object :sessionManager
                 (js-object :getSessionId (lambda () "child-pi") :getSessionName (lambda () child-name)
                   :getBranch (lambda () (js-call child-inputs :map (lambda (text index)
                     (js-object :type "message" :id (str "child-input-" index) :message (js-object :role "user" :content text))))))
                 :isStreaming false :setSessionName (lambda (name) (setq child-name name)) :dispose (lambda () nil)
                 :prompt (async (text options)
                   (js-call child-inputs :push text) (js-call options :preflightResult t)))))))
             (receiver (activatePiReceiver pi (js-object :root root :sdk sdk))) (port nil))
        (try
          (await (funcall (js-call handlers :get "session_start") (js-object) context))
          (let* ((files (await (readdir root)))
                 (manifest (join root (js-call files :find (lambda (name) (js-call name :endsWith ".json")))))
                 (endpoint (js-object :tool "pi" :instance_id "pi-host" :native_namespace "pi-local"
                   :manifest_path manifest :directory (resolve ".") :workspace_ref "ws-pi")))
            (setq port (createPiNativePort (js-object :endpoints (js-array endpoint)) (js-object)))
            (let* ((instance (Object/assign (js-object :instance_id "pi-host")
                       (await (js-call port :probeInstance (js-object :instance_id "pi-host") (js-object)))))
                   (call-context (lambda () (js-object :deadline (+ (performance/now) 5000) :title "New Pi")))
                   (created (await (js-call port :create instance "ws-pi" "new-pi-key" (funcall call-context))))
                   (session (nativeGet created "session")))
              (js-call (expect (nativeGet created "state")) :toBe "ready")
              (js-call (expect (nativeGet session "native_session_id")) :toBe "child-pi")
              (await (js-call port :create instance "ws-pi" "new-pi-key" (funcall call-context)))
              (js-call (expect sdk-calls) :toBe 1)
              (await (js-call port :rename session "Renamed Pi" (funcall call-context)))
              (js-call (expect child-name) :toBe "Renamed Pi")
              (let ((page (await (js-call port :listSessions (js-object) nil (js-object :max_records 1) (funcall call-context)))))
                (js-call (expect (nativeGet page "complete")) :toBe false)
                (let ((next (await (js-call port :listSessions (js-object) (nativeGet page "next_cursor")
                              (js-object :max_records 1) (funcall call-context)))))
                  (js-call (expect (nativeGet next "complete")) :toBe t)
                  (js-call (expect (nativeGet (aref (nativeGet next "items") 0) "native_session_id")) :toBe "child-pi")))
              (await (cursorRequest endpoint (js-object :schema_version 1 :operation "submit" :session_id "child-pi"
                :receiver_epoch (nativeGet (JSON/parse (await (readFile manifest "utf8"))) "instanceEpoch")
                :text "Child input 中文😀" :dispatch_key "child-send") (funcall call-context)))
              (js-call (expect child-inputs) :toEqual (js-array "Child input 中文😀"))
              (js-call (expect (js-length original-inputs)) :toBe 0)
              (js-call (expect original-name) :toBe "Original")
              (let ((page (await (js-call port :readMessages session nil (js-object) (funcall call-context)))))
                (js-call (expect (nativeGet (aref (nativeGet page "items") 0) "text")) :toBe "Child input 中文😀"))))
          (finally (when port (await (js-call port :close))) (await (js-call receiver :close))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
  (withCase "T53.codex-host-control.integration"
    (async () (let ((root (resolve ".local/tests" (str "codex-host-" (randomUUID)))))
      (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((path (join root "native.sock")) (creates 0) (renames 0) (sends 0) (receiver nil)
             (server (createServer (lambda (socket)
               (let ((buffer (Buffer/alloc 0)))
                 (js-call socket :on "data" (lambda (bytes)
                   (setq buffer (Buffer/concat (js-array buffer bytes)))
                   (when (and (>= (js-length buffer) 4) (>= (js-length buffer) (+ 4 (js-call buffer :readUInt32LE 0))))
                     (let* ((request (JSON/parse (js-call (js-call buffer :subarray 4) :toString "utf8")))
                            (params (nativeGet request "params")) (result nil))
                       (if (= (nativeGet request "method") "tools/list")
                         (setq result (js-object :tools (js-call (js-array "create_thread" "set_thread_title" "list_projects" "read_thread" "send_message_to_thread") :map
                           (lambda (name) (js-object :name name :namespace "codex_app")))))
                         (progn
                           (js-call (expect (nativeGet params "threadId")) :toBe "caller-native")
                           (js-call (expect (nativeGet params "turnId")) :toBe "actual-turn")
                           (let ((tool (nativeGet params "tool")) (args (nativeGet params "arguments")))
                             (cond
                               ((= tool "list_projects") (setq result (js-object :projects
                                 (js-array (js-object :projectKind "local" :path root :projectId "native-project")))))
                               ((= tool "create_thread")
                                 (setq creates (1+ creates))
                                 (js-call (expect (nativeGet args "prompt")) :toBe "Explicit initial input")
                                 (js-call (expect (nativeGet (nativeGet args "target") "environment")) :toEqual (js-object :type "local"))
                                 (setq result (js-object :threadId "created-native" :hostId "local")))
                               ((= tool "set_thread_title") (setq renames (1+ renames) result "Title updated"))
                               ((= tool "read_thread")
                                 (setq result (js-object :thread (js-object :id (nativeGet args "threadId")
                                   :kind "codex" :hostId "local" :cwd root :status (js-object :type "notLoaded")))))
                               ((= tool "send_message_to_thread")
                                 (js-call (expect (nativeGet args "threadId")) :toBe "created-native")
                                 (js-call (expect (js-call (nativeGet args "prompt") :includes "Frozen test message")) :toBe t)
                                 (setq sends (1+ sends) result "Accepted"))
                               (t (throw (new globalThis.Error "unexpected tool")))))
                           (setq result (js-object :success t :contentItems (js-array
                             (js-object :type "inputText" :text (if (= (nativeGet params "tool") "set_thread_title")
                               result (JSON/stringify result))))))))
                       (let* ((body (Buffer/from (JSON/stringify (js-object :id 1 :jsonrpc "2.0" :result result)))) (header (Buffer/alloc 4)))
                         (js-call header :writeUInt32LE (js-length body)) (js-call socket :end (Buffer/concat (js-array header body))))))))))))
)
        (try
          (await (new globalThis.Promise (lambda (done failed) (js-call server :once "error" failed) (js-call server :listen path done))))
          (setq receiver (await (activateCodexControl (js-object :owner_pid (nativeGet globalThis.process "pid") :owner_birth "fixture-birth"
            :root (join root "receiver") :pipe_path path :request_meta
              (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn"))))))
          (let* ((manifest (JSON/parse (await (readFile (nativeGet receiver "manifest_path") "utf8"))))
                 (endpoint (js-object :manifest_path (nativeGet receiver "manifest_path")))
                 (args (js-object :operation "create" :receiver_epoch (nativeGet manifest "instanceEpoch") :key "new"
                   :directory root :title "QA native" :content (js-object :type "text" :text "Explicit initial input")))
                 (context (lambda () (js-object :deadline (+ (performance/now) 5000))))
                 (created (await (cursorRequest endpoint args (funcall context)))))
            (js-call (expect (nativeGet (nativeGet (nativeGet created "data") "data") "thread_id")) :toBe "created-native")
            (await (cursorRequest endpoint args (funcall context)))
            (js-call (expect creates) :toBe 1)
            (await (cursorRequest endpoint (js-object :operation "rename" :receiver_epoch (nativeGet manifest "instanceEpoch")
              :thread "created-native" :title "Renamed") (funcall context)))
            (js-call (expect renames) :toBe 2)
            (let ((lookup (await (cursorRequest endpoint (js-object :operation "lookup_create" :key "missing"
              :receiver_epoch (nativeGet manifest "instanceEpoch")) (funcall context)))))
              (js-call (expect (nativeGet (nativeGet (nativeGet lookup "data") "data") "state")) :toBe "unknown")))
          (let* ((history (join root "history.sqlite"))
                 (db (new Database history))
                 (pid (nativeGet globalThis.process "pid"))
                 (uid (js-call globalThis.process :getuid))
                 (app "/Applications/Codex.app/Contents/MacOS/Codex")
                 (owner (js-object :pid pid :uid uid :birth "fixture-birth" :executable app))
                 (helper (join root "metadata"))
                 (endpoint (js-object :instance_id "desktop" :native_namespace "desktop" :tool "codex"
                   :directory root :workspace_ref "workspace" :socket_path (join root "dead.sock")
                   :history_database history :process_helper_ref helper
                   :control_manifest_path (join root "receiver" "999999.json")))
                 (port (createDesktopPort "codex" (js-object :endpoints (js-array endpoint))
                   (js-object :codex_discovery_command (async (file args context)
                     (if (= file "ps") (str pid " 1 " uid " " app "\n") (JSON/stringify owner))))))
                 (target (js-object :instance_id "desktop" :native_session_id "created-native"))
                 (context (js-object :deadline (+ (performance/now) 5000))))
            (js-call db :exec "CREATE TABLE threads (id TEXT PRIMARY KEY,name TEXT,cwd TEXT,archived INTEGER)")
            (js-call (js-call db :query "INSERT INTO threads VALUES(?,?,?,0)") :run "created-native" "Canonical title" root)
            (js-call db :close)
            (await (writeFile helper "fixture metadata program" (js-object :mode 448)))
            ;; A dead socket and stale PID in configuration cannot win over the registered current host.
            (let* ((probe (await (js-call port :probe target target context)))
                   (epoch (nativeGet probe "instance_epoch"))
                   (instance (await (js-call port :probeInstance target context)))
                   (envelope (js-object :schema_version 1 :kind "external_message" :allowed_actions (js-array)
                     :content (js-object :text "Frozen test message"))))
              (js-call (expect (nativeGet probe "title")) :toBe "Canonical title")
              (js-call (expect (nativeGet probe "live_receiver")) :toBe t)
              (js-call (expect (nativeGet instance "instance_epoch")) :toBe epoch)
              (let ((sent (await (js-call port :submit (Object/assign (js-object) target (js-object :instance_epoch epoch))
                envelope "start_idle" "delivery-key" context))))
                (js-call (expect (nativeGet sent "state")) :toBe "accepted")
                (js-call (expect sends) :toBe 1))
              (put owner :birth "new-unregistered-app")
              (let ((stale (await (js-call port :submit (Object/assign (js-object) target (js-object :instance_epoch epoch))
                envelope "start_idle" "delivery-key" context))))
                (js-call (expect (nativeGet stale "definite_not_sent")) :toBe t)
                (js-call (expect sends) :toBe 1)))
            (await (js-call port :close)))
          (finally
            (when receiver (await (js-call receiver :close)))
            (await (new globalThis.Promise (lambda (done) (js-call server :close done))))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
)
