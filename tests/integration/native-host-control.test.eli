(module dj.tests.integration.native-host-control
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/connectors/codex.eli" activateCodexControl ensureCodexControl superviseCodexControl)
  (import "../../src/connectors/codex-mcp.eli" createCodexMcpProxy collectCallerCandidates)
  (import "../../src/adapters/agent/desktop.eli" createDesktopPort)
  (import "bun:sqlite" Database)
  (import "node:net" createServer)
  (import "../../src/adapters/agent/electron-control.eli" renderer)
  (import "../../src/adapters/agent/pi-native.eli" createPiNativePort)
  (import "../../src/connectors/pi.eli" activatePiReceiver)
  (import "../../src/adapters/agent/desktop-transport.eli" cursorRequest)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk)
  (import "node:vm" runInNewContext)
  (import "node:fs" existsSync)
  (import "node:fs/promises" mkdir readdir rm readFile writeFile)
  (import "node:path" resolve join)
  (import "node:crypto" randomUUID)
  (import "node:stream" PassThrough)
  (import "node:sqlite" DatabaseSync)
  (import "bun:test" expect)
  (withCase "T53.desktop-host-control.integration" (lambda () nil)
    (async (unused)
      (progn
        (let* ((sessions (new globalThis.Map)) (sent (js-array))
               (api (js-object :start (async (options)
                 (js-call (expect (nativeGet options "message")) :toBe "")
                 (js-call sessions :set (nativeGet options "sessionId") (js-object :id (nativeGet options "sessionId")
                   :cwd (nativeGet options "cwd") :title (nativeGet options "title")))
                 (js-object :sessionId (nativeGet options "sessionId")))
                 :getSession (async (id) (js-call sessions :get id))
                 :getAll (async () (Array/from (js-call sessions :values)))
                 :updateSession (async (id args) (Object/assign (js-call sessions :get id) args))
                 :sendMessage (async (id text images tools attachments priority gates key)
                   (js-call sent :push (js-object :id id :text text :key key)))))
               (run (runInNewContext (str "(" renderer ")") (js-object :window (js-object :claude.web (js-object :LocalSessions api))))))
          (await (funcall run (js-object :tool "claude" :operation "create" :key "claude-create" :native_id "claude-new"
            :directory "/fixture/claude" :title "Claude created")))
          (await (funcall run (js-object :tool "claude" :operation "rename" :thread "claude-new" :title "Claude renamed")))
          (await (funcall run (js-object :tool "claude" :operation "submit" :thread "claude-new" :text "中文😀" :dispatch_key "native-input")))
          (js-call (expect (nativeGet sessions "size")) :toBe 1)
          (js-call (expect (nativeGet (js-call sessions :get "claude-new") "title")) :toBe "Claude renamed")
          (js-call (expect (aref sent 0)) :toEqual (js-object :id "claude-new" :text "中文😀" :key "native-input"))))
      (let ((f (await (createFixture "native-host-mixed" "one" (js-object :configure (lambda (config ports)
        (let ((common (js-object :tool "claude" :ownership "existing" :directory (resolve "fixture-native-host") :workspace_ref "ws-native")))
          (js-call (nativeGet config "agent_endpoints") :push
            (Object/assign (js-object) common (js-object :instance_id "claude-inbox" :native_namespace "claude-cli"
              :endpoint_ref "claude-inbox" :instance_epoch "cli-current" :socket_path (resolve "fixture-cli.sock")
              :registry_path (resolve "fixture-cli.json") :native_session_id "cli-session"
              :process_binding (js-object :pid 1 :process_birth "fixture" :process_helper_ref (resolve "fixture-helper"))))
            (Object/assign (js-object) common (js-object :instance_id "claude-desktop" :native_namespace "claude-desktop"
              :endpoint_ref "claude-desktop" :instance_epoch "desktop-current" :window_id 1
              :native_api (js-object :inspector_url "http://127.0.0.1:9229/" :process_id 1 :process_origin 1)))))))))))
        (try
          (let ((cli (await (callOk f "O" "instance.get" (js-object :instance_id "claude-inbox"))))
                (desktop (await (callOk f "O" "instance.get" (js-object :instance_id "claude-desktop")))))
            (js-call (expect (nativeGet (nativeGet cli "capabilities") "session_create")) :toBe "unsupported")
            (js-call (expect (nativeGet (nativeGet desktop "capabilities") "session_create")) :toBe "supported"))
          (finally (await (closeFixture f)))))
)
    (lambda (unused) nil))
  (withCase "T53.pi-host-control.integration"
    (async ()
      (let* ((root (resolve ".local/tests" (str "pi-host-" (randomUUID)))))
        (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((handlers (new globalThis.Map)) (original-name "Original") (original-inputs (js-array)) (child-inputs (js-array))
             (manager (js-object :getSessionId (lambda () "original-pi") :getSessionName (lambda () original-name)
               :getBranch (lambda () (js-array))))
             (model (js-object :provider "fixture" :id "native"))
             (context (js-object :mode "tui" :cwd (resolve ".") :model model :modelRegistry (js-object)
               :sessionManager manager :isIdle (lambda () t) :hasPendingMessages (lambda () false)))
             (pi (js-object :on (lambda (name handler) (js-call handlers :set name handler))
               :getThinkingLevel (lambda () "high") :setSessionName (lambda (name) (setq original-name name))
               :sendUserMessage (async (text) (js-call original-inputs :push text))))
             (sdk-calls 0) (child-name "")
             (sdk (js-object :createAgentSession (async (options)
               (setq sdk-calls (1+ sdk-calls))
               (js-call (expect (nativeGet options "cwd")) :toBe (resolve "."))
               (js-call (expect (nativeGet options "model")) :toBe model)
               (js-object :session (js-object :sessionManager
                 (js-object :getSessionId (lambda () "child-pi") :getSessionName (lambda () child-name)
                   :getBranch (lambda () (js-call child-inputs :map (lambda (text index)
                     (js-object :type "message" :id (str "child-input-" index) :message (js-object :role "user" :content text))))))
                 :isStreaming false :setSessionName (lambda (name) (setq child-name name)) :dispose (lambda () nil)
                 :prompt (async (text options)
                   (js-call child-inputs :push text) (js-call options :preflightResult t)))))))
             (receiver (activatePiReceiver pi (js-object :root root :sdk sdk))) (port nil))
        (try
          (await (funcall (js-call handlers :get "session_start") (js-object) context))
          (let* ((files (await (readdir root)))
                 (manifest (join root (js-call files :find (lambda (name) (js-call name :endsWith ".json")))))
                 (endpoint (js-object :tool "pi" :instance_id "pi-host" :native_namespace "pi-local"
                   :manifest_path manifest :directory (resolve ".") :workspace_ref "ws-pi")))
            (setq port (createPiNativePort (js-object :endpoints (js-array endpoint)) (js-object)))
            (let* ((instance (Object/assign (js-object :instance_id "pi-host")
                       (await (js-call port :probeInstance (js-object :instance_id "pi-host") (js-object)))))
                   (call-context (lambda () (js-object :deadline (+ (performance/now) 5000) :title "New Pi")))
                   (created (await (js-call port :create instance "ws-pi" "new-pi-key" (funcall call-context))))
                   (session (nativeGet created "session")))
              (js-call (expect (nativeGet created "state")) :toBe "ready")
              (js-call (expect (nativeGet session "native_session_id")) :toBe "child-pi")
              (await (js-call port :create instance "ws-pi" "new-pi-key" (funcall call-context)))
              (js-call (expect sdk-calls) :toBe 1)
              (await (js-call port :rename session "Renamed Pi" (funcall call-context)))
              (js-call (expect child-name) :toBe "Renamed Pi")
              (let ((page (await (js-call port :listSessions (js-object) nil (js-object :max_records 1) (funcall call-context)))))
                (js-call (expect (nativeGet page "complete")) :toBe false)
                (let ((next (await (js-call port :listSessions (js-object) (nativeGet page "next_cursor")
                              (js-object :max_records 1) (funcall call-context)))))
                  (js-call (expect (nativeGet next "complete")) :toBe t)
                  (js-call (expect (nativeGet (aref (nativeGet next "items") 0) "native_session_id")) :toBe "child-pi")))
              (await (cursorRequest endpoint (js-object :schema_version 1 :operation "submit" :session_id "child-pi"
                :receiver_epoch (nativeGet (JSON/parse (await (readFile manifest "utf8"))) "instanceEpoch")
                :text "Child input 中文😀" :dispatch_key "child-send") (funcall call-context)))
              (js-call (expect child-inputs) :toEqual (js-array "Child input 中文😀"))
              (js-call (expect (js-length original-inputs)) :toBe 0)
              (js-call (expect original-name) :toBe "Original")
              (let ((page (await (js-call port :readMessages session nil (js-object) (funcall call-context)))))
                (js-call (expect (nativeGet (aref (nativeGet page "items") 0) "text")) :toBe "Child input 中文😀"))))
          (finally (when port (await (js-call port :close))) (await (js-call receiver :close))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
  (withCase "T53.codex-host-control.integration"
    (async () (let ((root (resolve ".local/tests" (str "codex-host-" (randomUUID)))))
      (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((path (join root "native.sock")) (creates 0) (renames 0) (sends 0) (receiver nil) (replacement nil)
             (server (createServer (lambda (socket)
               (let ((buffer (Buffer/alloc 0)))
                 (js-call socket :on "data" (lambda (bytes)
                   (setq buffer (Buffer/concat (js-array buffer bytes)))
                   (when (and (>= (js-length buffer) 4) (>= (js-length buffer) (+ 4 (js-call buffer :readUInt32LE 0))))
                     (let* ((request (JSON/parse (js-call (js-call buffer :subarray 4) :toString "utf8")))
                            (params (nativeGet request "params")) (result nil))
                       (if (= (nativeGet request "method") "tools/list")
                         (setq result (js-object :tools (js-call (js-array "create_thread" "set_thread_title" "list_projects" "read_thread" "send_message_to_thread") :map
                           (lambda (name) (js-object :name name :namespace "codex_app")))))
                         (progn
                           (js-call (expect (nativeGet params "threadId")) :toBe "caller-native")
                           (js-call (expect (nativeGet params "turnId")) :toBe "actual-turn")
                           (let ((tool (nativeGet params "tool")) (args (nativeGet params "arguments")))
                             (cond
                               ((= tool "list_projects") (setq result (js-object :projects
                                 (js-array (js-object :projectKind "local" :path root :projectId "native-project")))))
                               ((= tool "create_thread")
                                 (setq creates (1+ creates))
                                 (js-call (expect (nativeGet args "prompt")) :toBe "Explicit initial input")
                                 (js-call (expect (nativeGet (nativeGet args "target") "environment")) :toEqual (js-object :type "local"))
                                 (setq result (js-object :threadId "created-native" :hostId "local")))
                               ((= tool "set_thread_title") (setq renames (1+ renames) result "Title updated"))
                               ((= tool "read_thread")
                                 (js-call (expect (nativeGet args "includeTurns")) :toBe false)
                                 (setq result (js-object :thread (js-object :id (nativeGet args "threadId")
                                   :kind "codex" :hostId "local"
                                   :cwd (if (= (nativeGet args "threadId") "wrong-workspace") (join root "other") root)
                                   :status (js-object :type "notLoaded")))))
                               ((= tool "send_message_to_thread")
                                 (js-call (expect (nativeGet args "threadId")) :toBe "created-native")
                                 (js-call (expect (js-call (nativeGet args "prompt") :includes "Frozen test message")) :toBe t)
                                 (setq sends (1+ sends) result "Accepted"))
                               (t (throw (new globalThis.Error "unexpected tool")))))
                           (setq result (js-object :success t :contentItems (js-array
                             (js-object :type "inputText" :text (if (= (nativeGet params "tool") "set_thread_title")
                               result (JSON/stringify result))))))))
                       (let* ((body (Buffer/from (JSON/stringify (js-object :id 1 :jsonrpc "2.0" :result result)))) (header (Buffer/alloc 4)))
                         (js-call header :writeUInt32LE (js-length body)) (js-call socket :end (Buffer/concat (js-array header body))))))))))))
)
        (try
          (await (new globalThis.Promise (lambda (done failed) (js-call server :once "error" failed) (js-call server :listen path done))))
          (await (mkdir (join root "receiver") (js-object :recursive t :mode 448)))
          (await (writeFile (join root "receiver" "99999999.json") "{}" (js-object :mode 384)))
          (await (writeFile (join root "receiver" "99999999-deaddead.sock") "" (js-object :mode 384)))
          (setq receiver (await (activateCodexControl (js-object :owner_pid (nativeGet globalThis.process "pid") :owner_birth "fixture-birth"
            :watchdog_ms 40 :root (join root "receiver") :pipe_path path :request_meta
              (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn"))))))
          (js-call (expect (existsSync (join root "receiver" "99999999.json"))) :toBe false)
          (js-call (expect (existsSync (join root "receiver" "99999999-deaddead.sock"))) :toBe false)
          (let* ((reused (await (ensureCodexControl (js-object :owner_pid (nativeGet globalThis.process "pid") :owner_birth "fixture-birth"
                   :root (join root "receiver") :pipe_path path :request_meta
                     (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn")))))))
            (js-call (expect (nativeGet reused "epoch")) :toBe (nativeGet receiver "epoch")))
          (let* ((manifest (JSON/parse (await (readFile (nativeGet receiver "manifest_path") "utf8"))))
                 (endpoint (js-object :manifest_path (nativeGet receiver "manifest_path")))
                 (args (js-object :operation "create" :receiver_epoch (nativeGet manifest "instanceEpoch") :key "new"
                   :directory root :title "QA native" :content (js-object :type "text" :text "Explicit initial input")))
                 (context (lambda () (js-object :deadline (+ (performance/now) 5000))))
                 (created (await (cursorRequest endpoint args (funcall context)))))
            (js-call (expect (js-call (nativeGet manifest "capabilities") :includes "app_tools")) :toBe t)
            (let* ((app-list (await (cursorRequest endpoint (js-object :operation "app_tools"
                     :receiver_epoch (nativeGet manifest "instanceEpoch") :method "tools/list" :params (js-object)) (funcall context))))
                   (app-call (await (cursorRequest endpoint (js-object :operation "app_tools"
                     :receiver_epoch (nativeGet manifest "instanceEpoch") :method "tools/call"
                     :params (js-object :namespace "codex_app" :tool "list_projects" :arguments (js-object))) (funcall context))))
                   (rejected-tool nil))
              (js-call (expect (js-length (nativeGet (nativeGet (nativeGet app-list "data") "data") "tools"))) :toBe 5)
              (js-call (expect (nativeGet (nativeGet (nativeGet app-call "data") "data") "success")) :toBe t)
              (try (await (cursorRequest endpoint (js-object :operation "app_tools"
                :receiver_epoch (nativeGet manifest "instanceEpoch") :method "tools/call"
                :params (js-object :namespace "codex_app" :tool "arbitrary_tool" :arguments (js-object))) (funcall context)))
                (catch err (setq rejected-tool (nativeGet err "code"))))
              (js-call (expect rejected-tool) :toBeDefined))
            (js-call (expect (nativeGet (nativeGet (nativeGet created "data") "data") "thread_id")) :toBe "created-native")
            (await (cursorRequest endpoint args (funcall context)))
            (js-call (expect creates) :toBe 1)
            (await (cursorRequest endpoint (js-object :operation "rename" :receiver_epoch (nativeGet manifest "instanceEpoch")
              :thread "created-native" :title "Renamed") (funcall context)))
            (js-call (expect renames) :toBe 2)
            (let ((lookup (await (cursorRequest endpoint (js-object :operation "lookup_create" :key "missing"
              :receiver_epoch (nativeGet manifest "instanceEpoch")) (funcall context)))))
              (js-call (expect (nativeGet (nativeGet (nativeGet lookup "data") "data") "state")) :toBe "unknown")))
          (let* ((history (join root "history.sqlite"))
                 (db (new Database history))
                 (pid (nativeGet globalThis.process "pid"))
                 (uid (js-call globalThis.process :getuid))
                 (app "/Applications/Codex.app/Contents/MacOS/Codex")
                 (owner (js-object :pid pid :uid uid :birth "fixture-birth" :executable app))
                 (helper (join root "metadata"))
                 (endpoint (js-object :instance_id "desktop" :native_namespace "desktop" :tool "codex"
                   :directory root :workspace_ref "workspace" :socket_path (join root "dead.sock")
                   :history_database history :process_helper_ref helper
                   :control_manifest_path (join root "receiver" "999999.json")))
                 (port (createDesktopPort "codex" (js-object :endpoints (js-array endpoint))
                   (js-object :codex_discovery_command (async (file args context)
                     (if (= file "ps") (str pid " 1 " uid " " app "\n") (JSON/stringify owner))))))
                 (target (js-object :instance_id "desktop" :native_session_id "created-native"))
                 (context (js-object :deadline (+ (performance/now) 5000))))
            (js-call db :exec "CREATE TABLE threads (id TEXT PRIMARY KEY,name TEXT,cwd TEXT,archived INTEGER,updated_at INTEGER)")
            (let ((insert (js-call db :query "INSERT INTO threads VALUES(?,?,?,0,0)")))
              (js-call insert :run "created-native" "Canonical title" root)
              (let ((index 0))
                (while (< index 7)
                  (js-call insert :run (str "extra-" index) "" root)
                  (setq index (1+ index))))
              (js-call insert :run "wrong-workspace" "" root))
            (js-call db :close)
            (await (writeFile helper "fixture metadata program" (js-object :mode 448)))
            ;; A dead socket and stale PID in configuration cannot win over the registered current host.
            (let* ((probe (await (js-call port :probe target target context)))
                   (epoch (nativeGet probe "instance_epoch"))
                   (instance (await (js-call port :probeInstance target context)))
                   (envelope (js-object :schema_version 1 :kind "external_message" :allowed_actions (js-array)
                     :content (js-object :text "Frozen test message"))))
              (js-call (expect (nativeGet probe "title")) :toBe "Canonical title")
              (js-call (expect (nativeGet probe "live_receiver")) :toBe t)
              (js-call (expect (nativeGet instance "instance_epoch")) :toBe epoch)
              (let* ((first (await (js-call port :discover "live" (js-object :instance_id "desktop") context)))
                     (cursor (nativeGet first "next_cursor"))
                     (items (nativeGet first "items"))
                     (second (await (js-call port :discover "live" (js-object :instance_id "desktop" :cursor cursor) context))))
                (js-call (expect (js-length items)) :toBe 8)
                (js-call (expect (nativeGet (aref items 0) "title")) :toBe "Canonical title")
                (js-call (expect (nativeGet (aref items 0) "instance_epoch")) :toBe epoch)
                (js-call (expect (nativeGet first "coverage")) :toBe "covered")
                (js-call (expect (nativeGet second "coverage")) :toBe "partial")
                (js-call (expect (nativeGet second "reason")) :toBe "receiver_discovery_partial")
                (js-call (expect (js-length (nativeGet second "items"))) :toBe 0)
                (js-call (expect sends) :toBe 0))
              (let ((sent (await (js-call port :submit (Object/assign (js-object) target (js-object :instance_epoch epoch))
                envelope "start_idle" "delivery-key" context))))
                (js-call (expect (nativeGet sent "state")) :toBe "accepted")
                (js-call (expect sends) :toBe 1))
              (setq replacement (await (activateCodexControl (js-object :owner_pid pid :owner_birth "fixture-birth"
                :root (join root "receiver") :pipe_path path :request_meta
                (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn"))))))
              (await (new globalThis.Promise (lambda (resolve) (globalThis.setTimeout resolve 120))))
              (js-call (expect (js-call receiver :isClosed)) :toBe t)
              (await (js-call receiver :close))
              (let ((next (await (js-call port :probeInstance target context))))
                (js-call (expect (nativeGet next "state")) :toBe "ready")
                (js-call (expect (= (nativeGet next "instance_epoch") epoch)) :toBe false))
              (put owner :birth "new-unregistered-app")
              (let ((stale (await (js-call port :submit (Object/assign (js-object) target (js-object :instance_epoch epoch))
                envelope "start_idle" "delivery-key" context))))
                (js-call (expect (nativeGet stale "definite_not_sent")) :toBe t)
                (js-call (expect sends) :toBe 1)))
            (await (js-call port :close)))
          (finally
            (when replacement (await (js-call replacement :close)))
            (when receiver (await (js-call receiver :close)))
            (await (new globalThis.Promise (lambda (done) (js-call server :close done))))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
  (withCase "T53.codex-supervision-failover.integration"
    (async () (let ((root (resolve ".local/tests" (str "codex-sup-" (randomUUID)))))
      (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((path (join root "native.sock"))
             (recv-dir (join root "receiver"))
             (owner-pid (nativeGet globalThis.process "pid"))
             (manifest-path (join recv-dir (str owner-pid ".json")))
             (helper (resolve "dist/native/dj-process-info"))
             (sends 0)
             (server (createServer (lambda (socket)
               (let ((buffer (Buffer/alloc 0)))
                 (js-call socket :on "data" (lambda (bytes)
                   (setq buffer (Buffer/concat (js-array buffer bytes)))
                   (when (and (>= (js-length buffer) 4) (>= (js-length buffer) (+ 4 (js-call buffer :readUInt32LE 0))))
                     (let* ((request (JSON/parse (js-call (js-call buffer :subarray 4) :toString "utf8")))
                            (params (nativeGet request "params")) (result nil))
                       (if (= (nativeGet request "method") "tools/list")
                         (setq result (js-object :tools (js-call (js-array "create_thread" "set_thread_title" "list_projects" "read_thread" "send_message_to_thread") :map
                           (lambda (name) (js-object :name name :namespace "codex_app")))))
                         (progn
                           (js-call (expect (nativeGet params "threadId")) :toBe "caller-native")
                           (js-call (expect (nativeGet params "turnId")) :toBe "actual-turn")
                           (let ((tool (nativeGet params "tool")) (args (nativeGet params "arguments")))
                             (cond
                               ((= tool "read_thread")
                                 (setq result (js-object :thread (js-object :id (nativeGet args "threadId")
                                   :kind "codex" :hostId "local" :cwd root
                                   :status (js-object :type "idle")))))
                               ((= tool "send_message_to_thread")
                                 (js-call (expect (nativeGet args "prompt")) :toBe "Failover test message")
                                 (setq sends (1+ sends) result "Accepted"))
                               (t (throw (new globalThis.Error "unexpected tool")))))
                           (setq result (js-object :success t :contentItems (js-array
                             (js-object :type "inputText" :text (if (= (nativeGet params "tool") "send_message_to_thread")
                               result (JSON/stringify result))))))))
                       (let* ((body (Buffer/from (JSON/stringify (js-object :id 1 :jsonrpc "2.0" :result result)))) (header (Buffer/alloc 4)))
                         (js-call header :writeUInt32LE (js-length body)) (js-call socket :end (Buffer/concat (js-array header body))))))))))))
             (wait-manifest (async (previous-epoch)
               (let ((deadline (+ (performance/now) 4000)) (found nil))
                 (while (and (< (performance/now) deadline) (not found))
                   (try
                     (let ((parsed (JSON/parse (await (readFile manifest-path "utf8")))))
                       (when (and (nativeGet parsed "instanceEpoch")
                                  (or (not previous-epoch) (not (= (nativeGet parsed "instanceEpoch") previous-epoch)))
                                  (existsSync (nativeGet parsed "socketPath")))
                         (setq found parsed)))
                     (catch ignored nil))
                   (unless found
                     (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 25))))))
                 found)))
             (stop-a (js-object :stopped false :reason nil :stop nil))
             (stop-b (js-object :stopped false :reason nil :stop nil))
             (stop-c (js-object :stopped false :reason nil :stop nil))
             (stop-d (js-object :stopped false :reason nil :stop nil))
             (sup-a nil) (sup-b nil) (sup-c nil) (sup-d nil)
             (settled-b false) (settled-c false) (settled-d false) (resolved-b false)
             (owner (js-object :pid owner-pid :uid (js-call globalThis.process :getuid)
               :birth "fixture-sup-birth" :executable "fixture-codex")))
        (try
          (await (mkdir recv-dir (js-object :recursive t :mode 448)))
          (await (new globalThis.Promise (lambda (done failed) (js-call server :once "error" failed) (js-call server :listen path done))))
          (let ((make-opts (lambda (ctrl &optional resolver)
                  (let ((opts (js-object :root recv-dir :process_helper helper
                          :app_owner (lambda () owner) :owner_pipe (lambda (ignored) path)
                          :watch_interval_ms 50 :probe_interval_ms 5000
                          :watchdog_ms 100 :stop_control ctrl)))
                    (if resolver
                      (put opts :resolve_caller resolver)
                      (put opts :request_meta (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn"))))
                    opts))))
            (setq sup-a (superviseCodexControl (funcall make-opts stop-a)))
            (let* ((first (await (funcall wait-manifest nil)))
                   (epoch-1 (and first (nativeGet first "instanceEpoch")))
                   (endpoint (js-object :manifest_path manifest-path))
                   (context (lambda () (js-object :deadline (+ (performance/now) 5000)))))
              (js-call (expect epoch-1) :toBeDefined)
              (let ((probed (await (cursorRequest endpoint (js-object :operation "probe" :receiver_epoch epoch-1) (funcall context))))
                    (read-res (await (cursorRequest endpoint (js-object :operation "read" :thread "caller-native" :directory root :receiver_epoch epoch-1) (funcall context)))))
                (js-call (expect (nativeGet (nativeGet (nativeGet probed "data") "data") "state")) :toBe "ready")
                (js-call (expect (nativeGet (nativeGet (nativeGet read-res "data") "data") "id")) :toBe "caller-native"))
              (setq sup-b (js-call (superviseCodexControl (funcall make-opts stop-b (async ()
                (setq resolved-b t)
                (js-object :x-codex-turn-metadata (js-object :thread_id "caller-native" :turn_id "actual-turn")))))
                :then (lambda () (setq settled-b t))))
              (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 150))))
              (js-call (expect settled-b) :toBe false)
              (js-call (expect (existsSync (join recv-dir (str owner-pid ".standby.lock")))) :toBe false)
              (let ((still (JSON/parse (await (readFile manifest-path "utf8")))))
                (js-call (expect (nativeGet still "instanceEpoch")) :toBe epoch-1))
              (put stop-a :stopped t)
              (put stop-a :reason "test_failover")
              (when (nativeGet stop-a "stop") (funcall (nativeGet stop-a "stop") "test_failover"))
              (await sup-a)
              (setq sup-a nil)
              (let* ((second (await (funcall wait-manifest epoch-1)))
                     (epoch-2 (and second (nativeGet second "instanceEpoch"))))
                (js-call (expect epoch-2) :toBeDefined)
                (js-call (expect (= epoch-2 epoch-1)) :toBe false)
                (js-call (expect resolved-b) :toBe t)
                (let ((probed-2 (await (cursorRequest endpoint (js-object :operation "probe" :receiver_epoch epoch-2) (funcall context))))
                      (sent (await (cursorRequest endpoint (js-object :operation "send" :thread "caller-native" :directory root
                        :text "Failover test message" :receiver_epoch epoch-2) (funcall context)))))
                  (js-call (expect (nativeGet (nativeGet (nativeGet probed-2 "data") "data") "state")) :toBe "ready")
                  (js-call (expect (nativeGet (nativeGet (nativeGet sent "data") "data") "state")) :toBe "accepted")
                  (js-call (expect sends) :toBe 1)))
              (setq sup-c (js-call (superviseCodexControl (funcall make-opts stop-c)) :then (lambda () (setq settled-c t))))
              (setq sup-d (js-call (superviseCodexControl (funcall make-opts stop-d)) :then (lambda () (setq settled-d t))))
              (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 200))))
              (js-call (expect settled-c) :toBe false)
              (js-call (expect settled-d) :toBe false)
              (js-call (expect (existsSync (join recv-dir (str owner-pid ".standby.lock")))) :toBe false)
              (put stop-d :stopped t)
              (when (nativeGet stop-d "stop") (funcall (nativeGet stop-d "stop") "test_done"))
              (await sup-d)
              (setq sup-d nil)
              (put stop-c :stopped t)
              (when (nativeGet stop-c "stop") (funcall (nativeGet stop-c "stop") "test_done"))
              (await sup-c)
              (setq sup-c nil)
              (put stop-b :stopped t)
              (when (nativeGet stop-b "stop") (funcall (nativeGet stop-b "stop") "test_done"))
              (await sup-b)
              (setq sup-b nil)
              (let ((trace (await (readFile (join recv-dir "receiver.ndjson") "utf8"))))
                (js-call (expect trace) :toContain "\"receiver_supervisor_started\"")
                (js-call (expect trace) :toContain "\"receiver_supervisor_leader\"")
                (js-call (expect trace) :toContain "\"receiver_registered\"")
                (js-call (nativeGet (expect trace) "not") :toContain "\"receiver_standby_full\""))))
          (finally
            (when sup-a
              (put stop-a :stopped t)
              (when (nativeGet stop-a "stop") (funcall (nativeGet stop-a "stop") "cleanup"))
              (await sup-a))
            (when sup-b
              (put stop-b :stopped t)
              (when (nativeGet stop-b "stop") (funcall (nativeGet stop-b "stop") "cleanup"))
              (await sup-b))
            (when sup-c
              (put stop-c :stopped t)
              (when (nativeGet stop-c "stop") (funcall (nativeGet stop-c "stop") "cleanup"))
              (await sup-c))
            (when sup-d
              (put stop-d :stopped t)
              (when (nativeGet stop-d "stop") (funcall (nativeGet stop-d "stop") "cleanup"))
              (await sup-d))
            (await (new globalThis.Promise (lambda (done) (js-call server :close done))))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
  (withCase "T53.codex-mcp-proxy.integration"
    (async () (let ((root (resolve ".local/tests" (str "codex-mcp-" (randomUUID)))))
      (await (mkdir root (js-object :recursive t :mode 448))) root))
    (async (root)
      (let* ((recv-dir (join root "receivers"))
             (codex-home (join root "codex"))
             (token-file (join root "mcp.token"))
             (stdin (new PassThrough))
             (stdout (new PassThrough))
             (out-buf "")
             (replies (js-array))
             (calls (js-array))
             (init-count 0)
             (active-sid nil)
             (expired false)
             (proxy nil))
        (try
          (await (mkdir recv-dir (js-object :recursive t :mode 448)))
          (await (mkdir codex-home (js-object :recursive t :mode 448)))
          (await (writeFile token-file "secret-mcp-token\n" (js-object :mode 384)))
          (await (writeFile (join recv-dir "99999.json")
            (JSON/stringify (js-object :caller_thread_id "thread-manifest")) (js-object :mode 384)))
          (let ((db (new DatabaseSync (join codex-home "state_5.sqlite"))))
            (try
              (js-call db :exec "CREATE TABLE threads (id TEXT PRIMARY KEY, archived INTEGER NOT NULL DEFAULT 0, preview TEXT NOT NULL DEFAULT '', updated_at INTEGER NOT NULL DEFAULT 0)")
              (let ((stmt (js-call db :prepare "INSERT INTO threads (id, archived, preview, updated_at) VALUES (?, ?, ?, ?)")))
                (js-call stmt :run "thread-archived" 1 "archived prompt" 300)
                (js-call stmt :run "thread-empty" 0 "" 200)
                (js-call stmt :run "thread-visible" 0 "active thread preview" 100))
              (finally (js-call db :close))))
          (let ((initial-candidates (await (collectCallerCandidates recv-dir 99999 codex-home nil))))
            (js-call (expect initial-candidates) :toEqual (js-array "thread-manifest" "thread-visible")))
          (js-call stdout :on "data" (lambda (chunk)
            (setq out-buf (str out-buf (js-call chunk :toString "utf8")))
            (let ((idx (js-call out-buf :indexOf "\n")))
              (while (>= idx 0)
                (let ((line (js-call (js-call out-buf :slice 0 idx) :trim)))
                  (setq out-buf (js-call out-buf :slice (1+ idx)))
                  (when (> (js-length line) 0)
                    (js-call replies :push (JSON/parse line))))
                (setq idx (js-call out-buf :indexOf "\n"))))))
          (let* ((wait-reply (async (target-id)
                   (let ((deadline (+ (performance/now) 3000)) (match nil))
                     (while (and (< (performance/now) deadline) (not match))
                       (setq match (js-call replies :find (lambda (item) (= (nativeGet item "id") target-id))))
                       (unless match
                         (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 15))))))
                     (unless match (throw (new globalThis.Error (str "missing reply for id " target-id))))
                     match)))
                 (mock-fetch (async (url init)
                   (let* ((headers (nativeGet init "headers"))
                          (body (JSON/parse (nativeGet init "body")))
                          (method (nativeGet body "method"))
                          (sid (nativeGet headers "mcp-session-id")))
                     (js-call (expect url) :toBe "http://127.0.0.1:53270/mcp")
                     (js-call (expect (nativeGet headers "authorization")) :toBe "Bearer secret-mcp-token")
                     (js-call calls :push (js-object :method method :sid sid))
                     (cond
                       ((= method "initialize")
                         (setq init-count (1+ init-count) active-sid (str "sid-" init-count) expired false)
                         (js-object :status 200
                           :headers (new globalThis.Headers (js-object :content-type "application/json" :mcp-session-id active-sid))
                           :text (async () (JSON/stringify (js-object :jsonrpc "2.0" :id (nativeGet body "id")
                             :result (js-object :protocolVersion "2025-03-26" :capabilities (js-object)))))))
                       ((= method "notifications/initialized")
                         (js-call (expect sid) :toBe active-sid)
                         (js-object :status 202 :headers (new globalThis.Headers) :text (async () "")))
                       ((or expired (not (= sid active-sid)))
                         (js-object :status 404
                           :headers (new globalThis.Headers (js-object :content-type "application/json"))
                           :text (async () (JSON/stringify (js-object :error "session_expired")))))
                       ((= method "tools/list")
                         (js-object :status 200
                           :headers (new globalThis.Headers (js-object :content-type "text/event-stream" :mcp-session-id active-sid))
                           :text (async () (str "event: message\ndata: "
                             (JSON/stringify (js-object :jsonrpc "2.0" :id (nativeGet body "id")
                               :result (js-object :tools (js-array (js-object :name "dj_service_status")))))
                             "\n\n"))))
                       ((= method "tools/call")
                         (js-object :status 200
                           :headers (new globalThis.Headers (js-object :content-type "application/json" :mcp-session-id active-sid))
                           :text (async () (JSON/stringify (js-object :jsonrpc "2.0" :id (nativeGet body "id")
                             :result (js-object :content (js-array (js-object :type "text" :text "ok"))))))))
                       (t (throw (new globalThis.Error (str "unexpected MCP method " method)))))))))
            (setq proxy (createCodexMcpProxy (js-object :url "http://127.0.0.1:53270/mcp"
              :token_file token-file :stdin stdin :stdout stdout
              :receiver_root recv-dir :codex_home codex-home
              :fetch_fn mock-fetch :disable_control t)))
            (js-call stdin :write (str (JSON/stringify (js-object :jsonrpc "2.0" :id 1 :method "initialize"
              :params (js-object :protocolVersion "2025-03-26" :capabilities (js-object) :clientInfo (js-object :name "codex" :version "1.0")))) "\n"))
            (let ((init-reply (await (funcall wait-reply 1))))
              (js-call (expect (nativeGet (nativeGet init-reply "result") "protocolVersion")) :toBe "2025-03-26")
              (js-call (expect (js-call proxy :sessionId)) :toBe "sid-1"))
            (js-call stdin :write (str (JSON/stringify (js-object :jsonrpc "2.0" :id 2 :method "tools/list" :params (js-object))) "\n"))
            (let ((list-reply (await (funcall wait-reply 2))))
              (js-call (expect (nativeGet (aref (nativeGet (nativeGet list-reply "result") "tools") 0) "name")) :toBe "dj_service_status"))
            (js-call stdin :write (str (JSON/stringify (js-object :jsonrpc "2.0" :id 3 :method "tools/call"
              :params (js-object :name "dj_service_status" :arguments (js-object)
                :_meta (js-object :x-codex-turn-metadata (js-object :thread_id "thread-live-call" :turn_id "turn-live-1"))))) "\n"))
            (let ((call-reply (await (funcall wait-reply 3))))
              (js-call (expect (nativeGet (aref (nativeGet (nativeGet call-reply "result") "content") 0) "text")) :toBe "ok")
              (js-call (expect (js-call proxy :liveCaller)) :toEqual (js-object :thread_id "thread-live-call" :turn_id "turn-live-1"))
              (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 50))))
              (let ((ctx (JSON/parse (await (readFile (join recv-dir "caller-context.json") "utf8")))))
                (js-call (expect (nativeGet ctx "thread_id")) :toBe "thread-live-call")))
            (setq expired t)
            (js-call stdin :write (str (JSON/stringify (js-object :jsonrpc "2.0" :id 4 :method "tools/call"
              :params (js-object :name "dj_service_status" :arguments (js-object)
                :_meta (js-object :x-codex-turn-metadata (js-object :thread_id "thread-reinit-call" :turn_id "turn-reinit-2"))))) "\n"))
            (let ((reinit-reply (await (funcall wait-reply 4))))
              (js-call (expect (nativeGet (aref (nativeGet (nativeGet reinit-reply "result") "content") 0) "text")) :toBe "ok")
              (js-call (expect init-count) :toBe 2)
              (js-call (expect (js-call proxy :sessionId)) :toBe "sid-2")
              (let ((post-candidates (await (collectCallerCandidates recv-dir 99999 codex-home (js-call proxy :liveCaller)))))
                (js-call (expect post-candidates) :toEqual (js-array "thread-reinit-call" "thread-manifest" "thread-visible")))))
          (js-call stdin :end)
          (await (js-call proxy :start))
          (setq proxy nil)
          (finally
            (when proxy (await (js-call proxy :close "test_cleanup")))))))
    (async (root) (await (rm root (js-object :recursive t :force t)))))
)
