  (withCase "T41.hybrid-inbox.integration" (lambda () nil)
    (async (unused)
      (let ((application nil) (poller nil) (reads (js-array)) (queries (js-array)) (fail false) (bot-poller nil))
        (let* ((f (await (createFixture "user-inbox" "one" (js-object :configure
            (lambda (config ports)
              (put config :managed_profiles (js-array))
              (let ((connection (aref (nativeGet config "connections") 0))
                (peer (js-call (nativeGet ports "im_ports") :get "lark")))
                (put connection :source_delivery "events") (put connection :event_scope "all_authorized")
                (put connection :event_app_id "fixture-app") (put connection :event_subject_id "ou_self")
                (put connection :user_identity (js-object :app_id "fixture-app" :open_id "ou_self"))
                (put peer :initialize (lambda (context) (setq application context)))
              (js-call (nativeGet config "connections") :push (js-object :connection_id "lark-bot"
                :platform "lark" :brand "lark" :identity "bot" :source_delivery "events"
                :event_scope "all_authorized" :event_app_id "fixture-bot" :event_subject_id "ou_bot"
                :credential_ref "secrets/mock.json" :watches (js-array) :revision 1))
              (js-call (nativeGet ports "im_ports") :set "lark-bot" (js-call (nativeGet ports "im_ports") :get "lark"))))))))
          (clock (nativeGet f "clock")) (connection (aref (nativeGet (nativeGet f "config") "connections") 0))
          (host (js-object :clock clock))
          (base (js-object
            :nativeRequest (async (path method body context)
              (js-call queries :push (js-object :path path :method method :body body))
              (if fail (js-object :status 403 :wire (js-object :code 99991672))
                (js-object :status 200 :wire (js-object :code 0 :data
                  (if (= (nativeGet body "chat_type") "group_chat")
                    (js-object :items (js-array "group-message") :has_more false)
                    (if (js-call path :includes "page_token=next")
                      (js-object :items (js-array "second-private") :has_more false)
                      (js-object :items (js-array "private-message" "websocket-known" "old-message")
                        :has_more t :page_token "next")))))))
            :history (async (parameters context)
              (let ((id (nativeGet parameters "message_id")))
                (js-call reads :push id)
                (success (js-object :messages (js-array (js-object :message_id id
                  :chat_id (if (= id "group-message") "group-chat" "private-chat") :msg_type "text"
                  :create_time (if (= id "old-message") "1767225599000" "1767225605000")
                  :content "native @self" :sender (js-object :id "ou_sender" :id_type "open_id" :sender_type "user")
                  :mentions (js-array (js-object :id "ou_self" :id_type "open_id" :name "self"))
                  :thread_id (when (= id "group-message") "thread-one") :root_id "original-root"))))))))
          (step (async ()
            (js-call clock :advance 1000) (js-call poller :pump)
            (let ((n 0))
              (while (and (> (js-call poller :pendingWork) 0) (< n 100))
                (setq n (1+ n))
                (await (new globalThis.Promise (lambda (resolve) (nativeSetTimeout resolve 0)))))
              (js-call (expect (js-call poller :pendingWork)) :toBe 0))))
          (db (nativeGet (nativeGet application "store") "db")))
          (try
            (setq poller (createLarkInboxPoller (Object/assign (js-object) connection
              (js-object :inbox_poll_seconds 5)) host base normalizeLarkEvent))
            (js-call poller :initialize application)
            (await (js-call f :ingest (createdEvent "lark" "websocket-known" "already received")))
            (let ((n 0)) (while (< n 20) (await (funcall step)) (setq n (1+ n))))
            (js-call (expect (nativeGet (js-call poller :status) "state")) :toBe "ready")
            (js-call (expect (js-call reads :includes "websocket-known")) :toBe false)
            (js-call (expect (js-call reads :includes "private-message")) :toBe t)
            (js-call (expect (js-call reads :includes "group-message")) :toBe t)
            (js-call queries :forEach (lambda (query)
              (js-call (expect (nativeGet (nativeGet query "body") "query")) :toBe "")
              (js-call (expect (nativeGet (nativeGet query "body") "start_time")) :toBeDefined)
              (js-call (expect (nativeGet (nativeGet query "body") "end_time")) :toBeDefined)))
            (let ((rows (js-call (js-call db :query "SELECT payload FROM im_event_inbox WHERE connection_id='lark'") :all)))
              (js-call (expect (js-length rows)) :toBe 3)
              (let ((index 0))
                (while (< index (js-length rows))
                  (let ((event (JSON/parse (nativeGet (aref rows index) "payload"))))
                    (js-call (expect (nativeGet event "receive_transport")) :toBe "poll")
                    (js-call (expect (nativeGet event "addressed_self")) :toBe t)
                    (await (js-call f :ingest event)) (await (js-call f :ingest event)))
                  (setq index (1+ index))))
              (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM events") :get) "n")) :toBe 4))
            (let* ((row (js-call (js-call db :query "SELECT payload FROM events WHERE native_message_id='group-message'") :get))
              (event (JSON/parse (nativeGet row "payload"))))
              (js-call (expect (nativeGet (nativeGet event "conversation") "native_thread_id")) :toBe "thread-one")
              (js-call (expect (nativeGet event "chat_type")) :toBe "group")
              (js-call (expect (nativeGet event "receive_transport")) :toBe "poll"))
            (let ((activation (nativeGet (js-call (js-call db :query
                "SELECT payload FROM poll_checkpoints WHERE conversation_key='inbox:p2p_chat'") :get) "payload")))
              (js-call poller :close)
              (setq poller (createLarkInboxPoller (Object/assign (js-object) connection
                (js-object :inbox_poll_seconds 5)) host base normalizeLarkEvent))
              (js-call poller :initialize application)
              (js-call (expect (nativeGet (js-call (js-call db :query
                "SELECT payload FROM poll_checkpoints WHERE conversation_key='inbox:p2p_chat'") :get) "payload")) :toBe activation))
            (setq fail t)
            (let ((n 0)) (while (and (< n 20) (not (= (nativeGet (js-call poller :status) "state") "degraded")))
              (await (funcall step)) (setq n (1+ n))))
            (js-call (expect (nativeGet (nativeGet (js-call poller :status) "native_error") "code")) :toBe 99991672)
            (let* ((user-poller poller)
              (bot-config (js-call (nativeGet (nativeGet f "config") "connections") :find
                (lambda (item) (= (nativeGet item "connection_id") "lark-bot"))))
              (bot-base (js-object
                :nativeRequest (async (path method body context)
                  (js-call (expect (js-call path :startsWith "/open-apis/im/v1/chats?")) :toBe t)
                  (js-object :status 200 :wire (js-object :code 0 :data
                    (js-object :items (js-array (js-object :chat_id "bot-group")) :has_more false))))
                :history (async (parameters context)
                  (let ((chat (nativeGet parameters "chat_id")))
                    (success (js-object :messages (js-array (js-object :message_id (str "bot-http-" chat)
                      :chat_id chat :content "bot message" :create_time (str (Date/parse (js-call clock :utcNow)))
                      :sender (js-object :id "peer-bot" :sender_type "app" :id_type "app_id")
                      :mentions (js-array (js-object :id "ou_bot" :id_type "open_id")))) :has_more false)))))))
              (let ((private (createdEvent "lark-bot" "bot-known-private" "known private")))
                (put private :chat_type "p2p") (await (js-call f :ingest private)))
              (setq bot-poller (createLarkInboxPoller bot-config host bot-base normalizeLarkEvent))
              (js-call bot-poller :initialize application)
              (setq poller bot-poller)
              (let ((n 0)) (while (< n 12) (await (funcall step)) (setq n (1+ n))))
              (js-call (expect (nativeGet (js-call bot-poller :status) "interval_seconds")) :toBe 2)
              (js-call (expect (nativeGet (js-call bot-poller :status) "state")) :toBe "ready")
              (js-call (expect (nativeGet (js-call user-poller :status) "state")) :toBe "degraded")
              (let ((rows (js-call (js-call db :query
                  "SELECT payload FROM im_event_inbox WHERE connection_id='lark-bot'") :all)))
                (js-call (expect (js-length rows)) :toBe 2)
                (js-call rows :forEach (lambda (row)
                  (let ((event (JSON/parse (nativeGet row "payload"))))
                    (js-call (expect (nativeGet (nativeGet event "sender") "kind")) :toBe "bot")
                    (js-call (expect (nativeGet event "receive_transport")) :toBe "poll")))))
              (js-call user-poller :close))
            (finally (when poller (js-call poller :close))
              (when bot-poller (js-call bot-poller :close)) (await (closeFixture f)))))))
    (lambda (unused) nil))
  (withCase "T01.lark-key-api.integration" (lambda () nil)
    (async (unused)
      (let* ((calls (js-array)) (credentials 0)
             (host (js-object :clock (js-object :monoNow (lambda () (performance/now))
                        :utcNow (lambda () "2026-01-01T00:00:12.000Z"))
               :credentials (js-object :resolve (async (ref)
                 (setq credentials (1+ credentials))
                 (js-call (expect ref) :toBe "secrets/app.json")
                 (js-object :app_id "test-app" :app_secret "test-secret")))
               :http (js-object :fetch (async (url options)
                 (js-call calls :push (js-object :url url :options options))
                 (cond
                   ((js-call url :endsWith "/auth/v3/tenant_access_token/internal")
                     (js-call (expect (JSON/parse (nativeGet options "body"))) :toEqual
                       (js-object :app_id "test-app" :app_secret "test-secret"))
                     (Response/json (js-object :code 0 :tenant_access_token "test-token" :expire 7200)))
                   ((= (nativeGet options "method") "GET")
                     (js-call (expect (nativeGet (nativeGet options "headers") "authorization")) :toBe "Bearer test-token")
                     (Response/json (js-object :code 0 :data (js-object :has_more false :items
                       (js-array (js-object :message_id "key-source" :chat_id "key-chat" :msg_type "text"
                         :create_time "1767225605000" :sender (js-object :id "sender" :sender_type "user")
                         :body (js-object :content "{\"text\":\"key-driven\"}")))))))
                   (t (Response/json (js-object :code 0 :data
                     (js-object :message_id "key-reply" :chat_id "key-chat")))))))))
             (config (js-object :connection_id "key-lark" :platform "lark" :brand "lark" :identity "bot"
                       :credential_ref "secrets/app.json" :watches (js-array)))
             (port (createLarkPort config host))
             (context (js-object :deadline (+ (performance/now) 5000))))
        (try
          (let* ((page (await (js-call port :readPollPage (js-object :chat_id "key-chat")
                     (js-object :activation_at "2026-01-01T00:00:00.000Z"
                       :window_start "2026-01-01T00:00:00.000Z" :window_end "2026-01-01T00:00:10.000Z"
                       :identity_revision 1 :generation 1) nil context)))
                 (event (aref (nativeGet (nativeGet page "data") "messages") 0)))
