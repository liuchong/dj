            (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe "key-driven"))
          (let ((receipt (await (js-call port :send (js-object
              :destination (js-object :connection_id "key-lark" :native_chat_id "key-chat")
              :native_reply_to "key-source" :content (js-object :text "reply")) "key-once" context))))
            (js-call (expect (nativeGet receipt "state")) :toBe "accepted")
            (js-call (expect (nativeGet receipt "native_message_id")) :toBe "key-reply"))
          (js-call (expect credentials) :toBe 1)
          (js-call (expect (js-length calls)) :toBe 3)
          (js-call (expect (nativeGet (aref calls 0) "url")) :toBe
