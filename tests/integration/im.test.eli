          (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
          (let ((connection (aref (nativeGet config "connections") 0))
            (actor (aref (nativeGet config "principals") 2)))
            (js-call (nativeGet connection "watches") :push (js-object :chat_id "c2") (js-object :chat_id "c3"))
            (js-call (nativeGet actor "grants") :push (js-object :action "message.send"
              :resources (js-array (js-object :connection_id "lark" :native_chat_id "c1"))))))
        :before_restart (lambda (config ports)
          (let* ((actor (aref (nativeGet config "principals") 2))
            (grant (js-call (nativeGet actor "grants") :find (lambda (g) (= (nativeGet g "action") "message.send")))))
            (js-call (nativeGet grant "resources") :push (js-object :connection_id "lark" :native_chat_id "c2"))
            (put actor :authorization_revision (1+ (nativeGet actor "authorization_revision")))))))))
    (async (f)
      (let* ((destination (await (callOk f "A" "conversation.resolve"
          (js-object :connection_id "lark" :chat_id "c2" :thread_id nil))))
        (args (js-object :destination_ref (nativeGet destination "conversation_ref")
          :content (js-object :type "text" :text "one authorized notification") :idempotency_key "same-logical-send"))
        (denied (await (js-call f :call (nativeGet f "A") "message.send" args))))
        (js-call (expect (nativeGet denied "ok")) :toBe false)
        (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden")
        (js-call (expect (nativeGet denied "effect_state")) :toBe "none")
        (js-call (expect (nativeGet denied "operation_id")) :toBeUndefined)
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
        ;; The operator adds one exact chat scope, then reloads the same identity.
        (await (js-call f :restart))
        (let* ((fresh (await (callOk f "A" "conversation.resolve"
            (js-object :connection_id "lark" :chat_id "c2" :thread_id nil))))
          (allowed-args (Object/assign (js-object) args (js-object :destination_ref (nativeGet fresh "conversation_ref"))))
          (accepted (await (callOk f "A" "message.send" allowed-args)))
          (same (await (callOk f "A" "message.send" allowed-args))))
          (js-call (expect (nativeGet same "outbound_id")) :toBe (nativeGet accepted "outbound_id"))
          (await (js-call f :tick))
          (let ((outbound (await (callOk f "A" "outbound.get" (js-object :outbound_id (nativeGet accepted "outbound_id"))))))
            (js-call (expect (nativeGet outbound "state")) :toBe "accepted")
            (js-call (expect (nativeGet (nativeGet outbound "destination") "native_chat_id")) :toBe "c2")))
        (let* ((old-scope (await (callOk f "A" "conversation.resolve"
            (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
          (original (await (callOk f "A" "message.send" (js-object :destination_ref (nativeGet old-scope "conversation_ref")
            :content (js-object :type "text" :text "original scope retained") :idempotency_key "original-scope")))))
          (await (js-call f :tick))
          (js-call (expect (nativeGet (await (callOk f "A" "outbound.get"
            (js-object :outbound_id (nativeGet original "outbound_id")))) "state")) :toBe "accepted"))
        (let* ((ungranted (await (callOk f "A" "conversation.resolve"
            (js-object :connection_id "lark" :chat_id "c3" :thread_id nil))))
          (still-denied (await (js-call f :call (nativeGet f "A") "message.send"
            (js-object :destination_ref (nativeGet ungranted "conversation_ref")
              :content (js-object :type "text" :text "must not send") :idempotency_key "still-denied")))))
          (js-call (expect (nativeGet (nativeGet still-denied "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet still-denied "effect_state")) :toBe "none"))
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 2)))
    closeFixture))
