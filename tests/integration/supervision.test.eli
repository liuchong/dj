(module dj.tests.integration.supervision
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defasync setup ()
    (let ((f (await (createFixture "supervision" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")))))))
      (put f :agent (await (bindRecipient f))) f))
  (defun target (f) (js-object :agent_id (nativeGet (nativeGet f "agent") "agent_id")))
  (defasync inspect (f) (await (callOk f "A" "session.supervision.get" (target f))))
  (defasync start (f &optional key)
    (await (callOk f "A" "session.supervision.start" (Object/assign (target f)
      (js-object :prompt "继续原任务，保留原目标与预算。" :idle_seconds 30 :check_seconds 10 :idempotency_key (or key "watch-start"))))))
  (defasync cancel (f)
    (await (callOk f "A" "session.supervision.cancel" (Object/assign (target f) (js-object :idempotency_key "watch-cancel")))))
  (defasync steps (f &optional count advance)
    (let ((i 0)) (while (< i (or count 3))
      (js-call (nativeGet f "clock") :advance (or advance 0))
      (await (js-call f :tick))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
      (setq i (1+ i)))))
  (defun peer (f) (nativeGet f "opencode"))
  (defun session (f) (aref (nativeGet (peer f) "sessions") 0))
  (defun inputCount (f) (js-length (nativeGet (peer f) "inputs")))
  (defun query (f sql &rest args)
    (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
      (try (Reflect/apply (nativeGet (js-call db :query sql) "all") (js-call db :query sql) args)
        (finally (js-call db :close)))))
  (withCase "T38.supervision-lifecycle.integration" setup (async (f)
    (js-call (expect (nativeGet (await (inspect f)) "state")) :toBe "inactive")
    (let ((record (await (start f))))
      (js-call (expect (nativeGet record "state")) :toBe "active")
      (js-call (expect (nativeGet record "generation")) :toBe (nativeGet (await (start f)) "generation"))
      (validateResult (js-call operationCatalog :get "session.supervision.start") (js-object :ok t :data record)))
    (let ((status (await (callOk f "A" "service.status" (js-object)))))
      (js-call (expect (JSON/stringify status)) :toContain "session.supervision.start"))
    (put (session f) :runtime_state "busy")
    (await (steps f 3 40000))
    (js-call (expect (inputCount f)) :toBe 0)
    (put (session f) :runtime_state "waiting_permission")
    (await (steps f 2 40000))
    (js-call (expect (inputCount f)) :toBe 0)
    (put (session f) :runtime_state "idle")
    (await (steps f 1 10000))
    (js-call (expect (inputCount f)) :toBe 0)
    (await (steps f 4 10000))
    (js-call (expect (inputCount f)) :toBe 1)
    (let ((input (aref (nativeGet (peer f) "inputs") 0)))
      (js-call (expect (nativeGet (nativeGet input "binding") "native_session_id")) :toBe "s1")
      (js-call (expect (nativeGet (nativeGet (nativeGet input "envelope") "content") "text")) :toContain "继续原任务"))
    (await (steps f 8 10000))
    (js-call (expect (> (inputCount f) 1)) :toBe t)
    (js-call (expect (nativeGet (await (inspect f)) "state")) :toBe "active")
    (js-call (expect (nativeGet (await (cancel f)) "state")) :toBe "cancelled")
    (let ((n (inputCount f))) (await (steps f 3 1000000)) (js-call (expect (inputCount f)) :toBe n))) closeFixture)
  (withCase "T38.supervision-offline.integration" setup (async (f)
    (await (start f))
    (put (session f) :runtime_state "offline") (put (session f) :live_receiver false)
    (await (steps f 3 40000))
    (js-call (expect (inputCount f)) :toBe 0)
    (js-call (expect (nativeGet (await (inspect f)) "state")) :toBe "active")
    (await (js-call f :restart))
    (js-call (expect (nativeGet (await (inspect f)) "state")) :toBe "active")
    (put (session f) :runtime_state "idle") (put (session f) :live_receiver t)
    (await (steps f 1 1000000)) (await (steps f 9 10000))
    (js-call (expect (inputCount f)) :toBe 1)
    (await (cancel f)) (await (js-call f :restart))
    (await (steps f 3 1000000))
    (js-call (expect (inputCount f)) :toBe 1)) closeFixture)
  (withCase "T38.supervision-unknown.integration" setup (async (f)
    (put (nativeGet (peer f) "behavior") :submit "throw")
    (await (start f)) (await (steps f 4 10000))
    (js-call (expect (inputCount f)) :toBe 1)
    (await (steps f 4 1000000))
    (js-call (expect (inputCount f)) :toBe 1)
    (js-call (expect (nativeGet (await (inspect f)) "status")) :toBe "delivery_unknown")
    ;; Unknown native work deliberately prevents a graceful fixture restart.
    ;; Restart persistence is exercised separately without claiming unknown was resolved.
    (await (steps f 4 1000000))
    (js-call (expect (inputCount f)) :toBe 1)
    (await (cancel f))
    (js-call (expect (nativeGet (aref (query f "SELECT state FROM deliveries WHERE origin='direct'") 0) "state")) :toBe "unknown")) closeFixture)
  (withCase "T38.supervision-cancel-race.integration" setup (async (f)
    (await (start f))
    (let ((original (nativeGet (peer f) "probe")) (calls 0) (release nil))
      (put (peer f) :probe (async (target binding context)
        (setq calls (1+ calls))
        (when (= calls 2)
          (await (new globalThis.Promise (lambda (done) (setq release done)))))
        (await (funcall original target binding context))))
      (try
        (await (steps f 1 31000))
        (js-call (expect (not (not release))) :toBe t)
        (await (cancel f)) (funcall release)
        (await (steps f 3 0))
        (js-call (expect (inputCount f)) :toBe 0)
        (js-call (expect (js-length (query f "SELECT delivery_id FROM deliveries WHERE origin='direct'"))) :toBe 0)
        (finally (when release (funcall release)) (put (peer f) :probe original))))) closeFixture)
  (withCase "T38.supervision-queued-cancel.integration" setup (async (f)
    (await (start f))
    (let ((original (nativeGet (peer f) "probe")) (calls 0))
      (put (peer f) :probe (async (target binding context)
        (setq calls (1+ calls))
        (let ((result (await (funcall original target binding context))))
          (when (> calls 2) (put result :runtime_state "busy")) result)))
      (try
        (await (steps f 1 31000)) (await (steps f 3 0))
        (js-call (expect (inputCount f)) :toBe 0)
        (js-call (expect (js-length (query f "SELECT delivery_id FROM deliveries WHERE origin='direct'"))) :toBe 1)
        (await (cancel f))
        (put (peer f) :probe original)
        (await (steps f 3 1000000))
        (js-call (expect (inputCount f)) :toBe 0)
        (js-call (expect (nativeGet (aref (query f "SELECT state FROM deliveries WHERE origin='direct'") 0) "state")) :toBe "cancelled")
        (finally (put (peer f) :probe original))))) closeFixture)
  (withCase "T38.supervision-isolation.integration" setup (async (f)
    (await (start f))
    (let ((result (await (js-call f :call (nativeGet f "B") "session.supervision.cancel"
      (Object/assign (target f) (js-object :idempotency_key "other-cancel"))))))
      (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "forbidden"))
    (let ((result (await (js-call f :call (nativeGet f "X") "session.supervision.get" (target f)))))
      (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "forbidden"))
    (let ((args (Object/assign (target f) (js-object :idempotency_key "watch-start" :prompt "changed"))))
      (js-call (expect (nativeGet (nativeGet (await (js-call f :call (nativeGet f "A") "session.supervision.start" args)) "error") "code")) :toBe "idempotency_conflict"))
    (js-call (expect (nativeGet (await (inspect f)) "state")) :toBe "active")
    (let ((result (await (js-call f :call (nativeGet f "A") "session.supervision.start"
      (Object/assign (target f) (js-object :prompt "invalid" :idle_seconds 0 :idempotency_key "invalid"))))))
      (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "invalid_argument"))) closeFixture)
  (withCase "T38.supervision-crash-ledger.integration" setup (async (f)
    (await (start f)) (await (steps f 4 10000))
    (let* ((watch (await (inspect f))) (key (nativeGet watch "session_key"))
      (wake-key (str "supervision:" (nativeGet watch "generation") ":" (nativeGet watch "wake_sequence"))))
      (js-call (expect (inputCount f)) :toBe 1)
      ;; Simulate death after outbox commit, before linking the accepted operation.
      (query f "UPDATE session_supervisions SET next_check_at=?,payload=json_set(payload,'$.next_check_at',?,'$.pending_key',?,'$.delivery_id',null) WHERE session_key=?"
        (js-call (nativeGet f "clock") :utcNow) (js-call (nativeGet f "clock") :utcNow) wake-key key)
      (await (js-call f :restart))
      (await (steps f 2 0))
      (js-call (expect (inputCount f)) :toBe 1)
      (js-call (expect (js-length (query f "SELECT delivery_id FROM deliveries WHERE origin='direct'"))) :toBe 1)
      (js-call (expect (nativeGet (await (inspect f)) "last_error")) :toBe nil))) closeFixture)
  (withCase "T38.supervision-existing-work.integration" setup (async (f)
    (await (start f))
    (put (session f) :runtime_state "busy")
    (await (callOk f "O" "session.send" (Object/assign (target f)
      (js-object :content (js-object :type "text" :text "original work") :delivery_policy (js-object :busy "queue") :idempotency_key "original"))))
    (await (steps f 3 20000))
    (put (session f) :runtime_state "idle") (await (steps f 2 10000))
    (js-call (expect (js-length (query f "SELECT delivery_id FROM deliveries WHERE json_extract(payload,'$.supervision_key') IS NOT NULL"))) :toBe 0)
    (await (cancel f))) closeFixture))
