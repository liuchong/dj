(module dj.tests.integration.cli
  (import "../../src/core/native.eli" nativeGet)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk successful subscribe createdEvent)
  (import "../support/process.eli" until)
  (defconst cliFixtureSource "const readline=globalThis.fixtureReadline;\nconst tool=process.env.DJ_NATIVE_FIXTURE_TOOL;\nlet count=0,turn=0;\nconst write=x=>process.stdout.write(JSON.stringify(x)+'\\n');\nconst rl=readline.createInterface({input:process.stdin});\nrl.on('line',line=>{const w=JSON.parse(line),p=w.params||{},reply=result=>write({jsonrpc:'2.0',id:w.id,result});\nif(w.method==='initialized') return;\nif(w.method==='initialize') return reply({protocolVersion:1,agentCapabilities:{},authMethods:[{id:'cursor_login'}]});\nif(w.method==='authenticate') return reply({});\nif(w.method==='thread/start') return reply({thread:{id:'codex-native-'+(++count)}});\nif(w.method==='session/new') return reply({sessionId:'cursor-native-'+(++count)});\nif(w.method==='turn/start'||w.method==='session/prompt'){\n const sid=p.threadId||p.sessionId, text=(p.input||p.prompt)[0].text, env=JSON.parse(text);\n if(env.schema_version!==1||env.kind!=='external_message') throw Error('not a DJ envelope');\n const tid='native-turn-'+(++turn),out='native-received:'+env.content.text;\n if(tool==='codex') {reply({turn:{id:tid}});setTimeout(()=>{\n  write({method:'item/completed',params:{threadId:sid,item:{id:tid+'-item',type:'agentMessage',text:out}}});\n  write({method:'turn/completed',params:{threadId:sid,turn:{id:tid,status:'completed'}}});\n },5);} else {\n  write({jsonrpc:'2.0',method:'session/update',params:{sessionId:sid,update:{sessionUpdate:'agent_message_chunk',content:{type:'text',text:out}}}});\n  setTimeout(()=>reply({stopReason:'end_turn'}),5);\n } return;\n}\nwrite({id:w.id,error:{code:-32601,message:'unsupported fixture method'}});\n});\nrl.on('close',()=>process.exit(0));")
  (defasync setupCli ()
    (await (createFixture "cli-native" "one" (js-object
      :configure (lambda (config ports)
        (put (nativeGet ports "clock") :monoNow (lambda () (performance/now)))
        (put config :agent_endpoints (js-array))
        (put config :managed_profiles (js-call (js-array "codex" "cursor") :map
          (lambda (tool) (Object/assign (if (= tool "cursor") (js-object :auth_method "cursor_login") (js-object))
           (js-object :profile_id (str tool "-cli") :tool tool :revision 1
            :native_namespace (str tool "-cli") :cwd (js-call globalThis.process :cwd)
            :workspace_refs (js-array "ws-test") :auto_start false
            :argv (js-array (nativeGet globalThis.process "execPath") "-e" "import readline from 'node:readline';globalThis.fixtureReadline=readline;eval(process.env.DJ_NATIVE_FIXTURE_SOURCE)")
            :env (js-object :DJ_NATIVE_FIXTURE_TOOL tool :DJ_NATIVE_FIXTURE_SOURCE cliFixtureSource))))))
        (js-call (nativeGet config "principals") :forEach (lambda (principal)
          (when (js-call (js-array "A" "B") :includes (nativeGet principal "principal_id"))
            (let ((tool (if (= (nativeGet principal "principal_id") "A") "codex" "cursor")))
              (put principal :target_constraint (js-object :tool tool :native_namespace (str tool "-cli")
                :native_session_id (str tool "-native-1")))))))))))
  )
  (defasync waitLifecycle (f action expected)
    (let ((result nil))
      (await (until "CLI lifecycle" (async ()
        (successful (await (js-call f :tick)))
        (setq result (await (callOk f "O" "lifecycle.get"
          (js-object :lifecycle_id (nativeGet action "lifecycle_id")))))
        (= (nativeGet result "state") expected)) 5000))
      result))
  (withCase "T01.cli-relay.integration" setupCli
    (async (f)
      (let ((index 0) (instances (js-array)) (deliveries (js-array)))
        (while (< index 2)
          (let* ((tool (if (= index 0) "codex" "cursor")) (actor (if (= index 0) "A" "B"))
                 (start (await (callOk f "O" "instance.start" (js-object
                   :profile_id (str tool "-cli") :expected_profile_revision 1 :idempotency_key (str tool "-start")))))
                 (ready (await (waitLifecycle f start "ready")))
                 (instance (await (callOk f "O" "instance.get" (js-object :instance_id (nativeGet ready "instance_id")))))
                 (creation (await (callOk f "O" "session.create" (js-object
                   :instance_id (nativeGet instance "instance_id") :expected_instance_epoch (nativeGet instance "instance_epoch")
                   :workspace_ref "ws-test" :idempotency_key (str tool "-create")))))
                 (created (await (waitLifecycle f creation "ready")))
                 (session (await (callOk f "O" "session.get" (js-object :session_key (nativeGet created "session_key"))))))
            (js-call instances :push instance)
            (js-call (expect (nativeGet session "native_session_id")) :toBe (str tool "-native-1"))
            (js-call (expect (nativeGet session "runtime_state")) :toBe "idle")
            (let ((sent (await (callOk f "O" "session.send" (js-object
                    :session_ref (nativeGet session "session_ref") :content (js-object :type "text" :text (str "direct-" tool))
                    :idempotency_key (str tool "-direct"))))))
              (js-call deliveries :push (nativeGet sent "delivery_id")))
            (await (until "CLI direct receipt" (async ()
              (successful (await (js-call f :tick)))
              (= (nativeGet (await (callOk f "O" "delivery.get"
                   (js-object :delivery_id (aref deliveries index)))) "state") "accepted")) 5000))
            (let* ((page (await (callOk f "O" "agent.discover" (js-object :tool tool :scope "live"))))
                   (candidate (aref (nativeGet page "items") 0))
                   (agent (await (callOk f "O" "agent.register" (js-object
                     :candidate_ref (nativeGet candidate "candidate_ref") :display_name (str tool " native CLI")
                     :binding_mode "managed" :recipient_principal_id actor
                     :idempotency_key (str tool "-register"))))))
              (await (subscribe f agent "lark" 120 actor))))
          (setq index (1+ index)))
        (successful (await (js-call f :ingest (createdEvent "lark" "cli-sub-event" "subscribed-source"))))
        (await (until "CLI subscription receipts" (async ()
          (successful (await (js-call f :tick)))
          (let ((rows (nativeGet (await (callOk f "O" "delivery.list" (js-object))) "items")))
            (and (= (js-length rows) 4) (js-call rows :every (lambda (row) (= (nativeGet row "state") "accepted")))))) 5000))
        (let ((rows (nativeGet (await (callOk f "O" "delivery.list" (js-object))) "items")) (n 0))
          (while (< n (js-length rows))
            (let* ((row (aref rows n))
                   (detail (await (callOk f "O" "delivery.get" (js-object :delivery_id (nativeGet row "delivery_id"))))))
              (js-call (expect (nativeGet detail "state")) :toBe "accepted")
              (js-call (expect (> (js-length (nativeGet detail "receipts")) 0)) :toBe t)
              (when (= (nativeGet detail "origin") "subscription_event")
                (let* ((agent (await (callOk f "O" "agent.get" (js-object :agent_id (nativeGet detail "agent_id")))))
                       (actor (if (= (nativeGet agent "tool") "codex") "A" "B")))
                  (await (callOk f actor "message.reply" (js-object
                    :reply_context_id (nativeGet detail "reply_context_id")
                    :content (js-object :type "text" :text (str "native-reply-" actor))
                    :idempotency_key (str "native-reply-" actor)))))))
            (setq n (1+ n))))
        (await (until "CLI original-conversation replies" (async ()
          (successful (await (js-call f :tick)))
          (= (js-length (nativeGet (nativeGet f "lark") "sent")) 2)) 5000))
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 2)
        (let ((n 0))
          (while (< n 2)
            (let* ((instance (aref instances n))
                   (action (await (callOk f "O" "instance.stop" (js-object
                     :instance_id (nativeGet instance "instance_id") :expected_revision (nativeGet instance "revision")
                     :idempotency_key (str "stop-" n))))))
              (let ((result (await (waitLifecycle f action "stopped"))))
                (js-call (expect (nativeGet result "state")) :toBe "stopped")))
            (setq n (1+ n))))
        (js-call (expect (nativeGet (successful (await (js-call f :close))) "state")) :toBe "stopped")
        ;; Preserve a stopped row and repair the historical stopping projection
        ;; only from its exact, native-confirmed terminal stop action.
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
          (try
            (js-call (js-call db :query
              "UPDATE instances SET state='stopping',revision=revision+1,payload=json_set(payload,'$.state','stopping','$.revision',revision+1) WHERE instance_id=?")
              :run (nativeGet (aref instances 0) "instance_id"))
            (finally (js-call db :close))))
        (await (js-call f :restart))
        (let ((n 0))
          (while (< n (js-length instances))
            (let ((instance (await (callOk f "O" "instance.get"
                    (js-object :instance_id (nativeGet (aref instances n) "instance_id"))))))
              (js-call (expect (nativeGet instance "state")) :toBe "stopped"))
            (setq n (1+ n))))
        (js-call (expect (nativeGet (successful (await (js-call f :close))) "state")) :toBe "stopped")))
    closeFixture))
