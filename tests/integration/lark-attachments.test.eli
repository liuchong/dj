(module dj.tests.integration.lark-attachments
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../../src/adapters/im/lark-http.eli" formatLarkMessage)
  (import "../../src/adapters/im/lark.eli" createLarkPort)
  (import "../../src/delivery/envelope.eli" renderEnvelope)
  (import "../../src/attachments/notification.eli" cursorAttachmentContext)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe)
  (import "../support/case.eli" withCase)
  (import "node:fs/promises" readFile)
  (import "bun:test" expect)

  (defconst imageBytes "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/q1sAAAAASUVORK5CYII=")

  (defun mediaFixture ()
    (let ((calls (js-array)) (config-ref (js-object)))
      (createFixture "lark-attachments" "one" (js-object :configure (lambda (config ports)
        (let ((connection (aref (nativeGet config "connections") 0)))
          (put config-ref :connection connection) (put config-ref :calls calls)
          (put connection :event_app_id "cli_test")
          (put ports :credentials (js-object :resolve (lambda (ref)
            (js-object :app_id "cli_test" :app_secret "test-secret" :user_access_token "user-fixture"))))
          (put ports :http (js-object :fetch (async (address options)
            (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname")))
              (js-call calls :push (js-object :path path :query (nativeGet url "search")
                :authorization (nativeGet (nativeGet options "headers") "authorization")))
              (cond
                ((js-call path :endsWith "/user_info")
                  (Response/json (js-object :code 0 :data (js-object :open_id "ou_user"))))
                ((js-call path :endsWith "/img_fixture")
                  (new globalThis.Response (Buffer/from imageBytes "base64")
                    (js-object :headers (js-object :content-type "image/png"))))
                ((js-call path :endsWith "/file_denied")
                  (Response/json (js-object :code 99991672) (js-object :status 403)))
                ((= path "/open-apis/drive/v1/export_tasks")
                  (Response/json (js-object :code 0 :data (js-object :ticket "export_example"))))
                ((= path "/open-apis/drive/v1/export_tasks/export_example")
                  (Response/json (js-object :code 0 :data (js-object :result
                    (js-object :job_status 0 :file_token "pdf_example" :file_name "Guide")))))
                ((= path "/open-apis/drive/v1/export_tasks/file/pdf_example/download")
                  (new globalThis.Response "%PDF-example" (js-object :headers (js-object :content-type "application/pdf"))))
                (t (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false)))))))))
          (let* ((native (createLarkPort connection ports)) (fake (js-call (nativeGet ports "im_ports") :get "lark")))
            ;; Keep the fixture conversation catalogue while using the production resource path.
            (put fake :downloadAttachment (nativeGet native "downloadAttachment"))
            (put fake :media_fixture config-ref))))))))

  (withCase "T40.lark-attachments.integration" mediaFixture
    (async (f)
      (let* ((fixture (nativeGet (nativeGet f "lark") "media_fixture"))
             (connection (nativeGet fixture "connection"))
             (calls (nativeGet fixture "calls"))
             (agent (await (bindRecipient f)))
             (sub (await (subscribe f agent "lark")))
             (raw (JSON/stringify (js-object :en_us (js-object :title "Release notes" :content
               (js-array (js-array (js-object :tag "a" :text "Guide" :href "https://demo.larksuite.com/docx/doc_example")
                 (js-object :tag "img" :image_key "img_fixture")
                 (js-object :tag "file" :file_key "file_denied" :file_name "missing.txt")))))))
             (message (js-object :message_id "om_media" :chat_id "c1" :message_type "post" :chat_type "group"
               :content raw :create_time (str (Date/parse "2026-01-01T00:00:00.000Z"))))
             (ws (flattenLarkEvent (js-object
               :header (js-object :app_id "cli_test" :event_type "im.message.receive_v1")
               :event (js-object :message message :sender (js-object :sender_type "user"
                 :sender_id (js-object :open_id "ou_other"))))))
             (history (formatLarkMessage (js-object :msg_type "post" :body (js-object :content raw)) nil))
             (event (normalizeLarkEvent connection ws))
             (ingested (await (js-call f :ingest event)))
             (event-id (nativeGet (nativeGet ingested "data") "event_id"))
             (inputs (nativeGet (nativeGet f "opencode") "inputs"))
             (turn 0))
        (js-call (expect (nativeGet history "parsed_content")) :toEqual (nativeGet ws "parsed_content"))
        (js-call (expect (nativeGet (nativeGet event "content") "text")) :toBe "Release notes\nGuide[image]")
        (js-call (expect (nativeGet ingested "ok")) :toBe t)
        (while (and (< turn 30) (= (js-length inputs) 0))
          (await (js-call f :tick))
          (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 5))))
          (setq turn (1+ turn)))
        (js-call (expect (js-length inputs)) :toBe 1)
        (let* ((envelope (nativeGet (aref inputs 0) "envelope"))
               (assets (nativeGet envelope "attachments"))
               (rendered (renderEnvelope envelope))
               (image (js-call assets :find (lambda (item) (= (nativeGet item "kind") "image"))))
               (file (js-call assets :find (lambda (item) (= (nativeGet item "kind") "file")))))
          (js-call (expect (nativeGet (nativeGet envelope "message_source") "message_id")) :toBe "om_media")
          (js-call (expect rendered) :toContain "[Guide](<https://demo.larksuite.com/docx/doc_example>)")
          (js-call (expect rendered) :toContain "# attachments")
          (js-call (expect (nativeGet image "state")) :toBe "ready")
          (js-call (expect (js-call (await (readFile (nativeGet image "local_path"))) :toString "base64")) :toBe imageBytes)
          (js-call (expect (nativeGet file "state")) :toBe "forbidden")
          (js-call (expect (nativeGet (nativeGet file "source") "file_key")) :toBe "file_denied")
          (let* ((view (await (callOk f "O" "message.get" (js-object :event_id event-id))))
                 (document (js-call (nativeGet view "attachments") :find (lambda (item) (= (nativeGet item "kind") "document"))))
                 (ref (nativeGet document "attachment_ref"))
                 (count (js-length calls))
                 (local (await (callOk f "O" "message.attachment.get" (js-object :attachment_ref ref))))
                 (native (await (callOk f "O" "message.attachment.get" (js-object :attachment_ref ref :corpus "native")))))
            (js-call (expect (js-call (js-array "ready" "not_cached") :includes (nativeGet local "state"))) :toBe t)
            (js-call (expect (nativeGet native "state")) :toBe "ready")
            (js-call (expect (await (readFile (nativeGet native "local_path") "utf8"))) :toBe "%PDF-example")
            (let* ((cursor (await (cursorAttachmentContext (js-array image native file))))
                   (image-input (aref (nativeGet cursor "selectedImages") 0))
                   (document-input (aref (nativeGet cursor "selectedDocuments") 0)))
              (js-call (expect (nativeGet image-input "dimension")) :toEqual (js-object :width 1 :height 1))
              (js-call (expect (nativeGet document-input "path")) :toBe (nativeGet native "local_path")))
            (js-call (expect (js-call calls :some (lambda (row)
              (and (= (nativeGet row "path") "/open-apis/im/v1/messages/om_media/resources/img_fixture")
                (= (nativeGet row "query") "?type=image") (= (nativeGet row "authorization") "Bearer user-fixture"))))) :toBe t)
            (let* ((before (js-length calls))
                   (again (await (callOk f "O" "message.attachment.get" (js-object :attachment_ref ref :corpus "native")))))
              (js-call (expect (nativeGet again "local_path")) :toBe (nativeGet native "local_path"))
              (js-call (expect (js-length calls)) :toBe before))
            (let ((foreign (await (js-call f :call (nativeGet f "B") "message.attachment.get" (js-object :attachment_ref ref)))))
              (js-call (expect (nativeGet foreign "ok")) :toBe false))))))
    closeFixture))
