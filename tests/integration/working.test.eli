(module dj.tests.integration.working
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark-http.eli" createLarkHttpTransport)
  (import "../../src/adapters/im/lark.eli" createLarkPort)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (let ((marks (new globalThis.Map)) (calls (js-array)) (behavior (js-object)))
      (let ((f (await (createFixture "working" "one" (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array))
        (put (aref (nativeGet config "principals") 3) :target_constraint (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s2"))
        (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (let ((connection (aref (nativeGet config "connections") 0))
          (port (js-call (nativeGet ports "im_ports") :get "lark")))
          (put connection :identity "bot") (put connection :event_app_id "test-app")
          (put port :reaction (async (command args context)
            (js-call calls :push command)
            (cond ((= command "list") (js-object :ok t :data (js-object :items (js-call (Array/from (js-call marks :values)) :filter (lambda (mark) (and (= (nativeGet (nativeGet mark "reaction_type") "emoji_type") (nativeGet args "emoji_type" "Typing")) (or (not (nativeGet mark "native_message_id")) (= (nativeGet mark "native_message_id") (nativeGet args "message_id")))))) :has_more false)))
              ((= command "create")
                (let ((id (str (if (= (nativeGet args "emoji_type") "Get") "get-rid" "rid") ":" (nativeGet args "message_id"))))
                  (js-call marks :set id (js-object :reaction_id id :native_message_id (nativeGet args "message_id") :reaction_type (js-object :emoji_type (nativeGet args "emoji_type" "Typing"))
                    :operator (js-object :operator_type "app" :operator_id "test-app"))))
                (when (nativeGet behavior "lose_create") (put behavior :lose_create false) (throw (new globalThis.Error "lost create response")))
                (js-object :ok t :data (js-object :reaction_id (str (if (= (nativeGet args "emoji_type") "Get") "get-rid" "rid") ":" (nativeGet args "message_id")))))
              (t (js-call marks :delete (nativeGet args "reaction_id"))
                (when (nativeGet behavior "lose_delete") (put behavior :lose_delete false) (throw (new globalThis.Error "lost delete response")))
                (js-object :ok t :data (js-object)))))))))))))
        (put f :marks marks) (put f :reaction_calls calls) (put f :reaction_behavior behavior) f)))
  (defasync turns (f n)
    (let ((i 0)) (while (< i n) (await (js-call f :tick)) (setq i (1+ i)))))
  (defun input (f index) (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") index) "envelope"))
  (defasync complete (f actor envelope key)
    (callOk f actor "delivery.complete" (js-object :delivery_id (nativeGet envelope "delivery_id") :reason "no_reply" :idempotency_key key)))
  (withCase "T38.working-replay.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (js-call f :ingest (createdEvent "lark" "missed-before-subscribe" "old real message")))
      (await (turns f 1))
      (let* ((sub (await (subscribe f agent "lark")))
        (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
        (event-id (nativeGet (js-call (js-call db :query "SELECT event_id FROM events WHERE native_message_id='missed-before-subscribe'") :get) "event_id"))
        (args (js-object :subscription_id (nativeGet sub "subscription_id") :expected_revision 1 :event_ids (js-array event-id) :idempotency_key "recover-one")))
        (js-call db :close)
        (await (callOk f "A" "subscription.replay" args)) (await (callOk f "A" "subscription.replay" args))
        (await (turns f 4))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
        (let ((envelope (input f 0)))
          (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
            :content (js-object :type "text" :text "deliberate reply") :idempotency_key "working-reply")))
          (await (turns f 4))
          (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done"))))) closeFixture)
  (withCase "T40.working-recovery.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (subscribe f agent "lark"))
      (put (nativeGet f "reaction_behavior") :lose_create t)
      (await (js-call f :ingest (createdEvent "lark" "uncertain-marker" "do not reply")))
      (await (turns f 3)) (js-call (nativeGet f "clock") :advance 11000) (await (turns f 2))
      (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (let ((envelope (input f 0)))
        (let ((denied (await (js-call f :call (nativeGet f "B") "delivery.complete"
          (js-object :delivery_id (nativeGet envelope "delivery_id") :reason "no_reply" :idempotency_key "other-cannot-finish")))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (put (nativeGet f "reaction_behavior") :lose_delete t)
        (await (complete f "A" envelope "no-reply")) (await (turns f 1))
        (await (js-call f :restart)) (js-call (nativeGet f "clock") :advance 11000) (await (turns f 2))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done")
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)))) closeFixture)
  (withCase "T40.working-lifecycle.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (candidates (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
      (candidate (js-call candidates :find (lambda (x) (= (nativeGet x "native_session_id") "s2"))))
      (other (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name "other" :binding_mode "existing" :recipient_principal_id "B" :idempotency_key "register-B")))))
      (await (subscribe f agent "lark")) (await (subscribe f other "lark" 86400 "B"))
      (await (js-call f :ingest (createdEvent "lark" "shared-marker" "shared work")))
      (await (turns f 4))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet (input f 0) "reply_context_id") :idempotency_key "ack-A")))
      (await (turns f 4))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 2)
      (js-call (expect (js-call (nativeGet f "marks") :has "rid:shared-marker")) :toBe t)
      ;; Missing completion from the other recipient cannot leave the marker forever.
      (js-call (nativeGet f "clock") :advance 1801000) (await (turns f 3))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:shared-marker")) :toBe t)
      (js-call (nativeGet f "marks") :set "manual" (js-object :reaction_id "manual" :reaction_type (js-object :emoji_type "Typing")
        :operator (js-object :operator_type "app" :operator_id "test-app")))
      (await (js-call f :ingest (createdEvent "lark" "preexisting-marker" "manual marker remains")))
      (await (turns f 4))
      (js-call (expect (js-call (nativeGet f "marks") :has "manual")) :toBe t))) closeFixture)
  (withCase "T40.message-acknowledgement.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (subscribe f agent "lark"))
      (await (js-call f :ingest (createdEvent "lark" "acknowledge-without-reply" "received, no textual reply needed")))
      (await (turns f 4))
      (let* ((envelope (input f 0))
        (args (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "acknowledge-once"))
        (creates-before (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))))
        (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "B") "message.acknowledge" args)) "ok")) :toBe false)
        ;; Failed lease completion must roll back the Get intent in the same transaction.
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
          (try
            (js-call db :run "CREATE TRIGGER test_ack_atomic BEFORE UPDATE OF state ON work_items WHEN NEW.state='completed' BEGIN SELECT RAISE(ABORT,'test_ack_atomic'); END")
            (let ((denied (await (js-call f :call (nativeGet f "A") "message.acknowledge"
              (Object/assign (js-object) args (js-object :idempotency_key "atomic-ack-failure"))))))
              (js-call (expect (nativeGet denied "ok")) :toBe false))
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM work_marks WHERE json_extract(payload,'$.acknowledgement')=1") :get) "n")) :toBe 0)
            (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "state")) :toBe "active")
            (finally (js-call db :run "DROP TRIGGER IF EXISTS test_ack_atomic") (js-call db :close))))
        (let* ((ack (await (callOk f "A" "message.acknowledge" args)))
          (id (nativeGet ack "acknowledgement_id")))
          (js-call (expect (nativeGet ack "native_acknowledged")) :toBe false)
          (js-call (expect (nativeGet ack "emoji_type")) :toBe "Get")
          (let ((working (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id"))))))
            (js-call (expect (nativeGet working "state")) :toBe "completed")
            (js-call (expect (nativeGet working "reason")) :toBe "no_reply"))
          (js-call (expect (nativeGet (await (callOk f "A" "message.acknowledge" args)) "acknowledgement_id")) :toBe id)
          (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "B") "message.acknowledge.get" (js-object :acknowledgement_id id))) "ok")) :toBe false)
          ;; A lost POST response must be reconciled by GET, without another POST.
          (put (nativeGet f "reaction_behavior") :lose_create t)
          (await (turns f 1))
          (await (js-call f :restart))
          (js-call (nativeGet f "clock") :advance 11000) (await (turns f 4))
          (let ((confirmed (await (callOk f "A" "message.acknowledge.get" (js-object :acknowledgement_id id)))))
            (js-call (expect (nativeGet confirmed "native_acknowledged")) :toBe t)
            (js-call (expect (nativeGet confirmed "state")) :toBe "done")
            (js-call (expect (nativeGet confirmed "reaction_id")) :toBe "get-rid:acknowledge-without-reply"))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done")
          (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:acknowledge-without-reply")) :toBe t)
          (js-call (expect (js-call (nativeGet f "marks") :has "rid:acknowledge-without-reply")) :toBe false)
          (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe (1+ creates-before))
          (put args :idempotency_key "same-acknowledgement-new-request")
          (js-call (expect (nativeGet (await (callOk f "A" "message.acknowledge" args)) "native_acknowledged")) :toBe t)
          (await (turns f 2))
          (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe (1+ creates-before))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))))) closeFixture)
  (withCase "T40.acknowledgement-isolation.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (peer (nativeGet f "opencode")))
      (await (subscribe f agent "lark"))
      (await (js-call f :ingest (createdEvent "lark" "original-task" "still processing")))
      (await (turns f 4))
      (await (js-call f :ingest (createdEvent "lark" "additional-context" "supplement incorporated")))
      (await (turns f 4))
      (let ((original (input f 0)) (supplement (input f 1)))
        (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet supplement "reply_context_id") :idempotency_key "ack-supplement")))
        (await (turns f 4))
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet original "delivery_id")))) "state")) :toBe "active")
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet supplement "delivery_id")))) "state")) :toBe "completed")
        (js-call (expect (js-call (nativeGet f "marks") :has "rid:original-task")) :toBe t)
        (js-call (expect (js-call (nativeGet f "marks") :has "rid:additional-context")) :toBe false)
        (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:additional-context")) :toBe t)
        (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:original-task")) :toBe false)
        (await (complete f "A" original "finish-original"))
        (await (turns f 4)))
      ;; A receiver may acknowledge while native submit has not returned accepted.
      (let ((submit (nativeGet peer "submit")))
        (put peer :submit (async (binding envelope mode key context)
          (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "ack-before-receipt")))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "state")) :toBe "completed")
          (funcall submit binding envelope mode key context)))
        (try
          (await (js-call f :ingest (createdEvent "lark" "early-ack" "understood before receipt")))
          (await (turns f 5))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet (input f 2) "delivery_id")))) "state")) :toBe "completed")
          (js-call (expect (js-call (nativeGet f "marks") :has "rid:early-ack")) :toBe false)
          (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:early-ack")) :toBe t)
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
          (finally (put peer :submit submit)))))) closeFixture)
  (withCase "T38.working-http.integration" (lambda () nil) (async (unused)
    (let* ((calls (js-array))
      (host (js-object :clock (js-object :monoNow (lambda () (performance/now))) :credentials (js-object :resolve (async (ref) (js-object :app_id "app" :app_secret "private")))
        :http (js-object :fetch (async (url options)
          (js-call calls :push (js-object :url url :method (nativeGet options "method") :body (nativeGet options "body")))
          (new globalThis.Response (JSON/stringify (if (js-call url :includes "tenant_access_token")
            (js-object :code 0 :tenant_access_token "test-token" :expire 3600)
            (js-object :code 0 :data (if (= (nativeGet options "method") "GET")
              (js-object :items (js-array) :has_more false) (js-object :reaction_id "reaction/id"))))) (js-object :status 200))))))
      (transport (createLarkHttpTransport (js-object :identity "bot" :credential_ref "credential") host))
      (ctx (js-object :deadline (+ (performance/now) 2000))))
      (await (js-call transport :perform "reaction_list" (js-object :message_id "message/id" :emoji_type "Typing") ctx))
      (await (js-call transport :perform "reaction_create" (js-object :message_id "message/id" :emoji_type "Typing") ctx))
      (await (js-call transport :perform "reaction_delete" (js-object :message_id "message/id" :reaction_id "reaction/id") ctx))
      (js-call (expect (nativeGet (aref calls 1) "url")) :toContain "/messages/message%2Fid/reactions?user_id_type=open_id&page_size=50&reaction_type=Typing")
      (js-call (expect (nativeGet (JSON/parse (nativeGet (aref calls 2) "body")) "reaction_type")) :toEqual (js-object :emoji_type "Typing"))
      (js-call (expect (nativeGet (aref calls 3) "method")) :toBe "DELETE")
      (js-call (expect (nativeGet (aref calls 3) "url")) :toContain "/reactions/reaction%2Fid")
      (await (js-call transport :perform "reaction_list" (js-object :message_id "message/id" :emoji_type "Get") ctx))
      (await (js-call transport :perform "reaction_create" (js-object :message_id "message/id" :emoji_type "Get") ctx))
      (js-call (expect (nativeGet (aref calls 4) "url")) :toContain "reaction_type=Get")
      (js-call (expect (nativeGet (JSON/parse (nativeGet (aref calls 5) "body")) "reaction_type")) :toEqual (js-object :emoji_type "Get"))
      (let* ((port (createLarkPort (js-object :connection_id "lark" :identity "bot" :credential_ref "credential" :watches (js-array)) host))
        (response (await (js-call port :reaction "list" (js-object :message_id "message/id") ctx))))
        (js-call (expect (nativeGet response "ok")) :toBe t)
        (js-call (expect (nativeGet (nativeGet response "data") "items")) :toEqual (js-array))
        (await (js-call port :close)))
      (await (js-call transport :close)))) (lambda (unused) nil))
)
