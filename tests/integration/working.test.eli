(module dj.tests.integration.working
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" stableSessionKey)
  (import "../../src/service/main.eli" prepareSocket)
  (import "../../src/interfaces/gepo.eli" handleServiceRequest)
  (import "../../src/interfaces/cli.eli" runCli)
  (import "../../src/adapters/im/lark-http.eli" createLarkHttpTransport)
  (import "../../src/adapters/im/lark.eli" createLarkPort)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent grant successful)
  (import "../support/case.eli" withCase)
  (import "node:fs/promises" chmod mkdir writeFile rm)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defun attachReactionMock (config ports marks calls behavior)
    (put config :managed_profiles (js-array))
    (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
    (let ((connection (aref (nativeGet config "connections") 0))
      (port (js-call (nativeGet ports "im_ports") :get "lark")))
      (put connection :identity "bot") (put connection :event_app_id "test-app")
      (put port :reaction (async (command args context)
        (js-call calls :push command)
        (cond ((= command "list") (js-object :ok t :data (js-object :items (js-call (Array/from (js-call marks :values)) :filter (lambda (mark) (and (= (nativeGet (nativeGet mark "reaction_type") "emoji_type") (nativeGet args "emoji_type" "Typing")) (or (not (nativeGet mark "native_message_id")) (= (nativeGet mark "native_message_id") (nativeGet args "message_id")))))) :has_more false)))
          ((= command "create")
            (let ((id (str (if (= (nativeGet args "emoji_type") "Get") "get-rid" "rid") ":" (nativeGet args "message_id"))))
              (js-call marks :set id (js-object :reaction_id id :native_message_id (nativeGet args "message_id") :reaction_type (js-object :emoji_type (nativeGet args "emoji_type" "Typing"))
                :operator (js-object :operator_type "app" :operator_id "test-app"))))
            (when (nativeGet behavior "lose_create") (put behavior :lose_create false) (throw (new globalThis.Error "lost create response")))
            (js-object :ok t :data (js-object :reaction_id (str (if (= (nativeGet args "emoji_type") "Get") "get-rid" "rid") ":" (nativeGet args "message_id")))))
          (t (if (nativeGet behavior "reject_delete")
              (js-object :ok false :error (js-object :code "unavailable" :details (js-object :http_status 400 :native_code 231003 :reason "native_api_rejected")))
              (progn
                (js-call marks :delete (nativeGet args "reaction_id"))
                (when (nativeGet behavior "lose_delete") (put behavior :lose_delete false) (throw (new globalThis.Error "lost delete response")))
                (js-object :ok t :data (js-object))))))))))
  (defasync setup ()
    (let ((marks (new globalThis.Map)) (calls (js-array)) (behavior (js-object)))
      (let ((f (await (createFixture "working" "one" (js-object :configure (lambda (config ports)
        (js-call (nativeGet (aref (nativeGet config "principals") 2) "grants") :push
          (js-object :action "subscription.consume" :resources (js-array "self")))
        (put (aref (nativeGet config "principals") 3) :target_constraint (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s2"))
        (attachReactionMock config ports marks calls behavior)))))))
        (put f :marks marks) (put f :reaction_calls calls) (put f :reaction_behavior behavior) f)))
  (defasync setupRestrictedCli ()
    (let ((marks (new globalThis.Map)) (calls (js-array)) (behavior (js-object)))
      (let ((f (await (createFixture "working" "cli-restricted" (js-object :configure (lambda (config ports)
        (let ((shared (aref (nativeGet config "principals") 1))
              (restricted (aref (nativeGet config "principals") 2)))
          (put shared :grants (js-array
            (grant "agent.discover" "*")
            (grant "agent.bind" "*")
            (grant "agent.inspect" "*")
            (grant "subscription.manage" "*")
            (grant "subscription.consume" "*")
            (grant "delivery.inspect" "*")
            (grant "delivery.manage" "*")
            (grant "operation.inspect" "*")
            (grant "session.inspect" "*")
            (grant "session.list" "*")
            (grant "session.read" "*")
            (grant "session.send" "*")
            (grant "session.rules.read" "*")
            (grant "session.rules.manage" "*")))
          (put restricted :grants (js-array
            (grant "agent.bind" "agent_stale_closed")
            (grant "subscription.manage" "self")
            (grant "subscription.consume" "self")
            (grant "delivery.inspect" "self")
            (grant "operation.inspect" "self")
            (grant "session.rules.read" (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1"))
            (grant "session.rules.manage" (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1"))))
          (attachReactionMock config ports marks calls behavior))))))))
        (let* ((root (nativeGet f "root"))
               (socket (resolve root "run/dj.sock"))
               (secrets (resolve root "secrets"))
               (restricted-profile (resolve root "client-restricted.json"))
               (shared-profile (resolve root "client-shared.json")))
          (await (chmod root 448))
          (await (chmod (resolve root "run") 448))
          (await (mkdir secrets (js-object :recursive t :mode 448)))
          (await (chmod secrets 448))
          (await (writeFile (resolve secrets "restricted.token") (nativeGet (nativeGet f "credentials") "A") (js-object :mode 384)))
          (await (writeFile (resolve secrets "shared.token") (nativeGet (nativeGet f "credentials") "S") (js-object :mode 384)))
          (await (writeFile restricted-profile (str (JSON/stringify (js-object :schema_version 1 :default_endpoint "local"
            :endpoints (js-array (js-object :endpoint_id "local" :socket_ref "run/dj.sock" :credential_ref "secrets/restricted.token")))) "\n") (js-object :mode 384)))
          (await (writeFile shared-profile (str (JSON/stringify (js-object :schema_version 1 :default_endpoint "local"
            :endpoints (js-array (js-object :endpoint_id "local" :socket_ref "run/dj.sock" :credential_ref "secrets/shared.token")))) "\n") (js-object :mode 384)))
          (successful (await (prepareSocket socket)))
          (let ((server (Bun/serve (js-object :unix socket :fetch (async (request)
            (await (handleServiceRequest request (nativeGet f "core"))))))))
            (put f :uds_server server)
            (put f :restricted_profile restricted-profile)
            (put f :shared_profile shared-profile)))
        (put f :marks marks) (put f :reaction_calls calls) (put f :reaction_behavior behavior) f)))
  (defasync teardownRestrictedCli (f)
    (try
      (when (nativeGet f "uds_server")
        (js-call (nativeGet f "uds_server") :stop t))
      (finally
        (await (closeFixture f))
        (when (nativeGet f "root")
          (await (rm (nativeGet f "root") (js-object :recursive t :force t)))))))
  (defasync turns (f n)
    (let ((i 0)) (while (< i n) (await (js-call f :tick)) (setq i (1+ i)))))
  (defun input (f index) (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") index) "envelope"))
  (defasync complete (f actor envelope key)
    (callOk f actor "delivery.complete" (js-object :delivery_id (nativeGet envelope "delivery_id") :reason "no_reply" :idempotency_key key)))
  (withCase "T38.working-replay.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (js-call f :ingest (createdEvent "lark" "missed-before-subscribe" "old real message")))
      (await (turns f 1))
      (let* ((sub (await (subscribe f agent "lark")))
        (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
        (event-id (nativeGet (js-call (js-call db :query "SELECT event_id FROM events WHERE native_message_id='missed-before-subscribe'") :get) "event_id"))
        (args (js-object :agent_id (nativeGet sub "agent_id") :expected_revision (nativeGet sub "revision") :event_ids (js-array event-id) :idempotency_key "recover-one")))
        (js-call db :close)
        (await (callOk f "A" "subscription.replay" args)) (await (callOk f "A" "subscription.replay" args))
        (await (turns f 4))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
        (let ((envelope (input f 0)))
          (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
            :content (js-object :type "text" :text "deliberate reply") :idempotency_key "working-reply")))
          (await (turns f 4))
          (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done"))))) closeFixture)
  (withCase "T40.working-recovery.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (subscribe f agent "lark"))
      (put (nativeGet f "reaction_behavior") :lose_create t)
      (await (js-call f :ingest (createdEvent "lark" "uncertain-marker" "do not reply")))
      (await (turns f 3)) (js-call (nativeGet f "clock") :advance 11000) (await (turns f 2))
      (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (let ((envelope (input f 0)))
        (let ((denied (await (js-call f :call (nativeGet f "B") "delivery.complete"
          (js-object :delivery_id (nativeGet envelope "delivery_id") :reason "no_reply" :idempotency_key "other-cannot-finish")))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (put (nativeGet f "reaction_behavior") :lose_delete t)
        (await (complete f "A" envelope "no-reply")) (await (turns f 1))
        (await (js-call f :restart)) (js-call (nativeGet f "clock") :advance 11000) (await (turns f 2))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done")
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)))
      ;; Non-ok DELETE response (e.g. HTTP 400 231003) must back off instead of spinning every tick.
      (put (nativeGet f "reaction_behavior") :reject_delete t)
      (await (js-call f :ingest (createdEvent "lark" "rejected-delete" "backoff check")))
      (await (turns f 3))
      (let ((envelope (input f 1)))
        (await (complete f "A" envelope "finish-rejected"))
        (await (turns f 2))
        (let ((calls-after-first (js-length (nativeGet f "reaction_calls"))))
          (js-call (nativeGet f "clock") :advance 2000)
          (await (turns f 3))
          (js-call (expect (js-length (nativeGet f "reaction_calls"))) :toBe calls-after-first)
          (let ((status (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id"))))))
            (js-call (expect (nativeGet status "cleanup_state")) :toBe "removing")
            (js-call (expect (nativeGet status "last_error")) :toBe "reaction_cleanup_pending"))
          (put (nativeGet f "reaction_behavior") :reject_delete false)
          (js-call (nativeGet f "clock") :advance 10000)
          (await (turns f 3))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done")))) closeFixture)
  (withCase "T40.working-lifecycle.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (candidates (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
      (candidate (js-call candidates :find (lambda (x) (= (nativeGet x "native_session_id") "s2"))))
      (other (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name "other" :binding_mode "existing" :recipient_principal_id "B" :idempotency_key "register-B")))))
      (await (subscribe f agent "lark")) (await (subscribe f other "lark" 86400 "B"))
      (await (js-call f :ingest (createdEvent "lark" "shared-marker" "shared work")))
      (await (turns f 4))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet (input f 0) "reply_context_id") :idempotency_key "ack-A")))
      (await (turns f 4))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 2)
      (js-call (expect (js-call (nativeGet f "marks") :has "rid:shared-marker")) :toBe t)
      ;; Missing completion from the other recipient cannot leave the marker forever.
      (js-call (nativeGet f "clock") :advance 1801000) (await (turns f 3))
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:shared-marker")) :toBe t)
      (js-call (nativeGet f "marks") :set "manual" (js-object :reaction_id "manual" :reaction_type (js-object :emoji_type "Typing")
        :operator (js-object :operator_type "app" :operator_id "test-app")))
      (await (js-call f :ingest (createdEvent "lark" "preexisting-marker" "manual marker remains")))
      (await (turns f 4))
      (js-call (expect (js-call (nativeGet f "marks") :has "manual")) :toBe t))) closeFixture)
  (withCase "T40.message-acknowledgement.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (subscribe f agent "lark"))
      (await (js-call f :ingest (createdEvent "lark" "acknowledge-without-reply" "received, no textual reply needed")))
      (await (turns f 4))
      (let* ((envelope (input f 0))
        (args (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "acknowledge-once"))
        (creates-before (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))))
        ;; Failed lease completion must roll back the Get intent in the same transaction.
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
          (try
            (js-call db :run "CREATE TRIGGER test_ack_atomic BEFORE UPDATE OF state ON work_items WHEN NEW.state='completed' BEGIN SELECT RAISE(ABORT,'test_ack_atomic'); END")
            (let ((denied (await (js-call f :call (nativeGet f "B") "message.acknowledge"
              (Object/assign (js-object) args (js-object :idempotency_key "atomic-ack-failure"))))))
              (js-call (expect (nativeGet denied "ok")) :toBe false))
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM work_marks WHERE json_extract(payload,'$.acknowledgement')=1") :get) "n")) :toBe 0)
            (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "state")) :toBe "active")
            (finally (js-call db :run "DROP TRIGGER IF EXISTS test_ack_atomic") (js-call db :close))))
        (let* ((ack (await (callOk f "B" "message.acknowledge" args)))
          (id (nativeGet ack "acknowledgement_id")))
          (js-call (expect (nativeGet ack "native_acknowledged")) :toBe false)
          (js-call (expect (nativeGet ack "emoji_type")) :toBe "Get")
          (let ((working (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id"))))))
            (js-call (expect (nativeGet working "state")) :toBe "completed")
            (js-call (expect (nativeGet working "reason")) :toBe "no_reply"))
          (js-call (expect (nativeGet (await (callOk f "B" "message.acknowledge" args)) "acknowledgement_id")) :toBe id)
          (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "A") "message.acknowledge.get" (js-object :acknowledgement_id id))) "ok")) :toBe false)
          ;; A lost POST response must be reconciled by GET, without another POST.
          (put (nativeGet f "reaction_behavior") :lose_create t)
          (await (turns f 1))
          (await (js-call f :restart))
          (js-call (nativeGet f "clock") :advance 11000) (await (turns f 4))
          (let ((confirmed (await (callOk f "B" "message.acknowledge.get" (js-object :acknowledgement_id id)))))
            (js-call (expect (nativeGet confirmed "native_acknowledged")) :toBe t)
            (js-call (expect (nativeGet confirmed "state")) :toBe "done")
            (js-call (expect (nativeGet confirmed "reaction_id")) :toBe "get-rid:acknowledge-without-reply"))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done")
          (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:acknowledge-without-reply")) :toBe t)
          (js-call (expect (js-call (nativeGet f "marks") :has "rid:acknowledge-without-reply")) :toBe false)
          (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe (1+ creates-before))
          (put args :idempotency_key "same-acknowledgement-new-request")
          (js-call (expect (nativeGet (await (callOk f "B" "message.acknowledge" args)) "native_acknowledged")) :toBe t)
          (await (turns f 2))
          (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (x) (= x "create"))))) :toBe (1+ creates-before))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))))) closeFixture)
  (withCase "T40.acknowledgement-isolation.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (peer (nativeGet f "opencode")))
      (await (subscribe f agent "lark"))
      (await (js-call f :ingest (createdEvent "lark" "original-task" "still processing")))
      (await (turns f 4))
      (await (js-call f :ingest (createdEvent "lark" "additional-context" "supplement incorporated")))
      (await (turns f 4))
      (let ((original (input f 0)) (supplement (input f 1)))
        (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet supplement "reply_context_id") :idempotency_key "ack-supplement")))
        (await (turns f 4))
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet original "delivery_id")))) "state")) :toBe "active")
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet supplement "delivery_id")))) "state")) :toBe "completed")
        (js-call (expect (js-call (nativeGet f "marks") :has "rid:original-task")) :toBe t)
        (js-call (expect (js-call (nativeGet f "marks") :has "rid:additional-context")) :toBe false)
        (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:additional-context")) :toBe t)
        (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:original-task")) :toBe false)
        (await (complete f "A" original "finish-original"))
        (await (turns f 4)))
      ;; A receiver may acknowledge while native submit has not returned accepted.
      (let ((submit (nativeGet peer "submit")))
        (put peer :submit (async (binding envelope mode key context)
          (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "ack-before-receipt")))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "state")) :toBe "completed")
          (funcall submit binding envelope mode key context)))
        (try
          (await (js-call f :ingest (createdEvent "lark" "early-ack" "understood before receipt")))
          (await (turns f 5))
          (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet (input f 2) "delivery_id")))) "state")) :toBe "completed")
          (js-call (expect (js-call (nativeGet f "marks") :has "rid:early-ack")) :toBe false)
          (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:early-ack")) :toBe t)
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
          (finally (put peer :submit submit)))))) closeFixture)
  (withCase "T40.pull-reply-authority.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
           (agent-id (nativeGet agent "agent_id"))
           (preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object
             :agent_id agent-id :delivery_mode "pull"
             :rules (js-array (js-object :id "messages" :enabled t :predicate (js-object :all (js-array))))))))))
      (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "subscribe-pull")))
      (await (js-call f :ingest (createdEvent "lark" "released-claim" "reply only while authorized")))
      (await (turns f 2))
      (let* ((claim (await (callOk f "A" "subscription.pull" (js-object :agent_id agent-id :idempotency_key "pull-original"))))
             (item (nativeGet claim "item"))
             (envelope (nativeGet item "envelope"))
             (ref (nativeGet envelope "reply_context_id"))
             (args (js-object :reply_context_id ref :content (js-object :type "text" :text "must not send") :idempotency_key "reply-before-release"))
             (outbound (await (callOk f "B" "message.reply" args)))
             (ack (await (callOk f "B" "message.acknowledge" (js-object :reply_context_id ref :idempotency_key "ack-before-release")))))
        (let ((foreign-ack (await (js-call f :call (nativeGet f "B") "subscription.ack"
          (js-object :claim_ref (nativeGet item "claim_ref") :disposition "retry" :idempotency_key "foreign-claim")))))
          (js-call (expect (nativeGet foreign-ack "ok")) :toBe false))
        (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet item "claim_ref")
          :disposition "retry" :idempotency_key "release-original")))
        (put args :idempotency_key "reply-after-release")
        (let ((rejected (await (js-call f :call (nativeGet f "B") "message.reply" args))))
          (js-call (expect (nativeGet (nativeGet rejected "error") "code")) :toBe "stale_reference")
          (js-call (expect (nativeGet (nativeGet (nativeGet rejected "error") "details") "reason")) :toBe "reply_claim_changed"))
        (await (turns f 3))
        (let ((projected (await (callOk f "B" "outbound.get" (js-object :outbound_id (nativeGet outbound "outbound_id")))))
              (reaction (await (callOk f "B" "message.acknowledge.get" (js-object :acknowledgement_id (nativeGet ack "acknowledgement_id"))))))
          (js-call (expect (nativeGet projected "state")) :toBe "failed")
          (js-call (expect (nativeGet projected "definite_not_sent")) :toBe t)
          (js-call (expect (nativeGet reaction "native_acknowledged")) :toBe false))
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0)
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (let* ((next (await (callOk f "A" "subscription.pull" (js-object :agent_id agent-id :idempotency_key "pull-again"))))
               (fresh (nativeGet next "item"))
               (fresh-ref (nativeGet (nativeGet fresh "envelope") "reply_context_id")))
          (js-call (expect (nativeGet fresh "inbox_id")) :toBe (nativeGet item "inbox_id"))
          (js-call (expect (= fresh-ref ref)) :toBe false)
          (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet fresh "claim_ref")
            :disposition "consumed" :idempotency_key "consume-fresh")))
          (let ((sent (await (callOk f "B" "message.reply" (js-object
            :reply_context_id fresh-ref :content (js-object :type "text" :text "authorized reply") :idempotency_key "reply-after-consume")))))
            (await (turns f 3))
            (js-call (expect (nativeGet (await (callOk f "B" "outbound.get"
              (js-object :outbound_id (nativeGet sent "outbound_id")))) "state")) :toBe "accepted")
            (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 1))
          (let ((fresh-ack (await (callOk f "B" "message.acknowledge" (js-object
            :reply_context_id fresh-ref :idempotency_key "ack-after-consume")))))
            (put (nativeGet f "B") :authorization_revision 2)
            (await (turns f 3))
            (js-call (expect (nativeGet (await (callOk f "B" "message.acknowledge.get"
              (js-object :acknowledgement_id (nativeGet fresh-ack "acknowledgement_id")))) "native_acknowledged")) :toBe t)))))) closeFixture)
  (withCase "T38.working-http.integration" (lambda () nil) (async (unused)
    (let* ((calls (js-array))
      (host (js-object :clock (js-object :monoNow (lambda () (performance/now))) :credentials (js-object :resolve (async (ref) (js-object :app_id "app" :app_secret "private")))
        :http (js-object :fetch (async (url options)
          (js-call calls :push (js-object :url url :method (nativeGet options "method") :body (nativeGet options "body")))
          (new globalThis.Response (JSON/stringify (if (js-call url :includes "tenant_access_token")
            (js-object :code 0 :tenant_access_token "test-token" :expire 3600)
            (js-object :code 0 :data (if (= (nativeGet options "method") "GET")
              (js-object :items (js-array) :has_more false) (js-object :reaction_id "reaction-id"))))) (js-object :status 200))))))
      (transport (createLarkHttpTransport (js-object :identity "bot" :event_app_id "app" :credential_ref "credential") host))
      (ctx (js-object :deadline (+ (performance/now) 2000))))
      (await (js-call transport :perform "reaction_list" (js-object :message_id "message-id" :emoji_type "Typing") ctx))
      (await (js-call transport :perform "reaction_create" (js-object :message_id "message-id" :emoji_type "Typing") ctx))
      (await (js-call transport :perform "reaction_delete" (js-object :message_id "message-id" :reaction_id "reaction-id") ctx))
      (js-call (expect (nativeGet (aref calls 1) "url")) :toContain "/messages/message-id/reactions?user_id_type=open_id&page_size=50&reaction_type=Typing")
      (js-call (expect (nativeGet (JSON/parse (nativeGet (aref calls 2) "body")) "reaction_type")) :toEqual (js-object :emoji_type "Typing"))
      (js-call (expect (nativeGet (aref calls 3) "method")) :toBe "DELETE")
      (js-call (expect (nativeGet (aref calls 3) "url")) :toContain "/reactions/reaction-id")
      (await (js-call transport :perform "reaction_list" (js-object :message_id "message-id" :emoji_type "Get") ctx))
      (await (js-call transport :perform "reaction_create" (js-object :message_id "message-id" :emoji_type "Get") ctx))
      (js-call (expect (nativeGet (aref calls 4) "url")) :toContain "reaction_type=Get")
      (js-call (expect (nativeGet (JSON/parse (nativeGet (aref calls 5) "body")) "reaction_type")) :toEqual (js-object :emoji_type "Get"))
      (let* ((port (createLarkPort (js-object :connection_id "lark" :identity "bot" :event_app_id "app" :credential_ref "credential" :watches (js-array)) host))
        (response (await (js-call port :reaction "list" (js-object :message_id "message-id") ctx))))
        (js-call (expect (nativeGet response "ok")) :toBe t)
        (js-call (expect (nativeGet (nativeGet response "data") "items")) :toEqual (js-array))
        (await (js-call port :close)))
      (await (js-call transport :close)))) (lambda (unused) nil))
  (withCase "T38.recipient-reactions.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (subscribe f agent "lark"))
      (let ((first (createdEvent "lark" "before-optout" "work")))
        (put first :chat_type "p2p") (await (js-call f :ingest first)))
      (await (turns f 4))
      (js-call (expect (js-call (nativeGet f "marks") :has "rid:before-optout")) :toBe t)
      ;; Queued Get must be suppressed too, while the old Typing is cleaned up.
      (await (callOk f "A" "message.acknowledge" (js-object
        :reply_context_id (nativeGet (input f 0) "reply_context_id") :idempotency_key "queued-get-before-td")))
      (let ((td (createdEvent "lark" "recipient-td" "TD")))
        (put td :chat_type "p2p") (await (js-call f :ingest td)))
      (js-call (nativeGet f "clock") :advance 11000) (await (turns f 4))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2)
      (js-call (expect (nativeGet (input f 1) "origin")) :toBe "subscription_event")
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
      (let ((later (createdEvent "lark" "after-optout" "new request")))
        (put later :chat_type "p2p") (await (js-call f :ingest later)))
      (await (turns f 4))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 3)
      (js-call (expect (js-length (js-call (nativeGet f "reaction_calls") :filter (lambda (command) (= command "create"))))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
      (let ((ack (await (js-call f :call (nativeGet f "A") "message.acknowledge" (js-object
          :reply_context_id (nativeGet (input f 2) "reply_context_id") :idempotency_key "get-after-td"))))
        (reply (await (js-call f :call (nativeGet f "A") "message.reply" (js-object
          :reply_context_id (nativeGet (input f 2) "reply_context_id") :content (js-object :type "text" :text "no")
          :idempotency_key "reply-after-td")))))
        (js-call (expect (nativeGet (nativeGet ack "error") "code")) :toBe "recipient_opted_out")
        (js-call (expect (nativeGet (nativeGet reply "error") "code")) :toBe "recipient_opted_out"))
      (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))) closeFixture)

  (defun cliStdin (text)
    (new globalThis.ReadableStream (js-object :start (lambda (controller)
      (js-call controller :enqueue (js-call (new globalThis.TextEncoder) :encode text))
      (js-call controller :close)))))

  (defasync cliExec (argv &optional stdin-text)
    (let ((out "") (err ""))
      (let ((code (await (runCli argv (js-object
              :stdin (if (undefined? stdin-text) nil (cliStdin stdin-text))
              :stdout (lambda (text) (setq out (str out text)))
              :stderr (lambda (text) (setq err (str err text))))))))
        (js-object :code code :stdout out :stderr err
          :json (JSON/parse (if (> (js-length (js-call out :trim)) 0) out err))))))

  (withCase "T40.restricted-recipient-cli-complete.integration" setupRestrictedCli (async (f)
    (let* ((agent (await (bindRecipient f)))
           (restricted (nativeGet f "restricted_profile"))
           (shared (nativeGet f "shared_profile"))
           (s1-key (stableSessionKey (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1")))
           (s2-key (stableSessionKey (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s2"))))
      (await (subscribe f agent "lark"))
      ;; Original conversation saves its business rule + reply_routes via its dedicated profile.
      (let ((init-rules (await (cliExec (js-array "session" "rules" "update" "--client-profile" restricted "--input" "-" "--json")
              (JSON/stringify (js-object :session_key s1-key :expected_revision 1 :text "原有业务规则正文"
                :reply_routes (js-array (js-object :source_connection_id "lark" :mention_id "ou_user" :reply_connection_id "lark"))
                :idempotency_key "init-rules-s1"))))))
        (js-call (expect (nativeGet init-rules "code")) :toBe 0)
        (js-call (expect (nativeGet (nativeGet (nativeGet init-rules "json") "data") "revision")) :toBe 2))
      ;; Authorized installer holding session.rules.manage preserves existing text & reply_routes and appends ONLY profile wiring path.
      (let* ((before (await (cliExec (js-array "session" "rules" "get" "--client-profile" shared "--session-key" s1-key "--json"))))
             (prev-data (nativeGet (nativeGet before "json") "data"))
             (updated-text (str (nativeGet prev-data "text") "\ndedicated_cli_profile: " restricted))
             (saved (await (cliExec (js-array "session" "rules" "update" "--client-profile" shared "--input" "-" "--json")
               (JSON/stringify (js-object :session_key s1-key :expected_revision (nativeGet prev-data "revision")
                 :text updated-text :idempotency_key "installer-profile-note-1"))))))
        (js-call (expect (nativeGet before "code")) :toBe 0)
        (js-call (expect (nativeGet saved "code")) :toBe 0)
        (js-call (expect (nativeGet (nativeGet (nativeGet saved "json") "data") "revision")) :toBe 3)
        (js-call (expect (nativeGet (nativeGet (nativeGet saved "json") "data") "updated_by")) :toBe "S")
        (js-call (expect (js-length (nativeGet (nativeGet (nativeGet saved "json") "data") "reply_routes"))) :toBe 1))

      ;; Ingest IM message for s1 (recipient A) -> Typing reaction registered.
      (await (js-call f :ingest (createdEvent "lark" "cli-no-reply" "acknowledged quietly")))
      (await (turns f 4))
      (js-call (expect (js-call (nativeGet f "marks") :has "rid:cli-no-reply")) :toBe t)
      (let* ((envelope (input f 0))
             (delivery-id (nativeGet envelope "delivery_id")))
        ;; Shared principal (even with delivery.inspect:* + delivery.manage:* + setup session.rules.manage) can read delivery.get
        ;; but is strictly refused by delivery.working and delivery.complete.
        (let ((s-whoami (await (cliExec (js-array "agent" "whoami" "--client-profile" shared "--json"))))
              (s-get (await (cliExec (js-array "delivery" "get" "--client-profile" shared "--delivery" delivery-id "--json"))))
              (s-working (await (cliExec (js-array "delivery" "working" "--client-profile" shared "--delivery" delivery-id "--json"))))
              (s-complete (await (cliExec (js-array "delivery" "complete" "--client-profile" shared "--delivery" delivery-id "--reason" "no_reply" "--idempotency-key" "shared-denied" "--json")))))
          (js-call (expect (nativeGet s-whoami "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet s-whoami "json") "data") "principal_id")) :toBe "S")
          (js-call (expect (nativeGet s-get "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet (nativeGet s-get "json") "data") "reply_authority") "recipient_principal_id")) :toBe "A")
          (js-call (expect (nativeGet s-working "code")) :toBe 3)
          (js-call (expect (nativeGet (nativeGet s-working "json") "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet s-working "json") "effect_state")) :toBe "none")
          (js-call (expect (nativeGet (nativeGet (nativeGet s-working "json") "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet s-complete "code")) :toBe 3)
          (js-call (expect (nativeGet (nativeGet s-complete "json") "ok")) :toBe false)
          (js-call (expect (nativeGet (nativeGet s-complete "json") "effect_state")) :toBe "none")
          (js-call (expect (nativeGet (nativeGet (nativeGet s-complete "json") "error") "code")) :toBe "forbidden")
          (js-call (expect (js-call (nativeGet f "marks") :has "rid:cli-no-reply")) :toBe t))

        ;; Restricted recipient A proactively uses its dedicated profile:
        ;; 1) whoami + 2) session.rules.get (does NOT rely on agent.get) + 3) delivery.working
        (let ((a-whoami (await (cliExec (js-array "agent" "whoami" "--client-profile" restricted "--json"))))
              (a-agent-get (await (cliExec (js-array "agent" "get" "--client-profile" restricted "--agent" (nativeGet agent "agent_id") "--json"))))
              (a-rules (await (cliExec (js-array "session" "rules" "get" "--client-profile" restricted "--session-key" s1-key "--json"))))
              (a-other-rules (await (cliExec (js-array "session" "rules" "get" "--client-profile" restricted "--session-key" s2-key "--json"))))
              (a-working-before (await (cliExec (js-array "delivery" "working" "--client-profile" restricted "--delivery" delivery-id "--json")))))
          (js-call (expect (nativeGet a-whoami "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-whoami "json") "data") "principal_id")) :toBe "A")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-whoami "json") "data") "kind")) :toBe "agent")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-whoami "json") "data") "binding_state")) :toBe "bound")
          (js-call (expect (js-call (nativeGet (nativeGet (nativeGet a-whoami "json") "data") "bound_agent_ids") :includes (nativeGet agent "agent_id"))) :toBe t)
          (js-call (expect (nativeGet a-agent-get "code")) :toBe 3)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-agent-get "json") "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet a-rules "code")) :toBe 0)
          (let ((rules-data (nativeGet (nativeGet a-rules "json") "data")))
            (js-call (expect (nativeGet rules-data "session_key")) :toBe s1-key)
            (js-call (expect (nativeGet rules-data "tool")) :toBe "opencode")
            (js-call (expect (nativeGet rules-data "native_namespace")) :toBe "ns-opencode")
            (js-call (expect (nativeGet rules-data "native_session_id")) :toBe "s1")
            (js-call (expect (nativeGet rules-data "updated_by")) :toBe "S")
            (js-call (expect (nativeGet rules-data "text")) :toBe (str "原有业务规则正文\ndedicated_cli_profile: " restricted))
            (js-call (expect (js-length (nativeGet rules-data "reply_routes"))) :toBe 1)
            (js-call (expect (nativeGet (aref (nativeGet rules-data "reply_routes") 0) "mention_id")) :toBe "ou_user"))
          (js-call (expect (nativeGet a-other-rules "code")) :toBe 3)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-other-rules "json") "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet a-working-before "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-working-before "json") "data") "state")) :toBe "active")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-working-before "json") "data") "cleanup_state")) :toBe "active"))

        ;; Complete with reason=no_reply, verify idempotent replay, conflict rejection, operation.get, and post-cleanup read-back.
        (let* ((a-complete (await (cliExec (js-array "delivery" "complete" "--client-profile" restricted "--delivery" delivery-id "--reason" "no_reply" "--idempotency-key" "complete-cli-no-reply-1" "--json"))))
               (op-id (nativeGet (nativeGet a-complete "json") "operation_id"))
               (a-replay (await (cliExec (js-array "delivery" "complete" "--client-profile" restricted "--delivery" delivery-id "--reason" "no_reply" "--idempotency-key" "complete-cli-no-reply-1" "--json"))))
               (a-conflict (await (cliExec (js-array "delivery" "complete" "--client-profile" restricted "--delivery" delivery-id "--reason" "completed" "--idempotency-key" "complete-cli-no-reply-1" "--json"))))
               (a-op (await (cliExec (js-array "operation" "get" "--client-profile" restricted "--operation" "delivery.complete" "--idempotency-key" "complete-cli-no-reply-1" "--json")))))
          (js-call (expect (nativeGet a-complete "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet a-complete "json") "effect_state")) :toBe "recorded")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-complete "json") "data") "state")) :toBe "completed")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-complete "json") "data") "reason")) :toBe "no_reply")
          (js-call (expect (nativeGet a-replay "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet a-replay "json") "operation_id")) :toBe op-id)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-replay "json") "data") "state")) :toBe "completed")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-replay "json") "data") "reason")) :toBe "no_reply")
          (js-call (expect (nativeGet a-conflict "code")) :toBe 6)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-conflict "json") "error") "code")) :toBe "idempotency_conflict")
          (js-call (expect (nativeGet a-op "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-op "json") "data") "operation_id")) :toBe op-id)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-op "json") "data") "resource_refs"))
            :toEqual (js-array (js-object :kind "working" :id delivery-id))))
        (await (turns f 4))
        (let ((a-after (await (cliExec (js-array "delivery" "working" "--client-profile" restricted "--delivery" delivery-id "--json")))))
          (js-call (expect (nativeGet a-after "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet a-after "json") "data") "state")) :toBe "completed")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-after "json") "data") "reason")) :toBe "no_reply")
          (js-call (expect (nativeGet (nativeGet (nativeGet a-after "json") "data") "cleanup_state")) :toBe "done"))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (js-call (nativeGet f "marks") :has "get-rid:cli-no-reply")) :toBe false)
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))

      ;; Register s2 owned by S, verify not_marked direct read-back + multi-recipient shared Typing + same-identity completion.
      (let* ((candidates (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
             (c2 (js-call candidates :find (lambda (x) (= (nativeGet x "native_session_id") "s2"))))
             (agent2 (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet c2 "candidate_ref")
               :display_name "same-id" :binding_mode "existing" :recipient_principal_id "S" :idempotency_key "register-S-s2")))))
        (await (subscribe f agent2 "telegram" 86400 "S"))
        ;; Unmarked subscription delivery (e.g. telegram without reaction support) produces state=not_marked, cleanup_state=done (no Typing mark created).
        (await (js-call f :ingest (createdEvent "telegram" "tg-not-marked" "no typing on tg")))
        (await (turns f 4))
        (let* ((unmarked-entry (js-call (nativeGet (nativeGet f "opencode") "inputs") :find (lambda (entry)
                 (= (nativeGet (nativeGet (nativeGet entry "envelope") "source") "native_message_id") "tg-not-marked"))))
               (unmarked-id (nativeGet (nativeGet unmarked-entry "envelope") "delivery_id"))
               (unmarked-working (await (cliExec (js-array "delivery" "working" "--client-profile" shared "--delivery" unmarked-id "--json"))))
               (unmarked-complete (await (cliExec (js-array "delivery" "complete" "--client-profile" shared "--delivery" unmarked-id "--reason" "no_reply" "--idempotency-key" "tg-not-marked-1" "--json")))))
          (js-call (expect (nativeGet unmarked-working "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet unmarked-working "json") "data") "state")) :toBe "not_marked")
          (js-call (expect (nativeGet (nativeGet (nativeGet unmarked-working "json") "data") "cleanup_state")) :toBe "done")
          (js-call (expect (nativeGet unmarked-complete "code")) :toBe 0)
          (js-call (expect (nativeGet (nativeGet (nativeGet unmarked-complete "json") "data") "state")) :toBe "not_marked")
          (js-call (expect (nativeGet (nativeGet (nativeGet unmarked-complete "json") "data") "cleanup_state")) :toBe "done")
          (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0))
        (await (subscribe f agent2 "lark" 86400 "S"))

        ;; Multi-recipient IM message shared between s1 (A) and s2 (S).
        (await (js-call f :ingest (createdEvent "lark" "shared-multi-and-same-id" "both recipients")))
        (await (turns f 5))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
        (let* ((multi-inputs (js-call (nativeGet (nativeGet f "opencode") "inputs") :filter (lambda (entry)
                 (and (= (nativeGet (nativeGet entry "envelope") "origin") "subscription_event")
                      (= (nativeGet (nativeGet (nativeGet entry "envelope") "source") "native_message_id") "shared-multi-and-same-id")))))
               (del1 (nativeGet (nativeGet (js-call multi-inputs :find (lambda (entry)
                 (= (nativeGet (nativeGet (nativeGet entry "envelope") "recipient") "session_key") s1-key))) "envelope") "delivery_id"))
               (del2 (nativeGet (nativeGet (js-call multi-inputs :find (lambda (entry)
                 (= (nativeGet (nativeGet (nativeGet entry "envelope") "recipient") "session_key") s2-key))) "envelope") "delivery_id")))
          ;; Restricted A cannot complete S's delivery.
          (let ((a-denied-s2 (await (cliExec (js-array "delivery" "complete" "--client-profile" restricted "--delivery" del2 "--reason" "no_reply" "--idempotency-key" "a-cannot-complete-s" "--json")))))
            (js-call (expect (nativeGet a-denied-s2 "code")) :toBe 3)
            (js-call (expect (nativeGet (nativeGet (nativeGet a-denied-s2 "json") "error") "code")) :toBe "forbidden"))
          ;; S (same-identity caller) completes its own del2 while A is still active:
          ;; del2 reads state=completed & reason=no_reply, while shared mark legitimately remains (cleanup_state=active).
          (let ((s-own-complete (await (cliExec (js-array "delivery" "complete" "--client-profile" shared "--delivery" del2 "--reason" "no_reply" "--idempotency-key" "same-id-complete-1" "--json")))))
            (js-call (expect (nativeGet s-own-complete "code")) :toBe 0)
            (js-call (expect (nativeGet (nativeGet (nativeGet s-own-complete "json") "data") "state")) :toBe "completed")
            (js-call (expect (nativeGet (nativeGet (nativeGet s-own-complete "json") "data") "reason")) :toBe "no_reply"))
          (await (turns f 3))
          (let ((s-mid-working (await (cliExec (js-array "delivery" "working" "--client-profile" shared "--delivery" del2 "--json")))))
            (js-call (expect (nativeGet (nativeGet (nativeGet s-mid-working "json") "data") "state")) :toBe "completed")
            (js-call (expect (nativeGet (nativeGet (nativeGet s-mid-working "json") "data") "reason")) :toBe "no_reply")
            (js-call (expect (nativeGet (nativeGet (nativeGet s-mid-working "json") "data") "cleanup_state")) :toBe "active")
            (js-call (expect (js-call (nativeGet f "marks") :has "rid:shared-multi-and-same-id")) :toBe t))
          ;; Once restricted A completes del1 too, shared Typing is removed and both read cleanup_state=done with zero Get.
          (let ((a-complete-multi (await (cliExec (js-array "delivery" "complete" "--client-profile" restricted "--delivery" del1 "--reason" "no_reply" "--idempotency-key" "restricted-complete-multi-1" "--json")))))
            (js-call (expect (nativeGet a-complete-multi "code")) :toBe 0))
          (await (turns f 4))
          (let ((a-multi-after (await (cliExec (js-array "delivery" "working" "--client-profile" restricted "--delivery" del1 "--json"))))
                (s-multi-after (await (cliExec (js-array "delivery" "working" "--client-profile" shared "--delivery" del2 "--json")))))
            (js-call (expect (nativeGet (nativeGet (nativeGet a-multi-after "json") "data") "state")) :toBe "completed")
            (js-call (expect (nativeGet (nativeGet (nativeGet a-multi-after "json") "data") "reason")) :toBe "no_reply")
            (js-call (expect (nativeGet (nativeGet (nativeGet a-multi-after "json") "data") "cleanup_state")) :toBe "done")
            (js-call (expect (nativeGet (nativeGet (nativeGet s-multi-after "json") "data") "cleanup_state")) :toBe "done"))
          (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))))) teardownRestrictedCli)

)
