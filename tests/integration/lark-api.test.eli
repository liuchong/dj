(module dj.tests.integration.lark-api
  (import "../../src/core/native.eli" nativeGet nativeFetch)
  (import "../../src/adapters/im/lark.eli" createLarkPort)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../packages/lark/src/index.eli" createLarkClient)
  (import "../support/fixtures.eli" createFixture closeFixture callOk)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "ajv/dist/2020.js" :default Ajv2020)
  (import "node:path" resolve)
  (defun serveNative ()
    (let* ((state (js-object :calls (js-array) :writes 0 :root nil :mode "normal"))
      (server (Bun/serve (js-object :hostname "127.0.0.1" :port 0
        :fetch (async (request)
          (let* ((url (new globalThis.URL (nativeGet request "url")))
            (path (nativeGet url "pathname")) (method (nativeGet request "method")))
            (js-call (nativeGet state "calls") :push (js-object :path path :method method
              :authorization (js-call (nativeGet request "headers") :get "authorization")))
            (cond
              ((js-call path :endsWith "/tenant_access_token/internal")
                (Response/json (js-object :code 0 :tenant_access_token "bot-fixture" :expire 7200)))
              ((js-call path :endsWith "/authen/v1/user_info")
                (Response/json (js-object :code 0 :data (js-object :open_id "ou_user"))))
              ((js-call path :endsWith "/download")
                (new globalThis.Response (Buffer/from (js-array 0 255 10 65)) (js-object :headers (js-object :content-type "application/octet-stream"))))
              ((js-call path :endsWith "/upload")
                (let* ((form (await (js-call request :formData))) (file (js-call form :get "file")))
                  (js-call (expect (await (js-call file :text))) :toBe "中文\nfile")
                  (js-call (expect (js-call form :get "file_type")) :toBe "stream")
                  (Response/json (js-object :code 0 :data (js-object :file_key "file_fixture")))))
              ((not (= method "GET"))
                (when (nativeGet state "root")
                  (let ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t))))
                    (try (js-call (expect (nativeGet (js-call (js-call db :query
                      "SELECT json_extract(payload,'$.safe_result.data.state') AS state FROM operations ORDER BY rowid DESC LIMIT 1") :get) "state")) :toBe "unknown")
                      (finally (js-call db :close)))))
                (put state :writes (1+ (nativeGet state "writes")))
                (cond ((= (nativeGet state "mode") "unavailable") (new globalThis.Response "upstream failed" (js-object :status 503)))
                  ((= (nativeGet state "mode") "denied")
                    (Response/json (js-object :code 99991672 :msg "permission denied"
                      :error (js-object :permission_violations (js-array (js-object :subject "fixture:write"))))))
                  (t (Response/json (js-object :code 0 :data (js-object :document_id "doc_fixture" :body (await (js-call request :json))))))))
              (t (Response/json (js-object :code 0 :data (js-object :items (js-array (js-object :text "中文\nplain"))
                :page_token (js-call (nativeGet url "searchParams") :get "page_token") :has_more false))))))))))
      (host (js-object :fetch (lambda (address options)
        (let ((url (new globalThis.URL address)))
          (js-call (expect (nativeGet url "origin")) :toBe "https://open.larksuite.com")
          (funcall nativeFetch
            (str "http://127.0.0.1:" (nativeGet server "port") (nativeGet url "pathname") (nativeGet url "search")) options))))))
      (js-object :server server :state state :host host)))
  (withCase "T40.lark-package.integration" (async () (serveNative))
    (async (fixture)
      (let* ((host (Object/assign (js-object) (nativeGet fixture "host")
        (js-object :monoNow (lambda () (performance/now)) :credentials (js-object :resolve (lambda (ref)
          (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "user-fixture"))))))
        (config (js-object :brand "lark" :identity "user" :credential_ref "fixture"
          :user_identity (js-object :app_id "cli_test" :open_id "ou_user")))
        (user (createLarkClient config host))
        (bot (createLarkClient (Object/assign (js-object) config (js-object :identity "bot")) host)))
        (try
          (let ((read (await (js-call user :request (js-object :path "/open-apis/docx/v1/documents/doc_fixture/blocks"
            :query (js-object :page_token "a+b / 中文")) (js-object)))))
            (js-call (expect (nativeGet read "status")) :toBe 200)
            (js-call (expect (nativeGet (nativeGet (nativeGet read "wire") "data") "page_token")) :toBe "a+b / 中文"))
          (let ((upload (await (js-call bot :request (js-object :method "POST" :path "/open-apis/im/v1/files/upload"
            :form (js-object :file_type "stream" :file (new globalThis.File (js-array "中文\nfile") "a.txt"))) (js-object)))))
            (js-call (expect (nativeGet (nativeGet (nativeGet upload "wire") "data") "file_key")) :toBe "file_fixture"))
          (let ((download (await (js-call bot :request (js-object :path "/open-apis/drive/v1/files/file_fixture/download" :response_mode "bytes") (js-object)))))
            (js-call (expect (js-call (nativeGet download "wire") :toString "base64")) :toBe "AP8KQQ=="))
          (js-call user :close)
          ;; Closing one account must not cancel or disable the other account.
          (js-call (expect (nativeGet (await (js-call bot :request (js-object :path "/open-apis/contact/v3/users") (js-object))) "status")) :toBe 200)
          (let ((calls (nativeGet (nativeGet fixture "state") "calls")))
            (js-call (expect (js-call calls :some (lambda (row) (= (nativeGet row "authorization") "Bearer user-fixture")))) :toBe t)
            (js-call (expect (js-call calls :some (lambda (row) (= (nativeGet row "authorization") "Bearer bot-fixture")))) :toBe t))
          (finally (js-call user :close) (js-call bot :close)))))
    (async (fixture) (js-call (nativeGet fixture "server") :stop t)))
  (withCase "T40.lark-api.integration" (async () (serveNative))
    (async (fixture)
      (let ((index 0) (identities (js-array "user" "bot")))
        (while (< index (js-length identities))
          (let* ((identity (aref identities index)) (state (nativeGet fixture "state"))
            (f (await (createFixture (str "lark-api-" identity) "one" (js-object :configure (lambda (config ports)
              (put config :managed_profiles (js-array))
              (put ports :credentials (js-object :resolve (lambda (ref)
                (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "user-fixture"))))
              (put ports :http (nativeGet fixture "host"))
              (let ((connection (aref (nativeGet config "connections") 0)))
                (put connection :identity identity)
                (js-call (nativeGet ports "im_ports") :set "lark" (createLarkPort connection ports))))))))
            (base (js-object :connection_id "lark" :identity_revision 1 :path "/open-apis/docx/v1/documents"))
            (args (Object/assign (js-object) base (js-object :method "POST" :idempotency_key "create-once" :body (js-object :title "fixture"))))
            (ajv (new Ajv2020 (js-object :strict t :allowUnionTypes t))))
            (put state :root (nativeGet f "root")) (put state :mode "normal")
            (try
              (js-call (expect (nativeGet (await (callOk f "O" "connection.get"
                (js-object :connection_id "lark"))) "identity_revision")) :toBe 1)
              (let ((result (await (callOk f "O" "lark.api.call" args))) (count (nativeGet state "writes")))
                (js-call (expect (nativeGet result "state")) :toBe "accepted")
                (js-call (expect (nativeGet result "identity")) :toBe identity)
                (await (callOk f "O" "lark.api.call" args))
                (js-call (expect (nativeGet state "writes")) :toBe count)
                (js-call (expect (nativeGet (await (callOk f "O" "lark.api.get" (js-object :action_id (nativeGet result "action_id")))) "state")) :toBe "accepted")
                (let ((full (await (js-call f :call (nativeGet f "O") "lark.api.call" args)))
                  (validate (js-call ajv :compile (nativeGet (js-call operationCatalog :get "lark.api.call") "output_schema"))))
                  (js-call (expect (funcall validate full)) :toBe t)))
              (let ((read (await (callOk f "O" "lark.api.read" (Object/assign (js-object) base
                (js-object :query (js-object :page_token "a+b / 中文")))))))
                (js-call (expect (nativeGet read "native_ok")) :toBe t)
                (js-call (expect (nativeGet (nativeGet (nativeGet read "response") "data") "page_token")) :toBe "a+b / 中文")
                (js-call (expect (nativeGet (aref (nativeGet (nativeGet (nativeGet read "response") "data") "items") 0) "text")) :toBe "中文\nplain"))
              (put state :mode "denied")
              (let ((denied (await (callOk f "O" "lark.api.call" (Object/assign (js-object) args (js-object :idempotency_key "denied"))))))
                (js-call (expect (nativeGet denied "state")) :toBe "rejected")
                (js-call (expect (nativeGet (nativeGet denied "response") "code")) :toBe 99991672))
              (put state :mode "unavailable")
              (let* ((uncertain (Object/assign (js-object) args (js-object :idempotency_key "uncertain")))
                (result (await (callOk f "O" "lark.api.call" uncertain))) (count (nativeGet state "writes")))
                (js-call (expect (nativeGet result "state")) :toBe "unknown")
                (await (js-call f :restart))
                (await (callOk f "O" "lark.api.call" uncertain))
                (js-call (expect (nativeGet state "writes")) :toBe count))
              (let ((count (js-length (nativeGet state "calls"))))
                (let ((invalid (await (js-call f :call (nativeGet f "O") "lark.api.read"
                  (Object/assign (js-object) base (js-object :identity_revision 999))))))
                  (js-call (expect (nativeGet (nativeGet invalid "error") "code")) :toBe "stale_reference"))
                (let ((secret (await (js-call f :call (nativeGet f "O") "lark.api.read"
                  (Object/assign (js-object) base (js-object :path "/open-apis/auth/v3/tenant_access_token/internal"))))))
                  (js-call (expect (nativeGet (nativeGet secret "error") "code")) :toBe "invalid_argument"))
                (js-call (expect (js-length (nativeGet state "calls"))) :toBe count))
              (finally (put state :root nil) (await (closeFixture f)))))
          (setq index (1+ index)))))
    (async (fixture) (js-call (nativeGet fixture "server") :stop t))))
