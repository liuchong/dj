(module dj.tests.integration.recipients
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/messaging/recipients.eli" optOutNotice)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "../support/fixtures.eli" createFixture closeFixture callOk createdEvent bindRecipient subscribe successful createImPeer)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (defasync setup ()
    (await (createFixture "recipients" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array)) (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (Object/assign (aref (nativeGet config "connections") 0)
        (js-object :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_self"))
      (js-call (nativeGet config "connections") :push (Object/assign (js-object)
        (aref (nativeGet config "connections") 0) (js-object :connection_id "lark-alt" :identity "bot")))
      (js-call (nativeGet ports "im_ports") :set "lark-alt" (createImPeer "lark-alt"))
      (let ((peer (js-call (nativeGet ports "im_ports") :get "lark")))
        (put peer :api_calls 0)
        (put peer :apiCall (async (record call)
          (put peer :api_calls (1+ (nativeGet peer "api_calls")))
          (js-object :status 200 :wire (js-object :code 0 :data (js-object)) :headers (js-object))))))))))
  (defun event (id text person &optional group parent time)
    (let ((value (createdEvent "lark" id text)))
      (put value :sender (js-object :id person :kind "human"))
      (put value :chat_type (if group "group" "p2p"))
      (when parent (put value :reply_to (js-object :id parent)))
      (when time (put value :source_time time)) value))
  (defasync ingest (f value) (successful (await (js-call f :ingest value))))
  (defasync destination (f &optional id)
    (nativeGet (await (callOk f "O" "conversation.resolve" (js-object :connection_id (or id "lark") :chat_id "c1" :thread_id nil))) "conversation_ref"))
  (defasync send (f ref key text &optional force-send)
    (await (js-call f :call (nativeGet f "O") "message.send"
      (js-object :destination_ref ref :content (js-object :type "text" :text text) :idempotency_key key :force_send (= force-send t)))))
  (defasync turns (f) (await (js-call f :tick)) (await (js-call f :tick)))
  (defun countSent (f) (js-length (nativeGet (nativeGet f "lark") "sent")))
  (defun policy (mode &optional allow deny)
    (js-object :default_action mode :allow (js-object :recipient_ids (or allow (js-array)) :chat_ids (js-array))
      :deny (js-object :recipient_ids (or deny (js-array)) :chat_ids (js-array))))
  (defasync setPolicy (f revision value &optional key)
    (await (callOk f "O" "message.recipient_policy.set" (js-object :connection_id "lark" :expected_revision revision
      :policy value :idempotency_key (or key (str "policy-" revision))))))
  (defun stored (f sql &rest values)
    (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (stmt (js-call db :query sql)))
      (try (Reflect/apply (nativeGet stmt "all") stmt values)
        (finally (js-call stmt :finalize) (js-call db :close)))))
  (defun code (result) (nativeGet (nativeGet result "error") "code"))
  (withCase "T38.recipient-optout.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (sub (await (subscribe f agent "lark")))
      (ref (await (destination f))) (reply-id nil))
      (let ((other (event "other-hello" "hello" "human-1")))
        (put other :connection_id "lark-alt") (put (nativeGet other "conversation") :connection_id "lark-alt")
        (await (ingest f other)))
      (await (ingest f (event "hello" "hello" "human-1"))) (await (turns f))
      (let ((reply (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") 0) "envelope")))
        (setq reply-id (nativeGet reply "reply_context_id"))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id reply-id
          :content (js-object :type "text" :text "answer") :idempotency_key "reply-first"))))
      (await (turns f))
      (js-call (expect (countSent f)) :toBe 1)
      (js-call (expect (nativeGet (nativeGet (nativeGet (aref (nativeGet (nativeGet f "lark") "sent") 0) "outbound") "content") "text"))
        :toBe (str "answer\n\n" optOutNotice))
      (let* ((queued (successful (await (send f ref "queued" "must not leave"))))
        (input-count (js-length (nativeGet (nativeGet f "opencode") "inputs")))
        (td (event "td-1" "  tD  " "human-1" nil nil "2026-01-01T00:00:01.000Z")))
        (await (ingest f td)) (await (ingest f td)) (await (turns f))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe (+ input-count 1))
        (js-call (expect (countSent f)) :toBe 1)
        (let ((out (await (callOk f "O" "outbound.get" (js-object :outbound_id (nativeGet queued "outbound_id"))))))
          (js-call (expect (nativeGet out "state")) :toBe "failed")
          (js-call (expect (nativeGet out "blocked_reason")) :toBe "recipient_opted_out")
          (js-call (expect (nativeGet out "definite_not_sent")) :toBe t)
          (js-call (expect (nativeGet out "retryable")) :toBe false))
        (js-call (expect (nativeGet (aref (stored f "SELECT w.state FROM routing_work w JOIN events e ON e.event_id=w.event_id WHERE e.native_message_id='td-1'") 0) "state")) :toBe "done")
        (await (js-call f :restart))
        (let ((denied (await (send f (await (destination f)) "after-restart" "blocked"))))
          (js-call (expect (code denied)) :toBe "recipient_opted_out")
          (js-call (expect (js-call (nativeGet (nativeGet denied "error") "message") :includes "不要重试")) :toBe t))
        (js-call (expect (code (await (send f (await (destination f "lark-alt")) "other-account-no-bypass" "blocked")))) :toBe "recipient_opted_out")
        (js-call (expect (js-length (nativeGet (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark-alt") "sent"))) :toBe 0)
        ;; Admin allow cannot override explicit recipient choice.
        (await (setPolicy f 0 (policy "allow" (js-array "human-1"))))
        (js-call (expect (code (await (send f (await (destination f)) "allow-not-bypass" "blocked")))) :toBe "recipient_opted_out")
        ;; Explicit exception survives queue/restart but changes no consent or following send.
        (let* ((force-ref (await (destination f)))
          (forced (successful (await (send f force-ref "force-once" "explicit user exception" t)))))
          (js-call (expect (nativeGet forced "force_send")) :toBe t)
          (let ((replayed (successful (await (send f force-ref "force-once" "explicit user exception" t)))))
            (js-call (expect (nativeGet replayed "outbound_id")) :toBe (nativeGet forced "outbound_id")))
          (js-call (expect (code (await (send f (await (destination f)) "force-not-sticky" "still blocked")))) :toBe "recipient_opted_out")
          (await (js-call f :restart)) (await (turns f))
          (js-call (expect (countSent f)) :toBe 2)
          (let ((read (await (callOk f "O" "outbound.get" (js-object :outbound_id (nativeGet forced "outbound_id"))))))
            (js-call (expect (nativeGet read "state")) :toBe "accepted")
            (js-call (expect (nativeGet read "force_send")) :toBe t)))
        (let ((forced-reply (await (callOk f "A" "message.reply" (js-object :reply_context_id reply-id
          :content (js-object :type "text" :text "explicit forced reply") :force_send t :idempotency_key "force-reply")))))
          (js-call (expect (nativeGet forced-reply "force_send")) :toBe t))
        (await (turns f)) (js-call (expect (countSent f)) :toBe 3)
        (js-call (expect (code (await (send f (await (destination f)) "after-force-reply" "blocked")))) :toBe "recipient_opted_out")
        (let ((read (await (callOk f "O" "message.recipient_policy.get" (js-object :connection_id "lark")))))
          (js-call (expect (nativeGet (aref (nativeGet read "optouts") 0) "state")) :toBe "deny"))
        (await (ingest f (event "restore" "恢复接收" "human-1" nil nil "2026-01-01T00:00:03.000Z")))
        (await (ingest f (event "late-td" "TD" "human-1" nil nil "2026-01-01T00:00:02.000Z")))
        (await (js-call f :restart))
        (let* ((content (str "restored\n\n" optOutNotice))
          (out (successful (await (send f (await (destination f)) "restored" content)))))
          (js-call (expect (nativeGet (nativeGet out "content") "text")) :toBe content))
        (await (turns f)) (js-call (expect (countSent f)) :toBe 4)))) closeFixture)
  (withCase "T38.recipient-group.integration" setup (async (f)
    (let ((ref (await (destination f))))
      (await (ingest f (event "group-hello" "hello" "human-a" t)))
      (successful (await (send f ref "group-out" "hello group"))) (await (turns f))
      (await (ingest f (event "lark-reply-1" "TD" "echo-human" nil)))
      (await (ingest f (event "self-td" "TD" "ou_self" nil)))
      (await (ingest f (event "stray-td" "TD" "human-stray" t)))
      (let ((bot (event "bot-td" "TD" "bot-a" nil)))
        (put (nativeGet bot "sender") :kind "bot") (await (ingest f bot)))
      (await (ingest f (event "words" "文档有 TD 示例" "human-a" t)))
      (js-call (expect (js-length (stored f "SELECT * FROM recipient_optouts"))) :toBe 1)
      (js-call (expect (code (await (send f ref "to-stray" "<at user_id=\"human-stray\">S</at>")))) :toBe "recipient_opted_out")
      (let ((td (event "group-td" "退订" "human-b" t "lark-reply-1")))
        (put td :connection_id "lark-alt") (put (nativeGet td "conversation") :connection_id "lark-alt")
        (await (ingest f td)))
      (let ((index 0))
        (while (< index 257)
          (await (ingest f (event (str "command-page-" index) "TD example is not a command" "human-page" t)))
          (setq index (1+ index))))
      (await (ingest f (event "tail-command" "TD" "human-tail" t)))
      ;; Simulate commands collected before the registration fix. Startup reconstructs
      ;; service consent without an AI action or redelivery of historical inputs.
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
        (try (js-call db :run "DELETE FROM recipient_optouts") (finally (js-call db :close))))
      (await (js-call f :restart)) (setq ref (await (destination f)))
      (js-call (expect (code (await (send f ref "tail-denied" "<at user_id=\"human-tail\">T</at>")))) :toBe "recipient_opted_out")
      (js-call (expect (code (await (send f ref "to-b" "<at user_id=\"human-b\">B</at> answer")))) :toBe "recipient_opted_out")
      (js-call (expect (nativeGet (await (send f ref "to-a" "<at user_id=\"human-a\">A</at> answer")) "ok")) :toBe t)
      (js-call (expect (nativeGet (await (send f ref "broadcast" "group broadcast")) "ok")) :toBe t)
      (await (turns f)) (js-call (expect (countSent f)) :toBe 3)
      (let ((read (await (callOk f "O" "message.recipient_policy.get" (js-object :connection_id "lark-alt")))))
        (js-call (expect (js-length (nativeGet read "optouts"))) :toBe 1)
        (js-call (expect (nativeGet (aref (nativeGet read "optouts") 0) "recipient_id")) :toBe "human-b")
        (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get "message.recipient_policy.get")
          (js-object :ok t :data read :request_id "read" :warnings (js-array) :effect_state "none" :evidence_level "service_record")) "ok")) :toBe t)))) closeFixture)
  (withCase "T38.recipient-policy.integration" setup (async (f)
    (await (ingest f (event "hello-policy" "hello" "human-1")))
    (let ((ref (await (destination f))) (peer (nativeGet f "lark")))
      (let ((denied (await (js-call f :call (nativeGet f "A") "message.recipient_policy.set"
        (js-object :connection_id "lark" :expected_revision 0 :policy (policy "allow") :idempotency_key "agent-no-admin")))))
        (js-call (expect (code denied)) :toBe "forbidden"))
      (await (setPolicy f 0 (policy "deny")))
      (js-call (expect (code (await (send f ref "default-deny" "blocked")))) :toBe "recipient_blocked")
      (let ((value (policy "deny" (js-array "human-1"))))
        (await (setPolicy f 1 value "allow-once")) (await (setPolicy f 1 value "allow-once")))
      (js-call (expect (nativeGet (await (send f ref "allow-target" "allowed")) "ok")) :toBe t)
      (await (setPolicy f 2 (policy "deny" (js-array "human-1") (js-array "human-1"))))
      (js-call (expect (code (await (send f ref "deny-wins" "blocked")))) :toBe "recipient_blocked")
      (await (turns f)) (js-call (expect (countSent f)) :toBe 0)
      (let ((result (await (js-call f :call (nativeGet f "O") "lark.api.call"
        (js-object :connection_id "lark" :identity_revision 1 :method "POST" :path "/open-apis/im/v1/messages"
          :body (js-object :receive_id "human-1" :content "bypass") :idempotency_key "raw-send-no")))))
        (js-call (expect (code result)) :toBe "recipient_blocked")
        (js-call (expect (nativeGet peer "api_calls")) :toBe 0))
      (let ((result (await (callOk f "O" "lark.api.read" (js-object :connection_id "lark" :identity_revision 1 :path "/open-apis/contact/v3/users")))))
        (js-call (expect (nativeGet result "native_ok")) :toBe t)
        (js-call (expect (nativeGet peer "api_calls")) :toBe 1))
      (let ((forced (successful (await (send f ref "force-policy" "explicit exception" t)))))
        (await (turns f)) (js-call (expect (countSent f)) :toBe 1)
        (js-call (expect (nativeGet forced "force_send")) :toBe t))
      (js-call (expect (code (await (send f ref "after-force-policy" "blocked")))) :toBe "recipient_blocked")
      (let ((invalid (await (js-call f :call (nativeGet f "O") "message.send" (js-object
        :destination_ref ref :content (js-object :type "text" :text "invalid flag")
        :force_send "true" :idempotency_key "force-invalid")))))
        (js-call (expect (nativeGet invalid "ok")) :toBe false))
      (await (setPolicy f 3 (policy "allow")))
      (put (nativeGet peer "capabilities") :max_text_bytes 100)
      (js-call (expect (code (await (send f ref "footer-limit" (js-call "x" :repeat 90))))) :toBe "limit_exceeded"))) closeFixture))
