(module dj.tests.integration.mention-replies
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent createImPeer)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "mention-replies" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let* ((source (aref (nativeGet config "connections") 0))
        (user (JSON/parse (JSON/stringify source)))
        (grants (nativeGet (aref (nativeGet config "principals") 2) "grants"))
        (target (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1")))
        (put source :identity "bot") (put source :event_app_id "source_app") (put source :event_subject_id "ou_bot")
        (put source :tenant_ref "same-tenant")
        (put user :connection_id "lark-user") (put user :identity "user") (put user :tenant_ref "same-tenant")
        (put user :event_app_id "user_app") (put user :event_subject_id "ou_user")
        (js-call (nativeGet config "connections") :push user)
        (js-call (nativeGet ports "im_ports") :set "lark-user" (createImPeer "lark-user"))
        (js-call grants :push (js-object :action "session.rules.read" :resources (js-array target)))
        (js-call grants :push (js-object :action "session.rules.manage" :resources (js-array target)))))))))
  (defasync subscribeMentions (f agent)
    (let* ((source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (spec (js-object :agent_id (nativeGet agent "agent_id")
        :rules (js-array (js-object :id "default" :enabled t
          :sources (js-array (js-object :conversation_ref (nativeGet source "conversation_ref") :include_threads false))
          :event_kinds (js-array "message.created")
          :predicate (js-object :field "mentions.id" :op "in" :value (js-array "ou_human" "ou_bot"))
          :context_policy (js-object :mode "current" :max_events 1 :max_bytes 16384)))
        :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 86400) :start "now"))
      (preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec spec)))))
      (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "native-mention-subscription"))))
  (defun routes () (js-array
    (js-object :source_connection_id "lark" :mention_id "ou_human" :reply_connection_id "lark-user")
    (js-object :source_connection_id "lark" :mention_id "ou_bot" :reply_connection_id "lark")))
  (defasync configure (f agent)
    (callOk f "A" "session.rules.update" (js-object :agent_id (nativeGet agent "agent_id")
      :expected_revision 1 :text "Only explicit tool calls send a reply." :reply_routes (routes) :idempotency_key "mention-routes")))
  (defun nativeEvent (f id ids sender)
    (normalizeLarkEvent (aref (nativeGet (nativeGet f "config") "connections") 0)
      (flattenLarkEvent (js-object :header (js-object :event_type "im.message.receive_v1" :app_id "source_app")
        :event (js-object :sender (js-object :sender_id (js-object :open_id sender) :sender_type "user")
          :message (js-object :message_id id :chat_id "c1" :chat_type "group" :message_type "text"
            :create_time "1767225600000" :content "{\"text\":\"native mention\"}"
            :mentions (js-call ids :map (lambda (mention) (js-object :id (js-object :open_id mention) :name "Native mention")))))))))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defun sent (f id) (nativeGet (js-call (nativeGet (nativeGet f "ports") "im_ports") :get id) "sent"))
  (withCase "T38.mention-replies.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (configure f agent)) (await (subscribeMentions f agent))
      (await (js-call f :ingest (nativeEvent f "ordinary-without-mention" (js-array) "ou_human")))
      ;; Both user-sent self-mentions and another sender use exactly the native metadata.
      (await (js-call f :ingest (nativeEvent f "human-mentioned" (js-array "ou_human") "ou_human")))
      (await (js-call f :ingest (nativeEvent f "bot-mentioned" (js-array "ou_bot") "ou_human")))
      (await (js-call f :tick))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 0)
      (js-call (expect (js-length (sent f "lark"))) :toBe 0)
      (let ((i 0))
        (while (< i 2)
          (let* ((envelope (nativeGet (aref (inputs f) i) "envelope"))
            (expected (if (= i 0) "lark-user" "lark"))
            (ref (nativeGet envelope "reply_context_id")))
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "connection_id")) :toBe expected)
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "identity")) :toBe (if (= i 0) "user" "bot"))
            (js-call (expect (nativeGet (aref (nativeGet envelope "mentions") 0) "id")) :toBe (if (= i 0) "ou_human" "ou_bot"))
            (let ((invalid (await (js-call f :call (nativeGet f "A") "message.reply" (js-object :reply_context_id ref
              :connection_id "wrong" :content (js-object :type "text" :text "override") :idempotency_key (str "override-" i))))))
              (js-call (expect (nativeGet invalid "ok")) :toBe false))
            (let ((args (js-object :reply_context_id ref :content (js-object :type "text" :text "Intentional tool reply") :idempotency_key (str "reply-" i))))
              (await (callOk f "A" "message.reply" args))
              (await (callOk f "A" "message.reply" args))))
          (setq i (1+ i))))
      (await (js-call f :tick))
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 1)
      (js-call (expect (js-length (sent f "lark"))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark-user") 0) "outbound") "native_reply_to")) :toBe "human-mentioned")
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark") 0) "outbound") "native_reply_to")) :toBe "bot-mentioned")
      (let* ((item (nativeGet (aref (inputs f) 0) "envelope"))
        (visible (await (callOk f "A" "message.get" (js-object :event_id (nativeGet item "event_id"))))))
        (js-call (expect (nativeGet (aref (nativeGet visible "mentions") 0) "id")) :toBe "ou_human"))
      (await (js-call f :restart))
      (let ((saved (await (callOk f "A" "session.rules.get" (js-object :agent_id (nativeGet agent "agent_id"))))))
        (js-call (expect (js-length (nativeGet saved "reply_routes"))) :toBe 2))
      (await (js-call f :ingest (nativeEvent f "both-mentioned" (js-array "ou_human" "ou_bot") "other")))
      (await (js-call f :tick))
      (let ((envelope (nativeGet (aref (inputs f) 2) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "reply_route") "status")) :toBe "ambiguous_target")
        (js-call (expect (nativeGet envelope "reply_context_id")) :toBeNull)
        (js-call (expect (nativeGet envelope "allowed_actions")) :toEqual (js-array)))
      (js-call (expect (js-length (sent f "lark"))) :toBe 1))) closeFixture)
  (withCase "T40.mention-reply-guards.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (key (nativeGet agent "agent_id"))
      (bad (await (js-call f :call (nativeGet f "A") "session.rules.update"
        (js-object :agent_id key :expected_revision 1 :text "bad" :reply_routes (js-array
          (js-object :source_connection_id "lark" :mention_id "ou_human" :reply_connection_id "telegram")) :idempotency_key "cross-im")))))
      (js-call (expect (nativeGet bad "ok")) :toBe false)
      (await (configure f agent)) (await (subscribe f agent "lark"))
      (await (js-call f :ingest (nativeEvent f "future-stale" (js-array "ou_human") "other")))
      (await (js-call f :tick))
      (let* ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id"))
        (user (aref (nativeGet (nativeGet f "config") "connections") 2)))
        (put user :identity_revision 2)
        (await (js-call f :restart))
        (let ((denied (await (js-call f :call (nativeGet f "A") "message.reply"
          (js-object :reply_context_id ref :content (js-object :type "text" :text "must refuse") :idempotency_key "stale-route")))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (await (js-call f :ingest (nativeEvent f "new-stale" (js-array "ou_human") "other")))
        (await (js-call f :tick))
        (let ((envelope (nativeGet (aref (inputs f) 1) "envelope")))
          (js-call (expect (nativeGet (nativeGet envelope "reply_route") "status")) :toBe "stale_reference")
          (js-call (expect (nativeGet envelope "reply_context_id")) :toBeNull)))
      (js-call (expect (js-length (sent f "lark"))) :toBe 0)
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 0))) closeFixture)

  (withCase "T40.interaction-replies.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object :agent_id (nativeGet agent "agent_id")
        :rules (js-array (js-object :id "default" :enabled t
          :event_kinds (js-array "message.created" "message.reaction.added")
          :predicate (js-object :field "interaction.target_id" :op "in" :value (js-array "ou_human" "ou_bot"))))))))))
      (await (configure f agent))
      (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "reply-interactions")))
      (let ((i 0))
        (while (< i 2)
          (let* ((id (str "respond-" i)) (target (if (= i 0) "ou_human" "ou_bot"))
            (event (nativeEvent f id (js-array) "colleague")))
            (put event :interaction (js-object :state "resolved" :kind "reply" :target_id target
              :target_kind (if (= i 0) "human" "bot") :target_message_id (str "original-" i) :addressed_self false))
            (put event :reply_to (js-object :id (str "original-" i)))
            (await (js-call f :ingest event))) (setq i (1+ i))))
      (await (js-call f :tick))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (let ((i 0))
        (while (< i 2)
          (let* ((envelope (nativeGet (aref (inputs f) i) "envelope"))
            (connection (if (= i 0) "lark-user" "lark")))
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "connection_id")) :toBe connection)
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "mention_ids")) :toEqual (js-array))
            (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
              :content (js-object :type "text" :text "Explicit response") :idempotency_key (str "interaction-reply-" i)))))
          (setq i (1+ i))))
      (await (js-call f :tick))
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark-user") 0) "outbound") "native_reply_to")) :toBe "respond-0")
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark") 0) "outbound") "native_reply_to")) :toBe "respond-1"))) closeFixture)
  (defun crossEvent (f connection id ids &optional keys)
    (let* ((config (js-call (nativeGet (nativeGet f "config") "connections") :find
      (lambda (item) (= (nativeGet item "connection_id") connection))))
      (event (nativeEvent f id ids "colleague")))
      (put event :connection_id connection) (put (nativeGet event "conversation") :connection_id connection)
      (put event :addressed_self false)
      (when keys (let ((i 0)) (while (< i (js-length ids))
        (put (aref (nativeGet event "mentions") i) :key (aref keys i)) (setq i (1+ i))))) event))
  (withCase "T38.reply-identity-safety.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec (js-object
        :agent_id (nativeGet agent "agent_id")
        :rules (js-array (js-object :id "default" :enabled t
          :event_kinds (js-array "message.created")
          :predicate (js-object :all (js-array))))))))) (latest nil))
      (try
        (await (configure f agent))
        (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key "safety-subscribe")))
        ;; The source knows its own bot, while the other application's OpenID is
        ;; not in reply_routes. Both exact native-message views must choose bot.
        (await (js-call f :ingest (crossEvent f "lark" "same-bot" (js-array "ou_bot"))))
        (await (js-call f :ingest (crossEvent f "lark-user" "same-bot" (js-array "foreign-bot"))))
        (await (js-call f :tick))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (js-call (inputs f) :forEach (lambda (input)
          (js-call (expect (nativeGet (nativeGet (nativeGet input "envelope") "reply_route") "connection_id")) :toBe "lark")))
        ;; A missing mapping alone never turns an unrecognized @ into a user reply.
        (await (js-call f :ingest (crossEvent f "lark-user" "missing-bot" (js-array "foreign-bot"))))
        (await (js-call f :tick))
        (setq latest (nativeGet (aref (inputs f) 1) "envelope"))
        (js-call (expect (nativeGet (nativeGet latest "reply_route") "status")) :toBe "unmapped_target")
        (js-call (expect (nativeGet latest "reply_context_id")) :toBeNull)
        ;; Real contradictory mappings across two views cannot be delegated to AI.
        (await (js-call f :ingest (crossEvent f "lark" "conflicting" (js-array "ou_bot"))))
        (await (js-call f :ingest (crossEvent f "lark-user" "conflicting" (js-array "ou_user"))))
        (await (js-call f :tick))
        (let ((i 2)) (while (< i 3)
          (setq latest (nativeGet (aref (inputs f) i) "envelope"))
          (js-call (expect (nativeGet (nativeGet latest "reply_route") "status")) :toBe "ambiguous_target")
          (js-call (expect (nativeGet latest "reply_context_id")) :toBeNull)
          (setq i (1+ i))))
        ;; Native mention keys relate multi-mention OpenIDs even in different order.
        (await (js-call f :ingest (crossEvent f "lark" "multi-bot" (js-array "ou_bot" "ou_bot") (js-array "@_user_1" "@_user_2"))))
        (await (js-call f :ingest (crossEvent f "lark-user" "multi-bot" (js-array "foreign-bot-b" "foreign-bot-a") (js-array "@_user_2" "@_user_1"))))
        (await (js-call f :tick))
        (let ((i 3)) (while (< i 4)
          (setq latest (nativeGet (aref (inputs f) i) "envelope"))
          (js-call (expect (nativeGet (nativeGet latest "reply_route") "connection_id")) :toBe "lark")
          (setq i (1+ i))))
        ;; Late transport evidence cannot rewrite the committed identity snapshot.
        (await (js-call f :ingest (crossEvent f "lark" "late-conflict" (js-array "ou_bot"))))
        (await (js-call f :tick))
        (setq latest (nativeGet (aref (inputs f) 4) "envelope"))
        (let* ((ref (nativeGet latest "reply_context_id"))
          (args (js-object :reply_context_id ref :content (js-object :type "text" :text "Keep the original bot identity") :idempotency_key "late-queued"))
          (accepted (await (callOk f "A" "message.reply" args))))
          (await (js-call f :ingest (crossEvent f "lark-user" "late-conflict" (js-array "ou_user"))))
          (let ((refreshed (await (callOk f "A" "message.reply_context" (js-object :delivery_id (nativeGet latest "delivery_id"))))))
            (js-call (expect (nativeGet refreshed "reply_context_id")) :toBeDefined))
          (await (callOk f "A" "message.reply" args))
          (await (js-call f :tick))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT state FROM outbound WHERE outbound_id=?") :get
            (nativeGet accepted "outbound_id")) "state")) :toBe "accepted")
          (js-call (expect (js-length (sent f "lark"))) :toBe 1)
          (js-call (expect (js-length (sent f "lark-user"))) :toBe 0))
        ;; A follow-up under a bot-owned topic root must keep the bot reply route
        ;; even when the user connection also observed prior thread participation.
        (let ((bot-view (crossEvent f "lark" "bot-thread-followup" (js-array)))
              (user-view (crossEvent f "lark-user" "bot-thread-followup" (js-array))))
          (put (nativeGet bot-view "conversation") :native_thread_id "t1")
          (put (nativeGet bot-view "conversation") :thread_kind "thread")
          (put (nativeGet user-view "conversation") :native_thread_id "t1")
          (put (nativeGet user-view "conversation") :thread_kind "thread")
          (put bot-view :root_message_id "om_bot_root")
          (put user-view :root_message_id "om_bot_root")
          (put bot-view :interaction (js-object :state "resolved" :kind "thread"
            :target_id "ou_bot" :target_kind "bot" :target_message_id "om_bot_root" :addressed_self t))
          (put user-view :interaction (js-object :state "resolved" :kind "thread" :basis "thread_participation"
            :target_id "ou_user" :target_kind "human" :target_message_id "om_user_prev" :addressed_self t))
          (js-call (expect (nativeGet (await (js-call f :ingest bot-view)) "ok")) :toBe t)
          (await (js-call f :tick))
          (let ((first-delivered (nativeGet (aref (inputs f) (- (js-length (inputs f)) 1)) "envelope")))
            (js-call (expect (nativeGet (nativeGet first-delivered "reply_route") "status")) :toBe "ready")
            (js-call (expect (nativeGet (nativeGet first-delivered "reply_route") "connection_id")) :toBe "lark")
            (js-call (expect (nativeGet (await (js-call f :ingest user-view)) "ok")) :toBe t)
            (await (js-call f :tick))
            (setq latest (nativeGet (aref (inputs f) (- (js-length (inputs f)) 1)) "envelope"))
            (js-call (expect (nativeGet (nativeGet latest "reply_route") "status")) :toBe "ready")
            (js-call (expect (nativeGet (nativeGet latest "reply_route") "connection_id")) :toBe "lark")
            (let ((refreshed (await (callOk f "A" "message.reply_context"
                    (js-object :delivery_id (nativeGet first-delivered "delivery_id"))))))
              (js-call (expect (nativeGet refreshed "reply_context_id")) :toBeDefined)
              (await (callOk f "A" "message.reply" (js-object
                :reply_context_id (nativeGet refreshed "reply_context_id")
                :content (js-object :type "text" :text "bot thread reply succeeds")
                :idempotency_key "bot-thread-followup-reply")))))
          (await (js-call f :tick))
          (js-call (expect (js-length (sent f "lark"))) :toBe 2)
          (js-call (expect (js-length (sent f "lark-user"))) :toBe 0))
        ;; Private recipient and sender echo share one native message. Exercise
        ;; both arrival orders, reverse bot/user direction, self-chat and human DM.
        (let ((index 0))
          (while (< index 5)
            (let* ((id (str "private-recipient-" index)) (bot-recipient (< index 2))
              (expected (if bot-recipient "lark" "lark-user"))
              (primary (crossEvent f expected id (js-array)))
              (peer-id (if bot-recipient "lark-user" "lark"))
              (peer (crossEvent f peer-id id (js-array)))
              (offset (js-length (inputs f))) (args nil) (outbound nil))
              (put primary :chat_type "p2p") (put peer :chat_type "p2p")
              (put primary :sender (js-object :id (cond (bot-recipient "native-human-in-bot-app")
                ((= index 2) "foreign-bot") ((= index 3) "ou_user") (t "colleague"))
                :kind (if (= index 2) "bot" "human")))
              (put peer :sender (js-object :id (if bot-recipient "ou_user" "source_app")
                :kind (if bot-recipient "human" "bot")))
              (if (= index 1)
                (progn (await (js-call f :ingest peer)) (await (js-call f :ingest primary)))
                (progn (await (js-call f :ingest primary))
                  (when (= index 2) (await (js-call f :ingest peer)))))
              (await (js-call f :tick))
              (let ((j offset))
                (while (< j (js-length (inputs f)))
                  (let ((route (nativeGet (nativeGet (aref (inputs f) j) "envelope") "reply_route")))
                    (js-call (expect (nativeGet route "status")) :toBe "ready")
                    (js-call (expect (nativeGet route "connection_id")) :toBe expected))
                  (setq j (1+ j))))
              (let ((envelope (nativeGet (aref (inputs f) offset) "envelope")))
                (setq args (js-object :reply_context_id (nativeGet envelope "reply_context_id")
                  :content (js-object :type "text" :text "Reply as the private recipient")
                  :idempotency_key (str "private-recipient-reply-" index)))
                (setq outbound (await (callOk f "A" "message.reply" args)))
                ;; A sender echo arrives after the reply handle and outbound
                ;; were frozen: neither the handle nor queued send may fail.
                (when (= index 0)
                  (await (js-call f :ingest peer))
                  (let ((refreshed (await (callOk f "A" "message.reply_context"
                    (js-object :delivery_id (nativeGet envelope "delivery_id"))))))
                    (js-call (expect (nativeGet refreshed "reply_context_id")) :toBeDefined))
                  (await (callOk f "A" "message.reply" args))))
              (await (js-call f :tick))
              (await (js-call f :tick))
              (js-call (expect (nativeGet (await (callOk f "A" "outbound.get"
                (js-object :outbound_id (nativeGet outbound "outbound_id")))) "state")) :toBe "accepted")
              (let ((last-sent (aref (sent f expected) (- (js-length (sent f expected)) 1))))
                (js-call (expect (nativeGet (nativeGet last-sent "outbound") "native_reply_to")) :toBe id)))
            (setq index (1+ index))))
        (js-call (expect (js-length (sent f "lark"))) :toBe 4)
        (js-call (expect (js-length (sent f "lark-user"))) :toBe 3)
        ;; A bot-authored topic root mentioning the user is not two direct
        ;; addressees. A late historical mention must preserve the bot handle.
        (let ((bot-view (crossEvent f "lark" "root-author-before-old-mention" (js-array)))
          (user-view (crossEvent f "lark-user" "root-author-before-old-mention" (js-array))))
          (put bot-view :interaction (js-object :state "resolved" :kind "thread" :target_id "ou_bot"
            :target_kind "bot" :target_message_id "root-with-old-mention" :addressed_self t))
          (put user-view :interaction (js-object :state "resolved" :kind "thread" :basis "thread_mention"
            :target_id "ou_user" :target_kind "human" :target_message_id "root-with-old-mention" :addressed_self t))
          (await (js-call f :ingest bot-view)) (await (js-call f :tick))
          (let* ((envelope (nativeGet (aref (inputs f) (- (js-length (inputs f)) 1)) "envelope"))
            (ref (nativeGet envelope "reply_context_id")))
            (await (js-call f :ingest user-view)) (await (js-call f :tick))
            (await (callOk f "A" "message.reply_context" (js-object :delivery_id (nativeGet envelope "delivery_id"))))
            (let ((out (await (callOk f "A" "message.reply" (js-object :reply_context_id ref
              :content (js-object :type "text" :text "Reply to the root author") :idempotency_key "root-author-reply")))))
              (await (js-call f :tick)) (await (js-call f :tick))
              (js-call (expect (nativeGet (await (callOk f "A" "outbound.get"
                (js-object :outbound_id (nativeGet out "outbound_id")))) "state")) :toBe "accepted")))
          (js-call (expect (js-length (sent f "lark"))) :toBe 5)
          (js-call (expect (js-length (sent f "lark-user"))) :toBe 3))
        (let ((saved (await (callOk f "A" "session.rules.get" (js-object :agent_id (nativeGet agent "agent_id"))))))
          (js-call (expect (nativeGet saved "text")) :toBe "Only explicit tool calls send a reply.")
          (js-call (expect (js-length (nativeGet saved "reply_routes"))) :toBe 2))
        (finally (js-call db :close))))) closeFixture)
  (defasync expectFailure (f actor operation args code &optional reason)
    (let* ((result (await (js-call f :call (nativeGet f actor) operation args)))
           (error (nativeGet result "error")))
      (js-call (expect (nativeGet result "ok")) :toBe false)
      (js-call (expect (nativeGet error "code")) :toBe code)
      (when reason (js-call (expect (nativeGet (nativeGet error "details") "reason")) :toBe reason))))

  (withCase "T40.reply-context-lifecycle.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))) (clock (nativeGet f "clock"))
          (content (js-object :type "text" :text "A single reply with the original identity")))
      (await (configure f agent))
      (await (subscribeMentions f agent))
      (await (js-call f :ingest (nativeEvent f "reply-lifecycle" (js-array "ou_human") "other")))
      (await (js-call f :tick))
      (let* ((envelope (nativeGet (aref (inputs f) 0) "envelope"))
             (ref (nativeGet envelope "reply_context_id"))
             (key (js-object :delivery_id (nativeGet envelope "delivery_id")))
             (original (await (callOk f "A" "message.reply_context" key)))
             (reply (js-object :reply_context_id ref :content content :idempotency_key "reply-lifecycle")))
        (let ((authority (nativeGet envelope "reply_authority")))
          (js-call (expect (nativeGet authority "recipient_principal_id")) :toBe "A")
          (js-call (expect (nativeGet authority "expires_at")) :toBe (nativeGet original "expires_at")))
        (js-call clock :advance 300000)
        (let* ((mine (await (callOk f "A" "delivery.get" key)))
               (inspection (await (callOk f "O" "delivery.get" key)))
               (listing (aref (nativeGet (await (callOk f "O" "delivery.list" (js-object))) "items") 0)))
          (js-call (expect (nativeGet mine "reply_context_id")) :toBe ref)
          (js-call (expect (nativeGet mine "allowed_actions")) :toContain "reply")
          (js-call (expect (nativeGet mine "reply_authority")) :toEqual (nativeGet envelope "reply_authority"))
          (js-call (js-array inspection listing) :forEach (lambda (view)
            (js-call (expect (nativeGet view "state")) :toBe "accepted")
            (js-call (expect (nativeGet view "reply_context_id")) :toBeNull)
            (js-call (expect (object-has? view "reply_authority")) :toBe false)
            (js-call (expect (nativeGet view "allowed_actions")) :toEqual (js-array)))))
        (await (expectFailure f "O" "message.reply" reply "stale_reference" "reply_reference_not_current"))
        (await (expectFailure f "O" "message.reply_context" key "forbidden" "reply_recipient_required"))
        (await (expectFailure f "O" "message.acknowledge"
          (js-object :reply_context_id ref :idempotency_key "foreign-ack") "stale_reference"))
        (put (nativeGet f "A") :authorization_revision 2)
        (await (expectFailure f "A" "message.reply" reply "stale_reference"))
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.get" key)) "reply_context_id")) :toBeNull)
        (let* ((fresh (await (callOk f "A" "message.reply_context" key)))
               (fresh-ref (nativeGet fresh "reply_context_id")))
          (js-call (expect (nativeGet fresh "expires_at")) :toBe (nativeGet original "expires_at"))
          (js-call (expect (= fresh-ref ref)) :toBe false)
          (put reply :reply_context_id fresh-ref)
          (let* ((outbound (await (callOk f "A" "message.reply" reply)))
                 (outbound-key (js-object :outbound_id (nativeGet outbound "outbound_id"))))
            (await (callOk f "A" "message.reply" reply))
            (await (js-call f :tick))
            (await (js-call f :tick))
            (js-call (expect (nativeGet (await (callOk f "O" "outbound.get" outbound-key)) "reply_context_id")) :toBeNull)
            (await (expectFailure f "O" "message.reply"
              (Object/assign (js-object :content content :idempotency_key "foreign-followup") outbound-key)
              "forbidden" "reply_recipient_required"))
            (js-call (expect (nativeGet (await (callOk f "A" "outbound.get" outbound-key)) "state")) :toBe "accepted")
            (js-call (expect (js-length (sent f "lark-user"))) :toBe 1)
            (js-call (expect (nativeGet (nativeGet (aref (sent f "lark-user") 0) "outbound") "native_reply_to")) :toBe "reply-lifecycle")
            (js-call (expect (js-length (sent f "lark"))) :toBe 0)))
        ;; Refresh in the last millisecond, then cross the deadline before the
        ;; queued operation can make any native request.
        (let ((deadline (Date/parse (nativeGet original "expires_at"))))
          (js-call clock :advance (- deadline (Date/parse (js-call clock :utcNow)) 1))
          (let* ((last (await (callOk f "A" "message.reply_context" key)))
                 (args (js-object :reply_context_id (nativeGet last "reply_context_id")
                   :content content :idempotency_key "queued-before-deadline"))
                 (queued (await (callOk f "A" "message.reply" args))))
            (js-call (expect (nativeGet last "expires_at")) :toBe (nativeGet original "expires_at"))
            (js-call clock :advance 1)
            (await (expectFailure f "A" "message.reply_context" key "reply_context_expired"))
            (put args :idempotency_key "new-after-deadline")
            (await (expectFailure f "A" "message.reply" args "reply_context_expired"))
            (await (js-call f :tick))
            (let ((outbound (await (callOk f "A" "outbound.get" (js-object :outbound_id (nativeGet queued "outbound_id"))))))
              (js-call (expect (nativeGet outbound "state")) :toBe "failed")
              (js-call (expect (nativeGet outbound "definite_not_sent")) :toBe t)
              (js-call (expect (nativeGet outbound "reply_context_id")) :toBeNull))
            (js-call (expect (js-length (sent f "lark-user"))) :toBe 1))))))
    closeFixture)
)
