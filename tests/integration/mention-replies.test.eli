(module dj.tests.integration.mention-replies
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent createImPeer)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "mention-replies" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let* ((source (aref (nativeGet config "connections") 0))
        (user (JSON/parse (JSON/stringify source)))
        (grants (nativeGet (aref (nativeGet config "principals") 2) "grants"))
        (target (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1")))
        (put source :identity "bot") (put source :event_app_id "source_app") (put source :event_subject_id "ou_bot")
        (put source :tenant_ref "same-tenant")
        (put user :connection_id "lark-user") (put user :identity "user") (put user :tenant_ref "same-tenant")
        (js-call (nativeGet config "connections") :push user)
        (js-call (nativeGet ports "im_ports") :set "lark-user" (createImPeer "lark-user"))
        (js-call grants :push (js-object :action "session.rules.read" :resources (js-array target)))
        (js-call grants :push (js-object :action "session.rules.manage" :resources (js-array target)))))))))
  (defasync subscribeMentions (f agent)
    (let* ((source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (spec (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object :sources (js-array
        (js-object :conversation_ref (nativeGet source "conversation_ref") :include_threads false)) :event_kinds (js-array "message.created"))
        :predicate (js-object :field "mentions.id" :op "in" :value (js-array "ou_human" "ou_bot"))
        :context_policy (js-object :mode "current" :max_events 1 :max_bytes 16384)
        :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 86400) :start "now"))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec spec)))))
      (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "native-mention-subscription"))))
  (defun routes () (js-array
    (js-object :source_connection_id "lark" :mention_id "ou_human" :reply_connection_id "lark-user")
    (js-object :source_connection_id "lark" :mention_id "ou_bot" :reply_connection_id "lark")))
  (defasync configure (f agent)
    (callOk f "A" "session.rules.update" (js-object :agent_id (nativeGet agent "agent_id")
      :expected_revision 1 :text "Only explicit tool calls send a reply." :reply_routes (routes) :idempotency_key "mention-routes")))
  (defun nativeEvent (f id ids sender)
    (normalizeLarkEvent (aref (nativeGet (nativeGet f "config") "connections") 0)
      (flattenLarkEvent (js-object :header (js-object :event_type "im.message.receive_v1" :app_id "source_app")
        :event (js-object :sender (js-object :sender_id (js-object :open_id sender) :sender_type "user")
          :message (js-object :message_id id :chat_id "c1" :chat_type "group" :message_type "text"
            :create_time "1767225600000" :content "{\"text\":\"native mention\"}"
            :mentions (js-call ids :map (lambda (mention) (js-object :id (js-object :open_id mention) :name "Native mention")))))))))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defun sent (f id) (nativeGet (js-call (nativeGet (nativeGet f "ports") "im_ports") :get id) "sent"))
  (withCase "T38.mention-replies.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))))
      (await (configure f agent)) (await (subscribeMentions f agent))
      (await (js-call f :ingest (nativeEvent f "ordinary-without-mention" (js-array) "ou_human")))
      ;; Both user-sent self-mentions and another sender use exactly the native metadata.
      (await (js-call f :ingest (nativeEvent f "human-mentioned" (js-array "ou_human") "ou_human")))
      (await (js-call f :ingest (nativeEvent f "bot-mentioned" (js-array "ou_bot") "ou_human")))
      (await (js-call f :tick))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 0)
      (js-call (expect (js-length (sent f "lark"))) :toBe 0)
      (let ((i 0))
        (while (< i 2)
          (let* ((envelope (nativeGet (aref (inputs f) i) "envelope"))
            (expected (if (= i 0) "lark-user" "lark"))
            (ref (nativeGet envelope "reply_context_id")))
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "connection_id")) :toBe expected)
            (js-call (expect (nativeGet (nativeGet envelope "reply_route") "identity")) :toBe (if (= i 0) "user" "bot"))
            (js-call (expect (nativeGet (aref (nativeGet envelope "mentions") 0) "id")) :toBe (if (= i 0) "ou_human" "ou_bot"))
            (let ((invalid (await (js-call f :call (nativeGet f "A") "message.reply" (js-object :reply_context_id ref
              :connection_id "wrong" :content (js-object :type "text" :text "override") :idempotency_key (str "override-" i))))))
              (js-call (expect (nativeGet invalid "ok")) :toBe false))
            (let ((args (js-object :reply_context_id ref :content (js-object :type "text" :text "Intentional tool reply") :idempotency_key (str "reply-" i))))
              (await (callOk f "A" "message.reply" args))
              (await (callOk f "A" "message.reply" args))))
          (setq i (1+ i))))
      (await (js-call f :tick))
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 1)
      (js-call (expect (js-length (sent f "lark"))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark-user") 0) "outbound") "native_reply_to")) :toBe "human-mentioned")
      (js-call (expect (nativeGet (nativeGet (aref (sent f "lark") 0) "outbound") "native_reply_to")) :toBe "bot-mentioned")
      (let* ((item (nativeGet (aref (inputs f) 0) "envelope"))
        (visible (await (callOk f "A" "message.get" (js-object :event_id (nativeGet item "event_id"))))))
        (js-call (expect (nativeGet (aref (nativeGet visible "mentions") 0) "id")) :toBe "ou_human"))
      (await (js-call f :restart))
      (let ((saved (await (callOk f "A" "session.rules.get" (js-object :agent_id (nativeGet agent "agent_id"))))))
        (js-call (expect (js-length (nativeGet saved "reply_routes"))) :toBe 2))
      (await (js-call f :ingest (nativeEvent f "both-mentioned" (js-array "ou_human" "ou_bot") "other")))
      (await (js-call f :tick))
      (let ((envelope (nativeGet (aref (inputs f) 2) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "reply_route") "status")) :toBe "ambiguous_target")
        (js-call (expect (nativeGet envelope "reply_context_id")) :toBeNull)
        (js-call (expect (nativeGet envelope "allowed_actions")) :toEqual (js-array)))
      (js-call (expect (js-length (sent f "lark"))) :toBe 1))) closeFixture)
  (withCase "T40.mention-reply-guards.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (key (nativeGet agent "agent_id"))
      (bad (await (js-call f :call (nativeGet f "A") "session.rules.update"
        (js-object :agent_id key :expected_revision 1 :text "bad" :reply_routes (js-array
          (js-object :source_connection_id "lark" :mention_id "ou_human" :reply_connection_id "telegram")) :idempotency_key "cross-im")))))
      (js-call (expect (nativeGet bad "ok")) :toBe false)
      (await (configure f agent)) (await (subscribe f agent "lark"))
      (await (js-call f :ingest (nativeEvent f "future-stale" (js-array "ou_human") "other")))
      (await (js-call f :tick))
      (let* ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id"))
        (user (aref (nativeGet (nativeGet f "config") "connections") 2)))
        (put user :identity_revision 2)
        (await (js-call f :restart))
        (let ((denied (await (js-call f :call (nativeGet f "A") "message.reply"
          (js-object :reply_context_id ref :content (js-object :type "text" :text "must refuse") :idempotency_key "stale-route")))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (await (js-call f :ingest (nativeEvent f "new-stale" (js-array "ou_human") "other")))
        (await (js-call f :tick))
        (let ((envelope (nativeGet (aref (inputs f) 1) "envelope")))
          (js-call (expect (nativeGet (nativeGet envelope "reply_route") "status")) :toBe "stale_reference")
          (js-call (expect (nativeGet envelope "reply_context_id")) :toBeNull)))
      (js-call (expect (js-length (sent f "lark"))) :toBe 0)
      (js-call (expect (js-length (sent f "lark-user"))) :toBe 0))) closeFixture)
)
