(module dj.tests.integration.tasks
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent getSession)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "task-inspection" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put config :task_inspection (js-object :administrators (js-array "O") :users (js-array
        (js-object :principal_id "O" :identities (js-array (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_admin")) :connections (js-array))
        (js-object :principal_id "A" :identities (js-array (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_a")) :connections (js-array (js-object :connection_id "lark" :identity_revision 1)))
        (js-object :principal_id "B" :identities (js-array (js-object :platform "telegram" :scope "user_id" :id "123")) :connections (js-array (js-object :connection_id "telegram" :identity_revision 1))))))
      (js-call (nativeGet config "principals") :forEach (lambda (p)
        (when (js-call (js-array "A" "B") :includes (nativeGet p "principal_id"))
          (js-call (nativeGet p "grants") :push (js-object :action "task.inspect" :resources (js-array "task-inspection")))
          (js-call (nativeGet p "grants") :push (js-object :action "task.link" :resources (js-array "task-inspection")))
          (js-call (nativeGet p "grants") :push (js-object :action "session.inspect" :resources (js-array "*")))))))))))
  (defasync denied (f actor op args)
    (let ((result (await (js-call f :call (nativeGet f actor) op args))))
      (js-call (expect (nativeGet result "ok")) :toBe false)
      (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "forbidden")))
  (defun command (id text sender &optional group)
    (let ((event (createdEvent "lark" id text)))
      (put event :sender (js-object :id sender :kind "human"))
      (put event :chat_type (if group "group" "p2p")) event))
  (withCase "T38.task-inspection.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (s1 (await (getSession f "s1"))) (s2 (await (getSession f "s2"))))
      (await (subscribe f agent "lark")) (await (subscribe f agent "telegram"))
      (await (js-call f :ingest (createdEvent "lark" "task-lark" "original request")))
      (await (js-call f :ingest (createdEvent "telegram" "task-telegram" "another source")))
      (await (js-call f :tick))
      (let* ((all (nativeGet (await (callOk f "O" "task.list" (js-object :limit 1))) "items"))
        (page (await (callOk f "O" "task.list" (js-object :limit 1))))
        (own (nativeGet (await (callOk f "A" "task.list" (js-object))) "items"))
        (other (nativeGet (await (callOk f "B" "task.list" (js-object))) "items"))
        (id (nativeGet (aref own 0) "delivery_id")))
        (js-call (expect (js-length all)) :toBe 1)
        (js-call (expect (nativeGet page "next_after")) :toBeTruthy)
        (js-call (expect (js-length (nativeGet (await (callOk f "O" "task.list" (js-object :after (nativeGet page "next_after")))) "items"))) :toBe 1)
        (js-call (expect (js-length own)) :toBe 1) (js-call (expect (js-length other)) :toBe 1)
        (js-call (expect (nativeGet (nativeGet (aref own 0) "source") "connection_id")) :toBe "lark")
        (await (denied f "B" "task.tree" (js-object :delivery_id id)))
        (await (denied f "S" "task.list" (js-object)))
        (let ((tree (await (callOk f "A" "task.tree" (js-object :delivery_id id)))))
          (js-call (expect (nativeGet (nativeGet tree "task") "native_session_id")) :toBe "s1")
          (js-call (expect (nativeGet (nativeGet tree "task") "task_state")) :toBe "accepted_not_confirmed_complete")
          (js-call (expect (nativeGet tree "children_coverage")) :toBe "reported_only_unknown_children_not_inferred"))
        (let* ((args (js-object :delivery_id id :parent_session_key (nativeGet s1 "session_key")
          :child_session_key (nativeGet s2 "session_key") :idempotency_key "task-child"))
          (linked (await (callOk f "O" "task.link" args))))
          (js-call (expect (nativeGet linked "evidence")) :toBe "reported_unverified")
          (js-call (expect (nativeGet (await (callOk f "O" "task.link" args)) "evidence")) :toBe "reported_unverified")
          (js-call (expect (js-length (nativeGet (await (callOk f "A" "task.tree" (js-object :delivery_id id))) "nodes"))) :toBe 2)
          (let ((cycle (await (js-call f :call (nativeGet f "O") "task.link" (js-object :delivery_id id
            :parent_session_key (nativeGet s2 "session_key") :child_session_key (nativeGet s1 "session_key") :idempotency_key "cycle")))))
            (js-call (expect (nativeGet cycle "ok")) :toBe false)))
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
          (try
            (js-call (js-call db :query "INSERT INTO work_items(delivery_id,state,expires_at,payload) VALUES (?,'completed','2099-01-01T00:00:00.000Z',?)")
              :run id (JSON/stringify (js-object :delivery_id id :state "completed" :reason "lease_expired")))
            (finally (js-call db :close))))
        (js-call (expect (nativeGet (nativeGet (await (callOk f "O" "task.tree" (js-object :delivery_id id))) "task") "task_state")) :toBe "accepted_not_confirmed_complete")
        ;; Deterministic IM commands use the same persisted source and ordinary outbound queue.
        (let ((event (command "task-command" "/dj tasks" "ou_admin")))
          (await (js-call f :ingest event)) (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 1)
          (await (js-call f :ingest event)) (await (js-call f :tick))
          (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
            (try (js-call db :run "UPDATE task_commands SET state='prepared' WHERE state='recorded'")
              (finally (js-call db :close))))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 1))
        (await (js-call f :ingest (command "task-forged" "/dj tasks" "ou_stranger"))) (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 1)
        (js-call (expect (js-length (nativeGet (await (callOk f "O" "task.list" (js-object))) "items"))) :toBe 2)
        (await (js-call f :ingest (command "task-group" "/dj tasks" "ou_admin" t))) (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 2)
        ;; A changed grant invalidates old handles, but can safely reissue the same frozen reply route.
        (let* ((first (await (callOk f "A" "message.reply_context" (js-object :delivery_id id))))
          (actor (nativeGet f "A")))
          (put actor :authorization_revision (1+ (nativeGet actor "authorization_revision")))
          (let ((rejected (await (js-call f :call actor "message.reply" (js-object
              :reply_context_id (nativeGet first "reply_context_id") :content (js-object :type "text" :text "reply") :idempotency_key "task-reply")))))
            (js-call (expect (nativeGet (nativeGet rejected "error") "code")) :toBe "reply_context_expired"))
          (let ((fresh (await (callOk f "A" "message.reply_context" (js-object :delivery_id id)))))
            (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "B") "message.reply_context" (js-object :delivery_id id))) "ok")) :toBe false)
            (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet fresh "reply_context_id")
              :content (js-object :type "text" :text "reply") :idempotency_key "task-reply"))))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 3))))) closeFixture)
  (withCase "T31.message-consumption.sqlite" (async () nil) (async (unused)
    (let ((policies (js-array "steer" "queue" "steer_unknown")) (i 0))
      (while (< i (js-length policies))
        (let* ((policy (aref policies i))
          (f (await (createFixture (str "message-consumption-" policy) "one" (js-object :configure (lambda (config ports)
            (put config :managed_profiles (js-array))
            (put config :message_delivery (js-object :busy (if (= policy "queue") "queue" "steer") :max_in_flight 3))))))))
          (try
            (let* ((agent (await (bindRecipient f))) (peer (nativeGet f "opencode"))
              (original (nativeGet peer "submit")) (modes (js-array))
              (native (js-call (nativeGet peer "sessions") :find (lambda (s) (= (nativeGet s "native_session_id") "s1")))))
              (await (subscribe f agent "lark"))
              (put (nativeGet peer "capabilities") :message_during_run "supported")
              (put native :runtime_state "busy")
              (put peer :submit (async (binding envelope mode key context)
                (js-call modes :push mode)
                (if (and (= policy "steer_unknown") (= (js-length modes) 1))
                  (js-object :state "unknown" :kind "unknown" :definite_not_sent false :evidence_level "none")
                  (await (funcall original binding envelope mode key context)))))
              (await (js-call f :ingest (createdEvent "lark" "message-1" "first message")))
              (await (js-call f :ingest (createdEvent "lark" "message-2" "second message")))
              (await (js-call f :tick))
              (if (= policy "queue")
                (progn (js-call (expect (js-length modes)) :toBe 0) (put native :runtime_state "idle"))
                (js-call (expect (aref modes 0)) :toBe "steer"))
              (await (js-call f :tick))
              (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                (try
                  (let ((rows (js-call (js-call db :query "SELECT state FROM deliveries ORDER BY delivery_seq") :all)))
                    (js-call (expect (js-length rows)) :toBe 2)
                    (js-call (expect (nativeGet (aref rows 1) "state")) :toBe "accepted")
                    (js-call (expect (nativeGet (aref rows 0) "state")) :toBe (if (= policy "steer_unknown") "unknown" "accepted"))
                    (js-call (expect (js-length modes)) :toBe 2)
                    (js-call (expect (aref modes 1)) :toBe (if (= policy "queue") "start_idle" "steer")))
                  (finally (js-call db :close))))
              (unless (= policy "steer_unknown")
                (let ((stopped (await (js-call (nativeGet f "core") :stop "message-service-upgrade" (+ (js-call (nativeGet f "clock") :monoNow) 1000)))))
                  (js-call (expect (nativeGet (nativeGet stopped "data") "state")) :toBe "stopped"))))
            (finally (await (closeFixture f)))))
        (setq i (1+ i))))) (async (unused) nil)))
