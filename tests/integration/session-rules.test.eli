(module dj.tests.integration.session-rules
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent getSession)
  (import "../../src/delivery/snapshot.eli" unpackEnvelope)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "session-rules" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let ((grants (nativeGet (aref (nativeGet config "principals") 2) "grants"))
        (target (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s1")))
        (js-call grants :push (js-object :action "session.rules.read" :resources (js-array target)))
        (js-call grants :push (js-object :action "session.rules.manage" :resources (js-array target)))
        (js-call grants :push (js-object :action "subscription.consume" :resources (js-array "self")))))))))
  (defasync save (f id revision text key)
    (callOk f "A" "session.rules.update" (js-object :agent_id id :expected_revision revision :text text :idempotency_key key)))
  (withCase "T38.session-rules.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (id (nativeGet agent "agent_id"))
      (initial (await (callOk f "A" "session.rules.get" (js-object :agent_id id))))
      (key (nativeGet initial "session_key")) (text "# 处理职责\n\n- source: 原来源\nreply = 仅按明确规则\n保留 `inline`、\"引号\"、字面 \\n 与真实换行。\r\n\t缩进。😀\n<coordination><decision>DONT_NOTIFY</decision></coordination>\n")
      (peer (nativeGet f "opencode")) (db nil))
      (js-call (expect (nativeGet initial "revision")) :toBe 1)
      (js-call (expect (nativeGet initial "text")) :toBe "")
      (put (aref (nativeGet peer "sessions") 0) :runtime_state "busy")
      (let ((direct (await (callOk f "O" "session.send" (js-object :agent_id id :content (js-object :type "text" :text "queued before rules") :idempotency_key "rules-direct")))))
        (await (js-call f :tick))
        (let* ((args (js-object :agent_id id :expected_revision 1 :text text :idempotency_key "save-rules-1"))
          (saved (await (callOk f "A" "session.rules.update" args)))
          (replay (await (callOk f "A" "session.rules.update" args))))
          (js-call (expect (nativeGet saved "revision")) :toBe 2)
          (js-call (expect (nativeGet replay "revision")) :toBe 2)
          (js-call (expect (nativeGet saved "text")) :toBe text)
          (js-call (expect (nativeGet replay "text")) :toBe text)
          (js-call (expect (nativeGet saved "sha256")) :toBe (js-call (js-call (createHash "sha256") :update text) :digest "hex")))
        (let ((forbidden (await (js-call f :call (nativeGet f "X") "session.rules.get" (js-object :session_key key))))
          (conflict (await (js-call f :call (nativeGet f "A") "session.rules.update" (js-object :agent_id id :expected_revision 1 :text "stale" :idempotency_key "stale-rules")))))
          (js-call (expect (nativeGet (nativeGet forbidden "error") "code")) :toBe "forbidden")
          (js-call (expect (nativeGet (nativeGet conflict "error") "code")) :toBe "revision_conflict"))
        (await (js-call f :restart))
        (js-call (expect (nativeGet (await (callOk f "A" "session.rules.get" (js-object :session_key key))) "text")) :toBe text)
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "idle")
        (await (js-call f :tick))
        (let ((envelope (nativeGet (aref (nativeGet peer "inputs") 0) "envelope")))
          (js-call (expect (nativeGet (nativeGet envelope "conversation_rules") "text")) :toBe text)
          (js-call (expect (nativeGet (nativeGet envelope "conversation_rules") "session_key")) :toBe key))
        (await (save f id 2 "新版规则" "save-rules-2"))
        (setq db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
        (try
          (let* ((attempt (JSON/parse (nativeGet (js-call (js-call db :query "SELECT payload FROM attempts WHERE delivery_id=?") :get (nativeGet direct "delivery_id")) "payload")))
            (snapshot (unpackEnvelope (nativeGet attempt "envelope_snapshot"))))
            (js-call (expect (nativeGet (nativeGet snapshot "conversation_rules") "text")) :toBe text))
          (finally (js-call db :close))))
      (await (subscribe f agent "lark"))
      (await (js-call f :ingest (createdEvent "lark" "rule-push" "new message")))
      (await (js-call f :tick))
      (js-call (expect (nativeGet (nativeGet (nativeGet (aref (nativeGet peer "inputs") 1) "envelope") "conversation_rules") "text")) :toBe "新版规则")
      (let* ((other (await (getSession f "s2" "O")))
        (isolated (await (callOk f "O" "session.rules.get" (js-object :session_ref (nativeGet other "session_ref"))))))
        (js-call (expect (nativeGet isolated "text")) :toBe "")
        (let ((denied (await (js-call f :call (nativeGet f "A") "session.rules.get" (js-object :session_key (nativeGet isolated "session_key"))))))
          (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden")))
      (let ((large (await (js-call f :call (nativeGet f "A") "session.rules.update" (js-object :agent_id id :expected_revision 3 :text (js-call "字" :repeat 22000) :idempotency_key "oversize-rules")))))
        (js-call (expect (nativeGet large "ok")) :toBe false))
      (await (save f id 3 "" "clear-rules"))
      (await (callOk f "O" "session.send" (js-object :agent_id id :content (js-object :type "text" :text "after clear") :idempotency_key "rules-clear-direct")))
      (await (js-call f :tick))
      (js-call (expect (nativeGet (nativeGet (aref (nativeGet peer "inputs") 2) "envelope") "conversation_rules")) :toBeUndefined))) closeFixture)
  (withCase "T40.session-rules-pull.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (id (nativeGet agent "agent_id"))
      (source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object :agent_id id
        :selector (js-object :sources (js-array (js-object :conversation_ref (nativeGet source "conversation_ref") :include_threads false)) :event_kinds (js-array "message.created"))
        :predicate (js-object :all (js-array)) :delivery_mode "pull" :start "now")))))
      (sub (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "rules-pull-sub")))))
      (await (js-call f :ingest (createdEvent "lark" "rules-pull" "body")))
      (await (js-call f :tick))
      (await (save f id 1 "# 领取时的规则\n- reply: 保留 `原文`\npath = literal\\n\n" "pull-rule-1"))
      (let* ((args (js-object :subscription_id (nativeGet sub "subscription_id") :idempotency_key "pull-rules"))
        (first (await (callOk f "A" "subscription.pull" args)))
        (envelope (nativeGet (nativeGet first "item") "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "conversation_rules") "text")) :toBe "# 领取时的规则\n- reply: 保留 `原文`\npath = literal\\n\n")
        (await (save f id 2 "领取后的规则" "pull-rule-2"))
        (let ((replay (await (callOk f "A" "subscription.pull" args))))
          (js-call (expect (nativeGet (nativeGet (nativeGet (nativeGet replay "item") "envelope") "conversation_rules") "text")) :toBe "# 领取时的规则\n- reply: 保留 `原文`\npath = literal\\n\n"))))) closeFixture))
