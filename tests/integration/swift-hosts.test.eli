(module dj.tests.integration.swift-hosts
  (import "../../src/core/native.eli" nativeGet nativeTypeOf)
  (import "../support/case.eli" withCase)
  (import "../../tools/controller.eli" buildStatusBar)
  (import "../../tools/connector-entries.eli" writeConnectorEntry)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile rm symlink)
  (import "node:path" resolve join isAbsolute)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "bun:test" expect)
  (defasync command (file args)
    (let* ((child (Bun/spawn (js-call (js-array file) :concat args)
      (js-object :stdin "ignore" :stdout "pipe" :stderr "pipe")))
      (stdout (await (js-call (new globalThis.Response (nativeGet child "stdout")) :text)))
      (stderr (await (js-call (new globalThis.Response (nativeGet child "stderr")) :text)))
      (code (await (nativeGet child "exited"))))
      (js-object :code code :stdout stdout :stderr stderr)))
  (defasync setup ()
    (await (mkdir ".local/tests" (js-object :recursive t)))
    (let ((root (await (mkdtemp (resolve ".local/tests/swift-hosts-")))))
      (await (buildStatusBar (join root "dj-status-bar"))) root))
  (withCase "T38.swift-hosts.integration" setup (async (root)
    (let* ((helper (resolve "dist/native/dj-process-info"))
      (result (await (command helper (js-array (str (nativeGet globalThis.process "pid"))))))
      (record (JSON/parse (nativeGet result "stdout"))))
      (js-call (expect (nativeGet result "code")) :toBe 0)
      (js-call (expect (nativeGet record "pid")) :toBe (nativeGet globalThis.process "pid"))
      (js-call (expect (nativeGet record "uid")) :toBe (js-call globalThis.process :getuid))
      (js-call (expect (nativeGet record "executable")) :toBe (nativeGet globalThis.process "execPath"))
      (js-call (expect (nativeGet record "birth")) :toMatch (new globalThis.RegExp "^[0-9]+:[0-9]+$"))
      (js-call (expect (nativeTypeOf (nativeGet record "caught"))) :toBe "boolean")
      (let ((again (JSON/parse (nativeGet (await (command helper (js-array (str (nativeGet globalThis.process "pid"))))) "stdout"))))
        (js-call (expect (nativeGet again "birth")) :toBe (nativeGet record "birth"))))
    (let ((directory (await (command (join root "dj-status-bar") (js-array "--application-directory")))))
      (js-call (expect (nativeGet directory "code")) :toBe 0)
      (js-call (expect (isAbsolute (js-call (nativeGet directory "stdout") :trim))) :toBe t))
    (await (mkdir (join root "connectors/pi") (js-object :recursive t)))
    (await (symlink (resolve "dist") (join root "dist") "dir"))
    (await (writeConnectorEntry "pi" (join root "connectors/pi/extension.mjs")))
    (let* ((entry (js* "await import(pathToFileURL(join(root, 'connectors/pi/extension.mjs')).href)"))
      (handlers (new globalThis.Map))
      (host (js-object :on (lambda (event handler) (js-call handlers :set event handler))
        :sendUserMessage (lambda (message) (throw (new globalThis.Error "entry must not send a message"))))))
      (funcall (nativeGet entry "default") host)
      (js-call (expect (js-call handlers :has "session_start")) :toBe t)
      (js-call (expect (js-call handlers :has "agent_end")) :toBe t))
    (await (writeConnectorEntry "cursor" (join root "cursor/extension.cjs")))
    (await (writeFile (join root "cursor/control.cjs") "exports.activateCursorControl=(host,context)=>({host,context});\n"))
    (await (mkdir (join root "cursor/node_modules/vscode") (js-object :recursive t)))
    (await (writeFile (join root "cursor/node_modules/vscode/index.js") "module.exports={fixture:true};\n"))
    (let* ((require (createRequire (js-call (pathToFileURL (join root "cursor/extension.cjs")) :toString)))
      (entry (funcall require (join root "cursor/extension.cjs"))) (context (js-object :marker "context"))
      (result (await (js-call entry :activate context))))
      (js-call (expect (nativeGet (nativeGet result "host") "fixture")) :toBe t)
      (js-call (expect (nativeGet result "context")) :toBe context))
    (js-call (expect (await (readFile (join root "connectors/pi/extension.mjs") "utf8"))) :toContain "Generated by the DJ Eliscript build"))
    (async (root) (when root (await (rm root (js-object :recursive t :force t)))))))
