(module dj.tests.integration.slack
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/adapters/im/slack.eli" createSlackPort)
  (import "../../packages/slack/src/index.eli" createSlackClient)
  (import "../../src/adapters/im/slack-normalize.eli" normalizeSlackMessage slackMessageId)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (import "node:path" resolve)
  (defasync until (predicate)
    (let ((deadline (+ (performance/now) 5000)))
      (while (and (not (funcall predicate)) (< (performance/now) deadline))
        (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 5)))))
      (js-call (expect (not (not (funcall predicate)))) :toBe t)))
  (defun sql (f query &rest args)
    (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try (Reflect/apply (nativeGet (js-call db :query query) "all") (js-call db :query query) args)
        (finally (js-call db :close)))))
  (defasync steps (f count)
    (let ((i 0)) (while (< i count)
      (js-call (nativeGet f "clock") :advance 200)
      (await (js-call f :tick))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
      (setq i (1+ i)))))
  (defasync setup ()
    (let* ((state (js-object :sockets (js-array) :calls (js-array) :acks (js-array) :messages (new globalThis.Map)
      :poll (js-array) :poll_calls 0 :mode "normal" :deny_bot false))
      (f (await (createFixture "slack-integration" "one" (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array))
        (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (put config :connections (js-array
          (js-object :connection_id "slack-user" :platform "slack" :brand "slack" :identity "user"
            :tenant_ref "TEXAMPLE" :source_delivery "events" :event_app_id "AEXAMPLE" :event_subject_id "UOWNER"
            :credential_ref "fixture:user" :event_scope "configured" :watches (js-array (js-object :chat_id "CEXAMPLE")))
          (js-object :connection_id "slack-bot" :platform "slack" :brand "slack" :identity "bot"
            :tenant_ref "TEXAMPLE" :source_delivery "events" :event_app_id "AEXAMPLE" :event_subject_id "UBOT"
            :credential_ref "fixture:bot" :event_scope "configured" :watches (js-array (js-object :chat_id "CEXAMPLE")))))
        (put ports :credentials (js-object :resolve (lambda (ref)
          (js-object :team_id "TEXAMPLE" :app_id "AEXAMPLE" :app_token "fixture-app-token"
            :access_token (if (= ref "fixture:bot") "fixture-bot-token" "fixture-user-token")))))
        (put ports :webSocket (lambda (url)
          (let ((socket (new globalThis.EventTarget)))
            (js-call (nativeGet state "sockets") :push socket) (put socket :readyState 0)
            (put socket :send (lambda (text)
              (let* ((ack (JSON/parse text)) (root (nativeGet state "root"))
                (db (new Database (resolve root "state/dj.sqlite") (js-object :readonly t))))
                (try
                  (js-call (expect (> (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM im_event_inbox") :get) "n") 0)) :toBe t)
                  (js-call (nativeGet state "acks") :push ack)
                  (finally (js-call db :close))))))
            (put socket :close (lambda (&rest ignored)
              (unless (= (nativeGet socket "readyState") 3)
                (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close")))))
            (nativeSetTimeout (lambda () (put socket :readyState 1) (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0)
            socket)))
        (put ports :http (js-object :fetch (async (url options)
          (let* ((method (js-call (nativeGet (new globalThis.URL url) "pathname") :replace "/api/" ""))
            (body (JSON/parse (nativeGet options "body")))
            (bot (= (nativeGet (nativeGet options "headers") "authorization") "Bearer fixture-bot-token"))
            (self (if bot "UBOT" "UOWNER"))
            (message (and (nativeGet body "timestamp") (js-call (nativeGet state "messages") :get (nativeGet body "timestamp")))))
            (js-call (nativeGet state "calls") :push (js-object :method method :body body :self self))
            (cond
              ((= method "auth.test") (Response/json (Object/assign (js-object :ok t :user_id self :team_id "TEXAMPLE") (if bot (js-object :bot_id "BBOT") (js-object)))))
              ((= method "apps.connections.open") (Response/json (js-object :ok t :url "wss://fixture.slack.com/socket")))
              ((= method "conversations.info") (Response/json (if (and bot (nativeGet state "deny_bot"))
                (js-object :ok false :error "channel_not_found") (js-object :ok t :channel (js-object :id (nativeGet body "channel") :is_member t)))))
              ((= method "users.info") (Response/json (js-object :ok t :user (js-object :id (nativeGet body "user") :is_bot (= (nativeGet body "user") "UBOT")))))
              ((js-call (js-array "conversations.history" "conversations.replies") :includes method)
                (put state :poll_calls (1+ (nativeGet state "poll_calls")))
                (if (= (nativeGet state "mode") "limited")
                  (Response/json (js-object :ok false :error "ratelimited") (js-object :status 429 :headers (js-object :retry-after "120")))
                  (Response/json (js-object :ok t :messages (nativeGet state "poll") :has_more false
                    :response_metadata (js-object :next_cursor "")))))
              ((= method "reactions.get") (Response/json (if message
                (js-object :ok t :type "message" :channel (nativeGet body "channel") :message message)
                (js-object :ok false :error "message_not_found"))))
              ((js-call (js-array "reactions.add" "reactions.remove") :includes method)
                (let ((rows (nativeGet message "reactions" (js-array))) (name (nativeGet body "name")))
                  (put message :reactions (js-call rows :filter (lambda (row) (not (= name (nativeGet row "name"))))))
                  (when (= method "reactions.add") (js-call (nativeGet message "reactions") :push (js-object :name name :users (js-array self) :count 1)))
                  (Response/json (js-object :ok t))))
              ((= method "chat.postMessage")
                (cond ((= (nativeGet state "mode") "lost") (throw (new globalThis.Error "response lost")))
                  ((= (nativeGet state "mode") "server") (Response/json (js-object :ok false :error "internal_error") (js-object :status 500)))
                  (t (Response/json (js-object :ok t :channel (nativeGet body "channel") :ts "1793400001.000001")))))
              ((= method "chat.update")
                (let ((row (js-call (nativeGet state "messages") :get (nativeGet body "ts"))))
                  (put row :text (nativeGet body "text")) (Response/json (js-object :ok t :channel (nativeGet body "channel") :ts (nativeGet body "ts")))))
              ((= method "chat.delete") (js-call (nativeGet state "messages") :delete (nativeGet body "ts")) (Response/json (js-object :ok t)))
              (t (throw (new globalThis.Error (str "unexpected method " method)))))))))))))))
      (put state :root (nativeGet f "root")) (put f :slack_state state)
      (await (until (lambda () (and (= (js-length (nativeGet state "sockets")) 1)
        (= (nativeGet (aref (nativeGet state "sockets") 0) "readyState") 1))))) f))
  (defun emit (f key message &optional team)
    (let* ((state (nativeGet f "slack_state")) (socket (js-call (nativeGet state "sockets") :at -1))
      (event (new globalThis.Event "message")))
      (when (nativeGet message "ts") (js-call (nativeGet state "messages") :set (nativeGet message "ts") message))
      (put event :data (JSON/stringify (js-object :type "events_api" :envelope_id key :payload
        (js-object :team_id (or team "TEXAMPLE") :api_app_id "AEXAMPLE" :event_id key :event message))))
      (js-call socket :dispatchEvent event)))
  (defun newMessage (timestamp text &optional thread)
    (Object/assign (js-object :type "message" :channel "CEXAMPLE" :ts timestamp :text text :user "UHUMAN")
      (if thread (js-object :thread_ts thread) (js-object))))
  (withCase "T24.slack.transport.integration" setup (async (f)
    (let ((state (nativeGet f "slack_state")))
      (emit f "evt-one" (newMessage "1793400000.000001" "<@UOWNER> <@UBOT> hello"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 1))))
      (emit f "evt-duplicate" (newMessage "1793400000.000001" "<@UOWNER> <@UBOT> hello"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 2))))
      (js-call (expect (nativeGet (aref (sql f "SELECT count(*) AS n FROM im_event_inbox") 0) "n")) :toBe 2)
      (await (steps f 4))
      (js-call (expect (nativeGet (aref (sql f "SELECT count(*) AS n FROM events WHERE native_message_id='CEXAMPLE:1793400000.000001'") 0) "n")) :toBe 2)
      (let* ((row (aref (sql f "SELECT payload FROM events WHERE connection_id='slack-user' LIMIT 1") 0))
        (event (JSON/parse (nativeGet row "payload"))))
        (js-call (expect (nativeGet event "addressed_self")) :toBe t))
      (js-call (expect (js-length (nativeGet state "sockets"))) :toBe 1)
      (let ((probe (await (callOk f "O" "connection.probe" (js-object :connection_id "slack-user")))))
        (js-call (expect (nativeGet (nativeGet probe "event_source") "state")) :toBe "connected")
        (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get "connection.probe")
          (js-object :ok t :request_id "slack-wire" :data probe :warnings (js-array) :evidence_level "service_record" :effect_state "none")) "ok")) :toBe t))
      ;; Metadata visible to one installation does not authorize the other.
      (put state :deny_bot t) (js-call (nativeGet f "clock") :advance 61000)
      (emit f "evt-private" (newMessage "1793400000.000011" "private"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 3))))
      (js-call (expect (nativeGet (aref (sql f "SELECT count(*) AS n FROM im_event_inbox WHERE source_key='CEXAMPLE:1793400000.000011:created'") 0) "n")) :toBe 1)
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
        (try (js-call db :exec "CREATE TRIGGER reject_slack BEFORE INSERT ON im_event_inbox WHEN NEW.source_key='CEXAMPLE:1793400000.000012:created' BEGIN SELECT RAISE(ABORT,'fixture unavailable'); END")
          (finally (js-call db :close))))
      (emit f "evt-failed" (newMessage "1793400000.000012" "retry"))
      (await (until (lambda () (= (nativeGet (aref (nativeGet state "sockets") 0) "readyState") 3))))
      (js-call (expect (js-length (nativeGet state "acks"))) :toBe 3)
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
        (try (js-call db :exec "DROP TRIGGER reject_slack") (finally (js-call db :close))))
      (await (until (lambda () (and (= (js-length (nativeGet state "sockets")) 2)
        (= (nativeGet (aref (nativeGet state "sockets") 1) "readyState") 1)))))
      (emit f "evt-failed" (newMessage "1793400000.000012" "retry"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 4))))
      (await (steps f 4))
      (js-call (expect (nativeGet (aref (sql f "SELECT count(*) AS n FROM events WHERE native_message_id='CEXAMPLE:1793400000.000012'") 0) "n")) :toBe 1)
      (let ((root (newMessage "1793400000.000013" "our root")))
        (put root :user "UOWNER") (emit f "evt-root" root))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 5))))
      (emit f "evt-thread" (newMessage "1793400000.000014" "thread response" "1793400000.000013"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 6))))
      (emit f "evt-reaction" (js-object :type "reaction_added" :user "UOWNER" :reaction "pushpin"
        :event_ts "1793400000.000015" :item (js-object :type "message" :channel "CEXAMPLE" :ts "1793400000.000012")))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 7))))
      (await (steps f 4))
      (let ((thread (JSON/parse (nativeGet (aref (sql f "SELECT payload FROM events WHERE connection_id='slack-user' AND native_message_id='CEXAMPLE:1793400000.000014'") 0) "payload"))))
        (js-call (expect (nativeGet (nativeGet thread "interaction") "addressed_self")) :toBe t))
      (let ((reaction (JSON/parse (nativeGet (aref (sql f "SELECT payload FROM events WHERE source_key='reaction:evt-reaction'") 0) "payload"))))
        (js-call (expect (nativeGet (nativeGet (nativeGet reaction "reaction") "operator") "is_self")) :toBe t)))) closeFixture)
  (withCase "T40.slack.actions.integration" setup (async (f)
    (let* ((state (nativeGet f "slack_state")) (ports (nativeGet f "ports"))
      (port (createSlackPort (aref (nativeGet (nativeGet f "config") "connections") 0) ports))
      (context (js-object :deadline (+ (js-call (nativeGet f "clock") :monoNow) 10000)))
      (message (newMessage "1793400000.000002" "original")))
      (put message :user "UOWNER") (js-call (nativeGet state "messages") :set (nativeGet message "ts") message)
      (let ((event (normalizeSlackMessage (aref (nativeGet (nativeGet f "config") "connections") 0) message "CEXAMPLE")))
        (await (js-call f :ingest event)))
      (let* ((event-id (nativeGet (JSON/parse (nativeGet (aref (sql f "SELECT payload FROM events LIMIT 1") 0) "payload")) "event_id"))
        (edit (await (callOk f "O" "message.edit" (js-object :event_id event-id :content (js-object :type "text" :text "edited 中文\nline") :idempotency_key "slack-edit")))))
        (js-call (expect (nativeGet edit "state")) :toBe "accepted")
        (js-call (expect (nativeGet edit "confirmed")) :toBe t)
        (let* ((added (await (callOk f "O" "message.reaction.add" (js-object :event_id event-id :emoji_type "pushpin" :idempotency_key "slack-reaction"))))
          (listed (await (callOk f "O" "message.reaction.list" (js-object :event_id event-id :limit 10)))))
          (js-call (expect (nativeGet added "reaction_id")) :toBe "pushpin:UOWNER")
          (js-call (expect (js-length (nativeGet listed "items"))) :toBe 1)
          (await (callOk f "O" "message.reaction.remove" (js-object :event_id event-id :reaction_id "pushpin:UOWNER" :idempotency_key "slack-remove"))))
        (let ((deleted (await (callOk f "O" "message.recall" (js-object :event_id event-id :idempotency_key "slack-recall")))))
          (js-call (expect (nativeGet deleted "state")) :toBe "accepted")))
      (let* ((outbound (js-object :destination (js-object :connection_id "slack-user" :native_chat_id "CEXAMPLE" :native_thread_id "1793400000.000001")
          :native_reply_to "CEXAMPLE:1793400000.000003" :content (js-object :text "reply")))
        (sent (await (js-call port :send outbound "send-once" context))))
        (js-call (expect (nativeGet sent "state")) :toBe "accepted")
        (js-call (expect (nativeGet (nativeGet (js-call (nativeGet state "calls") :at -1) "body") "thread_ts")) :toBe "1793400000.000001")
        (Reflect/deleteProperty outbound "native_reply_to")
        (js-call (expect (nativeGet (await (js-call port :send outbound "thread-send" context)) "state")) :toBe "accepted")
        (js-call (expect (nativeGet (nativeGet (js-call (nativeGet state "calls") :at -1) "body") "thread_ts")) :toBe "1793400000.000001")
        (put outbound :native_reply_to "CEXAMPLE:1793400000.000003")
        (put state :mode "lost")
        (js-call (expect (nativeGet (await (js-call port :send outbound "send-lost" context)) "state")) :toBe "unknown")
        (put state :mode "server")
        (js-call (expect (nativeGet (await (js-call port :send outbound "send-server" context)) "state")) :toBe "unknown")
        (put (nativeGet outbound "destination") :native_chat_id "COTHER")
        (let ((count (js-length (nativeGet state "calls"))))
          (js-call (expect (nativeGet (await (js-call port :send outbound "cross-channel" context)) "state")) :toBe "failed")
          (js-call (expect (js-length (nativeGet state "calls"))) :toBe count))
        (await (js-call port :close))))) closeFixture)
  (withCase "T27.slack.routing.integration" setup (async (f)
    (let* ((state (nativeGet f "slack_state")) (agent (await (bindRecipient f)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object
        :agent_id (nativeGet agent "agent_id") :selector (js-object :sources (js-array (js-object :connection_id "slack-user")) :event_kinds (js-array "message.created"))
        :predicate (js-object :op "contains" :field "text" :value "work") :context_policy (js-object :mode "current" :max_events 1 :max_bytes 16384)
        :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 86400) :start "now"))))))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "slack-subscribe")))
      (emit f "evt-route" (newMessage "1793400000.000004" "<@UOWNER> work"))
      (await (until (lambda () (= (js-length (nativeGet state "acks")) 1))))
      (await (steps f 10))
      (let* ((input (aref (nativeGet (nativeGet f "opencode") "inputs") 0))
        (envelope (nativeGet input "envelope")) (reply-context (nativeGet envelope "reply_context_id")))
        (js-call (expect reply-context) :toBeTruthy)
        (await (steps f 4))
        (js-call (expect (js-call (nativeGet (js-call (nativeGet state "messages") :get "1793400000.000004") "reactions" (js-array))
          :some (lambda (row) (= (nativeGet row "name") "keyboard")))) :toBe t)
        (await (callOk f "A" "message.reply" (js-object :reply_context_id reply-context :content (js-object :type "text" :text "done") :idempotency_key "slack-reply")))
        (await (steps f 10))
        (js-call (expect (js-call (nativeGet (js-call (nativeGet state "messages") :get "1793400000.000004") "reactions" (js-array))
          :some (lambda (row) (= (nativeGet row "name") "keyboard")))) :toBe false)))) closeFixture)
  (withCase "T40.slack.catchup.integration" setup (async (f)
    (let* ((state (nativeGet f "slack_state")) (timestamp (str (Math/floor (/ (Date/parse (js-call (nativeGet f "clock") :utcNow)) 1000)) ".000001")))
      (put state :poll (js-array (newMessage timestamp "HTTP catch-up")))
      (await (steps f 5))
      (await (until (lambda () (> (nativeGet state "poll_calls") 0))))
      (await (steps f 4))
      (js-call (expect (> (js-length (sql f "SELECT payload FROM events WHERE json_extract(payload,'$.content.text')='HTTP catch-up'")) 0)) :toBe t)
      (let ((calls (nativeGet state "poll_calls")))
        (await (steps f 10))
        (js-call (expect (nativeGet state "poll_calls")) :toBe calls))
      (js-call (expect (> (js-length (sql f "SELECT payload FROM poll_checkpoints WHERE conversation_key LIKE 'slack:%'")) 0)) :toBe t)
      (let* ((ports (nativeGet f "ports")) (clock (nativeGet f "clock"))
        (host (js-object :fetch (nativeGet (nativeGet ports "http") "fetch") :credentials (nativeGet ports "credentials") :monoNow (nativeGet clock "monoNow")))
        (user (createSlackClient (aref (nativeGet (nativeGet f "config") "connections") 0) host))
        (bot (createSlackClient (aref (nativeGet (nativeGet f "config") "connections") 1) host)))
        (try
          (put state :mode "limited")
          (let* ((first (await (js-call user :request "conversations.history" (js-object :channel "CEXAMPLE") (js-object))))
            (count (nativeGet state "poll_calls")))
            (js-call (expect (nativeGet first "status")) :toBe 429)
            (js-call (expect (nativeGet (await (js-call bot :request "conversations.history" (js-object :channel "CEXAMPLE") (js-object))) "status")) :toBe 429)
            (js-call (expect (nativeGet state "poll_calls")) :toBe count)
            (js-call clock :advance 120001) (put state :mode "normal")
            (js-call (expect (nativeGet (await (js-call bot :request "conversations.history" (js-object :channel "CEXAMPLE") (js-object))) "status")) :toBe 200))
          (finally (js-call user :close) (js-call bot :close)))))) closeFixture))
