(module dj.tests.integration.reactions
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout NativeGlobal)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../../src/core/rules.eli" evaluatePredicate)
  (import "../../src/adapters/im/lark-wire.eli" encodeLarkFrame decodeLarkFrame)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defconst receiverState (js-object))
  (defun receiver (url) (funcall (nativeGet receiverState "make") url))
  (defasync turns (f &optional n)
    (let ((i 0)) (while (< i (or n 5))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
      (await (js-call f :tick)) (setq i (1+ i)))))
  (defasync setup ()
    (let* ((original globalThis.WebSocket) (socket nil) (clock nil) (f nil)
      (state (js-object :acks 0 :gets 0 :seq 0 :root nil :native (new globalThis.Map)))
      (emit nil) (reaction nil))
      (setq emit (lambda (wire)
        (let ((bytes (encodeLarkFrame (js-object :seq 1 :service 1 :method 1
          :headers (js-array (js-object :key "type" :value "event") (js-object :key "message_id" :value (nativeGet (nativeGet wire "header") "event_id")))
          :payload (Buffer/from (JSON/stringify wire) "utf8")))))
          (js-call socket :dispatchEvent (new globalThis.MessageEvent "message" (js-object :data bytes))))))
      (setq reaction (lambda (key message emoji &optional actor type stamp)
        (funcall emit (js-object :header (js-object :event_id key :event_type (or type "im.message.reaction.created_v1") :app_id "cli_test")
          :event (js-object :message_id message :reaction_type (js-object :emoji_type emoji) :operator_type "user"
            :user_id (js-object :open_id (or actor "ou_user")) :action_time (or stamp "1767225600000"))))))
      (put receiverState :make (lambda (url)
        (setq socket (new globalThis.EventTarget))
        (put socket :readyState 1)
        (put socket :send (lambda (bytes)
          (let ((frame (decodeLarkFrame bytes)))
            (when (= (js-call (nativeGet frame "payload") :toString "utf8") "{\"code\":200}")
              (let ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t))))
                (try (js-call (expect (> (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM im_event_inbox") :get) "n") 0)) :toBe t)
                  (finally (js-call db :close))))
              (put state :acks (1+ (nativeGet state "acks")))))))
        (put socket :close (lambda (&rest ignored) (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close"))))
        (nativeSetTimeout (lambda () (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0)
        socket))
      (put NativeGlobal :WebSocket receiver)
      (try
        (setq f (await (createFixture "reaction-events" "one" (js-object :configure (lambda (config ports)
          (setq clock (nativeGet ports "clock"))
          (put config :managed_profiles (js-array)) (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
          (let ((connection (aref (nativeGet config "connections") 0)))
            (Object/assign connection (js-object :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_user"))
            (put ports :credentials (js-object :resolve (lambda (ref) (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "fixture"))))
            (put ports :http (js-object :fetch (async (address options)
              (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
                (method (nativeGet options "method" "GET"))
                (body (and (nativeGet options "body") (JSON/parse (nativeGet options "body"))))
                (match (js-call path :match (new globalThis.RegExp "/messages/([^/]+)(/reactions)?$"))))
                (cond ((js-call path :endsWith "/ws/endpoint")
                  (Response/json (js-object :code 0 :data (js-object :URL "wss://fixture.larksuite.com/ws?service_id=1" :ClientConfig (js-object :PingInterval 90)))))
                  ((js-call path :endsWith "/authen/v1/user_info") (Response/json (js-object :code 0 :data (js-object :open_id "ou_user"))))
                  ((and match (aref match 2))
                    (let ((emoji (nativeGet (nativeGet body "reaction_type") "emoji_type")))
                      (cond ((= method "GET") (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false))))
                        ((= method "POST")
                          (put state :seq (1+ (nativeGet state "seq")))
                          (let ((stamp (str (Date/parse (js-call clock :utcNow)))))
                            (nativeSetTimeout (lambda () (funcall reaction (str "auto-" (nativeGet state "seq")) (aref match 1) emoji "ou_user" nil stamp)) 0)
                            (Response/json (js-object :code 0 :data (js-object :reaction_id (str "auto-" (nativeGet state "seq")) :action_time stamp)))))
                        (t (Response/json (js-object :code 0 :data (js-object)))))))
                  ((and (= method "POST") (js-call path :endsWith "/reply"))
                    (Response/json (js-object :code 0 :data (js-object :message_id "confirmed-self-reply" :chat_id "c1"))))
                  (match
                    (put state :gets (1+ (nativeGet state "gets")))
                    (Response/json (js-object :code 0 :data (js-object :items (js-array
                      (or (js-call (nativeGet state "native") :get (aref match 1))
                      (js-object :message_id (aref match 1) :chat_id "c1" :thread_id "thread-original" :root_id "root-original"
                        :msg_type "text" :create_time "1767225600000" :sender (js-object :id "author" :sender_type "user" :id_type "open_id")
                        :body (js-object :content "{\"text\":\"exact native original\"}")))) :has_more false))))
                  (t (Response/json (js-object :code 99991663))))))))
            (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort connection ports))))))))
        (put state :root (nativeGet f "root"))
        (put f :emit emit) (put f :react reaction) (put f :reaction_state state) (put f :old_socket original)
        (await (turns f 2)) f
        (catch error (put NativeGlobal :WebSocket original) (throw error)))))
  (defasync cleanup (f) (try (await (closeFixture f)) (finally (put NativeGlobal :WebSocket (nativeGet f "old_socket")))))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defasync rules (f rules)
    (let ((policy (await (callOk f "O" "message.filter.get" (js-object)))))
      (await (callOk f "O" "message.filter.update" (js-object :rules rules :expected_revision (nativeGet policy "revision")
        :idempotency_key (str "filter-" (nativeGet policy "revision")))))))
  (withCase "T38.reaction-trigger.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object :agent_id (nativeGet agent "agent_id")
        :selector (js-object :event_kinds (js-array "message.created" "message.reaction.added"))
        :predicate (js-object :any (js-array
          (js-object :all (js-array (js-object :field "event_kind" :op "eq" :value "message.created") (js-object :field "addressed_self" :op "eq" :value t)))
          (js-object :all (js-array (js-object :field "event_kind" :op "eq" :value "message.reaction.added")
            (js-object :field "reaction.emoji_type" :op "in" :value (js-array "Pin" "Fire" "Typing" "Get"))
            (js-object :any (js-array (js-object :field "reaction.operator.is_self" :op "eq" :value t)
              (js-object :field "reaction.operator.id" :op "eq" :value "blocked-operator"))))))))))))
      (react (nativeGet f "react")) (emit (nativeGet f "emit")) (state (nativeGet f "reaction_state")))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "reaction-subscription")))
      (funcall emit (js-object :header (js-object :event_id "message-event" :event_type "im.message.receive_v1" :app_id "cli_test")
        :event (js-object :sender (js-object :sender_id (js-object :open_id "author") :sender_type "user")
          :message (js-object :message_id "cached" :chat_id "c1" :chat_type "group" :message_type "text" :create_time "1767225600000"
            :content "{\"text\":\"original with native metadata\"}" :mentions (js-array)))))
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 0)
      (funcall react "pin-1" "cached" "Pin") (await (turns f 8))
      (js-call (expect (js-length (inputs f))) :toBe 1)
      (js-call (expect (nativeGet state "gets")) :toBe 0)
      (let ((envelope (nativeGet (aref (inputs f) 0) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "reaction") "emoji_type")) :toBe "Pin")
        (js-call (expect (nativeGet (nativeGet envelope "sender") "id")) :toBe "author")
        (js-call (expect (nativeGet (nativeGet (nativeGet envelope "reaction") "operator") "id")) :toBe "ou_user")
        (js-call (expect (nativeGet (nativeGet envelope "content") "text")) :toBe "original with native metadata")
        (js-call (expect (nativeGet (nativeGet envelope "source") "native_message_id")) :toBe "cached")
        (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "auto-ack"))))
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 1)
      (funcall react "pin-1" "cached" "Pin")
      (funcall react "not-configured" "cached" "OK")
      (funcall react "not-self" "cached" "Pin" "other")
      (funcall react "deleted" "cached" "Pin" nil "im.message.reaction.deleted_v1")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 1)
      (funcall react "fire-1" "cached" "Fire") (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (funcall react "native-1" "not-cached" "Pin") (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 3)
      (js-call (expect (nativeGet state "gets")) :toBe 1)
      (let ((envelope (nativeGet (aref (inputs f) 2) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "source") "native_thread_id")) :toBe "thread-original")
        (let ((body (await (callOk f "A" "message.get" (js-object :event_id (nativeGet envelope "event_id"))))))
          (js-call (expect (nativeGet (nativeGet body "reaction") "emoji_type")) :toBe "Pin")))
      (await (rules f (js-array (js-object :id "block-author" :enabled t :effect "suppress_trigger"
        :predicate (js-object :field "sender.id" :op "eq" :value "author")))))
      (funcall react "blocked-author" "cached" "Pin") (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 3)
      (await (rules f (js-array (js-object :id "block-reactor" :enabled t :effect "suppress_trigger"
        :predicate (js-object :field "sender.id" :op "eq" :value "blocked-operator")))))
      (funcall react "blocked-reactor" "cached" "Pin" "blocked-operator") (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 3)
      (await (rules f (js-array (js-object :id "block-text" :enabled t :effect "suppress_trigger"
        :predicate (js-object :field "text" :op "contains" :value "original")))))
      (funcall react "blocked-text" "cached" "Pin") (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 3)
      (js-call (expect (> (nativeGet state "acks") 9)) :toBe t))) cleanup)
  (defun emitMessage (f id sender &optional parent root thread bot)
    (js-call f :emit (js-object :header (js-object :event_id (str "event-" id) :event_type "im.message.receive_v1" :app_id "cli_test")
      :event (js-object :sender (js-object :sender_id (js-object :open_id sender) :sender_type (if bot "app" "user"))
        :message (js-object :message_id id :chat_id "c1" :chat_type "group" :message_type "text"
          :create_time "1767225600000" :content (JSON/stringify (js-object :text (str "message " id)))
          :parent_id parent :root_id root :thread_id thread :mentions (js-array))))))
  (withCase "T40.message-interactions.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object :agent_id (nativeGet agent "agent_id")
        :selector (js-object :event_kinds (js-array "message.created" "message.reaction.added"))
        :predicate (js-object :any (js-array
          (js-object :field "interaction.addressed_self" :op "eq" :value t)
          (js-object :field "interaction.target_id" :op "eq" :value "ou_bot"))))))))
      (bot-filter (js-object :id "robots" :enabled t :effect "suppress_trigger"
        :predicate (js-object :field "trigger.kind" :op "eq" :value "bot")))
      (state (nativeGet f "reaction_state")))
      (let* ((defaults (await (callOk f "A" "subscription.preview" (js-object :spec
          (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object))))))
        (normalized (nativeGet defaults "normalized_spec"))
        (predicate (nativeGet normalized "predicate")))
        (js-call (expect (nativeGet (nativeGet normalized "selector") "event_kinds"))
          :toEqual (js-array "message.created" "message.reaction.added"))
        (js-call (expect (js-length (nativeGet predicate "any"))) :toBe 5)
        (js-call (js-array
          (js-object :event_kind "message.created" :addressed_self t)
          (js-object :event_kind "message.created" :chat_type "p2p")
          (js-object :event_kind "message.created" :interaction (js-object :addressed_self t :kind "reply"))
          (js-object :event_kind "message.created" :interaction (js-object :addressed_self t :kind "thread"))
          (js-object :event_kind "message.reaction.added" :interaction (js-object :addressed_self t :kind "reaction")))
          :forEach (lambda (event) (js-call (expect (evaluatePredicate predicate event)) :toBe "true"))))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "interactions-sub")))
      (await (rules f (js-array bot-filter)))
      (emitMessage f "owned" "ou_user") (emitMessage f "bot-owned" "ou_bot" nil nil nil t)
      (emitMessage f "unrelated" "other")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 0)
      ;; A human's Yes on our message is a new action, not an old @ or echo.
      (js-call f :react "yes-self" "owned" "YES" "colleague")
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 1)
      (let ((envelope (nativeGet (aref (inputs f) 0) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "target_id")) :toBe "ou_user")
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "kind")) :toBe "reaction")
        (await (callOk f "A" "message.acknowledge" (js-object :reply_context_id (nativeGet envelope "reply_context_id") :idempotency_key "interaction-ack"))))
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 1)
      ;; The author is a bot, but the trigger is human: do not suppress it.
      (js-call f :react "yes-bot" "bot-owned" "YES" "colleague")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 2)
      (emitMessage f "quote" "colleague" "owned")
      (emitMessage f "thread-reply" "colleague" "unrelated" "owned" "native-thread")
      (emitMessage f "ordinary" "colleague")
      (emitMessage f "other-quote" "colleague" "unrelated")
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 4)
      (let ((envelopes (js-call (inputs f) :map (lambda (input) (nativeGet input "envelope")))))
        (js-call (expect (js-call envelopes :some (lambda (e) (= (nativeGet (nativeGet e "interaction") "kind") "reply")))) :toBe t)
        (js-call (expect (js-call envelopes :some (lambda (e) (= (nativeGet (nativeGet e "interaction") "kind") "thread")))) :toBe t)
        (let* ((last (aref envelopes 3))
          (readback (await (callOk f "A" "message.get" (js-object :event_id (nativeGet last "event_id"))))))
          (js-call (expect (nativeGet (nativeGet readback "interaction") "target_message_id")) :toBe "owned")))
      ;; Exact-ID fallback when the parent is outside the local retained cache.
      (js-call (nativeGet state "native") :set "uncached-parent"
        (js-object :message_id "uncached-parent" :chat_id "c1" :msg_type "text" :create_time "1767225600000"
          :sender (js-object :id "ou_user" :sender_type "user" :id_type "open_id") :body (js-object :content "{\"text\":\"native parent\"}")))
      (emitMessage f "native-quote" "colleague" "uncached-parent")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 5)
      (js-call (expect (nativeGet state "gets")) :toBe 1)
      ;; Re-delivery must not duplicate the accepted input.
      (emitMessage f "quote" "colleague" "owned")
      (js-call f :react "yes-self" "owned" "YES" "colleague")
      (js-call f :emit (js-object :header (js-object :event_id "bot-reactor" :event_type "im.message.reaction.created_v1" :app_id "cli_test")
        :event (js-object :message_id "owned" :reaction_type (js-object :emoji_type "YES")
          :operator_type "app" :app_id "other-bot" :action_time "1767225601000")))
      (await (rules f (js-array bot-filter (js-object :id "person" :enabled t :effect "suppress_trigger"
        :predicate (js-object :field "sender.id" :op "eq" :value "blocked-colleague")))))
      (js-call f :react "blocked-reaction" "owned" "YES" "blocked-colleague")
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 5)
      ;; A third-party root does not erase our later native-thread exchange.
      (emitMessage f "self-in-foreign-thread" "ou_user" "unrelated" "unrelated" "foreign-topic")
      (await (turns f))
      (emitMessage f "followup-without-at" "colleague" "unrelated" "unrelated" "foreign-topic")
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 6)
      (let ((envelope (nativeGet (aref (inputs f) 5) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "basis")) :toBe "thread_participation")
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "target_message_id")) :toBe "self-in-foreign-thread")
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "target_id")) :toBe "ou_user")
        (js-call (expect (nativeGet (nativeGet envelope "source") "native_thread_id")) :toBe "foreign-topic")
        (js-call (expect (nativeGet envelope "mentions")) :toEqual (js-array)))
      (emitMessage f "other-topic" "colleague" "unrelated" "unrelated" "different-topic")
      (emitMessage f "robot-followup" "other-bot" "unrelated" "unrelated" "foreign-topic" t)
      (emitMessage f "blocked-followup" "blocked-colleague" "unrelated" "unrelated" "foreign-topic")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 6)
      ;; Our own sends need no incoming echo: an accepted native receipt is proof.
      (emitMessage f "outbound-start" "colleague" "owned" "unrelated" "outbound-topic")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 7)
      (let* ((envelope (nativeGet (aref (inputs f) 6) "envelope"))
        (outbound (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet envelope "reply_context_id")
          :content (js-object :type "text" :text "answer in native topic") :idempotency_key "topic-answer")))))
        (await (turns f 8))
        (let ((status (await (callOk f "A" "outbound.get" (js-object :outbound_id (nativeGet outbound "outbound_id"))))))
          (js-call (expect (nativeGet status "state")) :toBe "accepted")))
      (emitMessage f "outbound-followup" "colleague" "unrelated" "unrelated" "outbound-topic")
      (await (turns f 8)) (js-call (expect (js-length (inputs f))) :toBe 8)
      (let ((envelope (nativeGet (aref (inputs f) 7) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "basis")) :toBe "thread_participation")
        (js-call (expect (nativeGet (nativeGet envelope "interaction") "target_message_id")) :toBe "confirmed-self-reply"))
      ;; Disable thread triggers without disabling direct reply triggers.
      (let* ((sub (aref (nativeGet (await (callOk f "A" "subscription.list" (js-object))) "items") 0))
        (spec (js-object :agent_id (nativeGet agent "agent_id") :selector (nativeGet sub "selector")
          :predicate (js-object :all (js-array (nativeGet sub "predicate")
            (js-object :not (js-object :field "interaction.kind" :op "eq" :value "thread"))))))
        (ticket (await (callOk f "A" "subscription.preview" (js-object :subscription_id (nativeGet sub "subscription_id")
          :expected_revision (nativeGet sub "revision") :spec spec)))))
        (await (callOk f "A" "subscription.update" (js-object :subscription_id (nativeGet sub "subscription_id")
          :expected_revision (nativeGet sub "revision") :preview_id (nativeGet ticket "preview_id") :idempotency_key "disable-thread"))))
      (emitMessage f "disabled-thread" "colleague" "unrelated" "unrelated" "foreign-topic")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 8)
      (emitMessage f "enabled-quote" "colleague" "owned")
      (await (turns f)) (js-call (expect (js-length (inputs f))) :toBe 9))) cleanup)
)
