              (await
                (js-call
                  f
                  :call
                  (nativeGet f "X")
                  "session.list"
                  (js-object :limit 1 :cursor cursor)))))
          (js-call (expect (nativeGet foreign "ok")) :toBe false))))
    closeFixture)
  (withCase
    "T46.dimensions-and-order.sqlite"
    setup
    (async
      (f)
      (let ((native (nativeGet (nativeGet f "opencode") "sessions")))
        (put (aref native 0) :updated_at "2026-01-01T00:01:00Z")
        (put (aref native 1) :updated_at "2026-01-01T00:02:00Z")
        (await
          (callOk f "O" "catalog.refresh" (js-object :idempotency_key "updated-order")))
        (await (js-call f :tick))
        (let*
          (
            (ordered
              (await
                (callOk
                  f
                  "O"
                  "session.list"
                  (js-object
                    :scope
                    (js-object
                      :tools
