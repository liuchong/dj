          (js-call
            (expect
              (js-call (nativeGet two "items") :map (lambda (s) (nativeGet s "native_session_id"))))
            :toEqual
            (js-array "s2" "s1"))))
      ) closeFixture)
  (withCase
    "T47.body-offset-and-chunk.sqlite"
    setup
    (async
      (f)
      (let*
        ((long-text (str (js-call "a" :repeat 65534) "中文😀needle"))
          (messages (nativeGet (nativeGet f "opencode") "messages")))
        (js-call
          messages
          :set
          "s1"
          (js-array
            (js-object
              :native_message_id
              "m1"
              :role
              "user"
              :text
              long-text
              :created_at
              "2026-01-01T00:00:00Z")))
        (await
          (callOk
            f
            "O"
            "catalog.refresh"
            (js-object :include_content t :idempotency_key "chunk-body")))
        (await (js-call f :tick))
        (let*
          (
            (result
              (await
