  (withCase
    "T63.precise-refresh.sqlite"
    setup
    (async
      (f)
      (let*
        (
          (sessions
            (nativeGet
              (await
                (callOk
                  f
                  "O"
                  "session.list"
                  (js-object :scope (js-object :tools (js-array "opencode")))))
              "items"))
          (one
            (js-call sessions :find (lambda (s) (= (nativeGet s "native_session_id") "s1"))))
          (seen (js-array))
          (peer (nativeGet f "opencode"))
          (read (nativeGet peer "readMessages")))
        (put
          peer
          :readMessages
          (async
            (session cursor budget ctx)
            (js-call seen :push (nativeGet session "native_session_id"))
            (await (funcall read session cursor budget ctx))))
        (await
          (callOk
            f
            "O"
            "catalog.refresh"
            (js-object
              :scope
              (js-object :session_keys (js-array (nativeGet one "session_key")))
              :include_content
              t
              :idempotency_key
              "precise-refresh")))
        (await (js-call f :tick))
        (js-call (expect seen) :toEqual (js-array "s1"))
        (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
        (js-call (expect (js-length (nativeGet peer "starts"))) :toBe 0)
        (js-call (expect (js-length (nativeGet peer "creates"))) :toBe 0)))
    closeFixture)
  (withCase
    "T60.catalog-batch-atomic.sqlite"
    setup
    (async
      (f)
      (let* ((peer (nativeGet f "opencode")) (barrier (createBarrier)))
        (put (aref (nativeGet peer "sessions") 0) :title "new atomic marker")
        (js-call
          (nativeGet peer "messages")
          :set
          "s1"
          (js-array
            (js-object
              :native_message_id
              "m1"
              :role
              "user"
              :text
              "new atomic marker"
              :created_at
              "2026-01-01T00:00:00Z")))
        (atFault
          (nativeGet f "faults")
          "catalog.after_batch_before_checkpoint"
          (async (ctx) (await (js-call barrier :wait))))
        (let*
          (
            (accepted
              (await
                (callOk
                  f
                  "O"
                  "catalog.refresh"
                  (js-object :include_content t :idempotency_key "atomic-catalog"))))
            (inflight (js-call f :tick)))
          (try
            (await (nativeGet barrier "ready"))
            (let
              (
                (before
                  (await
                    (callOk
                      f
                      "O"
                      "session.search"
                      (js-object
                        :query
                        (js-object
                          :text
                          "new atomic marker"
                          :fields
                          (js-array "title" "message.text")
                          :mode
                          "literal"))))))
