          (js-call (expect (js-length (nativeGet result "items"))) :toBe 1)
          (js-call (expect (nativeGet page "text")) :toBe "中文😀")
          (js-call (expect (nativeGet page "next_offset_bytes")) :toBe 65544)
          (let
            (
              (misaligned
                (await
                  (js-call
