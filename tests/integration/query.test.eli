                  (nativeGet f "S")
                  "session.list"
                  (js-object :limit 1 :cursor cursor)))))
          (js-call (expect (nativeGet next "ok")) :toBe false)
          (js-call (expect (nativeGet next "effect_state")) :toBe "none")
          (js-call (expect (nativeGet (nativeGet next "data" (js-object)) "items")) :toBeUndefined))
        (let
          (
