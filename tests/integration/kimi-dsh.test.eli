(module dj.tests.integration.kimi-dsh
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" hashValue)
  (import "../../src/library.eli" createCore)
  (import "../../src/host/bun/io.eli" createHostPorts)
  (import "../../src/adapters/agent/kimi-dsh.eli" createKimiDshPort)
  (import "../../src/adapters/agent/native-local.eli" metadataCommand)
  (import "../support/case.eli" withCase)
  (import "../support/process.eli" until)
  (import "node:fs/promises" mkdir writeFile readFile rm)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (defasync setup ()
    (let* ((root (resolve ".local" (str "harness-" (randomUUID)))) (child nil))
      (await (mkdir root (js-object :recursive t :mode 448)))
      (await (writeFile (resolve root "package.json") (JSON/stringify (js-object :name "@deepseek-ai/dsh")) (js-object :mode 384)))
      (await (writeFile (resolve root "state.json") "{}" (js-object :mode 384)))
      (await (writeFile (resolve root "receiver.mjs") (str "import " (JSON/stringify
        (js-call (pathToFileURL (resolve "dist-tests/tests/support/harness-receiver.mjs")) :toString)) ";") (js-object :mode 384)))
      (setq child (Bun/spawn (js-array (nativeGet globalThis.process "execPath") (resolve root "receiver.mjs") "web")
        (js-object :env (Object/assign (js-object) (nativeGet globalThis.process "env") (js-object :DJ_HARNESS_FIXTURE_ROOT root)) :stdout "ignore" :stderr "ignore")))
      (try
        (await (until "synthetic harness receiver" (async ()
          (try (JSON/parse (await (readFile (resolve root "receiver.json") "utf8"))) (catch error nil))) 5000))
        (let* ((receiver (JSON/parse (await (readFile (resolve root "receiver.json") "utf8"))))
          (helper (resolve "dist/native/dj-process-info"))
          (process (JSON/parse (await (metadataCommand helper (js-array (str (nativeGet receiver "pid"))) (js-object)))))
          (endpoint (js-object :tool "dsh" :native_provider "dsh-web" :instance_id "fixture" :native_namespace "fixture-web"
            :ownership "existing" :endpoint_ref "native-fixture" :directory root :workspace_ref "fixture-workspace"
            :base_url (str "http://127.0.0.1:" (nativeGet receiver "port"))
            :process_binding (js-object :pid (nativeGet process "pid") :process_birth (nativeGet process "birth")
              :executable_ref (nativeGet process "executable") :process_helper_ref helper
              :entry_ref (resolve root "receiver.mjs") :package_ref (resolve root "package.json"))))
          (port (createKimiDshPort "dsh" (js-object :endpoints (js-array endpoint)) (js-object))))
          (let* ((core-root (resolve root "core"))
            (actor (js-object :principal_id "fixture-operator" :kind "operator" :authorization_revision 1
              :credential_sha256 (hashValue "isolated-test-credential") :grants (js-array (js-object :action "*" :resources (js-array "*")))))
            (core (createCore (createHostPorts (js-object :root core-root))
              (js-object :schema_version 1 :config_root core-root :service (js-object :service_id "harness-fixture")
                :principals (js-array actor) :agent_endpoints (js-array endpoint) :connections (js-array) :managed_profiles (js-array))))
            (started (await (js-call core :start))))
            (js-call (expect (nativeGet started "ok")) :toBe t)
            (js-object :root root :child child :endpoint endpoint :port port :core core :actor actor)))
        (catch error (js-call child :kill) (await (nativeGet child "exited")) (await (rm root (js-object :recursive t :force t))) (throw error)))))
  (defasync cleanup (f)
    (await (js-call (nativeGet f "core") :stop "test_complete" (+ (performance/now) 2000)))
    (await (js-call (nativeGet f "port") :close))
    (js-call (nativeGet f "child") :kill) (await (nativeGet (nativeGet f "child") "exited"))
    (await (rm (nativeGet f "root") (js-object :recursive t :force t))))
  (withCase "T38.kimi-dsh.integration" setup (async (f)
    (let* ((port (nativeGet f "port")) (endpoint (nativeGet f "endpoint")) (ctx (js-object))
      (probe (await (js-call port :probeInstance endpoint ctx)))
      (listed (await (js-call port :listSessions (js-object) nil (js-object :max_records 10) ctx)))
      (original (aref (nativeGet listed "items") 0))
      (created (await (js-call port :create (Object/assign (js-object) endpoint (js-object :instance_epoch (nativeGet probe "instance_epoch")))
        "fixture-workspace" "one-create" (js-object :title "Created by DJ"))))
      (session (nativeGet created "session"))
      (envelope (js-object :schema_version 1 :kind "external_message" :content (js-object :text "Native protocol input") :allowed_actions (js-array))))
      (let ((instance (await (js-call (nativeGet f "core") :execute (nativeGet f "actor") "instance.get" (js-object :instance_id "fixture")))))
        (js-call (expect (nativeGet instance "ok")) :toBe t)
        (js-call (expect (nativeGet (nativeGet instance "data") "state")) :toBe "ready"))
      (let* ((core (nativeGet f "core")) (actor (nativeGet f "actor"))
        (accepted (await (js-call core :execute actor "session.create" (js-object :instance_id "fixture"
          :expected_instance_epoch (nativeGet probe "instance_epoch") :workspace_ref "fixture-workspace"
          :title "Core created" :idempotency_key "core-create")))) (action nil))
        (js-call (expect (nativeGet accepted "ok")) :toBe t)
        (await (until "Core native create" (async ()
          (await (js-call core :tick))
          (setq action (await (js-call core :execute actor "lifecycle.get"
            (js-object :lifecycle_id (nativeGet (nativeGet accepted "data") "lifecycle_id")))))
          (= (nativeGet (nativeGet action "data") "state") "ready")) 5000)))
      (js-call (expect (nativeGet probe "state")) :toBe "ready")
      (js-call (expect (nativeGet original "native_session_id")) :toBe "session-original")
      (js-call (expect (nativeGet original "surface")) :toBe "sdk")
      (js-call (expect (nativeGet created "state")) :toBe "ready")
      (js-call (expect (nativeGet session "title")) :toBe "Created by DJ")
      (let* ((accepted (await (js-call port :submit session envelope "steer" "one-send" ctx)))
        (messages (await (js-call port :readMessages session nil (js-object :max_records 10 :max_bytes 524288) ctx))))
        (js-call (expect (nativeGet accepted "state")) :toBe "accepted")
        (js-call (expect (nativeGet accepted "evidence_level")) :toBe "native_protocol")
        (js-call (expect (js-length (nativeGet messages "items"))) :toBe 1)
        (js-call (expect (js-call (nativeGet (aref (nativeGet messages "items") 0) "text") :includes "# notification\n")) :toBe t))
      (let ((stale (await (js-call port :submit (Object/assign (js-object) session (js-object :instance_epoch "stale")) envelope "steer" "stale-send" ctx))))
        (js-call (expect (nativeGet stale "definite_not_sent")) :toBe t))
      (await (writeFile (resolve (nativeGet f "root") "state.json") "{\"drop\":true}"))
      (let ((unknown (await (js-call port :submit session envelope "steer" "uncertain-send" ctx))))
        (js-call (expect (nativeGet unknown "state")) :toBe "unknown")
        (js-call (expect (nativeGet unknown "definite_not_sent")) :toBe false))
      (js-call (expect (js-length (JSON/parse (await (readFile (resolve (nativeGet f "root") "received.json") "utf8"))))) :toBe 2)
      (let* ((changed (Object/assign (js-object) endpoint (js-object :directory (resolve (nativeGet f "root") "other"))))
        (other (createKimiDshPort "dsh" (js-object :endpoints (js-array changed)) (js-object)))
        (result (await (js-call other :submit session envelope "steer" "wrong-workspace" ctx))))
        (js-call (expect (nativeGet result "definite_not_sent")) :toBe t)))) cleanup))
