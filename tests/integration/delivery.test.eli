    setup
    (async
      (f)
      (let* ((session (await (getSession f "s1"))) (peer (nativeGet f "opencode")))
        (put (nativeGet peer "capabilities") :max_input_frame_bytes 1048576)
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "busy")
        (let
          (
            (accepted
              (await
                (callOk
                  f
                  "S"
                  "session.send"
                  (js-object
                    :session_ref
                    (nativeGet session "session_ref")
                    :content
                    (js-object :type "text" :text (js-call "😀" :repeat 100))
                    :idempotency_key
                    "budget-changed")))))
          (put (nativeGet peer "capabilities") :max_input_frame_bytes 64)
          (put (aref (nativeGet peer "sessions") 0) :runtime_state "idle")
          (await (js-call f :tick))
          (let
            (
              (record
                (await
                  (callOk
                    f
                    "S"
                    "delivery.get"
                    (js-object :delivery_id (nativeGet accepted "delivery_id"))))))
            (js-call (expect (nativeGet record "state")) :toBe "blocked"))
          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0))))
    closeFixture)
  (withCase
    "T12.update-cutover.sqlite"
    (async () (await (createFixture "update-cutover" "one" (js-object :configure (lambda (config ports)
