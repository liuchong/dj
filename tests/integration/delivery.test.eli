      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1"))))))
    (async
      (f)
      (let*
        ((agent (await (bindRecipient f)))
          (sub (await (subscribe f agent "lark" 60)))
          (peer (nativeGet f "opencode")))
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "busy")
        (await
          (js-call
            f
            :ingest
            (createdEvent "lark" "before-update" "obsolete contribution")))
        (await (js-call f :tick))
        (let*
          (
            (source
              (await
                (callOk
                  f
                  "A"
                  "conversation.resolve"
                  (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
            (ticket
              (await
                (callOk
                  f
                  "A"
                  "subscription.preview"
                  (js-object
                    :subscription_id
                    (nativeGet sub "subscription_id")
                    :expected_revision
                    (nativeGet sub "revision")
                    :spec
                    (js-object
                      :agent_id
                      (nativeGet agent "agent_id")
                      :selector
                      (js-object
                        :sources
                        (js-array
                          (js-object
                            :conversation_ref
                            (nativeGet source "conversation_ref")
                            :include_threads
                            false))
                        :event_kinds
                        (js-array "message.created"))
                      :predicate
                      (js-object :all (js-array))
                      :context_policy
                      (js-object :mode "current" :max_events 1 :max_bytes 16384)
                      :delivery_policy
                      (js-object :busy "queue" :offline "hold" :ttl_seconds 120)
                      :start
                      "now")))))
            (args
              (js-object
                :subscription_id
                (nativeGet sub "subscription_id")
                :expected_revision
                (nativeGet sub "revision")
                :preview_id
                (nativeGet ticket "preview_id")
                :idempotency_key
                "update-fixed-version"))
            (updated (await (callOk f "A" "subscription.update" args)))
            (replayed (await (callOk f "A" "subscription.update" args))))
          (js-call (expect (nativeGet updated "revision")) :toBe (1+ (nativeGet sub "revision")))
          (js-call
            (expect (nativeGet replayed "subscription_id"))
            :toBe
            (nativeGet sub "subscription_id"))
          (await
            (js-call
              f
              :ingest
              (createdEvent "lark" "after-update" "current contribution")))
          (await (js-call f :tick))
          (put (aref (nativeGet peer "sessions") 0) :runtime_state "idle")
          (await (js-call f :tick))
          (let*
            ((all (nativeGet (await (callOk f "O" "delivery.list" (js-object))) "items"))
              (current
                (js-call
                  all
                  :find
                  (lambda
                    (d)
