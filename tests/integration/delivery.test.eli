                      ;; and per-tick (not per-wave) priority alternation on an immediately consecutive 2-wave tick.
                      (await (js-call f :tick))
                      (let ((wave-route-ids (js-array))
                        (wave-outbound-ids (js-array))
                        (tick1-wave-log (js-array))
                        (tick2-wave-log (js-array))
                        (original-db-query (nativeGet (nativeGet Database "prototype") "query"))
                        (wrap-db-query (lambda (orig on-sql)
