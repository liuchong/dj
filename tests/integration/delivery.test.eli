                  (put (aref (nativeGet peer "sessions") 1) :runtime_state "busy")
                  (js-call (nativeGet f "faults") :install "routing.before_checkpoint_commit" (async (work)
                    (let ((cur-u (await (callOk f "A" "subscription.get"
