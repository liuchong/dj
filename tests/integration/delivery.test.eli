                                    :content (js-object :type "text" :text (str "j-wave1-r-" r-idx "-" m-idx))
                                    :idempotency_key (str "j-wave1-r-" r-idx "-" m-idx))))))
                                (js-call r-items :push (nativeGet queued "delivery_id")))
                              (setq m-idx (1+ m-idx)))
                            (js-call wave-route-ids :push r-items))
                          (setq r-idx (1+ r-idx)))
