(module dj.tests.integration.delivery
  (import "../../src/core/native.eli" NativeBigInt nativeGet nativeNullish nativeSetTimeout)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "../../src/delivery/snapshot.eli" unpackEnvelope)
  (import "../support/case.eli" withCase)
  (import "../support/resources.eli" runCapacitySchedule)
  (import "../support/fixtures.eli"
    createFixture
    closeFixture
    callOk
    successful
    getSession
    bindRecipient
    subscribe
    createdEvent)
  (defasync setup () (await (createFixture "delivery" "one")))
  (withCase "T31.existing-session-epoch.sqlite"
    (async () nil)
    (async (unused)
      (let ((modes (js-array "recovered" "closed_gate" "other_session" "other_workspace" "unverified")) (index 0))
        (while (< index (js-length modes))
          (let* ((mode (aref modes index))
                 (f (await (createFixture (str "session-epoch-" mode) "one"
                   (js-object :configure (lambda (config ports) (put config :managed_profiles (js-array))))))))
            (try
              (let* ((session (await (getSession f "s1")))
                     (agent (await (bindRecipient f)))
                     (subscription (await (subscribe f agent "lark")))
                     (peer (nativeGet f "opencode"))
                     (new-epoch (str (nativeGet session "instance_epoch") "-restarted"))
                     (original-probe (nativeGet peer "probe"))
                     (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :strict t))))
                ;; Reproduce recovered instance/gate metadata with a cached old session.
                (try
                  (let* ((instance (JSON/parse (nativeGet (js-call (js-call db :query
                            "SELECT payload FROM instances WHERE instance_id=?") :get (nativeGet session "instance_id")) "payload")))
                         (gate (JSON/parse (nativeGet (js-call (js-call db :query
                            "SELECT payload FROM instance_gates WHERE instance_id=?") :get (nativeGet session "instance_id")) "payload"))))
                    (put instance :instance_epoch new-epoch)
                    (put instance :revision (1+ (nativeGet instance "revision")))
                    (put gate :instance_epoch new-epoch)
                    (put gate :state (if (= mode "closed_gate") "closed" "open"))
                    (put gate :revision (1+ (nativeGet gate "revision")))
                    (js-call db :run "BEGIN IMMEDIATE")
                    (js-call (js-call db :query "UPDATE instances SET instance_epoch=?,revision=?,payload=? WHERE instance_id=?")
                      :run new-epoch (nativeGet instance "revision") (JSON/stringify instance) (nativeGet instance "instance_id"))
                    (js-call (js-call db :query "UPDATE instance_gates SET instance_epoch=?,state=?,revision=?,payload=? WHERE instance_id=?")
                      :run new-epoch (nativeGet gate "state") (nativeGet gate "revision") (JSON/stringify gate) (nativeGet instance "instance_id"))
                    (js-call db :run "COMMIT"))
                  (finally (js-call db :close)))
                (let ((native (js-call (nativeGet peer "sessions") :find
                        (lambda (item) (= (nativeGet item "native_session_id") "s1")))))
                  (put native :instance_epoch new-epoch))
                (put peer :probe (async (target binding context)
                  (let ((observed (Object/assign (js-object) (await (funcall original-probe target binding context))
                                    (js-object :evidence_level (if (= mode "unverified") "none" "native_protocol")))))
                    (when (= mode "other_session") (put observed :native_session_id "different-session"))
                    (when (= mode "other_workspace") (put observed :workspace_ref "different-workspace"))
                    observed)))
                (await (js-call f :ingest (createdEvent "lark" (str "epoch-" mode) "epoch notification")))
                (successful (await (js-call f :tick)))
                (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                  (try
                    (let* ((stored (JSON/parse (nativeGet (js-call (js-call reader :query
                                "SELECT payload FROM sessions WHERE session_key=?") :get (nativeGet session "session_key")) "payload")))
                           (delivery (JSON/parse (nativeGet (js-call (js-call reader :query
                                "SELECT payload FROM deliveries WHERE agent_id=?") :get (nativeGet agent "agent_id")) "payload"))))
                      (js-call (expect (nativeGet stored "native_session_id")) :toBe "s1")
                      (if (= mode "recovered")
                        (progn
                          (js-call (expect (nativeGet stored "instance_epoch")) :toBe new-epoch)
                          (js-call (expect (nativeGet delivery "state")) :toBe "accepted")
                          (js-call (expect (nativeGet delivery "blocked_reason")) :toBe nil)
                          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)
                          (js-call (expect (nativeGet (nativeGet (aref (nativeGet peer "inputs") 0) "binding") "instance_epoch")) :toBe new-epoch))
                        (progn
                          (js-call (expect (nativeGet stored "instance_epoch")) :toBe (nativeGet session "instance_epoch"))
                          (js-call (expect (nativeGet delivery "state")) :toBe "deferred")
                          (js-call (expect (nativeGet delivery "blocked_reason")) :toBe "instance_stopping")
                          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
                          (js-call (expect (nativeGet (js-call (js-call reader :query "SELECT COUNT(*) AS n FROM attempts") :get) "n")) :toBe 0))))
                    (finally (js-call reader :close)))))
              (finally (await (closeFixture f)))))
          (setq index (1+ index)))))
    (async (unused) nil))
  (defasync instructionSubscription (f agent source actor key policy &optional old delivery-mode)
    (let* ((resolved-source (await (callOk f actor "conversation.resolve"
              (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
           (spec (js-object :agent_id (nativeGet agent "agent_id")
             :selector (js-object :sources (js-array (js-object :conversation_ref (nativeGet resolved-source "conversation_ref")
               :include_threads t)))
             :predicate (js-object :field "text" :op "contains" :value "issue")))
           (args (js-object :spec spec)))
      (when policy (put spec :instruction_policy policy))
      (when delivery-mode (put spec :delivery_mode delivery-mode))
      (when old
        (put args :subscription_id (nativeGet old "subscription_id"))
        (put args :expected_revision (nativeGet old "revision")))
      (let* ((preview (await (callOk f actor "subscription.preview" args)))
             (commit (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key key)))
        (when old
          (put commit :subscription_id (nativeGet old "subscription_id"))
          (put commit :expected_revision (nativeGet old "revision")))
        (await (callOk f actor (if old "subscription.update" "subscription.create") commit)))))
  (withCase "T12.subscription-pull.sqlite"
    (async () (await (createFixture "subscription-pull" "one"
      (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array))
        (let ((recipient (js-call (nativeGet config "principals") :find (lambda (p) (= (nativeGet p "principal_id") "A")))))
          (js-call (nativeGet recipient "grants") :push (js-object :action "subscription.consume" :resources (js-array "self")))))))))
    (async (f)
      (await (getSession f "s1"))
      (let* ((agent (await (bindRecipient f)))
             (subscription (await (instructionSubscription f agent nil "A" "pull-subscription"
               (js-object :prompt "pull prompt" :task_template "task={{message.text}}") nil "pull")))
             (id (nativeGet subscription "subscription_id"))
             (pull-args (js-object :subscription_id id :lease_seconds 2 :idempotency_key "empty-pull"))
             (empty (await (callOk f "A" "subscription.pull" pull-args)))
             (peer (nativeGet f "opencode")) (lark (nativeGet f "lark")))
        (js-call (expect (nativeGet subscription "delivery_mode")) :toBe "pull")
        (js-call (expect (nativeGet empty "empty")) :toBe t)
        (await (js-call f :ingest (createdEvent "lark" "pull-first" "issue pull")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
        (js-call (expect (nativeGet (await (callOk f "A" "subscription.pull" pull-args)) "empty")) :toBe t)
        (let* ((args (js-object :subscription_id id :lease_seconds 2 :idempotency_key "claim-first"))
               (first (await (callOk f "A" "subscription.pull" args)))
               (item (nativeGet first "item")) (claim (nativeGet item "claim_ref"))
               (envelope (nativeGet item "envelope")) (reply (nativeGet envelope "reply_context_id")))
          (js-call (expect (nativeGet first "empty")) :toBe false)
          (js-call (expect (nativeGet envelope "delivery_id")) :toBe nil)
          (js-call (expect (nativeGet envelope "inbox_id")) :toBe (nativeGet item "inbox_id"))
          (js-call (expect (nativeGet (aref (nativeGet envelope "instructions") 0) "task")) :toBe "task=issue pull")
          (js-call (expect (nativeGet (await (callOk f "A" "subscription.pull"
            (js-object :subscription_id id :idempotency_key "concurrent-pull"))) "empty")) :toBe t)
          (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "O") "subscription.pull"
            (js-object :subscription_id id :idempotency_key "operator-not-recipient"))) "ok")) :toBe false)
          (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "X") "subscription.ack"
            (js-object :claim_ref claim :disposition "consumed" :idempotency_key "foreign-ack"))) "ok")) :toBe false)
          (await (js-call f :restart))
          (let ((replayed (await (callOk f "A" "subscription.pull" args))))
            (js-call (expect (nativeGet (nativeGet replayed "item") "claim_ref")) :toBe claim)
            (js-call (expect (nativeGet (nativeGet replayed "item") "envelope")) :toEqual envelope))
          (await (callOk f "A" "message.reply" (js-object :reply_context_id reply
            :content (js-object :type "text" :text "first pull reply") :idempotency_key "pull-reply-first")))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet lark "sent"))) :toBe 1)
          (js-call (expect (nativeGet (nativeGet (aref (nativeGet lark "sent") 0) "outbound") "native_reply_to")) :toBe "pull-first")
          (await (callOk f "A" "message.reply" (js-object :reply_context_id reply
            :content (js-object :type "text" :text "must not send after reclaim") :idempotency_key "pull-stale-outbound")))
          (js-call (nativeGet f "clock") :advance 2000)
          (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "A") "subscription.ack"
            (js-object :claim_ref claim :disposition "consumed" :idempotency_key "expired-ack"))) "ok")) :toBe false)
          (let* ((second (await (callOk f "A" "subscription.pull"
                    (js-object :subscription_id id :idempotency_key "reclaim-first"))))
                 (next (nativeGet second "item")) (next-claim (nativeGet next "claim_ref"))
                 (ack (js-object :claim_ref next-claim :disposition "consumed" :idempotency_key "consume-first")))
            (js-call (expect (nativeGet next "inbox_id")) :toBe (nativeGet item "inbox_id"))
            (js-call (nativeGet (expect next-claim) "not") :toBe claim)
            (let ((old (await (callOk f "A" "subscription.pull" args))))
              (js-call (expect (object-has? (nativeGet old "item") :envelope)) :toBe false)
              (js-call (expect (object-has? (nativeGet old "item") :claim_ref)) :toBe false))
            (await (js-call f :tick))
            (js-call (expect (js-length (nativeGet lark "sent"))) :toBe 1)
            (js-call (expect (nativeGet (await (callOk f "A" "subscription.ack" ack)) "state")) :toBe "consumed")
            (js-call (expect (nativeGet (await (callOk f "A" "subscription.ack" ack)) "state")) :toBe "consumed")
            (await (callOk f "A" "message.reply" (js-object
              :reply_context_id (nativeGet (nativeGet next "envelope") "reply_context_id")
              :content (js-object :type "text" :text "consumed reply") :idempotency_key "pull-consumed-reply")))
            (await (js-call f :tick))
            (js-call (expect (js-length (nativeGet lark "sent"))) :toBe 2)))
        (await (js-call f :ingest (createdEvent "lark" "pull-second" "issue retry")))
        (await (js-call f :tick))
        (let* ((one (nativeGet (await (callOk f "A" "subscription.pull"
                      (js-object :subscription_id id :idempotency_key "claim-second"))) "item"))
               (old-claim (nativeGet one "claim_ref")))
          (js-call (expect (nativeGet (await (callOk f "A" "subscription.ack"
            (js-object :claim_ref old-claim :disposition "retry" :idempotency_key "release-second"))) "state")) :toBe "ready")
          (let* ((two (nativeGet (await (callOk f "A" "subscription.pull"
                        (js-object :subscription_id id :idempotency_key "reclaim-second"))) "item")))
            (js-call (expect (nativeGet two "inbox_id")) :toBe (nativeGet one "inbox_id"))
            (js-call (nativeGet (expect (nativeGet two "claim_ref")) "not") :toBe old-claim)
            (await (callOk f "A" "subscription.pause" (js-object :subscription_id id
              :expected_revision (nativeGet subscription "revision") :idempotency_key "pause-pull")))
            (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "A") "subscription.ack"
              (js-object :claim_ref (nativeGet two "claim_ref") :disposition "consumed" :idempotency_key "paused-ack"))) "ok")) :toBe false)))
        (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
          (try
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries") :get) "n")) :toBe 0)
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM inbox_entries") :get) "n")) :toBe 2)
            (finally (js-call db :close))))))
    closeFixture)
  (withCase "T12.subscription-instructions.sqlite"
    (async () (await (createFixture "instructions" "one"
      (js-object :configure (lambda (config ports) (put config :managed_profiles (js-array)))))))
    (async (f)
      (await (getSession f "s1"))
      (let* ((agent (await (bindRecipient f)))
             (source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
             (one (await (instructionSubscription f agent source "A" "instruction-one"
               (js-object :prompt "trusted-v1" :task_template "{{subscription.id}}/{{event.id}}: {{message.text}}"))))
             (two (await (instructionSubscription f agent source "O" "instruction-two"
               (js-object :prompt "operator-prompt" :task_template "sender={{sender.id}}; thread={{source.thread_id}}"))))
             (legacy (await (instructionSubscription f agent source "A" "instruction-legacy" nil)))
             (peer (nativeGet f "opencode")) (inputs (nativeGet peer "inputs"))
             (original-snapshot nil))
        (js-call (expect (nativeGet (nativeGet one "instruction_policy") "prompt")) :toBe "trusted-v1")
        (js-call (expect (nativeGet (await (callOk f "A" "subscription.get"
          (js-object :subscription_id (nativeGet one "subscription_id")))) "instruction_policy")) :toEqual
          (nativeGet one "instruction_policy"))
        (await (js-call f :ingest (createdEvent "lark" "instruction-filtered" "no hit")))
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 0)
        (await (js-call f :ingest (createdEvent "lark" "instruction-first"
          (str "issue {{sender.id}} " (js-call "中文🙂" :repeat 3000)))))
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 1)
        (let* ((envelope (nativeGet (aref inputs 0) "envelope"))
               (instructions (nativeGet envelope "instructions"))
               (item (js-call instructions :find (lambda (i) (= (nativeGet i "subscription_id") (nativeGet one "subscription_id"))))))
          (js-call (expect (js-length (nativeGet envelope "matched"))) :toBe 3)
          (js-call (expect (js-length instructions)) :toBe 2)
          (js-call (expect (nativeGet item "subscription_revision")) :toBe 1)
          (js-call (expect (nativeGet item "prompt")) :toBe "trusted-v1")
          (js-call (expect (nativeGet item "task")) :toBe
            (str (nativeGet one "subscription_id") "/" (nativeGet envelope "event_id") ": "
              (nativeGet (nativeGet envelope "content") "text")))
          (js-call (expect (js-call (nativeGet item "task") :includes "{{sender.id}}")) :toBe t)
          (js-call (expect (nativeGet (nativeGet envelope "content") "truncated")) :toBe t)
          (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
            (try
              (setq original-snapshot (nativeGet (JSON/parse (nativeGet
                (js-call (js-call db :query "SELECT payload FROM attempts WHERE delivery_id=?")
                  :get (nativeGet envelope "delivery_id")) "payload")) "envelope_snapshot"))
              (js-call (expect (unpackEnvelope original-snapshot)) :toEqual envelope)
              (finally (js-call db :close)))))
        ;; Prepare old contributions while busy; a new revision may not replace
        ;; their instructions retroactively. Pausing the other owners removes
        ;; all remaining contributions before submission.
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "busy")
        (await (js-call f :ingest (createdEvent "lark" "instruction-stale" "issue queued")))
        (await (js-call f :tick))
        (setq one (await (instructionSubscription f agent source "A" "instruction-update"
          (js-object :prompt "trusted-v2" :task_template "new={{message.text}}") one)))
        (setq two (await (callOk f "O" "subscription.pause" (js-object :subscription_id (nativeGet two "subscription_id")
          :expected_revision (nativeGet two "revision") :idempotency_key "pause-other-owner"))))
        (setq legacy (await (callOk f "A" "subscription.pause" (js-object :subscription_id (nativeGet legacy "subscription_id")
          :expected_revision (nativeGet legacy "revision") :idempotency_key "pause-legacy"))))
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "idle")
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 1)
        (await (js-call f :ingest (createdEvent "lark" "instruction-new" "issue current")))
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 2)
        (let ((instruction (aref (nativeGet (nativeGet (aref inputs 1) "envelope") "instructions") 0)))
          (js-call (expect (nativeGet instruction "prompt")) :toBe "trusted-v2")
          (js-call (expect (nativeGet instruction "subscription_revision")) :toBe 2)
          (js-call (expect (nativeGet instruction "task")) :toBe "new=issue current"))
        (js-call (expect (nativeGet (aref (nativeGet (unpackEnvelope original-snapshot) "instructions") 0) "prompt")) :toBeDefined)
        (setq one (await (callOk f "A" "subscription.pause" (js-object :subscription_id (nativeGet one "subscription_id")
          :expected_revision (nativeGet one "revision") :idempotency_key "pause-instructions"))))
        (setq legacy (await (callOk f "A" "subscription.resume" (js-object :subscription_id (nativeGet legacy "subscription_id")
          :expected_revision (nativeGet legacy "revision") :idempotency_key "resume-legacy"))))
        (await (js-call f :ingest (createdEvent "lark" "instruction-none" "issue legacy")))
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 3)
        (js-call (expect (object-has? (nativeGet (aref inputs 2) "envelope") :instructions)) :toBe false)
        (setq one (await (instructionSubscription f agent source "A" "instruction-overflow-update"
          (js-object :task_template (js-call "{{message.text}}" :repeat 32)) one)))
        (setq one (await (callOk f "A" "subscription.resume" (js-object :subscription_id (nativeGet one "subscription_id")
          :expected_revision (nativeGet one "revision") :idempotency_key "resume-overflow"))))
        (await (js-call f :ingest (createdEvent "lark" "instruction-overflow" (str "issue " (js-call "x" :repeat 2000)))))
        (await (js-call f :tick))
        (js-call (expect (js-length inputs)) :toBe 3)
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
          (try
            (let* ((record (JSON/parse (nativeGet (js-call (js-call db :query
              "SELECT d.payload FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id=?")
              :get "instruction-overflow") "payload"))))
              (js-call (expect (nativeGet record "state")) :toBe "blocked")
              (js-call (expect (nativeGet record "blocked_reason")) :toBe "limit_exceeded")
              (js-call (expect (nativeGet record "attempt_id")) :toBeUndefined)
              (js-call (expect (nativeGet record "reply_context_id")) :toBe nil))
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM claims") :get) "n")) :toBe 0)
            (js-call (expect (nativeGet (JSON/parse (nativeGet (js-call (js-call db :query
              "SELECT payload FROM attempts WHERE delivery_id=?")
              :get (nativeGet (nativeGet (aref inputs 0) "envelope") "delivery_id")) "payload")) "envelope_snapshot"))
              :toEqual original-snapshot)
            (finally (js-call db :close))))))
    closeFixture)
  (defun nWrapQuery
    (orig on-sql)
    (funcall
      (new globalThis.Function "orig" "onSql"
        "return function(sql) { if (typeof sql === 'string') onSql(sql); return orig.call(this, sql); };")
      orig on-sql))
  ;; N-batch fixture: one registered agent + one subscription per distinct route.
  ;; Every route receives a unique text token so one ingested event matches exactly one route.
  (defasync nRouteWorld
    (count)
    (let*
      ((fixture
          (await
            (createFixture
              "delivery"
              (str "n-world-" (randomUUID))
              (js-object
                :configure
                (lambda
                  (config ports)
                  (let ((principals (nativeGet config "principals")) (i 0))
                    (while (< i count)
                      (js-call principals :push
                        (js-object
                          :principal_id (str "NR" i)
                          :kind "agent"
                          :authorization_revision 1
                          :target_constraint
                          (js-object
                            :tool "opencode"
                            :native_namespace "ns-opencode"
                            :native_session_id (str "n-" i))
                          :grants
                          (js-array
                            (js-object :action "message.read" :resources (js-array "*")))))
                      (setq i (1+ i)))))))))
        (peer (nativeGet fixture "opencode"))
        (sessions (nativeGet peer "sessions"))
        (entries (js-array))
        (i 0))
      (try
      (while (< i count)
        (js-call sessions :push
          (Object/assign (js-object) (aref sessions 0)
            (js-object :native_session_id (str "n-" i) :runtime_state "idle")))
        (setq i (1+ i)))
      (await
        (callOk fixture "O" "catalog.refresh"
          (js-object :include_content false :idempotency_key (str "n-refresh-" (randomUUID)))))
      (await (js-call fixture :tick))
      (let
        ((candidates
            (nativeGet
              (await (callOk fixture "O" "agent.discover" (js-object :tool "opencode" :scope "live")))
              "items")))
        (setq i 0)
        (while (< i count)
          (let*
            ((candidate
                (js-call candidates :find
                  (lambda
                    (candidate)
                    (= (nativeGet candidate "native_session_id") (str "n-" i)))))
              (agent
                (await
                  (callOk fixture "O" "agent.register"
                    (js-object
                      :candidate_ref (nativeGet candidate "candidate_ref")
                      :display_name (str "n-agent-" i)
                      :binding_mode "existing"
                      :recipient_principal_id (str "NR" i)
                      :idempotency_key (str "n-register-" i))))))
            (js-call entries :push agent))
          (setq i (1+ i))))
      (js-call entries :sort
        (lambda
          (a b)
          (if (< (nativeGet a "route_id") (nativeGet b "route_id")) -1 1)))
      (let
        ((source
            (await
              (callOk fixture "O" "conversation.resolve"
                (js-object :connection_id "lark" :chat_id "c1" :thread_id nil)))))
        (setq i 0)
        (while (< i count)
          (let*
            ((entry (aref entries i))
              (token (str "ntok" i "x" (js-call (randomUUID) :slice 8)))
              (preview
                (await
                  (callOk fixture "O" "subscription.preview"
                    (js-object
                      :spec
                      (js-object
                        :agent_id (nativeGet entry "agent_id")
                        :selector
                        (js-object
                          :sources
                          (js-array
                            (js-object
                              :conversation_ref (nativeGet source "conversation_ref")
                              :include_threads false))
                          :event_kinds (js-array "message.created"))
                        :predicate (js-object :op "contains" :field "text" :value token)
                        :context_policy (js-object :mode "current" :max_events 1 :max_bytes 16384)
                        :delivery_policy
                        (js-object :busy "queue" :offline "hold" :ttl_seconds 3600)
                        :start "now"))))))
            (await
              (callOk fixture "O" "subscription.create"
                (js-object :preview_id (nativeGet preview "preview_id")
                  :idempotency_key (str "n-subscribe-" i))))
            (put entry :token token))
          (setq i (1+ i))))
      (js-object
        :fixture fixture
        :peer peer
        :entries entries
        :sessions sessions)
        (catch error
          (await (closeFixture fixture))
          (throw error)))))
  (defasync nIngestOrder
    (fixture entries order)
    (let ((j 0))
      (while (< j (js-length order))
        (let ((idx (aref order j)))
          (await
            (js-call fixture :ingest
              (createdEvent "lark" (str "n-msg-" (randomUUID))
                (nativeGet (aref entries idx) "token")))))
        (setq j (1+ j)))))
  (defasync nCount (fixture sql)
    (let
      ((reader
          (new Database (resolve (nativeGet fixture "root") "state/dj.sqlite")
            (js-object :readonly t))))
      (try
        (nativeGet (js-call (js-call reader :query sql) :get) "n")
        (finally (js-call reader :close)))))
  (defasync nStopToStopped
    (fixture)
    (let ((core (nativeGet fixture "core")) (attempt 0) (stopped false))
      (while (and (not stopped) (< attempt 16))
        (await
          (js-call core :stop "n_bounded_stop"
            (+ (js-call (nativeGet fixture "clock") :monoNow) 1000)))
        (setq stopped (= (js-call core :transportState) "stopped"))
        (setq attempt (1+ attempt)))
      (js-call (expect stopped) :toBe t)))
  (defasync nAwaitEntered
    (barrier)
    (let ((attempt 0))
      (while (and (not (js-call barrier :entered)) (< attempt 400))
        (await (new globalThis.Promise
          (lambda (resolve reject) (nativeSetTimeout resolve 0))))
        (setq attempt (1+ attempt)))
      (js-call (expect (js-call barrier :entered)) :toBe t)))
