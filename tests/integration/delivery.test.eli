                                        (let
                                          ((unaccepted
                                              (nativeGet
                                                (js-call
                                                  (js-call
                                                    reader
                                                    :query
                                                    "SELECT COUNT(*) AS n FROM deliveries WHERE route_id=? AND state IN ('ready','deferred','blocked','submitting','unknown')")
                                                  :get
                                                  route-id)
                                                "n"))
                                            (claims
                                              (nativeGet
                                                (js-call
                                                  (js-call
                                                    reader
                                                    :query
                                                    "SELECT COUNT(*) AS n FROM claims WHERE route_id=?")
                                                  :get
                                                  route-id)
