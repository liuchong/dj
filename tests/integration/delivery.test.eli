                  (js-call (expect (nativeGet env2 "delivery_id")) :toBe (nativeGet d2 "delivery_id"))
                  (js-call (expect (nativeGet (nativeGet env1 "content") "text")) :toBe "same route event 1")
                  (js-call (expect (nativeGet (nativeGet env2 "content") "text")) :toBe "same route event 2")
                  (js-call (expect (js-length (nativeGet env1 "matched"))) :toBe 1)
                  (js-call (expect (js-length (nativeGet env2 "matched"))) :toBe 1)
                  (js-call (expect (nativeGet (aref (nativeGet env1 "matched") 0) "subscription_id"))
