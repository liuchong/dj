                      (md-2 (nativeGet (js-call (js-call reader :query
                          "SELECT COUNT(*) AS n FROM match_decisions WHERE event_id=? AND result='match'") :get (nativeGet d2 "event_id")) "n"))
                      (c-1 (nativeGet (js-call (js-call reader :query
