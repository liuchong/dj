  (withCase
    "T14.global-queue-limit.sqlite"
    setup
    (async
      (f)
      (let* ((peer (nativeGet f "opencode")) (sessions (nativeGet peer "sessions")) (i 0))
        (while (< i 9)
          (js-call
            sessions
            :push
            (Object/assign
              (js-object)
              (aref sessions 0)
              (js-object :native_session_id (str "capacity-" i))))
          (setq i (1+ i)))
        (js-call sessions :forEach (lambda (s) (put s :runtime_state "busy")))
        (await (getSession f "s1"))
        (let
          (
            (targets
              (nativeGet
                (await
                  (callOk
                    f
                    "S"
                    "session.list"
                    (js-object
                      :scope
                      (js-object :tools (js-array "opencode"))
                      :limit
                      200)))
                "items")))
          (js-call (expect (js-length targets)) :toBe 11)
          (setq i 0)
          (while (< i 10000)
            (await
              (callOk
                f
                "S"
                "session.send"
                (js-object
                  :session_ref
                  (nativeGet (aref targets (mod i 11)) "session_ref")
                  :content
                  (js-object :type "text" :text "bounded global queue")
                  :idempotency_key
                  (str "global-" i))))
            (setq i (1+ i)))
          (let
            (
              (overflow
                (await
                  (js-call
                    f
                    :call
                    (nativeGet f "S")
                    "session.send"
                    (js-object
                      :session_ref
                      (nativeGet (aref targets 0) "session_ref")
                      :content
                      (js-object :type "text" :text "global overflow")
                      :idempotency_key
                      "global-overflow")))))
            (js-call (expect (nativeGet (nativeGet overflow "error") "code")) :toBe "limit_exceeded")
            (js-call (expect (nativeGet overflow "effect_state")) :toBe "none"))
          (let ((cursor nil) (count 0) (done false))
            (while (not done)
              (let
                (
                  (page
                    (await
                      (callOk
                        f
                        "S"
                        "delivery.list"
                        (Object/assign
                          (js-object :limit 200)
                          (if cursor (js-object :cursor cursor) (js-object)))))))
                (setq
                  count
                  (+ count (js-length (nativeGet page "items")))
                  cursor
                  (nativeGet page "next_cursor")
                  done
                  (not cursor))))
            (js-call (expect count) :toBe 10000))
          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0))))
    closeFixture)
