                            (= (aref tick1-wave-log 3) "outbound")
                            (= (aref tick1-wave-log 4) "routes"))
                          (and (= (aref tick1-wave-log 0) "outbound")
                            (= (aref tick1-wave-log 1) "routes")
                            (= (aref tick1-wave-log 3) "routes")
                            (= (aref tick1-wave-log 4) "outbound")))) :toBe t)
