                (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 1)))) "state"))
                  :toBe "deferred")
                (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 2)))) "state"))
                  :toBe "ready")
                (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 3)))) "state"))
                  :toBe "ready"))
              ;; Restore idle and make the 2nd submit in the next tick throw -> unknown head barrier stops the worker immediately.
              (put target-session :runtime_state "idle")
              (let ((submit-count 0))
                (put peer :submit (async (binding envelope mode key context)
                  (setq submit-count (1+ submit-count))
                  (when (= submit-count 2)
                    (throw (new globalThis.Error "uncertain second submit in route job")))
                  (await (funcall original-submit binding envelope mode key context))))
                (await (js-call f :tick))
                (put peer :submit original-submit)
                (js-call (expect submit-count) :toBe 2)
                (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 72)
                (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 1)))) "state"))
                  :toBe "accepted")
                (let ((unknown-head (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 2)))))
                  (queued-tail (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 3))))))
                  (js-call (expect (nativeGet unknown-head "state")) :toBe "unknown")
                  (js-call (expect (nativeGet queued-tail "state")) :toBe "ready")
                  ;; Subsequent tick must not bypass the unknown head barrier; after manual resolve, the tail item dispatches.
                  (await (js-call f :tick))
                  (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 72)
                  (await (callOk f "O" "delivery.resolve"
                    (js-object :delivery_id (aref stop-ids 2)
                      :expected_revision (nativeGet unknown-head "revision")
                      :resolution "abandon_no_retry"
                      :reason "resolve route job unknown head"
                      :idempotency_key "resolve-route-job-unknown-head")))
