                      (when (js-call sql :startsWith "INSERT INTO deliveries(")
                        (js-call routing-sql-order :push (if (js-call sql :includes "),(") "deliveries_multi" "deliveries_single")))
                      (when (js-call sql :startsWith "INSERT INTO match_decisions(")
                        (js-call routing-sql-order :push "match_decisions"))
                      (when (js-call sql :startsWith "INSERT INTO contributions(")
                        (js-call routing-sql-order :push "contributions")))))
                    (await (js-call f :tick))
                    (finally
                      (put (nativeGet Database "prototype") :query original-db-query)
                      (js-call (nativeGet f "faults") :install "routing.before_checkpoint_commit" nil)))
                  (js-call (expect routing-sql-order) :toEqual (js-array "deliveries_multi" "match_decisions" "contributions"))
                  (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                    (try
