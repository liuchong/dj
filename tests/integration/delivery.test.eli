            (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)
            (js-call
              (expect (nativeGet (nativeGet (aref (nativeGet peer "inputs") 0) "envelope") "delivery_id"))
              :toBe
              (nativeGet current "delivery_id"))
            (js-call
              (nativeGet current "contributions")
              :forEach
              (lambda
                (c)
                (js-call
                  (expect (nativeGet c "subscription_revision"))
                  :toBe
                  (nativeGet updated "revision")))))
          ;; Verify same-route delivery_seq monotonic allocation across multi-subscription/multi-event matchBatch,
          ;; and cross-transaction fresh reads in effectiveContributions (subscription pause + grant revocation).
          (let* ((sub2-ticket (await (preview f agent 120)))
