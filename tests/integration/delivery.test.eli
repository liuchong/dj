                                :idempotency_key (str "j-wave1-o-" o-idx))))))
                            (js-call wave-outbound-ids :push (nativeGet queued-out "outbound_id")))
                          (setq o-idx (1+ o-idx)))
                        (try
                          (put (nativeGet Database "prototype") :query (funcall wrap-db-query original-db-query (lambda (sql)
                            (when (js-call sql :includes "FROM routes r WHERE r.route_id>? AND r.unknown_delivery_id IS NULL")
                              (unless (and (> (js-length tick1-wave-log) 0)
                                  (= (aref tick1-wave-log (1- (js-length tick1-wave-log))) "routes"))
                                (js-call tick1-wave-log :push "routes")))
                            (when (js-call sql :includes "FROM outbound WHERE outbound_id>? AND state IN ('ready','deferred','blocked')")
                              (unless (and (> (js-length tick1-wave-log) 0)
                                  (= (aref tick1-wave-log (1- (js-length tick1-wave-log))) "outbound"))
                                (js-call tick1-wave-log :push "outbound"))))))
                          (put peer :probe (async (target binding context)
                            (setq active-native (1+ active-native))
                            (when (> active-native max-active-native)
                              (setq max-active-native active-native))
                            (try
                              (await (funcall original-probe target binding context))
                              (finally
                                (setq active-native (1- active-native))))))
                          (put peer :submit (async (binding envelope mode key context)
                            (setq active-native (1+ active-native))
                            (when (> active-native max-active-native)
                              (setq max-active-native active-native))
