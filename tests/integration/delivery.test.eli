                        (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                          (try
                            (setq o-idx 0)
                            (while (< o-idx 32)
                              (let ((o-row (js-call (js-call reader :query "SELECT state FROM outbound WHERE outbound_id=?")
                                    :get (aref wave-outbound-ids o-idx))))
                                (js-call (expect (nativeGet o-row "state")) :toBe "accepted"))
                              (setq o-idx (1+ o-idx)))
                            (finally (js-call reader :close))))
