                              :idempotency_key (str "j-wave2-r-" r-idx))))
                          (setq r-idx (1+ r-idx)))
                        (setq o-idx 0)
                        (while (< o-idx 16)
                          (await (callOk f "O" "message.send"
                            (js-object :destination_ref (nativeGet dest "conversation_ref")
                              :content (js-object :type "text" :text (str "j-wave2-o-" o-idx))
                              :idempotency_key (str "j-wave2-o-" o-idx))))
                          (setq o-idx (1+ o-idx)))
                        (let ((second-submit-seen false))
                          (try
                            (put (nativeGet Database "prototype") :query (funcall wrap-db-query original-db-query (lambda (sql)
