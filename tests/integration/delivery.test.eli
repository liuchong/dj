  (withCase
    "T31.submit-cutover.sqlite"
    setup
    (async
      (f)
      (let*
        ((session (await (getSession f "s1")))
          (session2 (await (getSession f "s2")))
          (peer (nativeGet f "opencode"))
          (original-probe (nativeGet peer "probe"))
          (original-submit (nativeGet peer "submit"))
          (barrier (createBarrier))
          (probe-barrier (createBarrier))
          (submit-barrier (createBarrier))
          (submit-checks (js-array))
          (s1-probes 0)
          (accepted
            (await
              (callOk
                f
                "S"
                "session.send"
                (js-object
                  :session_ref
                  (nativeGet session "session_ref")
                  :content
                  (js-object :type "text" :text "submission boundary")
                  :idempotency_key
                  "cutover"))))
          (queued-s1-second
            (await
              (callOk
                f
                "S"
                "session.send"
                (js-object
                  :session_ref
                  (nativeGet session "session_ref")
                  :content
                  (js-object :type "text" :text "second on same route must not start during drain")
                  :idempotency_key
                  "cutover-s1-second"))))
          (queued-s2
            (await
              (callOk
                f
                "S"
                "session.send"
                (js-object
                  :session_ref
                  (nativeGet session2 "session_ref")
                  :content
                  (js-object :type "text" :text "held on drain")
                  :idempotency_key
                  "cutover-s2")))))
        (put
          peer
          :probe
          (async
            (target binding context)
            (when (= (nativeGet target "native_session_id") "s1")
              (setq s1-probes (1+ s1-probes)))
            (when (= (nativeGet target "native_session_id") "s2")
              (await (js-call probe-barrier :wait)))
            (await (funcall original-probe target binding context))))
        (put
          peer
          :submit
          (async
            (binding envelope mode key context)
            (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
              (try
                (let
                  ((delivery-row
                      (js-call
                        (js-call reader :query "SELECT state FROM deliveries WHERE delivery_id=?")
                        :get
                        (nativeGet envelope "delivery_id")))
                    (attempt-row
                      (js-call
                        (js-call reader :query "SELECT state FROM attempts WHERE delivery_id=?")
                        :get
                        (nativeGet envelope "delivery_id"))))
                  (js-call
                    submit-checks
                    :push
                    (js-object
                      :delivery_state
                      (nativeGet delivery-row "state")
                      :attempt_state
                      (nativeGet attempt-row "state"))))
                (finally (js-call reader :close))))
            (await (js-call submit-barrier :wait))
            (await (funcall original-submit binding envelope mode key context))))
        (atFault
          (nativeGet f "faults")
          "delivery.after_submitting_before_write"
          (async (ctx) (await (js-call barrier :wait))))
        (let ((original-db-query (nativeGet (nativeGet Database "prototype") "query"))
          (wrap-db-query (lambda (orig on-sql)
            (funcall (new globalThis.Function "orig" "onSql" "return function(sql) { if (typeof sql === 'string') onSql(sql); return orig.call(this, sql); };") orig on-sql)))
          (cutover-route-queries 0))
          (try
            (put (nativeGet Database "prototype") :query (funcall wrap-db-query original-db-query (lambda (sql)
              (when (js-call sql :includes "FROM routes r WHERE r.route_id>? AND r.unknown_delivery_id IS NULL")
                (setq cutover-route-queries (1+ cutover-route-queries))))))
            (let ((inflight (js-call f :tick)))
              (await (nativeGet barrier "ready"))
              (await (nativeGet probe-barrier "ready"))
              (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
              (let*
                (
                  (record
                    (await
                      (callOk
                        f
                        "S"
                        "delivery.get"
                        (js-object :delivery_id (nativeGet accepted "delivery_id")))))
                  (cancelled
                    (await
                      (js-call
                        f
                        :call
                        (nativeGet f "S")
                        "delivery.cancel"
                        (js-object
                          :delivery_id
                          (nativeGet accepted "delivery_id")
                          :expected_revision
                          (nativeGet record "revision")
                          :idempotency_key
                          "cancel-after-submit")))))
                (js-call (expect (nativeGet cancelled "ok")) :toBe false)
                (js-call (expect (nativeGet record "state")) :toBe "submitting"))
              (js-call barrier :release)
              (await (nativeGet submit-barrier "ready"))
              (js-call (expect (js-length submit-checks)) :toBe 1)
              (js-call (expect (nativeGet (aref submit-checks 0) "delivery_state")) :toBe "submitting")
              (js-call (expect (nativeGet (aref submit-checks 0) "attempt_state")) :toBe "submitting")
              (let
                ((draining
                    (successful
                      (await
                        (js-call
                          (nativeGet f "core")
                          :stop
                          "drain_during_submit"
                          (+ (js-call (nativeGet f "clock") :monoNow) 5000))))))
                (js-call (expect (nativeGet draining "state")) :toBe "draining")
                (js-call (expect (js-call (nativeGet f "core") :transportState)) :toBe "draining"))
              (js-call probe-barrier :release)
              (js-call submit-barrier :release)
              (await inflight))
            (finally
              (put (nativeGet Database "prototype") :query original-db-query)))
          (js-call (expect s1-probes) :toBe 1)
          (js-call (expect cutover-route-queries) :toBe 1)
          (await (js-call f :restart))
          (let
            ((after-s1
                (await
                  (callOk
                    f
                    "S"
                    "delivery.get"
                    (js-object :delivery_id (nativeGet accepted "delivery_id")))))
              (after-s1-second
                (await
                  (callOk
                    f
                    "S"
                    "delivery.get"
                    (js-object :delivery_id (nativeGet queued-s1-second "delivery_id")))))
              (after-s2
                (await
                  (callOk
                    f
                    "S"
                    "delivery.get"
                    (js-object :delivery_id (nativeGet queued-s2 "delivery_id"))))))
            (js-call (expect (nativeGet after-s1 "state")) :toBe "accepted")
            (js-call (expect (nativeGet after-s1-second "state")) :toBe "ready")
            (js-call (expect (nativeGet after-s2 "state")) :toBe "deferred")
            (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
              (try
                (let ((row (js-call (js-call reader :query
                    "SELECT json_extract(payload,'$.blocked_reason') AS reason FROM deliveries WHERE delivery_id=?")
                  :get (nativeGet queued-s2 "delivery_id"))))
                  (js-call (expect (nativeGet row "reason")) :toBe "service_draining"))
                (finally (js-call reader :close))))
            (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)))))
    closeFixture)
  (withCase
