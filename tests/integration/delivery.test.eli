                    (epoch-before nil)
                    (epoch-after nil)
                    (route-id (nativeGet queued-tail "route_id")))
                    (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                      (try
                        (setq epoch-before (nativeGet (js-call (js-call reader :query
                          "SELECT claim_epoch FROM routes WHERE route_id=?") :get route-id) "claim_epoch"))
                        (finally (js-call reader :close))))
                    (put peer :probe (async (target binding context)
                      (setq single-probes (1+ single-probes))
                      (await (funcall original-probe target binding context))))
