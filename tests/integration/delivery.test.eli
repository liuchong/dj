                                    (let ((d-row (js-call (js-call reader :query "SELECT state FROM deliveries WHERE delivery_id=?")
                                          :get (nativeGet envelope "delivery_id")))
                                      (a-row (js-call (js-call reader :query "SELECT state FROM attempts WHERE delivery_id=?")
                                          :get (nativeGet envelope "delivery_id"))))
