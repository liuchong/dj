                          (js-call (expect (nativeGet r-row "col_epoch")) :toBe (nativeGet r-row "json_epoch"))
                          (js-call (expect (nativeGet r-row "col_seq")) :toBe (nativeGet r-row "json_seq"))
                          (js-call (expect (nativeGet r-row "col_owner")) :toBe nil)
                          (js-call (expect (nativeGet r-row "json_owner")) :toBe nil)
                          (js-call (expect claim-count) :toBe 0))
                        (finally (js-call reader :close))))
                    (js-call (expect single-probes) :toBe 1)
                    (js-call (expect (- epoch-after epoch-before)) :toBe 1)
                    (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 73)
                    (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (aref stop-ids 3)))) "state"))
                      :toBe "accepted")
                    ;; Exercise runCapacitySchedule against the real SQLite Core fixture (producer + 20ms non-reentrant consumer + SQLite drain).
                    (let*
                      ((sched-ids (js-array))
                        (sched
                          (await
                            (runCapacitySchedule
                              (js-object
                                :total_events
                                6
                                :pace_ms
                                2
                                :catchup_yield_every
                                16
                                :consumer_interval_ms
                                10
                                :drain_poll_ms
                                2
                                :deadline_ms
                                5000
                                :ingest_event
                                (async
                                  (idx)
                                  (let
                                    (
                                      (queued
                                        (await
                                          (callOk
                                            f
                                            "S"
                                            "session.send"
                                            (js-object
                                              :session_ref
                                              target-ref
                                              :content
                                              (js-object
                                                :type
                                                "text"
