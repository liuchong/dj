                  (await (js-call f :ingest (createdEvent "lark" "after-prepare-pause" "paused after prepare must not deliver")))
                  (await (js-call f :tick))
                  (js-call (nativeGet f "faults") :install "routing.before_checkpoint_commit" nil))
                (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 3)
