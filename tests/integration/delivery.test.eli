                        (js-call (expect (<= max-active-native 64)) :toBe t)
                        (js-call (expect (nativeGet first-submit-states "delivery_state")) :toBe "submitting")
                        (js-call (expect (nativeGet first-submit-states "attempt_state")) :toBe "submitting")
                        (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 335)
                        (js-call (expect (js-length (nativeGet lark-peer "sent"))) :toBe 80)
                        (js-call (expect (js-length tick1-wave-log)) :toBe 5)
                        (js-call (expect (aref tick1-wave-log 2)) :toBe "inter_wave_timer")
                        (js-call (expect (or
