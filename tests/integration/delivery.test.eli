                      (js-call (expect (nativeGet sched "completed")) :toBe t)
                      (js-call (expect (nativeGet sched "ingested_events")) :toBe 6)
                      (js-call (expect (nativeGet sched "tick_error_count")) :toBe 0)
                      (js-call (expect (nativeGet sched "max_concurrent_ticks")) :toBe 1)
                      (js-call (expect (nativeGet sched "in_flight_at_exit")) :toBe false)
                      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 79)
                      ;; J1-J3 bounded second-wave dispatch in tick:
                      ;; J-A1 & J-A2: 64 ready routes (4 items each = 256 route deliveries) + 32 ready outbounds
                      ;; complete in a single tick across 2 waves (each wave <=32 routes, <=16 outbound, <=64 total jobs)
