                        (js-call (expect (nativeGet r-row "binding_id")) :toBe (nativeGet r-row "j_bind"))
                        (js-call (expect (nativeGet r-row "claim_owner")) :toBe nil)
                        (js-call (expect (nativeGet r-row "j_owner")) :toBe nil)
                        (js-call (expect (nativeGet r-row "unknown_delivery_id")) :toBe nil)
                        (js-call (expect (nativeGet r-row "j_unk")) :toBe nil)
                        (js-call (expect (nativeGet r-row "seq")) :toBe (nativeGet r-row "j_seq"))
