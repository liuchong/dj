                  (js-call (expect dispatch-rw-state-sqls) :toBe 2)
                  (js-call (expect dispatch-rw-payload-sqls) :toBe 0)
                  (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 5)
                  (let* ((inp-3 (aref (nativeGet peer "inputs") 3))
                    (inp-4 (aref (nativeGet peer "inputs") 4))
                    (s1-inp (if (= (nativeGet (nativeGet inp-3 "binding") "native_session_id") "s1") inp-3 inp-4))
                    (s2-inp (if (= (nativeGet (nativeGet inp-3 "binding") "native_session_id") "s2") inp-3 inp-4))
