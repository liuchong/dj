(module dj.tests.integration.antigravity-input
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort)
  (import "../support/fixtures.eli" createFixture closeFixture bindRecipient callOk)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (withCase "T38.antigravity-busy.integration" (lambda () nil) (async (ignored)
    (let* ((calls (js-array)) (status "CASCADE_RUN_STATUS_RUNNING") (fail-send false)
      (config (js-object :plannerConfig (js-object :planModel "native-model") :toolConfig (js-object :keep t)))
      (endpoint (js-object :instance_id "ag" :native_namespace "native" :directory "/workspace" :workspace_ref "ws" :workspace_scope "instance"))
      (binding (js-object :instance_id "ag" :native_namespace "native" :native_session_id "original" :instance_epoch "epoch"))
      (envelope (js-object :schema_version 1 :kind "external_message" :content (js-object :type "text" :text "supplement") :allowed_actions (js-array)))
      (port (createAntigravityPort (js-object :endpoints (js-array endpoint))
        (js-object :antigravity_rpc (async (ep method payload context)
          (cond
            ((= method "GetAllCascadeTrajectories") (js-object :instance_epoch "epoch" :data
              (js-object :trajectorySummaries (js-object :original
                (js-object :status status :stepCount 1 :lastUserInputStepIndex 0)))))
            ((= method "GetCascadeTrajectorySteps") (js-object :instance_epoch "epoch" :data
              (js-object :steps (js-array (js-object :userInput (js-object :userConfig config))))))
            (t (js-call calls :push payload)
              (when fail-send (throw (new globalThis.Error "lost acknowledgement")))
              (js-object :instance_epoch "epoch" :data (js-object))))))))
      (context (js-object :deadline (+ (performance/now) 5000))))
      (try
        (js-call (expect (nativeGet (await (js-call port :submit binding envelope "steer" "one" context)) "state")) :toBe "accepted")
        (js-call (expect (nativeGet (aref calls 0) "deliveryStrategy")) :toBe "MESSAGE_DELIVERY_STRATEGY_NEXT_INVOCATION")
        (js-call (expect (nativeGet (aref calls 0) "cascadeConfig")) :toEqual config)
        (js-call (expect (nativeGet (aref calls 0) "cascadeId")) :toBe "original")
        (js-call (expect (nativeGet (await (js-call port :submit binding envelope "start_idle" "two" context)) "definite_not_sent")) :toBe t)
        (js-call (expect (js-length calls)) :toBe 1)
        (setq status "CASCADE_RUN_STATUS_IDLE")
        (js-call (expect (nativeGet (await (js-call port :submit binding envelope "start_idle" "three" context)) "state")) :toBe "accepted")
        (js-call (expect (nativeGet (aref calls 1) "deliveryStrategy")) :toBe "MESSAGE_DELIVERY_STRATEGY_WHEN_IDLE")
        (setq status "CASCADE_RUN_STATUS_UNKNOWN")
        (js-call (expect (nativeGet (await (js-call port :submit binding envelope "steer" "four" context)) "definite_not_sent")) :toBe t)
        (js-call (expect (js-length calls)) :toBe 2)
        (setq status "CASCADE_RUN_STATUS_RUNNING" fail-send t)
        (let ((unknown (await (js-call port :submit binding envelope "steer" "five" context))))
          (js-call (expect (nativeGet unknown "state")) :toBe "unknown")
          (js-call (expect (nativeGet unknown "definite_not_sent")) :toBe false))
        (finally (await (js-call port :close)))))) (lambda (ignored) nil))
  (defasync setup ()
    (await (createFixture "native-ready-burst" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put config :message_delivery (js-object :busy "steer" :max_in_flight 64))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let ((caps (nativeGet (js-call (nativeGet ports "agent_ports") :get "opencode") "capabilities")))
        (put caps :message_during_run "supported") (put caps :max_dispatch_burst 32)))))))
  (withCase "T38.native-ready-burst.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (peer (nativeGet f "opencode"))
      (session (aref (nativeGet peer "sessions") 0)) (ids (js-array)) (index 0))
      (put session :runtime_state "busy")
      (while (< index 8)
        (let* ((args (js-object :agent_id (nativeGet agent "agent_id") :content (js-object :type "text" :text (str "pending-" index))
                :idempotency_key (str "pending-" index)))
          (first (await (callOk f "S" "session.send" args)))
          (again (await (callOk f "S" "session.send" args))))
          (js-call (expect (nativeGet again "delivery_id")) :toBe (nativeGet first "delivery_id"))
          (js-call ids :push (nativeGet first "delivery_id")))
        (setq index (1+ index)))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 8)
      (js-call (expect (nativeGet (new globalThis.Set (js-call (nativeGet peer "inputs") :map
        (lambda (input) (nativeGet (nativeGet input "envelope") "delivery_id")))) "size")) :toBe 8)
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 8)
      ;; Uncertain native acceptance is never retried; later independent steer
      ;; messages remain eligible rather than waiting for a model completion.
      (put (nativeGet peer "behavior") :submit "throw")
      (let ((unknown (await (callOk f "S" "session.send" (js-object :agent_id (nativeGet agent "agent_id")
        :content (js-object :type "text" :text "uncertain") :idempotency_key "uncertain")))))
        (await (js-call f :tick))
        (js-call (expect (nativeGet (await (callOk f "S" "delivery.get" (js-object :delivery_id (nativeGet unknown "delivery_id")))) "state")) :toBe "unknown"))
      (put (nativeGet peer "behavior") :submit "accepted")
      (await (callOk f "S" "session.send" (js-object :agent_id (nativeGet agent "agent_id")
        :content (js-object :type "text" :text "after uncertain") :idempotency_key "after-uncertain")))
      (await (js-call f :tick))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 10))) closeFixture))
