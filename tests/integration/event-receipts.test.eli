(module dj.tests.integration.event-receipts
  (import "../../src/core/native.eli" nativeGet NativeGlobal nativeSetTimeout)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../../packages/lark/src/wire.eli" encodeLarkFrame decodeLarkFrame)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defconst factory (js-object))
  (defun receiver (url) (funcall (nativeGet factory "make") url))
  (defun query (f sql &rest args)
    (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))) (statement (js-call db :query sql)))
      (try (Reflect/apply (nativeGet statement "all") statement args)
        (finally (js-call statement :finalize) (js-call db :close)))))
  (defasync turns (f &optional n advance)
    (js-call (nativeGet f "clock") :advance (or advance 0))
    (let ((i 0)) (while (< i (or n 5))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
      (await (js-call f :tick)) (setq i (1+ i)))))
  (defun notice (id &optional kind recipient)
    (js-object :header (js-object :event_id id :event_type "drive.notice.comment_add_v1" :app_id "cli_test"
      :create_time "1767225600000" :token "must-not-be-persisted")
      :event (js-object :notice_meta (js-object :file_type (or kind "bitable") :file_token "new-unwatched-token"
        :from_user_id (js-object :open_id "ou_author") :to_user_id (js-object :open_id (or recipient "ou_user"))
        :notice_type "add_comment") :comment_id (str "comment-" id) :is_mentioned t)))
  (defun emit (f wire)
    (js-call (nativeGet (nativeGet f "state") "socket") :dispatchEvent
      (new globalThis.MessageEvent "message" (js-object :data (encodeLarkFrame (js-object :seq 1 :service 1 :method 1
        :headers (js-array (js-object :key "type" :value "event")
          (js-object :key "message_id" :value (nativeGet (nativeGet wire "header") "event_id")))
        :payload (Buffer/from (JSON/stringify wire) "utf8")))))))
  (defasync setup ()
    (let* ((old globalThis.WebSocket) (f nil) (configure nil)
      (state (js-object :root nil :acks (js-array) :hold false :release nil :fail_history false :history_calls 0)))
      (put factory :make (lambda (url)
        (let ((socket (new globalThis.EventTarget)))
          (put state :socket socket) (put socket :readyState 1)
          (put socket :close (lambda (&rest args) (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close"))))
          (put socket :send (lambda (bytes)
            (let* ((frame (decodeLarkFrame bytes)) (body (js-call (nativeGet frame "payload") :toString "utf8")))
              (when (= body "{\"code\":200}")
                ;; Read through a different SQLite connection at the actual ACK.
                (let* ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t)))
                  (rows (js-call (js-call db :query "SELECT event_id,state,payload FROM lark_event_receipts") :all)))
                  (try
                    (js-call (expect (> (js-length rows) 0)) :toBe t)
                    (js-call (expect (js-call (JSON/stringify rows) :includes "must-not-be-persisted")) :toBe false)
                    (js-call (nativeGet state "acks") :push rows)
                    (finally (js-call db :close))))))))
          (nativeSetTimeout (lambda () (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0) socket)))
      (setq configure (lambda (config ports)
        (put config :managed_profiles (js-array))
        (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (let ((connection (aref (nativeGet config "connections") 0)))
          (Object/assign connection (js-object :source_delivery "events" :event_scope "all_authorized"
            :event_app_id "cli_test" :event_subject_id "ou_user"))
          (put ports :credentials (js-object :resolve (lambda (ref)
            (js-object :app_id "cli_test" :app_secret "secret" :user_access_token "access"))))
          (put ports :http (js-object :fetch (async (address options)
            (let ((path (nativeGet (new globalThis.URL address) "pathname")))
              (cond
                ((js-call path :endsWith "/ws/endpoint") (Response/json (js-object :code 0 :data
                  (js-object :URL "wss://fixture.larksuite.com/ws?service_id=1" :ClientConfig (js-object :PingInterval 90)))))
                ((js-call path :endsWith "/user/subscription_status") (Response/json (js-object :code 0 :data (js-object :is_subscribe t))))
                ((js-call path :endsWith "/authen/v1/user_info") (Response/json (js-object :code 0 :data (js-object :open_id "ou_user"))))
                ((js-call path :endsWith "/messages/slow-original")
                  (put state :history_calls (1+ (nativeGet state "history_calls")))
                  (when (nativeGet state "hold")
                    (await (new globalThis.Promise (lambda (done) (put state :release done)))))
                  (if (nativeGet state "fail_history") (Response/json (js-object :code 99991400) (js-object :status 503))
                    (Response/json (js-object :code 0 :data (js-object :items (js-array (js-object
                      :message_id "slow-original" :chat_id "c1" :msg_type "text" :create_time "1767225600000"
                      :sender (js-object :id "ou_author" :sender_type "user" :id_type "open_id")
                      :body (js-object :content "{\"text\":\"native original\"}"))) :has_more false)))))
                (t (Response/json (js-object :code 99991663))))))))
          (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort connection ports)))))
      (put NativeGlobal :WebSocket receiver)
      (try
        (setq f (await (createFixture "event-receipts" "one" (js-object :configure configure :before_restart configure))))
        (put state :root (nativeGet f "root")) (put f :state state) (put f :old_socket old)
        (await (turns f 2)) f
        (catch error (put NativeGlobal :WebSocket old) (when f (await (closeFixture f))) (throw error)))))
  (defasync cleanup (f)
    (when f (try
      (when (nativeGet (nativeGet f "state") "release") (funcall (nativeGet (nativeGet f "state") "release")))
      (await (closeFixture f)) (finally (put NativeGlobal :WebSocket (nativeGet f "old_socket"))))))
  (defasync subscribe (f &optional reaction)
    (let* ((agent (await (bindRecipient f))) (preview (await (callOk f "A" "subscription.preview"
      (js-object :spec (js-object :agent_id (nativeGet agent "agent_id")
        :selector (js-object :sources (js-array (js-object :connection_id "lark"))
          :event_kinds (js-array (if reaction "message.reaction.added" "resource.changed")))
        :predicate (if reaction (js-object :field "reaction.emoji_type" :op "eq" :value "Pin")
          (js-object :field "addressed_self" :op "eq" :value t))))))))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "receipt-sub")))))
  (defasync status (f)
    (nativeGet (nativeGet (await (callOk f "O" "connection.probe" (js-object :connection_id "lark"))) "event_source") "event_receipts"))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (withCase "T38.event-receipt-routing.integration" setup (async (f)
    (await (subscribe f))
    (js-call (js-array "doc" "docx" "sheet" "bitable" "slides" "file") :forEach
      (lambda (kind) (emit f (notice kind kind))))
    (await (turns f 12))
    (js-call (expect (js-length (inputs f))) :toBe 6)
    (emit f (notice "bitable" "bitable")) (await (turns f))
    (js-call (expect (js-length (inputs f))) :toBe 6)
    (js-call (expect (nativeGet (await (status f)) "processed")) :toBe 6)
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 7)
    (let ((rows (query f "SELECT payload,raw_bytes FROM lark_event_receipts")))
      (js-call rows :forEach (lambda (row)
        (js-call (expect (nativeGet row "payload")) :toBe nil)
        (js-call (expect (nativeGet row "raw_bytes")) :toBe 0))))
    (await (js-call f :restart)) (await (turns f))
    (let ((probe (await (callOk f "O" "connection.probe" (js-object :connection_id "lark")))))
      (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get "connection.probe")
        (js-object :ok t :request_id "receipt-probe" :data probe :warnings (js-array) :evidence_level "service_record" :effect_state "none")) "ok")) :toBe t)
      (js-call (expect (nativeGet (nativeGet (nativeGet probe "event_source") "user_document_notices") "realtime_observed")) :toBe t))
    (js-call (expect (js-length (inputs f))) :toBe 6)) cleanup)
  (withCase "T38.event-receipt-slow-restart.integration" setup (async (f)
    (await (subscribe f t))
    (let ((state (nativeGet f "state")))
      (put state :hold t) (put state :fail_history t)
      (emit f (js-object :header (js-object :event_id "slow" :event_type "im.message.reaction.created_v1" :app_id "cli_test")
        :event (js-object :message_id "slow-original" :reaction_type (js-object :emoji_type "Pin")
          :operator_type "user" :user_id (js-object :open_id "ou_user") :action_time "1767225600000")))
      (await (turns f 2))
      (js-call (expect (js-length (nativeGet state "acks"))) :toBe 1)
      (js-call (expect (nativeGet (await (status f)) "retrying")) :toBe 1)
      (js-call (expect (js-length (inputs f))) :toBe 0)
      (put state :hold false) (funcall (nativeGet state "release")) (await (turns f))
      (js-call (expect (nativeGet (aref (query f "SELECT state FROM lark_event_receipts") 0) "state")) :toBe "retrying")
      (put state :fail_history false)
      (await (js-call f :restart)) (await (turns f 10 3000))
      (js-call (expect (js-length (inputs f))) :toBe 1)
      (js-call (expect (nativeGet (aref (query f "SELECT attempts FROM lark_event_receipts") 0) "attempts")) :toBe 2)
      (js-call (expect (nativeGet (await (status f)) "retrying")) :toBe 0))) cleanup)
  (withCase "T38.event-receipt-atomic-retry.integration" setup (async (f)
    (await (subscribe f))
    (query f "CREATE TRIGGER test_block_normalize BEFORE INSERT ON im_event_inbox BEGIN SELECT RAISE(ABORT,'blocked'); END")
    (emit f (notice "atomic")) (await (turns f))
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 1)
    (js-call (expect (js-length (query f "SELECT seq FROM im_event_inbox"))) :toBe 0)
    (let ((row (aref (query f "SELECT state,payload FROM lark_event_receipts") 0)))
      (js-call (expect (nativeGet row "state")) :toBe "retrying")
      (js-call (expect (not (nil? (nativeGet row "payload")))) :toBe t))
    (query f "DROP TRIGGER test_block_normalize") (await (turns f 10 3000))
    (js-call (expect (js-length (inputs f))) :toBe 1)
    (let ((wire (notice "malformed")))
      (Reflect/deleteProperty (nativeGet wire "event") "comment_id") (emit f wire))
    (emit f (notice "another-user" nil "ou_other"))
    (let ((wire (notice "unsupported"))) (put (nativeGet wire "header") :event_type "unknown.event_v1") (emit f wire))
    (await (turns f))
    (js-call (expect (nativeGet (await (status f)) "retrying")) :toBe 1)
    (js-call (expect (nativeGet (await (status f)) "ignored")) :toBe 2)
    (js-call (expect (js-length (inputs f))) :toBe 1)) cleanup)
  (withCase "T38.event-receipt-no-ack.integration" setup (async (f)
    (query f "CREATE TRIGGER test_block_receipt BEFORE INSERT ON lark_event_receipts BEGIN SELECT RAISE(ABORT,'blocked'); END")
    (emit f (notice "not-committed")) (await (turns f))
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 0)
    (js-call (expect (js-length (query f "SELECT event_id FROM lark_event_receipts"))) :toBe 0)
    (js-call (expect (nativeGet (nativeGet (nativeGet f "state") "socket") "readyState")) :toBe 3)
    (query f "DROP TRIGGER test_block_receipt")
    (await (js-call f :restart)) (await (turns f 2))
    (emit f (notice "not-committed")) (await (turns f))
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 1)
    (let ((wire (notice "not-committed"))) (put (nativeGet wire "event") :comment_id "changed-under-same-id") (emit f wire))
    (await (turns f))
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 1)
    (js-call (expect (js-length (query f "SELECT event_id FROM lark_event_receipts"))) :toBe 1)) cleanup)
  (withCase "T38.event-receipt-capacity.integration" setup (async (f)
    (emit f (notice "seed")) (await (turns f))
    (query f "WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<1000) INSERT INTO lark_event_receipts(connection_id,identity_revision,event_id,event_type,received_at,next_attempt_at,state,payload,payload_hash,raw_bytes,attempts,normalized_count) SELECT connection_id,identity_revision,'full-'||x,event_type,received_at,'2099-01-01T00:00:00.000Z','pending','{}','hash',2,0,0 FROM lark_event_receipts,n WHERE event_id='seed'")
    (emit f (notice "over-capacity")) (await (turns f))
    (js-call (expect (js-length (nativeGet (nativeGet f "state") "acks"))) :toBe 1)
    (js-call (expect (nativeGet (await (status f)) "pending")) :toBe 1000)
    (js-call (expect (js-length (query f "SELECT event_id FROM lark_event_receipts WHERE event_id='over-capacity'"))) :toBe 0)
    (query f "DELETE FROM lark_event_receipts WHERE event_id LIKE 'full-%'")
    (query f "INSERT INTO lark_event_receipts(connection_id,identity_revision,event_id,event_type,received_at,next_attempt_at,state,payload,payload_hash,raw_bytes,attempts,normalized_count) SELECT connection_id,identity_revision+1,'other-login',event_type,received_at,received_at,'pending','{}','hash',2,0,0 FROM lark_event_receipts WHERE event_id='seed'")
    (await (js-call f :restart)) (await (turns f))
    (js-call (expect (nativeGet (await (status f)) "other_identity_pending")) :toBe 1)
    (js-call (expect (nativeGet (aref (query f "SELECT attempts FROM lark_event_receipts WHERE event_id='other-login'") 0) "attempts")) :toBe 0)
    (query f "UPDATE lark_event_receipts SET received_at='2025-01-01T00:00:00.000Z' WHERE event_id='seed'")
    (emit f (notice "fresh")) (await (turns f))
    (js-call (expect (js-length (query f "SELECT event_id FROM lark_event_receipts WHERE event_id='seed'"))) :toBe 0)
    (js-call (expect (nativeGet (await (status f)) "pending")) :toBe 1)) cleanup))
