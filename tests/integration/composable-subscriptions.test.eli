(module dj.tests.integration.composable-subscriptions
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (defasync setup () (await (createFixture "composable-subscriptions" "dispatch" (js-object :configure (lambda (config ports)
    (put config :managed_profiles (js-array))
    (Object/assign (aref (nativeGet config "connections") 0)
      (js-object :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_user"))
    (put (aref (nativeGet config "principals") 3) :target_constraint
      (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s2"))
    (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1"))))))
  (defun leaf (field op value) (js-object :field field :op op :value value))
  (defun spec (agent predicate)
    (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object) :predicate predicate
      :context_policy (js-object :mode "recent" :max_events 8 :max_bytes 16384)))
  (defasync subscribe (f actor agent predicate)
    (let ((preview (await (callOk f actor "subscription.preview" (js-object :spec (spec agent predicate))))))
      (await (callOk f actor "subscription.create" (js-object :preview_id (nativeGet preview "preview_id")
        :idempotency_key (str "subscribe-" (randomUUID)))))))
  (defasync secondAgent (f)
    (let* ((items (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
      (candidate (js-call items :find (lambda (item) (= (nativeGet item "native_session_id") "s2")))))
      (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name "second" :binding_mode "existing" :recipient_principal_id "B" :idempotency_key "second-agent")))))
  (defun event (id kind sender chat private mention text &optional thread)
    (let ((item (createdEvent "lark" id text thread)))
      (put item :sender (js-object :id sender :kind kind))
      (put item :chat_type (if private "p2p" "group"))
      (put item :mentions (if mention (js-array (js-object :id "other-person")) (js-array)))
      (put (nativeGet item "conversation") :native_chat_id chat) item))
  (defasync setPolicy (f rules &optional people)
    (let* ((current (await (callOk f "O" "message.filter.get" (js-object))))
      (args (js-object :expected_revision (nativeGet current "revision") :rules rules :idempotency_key (str "policy-" (randomUUID)))))
      (when people (put args :people people))
      (await (callOk f "O" "message.filter.update" args))))
  (defun suppression (predicate) (js-array (js-object :id "bot-replies" :enabled t :effect "suppress_trigger" :predicate predicate)))
  (defun countSql (db sql) (nativeGet (js-call (js-call db :query sql) :get) "n"))
  (withCase "T38.composable-subscriptions.integration" setup (async (f)
    (let* ((a (await (bindRecipient f))) (b (await (secondAgent f)))
      (human-rule (js-object :all (js-array
        (js-object :any (js-array (leaf "mentions.any" "eq" t) (leaf "chat_type" "eq" "p2p")))
        (js-object :not (leaf "sender.kind" "in" (js-array "bot" "agent")))
        (js-object :not (leaf "text" "contains" "IGNORE"))
        (js-object :not (leaf "conversation.native_chat_id" "eq" "excluded-chat"))
        (js-object :not (leaf "thread.id" "eq" "excluded-thread")))))
      (keyword-rule (leaf "text" "contains" "ship"))
      (first (await (subscribe f "A" a human-rule)))
      (second (await (subscribe f "A" a keyword-rule)))
      (third (await (subscribe f "B" b keyword-rule)))
      (bot-line (await (subscribe f "B" b (js-object :all (js-array
        (leaf "sender.kind" "eq" "bot") (leaf "sender.id" "eq" "bot-watch"))))))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try
        ;; Matching subscriptions merge for the same target, independently fan out to another target.
        (await (js-call f :ingest (event "overlap" "human" "person-a" "c1" false t "ship it")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM contributions c JOIN events e ON e.event_id=(SELECT event_id FROM deliveries WHERE delivery_id=c.delivery_id) WHERE e.native_message_id='overlap'")) :toBe 3)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id='overlap'")) :toBe 2)
        (await (js-call f :ingest (event "dm" "human" "person-a" "c1" t false "hello")))
        (await (js-call f :ingest (event "excluded-kind" "bot" "bot-other" "c1" t t "robot reply")))
        (await (js-call f :ingest (event "excluded-word" "human" "person-a" "c1" t t "IGNORE")))
        (await (js-call f :ingest (event "excluded-chat" "human" "person-a" "excluded-chat" t t "hello")))
        (await (js-call f :ingest (event "excluded-thread" "human" "person-a" "c1" false t "hello" "excluded-thread")))
        (await (js-call f :ingest (event "bot-opt-in" "bot" "bot-watch" "c1" false false "robot reply")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 4)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id LIKE 'excluded-%'")) :toBe 0)
        ;; Global suppression applies before every subscription, while the received message stays readable.
        (await (setPolicy f (suppression (js-object :all (js-array
          (leaf "sender.kind" "eq" "bot") (leaf "sender.id" "in" (js-array "bot-watch" "bot-command")))))))
        (await (js-call f :ingest (event "globally-blocked" "bot" "bot-watch" "c1" t t "ship robot reply")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 4)
        (let* ((row (js-call (js-call db :query "SELECT event_id FROM events WHERE native_message_id='globally-blocked'") :get))
          (preview (await (callOk f "B" "subscription.preview" (js-object :spec (spec b keyword-rule)
            :sample_event_ids (js-array (nativeGet row "event_id"))))))
          (sample (aref (nativeGet preview "samples") 0)))
          (js-call (expect (nativeGet sample "result")) :toBe "true")
          (js-call (expect (nativeGet sample "reason_codes")) :toEqual (js-array "trigger_suppressed")))
        (let* ((address (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
          (items (nativeGet (await (callOk f "A" "message.list" (js-object :conversation_ref (nativeGet address "conversation_ref")))) "items")))
          (js-call (expect (js-call items :some (lambda (item) (= (nativeGet item "native_message_id") "globally-blocked")))) :toBe t))
        (js-call (expect (countSql db "SELECT count(*) AS n FROM events")) :toBe 8)
        ;; A subscriber can pause just one line without cancelling another subscriber's line.
        (await (callOk f "A" "subscription.pause" (js-object :subscription_id (nativeGet second "subscription_id")
          :expected_revision (nativeGet second "revision") :idempotency_key "pause-keyword-a")))
        (await (js-call f :ingest (event "only-second-target" "human" "person-a" "c1" false false "ship")))
        (await (js-call f :tick))
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id='only-second-target'")) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 5)
        (finally (js-call db :close))))) closeFixture)
  (withCase "T38.person-subscriptions.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (alias (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_person_a"))
      (people (js-array (js-object :id "known-person" :identities (js-array alias))))
      (predicate (js-object :all (js-array (leaf "sender.person_id" "eq" "known-person") (leaf "chat_type" "eq" "p2p")))))
      (await (setPolicy f (js-array) people))
      (await (subscribe f "A" agent predicate))
      (let ((bad (await (js-call f :call (nativeGet f "A") "subscription.preview"
        (js-object :spec (spec agent (leaf "sender.person_id" "eq" "not-registered")))))))
        (js-call (expect (nativeGet bad "ok")) :toBe false))
      (await (js-call f :ingest (event "person-match" "human" "ou_person_a" "c1" t false "hello")))
      (await (js-call f :ingest (event "different-person" "human" "ou_other" "c1" t false "hello")))
      (await (js-call f :ingest (event "same-person-group" "human" "ou_person_a" "c1" false false "hello")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
      ;; A changed alias is read fresh; display names and previously cached decisions cannot stand in for identity.
      (await (setPolicy f (js-array) (js-array (js-object :id "known-person" :identities
        (js-array (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_person_b"))))))
      (await (js-call f :ingest (event "old-alias" "human" "ou_person_a" "c1" t false "hello")))
      (await (js-call f :ingest (event "new-alias" "human" "ou_person_b" "c1" t false "hello")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2))) closeFixture))
