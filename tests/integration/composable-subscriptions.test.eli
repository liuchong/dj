(module dj.tests.integration.composable-subscriptions
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/errors.eli" success)
  (import "../../src/adapters/im/lark-events.eli" flattenLarkEvent normalizeLarkEvent)
  (import "../../src/adapters/im/lark-resource-events.eli" normalizeResourceEvents)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (defasync setup () (await (createFixture "composable-subscriptions" "dispatch" (js-object :configure (lambda (config ports)
    (put config :managed_profiles (js-array))
    (Object/assign (aref (nativeGet config "connections") 0)
      (js-object :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_user"))
    (put (aref (nativeGet config "principals") 3) :target_constraint
      (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id "s2"))
    (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1"))))))
  (defun leaf (field op value) (js-object :field field :op op :value value))
  (defun ruleBranch (id predicate &optional options)
    (Object/assign
      (js-object :id id :enabled t :predicate predicate)
      (or options (js-object))))
  (defun spec (agent rules &optional options)
    (Object/assign
      (js-object :agent_id (nativeGet agent "agent_id") :rules rules)
      (or options (js-object))))
  (defasync setSubscription (f actor agent expected-revision rules &optional options)
    (let ((preview (await (callOk f actor "subscription.preview"
      (js-object :expected_revision expected-revision :spec (spec agent rules options))))))
      (await (callOk f actor "subscription.set"
        (js-object :preview_id (nativeGet preview "preview_id")
          :expected_revision expected-revision
          :idempotency_key (str "subscribe-" (randomUUID)))))))
  (defasync subscribe (f actor agent predicate)
    (await (setSubscription f actor agent 0
      (js-array (ruleBranch "default" predicate
        (js-object :context_policy (js-object :mode "recent" :max_events 8 :max_bytes 16384)))))))
  (defasync secondAgent (f)
    (let* ((items (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
      (candidate (js-call items :find (lambda (item) (= (nativeGet item "native_session_id") "s2")))))
      (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name "second" :binding_mode "existing" :recipient_principal_id "B" :idempotency_key "second-agent")))))
  (defun event (id kind sender chat private mention text &optional thread)
    (let ((item (createdEvent "lark" id text thread)))
      (put item :sender (js-object :id sender :kind kind))
      (put item :chat_type (if private "p2p" "group"))
      (put item :mentions (if mention (js-array (js-object :id "other-person")) (js-array)))
      (put (nativeGet item "conversation") :native_chat_id chat) item))
  (defasync setPolicy (f rules &optional people)
    (let* ((current (await (callOk f "O" "message.filter.get" (js-object))))
      (args (js-object :expected_revision (nativeGet current "revision") :rules rules :idempotency_key (str "policy-" (randomUUID)))))
      (when people (put args :people people))
      (await (callOk f "O" "message.filter.update" args))))
  (defun suppression (predicate) (js-array (js-object :id "bot-replies" :enabled t :effect "suppress_trigger" :predicate predicate)))
  (defun countSql (db sql) (nativeGet (js-call (js-call db :query sql) :get) "n"))
  (withCase "T38.composable-subscriptions.integration" setup (async (f)
    (let* ((a (await (bindRecipient f))) (b (await (secondAgent f)))
      (human-rule (js-object :all (js-array
        (js-object :any (js-array (leaf "mentions.any" "eq" t) (leaf "chat_type" "eq" "p2p")))
        (js-object :not (leaf "sender.kind" "in" (js-array "bot" "agent")))
        (js-object :not (leaf "text" "contains" "IGNORE"))
        (js-object :not (leaf "conversation.native_chat_id" "eq" "excluded-chat"))
        (js-object :not (leaf "thread.id" "eq" "excluded-thread")))))
      (keyword-rule (leaf "text" "contains" "ship"))
      (bot-predicate (js-object :all (js-array
        (leaf "sender.kind" "eq" "bot") (leaf "sender.id" "eq" "bot-watch"))))
      (sub-a (await (setSubscription f "A" a 0
        (js-array
          (ruleBranch "human" human-rule
            (js-object :context_policy (js-object :mode "current" :max_events 1 :max_bytes 4096)
              :instruction_policy (js-object :prompt "Human branch" :task_template "Handle {{rule.id}} on {{subscription.target_key}}")))
          (ruleBranch "keyword" keyword-rule
            (js-object :context_policy (js-object :mode "recent" :max_events 8 :max_bytes 16384)))))))
      (sub-b (await (setSubscription f "B" b 0
        (js-array
          (ruleBranch "keyword" keyword-rule
            (js-object :context_policy (js-object :mode "recent" :max_events 8 :max_bytes 16384)))
          (ruleBranch "bot-watch" bot-predicate)))))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try
        ;; Multiple matching rule branches in a target's single subscription coalesce into one delivery with matched rule_ids.
        (await (js-call f :ingest (event "overlap" "human" "person-a" "c1" false t "ship it")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM sqlite_master WHERE type='table' AND name='contributions'")) :toBe 0)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id='overlap'")) :toBe 2)
        (let* ((inputs (nativeGet (nativeGet f "opencode") "inputs"))
          (for-a (js-call inputs :find (lambda (item) (= (nativeGet (nativeGet item "binding") "native_session_id") "s1"))))
          (env-a (nativeGet for-a "envelope"))
          (matched-a (nativeGet env-a "matched"))
          (instr-a (aref (nativeGet env-a "instructions") 0)))
          (js-call (expect (nativeGet matched-a "target_key")) :toBe (nativeGet sub-a "target_key"))
          (js-call (expect (nativeGet matched-a "subscription_revision")) :toBe 1)
          (js-call (expect (nativeGet matched-a "rule_ids")) :toEqual (js-array "human" "keyword"))
          (js-call (expect (nativeGet instr-a "rule_id")) :toBe "human")
          (js-call (expect (nativeGet instr-a "task")) :toBe (str "Handle human on " (nativeGet sub-a "target_key"))))
        (await (js-call f :ingest (event "dm" "human" "person-a" "c1" t false "hello")))
        (await (js-call f :ingest (event "excluded-kind" "bot" "bot-other" "c1" t t "robot reply")))
        (await (js-call f :ingest (event "excluded-word" "human" "person-a" "c1" t t "IGNORE")))
        (await (js-call f :ingest (event "excluded-chat" "human" "person-a" "excluded-chat" t t "hello")))
        (await (js-call f :ingest (event "excluded-thread" "human" "person-a" "c1" false t "hello" "excluded-thread")))
        (await (js-call f :ingest (event "bot-opt-in" "bot" "bot-watch" "c1" false false "robot reply")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 4)
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id LIKE 'excluded-%'")) :toBe 0)
        ;; Global suppression applies before every subscription, while the received message stays readable.
        (await (setPolicy f (suppression (js-object :all (js-array
          (leaf "sender.kind" "eq" "bot") (leaf "sender.id" "in" (js-array "bot-watch" "bot-command")))))))
        (await (js-call f :ingest (event "globally-blocked" "bot" "bot-watch" "c1" t t "ship robot reply")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 4)
        (let* ((row (js-call (js-call db :query "SELECT event_id FROM events WHERE native_message_id='globally-blocked'") :get))
          (preview (await (callOk f "B" "subscription.preview"
            (js-object :expected_revision (nativeGet sub-b "revision")
              :spec (spec b (js-array (ruleBranch "keyword" keyword-rule)))
              :sample_event_ids (js-array (nativeGet row "event_id"))))))
          (sample (aref (nativeGet preview "samples") 0)))
          (js-call (expect (nativeGet sample "result")) :toBe "true")
          (js-call (expect (nativeGet sample "reason_codes")) :toEqual (js-array "trigger_suppressed")))
        (let* ((address (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
          (items (nativeGet (await (callOk f "A" "message.list" (js-object :conversation_ref (nativeGet address "conversation_ref")))) "items")))
          (js-call (expect (js-call items :some (lambda (item) (= (nativeGet item "native_message_id") "globally-blocked")))) :toBe t))
        (js-call (expect (countSql db "SELECT count(*) AS n FROM events")) :toBe 8)
        ;; A subscriber can disable one rule branch in its single subscription without affecting other rules or another subscriber.
        (await (setSubscription f "A" a (nativeGet sub-a "revision")
          (js-array
            (ruleBranch "human" human-rule)
            (ruleBranch "keyword" keyword-rule (js-object :enabled false)))))
        (await (js-call f :ingest (event "only-second-target" "human" "person-a" "c1" false false "ship")))
        (await (js-call f :tick))
        (js-call (expect (countSql db "SELECT count(*) AS n FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id='only-second-target'")) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 5)
        (finally (js-call db :close))))) closeFixture)
  (withCase "T38.single-slot-multi-kind-and-rebind.integration" setup (async (f)
    (put (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark") :resource
      (async (command args context)
        (if (= command "resolve")
          (success (js-object :node (js-object :obj_type "bitable" :obj_token "app_bug_table" :title "Bugs")))
          (success (js-object)))))
    (let* ((a (await (bindRecipient f)))
      (board (await (callOk f "A" "resource.resolve"
        (js-object :connection_id "lark" :url "https://test.larksuite.com/wiki/wikiBugs" :corpus "native"))))
      (sub-1 (await (setSubscription f "A" a 0
        (js-array
          (ruleBranch "im-mentions" (leaf "addressed_self" "eq" t)
            (js-object :sources (js-array (js-object :connection_id "lark"))
              :event_kinds (js-array "message.created")))
          (ruleBranch "bitable-bugs"
            (js-object :all (js-array
              (leaf "resource.kind" "eq" "bitable")
              (leaf "people.id" "eq" "ou_bug_owner")))
            (js-object :sources (js-array (js-object :conversation_ref (nativeGet board "conversation_ref") :include_threads t))
              :event_kinds (js-array "resource.changed")))))))
      (slot-key (nativeGet sub-1 "target_key")))
      (js-call (expect (js-call slot-key :startsWith "session:")) :toBe t)
      ;; Stale expected_revision: 0 is rejected once the single slot exists.
      (let ((conflict (await (js-call f :call (nativeGet f "A") "subscription.preview"
        (js-object :expected_revision 0 :spec (spec a (js-array (ruleBranch "dup" (leaf "addressed_self" "eq" t)))))))))
        (js-call (expect (nativeGet (nativeGet conflict "error") "code")) :toBe "revision_conflict"))
      ;; Ingest both IM mention and bitable resource.changed; each hits only its matching branch on the same slot.
      (let ((im-hit (event "im-1" "human" "person-1" "c1" false t "ping")))
        (put im-hit :addressed_self t)
        (await (js-call f :ingest im-hit)))
      (let* ((wire (js-object
               :header (js-object :event_type "drive.file.bitable_record_changed_v1" :app_id "cli_test" :event_id "bitable-change-1" :create_time "1767225600000")
               :event (js-object :file_token "app_bug_table" :file_type "bitable" :table_id "tbl_bugs" :operator_id (js-object :open_id "ou_editor")
                 :action_list (js-array (js-object :record_id "rec_bug_1" :action "record_edited" :after_value (js-array
                   (js-object :field_id "owner" :field_value "[{\"id\":\"ou_bug_owner\",\"name\":\"Owner\"}]")))))))
             (res-hit (aref (normalizeResourceEvents (js-object :connection_id "lark" :event_app_id "cli_test") wire) 0)))
        (await (js-call f :ingest res-hit)))
      (await (js-call f :tick))
      (let ((inputs (nativeGet (nativeGet f "opencode") "inputs")))
        (js-call (expect (js-length inputs)) :toBe 2)
        (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 0) "envelope") "matched") "rule_ids"))
          :toEqual (js-array "im-mentions"))
        (js-call (expect (nativeGet (nativeGet (nativeGet (aref inputs 1) "envelope") "matched") "rule_ids"))
          :toEqual (js-array "bitable-bugs")))
      ;; Unregistering closes the agent and pauses its slot; re-registering the same native session reuses the exact session:<session_key> slot.
      (let* ((closed (await (callOk f "O" "agent.unregister"
          (js-object :agent_id (nativeGet a "agent_id") :expected_revision (nativeGet a "revision") :idempotency_key "unreg-s1"))))
        (items (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))) "items"))
        (candidate (js-call items :find (lambda (x) (= (nativeGet x "native_session_id") "s1"))))
        (a2 (await (callOk f "O" "agent.register"
          (js-object :candidate_ref (nativeGet candidate "candidate_ref")
            :display_name "same-rebound" :binding_mode "existing" :recipient_principal_id "A" :idempotency_key "rereg-s1"))))
        (current (await (callOk f "A" "subscription.get" (js-object :agent_id (nativeGet a2 "agent_id")))))
        (sub-2 (await (setSubscription f "A" a2 (nativeGet current "revision")
          (js-array (ruleBranch "im-mentions" (leaf "addressed_self" "eq" t)))))))
        (js-call (expect (nativeGet closed "state")) :toBe "closed")
        (js-call (expect (nativeGet current "target_key")) :toBe slot-key)
        (js-call (expect (nativeGet current "state")) :toBe "paused")
        (js-call (expect (nativeGet sub-2 "target_key")) :toBe slot-key)
        (js-call (expect (nativeGet sub-2 "agent_id")) :toBe (nativeGet a2 "agent_id"))
        (js-call (expect (nativeGet sub-2 "state")) :toBe "active")))) closeFixture)
  (withCase "T38.person-subscriptions.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (alias (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_person_a"))
      (people (js-array (js-object :id "known-person" :identities (js-array alias))))
      (predicate (js-object :all (js-array (leaf "sender.person_id" "eq" "known-person") (leaf "chat_type" "eq" "p2p")))))
      (await (setPolicy f (js-array) people))
      (await (subscribe f "A" agent predicate))
      (let ((bad (await (js-call f :call (nativeGet f "A") "subscription.preview"
        (js-object :expected_revision 1 :spec (spec agent (js-array (ruleBranch "bad" (leaf "sender.person_id" "eq" "not-registered")))))))))
        (js-call (expect (nativeGet bad "ok")) :toBe false))
      (await (js-call f :ingest (event "person-match" "human" "ou_person_a" "c1" t false "hello")))
      (await (js-call f :ingest (event "different-person" "human" "ou_other" "c1" t false "hello")))
      (await (js-call f :ingest (event "same-person-group" "human" "ou_person_a" "c1" false false "hello")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
      ;; A changed alias is read fresh; display names and previously cached decisions cannot stand in for identity.
      (await (setPolicy f (js-array) (js-array (js-object :id "known-person" :identities
        (js-array (js-object :platform "lark" :scope "app:cli_test:open_id" :id "ou_person_b"))))))
      (await (js-call f :ingest (event "old-alias" "human" "ou_person_a" "c1" t false "hello")))
      (await (js-call f :ingest (event "new-alias" "human" "ou_person_b" "c1" t false "hello")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2))) closeFixture)
  (defun larkWireEvent (id chat sender-type sender-id msg-type payload)
    (let ((cfg (js-object :connection_id "lark" :brand "lark" :identity "bot" :event_app_id "cli_test" :event_subject_id "ou_bot"))
          (wire (js-object
            :header (js-object :event_type "im.message.receive_v1" :app_id "cli_test" :tenant_key "tenant_a")
            :event (js-object
              :sender (js-object :sender_id (js-object :open_id sender-id) :sender_type sender-type :tenant_key "tenant_a")
              :message (js-object :message_id id :chat_id chat :chat_type "group" :message_type msg-type
                :create_time "1790000000000" :content (JSON/stringify payload) :mentions (js-array))))))
      (normalizeLarkEvent cfg (flattenLarkEvent wire))))
  (withCase "T38.multi-condition-first-line.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (fire-first-line (js-object :all (js-array
        (leaf "event_kind" "eq" "message.created")
        (leaf "conversation.native_chat_id" "eq" "chat-fire")
        (leaf "text.first_line" "contains" "炸了！")
        (leaf "sender.kind" "eq" "human")
        (js-object :not (leaf "text" "contains" "演练")))))
      (fire-any-line-suffix (js-object :all (js-array
        (leaf "event_kind" "eq" "message.created")
        (leaf "conversation.native_chat_id" "eq" "chat-fire")
        (leaf "sender.kind" "eq" "human")
        (leaf "text.lines" "suffix" "请立即介入"))))
      (sub (await (subscribe f "A" agent (js-object :any (js-array fire-first-line fire-any-line-suffix))))))
      (await (js-call f :ingest (larkWireEvent "fire-post-hit" "chat-fire" "user" "ou_human_1" "post"
        (js-object :title "" :content (js-array
          (js-array (js-object :tag "text" :text "[告警] 线上订单服务炸了！ ") (js-object :tag "at" :user_name "值班员"))
          (js-array (js-object :tag "text" :text "错误率升高，请查看 ") (js-object :tag "a" :text "监控面板" :href "https://example.invalid/m")))))))
      (await (js-call f :ingest (larkWireEvent "fire-post-second-line-only" "chat-fire" "user" "ou_human_1" "post"
        (js-object :title "" :content (js-array
          (js-array (js-object :tag "text" :text "日常巡检正常"))
          (js-array (js-object :tag "text" :text "昨天测试环境炸了！")))))))
      (await (js-call f :ingest (larkWireEvent "fire-leading-newline" "chat-fire" "user" "ou_human_1" "text"
        (js-object :text "\n炸了！"))))
      (await (js-call f :ingest (larkWireEvent "other-chat-miss" "chat-other" "user" "ou_human_1" "text"
        (js-object :text "线上服务炸了！\n详情"))))
      (await (js-call f :ingest (larkWireEvent "bot-sender-miss" "chat-fire" "app" "cli_other_bot" "text"
        (js-object :text "线上服务炸了！\n详情"))))
      (await (js-call f :ingest (larkWireEvent "drill-excluded" "chat-fire" "user" "ou_human_1" "text"
        (js-object :text "线上服务炸了！\n本次为混沌演练"))))
      (await (js-call f :ingest (larkWireEvent "fire-line-suffix-hit" "chat-fire" "user" "ou_human_2" "text"
        (js-object :text "值班通报\n数据库主从延迟超限，请立即介入\n附慢查询摘要"))))
      (await (js-call f :tick))
      (let ((inputs (nativeGet (nativeGet f "opencode") "inputs")))
        (js-call (expect (js-length inputs)) :toBe 2)
        (let ((env0 (nativeGet (aref inputs 0) "envelope"))
              (env1 (nativeGet (aref inputs 1) "envelope")))
          (js-call (expect (nativeGet (nativeGet env0 "content") "text"))
            :toBe "[告警] 线上订单服务炸了！ @值班员\n错误率升高，请查看 监控面板")
          (js-call (expect (js-call (nativeGet env0 "trigger_reasons" (js-array)) :some
            (lambda (item) (= (nativeGet item "code") "subscription_rule")))) :toBe t)
          (js-call (expect (nativeGet (nativeGet env1 "content") "text"))
            :toBe "值班通报\n数据库主从延迟超限，请立即介入\n附慢查询摘要")))
      (let* ((address (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "chat-fire" :thread_id nil))))
        (listed (nativeGet (await (callOk f "A" "message.list" (js-object :conversation_ref (nativeGet address "conversation_ref")))) "items")))
        (js-call (expect (js-length listed)) :toBe 6)
        (js-call (expect (nativeGet sub "revision")) :toBe 1)))) closeFixture))
