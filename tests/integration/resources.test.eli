(module dj.tests.integration.resources
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/errors.eli" success)
  (import "../../src/adapters/im/lark-resources.eli" requestResource)
  (import "../../src/adapters/im/lark-resource-events.eli" normalizeResourceEvents)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "bun:test" expect)
  (defasync setup () (await (createFixture "resources" "one" (js-object :configure (lambda (config ports)
    (put config :managed_profiles (js-array))
    (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
    (js-call (nativeGet (aref (nativeGet config "principals") 2) "grants") :push
      (js-object :action "resource.read" :resources (js-array (js-object :connection_id "lark" :kind "resource" :resource_kind "wiki" :resource_token "wikiToken") (js-object :connection_id "lark" :kind "resource" :resource_kind "bitable" :resource_token "baseToken")))
      (js-object :action "resource.subscribe" :resources (js-array "*"))))))))
  (defun portOf (f) (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark"))
  (defun assertWire (name data)
    (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get name)
      (js-object :ok t :request_id "resources" :data data :warnings (js-array) :evidence_level "service_record" :effect_state "none")) "ok")) :toBe t))
  (defasync resolveBoard (f)
    (callOk f "A" "resource.resolve" (js-object :connection_id "lark" :url "https://test.larksuite.com/wiki/wikiToken" :corpus "native")))
  (withCase "T38.resource-context.integration" setup (async (f)
    (let ((calls 0) (watch-calls 0))
      (put (portOf f) :resource (async (command args context)
        (setq calls (1+ calls))
        (cond ((= command "resolve") (success (js-object :node (js-object :obj_type "bitable" :obj_token "baseToken" :space_id "spaceOne" :title "Board"))))
          ((= command "watch") (setq watch-calls (1+ watch-calls)) (success (js-object)))
          (t (success (js-object :record (js-object :record_id "recordOne" :fields (js-object :title (js-call "中文😀" :repeat 70) :state "open"))))))))
      (let* ((board (await (resolveBoard f))) (ref (nativeGet board "resource_ref"))
        (args (js-object :resource_ref ref :table_id "tableOne" :record_id "recordOne" :view "records" :max_bytes 128 :corpus "native"))
        (page (await (callOk f "A" "resource.read" args))) (joined (nativeGet page "text")) (cursor (nativeGet page "next_cursor")) (round 0))
        (assertWire "resource.resolve" board) (assertWire "resource.read" page)
        (js-call (expect (nativeGet board "kind")) :toBe "bitable")
        (js-call (expect calls) :toBe 2)
        (while (and cursor (< round 20))
          (setq page (await (callOk f "A" "resource.read" (Object/assign (js-object) args (js-object :cursor cursor)))))
          (setq joined (str joined (nativeGet page "text")) cursor (nativeGet page "next_cursor") round (1+ round)))
        (js-call (expect cursor) :toBe nil)
        (js-call (expect calls) :toBe 2)
        (js-call (expect (nativeGet (nativeGet (JSON/parse joined) "record") "record_id")) :toBe "recordOne")
        (let ((local (await (callOk f "A" "resource.read" (Object/assign (js-object) args (js-object :corpus "local"))))))
          (js-call (expect (nativeGet local "cache_hit")) :toBe t) (js-call (expect calls) :toBe 2))
        (let ((denied (await (js-call f :call (nativeGet f "B") "resource.read" args))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (let ((watch (await (callOk f "A" "resource.watch" (js-object :resource_ref ref :idempotency_key "watch-one")))))
          (assertWire "resource.watch.get" watch)
          (js-call (expect (nativeGet watch "state")) :toBe "subscribed")
          (js-call (expect (nativeGet watch "event_channel")) :toBe "not_configured")
          (let ((again (await (callOk f "A" "resource.watch" (js-object :resource_ref ref :idempotency_key "watch-two")))))
            (js-call (expect (nativeGet again "watch_id")) :toBe (nativeGet watch "watch_id")))
          (js-call (expect watch-calls) :toBe 1)
          (let ((readback (await (callOk f "A" "resource.watch.get" (js-object :watch_id (nativeGet watch "watch_id"))))))
            (js-call (expect (nativeGet readback "state")) :toBe "subscribed")))
        (await (js-call f :restart))
        (let ((local (await (callOk f "A" "resource.read" (Object/assign (js-object) args (js-object :corpus "local"))))))
          (js-call (expect (nativeGet local "cache_hit")) :toBe t))))) closeFixture)
  (withCase "T38.resource-routing.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (calls (js-array)))
      (put (portOf f) :resource (async (command args context)
        (if (= command "resolve") (success (js-object :node (js-object :obj_type "bitable" :obj_token "baseToken" :title "Board"))) (success (js-object)))))
      (let* ((board (await (resolveBoard f)))
        (spec (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object :sources (js-array
          (js-object :conversation_ref (nativeGet board "conversation_ref") :include_threads t)) :event_kinds (js-array "resource.changed"))
          :predicate (js-object :field "people.id" :op "eq" :value "ou_person") :context_policy (js-object :mode "current" :max_events 1)
          :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 86400) :start "now"))
        (preview (await (callOk f "A" "subscription.preview" (js-object :spec spec)))))
        (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "resource-sub")))
        (let* ((wire (js-object :header (js-object :event_type "drive.file.bitable_record_changed_v1" :app_id "cli_test" :event_id "changeOne" :create_time "1767225600000")
          :event (js-object :file_token "baseToken" :file_type "bitable" :table_id "tableOne" :operator_id (js-object :open_id "ou_editor")
          :action_list (js-array (js-object :record_id "recordOne" :action "record_edited" :after_value (js-array
            (js-object :field_id "personField" :field_value "[{\"id\":\"ou_person\",\"name\":\"Person\"}]")))))))
          (event (aref (normalizeResourceEvents (js-object :connection_id "lark" :event_app_id "cli_test") wire) 0)))
          (let ((result (await (js-call f :ingest event)))) (js-call (expect (nativeGet result "ok")) :toBe t))
          (await (js-call f :ingest event)) (await (js-call f :tick))
          (let* ((inputs (nativeGet (nativeGet f "opencode") "inputs")) (envelope (nativeGet (aref inputs 0) "envelope")))
            (js-call (expect (js-length inputs)) :toBe 1)
            (js-call (expect (nativeGet (nativeGet envelope "source") "kind")) :toBe "resource")
            (js-call (expect (nativeGet (nativeGet envelope "resource") "record_id")) :toBe "recordOne")
            (js-call (expect (nativeGet (nativeGet envelope "topic") "kind")) :toBe "resource_record")
            (js-call (expect (nativeGet envelope "reply_context_id")) :toBe nil)
            (js-call (expect (js-length (nativeGet envelope "mentions"))) :toBe 0)
            (js-call (expect (nativeGet (aref (nativeGet envelope "people") 0) "id")) :toBe "ou_person")
            (let ((page (await (callOk f "A" "resource.read" (js-object :resource_ref (nativeGet (nativeGet envelope "resource") "resource_ref") :view "records" :corpus "native")))))
              (assertWire "resource.read" page))))))) closeFixture)
  (withCase "T38.topic-context.integration" setup (async (f)
    (let ((root (createdEvent "lark" "topicRoot" "root" nil)) (reply (createdEvent "lark" "topicReply" "reply" nil)))
      (put reply :reply_to (js-object :id "topicRoot")) (put reply :root_message_id "topicRoot")
      (let* ((accepted (await (js-call f :ingest root))) (id (nativeGet (nativeGet accepted "data") "event_id")))
        (await (js-call f :ingest (createdEvent "lark" "otherTopic" "other" nil)))
        (await (js-call f :ingest reply))
        (let* ((context (await (callOk f "A" "message.context" (js-object :event_id id)))) (topic (await (callOk f "A" "message.history" (js-object :context_ref (nativeGet context "context_ref") :limit 10)))))
          (js-call (expect (js-length (nativeGet topic "items"))) :toBe 2)
          (js-call (expect (nativeGet (nativeGet (aref (nativeGet topic "items") 0) "topic") "kind")) :toBe "reply_chain"))
        (let* ((context (await (callOk f "A" "message.context" (js-object :event_id id)))) (all (await (callOk f "A" "message.history" (js-object :context_ref (nativeGet context "context_ref") :scope "conversation" :limit 10)))))
          (js-call (expect (js-length (nativeGet all "items"))) :toBe 3))))) closeFixture)
  (withCase "T38.resource-native-api.integration" (lambda () nil) (async (ignored)
    (let* ((calls (js-array)) (http (js-object :request (async (url method body context)
      (js-call calls :push (js-object :url url :method method :body body))
      (js-object :status 200 :wire (js-object :code 0 :data (js-object)))))))
      (await (requestResource http "resolve" (js-object :kind "wiki" :token "nodeOne") nil))
      (await (requestResource http "read" (js-object :kind "docx" :token "docOne" :view "content") nil))
      (await (requestResource http "read" (js-object :kind "sheet" :token "sheetOne" :range "tabOne!A1:C10") nil))
      (await (requestResource http "read" (js-object :kind "bitable" :token "baseOne" :table_id "tableOne" :view "records") nil))
      (js-call (expect (js-call (nativeGet (aref calls 0) "url") :startsWith "/open-apis/wiki/v2/spaces/get_node?")) :toBe t)
      (js-call (expect (js-call (nativeGet (aref calls 1) "url") :startsWith "/open-apis/docx/v1/documents/docOne/raw_content?")) :toBe t)
      (js-call (expect (js-call (nativeGet (aref calls 2) "url") :includes "ranges=tabOne%21A1%3AC10")) :toBe t)
      (js-call (expect (nativeGet (aref calls 3) "method")) :toBe "POST")
      (js-call (expect (js-call (nativeGet (aref calls 3) "url") :startsWith "/open-apis/bitable/v1/apps/baseOne/tables/tableOne/records/search?")) :toBe t))) (lambda (x) nil)))
