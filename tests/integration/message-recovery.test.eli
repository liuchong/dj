(module dj.tests.integration.message-recovery
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (let* ((marks (new globalThis.Map)) (state (js-object :reads 0))
      (f (await (createFixture "message-recovery" "one" (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array)) (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (let ((connection (aref (nativeGet config "connections") 0)) (port (js-call (nativeGet ports "im_ports") :get "lark")))
          (Object/assign connection (js-object :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_user"))
          (put port :history (async (args context)
            (put state :reads (1+ (nativeGet state "reads")))
            (let ((id (nativeGet args "message_id" "missed")))
              (js-object :ok t :data (js-object :messages (if (= id "missing") (js-array)
                (js-array (js-object :message_id id :chat_id "c1" :create_time "1767225600000"
                  :sender (js-object :id "human" :id_type "open_id" :sender_type "user")
                  :content "native missed message" :mentions (js-array (js-object :id "ou_user" :name "Recipient"))))) :has_more false)))))
          (put port :reaction (async (command args context)
            (cond ((= command "list") (js-object :ok t :data (js-object :items (Array/from (js-call marks :values)) :has_more false)))
              ((= command "create") (js-call marks :set "reaction" (js-object :reaction_id "reaction" :reaction_type (js-object :emoji_type "Typing")
                :operator (js-object :operator_type "user" :operator_id "ou_user"))) (js-object :ok t :data (js-object :reaction_id "reaction")))
              (t (js-call marks :delete "reaction") (js-object :ok t :data (js-object)))))))))))))
      (put f :marks marks) (put f :recovery_state state) f))
  (defasync turns (f n) (let ((i 0)) (while (< i n) (await (js-call f :tick)) (setq i (1+ i)))))
  (defun countEvents (f)
    (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM events") :get) "n") (finally (js-call db :close)))))
  (withCase "T38.explicit-message-recovery.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object))))))
      (conversation (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (args (js-object :connection_id "lark" :native_message_ids (js-array "missed") :reason "explicit missed-message processing" :idempotency_key "recover-one")))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "sub-one")))
      (await (callOk f "A" "message.history" (js-object :conversation_ref (nativeGet conversation "conversation_ref") :corpus "native")))
      (js-call (expect (countEvents f)) :toBe 0)
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
      (let ((denied (await (js-call f :call (nativeGet f "A") "message.recover" args))))
        (js-call (expect (nativeGet denied "ok")) :toBe false))
      (let* ((recovered (await (callOk f "O" "message.recover" args)))
        (reads (nativeGet (nativeGet f "recovery_state") "reads"))
        (again (await (callOk f "O" "message.recover" args))))
        (js-call (expect (nativeGet recovered "created_count")) :toBe 1)
        (js-call (expect (nativeGet recovered "realtime")) :toBe false)
        (js-call (expect (nativeGet again "recovery_id")) :toBe (nativeGet recovered "recovery_id"))
        (js-call (expect (nativeGet (nativeGet f "recovery_state") "reads")) :toBe reads)
        (let ((duplicate (await (callOk f "O" "message.recover" (Object/assign (js-object) args (js-object :idempotency_key "same-message-new-request"))))))
          (js-call (expect (nativeGet duplicate "created_count")) :toBe 0)))
      (await (turns f 4))
      (js-call (expect (countEvents f)) :toBe 1)
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
      (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 1)
      (let ((envelope (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") 0) "envelope")))
        (js-call (expect (nativeGet (nativeGet envelope "ingress_evidence") "kind")) :toBe "explicit_native_recovery")
        (js-call (expect (nativeGet envelope "reply_context_id")) :toBeTruthy)
        (await (callOk f "A" "delivery.complete" (js-object :delivery_id (nativeGet envelope "delivery_id") :reason "no_reply" :idempotency_key "no-reply")))
        (await (turns f 4))
        (js-call (expect (nativeGet (nativeGet f "marks") "size")) :toBe 0)
        (js-call (expect (nativeGet (await (callOk f "A" "delivery.working" (js-object :delivery_id (nativeGet envelope "delivery_id")))) "cleanup_state")) :toBe "done"))
      (let ((failed (await (js-call f :call (nativeGet f "O") "message.recover" (Object/assign (js-object) args
        (js-object :native_message_ids (js-array "another" "missing") :idempotency_key "no-partial"))))))
        (js-call (expect (nativeGet failed "ok")) :toBe false)
        (js-call (expect (countEvents f)) :toBe 1)))) closeFixture))
