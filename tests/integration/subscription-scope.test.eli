(module dj.tests.integration.subscription-scope
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defun openDb (f) (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
  (defasync setup () (await (createFixture "subscription-scope" "all" (js-object :configure (lambda (config ports)
    (put config :managed_profiles (js-array)) (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
    (Object/assign (aref (nativeGet config "connections") 0) (js-object :source_delivery "events" :event_app_id "cli_test" :event_subject_id "ou_self" :event_scope "all_authorized")))))))
  (defasync subscribe (f agent selector key)
    (let* ((spec (js-object :agent_id (nativeGet agent "agent_id") :selector selector))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec spec)))))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key key)))))
  (defun event (id chat thread text &optional sender)
    (let ((item (createdEvent "lark" id text thread)))
      (put (nativeGet item "conversation") :native_chat_id chat)
      (put item :addressed_self t)
      (when sender (put item :sender (js-object :id sender :kind "human"))) item))
  (withCase "T38.all-source-subscription.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (sub (await (subscribe f agent (js-object) "all-sources"))))
      (js-call (expect (js-length (nativeGet sub "resolved_sources"))) :toBe 2)
      (js-call (expect (js-call (nativeGet sub "resolved_sources") :every (lambda (source)
        (and (= (nativeGet source "scope") "connection") (= (nativeGet source "include_threads") t))))) :toBe t)
      (let ((policy (await (callOk f "O" "message.filter.get" (js-object)))))
        (await (callOk f "O" "message.filter.update" (js-object :expected_revision (nativeGet policy "revision") :idempotency_key "scope-blacklist"
          :rules (js-array (js-object :id "blocked-sender" :enabled t :effect "suppress_trigger" :predicate (js-object :field "sender.id" :op "eq" :value "blocked"))
            (js-object :id "blocked-text" :enabled t :effect "suppress_trigger" :predicate (js-object :field "text" :op "contains" :value "🚫")))))))
      (await (js-call f :ingest (event "new-group" "newGroup" nil "new group mention")))
      (await (js-call f :ingest (event "new-thread" "newGroup" "newThread" "thread mention")))
      (let ((dm (event "new-private" "newPrivate" nil "private mention"))) (put dm :chat_type "p2p") (await (js-call f :ingest dm)))
      (await (js-call f :ingest (event "blocked-sender" "newGroup" nil "still cached" "blocked")))
      (await (js-call f :ingest (event "blocked-text" "newPrivate" nil "🚫 still cached")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 3)
      (let ((db (openDb f)))
        (try (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM events") :get) "n")) :toBe 5)
          (finally (js-call db :close))))
      (await (js-call f :restart))
      (await (js-call f :ingest (event "after-restart" "anotherNewGroup" "anotherThread" "still all")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 4))) closeFixture)
  (withCase "T38.explicit-source-subscription.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (conversation (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (sub (await (subscribe f agent (js-object :sources (js-array (js-object :conversation_ref (nativeGet conversation "conversation_ref") :include_threads t))) "one-chat"))))
      (await (js-call f :ingest (event "inside" "c1" "t1" "inside thread")))
      (await (js-call f :ingest (event "outside" "otherChat" nil "outside")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1))) closeFixture))
