(module dj.tests.integration.opencode-live
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/host/bun/io.eli" createHostPorts)
  (import "../../src/adapters/agent/opencode-http.eli" createOpenCodePort)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk subscribe createdEvent)
  (import "node:fs/promises" readFile)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  ;; Explicit opt-in: the supplied private config names an existing native
  ;; desktop receiver. No new process, model default or arbitrary target.
  (defconst endpoint-file (nativeGet (nativeGet globalThis.process "env") "DJ_OPENCODE_ENDPOINT_FILE"))
  (defconst reuse-session (nativeGet (nativeGet globalThis.process "env") "DJ_OPENCODE_TEST_SESSION"))
  (when endpoint-file
    (withCase "T38.opencode-live-subscriber.integration"
      (async ()
        (let* ((endpoint (JSON/parse (await (readFile endpoint-file "utf8"))))
          (host (createHostPorts)) (port (createOpenCodePort (js-object :endpoints (js-array endpoint)) host))
          (ctx (js-object :deadline (+ (performance/now) 30000)))
          (observed (await (js-call port :probeInstance endpoint ctx))))
          (js-call (expect (nativeGet observed "state")) :toBe "ready")
          (put endpoint :instance_epoch (nativeGet observed "instance_epoch"))
          (let* ((created (if reuse-session (js-object :state "ready" :session
            (await (js-call port :probe (Object/assign (js-object) endpoint (js-object :native_session_id reuse-session)) endpoint ctx)))
            (await (js-call port :create endpoint (nativeGet endpoint "workspace_ref") "dj-live-models"
            (Object/assign (js-object) ctx (js-object :title "DJ 模型订阅接线验收"
              :model_selection (js-object :provider_id "commandcode" :model_id "deepseek/deepseek-v4.1-flash" :variant "high")))))))
            (session (nativeGet created "session")))
            (js-call (expect (nativeGet created "state")) :toBe "ready")
            (let ((f (await (createFixture "opencode-live-models" "one" (js-object :configure (lambda (config ports)
              (put config :managed_profiles (js-array))
              (put config :agent_endpoints (js-array endpoint))
              (put host :clock (nativeGet ports "clock"))
              (js-call (nativeGet ports "agent_ports") :set "opencode" port)
              (put (aref (nativeGet config "principals") 2) :target_constraint
                (js-object :tool "opencode" :native_namespace (nativeGet session "native_namespace")
                  :native_session_id (nativeGet session "native_session_id")))))))))
              (put f :live_session session) (put f :live_endpoint endpoint) (put f :live_port port) f))))
      (async (f)
        (let* ((session (nativeGet f "live_session"))
          (discovered (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "desktop-open"))))
          (candidate (js-call (nativeGet discovered "items") :find (lambda (item)
            (= (nativeGet item "native_session_id") (nativeGet session "native_session_id")))))
          (agent (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
            :display_name "DJ native model check" :binding_mode "existing" :recipient_principal_id "A" :idempotency_key "live-register"))))
          (subscription (await (subscribe f agent "lark"))))
          (js-call (expect (nativeGet (nativeGet (nativeGet subscription "subscriber") "model_selection") "model_id"))
            :toBe "deepseek/deepseek-v4.1-flash")
          (await (js-call f :ingest (createdEvent "lark" "native-model-reference"
            "仅供 DJ 接线验证。请读取此通知 recipient.model_selection，以一行回复 DJ_MODEL_REFERENCE_OK 与其中的 model_id。不要调用工具、外发 IM、派工或创建任务。")))
          (await (js-call f :tick))
          (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
            (try
              (let ((turns 0))
                (while (and (< turns 200) (= (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries WHERE state='accepted'") :get) "n") 0))
                  (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 50))))
                  (await (js-call f :tick)) (setq turns (1+ turns))))
              (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries WHERE state='accepted'") :get) "n")) :toBe 1)
              (let ((stored (JSON/parse (nativeGet (js-call (js-call db :query "SELECT payload FROM subscriptions LIMIT 1") :get) "payload"))))
                (js-call (expect (nativeGet (nativeGet (nativeGet stored "subscriber") "model_selection") "provider_id")) :toBe "commandcode"))
              (finally (js-call db :close))))
          (let* ((port (nativeGet f "live_port")) (deadline (+ (performance/now) 45000)) (found false) (page nil))
            (while (and (not found) (< (performance/now) deadline))
              (setq page (await (js-call port :readMessages session nil (js-object :max_records 30 :max_bytes 1048576)
                (js-object :deadline (+ (performance/now) 10000)))))
              (setq found (js-call (nativeGet page "items") :some (lambda (message)
                (and (= (nativeGet message "role") "assistant") (js-call (nativeGet message "text" "") :includes "DJ_MODEL_REFERENCE_OK")))))
              (unless found (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 500))))))
            (js-call (expect found) :toBe t)
            (js-call (expect (js-call (nativeGet page "items") :some (lambda (message)
              (and (= (nativeGet message "role") "user")
                (js-call (nativeGet message "text" "") :includes "model_selection")
                (js-call (nativeGet message "text" "") :includes "deepseek/deepseek-v4.1-flash"))))) :toBe t))))
      closeFixture)))
