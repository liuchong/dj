(module dj.tests.integration.agent
  (import "../../src/core/native.eli" nativeEncodeURIComponent nativeGet)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli"
    createFixture
    closeFixture
    callOk
    getSession
    bindRecipient)
  (import "../support/agent-protocol.eli"
    openCodeHarness
    channelHarness
    piProcessHarness
    closeHarness)
  (import "../support/process.eli" until)
  (import "../support/pi-receiver.eli" runPiReceiverFixture)
  (import "../../src/adapters/agent/pi-native.eli" createPiNativePort)
  (import "node:fs/promises" mkdir readFile rm)
  (import "node:os" homedir)
  (import "node:crypto" randomUUID)
  (defasync setup () (await (createFixture "agent" "one")))
  (withCase
    "T02.same-title.integration"
    setup
    (async
      (f)
      (let ((agent (await (bindRecipient f))))
        ;; Discovery consumes its own cursor buffer, never the adapter-owned catalog.
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "sessions"))) :toBe 2)
        (js-call (expect (nativeGet agent "native_session_id")) :toBe "s1")
        (js-call (expect (nativeGet agent "native_namespace")) :toBe "ns-opencode")
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "creates"))) :toBe 0)))
    closeFixture)
  (withCase
    "T07.busy-queue.integration"
    setup
    (async
      (f)
      (let*
        ((session (await (getSession f "s1")))
          (native (aref (nativeGet (nativeGet f "opencode") "sessions") 0)))
        (put native :runtime_state "busy")
        (await
          (callOk
            f
            "S"
            "session.send"
            (js-object
              :session_ref
              (nativeGet session "session_ref")
              :content
              (js-object :type "text" :text "queued")
              :idempotency_key
              "busy")))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
        (put native :runtime_state "waiting_permission")
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
        (put native :runtime_state "idle")
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)))
    closeFixture)
  (withCase
    "T10.no-native-dedup.integration"
    setup
    (async
      (f)
      (let* ((session (await (getSession f "s1"))) (peer (nativeGet f "opencode")))
        (put (nativeGet peer "behavior") :submit "throw")
        (let
          (
            (accepted
              (await
                (callOk
                  f
                  "S"
                  "session.send"
                  (js-object
                    :session_ref
                    (nativeGet session "session_ref")
                    :content
                    (js-object :type "text" :text "unknown")
                    :idempotency_key
                    "unknown")))))
          (await (js-call f :tick))
          (let
            (
              (delivery
                (await
                  (callOk
                    f
                    "S"
                    "delivery.get"
                    (js-object :delivery_id (nativeGet accepted "delivery_id"))))))
            (js-call (expect (nativeGet delivery "state")) :toBe "unknown")
            (let ((original-lookup (nativeGet peer "lookup")))
              (put
                peer
                :lookup
                (async
                  (binding key ref context)
                  (js-object
                    :state
                    "accepted"
                    :kind
                    "accepted"
                    :evidence_level
                    "native_protocol"
                    :dispatch_key
                    "mismatched-dispatch-key")))
              (await
                (callOk
                  f
                  "S"
                  "delivery.reconcile"
                  (js-object
                    :delivery_id
                    (nativeGet accepted "delivery_id")
                    :idempotency_key
                    "reconcile")))
              (await (js-call f :tick))
              (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                (try
                  (let
                    ((row
                        (js-call
                          (js-call
                            reader
                            :query
                            "SELECT state,json_extract(payload,'$.reconcile_requested') AS requested FROM deliveries WHERE delivery_id=?")
                          :get
                          (nativeGet accepted "delivery_id"))))
                    (js-call (expect (nativeGet row "state")) :toBe "unknown")
                    (js-call (expect (nativeGet row "requested")) :toBe 1))
                  (finally (js-call reader :close))))
              (put peer :lookup original-lookup)
              (await (js-call f :tick))
              (let ((reader (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
                (try
                  (let
                    ((row
                        (js-call
                          (js-call
                            reader
                            :query
                            "SELECT state,json_extract(payload,'$.reconcile_requested') AS requested FROM deliveries WHERE delivery_id=?")
                          :get
                          (nativeGet accepted "delivery_id"))))
                    (js-call (expect (nativeGet row "state")) :toBe "unknown")
                    (js-call (expect (nativeGet row "requested")) :toBe 0))
                  (finally (js-call reader :close)))))
            (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)))))
    closeFixture)
  (withCase
    "T50.exact-resolve.integration"
    setup
    (async
      (f)
      (let ((session (await (getSession f "s1"))))
        (put (aref (nativeGet (nativeGet f "opencode") "sessions") 0) :instance_epoch "epoch-2")
        (let
          (
            (result
              (await
                (js-call
                  f
                  :call
                  (nativeGet f "S")
                  "session.send"
                  (js-object
                    :session_ref
                    (nativeGet session "session_ref")
                    :content
                    (js-object :type "text" :text "stale")
                    :idempotency_key
                    "stale")))))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
          (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "starts"))) :toBe 0)
          (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "creates"))) :toBe 0))))
    closeFixture)
  (import "../../src/adapters/agent/pi-rpc.eli" createPiChannel)
  (withCase
    "T22.native-failure.integration"
    setup
    (async
      (f)
      (let* ((session (await (getSession f "s1"))) (peer (nativeGet f "opencode")))
        (put (aref (nativeGet peer "sessions") 0) :runtime_state "incompatible")
        (let
          (
            (result
              (await
                (js-call
                  f
                  :call
                  (nativeGet f "S")
                  "session.send"
                  (js-object
                    :session_ref
                    (nativeGet session "session_ref")
                    :content
                    (js-object :type "text" :text "never change model")
                    :idempotency_key
                    "incompatible")))))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
          (js-call (expect (js-length (nativeGet peer "starts"))) :toBe 0)
          (js-call (expect (js-length (nativeGet (nativeGet f "pi") "inputs"))) :toBe 0))))
    closeFixture)
  (withCase
    "T07.steer-disabled.integration"
    setup
    (async
      (f)
      (let*
        ((session (await (getSession f "s1")))
          (result
            (await
              (js-call
                f
                :call
                (nativeGet f "S")
                "session.send"
                (js-object
                  :session_ref
                  (nativeGet session "session_ref")
                  :content
                  (js-object :type "text" :text "no steer")
                  :delivery_policy
                  (js-object :busy "steer" :offline "hold" :ttl_seconds 60)
                  :idempotency_key
                  "steer-disabled")))))
        (js-call (expect (nativeGet (nativeGet result "error") "code")) :toBe "unsupported")
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)))
    closeFixture)
  (withCase
    "T69.frame-resync.integration"
    setup
    (async
      (f)
      (let*
        ((writes (js-array))
          (killed false)
          (clock (nativeGet f "clock"))
          (channel
            (createPiChannel
              (js-object
                :clock
                clock
                :write
                (lambda (value) (js-call writes :push value))
                :kill
                (lambda () (setq killed t)))
              (js-object :max_frame_bytes 1048576 :drain_timeout_ms 5000))))
        (js-call channel :feed (js-call "x" :repeat 1048577))
        (js-call
          (expect (nativeGet (js-call channel :status) "buffered_bytes"))
          :toBeLessThanOrEqual
          1048576)
        (js-call clock :advance 5001)
        (await (js-call channel :tick))
        (js-call (expect (nativeGet (js-call channel :status) "state")) :toBe "isolated")
        (let ((result (await (js-call channel :request "get_state" (js-object)))))
          (js-call (expect (nativeGet result "ok")) :toBe false))
        (js-call (expect (js-length writes)) :toBe 0)
        (js-call (expect killed) :toBe false)))
    closeFixture)
  (defun nativeEnvelope
    ()
    (js-object
      :schema_version
      1
      :kind
      "external_message"
      :allowed_actions
      (js-array)
      :origin
      "direct"
      :delivery_id
      "native-delivery"
      :content
      (js-object :type "text" :text "中文😀\u2028still one record\u2029")))
  (withCase
    "T16.opencode-204.integration"
    openCodeHarness
    (async
      (h)
      (let*
        ((port (nativeGet h "port"))
          (binding (nativeGet h "binding"))
          (ctx (nativeGet h "context"))
          (probe (await (js-call port :probe binding binding ctx))))
        (js-call (expect (nativeGet probe "runtime_state")) :toBe "idle")
        (let
          (
            (receipt
              (await
                (js-call
                  port
                  :submit
                  binding
                  (nativeEnvelope)
                  "start_idle"
                  "dispatch-native"
                  ctx))))
          (js-call (expect (nativeGet receipt "kind")) :toBe "accepted")
          (js-call (expect (nativeGet receipt "evidence_level")) :toBe "native_protocol")
          (let
            (
              (observed
                (await
                  (js-call
                    port
                    :observe
                    binding
                    (nativeGet receipt "native_ref")
                    nil
                    (js-object :max_records 100 :max_bytes 1048576)
                    ctx))))
            (js-call
              (expect
                (js-call
                  (nativeGet observed "items")
                  :some
                  (lambda
                    (item)
                    (js-call
                      (js-array "started" "completed" "settled")
                      :includes
                      (nativeGet item "kind")))))
              :toBe
              false)))
        (let*
          ((calls (nativeGet h "calls"))
            (input
              (js-call calls :filter (lambda (call) (= (nativeGet call "method") "POST"))))
            (request (aref input 0))
            (body (nativeGet request "body")))
          (js-call (expect (js-length input)) :toBe 1)
          (js-call
            (expect (nativeGet request "path"))
            :toBe
            (str
              "/session/"
              (nativeEncodeURIComponent (nativeGet binding "native_session_id"))
              "/prompt_async"))
          (js-call (expect (nativeGet request "authenticated")) :toBe t)
          (js-call
            (expect (nativeGet request "directory"))
            :toBe
            (nativeGet (nativeGet h "endpoint") "directory"))
          (js-call (expect (nativeGet body "model")) :toBeUndefined)
          (js-call (expect (nativeGet body "tools")) :toBeUndefined)
          (js-call (expect (nativeGet body "system")) :toBeUndefined)
          (js-call (expect (nativeGet body "agent")) :toBeUndefined)
          (js-call (expect (nativeGet (nativeGet h "state") "created")) :toBe 0))))
    closeHarness)
  (withCase
    "T51.opencode-empty-native.integration"
    openCodeHarness
    (async
      (h)
      (let*
        ((binding (nativeGet h "binding"))
          (instance
            (Object/assign (js-object) binding (js-object :ownership "existing")))
          (result
            (await
              (js-call
                (nativeGet h "port")
                :create
                instance
                "ws-native"
                "create-native"
                (nativeGet h "context")))))
        (js-call (expect (nativeGet result "state")) :toBe "ready")
        (js-call
          (expect (nativeGet (nativeGet result "session") "native_session_id"))
          :toBe
          "empty-1")
        (js-call (expect (nativeGet (nativeGet h "state") "created")) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet h "state") "native_inputs"))) :toBe 0)
        (js-call (expect (nativeGet (nativeGet h "state") "disposed")) :toBe 0)
        (let
          (
            (writes
              (js-call
                (nativeGet h "calls")
                :filter
                (lambda (call) (= (nativeGet call "method") "POST")))))
          (js-call (expect (js-length writes)) :toBe 1)
          (js-call (expect (nativeGet (aref writes 0) "path")) :toBe "/session"))))
    closeHarness)
  (withCase
    "T63.opencode-native-read.integration"
    openCodeHarness
    (async
      (h)
      (let*
        ((port (nativeGet h "port"))
          (ctx (nativeGet h "context"))
          (budget (js-object :max_records 100 :max_bytes 4194304))
          (sessions (await (js-call port :listSessions (js-object) nil budget ctx)))
          (session (aref (nativeGet sessions "items") 0))
          (messages (await (js-call port :readMessages session nil budget ctx))))
        (js-call
          (expect (nativeGet session "native_session_id"))
          :toBe
          (nativeGet (nativeGet h "binding") "native_session_id"))
        (js-call (expect (nativeGet session "native_namespace")) :toBe "native-project")
        (js-call
          (expect (nativeGet (aref (nativeGet messages "items") 0) "text"))
          :toBe
          "中文😀 native text")
        (let ((requests (js-array)) (native-id (nativeGet session "native_session_id")))
          (put (nativeGet h "state") :message_handler
            (async (url)
              (let* ((query (nativeGet url "searchParams"))
                     (n (js-call globalThis.Number :parseInt (js-call query :get "limit") 10))
                     (before (js-call query :get "before")))
                (js-call requests :push (js-object :limit n :before before))
                (if (> n 2)
                  (new globalThis.Response (js-call "x" :repeat 1048577))
                  (Response/json
                    (js-array (js-object :info (js-object :id (if before "older" "latest")
                      :sessionID native-id :role "assistant" :time (js-object :created 1767225600000))
                      :parts (js-array (js-object :type "text" :text (if before "older text" "latest text")))))
                    (js-object :headers (if before (js-object)
                      (js-object :x-next-cursor "opaque+/=older"))))))))
          (let* ((first (await (js-call port :readMessages session nil budget ctx)))
                 (cursor (nativeGet first "next_cursor"))
                 (second (await (js-call port :readMessages session cursor budget ctx))))
            (js-call (expect (nativeGet first "complete")) :toBe false)
            (js-call (expect (nativeGet cursor "before")) :toBe "opaque+/=older")
            (js-call (expect (nativeGet (aref (nativeGet first "items") 0) "text")) :toBe "latest text")
            (js-call (expect (nativeGet second "complete")) :toBe t)
            (js-call (expect (nativeGet (aref (nativeGet second "items") 0) "text")) :toBe "older text")
            (js-call (expect (nativeGet (aref requests 0) "limit")) :toBe 32)
            (js-call (expect (nativeGet (aref requests 4) "limit")) :toBe 2)
            (js-call (expect (nativeGet (aref requests 9) "before")) :toBe "opaque+/=older"))
          (put (nativeGet h "state") :message_handler
            (async (url) (new globalThis.Response (js-call "x" :repeat 1048577))))
          (let ((oversized (await (js-call port :readMessages session nil budget ctx))))
            (js-call (expect (js-length (nativeGet oversized "items"))) :toBe 0)
            (js-call (expect (nativeGet oversized "complete")) :toBe false)
            (js-call (expect (nativeGet oversized "coverage")) :toBe "partial")))
        (js-call
          (expect
            (js-call (nativeGet h "calls") :some (lambda (call) (= (nativeGet call "method") "POST"))))
          :toBe
          false)))
    closeHarness)
  (withCase
    "T10.opencode-native-response-loss.integration"
    openCodeHarness
    (async
      (h)
      (put (nativeGet h "state") :drop_after_accept t)
      (let
        (
          (result
            (await
              (js-call
                (nativeGet h "port")
                :submit
                (nativeGet h "binding")
                (nativeEnvelope)
                "start_idle"
                "lost-native-response"
                (nativeGet h "context")))))
        (js-call (expect (nativeGet result "state")) :toBe "unknown")
        (js-call (expect (nativeGet result "definite_not_sent")) :toBe false)
        (let
          (
            (lookup
              (await
                (js-call
                  (nativeGet h "port")
                  :lookup
                  (nativeGet h "binding")
                  "lost-native-response"
                  nil
                  (nativeGet h "context")))))
          (js-call (expect (nativeGet lookup "status")) :toBe "not_proven"))
        (js-call (expect (js-length (nativeGet (nativeGet h "state") "native_inputs"))) :toBe 1)
        (js-call (expect (nativeGet (nativeGet h "state") "created")) :toBe 0)))
    closeHarness)
  (withCase
    "T69.opencode-http-frame.integration"
    openCodeHarness
    (async
      (h)
      (put (nativeGet h "state") :oversized t)
      (let
        (
          (result
            (await
              (js-call
                (nativeGet h "port")
                :listSessions
                (js-object)
                nil
                (js-object :max_records 100 :max_bytes 4194304)
                (nativeGet h "context")))))
        (js-call (expect (nativeGet result "complete")) :toBe false)
        (js-call (expect (nativeGet result "coverage")) :toBe "partial")
        (js-call (expect (js-length (nativeGet result "items"))) :toBe 0)
        (js-call (expect (nativeGet (nativeGet h "state") "disposed")) :toBe 0)
        (js-call
          (expect
            (js-call (nativeGet h "calls") :some (lambda (call) (= (nativeGet call "method") "POST"))))
          :toBe
          false)))
    closeHarness)
  (defasync nextCommand
    (h count)
    (await
      (until
        "native command write"
        (lambda () (>= (js-length (nativeGet h "writes")) count))
        1000))
    (JSON/parse (aref (nativeGet h "writes") (1- count))))
  (withCase
    "T69.pi-jsonl-correlation.integration"
    channelHarness
    (async
      (h)
      (let*
        ((channel (nativeGet h "channel"))
          (first (js-call channel :request "get_state" (js-object) (nativeGet h "context")))
          (a (await (nextCommand h 1)))
          (second
            (js-call channel :request "get_messages" (js-object) (nativeGet h "context")))
          (b (await (nextCommand h 2))))
        (js-call (expect (= (nativeGet a "id") (nativeGet b "id"))) :toBe false)
        (js-call h :reply b (js-object :messages (js-array)))
        (js-call channel :feed "{\"type\":\"agent_start\"}\n")
        (js-call h :reply a (js-object :sessionId "exact-native-id" :isStreaming false))
        (js-call
          (expect (nativeGet (nativeGet (await first) "data") "sessionId"))
          :toBe
          "exact-native-id")
        (js-call
          (expect (nativeGet (nativeGet (await second) "data") "messages"))
          :toEqual
          (js-array))
        (js-call
          (expect (nativeGet (aref (js-call channel :drainEvents) 0) "type"))
          :toBe
          "agent_start")
        (js-call (expect (js-length (nativeGet h "kills"))) :toBe 0)))
    (lambda (h) nil))
  (withCase
    "T69.pi-utf8-lf.integration"
    channelHarness
    (async
      (h)
      (let*
        ((channel (nativeGet h "channel"))
          (text "中文😀\u2028one record\u2029")
          (pending
            (js-call
              channel
              :request
              "prompt"
              (js-object :message text)
              (nativeGet h "context")))
          (command (await (nextCommand h 1)))
          (wire
            (js-call
              (new globalThis.TextEncoder)
              :encode
              (str
                (JSON/stringify
                  (js-object
                    :id
                    (nativeGet command "id")
                    :type
                    "response"
                    :command
                    "prompt"
                    :success
                    t
                    :data
                    (js-object :disposition "handled" :echo text)))
                "\r\n"))))
        (js-call (expect (nativeGet command "message")) :toBe text)
        (let ((offset 0))
          (while (< offset (js-length wire))
            (js-call channel :feed (js-call wire :subarray offset (1+ offset)))
            (setq offset (1+ offset))))
        (let ((result (await pending)))
          (js-call (expect (nativeGet result "ok")) :toBe t)
          (js-call (expect (nativeGet (nativeGet result "data") "echo")) :toBe text)
          (js-call (expect (nativeGet (nativeGet result "data") "disposition")) :toBe "handled"))
        (js-call (expect (js-length (js-call channel :drainEvents))) :toBe 0)))
    (lambda (h) nil))
  (js-call
    (js-array "started" "queued" "handled")
    :forEach
    (lambda
      (disposition)
      (withCase
        (str "T16.pi-native-disposition.integration." disposition)
        piProcessHarness
        (async
          (h)
          (put (nativeGet h "state") :disposition disposition)
          (let*
            ((port (nativeGet h "port"))
              (ctx (nativeGet h "context"))
              (started
                (await (js-call port :start (nativeGet h "profile") "native-pi-token" ctx)))
              (session (nativeGet started "initial_session"))
              (receipt
                (await
                  (js-call
                    port
                    :submit
                    session
                    (nativeEnvelope)
                    "start_idle"
                    "native-pi-input"
                    ctx))))
            (js-call
              (expect (nativeGet session "native_session_id"))
              :toBe
              "native-pi-session")
            (js-call (expect (nativeGet receipt "kind")) :toBe "accepted")
            (js-call (expect (nativeGet receipt "disposition")) :toBe disposition)
            (js-call (expect (nativeGet receipt "evidence_level")) :toBe "native_protocol")
            (when (= disposition "handled")
              (let
                (
                  (observed
                    (await
                      (js-call
                        port
                        :observe
                        session
                        (nativeGet receipt "native_ref")
                        nil
                        (js-object :max_records 100 :max_bytes 1048576)
                        ctx))))
                (js-call
                  (expect
                    (js-call
                      (nativeGet observed "items")
                      :some
                      (lambda
                        (item)
                        (js-call
                          (js-array "started" "completed" "settled")
                          :includes
                          (nativeGet item "kind")))))
                  :toBe
                  false)))
            (let ((commands (nativeGet h "commands")))
              (js-call
                (expect
                  (js-length
                    (js-call commands :filter (lambda (c) (= (nativeGet c "type") "prompt")))))
                :toBe
                1)
              (js-call
                (expect
                  (js-call
                    commands
                    :some
                    (lambda
                      (c)
                      (js-call
                        (js-array "set_model" "new_session" "steer" "abort")
                        :includes
                        (nativeGet c "type")))))
                :toBe
                false))
            (js-call (expect (js-length (nativeGet h "spawns"))) :toBe 1)
            (js-call (expect (js-length (nativeGet h "kills"))) :toBe 0)))
        closeHarness)))
  (withCase
    "T16.pi-end-before-settled.integration"
    piProcessHarness
    (async
      (h)
      (let*
        ((port (nativeGet h "port"))
          (ctx (nativeGet h "context"))
          (started (await (js-call port :start (nativeGet h "profile") "pi-events" ctx)))
          (session (nativeGet started "initial_session")))
        (put (nativeGet h "state") :streaming t)
        (js-call h :emit (js-object :type "agent_start"))
        (js-call
          h
          :emit
          (js-object :type "agent_end" :messages (js-array) :willRetry t))
        (let
          (
            (observed (await (until "Pi native ended event"
 (async () (let ((batch (await (js-call
                  port
                  :observe
                  session
                  nil
                  nil
                  (js-object :max_records 100 :max_bytes 1048576)
                  ctx))))
