  (withCase "T63.pi-existing-receiver.integration"
    (async ()
      (let* ((root (resolve (homedir) ".dj" (str "pit-" (js-call (randomUUID) :slice 0 8))))
             (child nil) (f nil))
        (await (mkdir root (js-object :recursive t :mode 448)))
        (try
          (setq child (Bun/spawn (js-array "node" "dist-tests/tests/support/pi-receiver.mjs")
            (js-object :env (Object/assign (js-object) (nativeGet globalThis.process "env")
              (js-object :DJ_PI_FIXTURE_ROOT root)) :stdin "pipe" :stdout "ignore" :stderr "pipe")))
          (let ((ready (await (until "Node Pi SDK receiver ready" (async ()
            (try (JSON/parse (await (readFile (resolve root "ready.json") "utf8"))) (catch pending nil))) 5000))))
            (setq f (await (createFixture "pi-existing-receiver" "native"
              (js-object :root (resolve ".local" (str "pn-" (js-call (randomUUID) :slice 0 8)))
                :configure (lambda (config ports)
                  (put config :managed_profiles (js-array)) (put config :connections (js-array))
                  (put config :agent_endpoints (js-array (js-object :tool "pi" :instance_id "pi-live"
                    :native_namespace "pi-local" :ownership "existing" :endpoint_ref "pi-receiver"
                    :workspace_ref "ws-test" :manifest_path (nativeGet ready "manifest")
                    :directory (js-call globalThis.process :cwd))))
                  (js-call (nativeGet ports "agent_ports") :delete "pi"))))))
            (put f :receiver_root root) (put f :receiver_child child)
            (put f :receiver_manifest (nativeGet ready "manifest"))
            f)
          (catch error
            (when child (js-call child :kill) (await (nativeGet child "exited")))
            (when f (await (closeFixture f)))
            (await (rm root (js-object :recursive t :force t))) (throw error)))))
    (async (f)
      (let* ((config (nativeGet f "config")) (ports (nativeGet f "ports"))
             (endpoint (js-object :tool "pi" :instance_id "pi-live" :native_namespace "pi-local"
               :ownership "existing" :endpoint_ref "pi-receiver" :workspace_ref "ws-test"
               :manifest_path (nativeGet f "receiver_manifest") :directory (js-call globalThis.process :cwd))))
        (js-call (expect (nativeGet (nativeGet f "config") "managed_profiles")) :toEqual (js-array))
        (let* ((resolved (await (callOk f "O" "session.resolve"
                           (js-object :instance_id "pi-live" :native_session_id "pi-original-session"))))
               (probe (await (callOk f "O" "session.probe" (js-object :session_ref (nativeGet resolved "session_ref")))))
               (input (js-object :session_ref (nativeGet resolved "session_ref") :idempotency_key "pi-exact-once"
                 :content (js-object :type "text" :text "Pi original target 中文😀")))
               (sent (await (callOk f "O" "session.send" input))))
          (js-call (expect (nativeGet resolved "native_session_id")) :toBe "pi-original-session")
          (js-call (expect (nativeGet probe "runtime_state")) :toBe "idle")
          (await (until "Pi original native delivery accepted" (async ()
            (await (js-call f :tick))
            (let ((delivery (await (callOk f "O" "delivery.get"
                              (js-object :delivery_id (nativeGet sent "delivery_id"))))))
              (= (nativeGet delivery "state") "accepted"))) 5000))
          (let* ((replay (await (callOk f "O" "session.send" input)))
                 (delivery (await (callOk f "O" "delivery.get" (js-object :delivery_id (nativeGet sent "delivery_id")))))
                 (inputs (JSON/parse (await (readFile (resolve (nativeGet f "receiver_root") "inputs.json") "utf8")))))
            (js-call (expect (nativeGet replay "delivery_id")) :toBe (nativeGet sent "delivery_id"))
            (js-call (expect (nativeGet delivery "state")) :toBe "accepted")
            (js-call (expect (js-length inputs)) :toBe 1)
            (js-call (expect (nativeGet (nativeGet (JSON/parse (aref inputs 0)) "content") "text")) :toBe "Pi original target 中文😀"))
          (let* ((port (createPiNativePort (js-object :endpoints (js-array endpoint)) ports))
                 (ctx (lambda () (js-object :deadline (+ (performance/now) 3000))))
                 (page (await (js-call port :listSessions (js-object) nil (js-object :max_records 1) (funcall ctx))))
                 (target (aref (nativeGet page "items") 0))
                 (messages (await (js-call port :readMessages target nil
                   (js-object :max_records 1 :max_bytes 524288) (funcall ctx))))
                 (next (await (js-call port :readMessages target (nativeGet messages "next_cursor")
                   (js-object :max_records 32 :max_bytes 524288) (funcall ctx)))))
            (js-call (expect (nativeGet target "live_receiver")) :toBe t)
            (js-call (expect (nativeGet (aref (nativeGet messages "items") 0) "native_message_id")) :toBe "pi-native-user")
            (js-call (expect (nativeGet messages "coverage")) :toBe "partial")
            (js-call (expect (nativeGet messages "complete")) :toBe false)
            (js-call (expect (nativeGet next "complete")) :toBe t)
            (js-call (expect (nativeGet (aref (nativeGet next "items") 0) "native_message_id")) :toBe "pi-native-answer")
            (let ((bad (Object/assign (js-object) target (js-object :native_session_id "other-session"))))
              (await (js-call (nativeGet (expect (js-call port :probe bad bad (funcall ctx))) "rejects") :toThrow)))
            (await (js-call port :close))))))
    (async (f)
      (when f
        (await (closeFixture f))
        (let ((child (nativeGet f "receiver_child")))
          (js-call (nativeGet child "stdin") :write "stop\n")
          (js-call (nativeGet child "stdin") :end)
          (js-call (expect (await (nativeGet child "exited"))) :toBe 0))
        (await (rm (nativeGet f "receiver_root") (js-object :recursive t :force t))))))

