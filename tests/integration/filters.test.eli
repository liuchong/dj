(module dj.tests.integration.filters
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent)
  (import "../support/faults.eli" atFault)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "message-filters" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (js-call (nativeGet (aref (nativeGet config "principals") 2) "grants") :push
        (js-object :action "subscription.consume" :resources (js-array "self"))))))))
  (defun rule (id predicate)
    (js-object :id id :enabled t :effect "suppress_trigger" :predicate predicate))
  (defasync setRules (f rules)
    (let ((current (await (callOk f "O" "message.filter.get" (js-object)))))
      (await (callOk f "O" "message.filter.update" (js-object :rules rules
        :expected_revision (nativeGet current "revision") :idempotency_key (str "filters-" (randomUUID)))))))
  (defun event (id text sender)
    (let ((item (createdEvent "lark" id text)))
      (put item :sender (js-object :id sender :kind "human")) item))
  (defun openDb (f) (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
  (defasync visibleMessages (f)
    (let ((source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil)))))
      (nativeGet (await (callOk f "A" "message.list" (js-object :conversation_ref (nativeGet source "conversation_ref")))) "items")))
  (withCase "T38.message-filters.integration" setup (async (f)
    (let* ((initial (await (callOk f "O" "message.filter.get" (js-object))))
      (rules (js-array
        (rule "people" (js-object :all (js-array
          (js-object :field "connection_id" :op "eq" :value "lark")
          (js-object :field "sender.id" :op "in" :value (js-array "blocked-person")))))
        (rule "characters" (js-object :all (js-array
          (js-object :any (js-array (js-object :field "text" :op "contains" :value "🚫")
            (js-object :field "text" :op "contains" :value "屏蔽词")))
          (js-object :not (js-object :field "sender.id" :op "eq" :value "exception-person")))))))
      (key (str "policy-" (randomUUID))) (db nil))
      (js-call (expect (nativeGet initial "revision")) :toBe 1)
      (js-call (expect (nativeGet initial "rules")) :toEqual (js-array))
      (let ((denied (await (js-call f :call (nativeGet f "A") "message.filter.update"
        (js-object :expected_revision 1 :rules rules :idempotency_key "not-authorized")))))
        (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden"))
      (let* ((args (js-object :expected_revision 1 :rules rules :idempotency_key key))
        (saved (await (callOk f "O" "message.filter.update" args)))
        (again (await (callOk f "O" "message.filter.update" args))))
        (js-call (expect (nativeGet saved "revision")) :toBe 2)
        (js-call (expect (nativeGet again "revision")) :toBe 2))
      (let ((stale (await (js-call f :call (nativeGet f "O") "message.filter.update"
        (js-object :expected_revision 1 :rules (js-array) :idempotency_key "stale-policy")))))
        (js-call (expect (nativeGet (nativeGet stale "error") "code")) :toBe "revision_conflict"))
      (await (js-call f :restart))
      (js-call (expect (nativeGet (await (callOk f "O" "message.filter.get" (js-object))) "rules")) :toEqual rules)
      (let ((agent (await (bindRecipient f)))) (await (subscribe f agent "lark")))
      (await (js-call f :ingest (event "blocked-author" "关键词仍可查询" "blocked-person")))
      (await (js-call f :ingest (event "blocked-content" "正文🚫仍然记录" "other")))
      (await (js-call f :ingest (event "exception" "屏蔽词例外仍能触发" "exception-person")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
      (setq db (openDb f))
      (try
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM events") :get) "n")) :toBe 3)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM match_decisions WHERE payload LIKE '%trigger_suppressed%'") :get) "n")) :toBe 2)
        (finally (js-call db :close)))
      (let ((messages (await (visibleMessages f))))
        (js-call (expect (js-length messages)) :toBe 3)
        (js-call (expect (js-call messages :some (lambda (m) (= (nativeGet m "native_message_id") "blocked-author")))) :toBe t)
        (js-call (expect (js-call messages :some (lambda (m) (= (nativeGet m "native_message_id") "blocked-content")))) :toBe t)
        (let* ((blocked (js-call messages :find (lambda (m) (= (nativeGet m "native_message_id") "blocked-author"))))
          (body (await (callOk f "A" "message.get" (js-object :event_id (nativeGet blocked "event_id"))))))
          (js-call (expect (nativeGet body "text")) :toBe "关键词仍可查询")))
      (await (setRules f (js-array)))
      (await (js-call f :ingest (event "unblocked-new" "正文🚫" "blocked-person")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2))) closeFixture)
  (withCase "T31.message-filter-cutover.integration" setup (async (f)
    (let* ((peer (nativeGet f "opencode")) (session (aref (nativeGet peer "sessions") 0))
      (agent (await (bindRecipient f))) (db nil))
      (await (subscribe f agent "lark"))
      (put session :runtime_state "busy")
      (await (js-call f :ingest (event "queued" "排队消息仍可读" "blocked-person")))
      (await (js-call f :tick))
      (await (setRules f (js-array (rule "people" (js-object :field "sender.id" :op "eq" :value "blocked-person")))))
      (put session :runtime_state "idle")
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
      (setq db (openDb f))
      (try (let ((row (js-call (js-call db :query "SELECT state,json_extract(payload,'$.blocked_reason') AS reason FROM deliveries LIMIT 1") :get)))
          (js-call (expect (nativeGet row "state")) :toBe "cancelled")
          (js-call (expect (nativeGet row "reason")) :toBe "trigger_suppressed"))
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM claims") :get) "n")) :toBe 0)
        (finally (js-call db :close)))
      (await (setRules f (js-array)))
      (atFault (nativeGet f "faults") "delivery.after_submitting_before_write" (async (data)
        (await (setRules f (js-array (rule "chars" (js-object :field "text" :op "contains" :value "BLOCK")))))))
      (await (js-call f :ingest (event "already-submitting" "BLOCK" "ordinary")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)
      (await (js-call f :ingest (event "blocked-later" "BLOCK" "ordinary")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 1)
      (await (callOk f "O" "session.send" (js-object :agent_id (nativeGet agent "agent_id")
        :content (js-object :type "text" :text "BLOCK explicit direct input") :idempotency_key "explicit-filter-bypass")))
      (await (js-call f :tick))
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 2)
      (js-call (expect (js-length (await (visibleMessages f)))) :toBe 3))) closeFixture)
  (withCase "T40.message-filter-pull.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f)))
      (source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object
        :agent_id (nativeGet agent "agent_id") :selector (js-object :sources (js-array
          (js-object :conversation_ref (nativeGet source "conversation_ref") :include_threads false))
          :event_kinds (js-array "message.created")) :predicate (js-object :all (js-array))
        :delivery_mode "pull" :start "now")))))
      (sub (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "filter-pull-sub"))))
      (db nil))
      (await (js-call f :ingest (event "pull-pending" "待领取内容" "blocked-person")))
      (await (js-call f :tick))
      (await (setRules f (js-array (rule "people" (js-object :field "sender.id" :op "eq" :value "blocked-person")))))
      (let ((pulled (await (callOk f "A" "subscription.pull" (js-object :subscription_id (nativeGet sub "subscription_id") :idempotency_key "suppressed-pull")))))
        (js-call (expect (nativeGet pulled "empty")) :toBe t))
      (setq db (openDb f))
      (try (js-call (expect (nativeGet (js-call (js-call db :query "SELECT state FROM inbox_entries LIMIT 1") :get) "state")) :toBe "suppressed")
        (finally (js-call db :close)))
      (await (setRules f (js-array)))
      (await (js-call f :ingest (event "claimed-before-change" "KEEP already claimed" "ordinary")))
      (await (js-call f :tick))
      (let* ((args (js-object :subscription_id (nativeGet sub "subscription_id") :idempotency_key "claimed-pull"))
        (pulled (await (callOk f "A" "subscription.pull" args))) (item (nativeGet pulled "item")))
        (js-call (expect (nativeGet item "envelope")) :toBeDefined)
        (await (setRules f (js-array (rule "chars" (js-object :field "text" :op "contains" :value "KEEP")))))
        (let ((again (await (callOk f "A" "subscription.pull" args))))
          (js-call (expect (nativeGet (nativeGet again "item") "envelope")) :toEqual (nativeGet item "envelope")))
        (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet item "claim_ref")
          :disposition "consumed" :idempotency_key "ack-still-visible"))))
      (await (js-call f :ingest (event "pull-block-at-match" "KEEP not a new trigger" "ordinary")))
      (await (js-call f :tick))
      (js-call (expect (js-length (await (visibleMessages f)))) :toBe 3)
      (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0))) closeFixture))
