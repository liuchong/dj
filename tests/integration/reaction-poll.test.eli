(module dj.tests.integration.reaction-poll
  (import "../../src/core/native.eli" nativeGet NativeGlobal nativeSetTimeout)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../../packages/lark/src/wire.eli" encodeLarkFrame)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "../support/case.eli" withCase)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (import "bun:test" expect)
  (defconst receiverFactory (js-object))
  (defun receiver (address) (funcall (nativeGet receiverFactory "make") address))
  (defasync advance (f count &optional milliseconds)
    (let ((i 0)) (while (< i count)
      (js-call (nativeGet f "clock") :advance (or milliseconds 1000))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done (if (or (nil? milliseconds) (>= milliseconds 1000)) 30 5)))))
      (js-call (expect (nativeGet (await (js-call f :tick)) "ok")) :toBe t)
      (setq i (1+ i)))))
  (defasync setup ()
    (let* ((old NativeGlobal.WebSocket) (clock nil) (state (js-object :records (js-array) :reads 0 :read_times (js-array) :socket nil :per_message (new globalThis.Map) :queried (js-array) :hold_messages false :release_messages nil)))
      (put receiverFactory :make (lambda (address)
        (let ((socket (new globalThis.EventTarget)))
          (put socket :readyState 1) (put socket :send (lambda (bytes) nil))
          (put socket :close (lambda (&rest args) (put socket :readyState 3) (js-call socket :dispatchEvent (new globalThis.Event "close"))))
          (put state :socket socket)
          (nativeSetTimeout (lambda () (js-call socket :dispatchEvent (new globalThis.Event "open"))) 0) socket)))
      (put NativeGlobal :WebSocket receiver)
      (try
        (let ((f (await (createFixture "reaction-poll" "http" (js-object :before_restart (lambda (config ports)
          (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort (aref (nativeGet config "connections") 0) ports)))
          :configure (lambda (config ports)
          (setq clock (nativeGet ports "clock"))
          (put config :managed_profiles (js-array))
          (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
          (let ((connection (aref (nativeGet config "connections") 0)))
            (Object/assign connection (js-object :source_delivery "events" :event_scope "all_authorized"
              :reaction_poll (js-object :recent_messages 4)
              :event_app_id "cli_test" :event_subject_id "ou_self" :user_identity (js-object :app_id "cli_test" :open_id "ou_self")))
            (put ports :credentials (js-object :resolve (lambda (ref) (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "fixture"))))
            (put ports :http (js-object :fetch (async (address options)
              (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname")) (method (nativeGet options "method" "GET")))
                (cond
                  ((js-call path :endsWith "/ws/endpoint")
                    (Response/json (js-object :code 0 :data (js-object :URL "wss://fixture.larksuite.com/ws?service_id=1" :ClientConfig (js-object :PingInterval 90)))))
                  ((js-call path :endsWith "/authen/v1/user_info") (Response/json (js-object :code 0 :data (js-object :open_id "ou_self"))))
                  ((js-call path :endsWith "/reactions")
                    (if (= method "GET")
                      (progn (put state :reads (1+ (nativeGet state "reads")))
                        (js-call (nativeGet state "read_times") :push (Date/parse (js-call clock :utcNow)))
                        (js-call (nativeGet state "queried") :push (aref (js-call path :split "/") 5))
                        (Response/json (js-object :code 0 :data (js-object :items (if (js-call (nativeGet url "searchParams") :has "reaction_type")
                          (js-array) (or (js-call (nativeGet state "per_message") :get (aref (js-call path :split "/") 5))
                            (if (= (aref (js-call path :split "/") 5) "original") (nativeGet state "records") (js-array)))) :has_more false))))
                      (Response/json (js-object :code 0 :data (js-object :reaction_id "fixture-working" :action_time (str (Date/parse (js-call clock :utcNow))))))))
                  ((and (= path "/open-apis/search/v2/message") (nativeGet state "hold_messages"))
                    (await (new globalThis.Promise (lambda (done)
                      (put state :release_messages (lambda ()
                        (done (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false))))))))))
                  ((= method "DELETE") (Response/json (js-object :code 0 :data (js-object))))
                  (t (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false)))))))))
            (js-call (nativeGet ports "im_ports") :set "lark" (createLarkEventPort connection ports)))))))))
          (put f :reaction_poll_state state) (put f :old_socket old) f)
        (catch error (put NativeGlobal :WebSocket old) (throw error)))))
  (defasync cleanup (f)
    (when (nativeGet (nativeGet f "reaction_poll_state") "release_messages")
      (funcall (nativeGet (nativeGet f "reaction_poll_state") "release_messages")))
    (try (await (closeFixture f)) (finally (put NativeGlobal :WebSocket (nativeGet f "old_socket")))))
  (defun record (time) (js-object :reaction_id "native-pin" :action_time time
    :reaction_type (js-object :emoji_type "Pin") :operator (js-object :operator_type "user" :operator_id "ou_self")))
  (withCase "T41.reaction-poll.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (state (nativeGet f "reaction_poll_state"))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec (js-object :agent_id (nativeGet agent "agent_id")
        :selector (js-object :event_kinds (js-array "message.reaction.added"))
        :predicate (js-object :field "reaction.emoji_type" :op "eq" :value "Pin"))))))
      (sub (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "reaction-poll"))))
      (inputs (nativeGet (nativeGet f "opencode") "inputs"))
      (old-time (str (- (Date/parse (js-call (nativeGet f "clock") :utcNow)) 1))) (time nil))
      (put state :records (js-array (record old-time)))
      (await (js-call f :ingest (createdEvent "lark" "original" "Human message without any mention")))
      (await (advance f 8))
      (js-call (expect (> (nativeGet state "reads") 0)) :toBe t)
      (js-call (expect (js-length inputs)) :toBe 0)
      (setq time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))
      (put state :records (js-array (record time)))
      (await (advance f 10))
      (js-call (expect (js-length inputs)) :toBe 1)
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
        (try
          (let ((event (JSON/parse (nativeGet (js-call (js-call db :query "SELECT payload FROM events WHERE event_kind='message.reaction.added'") :get) "payload"))))
            (js-call (expect (nativeGet event "receive_transport")) :toBe "poll")
            (js-call (expect (nativeGet (nativeGet event "reaction") "native_reaction_id")) :toBe "native-pin")
            (js-call (expect (nativeGet (nativeGet event "reaction") "native_event_id")) :toBe ""))
          (finally (js-call db :close))))
      ;; The real WebSocket framing path sees the same native action, not a second task.
      (js-call (nativeGet state "socket") :dispatchEvent (new globalThis.MessageEvent "message" (js-object :data
        (encodeLarkFrame (js-object :service 1 :method 1 :headers (js-array
          (js-object :key "type" :value "event") (js-object :key "message_id" :value "wire-pin")
          (js-object :key "sum" :value "1") (js-object :key "seq" :value "0"))
          :payload (Buffer/from (JSON/stringify (js-object :header (js-object :event_id "pushed-pin" :app_id "cli_test" :event_type "im.message.reaction.created_v1")
            :event (js-object :message_id "original" :reaction_type (js-object :emoji_type "Pin")
              :operator_type "user" :user_id (js-object :open_id "ou_self") :action_time time)))))))))
      (await (advance f 6))
      (js-call (expect (js-length inputs)) :toBe 1)
      (await (js-call f :restart))
      (await (advance f 8))
      (js-call (expect (js-length inputs)) :toBe 1)
      (setq time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))
      (put state :records (js-array (record time)))
      (await (advance f 8))
      (js-call (expect (js-length inputs)) :toBe 2)
      ;; Hundreds of retained candidates no longer determine a new message's wait.
      ;; The real Core/cache/checkpoints run; only native HTTP/WS are substituted.
      (put state :records (js-array))
      (let ((i 0)) (while (< i 80)
        (await (js-call f :ingest (createdEvent "lark" (str "archive-" i) "ordinary cached message")))
        (setq i (1+ i))))
      (await (advance f 270))
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
        (try
          (js-call db :run "UPDATE events SET payload=json_set(payload,'$.identity_revision',999) WHERE native_message_id='archive-0'")
          (finally (js-call db :close))))
      (put state :queried (js-array))
      (put state :hold_messages t)
      (setq time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))
      (js-call (nativeGet state "per_message") :set "priority" (js-array (record time)))
      (await (js-call f :ingest (createdEvent "lark" "priority" "new message with Pin")))
      (await (advance f 60 100))
      (js-call (expect (js-call (nativeGet state "queried") :includes "priority")) :toBe t)
      (js-call (expect (js-length inputs)) :toBe 3)
      (js-call (expect (nativeGet state "release_messages")) :toBeTruthy)
      ;; A later reaction is detected by the recent lane, not only the first read.
      (setq time (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))
      (js-call (nativeGet state "per_message") :set "priority" (js-array (record time)))
      (await (advance f 160 100))
      (js-call (expect (js-length inputs)) :toBe 4)
      (put state :hold_messages false)
      (funcall (nativeGet state "release_messages"))
      (await (advance f 3))
      ;; Original is outside the four-message recent set. A later mark must
      ;; still reach the same recipient through the fair archive sweep.
      (put state :records (js-array (record (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))))
      (await (advance f 300))
      (js-call (expect (js-length inputs)) :toBe 5)
      (js-call (expect (js-call (nativeGet state "queried") :includes "archive-0")) :toBe false)
      ;; A known old message is now followed by the engaged lane, outside recent.
      (let ((before (nativeGet state "reads")))
        (put state :records (js-array))
        (await (advance f 30 100))
        (put state :records (js-array (record (str (Date/parse (js-call (nativeGet f "clock") :utcNow))))))
        (await (advance f 160 100))
        (js-call (expect (js-length inputs)) :toBe 6)
        (js-call (expect (> (nativeGet state "reads") before)) :toBe t))
      (let ((times (nativeGet state "read_times")) (i 1))
        (while (< i (js-length times))
          (js-call (expect (>= (- (aref times i) (aref times (1- i))) 100)) :toBe t)
          (setq i (1+ i))))
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
        (try
          (let ((before (nativeGet (js-call (js-call db :query
            "SELECT generation FROM poll_checkpoints WHERE conversation_key='inbox:reaction-new'") :get) "generation")))
            (await (advance f 12))
            (js-call (expect (nativeGet (js-call (js-call db :query
              "SELECT generation FROM poll_checkpoints WHERE conversation_key='inbox:reaction-new'") :get) "generation")) :toBe before))
          (finally (js-call db :close))))
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
        (try
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM poll_checkpoints WHERE json_extract(payload,'$.kind')='reactions'") :get) "n")) :toBe 4)
          (js-call (expect (nativeGet (js-call (js-call db :query
            "SELECT COUNT(*) AS n FROM poll_checkpoints WHERE conversation_key='inbox:reactions' AND generation>10") :get) "n")) :toBe 1)
          (finally (js-call db :close)))))) cleanup))
