(module dj.tests.integration.mcp-http
  (import "../../src/core/native.eli" nativeGet nativeFetch)
  (import "../../src/core/errors.eli" success failure)
  (import "../../src/application/operations.eli" operationCatalogDigest)
  (import "../../src/interfaces/mcp-http.eli" startMcpHttp)
  (import "bun:test" expect)
  (import "../support/case.eli" withCase)

  (defasync post (url token method id params &optional session)
    (let ((headers (js-object :accept "application/json, text/event-stream" :content-type "application/json")))
      (when token (put headers :authorization (str "Bearer " token)))
      (when session (put headers :mcp-session-id session))
      (await (nativeFetch url (js-object :method "POST" :headers headers
        :body (JSON/stringify (js-object :jsonrpc "2.0" :method method :id id :params params)))))))

  (withCase "T55.mcp-http-reconnect.integration" (lambda () nil)
    (async (unused)
      (let* ((core (js-object :transportState (lambda () "ready")
        :authenticate (lambda (token)
          (if (js-call (js-array "alpha" "beta") :includes token)
            (success (js-object :principal_id token :authorization_revision 1))
            (failure "unauthenticated")))
        :execute (async (actor operation args)
          (success (js-object :operation_catalog_digest operationCatalogDigest :visible_operations (js-array "service.status"))))))
        (mcp (startMcpHttp core 0))
        (url (str "http://127.0.0.1:" (nativeGet mcp "port") "/mcp"))
        (init (js-object :protocolVersion "2025-11-25" :capabilities (js-object)
          :clientInfo (js-object :name "fixture" :version "test"))))
        (try
          (let* ((denied (await (post url nil "initialize" 1 init)))
            (first (await (post url "alpha" "initialize" 2 init)))
            (id (js-call (nativeGet first "headers") :get "mcp-session-id"))
            (cross (await (post url "beta" "tools/list" 3 (js-object) id)))
            (listed (await (post url "alpha" "tools/list" 4 (js-object) id)))
            (tools (nativeGet (nativeGet (await (js-call listed :json)) "result") "tools"))
            (second (await (post url "alpha" "initialize" 5 init)))
            (new-id (js-call (nativeGet second "headers") :get "mcp-session-id")))
            (js-call (expect (nativeGet denied "status")) :toBe 401)
            (js-call (expect (nativeGet cross "status")) :toBe 404)
            (js-call (expect (nativeGet (aref tools 0) "name")) :toBe "dj_service_status")
            (js-call (expect (not (= id new-id))) :toBe t)
            (js-call (expect (nativeGet (js-call mcp :status) "active_sessions")) :toBe 2)
            (let ((removed (await (nativeFetch url (js-object :method "DELETE" :headers
              (js-object :authorization "Bearer alpha" :mcp-session-id id))))))
              (js-call (expect (nativeGet removed "ok")) :toBe t))
            (js-call (expect (nativeGet (js-call mcp :status) "active_sessions")) :toBe 1)
            (js-call (expect (nativeGet (await (post url "alpha" "tools/list" 6 (js-object) id)) "status")) :toBe 404)
            (js-call (expect (nativeGet (await (post url "alpha" "tools/list" 7 (js-object) new-id)) "status")) :toBe 200))
          (finally (await (js-call mcp :close))))))
    (lambda (unused) nil)))
