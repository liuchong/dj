(module dj.tests.integration.message-actions
  (import "../../src/messaging/recipients.eli" optOutNotice)
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/im/lark.eli" createLarkPort)
  (import "../support/fixtures.eli" createFixture closeFixture callOk createdEvent successful bindRecipient subscribe)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (defasync setup (identity)
    (let* ((state (js-object :calls (js-array) :text "original" :deleted false :mode "normal" :reactions (js-array)))
      (f (await (createFixture (str "message-actions-" identity) "one" (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array)) (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (let ((connection (aref (nativeGet config "connections") 0)))
          (put connection :identity identity)
          (put ports :credentials (js-object :resolve (lambda (ref)
            (js-object :app_id "cli_test" :app_secret "fixture" :user_access_token "fixture"))))
          (put ports :http (js-object :fetch (async (address options)
            (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
              (method (nativeGet options "method" "GET"))
              (body (and (nativeGet options "body") (JSON/parse (nativeGet options "body")))))
              (when (and (not (= method "GET")) (js-call path :includes "/messages/"))
                (let ((db (new Database (resolve (nativeGet state "root") "state/dj.sqlite") (js-object :readonly t))))
                  (try (js-call (expect (nativeGet (js-call (js-call db :query
                    "SELECT json_extract(payload,'$.safe_result.data.state') AS state FROM operations ORDER BY rowid DESC LIMIT 1") :get) "state")) :toBe "unknown")
                    (finally (js-call db :close)))))
              (js-call (nativeGet state "calls") :push (js-object :path path :query (nativeGet url "search") :method method :body body))
              (cond
                ((js-call path :endsWith "/authen/v1/user_info") (Response/json (js-object :code 0 :data (js-object :open_id "ou_user"))))
                ((js-call path :endsWith "/tenant_access_token/internal") (Response/json (js-object :code 0 :tenant_access_token "fixture" :expire 7200)))
                ((js-call path :includes "/reactions")
                  (cond ((= method "GET") (Response/json (js-object :code 0 :data (js-object :items (nativeGet state "reactions") :has_more false))))
                    ((= method "POST")
                      (let ((row (js-object :reaction_id "reaction-own" :reaction_type (nativeGet body "reaction_type")
                        :operator (js-object :operator_id "ou_user" :operator_type "user") :action_time "1767225600000")))
                        (put state :reactions (js-array row)) (Response/json (js-object :code 0 :data row))))
                    (t (put state :reactions (js-array)) (Response/json (js-object :code 0 :data (js-object))))))
                ((and (not (= method "GET")) (js-call path :includes "/messages/"))
                  (when (= (nativeGet state "mode") "network") (throw (new globalThis.Error "fixture transport lost")))
                  (cond ((= (nativeGet state "mode") "denied")
                    (Response/json (js-object :code 230006 :msg "sensitive native error not projected")))
                    (t (if (= method "PUT")
                      (progn (js-call (expect (nativeGet body "msg_type")) :toBe "text")
                        (put state :text (nativeGet (JSON/parse (nativeGet body "content")) "text")))
                      (put state :deleted t))
                      (Response/json (js-object :code 0 :data (js-object))))))
                ((js-call path :includes "/messages/")
                  (let ((id (js-call (js-call path :split "/") :at -1)))
                    (Response/json (js-object :code 0 :data (js-object :items (js-array (js-object
                      :message_id id :chat_id (if (= id "wrong-chat") "c2" "c1") :thread_id nil :deleted (nativeGet state "deleted")
                      :msg_type "text" :create_time "1767225600000" :sender (js-object :id "ou_user" :sender_type "user" :id_type "open_id")
                      :body (js-object :content (JSON/stringify (js-object :text (nativeGet state "text")))))) :has_more false)))))
                (t (Response/json (js-object :code 0 :data (js-object :items (js-array) :has_more false)))))))))
          (js-call (nativeGet ports "im_ports") :set "lark" (createLarkPort connection ports)))))))))
      (put state :root (nativeGet f "root"))
      (put f :action_state state) f))
  (defun writes (f)
    (js-call (nativeGet (nativeGet f "action_state") "calls") :filter
      (lambda (row) (and (not (= (nativeGet row "method") "GET")) (js-call (nativeGet row "path") :includes "/messages/")))))
  (defasync setupTopics (identity)
    (let* ((f (await (setup identity))) (ports (nativeGet f "ports"))
      (fallback (nativeGet (nativeGet ports "http") "fetch"))
      (state (js-object :messages (new globalThis.Map) :calls (js-array) :mode "normal")))
      (put f :topic_state state)
      (put ports :http (js-object :fetch (async (address options)
        (let* ((url (new globalThis.URL address)) (path (nativeGet url "pathname"))
          (method (nativeGet options "method" "GET"))
          (sending (and (= method "POST") (or (js-call path :endsWith "/messages") (js-call path :endsWith "/reply"))))
          (id (js-call (js-call path :split "/") :at -1)) (messages (nativeGet state "messages"))
          (known (js-call messages :get id)))
          (cond (sending
            (let* ((body (JSON/parse (nativeGet options "body")))
              (parent (and (js-call path :endsWith "/reply") (js-call (js-call path :split "/") :at -2)))
              (origin (and parent (js-call messages :get parent)))
              (thread (or (nativeGet origin "thread_id") (and (nativeGet body "reply_in_thread") "omt_topic")))
              (native-id (str "om_topic_" (1+ (nativeGet messages "size"))))
              (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
              (try
                ;; Native writes cannot start before both durable cut points.
                (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM outbound WHERE state='submitting'") :get) "n")) :toBe 1)
                (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM attempts WHERE state='submitting' AND outbound_id IS NOT NULL") :get) "n")) :toBe 1)
                (finally (js-call db :close)))
              (js-call (nativeGet state "calls") :push (js-object :path path :body body :parent parent))
              (let ((message (js-object :message_id native-id :chat_id "c1" :thread_id thread :parent_id parent
                :msg_type (nativeGet body "msg_type") :create_time "1767225600000" :sender (js-object :id "ou_user" :sender_type identity :id_type "open_id")
                :body (js-object :content (nativeGet body "content")))))
                (js-call messages :set native-id message)
                (when (and origin thread) (put origin :thread_id thread))
                (when (= (nativeGet state "mode") "missing-thread") (put message :thread_id nil))
                (Response/json (js-object :code 0 :data message)))))
            (known
              (cond ((= method "PUT") (put known :body (js-object :content (nativeGet (JSON/parse (nativeGet options "body")) "content"))))
                ((= method "DELETE") (put known :deleted t)))
              (if (= method "GET") (Response/json (js-object :code 0 :data (js-object :items (js-array known) :has_more false)))
                (Response/json (js-object :code 0 :data (js-object)))))
            (t (await (funcall fallback address options)))))))) f))
  (defasync settledOutbound (f record)
    (await (js-call f :tick))
    (await (callOk f "O" "outbound.get" (js-object :outbound_id (nativeGet record "outbound_id")))))
  (withCase "T40.topic-replies.integration" (async () nil) (async (ignored)
    (let ((identities (js-array "user" "bot")) (index 0))
      (while (< index (js-length identities))
        (let* ((f (await (setupTopics (aref identities index)))) (state (nativeGet f "topic_state")))
          (try
            (let* ((link (nativeGet (new globalThis.URL "https://example.com/中文说明.md?q=中文#reason-如何填写") "href"))
              (summary (str "## Summary\n[填写说明](<" link ">)\n\n|字段|说明|\n|---|---|\n|reason|中文|"))
              (address (await (callOk f "O" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
              (main (await (callOk f "O" "message.send" (js-object :destination_ref (nativeGet address "conversation_ref")
                :content (js-object :type "markdown" :text summary) :idempotency_key "topic-main"))))
              (args (js-object :outbound_id (nativeGet main "outbound_id") :reply_in_thread t
                :content (js-object :type "markdown" :text "**details**\n中文") :idempotency_key "topic-details")))
              (let ((pending (await (js-call f :call (nativeGet f "O") "message.reply" args))))
                (js-call (expect (nativeGet (nativeGet pending "error") "code")) :toBe "ambiguous_target"))
              (setq main (await (settledOutbound f main)))
              (js-call (expect (nativeGet main "state")) :toBe "accepted")
              (let* ((wire (nativeGet (aref (nativeGet state "calls") 0) "body"))
                (post (JSON/parse (nativeGet wire "content")))
                (node (aref (aref (nativeGet (nativeGet post "zh_cn") "content") 0) 0)))
                (js-call (expect (nativeGet wire "msg_type")) :toBe "post")
                (js-call (expect (nativeGet node "tag")) :toBe "md")
                (js-call (expect (nativeGet node "text")) :toBe (str summary "\n\n" optOutNotice))
                (js-call (expect (js-call (nativeGet node "text") :includes link)) :toBe t))
              (let* ((reply (await (callOk f "O" "message.reply" args)))
                (done (await (settledOutbound f reply))) (native-id (aref (nativeGet done "native_message_ids") 0)))
                (js-call (expect (nativeGet done "state")) :toBe "accepted")
                (js-call (expect (nativeGet done "native_thread_id")) :toBe "omt_topic")
                (js-call (expect (nativeGet done "native_reply_to")) :toBe (aref (nativeGet main "native_message_ids") 0))
                (js-call (expect (nativeGet (nativeGet done "destination") "connection_id")) :toBe "lark")
                (js-call (expect (nativeGet (nativeGet (aref (nativeGet state "calls") 1) "body") "reply_in_thread")) :toBe t)
                (let ((parent (await (callOk f "O" "outbound.get" (js-object :outbound_id (nativeGet main "outbound_id"))))))
                  (js-call (expect (nativeGet parent "native_thread_id")) :toBe "omt_topic")
                  (js-call (expect (nativeGet (await (callOk f "O" "message.edit" (js-object :outbound_id (nativeGet main "outbound_id")
                    :content (js-object :type "markdown" :text "## Updated summary") :idempotency_key "topic-main-edit"))) "confirmed")) :toBe t))
                (await (callOk f "O" "message.reply" args)) (await (js-call f :tick))
                (js-call (expect (js-length (nativeGet state "calls"))) :toBe 2)
                (let* ((next (await (callOk f "O" "message.reply" (js-object :outbound_id (nativeGet done "outbound_id")
                    :reply_in_thread false :content (js-object :type "text" :text "more") :idempotency_key "topic-more"))))
                  (next-done (await (settledOutbound f next))))
                  (js-call (expect (nativeGet next-done "native_thread_id")) :toBe "omt_topic")
                  (js-call (expect (nativeGet next-done "native_reply_to")) :toBe native-id)
                  (js-call (expect (nativeGet (nativeGet (aref (nativeGet state "calls") 2) "body") "reply_in_thread")) :toBe t))
                (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "X") "message.reply"
                  (Object/assign (js-object) args (js-object :idempotency_key "topic-foreign")))) "ok")) :toBe false)
                (let ((edited (await (callOk f "O" "message.edit" (js-object :outbound_id (nativeGet done "outbound_id")
                  :content (js-object :type "markdown" :text "**edited details**") :idempotency_key "topic-edit")))))
                  (js-call (expect (nativeGet edited "confirmed")) :toBe t))
                (js-call (expect (nativeGet (await (callOk f "O" "message.recall" (js-object :outbound_id (nativeGet done "outbound_id")
                  :idempotency_key "topic-recall"))) "confirmed")) :toBe t))
              ;; Follow-ups inherit the original notification guard, not merely
              ;; an accepted parent ID. Expiry must still stop this new path.
              (let ((agent (await (bindRecipient f))))
                (await (subscribe f agent "lark"))
                (await (js-call f :ingest (createdEvent "lark" "native-original" "match original")))
                (await (js-call f :tick))
                (let* ((delivery (aref (nativeGet (await (callOk f "A" "delivery.list" (js-object))) "items") 0))
                  (reply (await (callOk f "A" "message.reply" (js-object :reply_context_id (nativeGet delivery "reply_context_id")
                    :reply_in_thread t :content (js-object :type "markdown" :text "## Source topic") :idempotency_key "source-topic"))))
                  (done (await (settledOutbound f reply))))
                  (js-call (expect (nativeGet done "state")) :toBe "accepted")
                  (js-call (expect (nativeGet done "native_thread_id")) :toBe "omt_topic")
                  (js-call (nativeGet f "clock") :advance 86401000)
                  (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "A") "message.reply"
                    (js-object :outbound_id (nativeGet done "outbound_id") :content (js-object :type "text" :text "expired")
                      :idempotency_key "topic-expired-anchor"))) "ok")) :toBe false)))

              ;; A swallowed thread ID is an uncertain send, not success or an
              ;; invitation to use a new key. The same request never sends twice.
              (put state :mode "missing-thread")
              (let* ((unknown-args (Object/assign (js-object) args (js-object :idempotency_key "topic-uncertain")))
                (unknown (await (settledOutbound f (await (callOk f "O" "message.reply" unknown-args)))))
                (count (js-length (nativeGet state "calls"))))
                (js-call (expect (nativeGet unknown "state")) :toBe "unknown")
                (await (callOk f "O" "message.reply" unknown-args)) (await (js-call f :tick))
                (js-call (expect (js-length (nativeGet state "calls"))) :toBe count)
                (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "O") "message.reply"
                  (js-object :outbound_id (nativeGet unknown "outbound_id") :content (js-object :type "text" :text "no")
                    :idempotency_key "unknown-anchor"))) "ok")) :toBe false))
              (put state :mode "normal")
              (let ((policy (js-object :default_action "allow" :allow (js-object :recipient_ids (js-array) :chat_ids (js-array))
                :deny (js-object :recipient_ids (js-array) :chat_ids (js-array "c1")))))
                (await (callOk f "O" "message.recipient_policy.set" (js-object :connection_id "lark" :expected_revision 0
                  :policy policy :idempotency_key "topic-deny")))
                (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "O") "message.reply"
                  (Object/assign (js-object) args (js-object :idempotency_key "topic-blocked")))) "ok")) :toBe false)
                (let ((forced (await (settledOutbound f (await (callOk f "O" "message.reply"
                  (Object/assign (js-object) args (js-object :force_send t :idempotency_key "topic-force"))))))))
                  (js-call (expect (nativeGet forced "state")) :toBe "accepted")
                  (js-call (expect (nativeGet (await (js-call f :call (nativeGet f "O") "message.reply"
                    (js-object :outbound_id (nativeGet forced "outbound_id") :content (js-object :type "text" :text "blocked again")
                      :idempotency_key "topic-force-not-inherited"))) "ok")) :toBe false))
                (put policy :deny (js-object :recipient_ids (js-array) :chat_ids (js-array)))
                (await (callOk f "O" "message.recipient_policy.set" (js-object :connection_id "lark" :expected_revision 1
                  :policy policy :idempotency_key "topic-allow")))))
            (finally (await (closeFixture f)))))
        (setq index (1+ index))))) (async (ignored) nil))
  (withCase "T40.message-actions.integration" (async () nil) (async (ignored)
    (let ((identities (js-array "user" "bot")) (index 0))
      (while (< index (js-length identities))
        (let* ((f (await (setup (aref identities index)))) (state (nativeGet f "action_state")))
          (try
            (let* ((ingested (successful (await (js-call f :ingest (createdEvent "lark" "native-original" "original")))))
              (event-id (nativeGet ingested "event_id"))
              (target (js-object :event_id event-id))
              (edit-args (Object/assign (js-object) target (js-object :content (js-object :type "text" :text "edited\n中文") :idempotency_key "edit-once")))
              (edit (await (callOk f "O" "message.edit" edit-args))))
              (js-call (expect (nativeGet edit "state")) :toBe "accepted")
              (js-call (expect (nativeGet edit "confirmed")) :toBe t)
              (js-call (expect (nativeGet state "text")) :toBe (str "edited\n中文\n\n" optOutNotice))
              (js-call (expect (nativeGet (aref (writes f) 0) "method")) :toBe "PUT")
              (await (callOk f "O" "message.edit" edit-args))
              (js-call (expect (js-length (writes f))) :toBe 1)
              (let ((readback (await (callOk f "O" "message.action.get" (js-object :action_id (nativeGet edit "action_id"))))))
                (js-call (expect (nativeGet readback "state")) :toBe "accepted"))
              (let* ((added (await (callOk f "O" "message.reaction.add" (Object/assign (js-object) target
                  (js-object :emoji_type "Pin" :idempotency_key "react-once")))))
                (listed (await (callOk f "O" "message.reaction.list" (Object/assign (js-object) target (js-object :emoji_type "Pin" :limit 5))))))
                (js-call (expect (nativeGet added "reaction_id")) :toBe "reaction-own")
                (js-call (expect (nativeGet (aref (nativeGet listed "items") 0) "emoji_type")) :toBe "Pin")
                (let ((removed (await (callOk f "O" "message.reaction.remove" (Object/assign (js-object) target
                  (js-object :reaction_id "reaction-own" :idempotency_key "unreact-once"))))))
                  (js-call (expect (nativeGet removed "state")) :toBe "accepted"))
                (js-call (nativeGet f "clock") :advance 1000)
                (js-call (expect (js-length (nativeGet (await (callOk f "O" "message.reaction.list" target)) "items"))) :toBe 0))
              (put state :mode "denied")
              (let ((denied (await (callOk f "O" "message.recall" (Object/assign (js-object) target (js-object :idempotency_key "denied-once"))))))
                (js-call (expect (nativeGet denied "state")) :toBe "rejected")
                (js-call (expect (nativeGet denied "native_code")) :toBe 230006)
                (js-call (expect (js-call (JSON/stringify denied) :includes "sensitive")) :toBe false))
              (put state :mode "network")
              (let* ((args (Object/assign (js-object) target (js-object :idempotency_key "uncertain-once")))
                (unknown (await (callOk f "O" "message.recall" args))) (count (js-length (writes f))))
                (js-call (expect (nativeGet unknown "state")) :toBe "unknown")
                (await (js-call f :restart))
                (await (callOk f "O" "message.recall" args))
                (js-call (expect (js-length (writes f))) :toBe count))
              (put state :mode "normal")
              (let ((recalled (await (callOk f "O" "message.recall" (Object/assign (js-object) target (js-object :idempotency_key "recall-once"))))))
                (js-call (expect (nativeGet recalled "state")) :toBe "accepted")
                (js-call (expect (nativeGet recalled "confirmed")) :toBe t))
              (let* ((bad-event (successful (await (js-call f :ingest (createdEvent "lark" "wrong-chat" "original")))))
                (count (js-length (writes f)))
                (result (await (js-call f :call (nativeGet f "O") "message.recall" (js-object :event_id (nativeGet bad-event "event_id") :idempotency_key "wrong-chat")))))
                (js-call (expect (nativeGet result "ok")) :toBe false)
                (js-call (expect (js-length (writes f))) :toBe count)))
            (finally (await (closeFixture f)))))
        (setq index (1+ index))))) (async (ignored) nil)))
