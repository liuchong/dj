(module dj.tests.integration.context
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/core/types.eli" utf8Bytes)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" toolsFromStatus validateResult)
  (import "../../src/adapters/im/lark-http.eli" createLarkHttpTransport)
  (import "../../src/adapters/im/lark-events.eli" createLarkEventPort)
  (import "../support/lark-http.eli" createLarkHttp)
  (import "../support/fixtures.eli" createClock)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient createdEvent)
  (import "bun:test" expect)
  (defasync setup () (await (createFixture "message-context" "one" (js-object :configure (lambda (config ports)
    (put config :managed_profiles (js-array))
    (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1"))))))
  (defasync subscribeRecent (f agent)
    (let* ((conversation (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
      (spec (js-object :agent_id (nativeGet agent "agent_id") :selector (js-object :sources (js-array
        (js-object :conversation_ref (nativeGet conversation "conversation_ref") :include_threads false)) :event_kinds (js-array "message.created"))
        :predicate (js-object :field "text" :op "contains" :value "trigger")
        :context_policy (js-object :mode "recent" :max_events 5 :max_bytes 16384)
        :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 86400) :start "now"))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec spec)))))
      (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "context-sub")))
      conversation))
  (defasync ingest (f id text &optional parent)
    (let ((event (createdEvent "lark" id text nil)))
      (when parent (put event :reply_to (js-object :id parent)) (put event :root_message_id (if (js-call id :startsWith "context-") "context-0" parent)))
      (js-call f :ingest event)))
  (defun assertWire (operation data)
    (let ((result (js-object :ok t :request_id "context-check" :data data :warnings (js-array) :evidence_level "service_record" :effect_state "none")))
      (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get operation) result) "ok")) :toBe t)))
  (withCase "T38.message-context.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (conversation (await (subscribeRecent f agent)))
      (port (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark")) (reads 0))
      (put port :history (async (parameters call) (setq reads (1+ reads)) (throw (new globalThis.Error "local path must not fetch"))))
      (await (ingest f "context-0" "Earlier cached message"))
      (await (ingest f "context-1" "Quoted middle" "context-0"))
      (let ((accepted (await (ingest f "context-2" "trigger reply referencing context" "context-1"))))
        (await (js-call f :tick))
        (js-call (expect reads) :toBe 0)
        (let* ((input (aref (nativeGet (nativeGet f "opencode") "inputs") 0))
          (envelope (nativeGet input "envelope")) (context (nativeGet envelope "context"))
          (ref (nativeGet context "context_ref")))
          (js-call (expect (js-length (nativeGet context "messages"))) :toBe 2)
          (js-call (expect (js-length (nativeGet context "references"))) :toBe 2)
          (js-call (expect (nativeGet (nativeGet (aref (nativeGet context "references") 0) "message") "content")) :toEqual
            (js-object :kind "text" :text "Quoted middle" :truncated false :original_bytes 13))
          (let ((queried (await (callOk f "A" "message.context" (js-object :context_ref ref :before 5)))))
            (assertWire "message.context" queried)
            (js-call (expect (js-length (nativeGet queried "messages"))) :toBe 2))
          (let ((quoted (await (callOk f "A" "message.context" (js-object :context_ref ref :native_message_id "context-1" :before 0)))))
            (js-call (expect (nativeGet (nativeGet quoted "anchor") "native_message_id")) :toBe "context-1"))
          (let ((history (await (callOk f "A" "message.history" (js-object :context_ref ref :limit 2)))))
            (assertWire "message.history" history)
            (js-call (expect (js-length (nativeGet history "items"))) :toBe 2)
            (let ((next (await (callOk f "A" "message.history" (js-object :context_ref ref :limit 2 :cursor (nativeGet history "next_cursor"))))))
              (js-call (expect (js-length (nativeGet next "items"))) :toBe 1)))
          (let ((denied (await (js-call f :call (nativeGet f "B") "message.context" (js-object :context_ref ref)))))
            (js-call (expect (nativeGet denied "ok")) :toBe false))
          (await (js-call f :restart))
          (let ((again (await (callOk f "A" "message.context" (js-object :event_id (nativeGet envelope "event_id"))))))
            (js-call (expect (js-length (nativeGet again "references"))) :toBe 2))
          (let* ((descriptor (js-call operationCatalog :get "message.context"))
            (tools (toolsFromStatus (js-object :visible_operations (js-array "message.context" "message.history")))))
            (js-call (expect (nativeGet (aref tools 0) "name")) :toBe "dj_message_context")
            (js-call (expect (nativeGet descriptor "action")) :toBe "message.read")))))) closeFixture)
  (withCase "T40.message-history-pages.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (conversation (await (subscribeRecent f agent))) (i 0) (all (js-array)) (cursor nil))
      (while (< i 70)
        (await (ingest f (str "history-" (js-call (str i) :padStart 3 "0")) (str "cached " i)))
        (setq i (1+ i)))
      (let ((round 0) (more t))
        (while (and more (< round 8))
          (let ((args (js-object :conversation_ref (nativeGet conversation "conversation_ref") :limit 13)))
            (when cursor (put args :cursor cursor))
            (let ((page (await (callOk f "A" "message.history" args))))
              (js-call (nativeGet page "items") :forEach (lambda (item) (js-call all :push (nativeGet item "native_message_id"))))
              (setq cursor (nativeGet page "next_cursor") more (not (nativeGet page "complete")))))
          (setq round (1+ round))))
      (js-call (expect (js-length all)) :toBe 70)
      (js-call (expect (nativeGet (new globalThis.Set all) "size")) :toBe 70)
      (js-call (expect (aref all 0)) :toBe "history-069")
      (let ((page (await (callOk f "A" "message.history" (js-object :conversation_ref (nativeGet conversation "conversation_ref") :limit 2)))))
        (let ((changed (await (js-call f :call (nativeGet f "A") "message.history"
          (js-object :conversation_ref (nativeGet conversation "conversation_ref") :limit 3 :cursor (nativeGet page "next_cursor"))))))
          (js-call (expect (nativeGet changed "ok")) :toBe false))))) closeFixture)
  (withCase "T38.native-context-cache.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (conversation (await (subscribeRecent f agent)))
      (port (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark")) (reads 0))
      (put port :history (async (parameters call)
        (setq reads (1+ reads))
        (if (nativeGet parameters "message_id")
          (js-object :ok t :data (js-object :messages (js-array (js-object :message_id (nativeGet parameters "message_id")
            :chat_id "c1" :msg_type "text" :create_time "1767225600000" :sender (js-object :id "native-user" :sender_type "user")
            :content "Fetched referenced text" :parent_id (if (= (nativeGet parameters "message_id") "native-anchor") "native-missing" nil))) :has_more false))
          (js-object :ok t :data (js-object :messages (js-array (js-object :message_id "native-older" :chat_id "c1" :msg_type "text"
            :create_time "1767225599000" :sender (js-object :id "native-user" :sender_type "user") :content "Native older cached context"))
            :has_more false)))))
      (let* ((accepted (await (ingest f "native-anchor" "trigger" "native-missing")))
        (id (nativeGet (nativeGet accepted "data") "event_id"))
        (local (await (callOk f "A" "message.context" (js-object :event_id id :before 0)))))
        (js-call (expect reads) :toBe 0)
        (js-call (expect (nativeGet (aref (nativeGet local "references") 0) "status")) :toBe "unavailable")
        (let ((native (await (callOk f "A" "message.context" (js-object :event_id id :scope "conversation" :corpus "native" :before 2)))))
          (assertWire "message.context" native)
          (js-call (expect (> reads 0)) :toBe t)
          (let ((cached (await (callOk f "A" "message.context" (js-object :event_id id :scope "conversation" :before 2)))))
            (js-call (expect (nativeGet (aref (nativeGet cached "references") 0) "status")) :toBe "available")
            (js-call (expect (js-length (nativeGet cached "messages"))) :toBe 1)))
        (let ((events (await (callOk f "A" "message.list" (js-object :conversation_ref (nativeGet conversation "conversation_ref"))))))
          (js-call (expect (js-length (nativeGet events "items"))) :toBe 1))
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
        (let ((ref (nativeGet local "context_ref")) (connection (aref (nativeGet (nativeGet f "config") "connections") 0)))
          (put connection :identity_revision 2)
          (await (js-call f :restart))
          (let ((stale (await (js-call f :call (nativeGet f "A") "message.context" (js-object :context_ref ref)))))
            (js-call (expect (nativeGet stale "ok")) :toBe false)))))) closeFixture)
  (withCase "T40.native-history-byte-pages.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (conversation (await (subscribeRecent f agent)))
      (port (js-call (nativeGet (nativeGet f "ports") "im_ports") :get "lark")) (reads 0) (all (js-array)) (cursor nil))
      (put port :history (async (parameters call)
        (setq reads (1+ reads))
        (js-object :ok t :data (js-object :messages (js-call (js-array 5 4 3 2 1) :map (lambda (index)
          (js-object :message_id (str "byte-" index) :chat_id "c1" :create_time "1767225600000"
            :sender (js-object :id "human" :sender_type "user") :content (js-call "中文😀" :repeat 800)))) :has_more false))))
      (let ((round 0) (more t))
        (while (and more (< round 10))
          (let ((args (js-object :conversation_ref (nativeGet conversation "conversation_ref") :corpus "native" :limit 5 :max_bytes 1024)))
            (when cursor (put args :cursor cursor))
            (let ((page (await (callOk f "A" "message.history" args))))
              (assertWire "message.history" page)
              (js-call (expect (<= (utf8Bytes (JSON/stringify page)) 1024)) :toBe t)
              (js-call (nativeGet page "items") :forEach (lambda (item) (js-call all :push (nativeGet item "native_message_id"))))
              (setq cursor (nativeGet page "next_cursor") more (not (nativeGet page "complete")))))
          (setq round (1+ round))))
      (js-call (expect (js-length all)) :toBe 5)
      (js-call (expect (nativeGet (new globalThis.Set all) "size")) :toBe 5)
      (js-call (expect reads) :toBe 1))) closeFixture)
  (withCase "T38.context-official-http.integration" (lambda () nil) (async (ignored)
    (let ((paths (js-array)) (transport nil)
      (call (js-object :deadline 15000 :abort_signal (nativeGet (new globalThis.AbortController) "signal")))
      (host nil))
      (setq host (js-object :clock (js-object :monoNow (lambda () 0))
        :credentials (js-object :resolve (async (ref) (js-object :app_id "test-app" :app_secret "test-secret")))
        :http (js-object :fetch (async (url options)
          (js-call paths :push url)
          (let ((wire (if (js-call url :includes "tenant_access_token")
            (js-object :code 0 :tenant_access_token "test-token" :expire 3600)
            (js-object :code 0 :data (js-object :items (js-array (js-object :message_id "om-test" :chat_id "c1" :msg_type "text"
              :body (js-object :content (JSON/stringify (js-object :text "official content"))) :create_time "1767225600000"))
              :has_more false)))))
            (new globalThis.Response (JSON/stringify wire) (js-object :status 200 :headers (js-object :content-type "application/json"))))))))
      (setq transport (createLarkHttpTransport (js-object :identity "bot" :credential_ref "private") host))
      (let ((response (await (js-call transport :perform "get" (js-object :message_id "om-test") call))))
        (js-call (expect (nativeGet response "ok")) :toBe t)
        (js-call (expect (nativeGet (aref (nativeGet (nativeGet (nativeGet response "data") "data") "messages") 0) "content")) :toBe "official content"))
      (await (js-call transport :perform "list" (js-object :chat_id "c1" :order "desc" :limit 20) call))
      (js-call (expect (aref paths 1)) :toBe "https://open.larksuite.com/open-apis/im/v1/messages/om-test")
      (js-call (expect (js-call (aref paths 2) :includes "container_id_type=chat")) :toBe t)
      (js-call (expect (js-call (aref paths 2) :includes "page_size=20")) :toBe t)
      (js-call transport :close))) (lambda (x) nil))
  (withCase "T38.event-conversation-query.integration" (lambda () nil) (async (ignored)
    (let* ((clock (createClock)) (script (createLarkHttp clock "normal"))
      (host (Object/assign (js-object :clock clock) script))
      (connection (js-object :connection_id "user" :platform "lark" :brand "lark" :identity "user" :credential_ref "private"
        :user_identity (js-object :app_id "cli_test" :open_id "ou_user")
        :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_test" :event_subject_id "ou_user"))
      (application (js-object :ports host :repository (js-object :get (lambda (table id) connection))))
      (address (js-object :connection_id "user" :native_chat_id "c1" :native_thread_id nil :thread_kind "main"))
      (call (js-object :deadline 15000 :abort_signal (nativeGet (new globalThis.AbortController) "signal")))
      (port (createLarkEventPort connection host)))
      (let ((source (nativeGet (await (js-call port :probe connection call)) "event_source")))
        (js-call (expect (nativeGet source "identity")) :toBe "application")
        (js-call (expect (nativeGet source "send_identity")) :toBe "user")
        (js-call (expect (nativeGet source "coverage")) :toBe "application_authorized_chats")
        (js-call (expect (nativeGet source "personal_inbox")) :toBe "not_provided_by_im_message_receive_v1"))
      (js-call clock :advance 10000)
      (try
        (let ((resolved (await (js-call port :resolveConversation address call application))))
          (js-call (expect (nativeGet resolved "ok")) :toBe t)
          (js-call (expect (nativeGet resolved "coverage")) :toBe "authorized_exact_history_query")
          (js-call (expect (nativeGet resolved "evidence_level")) :toBe "native_protocol"))
        (js-call (expect (js-call (nativeGet script "calls") :some (lambda (entry)
          (js-call (nativeGet entry "url") :includes "/open-apis/im/v1/messages?")))) :toBe t)
        (finally (await (js-call port :close))))
      (let* ((denied-script (createLarkHttp clock "missing-scope"))
        (denied (createLarkEventPort connection (Object/assign (js-object :clock clock) denied-script))))
        (try (js-call (expect (nativeGet (await (js-call denied :resolveConversation address call application)) "ok")) :toBe false)
          (finally (await (js-call denied :close))))))) (lambda (x) nil))

)
