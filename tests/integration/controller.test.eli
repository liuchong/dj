(module dj.tests.integration.controller
  (import "../../src/core/native.eli" nativeGet nativeFetch nativeSetTimeout)
  (import "../../src/controller/platform/darwin/service.eli" createServiceController serviceLabel)
  (import "../../src/controller/platform/darwin/main.eli" runCommand)
  (import "../support/case.eli" withCase)
  (import "node:fs/promises" mkdir mkdtemp writeFile rm)
  (import "node:path" resolve)
  (import "node:os" homedir)
  (import "node:crypto" randomUUID)
  (import "bun:test" expect)
  (defasync pause () (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 100)))))
  (defasync setup ()
    (await (mkdir (resolve (homedir) "AI/caches/codex") (js-object :recursive t :mode 448)))
    (let* ((root (await (mkdtemp (resolve (homedir) "AI/caches/codex/dj-controller-test-"))))
      (label (str "dev.dispatch-junction.test-controller-" (randomUUID)))
      (target (str "gui/" (js-call globalThis.process :getuid) "/" label))
      (script (resolve root "dummy.mjs")) (socket (resolve root "probe.sock")) (agent (resolve root "dummy.plist"))
      (xml (lambda (text) (js-call (js-call (str text) :replaceAll "&" "&amp;") :replaceAll "<" "&lt;"))))
      (await (writeFile script "try{(await import('node:fs')).unlinkSync(process.env.DJ_TEST_SOCKET)}catch{};Bun.serve({unix:process.env.DJ_TEST_SOCKET,fetch(){return Response.json({ok:true,data:{state:'ready'}})}});"))
      (await (writeFile agent (str "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict><key>Label</key><string>" label "</string>"
        "<key>ProgramArguments</key><array><string>" (funcall xml (nativeGet globalThis.process "execPath")) "</string><string>" (funcall xml script) "</string></array>"
        "<key>EnvironmentVariables</key><dict><key>DJ_TEST_SOCKET</key><string>" (funcall xml socket) "</string></dict>"
        "<key>KeepAlive</key><true/><key>RunAtLoad</key><true/></dict></plist>")))
      (js-object :root root :target target :agent agent :controller
        (createServiceController (js-object :uid (js-call globalThis.process :getuid) :launch_agent agent)
          (js-object :now (lambda () (Date/now)) :inspectPlist (async () t)
            :run (async (command args)
              (await (runCommand command (js-call args :map (lambda (arg) (js-call arg :replaceAll serviceLabel label))))))
            :probe (async ()
              (try (await (js-call (await (nativeFetch "http://local/status" (js-object :unix socket))) :json))
                (catch offline (js-object :ok false)))))))))
  (defasync close (f)
    (when f
      (await (runCommand "launchctl" (js-array "bootout" (nativeGet f "target"))))
      (await (runCommand "launchctl" (js-array "enable" (nativeGet f "target"))))
      (await (rm (nativeGet f "root") (js-object :recursive t :force t)))))
  (defasync untilState (controller state)
    (let ((i 0) (value nil))
      (while (< i 80)
        (setq value (await (js-call controller :refresh)))
        (if (= (nativeGet value "state") state) (setq i 80)
          (progn (await (pause)) (setq i (1+ i)))))
      (js-call (expect (nativeGet value "state")) :toBe state) value))
  (withCase "T38.controller-launchd.integration" setup (async (f)
    (let ((controller (nativeGet f "controller")))
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "stopped")
      (await (js-call controller :action "start")) (await (untilState controller "running"))
      (await (js-call controller :action "stop")) (await (untilState controller "stopped"))
      (await (pause))
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "stopped")
      (await (js-call controller :action "start")) (await (untilState controller "running")))) close)
  (withCase "T38.controller-failures.integration" (lambda () nil) (async (ignored)
    (let* ((present false) (fail false) (loaded false) (ready false)
      (controller (createServiceController (js-object :uid 501 :launch_agent "dummy.plist")
        (js-object :now (lambda () 0) :inspectPlist (async () present)
          :probe (async () (if ready (js-object :ok t :data (js-object :state "ready"))
            (js-object :ok false :error (js-object :code "unauthenticated"))))
          :run (async (name args)
            (if (= (aref args 0) "print") (js-object :code (if loaded 0 113) :stdout (if loaded "state = running\npid = 123\n" ""))
              (js-object :code (if fail 1 0))))))))
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "uninstalled")
      (setq present t loaded t)
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "unresponsive")
      (setq fail t)
      (js-call (expect (nativeGet (await (js-call controller :action "stop")) "state")) :toBe "error")
      ;; Being ready cannot hide a failed stop. Once that stop really completes,
      ;; ordinary refresh must clear the stored error without another action.
      (setq ready t)
      (js-call (expect (nativeGet (await (js-call controller :refresh)) "state")) :toBe "error")
      (setq ready false loaded false)
      (let ((status (await (js-call controller :refresh))))
        (js-call (expect (nativeGet status "state")) :toBe "stopped")
        (js-call (expect (nativeGet status "detail")) :toBe "")))) (lambda (ignored) nil)))
