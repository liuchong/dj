            (let ((denied (await (js-call existing :start (js-object) "legacy" (js-object)))))
              (js-call (expect (nativeGet denied "reason")) :toBe "existing_receiver_only"))
            (let ((denied (await (js-call existing :stop (js-object) (js-object) (js-object)))))
              (js-call (expect (nativeGet denied "absence_verified")) :toBe false)
              (js-call (expect (nativeGet denied "reason")) :toBe "existing_receiver_only"))
            (finally (await (js-call existing :close)))))
        (await (callOk f "O" "catalog.refresh" (js-object :include_content t :idempotency_key "desktop-catalog")))
        (await (until "native desktop catalog" (async ()
          (successful (await (js-call f :tick)))
          (= (js-length (nativeGet (await (callOk f "O" "session.list" (js-object))) "items")) 2)) 5000))
        (let ((sessions (nativeGet (await (callOk f "O" "session.list" (js-object))) "items")))
          (js-call (expect (js-length sessions)) :toBe 2)
