                 :workspace (js-object :isTrusted t :workspaceFolders (js-array (js-object :uri
                   (js-object :scheme "file" :fsPath workspace)))
                   :getConfiguration (lambda (name) (js-object :get (lambda (key fallback)
                     (nativeGet (js-object :enabled t :workspaceRef "ws-test") key fallback)))))
                 :commands (js-object :getCommands (async (hidden) (js-array "composer.createNew"))
                   :executeCommand (async (name options)
                     (js-call calls :push options)
