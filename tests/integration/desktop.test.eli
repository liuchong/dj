                    (js-call (expect (nativeGet (nativeGet unsupported "data") "lifecycle_id" nil)) :toBe nil)))
                (await (callOk f "O" "session.send" (js-object :session_ref (nativeGet session "session_ref")
                  :content (js-object :type "text" :text (str "direct-" tool)) :idempotency_key (str "direct-" tool))))
                (let* ((page (await (callOk f "O" "agent.discover" (js-object :tool tool :scope "live"))))
                       (candidate (aref (nativeGet page "items") 0))
                       (actor (if (= tool "codex") "A" "B"))
                       (agent (await (callOk f "O" "agent.register" (js-object
                         :candidate_ref (nativeGet candidate "candidate_ref") :display_name tool
                         :binding_mode "existing" :recipient_principal_id actor :idempotency_key (str "register-" tool))))))
                  (js-call (expect (nativeGet candidate "native_session_id")) :toBe (str tool "-thread"))
                  (await (subscribe f agent "lark" 60 actor))
