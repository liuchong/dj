                :ownership "managed" :profile_id "retired-profile" :state "starting" :revision 1))
              (js-call repository :insert "operations" (js-object :operation_id "retired-operation"
                :principal_id "O" :operation "instance.start" :key_hash "retired-key" :request_hash "retired-request"
                :state "accepted" :created_at "2026-01-01T00:00:00.000Z" :result_expires_at "2030-01-01T00:00:00.000Z"))
              (js-call repository :insert "lifecycle_actions" (js-object :lifecycle_id "retired-start"
                :operation_id "retired-operation" :principal_id "O" :action "start" :instance_id "retired-instance"
                :instance_epoch "retired-epoch" :launch_token "retired-token" :state "recorded" :revision 1
                :profile_revision 1 :created_at "2026-01-01T00:00:00.000Z")))))
            (put peer :start (async (profile token context)
              (setq starts (1+ starts)) (throw (new globalThis.Error "retired action attempted to launch"))))
            (successful (await (js-call f :tick)))
            (let ((action (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id "retired-start")))))
              (js-call (expect (nativeGet action "state")) :toBe "blocked"))
            (js-call (expect starts) :toBe 0)
            (finally
              (put peer :start original-start)
              (js-call db :exec "DELETE FROM lifecycle_actions WHERE lifecycle_id='retired-start'; DELETE FROM operations WHERE operation_id='retired-operation'; DELETE FROM instances WHERE instance_id='retired-instance'; DELETE FROM profiles WHERE profile_id='retired-profile'")
              (js-call db :close))))
        (let ((existing (createOpenCodePort (js-object :existing_only t) (nativeGet f "ports"))))
