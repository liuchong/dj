              (js-call (expect (js-call text :includes "# notification\n")) :toBe t)
              (js-call (expect (js-call text :includes "- : \"reply\"")) :toBe t)
              (js-call (expect reply-line) :toBeTruthy)
              (await (callOk f actor "message.reply" (js-object
