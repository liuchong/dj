                     (js-call (expect (nativeGet options "autoSubmit")) :toBe false)
                     (js-call (expect (nativeGet options "skipShowAndFocus")) :toBe t)
                     (js-call (expect (nativeGet options "skipSelect")) :toBe t)
                     (js-call (expect (nativeGet (nativeGet options "partialState") "isDraft")) :toBe false)
                     (when fail-command (throw (new globalThis.Error "native command interrupted")))
                     (js-call (nativeGet h "created_rows") :push (js-object
                       :id (nativeGet (nativeGet options "partialState") "composerId")
                       :title "Created by fixed native API" :source "local" :status "idle" :windowId 7))))))
               (extension (js-object :subscriptions (js-array)))
               (control (await (activateCursorControl vscode extension)))
               (endpoint (Object/assign (js-object)
                 (js-call (nativeGet (nativeGet f "config") "agent_endpoints") :find
                   (lambda (row) (= (nativeGet row "tool") "cursor")))
                 (js-object :directory workspace :control_manifest_path (nativeGet control "manifest_path"))))
               (port (createDesktopPort "cursor" (js-object :endpoints (js-array endpoint)) (nativeGet f "ports")))
               (instance (await (callOk f "O" "instance.get" (js-object :instance_id "cursor-native"))))
               (context (js-object :deadline (+ (performance/now) 5000) :title "Empty DJ session")))
          (put h :control control)
          (try
            (let ((first (await (js-call port :create instance "ws-test" "create-one" context))))
              (js-call (expect (nativeGet first "state")) :toBe "ready")
              (js-call (expect (nativeGet (nativeGet first "session") "native_session_id"))
                :toBe (cursorCreationId "ws-test" "create-one")))
            (await (js-call port :create instance "ws-test" "create-one" context))
            (js-call (expect (js-length calls)) :toBe 1)
            (let ((lookup (await (js-call port :lookupCreate instance "create-one" nil context))))
              (js-call (expect (nativeGet lookup "state")) :toBe "ready"))
            (js-call (expect (js-length calls)) :toBe 1)
            (let ((rejected false))
              (try
                (await (cursorRequest (js-object :manifest_path (nativeGet control "manifest_path"))
                  (js-object :type "createSession" :workspace_ref "ws-test" :creation_key "inject"
                    :prompt "Must not cross the connector") context))
                (catch error (setq rejected t)))
              (js-call (expect rejected) :toBe t))
            (js-call (expect (js-length calls)) :toBe 1)
            (put (nativeGet vscode "workspace") :isTrusted false)
            (let ((rejected false))
              (try (await (js-call port :create instance "ws-test" "create-revoked" context))
                (catch error (setq rejected t)))
              (js-call (expect rejected) :toBe t))
            (js-call (expect (js-length calls)) :toBe 1)
            (put (nativeGet vscode "workspace") :isTrusted t)
            (setq fail-command t)
            (try (await (js-call port :create instance "ws-test" "create-unknown" context))
              (catch expected nil))
            (js-call (expect (js-length calls)) :toBe 2)
            (let ((retry (await (js-call port :create instance "ws-test" "create-unknown" context))))
              (js-call (expect (nativeGet retry "state")) :toBe "unknown"))
            (js-call (expect (js-length calls)) :toBe 2)
            (await (js-call control :dispose))
            (setq control (await (activateCursorControl vscode extension)))
            (put h :control control)
            (let ((lookup (await (js-call port :lookupCreate instance "create-unknown" nil context))))
              (js-call (expect (nativeGet lookup "state")) :toBe "unknown"))
            (await (js-call port :create instance "ws-test" "create-one" context))
            (js-call (expect (js-length calls)) :toBe 2)
            (finally (await (js-call port :close)))))
        (js-call (expect (nativeGet h "agent_spawns")) :toBe 0)
        (let ((endpoints (nativeGet (nativeGet f "config") "agent_endpoints")) (index 0))
          (while (< index (js-length endpoints))
            (let* ((endpoint (aref endpoints index)) (tool (nativeGet endpoint "tool"))
                   (port (createDesktopPort tool (js-object :endpoints (js-array endpoint)) (nativeGet f "ports")))
                   (target (Object/assign (js-object) endpoint (js-object :native_session_id (str tool "-thread"))))
                   (error-code nil))
              (try
                (let ((page (await (js-call port :readMessages target nil
                    (js-object :max_records 1 :max_bytes 1024)
                    (js-object :deadline (+ (performance/now) 5000))))))
                  (js-call (expect (js-length (nativeGet page "items"))) :toBe 1))
                (try
                  (await (js-call port :readMessages target nil
                    (js-object :max_records 1 :max_bytes 1)
                    (js-object :deadline (+ (performance/now) 5000))))
                  (catch error (setq error-code (nativeGet error "code"))))
                (js-call (expect error-code) :toBe "desktop_history_limit")
                (finally (await (js-call port :close)))))
            (setq index (1+ index))))))
    cleanupDesktop))
