(module dj.tests.integration.cursor-restart
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk)
  (import "../support/process.eli" until)
  (import "bun:sqlite" Database)
  (import "node:path" join)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "cursor-restart" "one" (js-object :configure (lambda (config ports)
      (let ((peer (js-call (nativeGet ports "agent_ports") :get "opencode")))
        (put (nativeGet peer "capabilities") :instance_restart "supported")
        (put peer :restart_calls 0)
        (put peer :snapshotRestart (async (instance context)
          (js-object :items (js-array (js-object :native_session_id "original" :title "Original"
            :workspace_id "workspace" :runtime_state "busy")) :coverage "partial")))
        (put peer :restart (async (instance context)
          (put peer :restart_calls (1+ (nativeGet peer "restart_calls")))
          (if (nativeGet peer "uncertain") (throw (new globalThis.Error "native result uncertain"))
            (js-object :state "ready" :native_namespace "ns-opencode" :instance_epoch "after-restart" :evidence_level "native_protocol"))))
        (put peer :inspectRestart (async (instance context)
          (js-object :state "ready" :native_namespace "ns-opencode" :instance_epoch "after-restart" :evidence_level "native_protocol")))))))))
  (withCase "T53.cursor-restart.sqlite" setup
    (async (f)
      (let* ((instance (await (callOk f "O" "instance.get" (js-object :instance_id "oc-existing"))))
             (args (js-object :instance_id "oc-existing" :expected_instance_epoch (nativeGet instance "instance_epoch")
               :allow_interrupt t :idempotency_key "restart"))
             (peer (nativeGet f "opencode")) (db (new Database (join (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
        (try
          (let ((denied (await (js-call f :call (nativeGet f "A") "instance.restart" args))))
            (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden"))
          (let ((stale (await (js-call f :call (nativeGet f "O") "instance.restart"
            (Object/assign (js-object) args (js-object :expected_instance_epoch "old" :idempotency_key "stale"))))))
            (js-call (expect (nativeGet (nativeGet stale "error") "code")) :toBe "stale_reference"))
          ;; A native restart can see its durable snapshot before its first effect.
          (let ((original (nativeGet peer "restart")))
            (put peer :restart (async (instance context)
              (let* ((row (js-call (js-call db :query "SELECT payload FROM lifecycle_actions WHERE action='restart' AND state='submitting'") :get))
                     (action (JSON/parse (nativeGet row "payload"))))
                (js-call (expect (nativeGet action "state")) :toBe "submitting")
                (js-call (expect (nativeGet (aref (nativeGet action "resume_sessions") 0) "native_session_id")) :toBe "original"))
              (await (funcall original instance context)))))
          (let ((action (await (callOk f "O" "instance.restart" args))) (ready nil))
            (await (until "restart finishes" (async ()
              (await (js-call f :tick))
              (setq ready (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))))
              (= (nativeGet ready "state") "ready")) 5000))
            (js-call (expect (nativeGet ready "result_instance_epoch")) :toBe "after-restart")
            (js-call (expect (nativeGet ready "resume_coverage")) :toBe "partial")
            (js-call (expect (nativeGet ready "restart_scope")) :toBe "application")
            (js-call (expect (nativeGet (aref (nativeGet ready "resume_sessions") 0) "runtime_state")) :toBe "busy")
            (let ((again (await (callOk f "O" "instance.restart" args))))
              (js-call (expect (nativeGet again "lifecycle_id")) :toBe (nativeGet action "lifecycle_id"))))
          (await (js-call f :tick))
          (js-call (expect (nativeGet peer "restart_calls")) :toBe 1)
          (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0)
          (let ((gate (js-call (js-call db :query "SELECT state,instance_epoch FROM instance_gates WHERE instance_id='oc-existing'") :get)))
            (js-call (expect (nativeGet gate "state")) :toBe "open")
            (js-call (expect (nativeGet gate "instance_epoch")) :toBe "after-restart"))
          (finally (js-call db :close))))) closeFixture)
  (withCase "T53.cursor-restart-unknown.sqlite" setup
    (async (f)
      (let* ((peer (nativeGet f "opencode"))
             (instance (await (callOk f "O" "instance.get" (js-object :instance_id "oc-existing")))))
        (put peer :uncertain t)
        (let ((action (await (callOk f "O" "instance.restart" (js-object :instance_id "oc-existing"
          :expected_instance_epoch (nativeGet instance "instance_epoch") :allow_interrupt t :idempotency_key "uncertain")))))
          (await (until "uncertain restart" (async () (await (js-call f :tick))
            (= (nativeGet (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))) "state") "unknown")) 5000))
          (await (js-call f :tick))
          (js-call (expect (nativeGet peer "restart_calls")) :toBe 1)
          (await (callOk f "O" "lifecycle.reconcile" (js-object :lifecycle_id (nativeGet action "lifecycle_id") :idempotency_key "inspect")))
          (await (until "read-only recovery" (async () (await (js-call f :tick))
            (= (nativeGet (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))) "state") "ready")) 5000))
          (js-call (expect (nativeGet peer "restart_calls")) :toBe 1)))) closeFixture))
