(module dj.tests.integration.antigravity-reconnect
  (import "../../src/core/native.eli" nativeGet)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort)
  (import "../../src/adapters/agent/native-local.eli" metadataCommand)
  (import "../support/fixtures.eli" createFixture closeFixture callOk subscribe createdEvent)
  (import "../support/process.eli" until)
  (import "../support/case.eli" withCase)
  (import "node:fs" mkdirSync writeFileSync readFileSync chmodSync rmSync existsSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" randomUUID)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defun rows (f sql)
    (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
      (try (js-call (js-call db :query sql) :all) (finally (js-call db :close)))))
  (defasync stopReceiver (state)
    (let ((child (nativeGet state "child")))
      (when child (js-call child :kill "SIGTERM") (await (nativeGet child "exited")) (put state :child nil))))
  (defasync startReceiver (state round)
    (await (stopReceiver state))
    (let* ((root (nativeGet state "root")) (cert (resolve root (str "cert-" round ".pem")))
           (key (resolve root (str "key-" round ".pem")))
           (ssl (Bun/spawn (js-array "openssl" "req" "-x509" "-newkey" "rsa:2048"
             "-nodes" "-keyout" key "-out" cert "-days" "1" "-subj" "/CN=localhost" "-addext" "subjectAltName=DNS:localhost,IP:127.0.0.1")
             (js-object :stdout "ignore" :stderr "ignore")))
           (file (resolve root "receiver.json")))
      (unless (= (await (nativeGet ssl "exited")) 0) (throw (new globalThis.Error "fixture certificate generation failed")))
      (put state :token (str "fixture-token-" round))
      (writeFileSync file (JSON/stringify (js-object :cert cert :key key :token (nativeGet state "token")
        :workspace (js-call (pathToFileURL root) :toString) :received (resolve root "received.jsonl"))))
      (let* ((child (Bun/spawn (js-array (nativeGet globalThis.process "execPath")
                     "dist-tests/tests/support/antigravity-receiver.mjs" file)
                     (js-object :stdout "pipe" :stderr "pipe")))
             (reader (progn (put state :child child) (js-call (nativeGet child "stdout") :getReader)))
             (value (await (js-call reader :read)))
             (info (if (nativeGet value "done")
               (throw (new globalThis.Error (str "fixture receiver exited: " (await (js-call (new globalThis.Response (nativeGet child "stderr")) :text)))))
               (JSON/parse (js-call (new globalThis.TextDecoder) :decode (nativeGet value "value"))))))
        (put state :child child) (put state :pid (nativeGet info "pid")) (put state :port (nativeGet info "port"))
        (put state :birth (str "fixture-birth-" round))
        (writeFileSync (resolve root "process.json") (JSON/stringify (js-object
          :child (js-object :pid (nativeGet state "pid") :uid (js-call globalThis.process :getuid)
            :birth (nativeGet state "birth") :executable "/Fixture.app/Contents/Resources/bin/language_server")
          :parent (js-object :pid (nativeGet globalThis.process "pid") :uid (js-call globalThis.process :getuid)
            :birth "fixture-parent" :executable "/Fixture.app/Contents/MacOS/Antigravity")))))))
  (defasync setup ()
    (let* ((root (resolve ".local/tests" (str "antigravity-reconnect-" (randomUUID))))
           (state (js-object :root root :child nil :ambiguous false))
           (helper (resolve root "process-info")))
      (mkdirSync root (js-object :recursive t :mode 448))
      ;; Emulate only executable/birth metadata. PIDs, listeners, TLS, CSRF,
      ;; HTTP and the persistent Core are real and owned by this test.
      (writeFileSync helper (str "#!/usr/bin/env python3\nimport json,sys\nd=json.load(open("
        (JSON/stringify (resolve root "process.json")) "))\nr=next((v for v in d.values() if v['pid']==int(sys.argv[1])),None)\nif r is None: sys.exit(1)\nprint(json.dumps(r))\n"))
      (chmodSync helper 448)
      (try
        (await (startReceiver state 1))
        (let* ((endpoint (js-object :tool "antigravity" :instance_id "ag-existing" :native_namespace "ag-native"
                 :ownership "existing" :endpoint_ref "native-ag" :directory root :workspace_ref "ws-ag" :workspace_scope "instance"
                 :instance_epoch "configured-old" :base_url "https://127.0.0.1:1"
                 :process_binding (js-object :pid 1 :process_birth "old" :process_helper_ref helper :certificate_sha256 (js-call "0" :repeat 64))))
               (port (createAntigravityPort (js-object :endpoints (js-array endpoint)) (js-object
                 :antigravity_discovery_command (async (file args context)
                   (cond
                     ((and (= file "ps") (= (aref args 0) "-axo"))
                       (str (nativeGet state "pid") " " (nativeGet globalThis.process "pid") " " (js-call globalThis.process :getuid)
                         " /Fixture.app/Contents/Resources/bin/language_server\n"
                         (nativeGet globalThis.process "pid") " 1 " (js-call globalThis.process :getuid)
                         " /Fixture.app/Contents/MacOS/Antigravity\n"
                         (if (nativeGet state "ambiguous") (str "99999 99998 " (js-call globalThis.process :getuid)
                           " /Other.app/Contents/Resources/bin/language_server\n99998 1 " (js-call globalThis.process :getuid)
                           " /Other.app/Contents/MacOS/Antigravity\n") "")))
                     ((= file "ps")
                       (if (nativeGet state "auth_missing")
                         "language_server --app_data_dir antigravity --standalone --host_bridge_url=http://127.0.0.1:1 --read_host_bridge_token_from_stdin"
                         (str "language_server --app_data_dir antigravity --csrf_token " (nativeGet state "token"))))
                     (t (await (metadataCommand file args context))))))))
               (f (await (createFixture "ag-reconnect" "one" (js-object :configure (lambda (config ports)
                 (put config :managed_profiles (js-array))
                 (js-call (nativeGet config "principals") :forEach (lambda (actor)
                   (when (= (nativeGet actor "principal_id") "A")
                     (put actor :target_constraint (js-object :tool "antigravity" :native_namespace "ag-native" :native_session_id "original")))))
                 (js-call (nativeGet config "agent_endpoints") :push endpoint)
                 (js-call (nativeGet ports "agent_ports") :set "antigravity" port)))))))
          (put f :native_state state) f)
        (catch error (await (stopReceiver state)) (rmSync root (js-object :recursive t :force t)) (throw error)))))
  (defun currentInstance (f)
    (JSON/parse (nativeGet (aref (rows f "SELECT payload FROM instances WHERE instance_id='ag-existing'") 0) "payload")))
  (defun received (state)
    (let ((file (resolve (nativeGet state "root") "received.jsonl")))
      (if (existsSync file) (js-call (js-call (readFileSync file "utf8") :trim) :split "\n") (js-array))))
  (withCase "T38.antigravity-process-reconnect.integration" setup (async (f)
    (let* ((state (nativeGet f "native_state"))
           (found (await (callOk f "O" "agent.discover" (js-object :tool "antigravity" :scope "live"))))
           (agent (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet (aref (nativeGet found "items") 0) "candidate_ref")
             :display_name "Original" :binding_mode "existing" :recipient_principal_id "A" :idempotency_key "register-ag"))))
           (sub (await (subscribe f agent "lark")))
           (first-epoch (nativeGet (currentInstance f) "instance_epoch")))
      (js-call (expect (nativeGet (currentInstance f) "state")) :toBe "ready")
      (js-call (expect (nativeGet found "coverage_complete")) :toBe t)
      (await (startReceiver state 2))
      (let ((probe (await (callOk f "A" "agent.probe" (js-object :agent_id (nativeGet agent "agent_id"))))))
        (js-call (expect (nativeGet probe "live_receiver")) :toBe t)
        (js-call (expect (= (nativeGet (currentInstance f) "instance_epoch") first-epoch)) :toBe false))
      (let* ((session (await (callOk f "O" "session.resolve" (js-object :instance_id "ag-existing" :native_session_id "original"))))
             (epoch (nativeGet session "instance_epoch")))
        (await (startReceiver state 3))
        (let ((probe (await (callOk f "O" "session.probe" (js-object :session_ref (nativeGet session "session_ref"))))))
          (js-call (expect (nativeGet probe "live_receiver")) :toBe t)
          (js-call (expect (= (nativeGet (currentInstance f) "instance_epoch") epoch)) :toBe false)))
      (let ((history (rows f "SELECT binding_id,payload FROM bindings")))
        (await (stopReceiver state))
        (await (js-call f :ingest (createdEvent "lark" "offline-native" "original receiver")))
        (await (js-call f :tick))
        (js-call (expect (js-length (received state))) :toBe 0)
        (await (startReceiver state 4))
        (await (until "pending input survives process restart" (async ()
          (await (js-call f :tick)) (= (js-length (received state)) 1)) 8000))
        (await (js-call f :tick))
        (js-call (expect (js-length (received state))) :toBe 1)
        (js-call history :forEach (lambda (row)
          (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
            (try (js-call (expect (nativeGet (js-call (js-call db :query "SELECT payload FROM bindings WHERE binding_id=?") :get (nativeGet row "binding_id")) "payload"))
              :toBe (nativeGet row "payload")) (finally (js-call db :close)))))))
      (js-call (expect (nativeGet (await (callOk f "A" "subscription.get" (js-object :agent_id (nativeGet sub "agent_id")))) "state")) :toBe "active")
      (let ((previous (nativeGet (currentInstance f) "instance_epoch")))
        (rows f "UPDATE instance_gates SET state='closed',payload=json_set(payload,'$.state','closed','$.reason','instance_stop') WHERE instance_id='ag-existing'")
        (await (startReceiver state 5))
        (let ((result (await (js-call f :call (nativeGet f "A") "agent.probe" (js-object :agent_id (nativeGet agent "agent_id"))))))
          (js-call (expect (nativeGet result "ok")) :toBe false))
        (js-call (expect (nativeGet (currentInstance f) "instance_epoch")) :toBe previous)
        (js-call (expect (existsSync (resolve (nativeGet state "root") "unused-credential.json"))) :toBe false)
        (js-call (expect (nativeGet (js-call (nativeGet (nativeGet f "config") "agent_endpoints") :find
          (lambda (e) (= (nativeGet e "instance_id") "ag-existing"))) "instance_epoch")) :toBe "configured-old")
        (await (startReceiver state 6)) (put state :ambiguous t)
        (let* ((port (js-call (nativeGet (nativeGet f "ports") "agent_ports") :get "antigravity"))
               (probe (await (js-call port :probeInstance (currentInstance f) (js-object :deadline (+ (performance/now) 4000))))))
          (js-call (expect (nativeGet probe "state")) :toBe "offline"))
        (put state :ambiguous false)
        (put state :auth_missing t)
        (let* ((page (await (callOk f "A" "agent.discover" (js-object :tool "antigravity" :scope "live"))))
               (source (aref (nativeGet page "sources") 0)))
          (js-call (expect (nativeGet page "items")) :toEqual (js-array))
          (js-call (expect (nativeGet page "complete")) :toBe t)
          (js-call (expect (nativeGet page "coverage_complete")) :toBe false)
          (js-call (expect (nativeGet source "coverage")) :toBe "partial")
          (js-call (expect (nativeGet source "reason")) :toBe "antigravity_desktop_auth_unavailable"))
        (js-call (expect (js-length (received state))) :toBe 1))))
    (async (f) (let ((state (nativeGet f "native_state")))
      (try (await (closeFixture f)) (finally (await (stopReceiver state)) (rmSync (nativeGet state "root") (js-object :recursive t :force t)))))))

)
