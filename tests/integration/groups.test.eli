(module dj.tests.integration.groups
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk createdEvent subscribe)
  (import "node:crypto" randomUUID)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (let ((states (new globalThis.Map)) (calls (js-object :count 0)))
      (let ((f (await (createFixture "group-subscriptions" "one" (js-object :configure (lambda (config ports)
        (put config :managed_profiles (js-array))
        (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
        (let ((principal (aref (nativeGet config "principals") 2)))
          (Reflect/deleteProperty principal "target_constraint")
          (put principal :grants (js-array (js-object :action "*" :resources (js-array "*")))))
        (let ((peer (js-call (nativeGet ports "agent_ports") :get "opencode")))
          (js-call (nativeGet peer "sessions") :forEach (lambda (session)
            (put session :model_selection (js-object :provider_id "fixture" :model_id (nativeGet session "native_session_id")))))
          (put peer :availability (async (target call)
            (put calls :count (1+ (nativeGet calls "count")))
            (js-object :state (js-call states :get (nativeGet target "native_session_id")) :source "fixture" :reason "fixture" :reset_at nil))))))))))
        (put f :quota_states states) (put f :quota_calls calls) f)))
  (defasync register (f id)
    (let* ((page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live"))))
      (candidate (js-call (nativeGet page "items") :find (lambda (x) (= (nativeGet x "native_session_id") id)))))
      (await (callOk f "A" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name id :binding_mode "existing" :idempotency_key (str "register-" id))))))
  (defasync group (f a b)
    (await (callOk f "A" "subscription.group.create" (js-object :name "receivers"
      :members (js-array (js-object :agent_id (nativeGet a "agent_id") :priority 0)
        (js-object :agent_id (nativeGet b "agent_id") :priority 1)) :idempotency_key (randomUUID)))))
  (defasync sub (f g &optional algorithm quota mode)
    (let* ((spec (js-object :group_id (nativeGet g "group_id")
      :selector (js-object :sources (js-array (js-object :connection_id "lark")) :event_kinds (js-array "message.created"))
      :predicate (js-object :all (js-array)) :delivery_mode (or mode "push")))
      (distribution (js-object)))
      (when algorithm (put distribution :algorithm algorithm))
      (when quota (put distribution :eligibility (js-object :quota quota)))
      (put spec :distribution distribution)
      (let ((preview (await (callOk f "A" "subscription.preview" (js-object :spec spec)))))
        (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key (randomUUID)))))))
  (defasync pump (f &optional count)
    (let ((i 0)) (while (< i (or count 6))
      (await (js-call f :tick)) (js-call (nativeGet f "clock") :advance 1000) (setq i (1+ i)))))
  (defasync ledger (f subscription)
    (nativeGet (await (callOk f "A" "subscription.group.dispatches"
      (js-object :subscription_id (nativeGet subscription "subscription_id")))) "items"))
  (withCase "T33.group-round-robin.integration" setup (async (f)
    (let* ((a (await (register f "s1"))) (b (await (register f "s2"))) (g (await (group f a b)))
      (s (await (sub f g))) (seen (js-array)))
      (js-call (expect (nativeGet (nativeGet s "distribution") "algorithm")) :toBe "round_robin")
      (let ((status (await (callOk f "A" "service.status" (js-object)))))
        (js-call (expect (js-call (nativeGet status "visible_operations") :includes "agent.availability")) :toBe t))
      (let ((i 0)) (while (< i 4)
        (await (js-call f :ingest (createdEvent "lark" (str "round-" i) "one member")))
        (await (pump f))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe (1+ i))
        (when (= i 1) (await (js-call f :restart)))
        (setq i (1+ i))))
      (let ((rows (await (ledger f s))) (inputs (nativeGet (nativeGet f "opencode") "inputs")))
        (js-call (expect (js-length rows)) :toBe 4)
        (js-call (expect (js-length (js-call rows :filter (lambda (x) (= (nativeGet x "agent_id") (nativeGet a "agent_id")))))) :toBe 2)
        (js-call (expect (nativeGet (new globalThis.Set (js-call inputs :map (lambda (x) (nativeGet x "key")))) "size")) :toBe 4)
        (js-call inputs :forEach (lambda (input)
          (js-call (expect (js-length (nativeGet (nativeGet input "envelope") "group_dispatches"))) :toBe 1))))
      (let ((ordinary (await (subscribe f b "lark"))))
        (await (js-call f :ingest (createdEvent "lark" "parallel" "ordinary plus group"))) (await (pump f))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBeGreaterThanOrEqual 5))
      (let ((denied (await (js-call f :call (nativeGet f "X") "subscription.group.get" (js-object :group_id (nativeGet g "group_id"))))))
        (js-call (expect (nativeGet denied "ok")) :toBe false))
      (let ((busy (await (js-call f :call (nativeGet f "A") "subscription.group.delete"
        (js-object :group_id (nativeGet g "group_id") :expected_revision 1 :idempotency_key "delete-in-use")))))
        (js-call (expect (nativeGet (nativeGet busy "error") "code")) :toBe "revision_conflict")))) closeFixture)
  (withCase "T33.group-quota-pull.integration" setup (async (f)
    (let* ((a (await (register f "s1"))) (b (await (register f "s2"))) (g (await (group f a b)))
      (states (nativeGet f "quota_states")))
      (js-call states :set "s1" "exhausted") (js-call states :set "s2" "available")
      (let ((s (await (sub f g "priority" "require_available" "pull"))))
        (await (js-call f :ingest (createdEvent "lark" "pull-one" "only available member"))) (await (pump f))
        (let* ((empty (await (callOk f "A" "subscription.pull" (js-object :subscription_id (nativeGet s "subscription_id")
          :agent_id (nativeGet a "agent_id") :idempotency_key "pull-wrong-member"))))
          (claimed (await (callOk f "A" "subscription.pull" (js-object :subscription_id (nativeGet s "subscription_id")
            :agent_id (nativeGet b "agent_id") :idempotency_key "pull-right-member")))))
          (js-call (expect (nativeGet empty "empty")) :toBe t)
          (js-call (expect (nativeGet claimed "empty")) :toBe false)
          (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet (nativeGet claimed "item") "claim_ref")
            :disposition "consumed" :idempotency_key "consume"))))
        (js-call (expect (nativeGet (nativeGet f "quota_calls") "count")) :toBe 2)
        (js-call states :set "s2" "unknown") (js-call (nativeGet f "clock") :advance 61000)
        (await (js-call f :ingest (createdEvent "lark" "wait-quota" "preserved"))) (await (pump f))
        (js-call (expect (js-length (js-call (await (ledger f s)) :filter (lambda (x) (= (nativeGet x "state") "waiting_member"))))) :toBe 1)
        (js-call states :set "s2" "available") (js-call (nativeGet f "clock") :advance 61000) (await (pump f))
        (let ((rows (await (ledger f s))))
          (js-call (expect (js-length (js-call rows :filter (lambda (x) (= (nativeGet x "state") "waiting_member"))))) :toBe 0))))) closeFixture)
  (withCase "T33.group-failure-boundary.integration" setup (async (f)
    (let* ((a (await (register f "s1"))) (b (await (register f "s2"))) (g (await (group f a b)))
      (s (await (sub f g "priority" "ignore"))) (peer (nativeGet f "opencode"))
      (submit (nativeGet peer "submit")) (calls (js-array)) (unknown false))
      (put peer :submit (async (binding envelope mode key call)
        (js-call calls :push (nativeGet binding "native_session_id"))
        (if unknown (js-object :state "unknown" :definite_not_sent false)
          (if (= (nativeGet binding "native_session_id") "s1")
            (js-object :state "failed" :definite_not_sent t :retryable t)
            (await (funcall submit binding envelope mode key call))))))
      (await (js-call f :ingest (createdEvent "lark" "reject-first" "safe failover"))) (await (pump f 12))
      (js-call (expect calls) :toEqual (js-array "s1" "s2"))
      (js-call (expect (nativeGet (aref (await (ledger f s)) 0) "state")) :toBe "accepted")
      (setq unknown t)
      (await (js-call f :ingest (createdEvent "lark" "unknown-first" "do not duplicate"))) (await (pump f 12))
      (js-call (expect (js-length calls)) :toBe 3)
      (js-call (expect (js-length (js-call (await (ledger f s)) :filter (lambda (x) (= (nativeGet x "state") "unknown"))))) :toBe 1))) closeFixture)
  (withCase "T33.group-target-storage.integration" setup (async (f)
    (let* ((a (await (register f "s1"))) (ordinary (await (subscribe f a "lark")))
      (core (nativeGet f "core")) (clock (nativeGet f "clock")))
      (await (js-call core :stop "schema_check" (+ (js-call clock :monoNow) 1000)))
      (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))))
        (try
          (js-call db :run "PRAGMA foreign_keys=OFF") (js-call db :run "BEGIN IMMEDIATE")
          (js-call db :run "CREATE TABLE subscriptions_previous(subscription_id TEXT PRIMARY KEY,owner_principal_id TEXT NOT NULL,agent_id TEXT NOT NULL REFERENCES agents(agent_id),state TEXT NOT NULL,revision INTEGER NOT NULL,payload TEXT NOT NULL CHECK(json_valid(payload))) STRICT")
          (js-call db :run "INSERT INTO subscriptions_previous SELECT * FROM subscriptions")
          (js-call db :run "DROP TABLE subscriptions")
          (js-call db :run "ALTER TABLE subscriptions_previous RENAME TO subscriptions")
          (js-call db :run "CREATE INDEX subscriptions_agent ON subscriptions(agent_id,subscription_id)")
          (js-call db :run "COMMIT")
          (finally (js-call db :close))))
      (await (js-call f :restart))
      (let ((saved (await (callOk f "A" "subscription.get" (js-object :subscription_id (nativeGet ordinary "subscription_id"))))))
        (js-call (expect saved) :toEqual ordinary))
      (let* ((b (await (register f "s2"))) (g (await (group f a b))) (s (await (sub f g "random" "ignore"))))
        (await (js-call f :ingest (createdEvent "lark" "random-one" "one durable choice"))) (await (pump f))
        (let ((before (await (ledger f s))))
          (js-call (expect (js-length before)) :toBe 1)
          (await (js-call f :restart)) (await (pump f))
          (let ((after (await (ledger f s))))
            (js-call (expect (js-length after)) :toBe 1)
            (js-call (expect (nativeGet (aref after 0) "agent_id")) :toBe (nativeGet (aref before 0) "agent_id"))
            (js-call (expect (nativeGet (aref after 0) "delivery_id")) :toBe (nativeGet (aref before 0) "delivery_id"))))))) closeFixture))
