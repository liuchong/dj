(module dj.tests.integration.composition
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (defasync turns (f count)
    (let ((index 0)) (while (< index count) (await (js-call f :tick)) (setq index (1+ index)))))
  (withCase "T40.module-composition.sqlite"
    (async () (await (createFixture "module-composition" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1"))))))
    (async (f)
      (let* ((core (nativeGet f "core")) (status (js-call core :moduleStatus))
        (agent (await (bindRecipient f))) (inputs (nativeGet (nativeGet f "opencode") "inputs")))
        (js-call (expect (> (js-length status) 15)) :toBe t)
        (js-call (expect (js-call status :every (lambda (row) (= (nativeGet row "state") "active")))) :toBe t)
        (js-call (expect (js-call status :some (lambda (row) (= (nativeGet row "name") "connection:lark")))) :toBe t)
        (await (subscribe f agent "lark"))
        (let ((event (createdEvent "lark" "rack-message" "hello composition")))
          (await (js-call f :ingest event)) (await (js-call f :ingest event)))
        (await (turns f 3))
        (js-call (expect (js-length inputs)) :toBe 1)
        (let ((ref (nativeGet (nativeGet (aref inputs 0) "envelope") "reply_context_id")))
          (let ((args (js-object :reply_context_id ref :content (js-object :type "text" :text "received") :idempotency_key "rack-reply")))
            (await (callOk f "A" "message.reply" args)) (await (callOk f "A" "message.reply" args)))
          (await (turns f 3))
          (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 1))
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
          (try
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries WHERE state='accepted'") :get) "n")) :toBe 1)
            (finally (js-call db :close))))
        (let ((result (await (js-call core :stop "composition_acceptance" (+ (js-call (nativeGet f "clock") :monoNow) 1000)))))
          (js-call (expect (nativeGet result "ok")) :toBe t)
          (js-call (expect (nativeGet (nativeGet result "data") "state")) :toBe "stopped"))
        (js-call (expect (js-length (js-call core :moduleStatus))) :toBe 0)
        (js-call (expect (nativeGet (await (js-call core :stop "repeat" 0)) "ok")) :toBe t)))
    closeFixture))
