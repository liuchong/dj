(module dj.tests.integration.echo
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent createImPeer)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "cross-echo" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let* ((source (aref (nativeGet config "connections") 0)) (other (JSON/parse (JSON/stringify source))))
        (put source :tenant_ref "network")
        (put other :connection_id "lark-alt") (put other :identity "bot") (put other :tenant_ref "network")
        (js-call (nativeGet config "connections") :push other)
        (js-call (nativeGet ports "im_ports") :set "lark-alt" (createImPeer "lark-alt"))))))))
  (defasync turns (f n) (let ((i 0)) (while (< i n) (await (js-call f :tick)) (setq i (1+ i)))))
  (defasync subscribeThreads (f agent connection)
    (let* ((address (await (callOk f "A" "conversation.resolve" (js-object :connection_id connection :chat_id "c1" :thread_id nil))))
      (current-res (await (js-call f :call (nativeGet f "A") "subscription.get" (js-object :agent_id (nativeGet agent "agent_id")))))
      (current (if (= (nativeGet current-res "ok") t) (nativeGet current-res "data") nil))
      (expected-rev (if current (nativeGet current "revision") 0))
      (rules (if current (js-call (nativeGet current "rules") :slice) (js-array)))
      (next-rule (js-object :id (str "threads-" connection) :enabled t
        :sources (js-array (js-object :conversation_ref (nativeGet address "conversation_ref") :include_threads t))
        :event_kinds (js-array "message.created")
        :predicate (js-object :all (js-array)))))
      (js-call rules :push next-rule)
      (let ((preview (await (callOk f "A" "subscription.preview"
        (js-object :expected_revision expected-rev
          :spec (js-object :agent_id (nativeGet agent "agent_id") :start "now" :rules rules))))))
        (await (callOk f "A" "subscription.set"
          (js-object :preview_id (nativeGet preview "preview_id") :expected_revision expected-rev :idempotency_key (str "threads-" connection)))))))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defun back (id text)
    (let ((event (createdEvent "lark-alt" id text)))
      (put event :sender (js-object :id "self-in-this-app" :kind "human")) event))
  (withCase "T38.cross-connection-echo.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (sub nil))
      (await (subscribe f agent "lark")) (setq sub (await (subscribe f agent "lark-alt")))
      (await (js-call f :ingest (createdEvent "lark" "parent" "source"))) (await (turns f 1))
      (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "reply to self") :idempotency_key "first-reply")))
        (await (turns f 2))
        (await (js-call f :ingest (back "lark-reply-1" "reply to self")))
        (await (js-call f :ingest (back "manual-self-mention" "manual native mention")))
        (await (turns f 2))
        (js-call (expect (js-length (inputs f))) :toBe 2)
        (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
          (echo (js-call (js-call db :query "SELECT w.payload,e.event_id FROM routing_work w JOIN events e ON e.event_id=w.event_id WHERE e.connection_id='lark-alt' AND e.native_message_id='lark-reply-1'") :get)))
          (js-call (expect (nativeGet (JSON/parse (nativeGet echo "payload")) "reason")) :toBe "own_echo")
          (js-call db :close)
          (let ((replay (await (js-call f :call (nativeGet f "A") "subscription.replay" (js-object :agent_id (nativeGet sub "agent_id")
            :event_ids (js-array (nativeGet echo "event_id")) :expected_revision (nativeGet sub "revision") :idempotency_key "no-echo-replay")))))
            (js-call (expect (nativeGet replay "ok")) :toBe false)))
        ;; If proof arrives after matching, submission still cancels the exact echo.
        (put (aref (nativeGet (nativeGet f "opencode") "sessions") 0) :runtime_state "busy")
        (await (js-call f :ingest (back "lark-reply-2" "late receipt"))) (await (turns f 1))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "late receipt") :idempotency_key "second-reply")))
        (await (turns f 2))
        (put (aref (nativeGet (nativeGet f "opencode") "sessions") 0) :runtime_state "idle")
        (await (turns f 2))
        (js-call (expect (js-length (inputs f))) :toBe 2)
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
          (let ((row (js-call (js-call db :query "SELECT d.state,json_extract(d.payload,'$.blocked_reason') AS reason FROM deliveries d JOIN events e ON d.event_id=e.event_id WHERE e.native_message_id='lark-reply-2'") :get)))
            (js-call (expect (nativeGet row "state")) :toBe "cancelled")
            (js-call (expect (nativeGet row "reason")) :toBe "own_echo"))
          (js-call db :close))))) closeFixture)
  (withCase "T40.cross-connection-echo-gate.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (release nil) (started false))
      (await (subscribe f agent "lark")) (await (subscribe f agent "lark-alt"))
      (await (js-call f :ingest (createdEvent "lark" "gate-parent" "source"))) (await (turns f 1))
      (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
        (put (nativeGet f "lark") :send (async (record key context)
          (setq started t)
          (await (new globalThis.Promise (lambda (resolve) (setq release resolve))))
          (js-object :state "accepted" :native_message_id "gate-outgoing" :evidence_level "native_protocol")))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "pending") :idempotency_key "gate-reply")))
        (await (turns f 1)) (js-call (expect started) :toBe t)
        (await (js-call f :ingest (back "real-human-during-send" "not the outgoing message")))
        (await (turns f 1))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (funcall release nil) (await (turns f 3))
        (js-call (expect (js-length (inputs f))) :toBe 2)))) closeFixture)
  (withCase "T40.topic-outbound-echo-race.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (release nil) (started false)
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try
        (await (subscribeThreads f agent "lark")) (await (subscribeThreads f agent "lark-alt"))
        (await (js-call f :ingest (createdEvent "lark" "topic-origin" "question"))) (await (turns f 1))
        (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
          (put (nativeGet f "lark") :send (async (record key context)
            ;; An independent read sees the reservation before native I/O.
            (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM echo_gates") :get) "n")) :toBe 1)
            (setq started t)
            (await (new globalThis.Promise (lambda (resolve) (setq release resolve))))
            (js-object :state "accepted" :native_message_id "new-topic-reply" :native_thread_id "t1" :evidence_level "native_protocol")))
          (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :reply_in_thread t
            :content (js-object :type "text" :text "topic answer") :idempotency_key "create-topic")))
          (await (turns f 1)) (js-call (expect started) :toBe t)
          (let ((echo (createdEvent "lark-alt" "new-topic-reply" "topic answer" "t1"))
            (human (createdEvent "lark-alt" "real-followup" "please clarify" "t1")))
            (put echo :root_message_id "topic-origin") (put echo :reply_to (js-object :id "topic-origin"))
            (put human :root_message_id "topic-origin") (put human :reply_to (js-object :id "new-topic-reply"))
            (await (js-call f :ingest echo)) (await (js-call f :ingest human))
            (await (turns f 2))
            (js-call (expect (js-length (inputs f))) :toBe 1)
            (let ((row (js-call (js-call db :query "SELECT w.state FROM routing_work w JOIN events e ON e.event_id=w.event_id WHERE e.native_message_id='new-topic-reply'") :get)))
              (js-call (expect (nativeGet row "state")) :toBe "held")))
          (funcall release nil) (await (turns f 4))
          (js-call (expect (js-length (inputs f))) :toBe 2)
          (js-call (expect (nativeGet (nativeGet (aref (inputs f) 1) "envelope") "origin")) :toBe "subscription_event")
          (let ((row (js-call (js-call db :query "SELECT json_extract(w.payload,'$.reason') AS reason FROM routing_work w JOIN events e ON e.event_id=w.event_id WHERE e.native_message_id='new-topic-reply'") :get)))
            (js-call (expect (nativeGet row "reason")) :toBe "own_echo"))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM echo_gates") :get) "n")) :toBe 0)
          (await (js-call f :restart))
          (let ((echo (createdEvent "lark" "new-topic-reply" "topic answer" "t1")))
            (put echo :root_message_id "topic-origin")
            (await (js-call f :ingest echo)) (await (turns f 2))
            (js-call (expect (js-length (inputs f))) :toBe 2))
          ;; Same words, different native message: this is genuine input.
          (let ((manual (createdEvent "lark-alt" "manual-same-text" "topic answer" "t1")))
            (put manual :root_message_id "topic-origin") (await (js-call f :ingest manual))
            (await (turns f 2)) (js-call (expect (js-length (inputs f))) :toBe 3)))
        (finally (when release (funcall release nil)) (js-call db :close))))) closeFixture)
  (withCase "T40.private-outbound-echo.integration" setup (async (f)
    (let ((agent (await (bindRecipient f))) (original (createdEvent "lark" "private-origin" "private question")))
      (await (subscribe f agent "lark")) (await (subscribe f agent "lark-alt"))
      (put original :chat_type "p2p")
      (await (js-call f :ingest original)) (await (turns f 1))
      (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "private answer") :idempotency_key "private-reply")))
        (await (turns f 2))
        (let ((echo (back "lark-reply-1" "private answer")))
          (put echo :chat_type "p2p") (await (js-call f :ingest echo)) (await (turns f 2))
          (js-call (expect (js-length (inputs f))) :toBe 1))
        (let ((reply (back "actual-private-reply" "private answer")))
          (put reply :chat_type "p2p") (put reply :reply_to (js-object :id "lark-reply-1"))
          (await (js-call f :ingest reply)) (await (turns f 2))
          (js-call (expect (js-length (inputs f))) :toBe 2))))) closeFixture)

)
