(module dj.tests.integration.echo
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent createImPeer)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "cross-echo" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (let* ((source (aref (nativeGet config "connections") 0)) (other (JSON/parse (JSON/stringify source))))
        (put source :tenant_ref "network")
        (put other :connection_id "lark-alt") (put other :identity "bot") (put other :tenant_ref "network")
        (js-call (nativeGet config "connections") :push other)
        (js-call (nativeGet ports "im_ports") :set "lark-alt" (createImPeer "lark-alt"))))))))
  (defasync turns (f n) (let ((i 0)) (while (< i n) (await (js-call f :tick)) (setq i (1+ i)))))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defun back (id text)
    (let ((event (createdEvent "lark-alt" id text)))
      (put event :sender (js-object :id "self-in-this-app" :kind "human")) event))
  (withCase "T38.cross-connection-echo.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (sub nil))
      (await (subscribe f agent "lark")) (setq sub (await (subscribe f agent "lark-alt")))
      (await (js-call f :ingest (createdEvent "lark" "parent" "source"))) (await (turns f 1))
      (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "reply to self") :idempotency_key "first-reply")))
        (await (turns f 2))
        (await (js-call f :ingest (back "lark-reply-1" "reply to self")))
        (await (js-call f :ingest (back "manual-self-mention" "manual native mention")))
        (await (turns f 2))
        (js-call (expect (js-length (inputs f))) :toBe 2)
        (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t)))
          (echo (js-call (js-call db :query "SELECT w.payload,e.event_id FROM routing_work w JOIN events e ON e.event_id=w.event_id WHERE e.connection_id='lark-alt' AND e.native_message_id='lark-reply-1'") :get)))
          (js-call (expect (nativeGet (JSON/parse (nativeGet echo "payload")) "reason")) :toBe "own_echo")
          (js-call db :close)
          (let ((replay (await (js-call f :call (nativeGet f "A") "subscription.replay" (js-object :subscription_id (nativeGet sub "subscription_id")
            :event_ids (js-array (nativeGet echo "event_id")) :expected_revision 1 :idempotency_key "no-echo-replay")))))
            (js-call (expect (nativeGet replay "ok")) :toBe false)))
        ;; If proof arrives after matching, submission still cancels the exact echo.
        (put (aref (nativeGet (nativeGet f "opencode") "sessions") 0) :runtime_state "busy")
        (await (js-call f :ingest (back "lark-reply-2" "late receipt"))) (await (turns f 1))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "late receipt") :idempotency_key "second-reply")))
        (await (turns f 2))
        (put (aref (nativeGet (nativeGet f "opencode") "sessions") 0) :runtime_state "idle")
        (await (turns f 2))
        (js-call (expect (js-length (inputs f))) :toBe 2)
        (let ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
          (let ((row (js-call (js-call db :query "SELECT d.state,json_extract(d.payload,'$.blocked_reason') AS reason FROM deliveries d JOIN events e ON d.event_id=e.event_id WHERE e.native_message_id='lark-reply-2'") :get)))
            (js-call (expect (nativeGet row "state")) :toBe "cancelled")
            (js-call (expect (nativeGet row "reason")) :toBe "own_echo"))
          (js-call db :close))))) closeFixture)
  (withCase "T40.cross-connection-echo-gate.integration" setup (async (f)
    (let* ((agent (await (bindRecipient f))) (release nil) (started false))
      (await (subscribe f agent "lark")) (await (subscribe f agent "lark-alt"))
      (await (js-call f :ingest (createdEvent "lark" "gate-parent" "source"))) (await (turns f 1))
      (let ((ref (nativeGet (nativeGet (aref (inputs f) 0) "envelope") "reply_context_id")))
        (put (nativeGet f "lark") :send (async (record key context)
          (setq started t)
          (await (new globalThis.Promise (lambda (resolve) (setq release resolve))))
          (js-object :state "accepted" :native_message_id "gate-outgoing" :evidence_level "native_protocol")))
        (await (callOk f "A" "message.reply" (js-object :reply_context_id ref :content (js-object :type "text" :text "pending") :idempotency_key "gate-reply")))
        (await (turns f 1)) (js-call (expect started) :toBe t)
        (await (js-call f :ingest (back "real-human-during-send" "not the outgoing message")))
        (await (turns f 1))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (funcall release nil) (await (turns f 3))
        (js-call (expect (js-length (inputs f))) :toBe 2)))) closeFixture)
)
