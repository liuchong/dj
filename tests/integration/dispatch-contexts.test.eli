(module dj.tests.integration.dispatch-contexts
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk createdEvent createImPeer)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "dispatch-contexts" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put config :message_delivery (js-object :busy "steer" :max_in_flight 64))
      (let ((actor (aref (nativeGet config "principals") 2)))
        (Reflect/deleteProperty actor "target_constraint")
        (put actor :grants (js-array (js-object :action "*" :resources (js-array "*")))))
      (let* ((bot (aref (nativeGet config "connections") 0)) (user (JSON/parse (JSON/stringify bot)))
        (peer (js-call (nativeGet ports "agent_ports") :get "opencode")))
        (put bot :identity "bot") (put bot :event_subject_id "ou_bot") (put bot :event_app_id "bot_app")
        (put bot :tenant_ref "same-tenant")
        (put user :identity "user") (put user :connection_id "lark-user") (put user :event_subject_id "ou_user")
        (put user :event_app_id "user_app") (put user :tenant_ref "same-tenant")
        (js-call (nativeGet config "connections") :push user)
        (js-call (nativeGet ports "im_ports") :set "lark-user" (createImPeer "lark-user"))
        (put (nativeGet peer "capabilities") :message_during_run "supported")))))))
  (defasync register (f id)
    (let* ((page (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live"))))
      (candidate (js-call (nativeGet page "items") :find (lambda (row) (= (nativeGet row "native_session_id") id)))))
      (await (callOk f "A" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :display_name id :binding_mode "existing" :idempotency_key (str "register-" id))))))
  (defasync subscribe (f agent &optional mode group)
    (let* ((spec (js-object
      :rules (js-array (js-object :id "default" :enabled t
        :event_kinds (js-array "message.created" "message.reaction.added")
        :predicate (js-object :all (js-array))))
      :start "now" :delivery_mode (or mode "push"))))
      (if group (put spec :group_id (nativeGet group "group_id")) (put spec :agent_id (nativeGet agent "agent_id")))
      (let ((preview (await (callOk f "A" "subscription.preview" (js-object :expected_revision 0 :spec spec)))))
        (await (callOk f "A" "subscription.set" (js-object :preview_id (nativeGet preview "preview_id") :expected_revision 0 :idempotency_key (randomUUID)))))))
  (defasync rules (f agent)
    (await (callOk f "A" "session.rules.update" (js-object :agent_id (nativeGet agent "agent_id") :expected_revision 1
      :text "Preserve these exact rules." :reply_routes (js-array
        (js-object :source_connection_id "lark-user" :mention_id "foreign_bot" :reply_connection_id "lark")
        (js-object :source_connection_id "lark" :mention_id "foreign_user" :reply_connection_id "lark-user"))
      :idempotency_key "rules"))))
  (defun event (f connection id &optional mention thread)
    (let ((e (createdEvent connection id "same readable text" thread)))
      (put e :chat_type "group") (put e :source_time (js-call (nativeGet f "clock") :utcNow))
      (put e :mentions (if mention (js-array (js-object :id mention :key "@_user_1")) (js-array)))
      (when thread (put e :root_message_id "interaction-root")) e))
  (defun inputs (f) (nativeGet (nativeGet f "opencode") "inputs"))
  (defun lastEnvelope (f) (nativeGet (aref (inputs f) (1- (js-length (inputs f)))) "envelope"))
  (defasync turns (f &optional count)
    (let ((i 0)) (while (< i (or count 4)) (await (js-call f :tick)) (setq i (1+ i)))))
  (withCase "T40.dispatch-contexts.integration" setup (async (f)
    (let* ((agent (await (register f "s1"))) (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try
        (await (rules f agent)) (await (subscribe f agent))
        ;; User transport arrives first, but the explicit bot addressee wins.
        (await (js-call f :ingest (event f "lark-user" "dual" "foreign_bot" "t1")))
        (await (js-call f :ingest (event f "lark" "dual" "ou_bot" "t1")))
        (await (turns f))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (let* ((first (lastEnvelope f)) (identity (nativeGet first "dispatch_context"))
          (ref (nativeGet first "reply_context_id"))
          (context (await (callOk f "A" "dispatch.context.get" (js-object :delivery_id (nativeGet first "delivery_id"))))))
          (js-call (expect (nativeGet identity "connection_id")) :toBe "lark")
          (js-call (expect (nativeGet (nativeGet context "binding") "state")) :toBe "active")
          (let ((owner (await (callOk f "A" "delivery.get" (js-object :delivery_id (nativeGet first "delivery_id"))))))
            (js-call (expect (js-length (nativeGet (nativeGet owner "notification") "sources"))) :toBe 2))
          (js-call (expect (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM deliveries WHERE state='coalesced'") :get) "n")) :toBe 1)
          ;; A no-mention follow-up and a process restart inherit the same binding.
          (js-call (nativeGet f "clock") :advance 1000)
          (await (js-call f :ingest (event f "lark-user" "followup" nil "t1")))
          (await (turns f))
          (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "connection_id")) :toBe "lark")
          (await (js-call f :restart))
          (js-call (nativeGet f "clock") :advance 1000)
          (await (js-call f :ingest (event f "lark-user" "after-restart" nil "t1")))
          (await (turns f))
          (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "identity_binding_id")) :toBe (nativeGet identity "identity_binding_id"))
          ;; Explicit new @ selects user from this message onward, preserving old refs.
          (js-call (nativeGet f "clock") :advance 1000)
          (await (js-call f :ingest (event f "lark" "new-user" "foreign_user" "t1")))
          (await (turns f))
          (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "connection_id")) :toBe "lark-user")
          (let ((send (await (callOk f "A" "message.reply" (js-object :reply_context_id ref
            :content (js-object :type "text" :text "Old message keeps bot identity") :idempotency_key "old-reply")))))
            (await (turns f))
            (js-call (expect (nativeGet (nativeGet (await (callOk f "A" "outbound.get" (js-object :outbound_id (nativeGet send "outbound_id")))) "destination") "connection_id")) :toBe "lark"))
          (let* ((current (await (callOk f "A" "dispatch.context.get" (js-object :context_id (nativeGet context "context_id")))))
            (args (js-object :context_id (nativeGet current "context_id") :expected_binding_id (nativeGet current "binding_id")
              :connection_id "lark" :explicit t :reason "User explicitly transfers identity" :idempotency_key "transfer"))
            (moved (await (callOk f "A" "dispatch.context.transfer" args))))
            (js-call (expect (nativeGet (nativeGet moved "binding") "connection_id")) :toBe "lark")
            (let ((same (await (callOk f "A" "dispatch.context.transfer" args))))
              (js-call (expect (nativeGet same "binding_id")) :toBe (nativeGet moved "binding_id")))
            (let ((stale (await (js-call f :call (nativeGet f "A") "dispatch.context.transfer"
              (Object/assign (js-object) args (js-object :idempotency_key "stale-transfer"))))))
              (js-call (expect (nativeGet (nativeGet stale "error") "code")) :toBe "stale_reference")))
          (js-call (nativeGet f "clock") :advance 1000)
          (await (js-call f :ingest (event f "lark-user" "manual-followup" nil "t1")))
          (await (turns f))
          (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "connection_id")) :toBe "lark")
          ;; Quoting an accepted outbound inherits its interaction even when no
          ;; incoming echo of that outbound has been stored.
          (let* ((sent (js-call (js-call db :query "SELECT native_message_id FROM echo_index LIMIT 1") :get))
            (quote (event f "lark-user" "quote-outbound")))
            (js-call (nativeGet f "clock") :advance 1000)
            (put quote :reply_to (js-object :id (nativeGet sent "native_message_id")))
            (await (js-call f :ingest quote)) (await (turns f))
            (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "context_id")) :toBe (nativeGet context "context_id"))
            (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "connection_id")) :toBe "lark"))
          ;; Old native-time input cannot roll the binding back.
          (let ((late (event f "lark-user" "older-input" "ou_user" "t1")))
            (put late :source_time "2026-01-01T00:00:00.500Z")
            (await (js-call f :ingest late)) (await (turns f))
            (let ((now (await (callOk f "A" "dispatch.context.get" (js-object :context_id (nativeGet context "context_id"))))))
              (js-call (expect (nativeGet (nativeGet now "binding") "connection_id")) :toBe "lark")))
          (let ((saved (await (callOk f "A" "session.rules.get" (js-object :agent_id (nativeGet agent "agent_id"))))))
            (js-call (expect (nativeGet saved "text")) :toBe "Preserve these exact rules.")))
        (finally (js-call db :close))))) closeFixture)
  (withCase "T40.dispatch-reservations.integration" setup (async (f)
    (let* ((agent (await (register f "s1"))) (peer (nativeGet f "opencode"))
      (db (new Database (resolve (nativeGet f "root") "state/dj.sqlite") (js-object :readonly t))))
      (try
        (await (rules f agent)) (await (subscribe f agent))
        (put (nativeGet peer "behavior") :submit "throw")
        (await (js-call f :ingest (event f "lark" "uncertain" "ou_bot"))) (await (turns f))
        (await (js-call f :ingest (event f "lark-user" "uncertain" "foreign_bot"))) (await (turns f))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (js-call (expect (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM deliveries WHERE state='deferred' AND json_extract(payload,'$.blocked_reason')='notification_pending'") :get) "n")) :toBe 1)
        ;; Explicitly close the uncertain attempt without claiming delivery;
        ;; this permits a graceful fixture restart, and still forbids retry.
        (let ((row (js-call (js-call db :query "SELECT delivery_id,revision FROM deliveries WHERE state='unknown' LIMIT 1") :get)))
          (await (callOk f "O" "delivery.resolve" (js-object :delivery_id (nativeGet row "delivery_id")
            :expected_revision (nativeGet row "revision") :resolution "abandon_no_retry" :reason "Close uncertain test attempt without retry" :idempotency_key "abandon"))))
        (await (js-call f :restart)) (await (turns f))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (finally (js-call db :close))))) closeFixture)
  (withCase "T40.dispatch-definite-unsent.integration" setup (async (f)
    (let* ((agent (await (register f "s1"))) (peer (nativeGet f "opencode")))
      (await (rules f agent)) (await (subscribe f agent))
      (put (nativeGet peer "behavior") :submit "definite_not_sent")
      (await (js-call f :ingest (event f "lark" "retry-safe" "ou_bot"))) (await (turns f))
      (put (nativeGet peer "behavior") :submit "accepted")
      (await (js-call f :ingest (event f "lark-user" "retry-safe" "foreign_bot"))) (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (js-call (expect (nativeGet (nativeGet (lastEnvelope f) "dispatch_context") "connection_id")) :toBe "lark")
      (js-call (nativeGet f "clock") :advance 5000) (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 2))) closeFixture)
  (withCase "T40.dispatch-many-targets.integration" setup (async (f)
    (let ((a (await (register f "s1"))) (b (await (register f "s2"))))
      (await (rules f a)) (await (subscribe f a)) (await (subscribe f b))
      (await (js-call f :ingest (event f "lark" "many-targets" "ou_bot")))
      (await (js-call f :ingest (event f "lark-user" "many-targets" "foreign_bot")))
      (await (turns f))
      (js-call (expect (js-length (inputs f))) :toBe 2)
      (let ((targets (new globalThis.Set (js-call (inputs f) :map (lambda (input) (nativeGet (nativeGet input "binding") "native_session_id"))))))
        (js-call (expect (nativeGet targets "size")) :toBe 2)))) closeFixture)
  (withCase "T40.dispatch-pull-group.integration" setup (async (f)
    (let* ((a (await (register f "s1"))) (b (await (register f "s2")))
      (sub (await (subscribe f a "pull"))))
      (await (rules f a))
      (await (js-call f :ingest (event f "lark" "pull-dual" "ou_bot")))
      (await (js-call f :ingest (event f "lark-user" "pull-dual" "foreign_bot")))
      (await (turns f))
      (let ((first (await (callOk f "A" "subscription.pull" (js-object :agent_id (nativeGet a "agent_id") :idempotency_key "pull-one")))))
        (js-call (expect (nativeGet first "empty")) :toBe false)
        (await (callOk f "A" "subscription.ack" (js-object :claim_ref (nativeGet (nativeGet first "item") "claim_ref") :disposition "consumed" :idempotency_key "ack"))))
      (let ((next (await (callOk f "A" "subscription.pull" (js-object :agent_id (nativeGet a "agent_id") :idempotency_key "pull-two")))))
        (js-call (expect (nativeGet next "empty")) :toBe t))
      (let* ((group (await (callOk f "A" "subscription.group.create" (js-object :name "group" :members
        (js-array (js-object :agent_id (nativeGet a "agent_id")) (js-object :agent_id (nativeGet b "agent_id"))) :idempotency_key "group"))))
        (group-sub (await (subscribe f nil "push" group))))
        (js-call (expect (nativeGet group-sub "state")) :toBe "active")
        (await (js-call f :ingest (event f "lark" "group-dual" "ou_bot")))
        (await (js-call f :ingest (event f "lark-user" "group-dual" "foreign_bot")))
        (await (turns f 8))
        (js-call (expect (js-length (inputs f))) :toBe 1)
        (let ((page (await (callOk f "A" "subscription.group.dispatches" (js-object :group_id (nativeGet group "group_id"))))))
          (js-call (expect (js-call (nativeGet page "items") :some (lambda (row) (= (nativeGet row "state") "coalesced")))) :toBe t))))) closeFixture))
