  ;; Per-operation root/unknown/missing cases test the actual authoritative schema.
  ;; Transport parity cases below will additionally exercise real proxy processes.
  (js-call
    (nativeGet manifest "cases")
    :forEach
    (lambda
      (meta)
      (let ((id (nativeGet meta "case_id")))
        (when
          (and (= (nativeGet meta "parent_id") "T26") (nativeGet (nativeGet meta "parameters") "operation"))
          (withCase
            id
            setup
            (async
              (f)
              (let*
                ((params (nativeGet meta "parameters"))
                  (operation (nativeGet params "operation"))
                  (descriptor
                    (js-call
                      vectors
                      :find
                      (lambda (row) (= (nativeGet row "operation") operation))))
                  (input
                    (if (= (nativeGet params "kind") "root-type")
                      (nativeGet params "value")
                      (JSON/parse (JSON/stringify (nativeGet descriptor "valid_arguments")))))
                  (kind (nativeGet params "kind")))
                (js-call
                  (expect
                    (nativeGet
                      (validateRequest
                        operation
                        (JSON/parse (JSON/stringify (nativeGet descriptor "valid_arguments"))))
                    "ok"))
                :toBe
                t)
              (cond
                ((= kind "wrong-field-type")
                  (put input (nativeGet params "field") (nativeGet params "value")))
                ((= kind "unknown-field") (put input :__unknown_field "rejected"))
                ((= kind "missing-field")
                  ;; Each XOR alternative starts present in its own valid form.
                  (when (js-call (nativeGet descriptor "exclusive_fields") :includes (nativeGet params "field"))
                    (js-call (nativeGet descriptor "exclusive_fields") :forEach
                      (lambda (name) (Reflect/deleteProperty input name)))
                    (put input (nativeGet params "field") "test-ref")
                    (js-call (expect (nativeGet (validateRequest operation input) "ok")) :toBe t))
                  (Reflect/deleteProperty input (nativeGet params "field")))
                ((= kind "xor-none")
                  (js-call
                    (nativeGet descriptor "exclusive_fields")
                    :forEach
                    (lambda (name) (Reflect/deleteProperty input name))))
                ((= kind "xor-both")
                  (js-call
                    (nativeGet descriptor "exclusive_fields")
                    :forEach
                    (lambda (name) (put input name "test-ref")))))
              (let ((result (await (js-call f :call (nativeGet f "O") operation input))))
                (js-call (expect (nativeGet result "ok")) :toBe false)
                (js-call
                  (expect (nativeGet (nativeGet result "error") "code"))
                  :toBe
                  "invalid_argument")
                (js-call (expect (nativeGet result "effect_state")) :toBe "none")
                (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
                (js-call (expect (js-length (nativeGet (nativeGet f "lark") "sent"))) :toBe 0))))
          closeFixture)))))
