  (defun comparable
    (result)
    (js-object
      :ok
      (nativeGet result "ok")
      :effect_state
      (nativeGet result "effect_state")
      :code
      (nativeGet (nativeGet result "error" (js-object)) "code")
      :field_errors
      (nativeGet (nativeGet result "error" (js-object)) "field_errors")))
  (js-call
    cases
    :forEach
    (lambda
      (meta)
      (when (and (= (nativeGet meta "parent_id") "T55") (nativeGet (nativeGet meta "parameters") "entry"))
        (withCase
          (nativeGet meta "case_id")
          setupEntry
          (async
            (p)
            (let*
              ((params (nativeGet meta "parameters"))
                (operation (nativeGet params "operation"))
                (args (js-object :__unknown_field "reject-this-field"))
                (reference (await (js-call p :request "O" operation args)))
                (actual nil))
              (cond
                ((= (nativeGet params "entry") "api")
                  (setq actual (await (js-call p :request "O" operation args))))
                ((= (nativeGet params "entry") "cli")
                  (setq actual (nativeGet (await (callCli p "O" operation args)) "envelope")))
                ((= (nativeGet params "entry") "mcp")
                  (let ((client (await (createMcpClient p "O"))))
                    (try
                      (setq actual (await (js-call client :call operation args)))
                      (finally (await (js-call client :close)))))))
              (js-call (expect (nativeGet reference "ok")) :toBe false)
              (js-call
                (expect (nativeGet (nativeGet reference "error") "code"))
                :toBe
                "invalid_argument")
              (js-call (expect (comparable actual)) :toEqual (comparable reference))
              (js-call (expect (nativeGet actual "effect_state")) :toBe "none")))
          closeProcess))))
