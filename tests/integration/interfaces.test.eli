  (defasync skillCliTest (args)
    (let* ((child (Bun/spawn
             (js-call (js-array (nativeGet globalThis.process "execPath") "dist/src/interfaces/cli.mjs" "skill") :concat args)
             (js-object :stdin "ignore" :stdout "pipe" :stderr "pipe")))
           (values (await (Promise/all (js-array
             (js-call (new globalThis.Response (nativeGet child "stdout")) :text)
             (js-call (new globalThis.Response (nativeGet child "stderr")) :text)
             (nativeGet child "exited")))))
           (text (if (= (aref values 2) 0) (aref values 0) (aref values 1))))
      (js-object :exit_code (aref values 2) :result (JSON/parse text))))
  (defasync exerciseSkillCli (project)
    (let* ((prefix (js-array "--target" "codex" "--scope" "project" "--project" project))
           (cursor (js-array "--target" "cursor" "--scope" "project" "--project" project)))
      (mkdirSync project (js-object :mode 448))
      (let ((planned (await (skillCliTest (js-call (js-array "install") :concat prefix (js-array "--dry-run"))))))
        (js-call (expect (nativeGet planned "exit_code")) :toBe 0)
        (js-call (expect (nativeGet (nativeGet (nativeGet planned "result") "data") "state")) :toBe "planned")
        (js-call (expect (existsSync (resolve project ".agents"))) :toBe false))
      (let* ((installed (await (skillCliTest (js-call (js-array "install") :concat prefix))))
             (data (nativeGet (nativeGet installed "result") "data")))
        (js-call (expect (nativeGet data "state")) :toBe "installed")
        (js-call (expect (nativeGet data "client_adoption")) :toBe "unverified")
        (js-call (expect (nativeGet data "agent_started")) :toBe false)
        (js-call (expect (readFileSync (resolve project ".agents/skills/dj/SKILL.md") "utf8")) :toBe
          (readFileSync "skills/dj/SKILL.md" "utf8"))
        (js-call (expect (readFileSync (resolve project ".agents/skills/dj/references/clients.md") "utf8")) :toBe
          (readFileSync "skills/dj/references/clients.md" "utf8")))
      (js-call (expect (nativeGet (nativeGet (nativeGet
        (await (skillCliTest (js-call (js-array "install") :concat prefix))) "result") "data") "state")) :toBe "unchanged")
      (js-call (expect (nativeGet (await (skillCliTest (js-call (js-array "check") :concat prefix))) "exit_code")) :toBe 0)
      (js-call (expect (nativeGet (await (skillCliTest (js-call (js-array "install") :concat cursor))) "exit_code")) :toBe 0)
      (let* ((profile (resolve project "recipient.json"))
             (codex-config (nativeGet (nativeGet (await (skillCliTest
               (js-array "config" "--target" "codex" "--client-profile" profile))) "result") "data"))
             (toml (js-call (nativeGet globalThis.Bun "TOML") :parse (nativeGet codex-config "config")))
             (cursor-config (nativeGet (nativeGet (await (skillCliTest
               (js-array "config" "--target" "cursor" "--client-profile" profile))) "result") "data")))
        (js-call (expect (nativeGet (nativeGet (nativeGet toml "mcp_servers") "dj") "args")) :toEqual
          (nativeGet (nativeGet (nativeGet (nativeGet cursor-config "config") "mcpServers") "dj") "args"))
        (js-call (expect (existsSync profile)) :toBe false)
        (js-call (expect (existsSync (resolve project ".cursor/mcp.json"))) :toBe false)
        (let* ((options (js-array "--client-profile" profile "--agent" "agent-local" "--subscription" "sub-local"))
               (codex-hooks (nativeGet (nativeGet (await (skillCliTest
                 (js-call (js-array "hooks" "--target" "codex") :concat options))) "result") "data"))
               (cursor-hooks (nativeGet (nativeGet (await (skillCliTest
                 (js-call (js-array "hooks" "--target" "cursor") :concat options))) "result") "data")))
          (js-call (expect (js-length (nativeGet (nativeGet (nativeGet codex-hooks "config") "hooks") "UserPromptSubmit"))) :toBe 1)
          (js-call (expect (nativeGet (aref (nativeGet (nativeGet (nativeGet cursor-hooks "config") "hooks") "stop") 0) "loop_limit")) :toBe 1)
          (js-call (expect (nativeGet cursor-hooks "client_config_modified")) :toBe false)
          (js-call (expect (existsSync (resolve project ".cursor/hooks.json"))) :toBe false)
          (js-call (expect (nativeGet (nativeGet (nativeGet (await (skillCliTest
            (js-call (js-array "hooks" "--target" "pi") :concat options))) "result") "error") "code")) :toBe "unsupported")))
      (let ((path (resolve project ".cursor/skills/dj/SKILL.md")))
        (writeFileSync path "caller-owned conflict")
        (js-call (expect (nativeGet (await (skillCliTest (js-call (js-array "install") :concat cursor))) "exit_code")) :toBe 2)
        (js-call (expect (readFileSync path "utf8")) :toBe "caller-owned conflict"))
      (let ((linked (resolve project "linked-project")))
        (mkdirSync linked)
        (symlinkSync (resolve project ".agents") (resolve linked ".agents"))
        (js-call (expect (nativeGet (await (skillCliTest (js-array "install" "--target" "codex"
          "--scope" "project" "--project" linked))) "exit_code")) :toBe 2))))
  (defasync requestGepo (p actor path method &optional args extra)
    (let* ((headers (Object/assign (js-object :content-type "application/json") extra))
           (options (js-object :unix (nativeGet p "socket") :method method :headers headers)))
      (when actor (put headers :authorization (str "Bearer " (nativeGet (nativeGet p "credentials") actor))))
      (when args (put options :body (if (= (nativeTypeOf args) "string") args (JSON/stringify args))))
      (let* ((response (await (nativeFetch (str "http://localhost" path) options)))
             (text (await (js-call response :text))))
        (js-object :status (nativeGet response "status") :text text
          :type (js-call (nativeGet response "headers") :get "content-type")))))
  (defasync exerciseNativeHooks ()
    (let ((targets (js-array "codex" "cursor")) (index 0))
      (while (< index (js-length targets))
        (let* ((tool (aref targets index))
               (f (await (createFixture "hooks" tool (js-object :configure
                 (lambda (config ports)
                   (put config :managed_profiles (js-array))
                   (let* ((old (js-call (nativeGet ports "agent_ports") :get "opencode"))
                          (session (Object/assign (js-object) (aref (nativeGet old "sessions") 0)
                            (js-object :tool tool :native_namespace "ns-hooks" :native_session_id "hook-session")))
                          (principal (js-call (nativeGet config "principals") :find (lambda (p) (= (nativeGet p "principal_id") "A")))))
                     (js-call (nativeGet ports "agent_ports") :set tool (createAgentPeer tool (js-array session)))
                     (put config :agent_endpoints (js-array (js-object :tool tool :instance_id "oc-existing"
                       :native_namespace "ns-hooks" :ownership "existing" :endpoint_ref "test:hooks" :workspace_refs (js-array "ws-test")
                       :workspace_ref "ws-test" :directory (nativeGet config "config_root")
                       :history_database "state/hook-history.sqlite" :socket_path "run/controlled-peer.sock"
                       :manifest_path "run/controlled-manifest.json" :window_id 1)))
                     (put principal :target_constraint (js-object :tool tool :native_namespace "ns-hooks" :native_session_id "hook-session"))
                     (js-call (nativeGet principal "grants") :push (js-object :action "subscription.consume" :resources (js-array "self")))))))))
               (socket (resolve (nativeGet f "root") "run/hooks.sock")) (server nil))
          (try
            (await (prepareSocket socket))
            (setq server (Bun/serve (js-object :unix socket :fetch
              (lambda (request) (handleServiceRequest request (nativeGet f "core"))))))
            (let* ((candidate (aref (nativeGet (await (callOk f "O" "agent.discover" (js-object :tool tool :scope "live"))) "items") 0))
                   (agent (await (callOk f "O" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
                     :binding_mode "existing" :recipient_principal_id "A" :display_name "hook target" :idempotency_key "hook-agent"))))
                   (source (await (callOk f "A" "conversation.resolve" (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))))
                   (preview (await (callOk f "A" "subscription.preview" (js-object :spec
                     (js-object :agent_id (nativeGet agent "agent_id") :delivery_mode "pull"
                       :instruction_policy (js-object :prompt "authorized hook work")
                       :selector (js-object :sources (js-array (js-object :conversation_ref (nativeGet source "conversation_ref")))))))))
                   (subscription (await (callOk f "A" "subscription.create"
                     (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "hook-sub"))))
                   (p (js-object :root (nativeGet f "root") :credentials (nativeGet f "credentials")))
                   (profile (await (writeClientProfile p "A")))
                   (profile-data (JSON/parse (readFileSync profile "utf8")))
                   (input (if (= tool "codex") (js-object :hook_event_name "UserPromptSubmit" :session_id "hook-session" :turn_id "turn-1")
                     (js-object :hook_event_name "stop" :conversation_id "hook-session" :generation_id "turn-1" :status "completed" :loop_count 0)))
                   (run (async (event)
                     (let* ((child (Bun/spawn (js-array (nativeGet globalThis.process "execPath") "dist/src/interfaces/cli.mjs"
                               "hook" "pull" "--target" tool "--client-profile" profile "--agent" (nativeGet agent "agent_id")
                               "--subscription" (nativeGet subscription "subscription_id"))
                               (js-object :stdin (new globalThis.Blob (js-array (JSON/stringify event))) :stdout "pipe" :stderr "pipe")))
                            (out (await (Promise/all (js-array (js-call (new globalThis.Response (nativeGet child "stdout")) :text)
                              (js-call (new globalThis.Response (nativeGet child "stderr")) :text) (nativeGet child "exited"))))))
                       (js-call (expect (aref out 2)) :toBe 0)
                       (js-call (expect (js-call (aref out 1) :includes (nativeGet (nativeGet f "credentials") "A"))) :toBe false)
                       (JSON/parse (aref out 0))))))
              (put (aref (nativeGet profile-data "endpoints") 0) :socket_ref socket)
              (writeFileSync profile (JSON/stringify profile-data) (js-object :mode 384))
              ;; Empty polls stay empty for this native turn, even after arrival.
              (js-call (expect (await (funcall run input))) :toEqual (js-object))
              (await (js-call f :ingest (createdEvent "lark" "hook-event" "external hook data")))
              (await (js-call f :tick))
              (js-call (expect (await (funcall run input))) :toEqual (js-object))
              (put input (if (= tool "codex") "turn_id" "generation_id") "turn-2")
              (let* ((output (await (funcall run input)))
                     (context (if (= tool "codex") (nativeGet (nativeGet output "hookSpecificOutput") "additionalContext")
                       (nativeGet output "followup_message")))
                     (item (JSON/parse (js-call context :slice (1+ (js-call context :indexOf "\n"))))))
                (js-call (expect (js-call context :includes "external hook data")) :toBe t)
                (js-call (expect (js-call context :includes "authorized hook work")) :toBe t)
                (js-call (expect (await (funcall run input))) :toEqual output)
                (let ((wrong (Object/assign (js-object) input)))
                  (put wrong (if (= tool "codex") "session_id" "conversation_id") "foreign-session")
                  (js-call (expect (await (funcall run wrong))) :toEqual (js-object)))
                (when (= tool "cursor")
                  (put input :loop_count 1)
                  (js-call (expect (await (funcall run input))) :toEqual (js-object))
                  (put input :loop_count 0) (put input :status "aborted")
                  (js-call (expect (await (funcall run input))) :toEqual (js-object))
                  (put input :status "completed"))
                (let ((ack (await (callOk f "A" "subscription.ack"
                             (js-object :claim_ref (nativeGet item "claim_ref") :disposition "consumed" :idempotency_key "hook-ack")))))
                  (js-call (expect (nativeGet ack "state")) :toBe "consumed"))
                (js-call (expect (await (funcall run input))) :toEqual (js-object)))
              (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0))
            (finally
              (when server (js-call server :stop t))
              (await (closeFixture f)))))
        (setq index (1+ index)))))
  (withCase
    "T18.cli-mcp-api-single-operation.integration"
    setupEntry
    (async
      (p)
      (await (exerciseNativeHooks))
      (let*
        ((session (await (senderSession p)))
          (args
            (js-object
              :session_ref
              (nativeGet session "session_ref")
              :content
              (js-object
                :type
                "text"
                :text
                "one logical mutation through three entries")
              :idempotency_key
              "entry-shared-key"))
          (cli (nativeGet (await (callCli p "S" "session.send" args)) "envelope"))
          (mcp (await (createMcpClient p "S"))))
        (try
          (let*
            ((skill-check (await (exerciseSkillCli (resolve (nativeGet p "root") "skill-project"))))
              (mcp-result (await (js-call mcp :call "session.send" args)))
              (api-result (await (js-call p :request "S" "session.send" args)))
              (lookup
                (await
                  (js-call
                    p
                    :request
                    "S"
                    "operation.get"
                    (js-object
                      :operation
                      "session.send"
                      :idempotency_key
                      "entry-shared-key")))))
            (js-call (expect (nativeGet cli "ok")) :toBe t)
            (js-call
              (expect (nativeGet mcp-result "operation_id"))
              :toBe
              (nativeGet cli "operation_id"))
            (js-call
              (expect (nativeGet api-result "operation_id"))
              :toBe
              (nativeGet cli "operation_id"))
            (js-call
              (expect (nativeGet (nativeGet lookup "data") "operation_id"))
              :toBe
              (nativeGet cli "operation_id"))
            (js-call
              (expect (nativeGet (nativeGet mcp-result "data") "delivery_id"))
              :toBe
              (nativeGet (nativeGet cli "data") "delivery_id"))
            ;; GEPO discovery/usage are metadata, not another execution.
            (let ((root (await (requestGepo p "S" "/.well-known/gepo" "GET")))
                  (index (await (requestGepo p "S" "/session?.gepo" "GET")))
                  (usage (await (requestGepo p "S" "/session/send" "GET")))
                  (head (await (requestGepo p "S" "/session/send" "HEAD"))))
              (js-call (expect (nativeGet root "status")) :toBe 200)
              (js-call (expect (js-call (nativeGet root "text") :includes "GEPO 0.2")) :toBe t)
              (js-call (expect (js-call (nativeGet index "text") :includes "`/session/send`")) :toBe t)
              (js-call (expect (js-call (nativeGet usage "type") :startsWith "text/markdown")) :toBe t)
              (js-call (expect (js-call (nativeGet usage "text") :includes "idempotency_key")) :toBe t)
              (js-call (expect (nativeGet head "text")) :toBe ""))
            (let* ((reply (await (requestGepo p "S" "/session/send" "POST" args)))
                   (gepo (JSON/parse (nativeGet reply "text"))))
              (js-call (expect (nativeGet gepo "ok")) :toBe t)
              (js-call (expect (nativeGet gepo "operation_id")) :toBe (nativeGet cli "operation_id"))
              (js-call (expect (nativeGet (nativeGet gepo "data") "delivery_id"))
                :toBe (nativeGet (nativeGet cli "data") "delivery_id")))
            (js-call (expect (nativeGet (await (requestGepo p nil "/.gepo" "GET")) "status")) :toBe 401)
            (js-call (expect (nativeGet (await (requestGepo p "S" "/instance/start" "GET")) "status")) :toBe 404)
            (js-call (expect (nativeGet (await (requestGepo p "S" "/service/status" "GET" nil
              (js-object :origin "https://untrusted.invalid"))) "status")) :toBe 403)
            (js-call (expect (nativeGet (await (requestGepo p "S" "/service/status" "POST" "{")) "status")) :toBe 400)
            (js-call (expect (nativeGet (await (requestGepo p "S" "/service/status" "GET" nil
              (js-object :x-dj-operation-catalog-digest (js-call "0" :repeat 64)))) "status")) :toBe 400)
            (let* ((bad (await (requestGepo p "S" "/session/send" "POST" (js-object :unexpected t))))
                   (result (JSON/parse (nativeGet bad "text"))))
              (js-call (expect (nativeGet result "ok")) :toBe false)
              (js-call (expect (nativeGet result "effect_state")) :toBe "none"))
            (await (js-call p :control (js-object :kind "tick")))
            (js-call
              (expect
                (nativeGet (await (js-call p :control (js-object :kind "stats"))) "inputs"))
              :toBe
              1)
            (let ((recipient (await (createMcpClient p "A"))))
              (try
                (let* ((candidates (nativeGet (nativeGet (await (js-call p :request "O" "agent.discover"
                                     (js-object :tool "opencode" :scope "live"))) "data") "items"))
                       (candidate (js-call candidates :find (lambda (c) (= (nativeGet c "native_session_id") "s1"))))
                       (agent (nativeGet (await (js-call p :request "O" "agent.register"
                         (js-object :candidate_ref (nativeGet candidate "candidate_ref") :binding_mode "existing"
                           :recipient_principal_id "A" :display_name "pull target" :idempotency_key "entry-pull-agent"))) "data"))
                       (source (nativeGet (await (js-call p :request "A" "conversation.resolve"
                         (js-object :connection_id "lark" :chat_id "c1" :thread_id nil))) "data"))
                       (preview (await (js-call recipient :call "subscription.preview"
                         (js-object :spec (js-object :agent_id (nativeGet agent "agent_id") :delivery_mode "pull"
                           :instruction_policy (js-object :task_template "process {{message.text}}")
                           :selector (js-object :sources (js-array (js-object :conversation_ref (nativeGet source "conversation_ref")))))))))
                       (subscription (await (js-call recipient :call "subscription.create"
                         (js-object :preview_id (nativeGet (nativeGet preview "data") "preview_id") :idempotency_key "entry-pull-sub")))))
                  (js-call (expect (nativeGet preview "ok")) :toBe t)
                  (js-call (expect (nativeGet subscription "ok")) :toBe t)
                  (await (js-call p :control (js-object :kind "ingest" :event (createdEvent "lark" "entry-pull-event" "pull message"))))
                  (await (js-call p :control (js-object :kind "tick")))
                  (let* ((args (js-object :subscription_id (nativeGet (nativeGet subscription "data") "subscription_id")
                                 :idempotency_key "entry-pull-claim"))
                         (claimed (await (js-call recipient :call "subscription.pull" args)))
                         (claim (nativeGet (nativeGet (nativeGet claimed "data") "item") "claim_ref"))
                         (gepo (JSON/parse (nativeGet (await (requestGepo p "A" "/subscription/pull" "POST" args)) "text"))))
                    (js-call (expect (nativeGet claimed "ok")) :toBe t)
                    (js-call (expect (nativeGet gepo "ok")) :toBe t)
                    (js-call (expect (nativeGet (nativeGet (nativeGet gepo "data") "item") "claim_ref")) :toBe claim)
                    (let ((acked (await (js-call recipient :call "subscription.ack"
                            (js-object :claim_ref claim :disposition "consumed" :idempotency_key "entry-pull-ack")))))
                      (js-call (expect (nativeGet acked "ok")) :toBe t)
                      (js-call (expect (nativeGet (nativeGet acked "data") "state")) :toBe "consumed"))))
                (finally (await (js-call recipient :close))))))
          (finally (await (js-call mcp :close))))))
    closeProcess)
  (withCase
    "T55.mcp-descriptors-and-errors.integration"
    setupEntry
    (async
      (p)
      (let ((client (await (createMcpClient p "O"))))
        (try
          (let*
            ((listed (await (js-call client :request "tools/list" (js-object))))
              (tools (nativeGet listed "tools"))
              (read
                (js-call
                  tools
                  :find
                  (lambda (tool) (= (nativeGet tool "name") "dj_session_list"))))
              (send
                (js-call
                  tools
                  :find
                  (lambda (tool) (= (nativeGet tool "name") "dj_session_send"))))
              (raw
                (await
                  (js-call
                    client
                    :request
                    "tools/call"
                    (js-object
                      :name
                      "dj_session_search"
                      :arguments
                      (js-object :query "business error inside valid protocol shell"))))))
            (js-call (expect (js-length tools)) :toBe 61)
            (js-call (expect (nativeGet (nativeGet read "annotations") "readOnlyHint")) :toBe t)
            (js-call (expect (nativeGet (nativeGet send "annotations") "readOnlyHint")) :toBe false)
            (js-call (expect (nativeGet (nativeGet send "annotations") "idempotentHint")) :toBe t)
            (js-call
              (expect (nativeGet send "inputSchema"))
              :toEqual
              (nativeGet (js-call operationCatalog :get "session.send") "input_schema"))
            (js-call
              (expect (nativeGet (nativeGet send "inputSchema") "additionalProperties"))
              :toBe
              false)
            (js-call (expect (nativeGet send "outputSchema")) :toBeDefined)
            (js-call (expect (nativeGet raw "isError")) :toBe t)
            (js-call
              (expect (nativeGet (nativeGet raw "structuredContent") "effect_state"))
              :toBe
              "none")
            (js-call
              (expect (nativeGet (nativeGet (nativeGet raw "structuredContent") "error") "code"))
              :toBe
              "invalid_argument")
            (let ((protocol-error false))
              (try
                (await (js-call client :request "not-a-protocol-method" (js-object)))
                (catch failure (setq protocol-error t)))
              (js-call (expect protocol-error) :toBe t)
              (js-call
                (expect
                  (js-call
                    (nativeGet client "messages")
                    :some
                    (lambda
                      (message)
                      (= (nativeGet (nativeGet message "error" (js-object)) "code") -32601))))
                :toBe
                t)))
          (finally (await (js-call client :close))))))
    closeProcess)
  (defasync rawApi
    (p actor wire &optional signal)
    (let
      (
        (response
          (await
            (nativeFetch
              "http://localhost/v1/operations"
              (js-object
                :unix
                (nativeGet p "socket")
                :method
                "POST"
                :signal
                signal
                :headers
                (js-object
                  :content-type
                  "application/json"
                  :authorization
                  (str "Bearer " (nativeGet (nativeGet p "credentials") actor)))
                :body
                (JSON/stringify wire))))))
      (await (js-call response :json))))
  (js-call
    (js-array "before" "after")
    :forEach
    (lambda
      (phase)
      (withCase
        (str "T29.transport-loss.integration." phase)
        setupEntry
        (async
          (p)
          (let*
            ((session (await (senderSession p)))
              (key (str "timeout-" phase))
              (args
                (js-object
                  :session_ref
                  (nativeGet session "session_ref")
                  :content
                  (js-object :type "text" :text "one late acceptance")
                  :idempotency_key
                  key))
              (controller (new globalThis.AbortController)))
            (await
              (js-call
                p
                :control
                (js-object :kind "hold-operation" :phase phase :idempotency_key key)))
            (let
              ((disconnected false)
                (request
                  (js-call
                    (rawApi
                      p
                      "S"
                      (js-object
                        :api_version
                        "1"
                        :operation
                        "session.send"
                        :arguments
                        args)
                      (nativeGet controller "signal"))
                    :catch
                    (lambda (failure) nil))))
              (await
                (until
                  "controlled request boundary"
                  (async
                    ()
                    (js-call
                      (nativeGet
                        (await (js-call p :control (js-object :kind "stats")))
                        "holds")
                      :some
                      (lambda
                        (hold)
                        (and (= (nativeGet hold "idempotency_key") key) (nativeGet hold "entered")))))
                  10000))
              (js-call controller :abort)
              (js-call (expect (await request)) :toBe nil)
              (let
                (
                  (lookup
                    (await
                      (js-call
                        p
                        :request
                        "S"
                        "operation.get"
                        (js-object :operation "session.send" :idempotency_key key)))))
                (if (= phase "before")
                  (js-call (expect (nativeGet (nativeGet lookup "error") "code")) :toBe "not_found")
                  (js-call (expect (nativeGet lookup "ok")) :toBe t)))
              (await
                (js-call
                  p
                  :control
                  (js-object :kind "release-operation" :idempotency_key key)))
              (let*
                ((replay (nativeGet (await (callCli p "S" "session.send" args)) "envelope"))
                  (found
                    (await
                      (js-call
                        p
                        :request
                        "S"
                        "operation.get"
                        (js-object :operation "session.send" :idempotency_key key)))))
                (js-call (expect (nativeGet replay "ok")) :toBe t)
                (js-call
                  (expect (nativeGet (nativeGet found "data") "operation_id"))
                  :toBe
                  (nativeGet replay "operation_id")))
              (await (js-call p :control (js-object :kind "tick")))
              (js-call
                (expect
                  (nativeGet (await (js-call p :control (js-object :kind "stats"))) "inputs"))
                :toBe
                1))))
        closeProcess)))
  (js-call
    (js-array "version" "extra-field" "oversized")
    :forEach
    (lambda
      (variant)
      (withCase
        (str "T26.api-wire.integration." variant)
        setupEntry
        (async
          (p)
          (let
            (
              (wire
                (js-object
                  :api_version
                  "1"
                  :operation
                  "service.status"
                  :arguments
                  (js-object))))
            (cond ((= variant "version") (put wire :api_version "999"))
              ((= variant "extra-field") (put wire :principal_id "O"))
              ((= variant "oversized")
                (put (nativeGet wire "arguments") :text (js-call "x" :repeat 262145))))
            (let ((result (await (rawApi p "S" wire))))
              (js-call (expect (nativeGet result "ok")) :toBe false)
              (js-call (expect (nativeGet result "effect_state")) :toBe "none"))
            (let ((stats (await (js-call p :control (js-object :kind "stats")))))
              (js-call (expect (nativeGet stats "inputs")) :toBe 0)
              (js-call (expect (nativeGet stats "starts")) :toBe 0)
              (js-call (expect (nativeGet stats "creates")) :toBe 0))))
        closeProcess))))
