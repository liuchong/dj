                   :parameters (js-object :run_id "cli-test" :duration_ms 60000 :interval_ms 100)))
                 (child (Bun/spawn (js-array (nativeGet globalThis.process "execPath")
                   (resolve "dist-tools/tools/resource-controller.mjs") "missing-private-binding.json")
                   (js-object :cwd (resolve ".local/tests") :stdin (new globalThis.Blob (js-array
                     (if (= variant "bad-json") "{bad" (JSON/stringify request)))) :stdout "pipe" :stderr "pipe"))))
            (try
              (let ((values (await (Promise/all (js-array
                (js-call (new globalThis.Response (nativeGet child "stdout")) :text)
                (js-call (new globalThis.Response (nativeGet child "stderr")) :text)
                (nativeGet child "exited"))))))
                (js-call (expect (not (= (aref values 2) 0))) :toBe t)
                (js-call (expect (nativeGet (JSON/parse (aref values 0)) "ok")) :toBe false)
                (js-call (expect (js-call (aref values 1) :trim)) :toBe "resource_controller_failed")
                (js-call (expect (js-call (aref values 1) :includes "missing-private-binding")) :toBe false))
              (finally
                (when (= (nativeGet child "exitCode") nil) (js-call child :kill "SIGKILL"))
                (await (nativeGet child "exited")))))
          (setq i (1+ i))))))
    (lambda (unused) nil))
