  (withCase
    "T70.resources.integration.native-reader"
    (lambda () nil)
    (async
      (unused)
      (let* ((reader (openNativeProcessReader))
             (pid (nativeGet globalThis.process "pid"))
             (uid (js-call globalThis.process :getuid)))
        (try
          (let ((first (await (js-call reader :read pid)))
                (second (await (js-call reader :read pid))))
            (js-call (expect (nativeGet first "pid")) :toBe pid)
            (js-call (expect (nativeGet first "uid")) :toBe uid)
            (js-call (expect (nativeGet first "executable")) :toBe (nativeGet globalThis.process "execPath"))
            (js-call (expect (nativeGet first "start_abstime")) :toBe (nativeGet second "start_abstime"))
            (js-call (expect (Number/isSafeInteger (nativeGet first "rss_bytes"))) :toBe t)
            (js-call (expect (Number/isSafeInteger (nativeGet first "physical_footprint_bytes"))) :toBe t)
            (js-call (expect (>= (nativeGet first "rss_bytes") 0)) :toBe t)
            (js-call (expect (>= (nativeGet first "physical_footprint_bytes") 0)) :toBe t))
          ;; The idle child belongs to this test and is never a real Agent/deployment.
          (let ((child (Bun/spawn (js-array (nativeGet globalThis.process "execPath")
                (resolve "dist-tools/tools/resource-controller.mjs") "missing-private-binding.json")
                (js-object :stdin "pipe" :stdout "pipe" :stderr "pipe"))))
            (try
              (js-call (expect (js-call (js-call reader :children pid) :includes (nativeGet child "pid"))) :toBe t)
              (let ((observed (js-call reader :read (nativeGet child "pid"))))
                (js-call (expect (nativeGet observed "ppid")) :toBe pid)
                (js-call (expect (nativeGet observed "uid")) :toBe uid)
                (js-call (expect (nativeGet observed "executable")) :toBe (nativeGet globalThis.process "execPath")))
              (finally
                (when (= (nativeGet child "exitCode") nil) (js-call child :kill "SIGKILL"))
                (await (nativeGet child "exited")))))
          (let ((caught 0))
            (try (await (js-call reader :read 0)) (catch error (setq caught (1+ caught))))
            (try (await (js-call reader :read 2147483648)) (catch error (setq caught (1+ caught))))
            (js-call (expect caught) :toBe 2))
          (finally (js-call reader :close)))
        (let ((closed-caught false))
          (try (await (js-call reader :read pid)) (catch error (setq closed-caught t)))
          (js-call (expect closed-caught) :toBe t))
        (js-call reader :close))
      (let* ((root (resolve ".local/tests" (str "capture-" (randomUUID))))
             (file (resolve root "resources.json"))
             (binding-data (js-object :schema_version 1 :authorized t :roots
               (js-array
                 (js-object :pid 101 :start_abstime "1" :executable (resolve "capture-a") :category "dj" :roles (js-array "dj"))
                 (js-object :pid 102 :start_abstime "2" :executable (resolve "capture-b") :category "dj" :roles (js-array "lark_websocket"))
                 (js-object :pid 103 :start_abstime "3" :executable (resolve "capture-c") :category "dj" :roles (js-array "mcp_proxy"))
                 (js-object :pid 104 :start_abstime "4" :executable (resolve "capture-d") :category "external_agent" :roles (js-array "external_agent"))))))
        (try
          (mkdirSync root (js-object :mode 448))
          (writeFileSync file (JSON/stringify binding-data) (js-object :mode 384))
          (chmodSync file 384)
          (let ((binding (await (loadCaptureBinding root "resources.json"))))
            (js-call (expect (js-length (nativeGet binding "roots"))) :toBe 4)
            (let* ((clock 0)
                   (reader (js-object
                     :read (lambda (pid)
                       (let ((root-record (js-call (nativeGet binding "roots") :find (lambda (r) (= (nativeGet r "pid") pid)))))
                         (and root-record (js-object :pid pid :ppid 0 :uid (js-call globalThis.process :getuid)
                           :executable (nativeGet root-record "executable") :start_abstime (nativeGet root-record "start_abstime")
                           :exit_abstime "0" :rss_bytes 64 :physical_footprint_bytes 128))))
                     :children (lambda (pid) (js-array))))
                   (runtime (js-object :reader reader :now (lambda () clock)
                     :sleep (async (ms) (setq clock (+ clock ms)))
                     :uid (js-call globalThis.process :getuid) :capture_id "int-capture"))
                   (request (js-object :schema_version 1 :operation "measure-owned-deployment"
                     :request_id "req-int" :run_id "run-int"
                     :parameters (js-object :run_id "run-int" :duration_ms 60000 :interval_ms 100))))
              (let ((response (await (handleResourceRequest request binding runtime))))
                (js-call (expect (nativeGet response "request_id")) :toBe "req-int")
                (js-call (expect (nativeGet response "run_id")) :toBe "run-int")
                (js-call (expect (nativeGet response "operation")) :toBe "measure-owned-deployment")
                (js-call (expect (nativeGet (nativeGet response "data") "complete")) :toBe t))))
