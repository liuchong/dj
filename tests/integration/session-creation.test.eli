(module dj.tests.integration.session-creation
  (import "../../src/core/native.eli" nativeGet NativeBun)
  (import "../../src/core/types.eli" hashValue)
  (import "../../src/adapters/agent/antigravity.eli" createAntigravityPort cascadeCreationId)
  (import "../../src/adapters/agent/opencode-http.eli" createOpenCodePort)
  (import "../../src/adapters/agent/cursor-native.eli" cursorRenderer)
  (import "../../src/host/bun/io.eli" createHostPorts)
  (import "../support/case.eli" withCase)
  (import "../support/fixtures.eli" createFixture closeFixture callOk)
  (import "../support/process.eli" until)
  (import "node:fs/promises" writeFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "node:vm" runInNewContext)
  (import "bun:test" expect)
  (defasync setup ()
    (await (createFixture "session-creation" "one" (js-object :configure (lambda (config ports)
      (let* ((endpoint (aref (nativeGet config "agent_endpoints") 0))
             (peer (js-call (nativeGet ports "agent_ports") :get "opencode"))
             (actor (aref (nativeGet config "principals") 2)))
        (Object/assign endpoint (js-object :workspace_ref "ws-test" :directory (resolve "fixture-create-base")
          :workspace_scope "instance"))
        (js-call (nativeGet actor "grants") :push (js-object :action "session.create" :resources (js-array "*"))
          (js-object :action "lifecycle.inspect" :resources (js-array "self"))
          (js-object :action "lifecycle.reconcile" :resources (js-array "self"))
          (js-object :action "session.rename" :resources (js-array "*"))
          (js-object :action "session.send" :resources (js-array "*"))
          (js-object :action "session.inspect" :resources (js-array "*")))
        (put (nativeGet peer "capabilities") :session_rename "supported")
        (put peer :rename (async (session title context)
          (let ((current (js-call (nativeGet peer "sessions") :find (lambda (row)
                         (= (nativeGet row "native_session_id") (nativeGet session "native_session_id"))))))
            (put current :title title)
            (js-object :state "ready" :session current :evidence_level "native_protocol"))))
        (put peer :create (async (instance workspace key context)
          (let ((session (js-object :tool "opencode" :native_namespace "ns-opencode" :native_session_id key
                         :instance_id (nativeGet instance "instance_id") :instance_epoch (nativeGet instance "instance_epoch")
                         :title "empty" :runtime_state "idle" :live_receiver t :visibility (js-array "live"))))
            (put session :directory (nativeGet context "directory")) (put session :workspace_ref workspace)
            (js-call (nativeGet peer "creates") :push session)
            (js-call (nativeGet peer "sessions") :push session)
            (js-object :state "ready" :session session :evidence_level "native_protocol"))))))))))
  (withCase "T53.instance-workspace-create.sqlite" setup
    (async (f)
      (let* ((instance (await (callOk f "O" "instance.get" (js-object :instance_id "oc-existing"))))
             (directory (resolve "fixture-create-other"))
             (ref (str "opencode-workspace-" (hashValue directory)))
             (args (js-object :instance_id "oc-existing" :expected_instance_epoch (nativeGet instance "instance_epoch")
               :workspace_ref ref :directory directory :title "isolated empty chat" :idempotency_key "cross-create")))
        (js-call (expect (nativeGet (nativeGet instance "capabilities") "session_create")) :toBe "supported")
        (js-call (expect (nativeGet instance "workspace_scope")) :toBe "instance")
        ;; A different AI principal can create; it is not an operator-only or
        ;; managed-instance operation. Query permissions remain independent.
        (let ((denied (await (js-call f :call (nativeGet f "A") "instance.get" (js-object :instance_id "oc-existing")))))
          (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden"))
        (let ((action (await (callOk f "A" "session.create" args))))
          (js-call (expect (nativeGet action "directory")) :toBe directory)
          (await (until "create lifecycle ready" (async ()
            (await (js-call f :tick))
            (= (nativeGet (await (callOk f "O" "lifecycle.get"
              (js-object :lifecycle_id (nativeGet action "lifecycle_id")))) "state") "ready")) 5000))
          (let ((again (await (callOk f "A" "session.create" args))))
            (js-call (expect (nativeGet again "lifecycle_id")) :toBe (nativeGet action "lifecycle_id"))))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "creates"))) :toBe 1)
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 0)
        (let* ((message-args (Object/assign (js-object) args
                 (js-object :idempotency_key "create-with-input" :content (js-object :type "text" :text "Check this specific task."))))
               (action (await (callOk f "A" "session.create" message-args))) (ready nil))
          (await (until "initial delivery is persisted and accepted" (async ()
            (await (js-call f :tick))
            (setq ready (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))))
            (and (= (nativeGet ready "state") "ready") (= (nativeGet ready "initial_input_state") "queued")
                 (= (nativeGet (await (callOk f "O" "delivery.get"
                   (js-object :delivery_id (nativeGet ready "initial_delivery_id")))) "state") "accepted"))) 5000))
          (await (callOk f "A" "session.create" message-args))
          (await (js-call f :tick))
          (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 1)
          (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "creates"))) :toBe 2)
          (setq ready (await (callOk f "A" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))))
          (let* ((rename-args (js-object :session_ref (nativeGet ready "session_ref") :title "caller chosen title" :idempotency_key "rename-created"))
                 (rename (await (callOk f "A" "session.rename" rename-args))))
            (await (until "rename readback" (async ()
              (await (js-call f :tick))
              (= (nativeGet (await (callOk f "O" "lifecycle.get" (js-object :lifecycle_id (nativeGet rename "lifecycle_id")))) "state") "ready")) 5000))
            (let ((again (await (callOk f "A" "session.rename" rename-args))))
              (js-call (expect (nativeGet again "lifecycle_id")) :toBe (nativeGet rename "lifecycle_id")))))
        ;; A second create resolves its directory from the first persisted chat.
        (let ((next (Object/assign (js-object) args (js-object :idempotency_key "resolve-workspace"))))
          (Reflect/deleteProperty next "directory")
          (let ((action (await (callOk f "A" "session.create" next))))
            (js-call (expect (nativeGet action "directory")) :toBe directory)))
        (let ((denied (await (js-call f :call (nativeGet f "A") "session.create"
          (Object/assign (js-object) args (js-object :workspace_ref "unknown-workspace" :idempotency_key "bad-workspace"))))))
          (js-call (expect (nativeGet (nativeGet (nativeGet denied "error") "details") "reason")) :toBe "creation_workspace_unresolved"))
        (let ((denied (await (js-call f :call (nativeGet f "A") "session.create"
          (Object/assign (js-object) args (js-object :expected_instance_epoch "obsolete" :idempotency_key "bad-epoch"))))))
          (js-call (expect (nativeGet denied "ok")) :toBe false))
        (let ((denied (await (js-call f :call (nativeGet f "A") "session.create"
          (Object/assign (js-object) args (js-object :model_selection (js-object :provider_id "native" :model_id "explicit")
            :idempotency_key "unsupported-model"))))))
          (js-call (expect (nativeGet (nativeGet (nativeGet denied "error") "details") "reason")) :toBe "creation_model_selection_unsupported"))))
    closeFixture)
  (withCase "T53.antigravity-empty-create.integration" (lambda () nil)
    (async (unused)
      (let* ((base (resolve "fixture-native-base")) (directory (resolve "fixture-native-other"))
             (ref (str "antigravity-workspace-" (hashValue directory)))
             (endpoint (js-object :instance_id "native-fixture" :native_namespace "native-fixture"
               :tool "antigravity" :workspace_ref "ws-base" :directory base :workspace_scope "instance" :instance_epoch "native-epoch"))
             (rows (js-object)) (calls (js-array)) (port nil)
             (ctx (js-object :directory directory :title "empty native chat"
               :model_selection (js-object :provider_id "antigravity" :model_id "1417"))))
        (setq port (createAntigravityPort (js-object :endpoints (js-array endpoint))
          (js-object :antigravity_rpc (async (e method payload context)
            (js-call calls :push method)
            (cond
              ((= method "GetAllCascadeTrajectories")
                (js-object :instance_epoch "native-epoch" :data (js-object :trajectorySummaries rows)))
              ((= method "StartCascade")
                (js-call (expect (nativeGet payload "requestedModel")) :toBe 1417)
                (js-call (expect (fileURLToPath (aref (nativeGet payload "workspaceUris") 0))) :toBe directory)
                (put rows (nativeGet payload "cascadeId") (js-object :status "CASCADE_RUN_STATUS_IDLE" :stepCount 0
                  :workspaces (js-array (js-object :workspaceFolderAbsoluteUri (aref (nativeGet payload "workspaceUris") 0)))))
                (js-object :instance_epoch "native-epoch" :data (js-object :cascadeId (nativeGet payload "cascadeId"))))
              ((= method "UpdateConversationAnnotations")
                (put (nativeGet rows (nativeGet payload "cascadeId")) :annotations (nativeGet payload "annotations"))
                (js-object :instance_epoch "native-epoch" :data (js-object)))
              (t (throw (new globalThis.Error "unexpected native mutation"))))))))
        (try
          (let* ((created (await (js-call port :create endpoint ref "create-key" ctx)))
                 (session (nativeGet created "session")))
            (js-call (expect (nativeGet created "state")) :toBe "ready")
            (js-call (expect (nativeGet session "native_session_id")) :toBe (cascadeCreationId "create-key"))
            (js-call (expect (nativeGet session "workspace_ref")) :toBe ref)
            (js-call (expect (nativeGet session "directory")) :toBe directory)
            (js-call (expect (nativeGet session "title")) :toBe "empty native chat")
            (let ((renamed (await (js-call port :rename session "renamed native chat" ctx))))
              (js-call (expect (nativeGet renamed "state")) :toBe "ready")
              (js-call (expect (nativeGet (nativeGet renamed "session") "title")) :toBe "renamed native chat"))
            (let ((again (await (js-call port :create endpoint ref "create-key" ctx))))
              (js-call (expect (nativeGet again "state")) :toBe "ready"))
            (let ((recovered (await (js-call port :lookupCreate endpoint "create-key" nil ctx))))
              (js-call (expect (nativeGet recovered "state")) :toBe "ready")))
          (js-call (expect (js-length (js-call calls :filter (lambda (m) (= m "StartCascade"))))) :toBe 1)
          (js-call (expect (js-call calls :includes "SendUserCascadeMessage")) :toBe false)
          (let ((stale (await (js-call port :create (Object/assign (js-object) endpoint
            (js-object :instance_epoch "stale")) ref "stale-key" ctx))))
            (js-call (expect (nativeGet stale "definite_not_sent")) :toBe t))
          (finally (await (js-call port :close))))))
    (lambda (unused) nil))
  (withCase "T53.cursor-empty-create.integration" (lambda () nil)
    (async (unused)
      (let* ((renderer (runInNewContext (str "(" cursorRenderer ")") (js-object :Map globalThis.Map)))
             (loaded (new globalThis.Map)) (records (new globalThis.Map)) (headers (new globalThis.Map))
             (created 0) (disposed 0) (sent 0)
             (id "12345678-1234-4123-a123-123456789abc")
             (workspace (js-object :id "native-workspace"))
             (local (js-object :_loadedAgents loaded :agentMap records))
             (repo (js-object :localRepo local :getAgentHeader (lambda (key) (js-call headers :get key))))
             (host (js-array (js-object :agentRepositoryProxy (js-object :delegate repo))))
             (request (js-object :operation "create" :thread id :workspace "native-workspace" :window 1 :title "empty")))
        (js-call records :set "template" (js-object :workspaceIdentifier workspace))
        (put local :createAgent (async (text environment options)
          (js-call (expect text) :toBe "")
          (js-call (expect (nativeGet options "skipInitialSubmit")) :toBe t)
          (js-call (expect (nativeGet options "trustPolicy")) :toBe "require-trusted")
          (js-call (expect (nativeGet environment "type")) :toBe "existing")
          (js-call (expect (nativeGet environment "environment")) :toBe workspace)
          (setq created (1+ created))
          (js-call records :set id (js-object :workspaceIdentifier workspace))
          (js-call loaded :set id (js-object :_composerDataHandle (js-object :data (js-object :workspaceIdentifier workspace))))
          (js-call headers :set id (js-object :source "local" :name (js-object :value "empty") :status (js-object :value "done")))
          (js-object :dispose (lambda () (setq disposed (1+ disposed)))
            :submitMessage (lambda () (setq sent (1+ sent))))))
        (let ((out (await (js-call renderer :call host request))))
          (js-call (expect (nativeGet (nativeGet out "thread") "id")) :toBe id))
        (put local :composerDataService (js-object :updateComposerDataAsync (async (key update)
          (funcall update (lambda (field title)
            (js-call (expect field) :toBe "name")
            (put (nativeGet (js-call headers :get key) "name") :value title))))))
        (let ((renamed (await (js-call renderer :call host
                (Object/assign (js-object) request (js-object :operation "rename" :title "renamed cursor"))))))
          (js-call (expect (nativeGet (nativeGet renamed "thread") "title")) :toBe "renamed cursor"))
        (await (js-call renderer :call host request))
        (js-call (expect created) :toBe 1)
        (js-call (expect disposed) :toBe 1)
        (js-call (expect sent) :toBe 0)
        (await (js-call (nativeGet (expect (js-call renderer :call host
          (Object/assign (js-object) request (js-object :thread "22345678-1234-4123-a123-123456789abc"
            :workspace "foreign-workspace")))) "rejects") :toThrow "cursor_native_workspace"))
        (js-call (expect created) :toBe 1)))
    (lambda (unused) nil))
  (withCase "T53.opencode-cross-workspace.integration"
    (async () (await (createFixture "opencode-create-http" "one")))
    (async (f)
      (let* ((directory (resolve "fixture-http-other")) (base (resolve "fixture-http-base"))
             (sessions (new globalThis.Map)) (posts 0)
             (server (js-call NativeBun :serve (js-object :hostname "127.0.0.1" :port 0
               :fetch (async (request)
                 (let* ((url (new globalThis.URL (nativeGet request "url"))) (path (nativeGet url "pathname")) (data nil))
                   (cond
                     ((= path "/api/info") (setq data (js-object :pid (nativeGet globalThis.process "pid") :version "fixture")))
                     ((= path "/api/location") (setq data (js-object :project (js-object :id "other-project"))))
                     ((and (= path "/api/session") (= (nativeGet request "method") "POST"))
                       (let ((body (await (js-call request :json))))
                         (js-call (expect (Object/hasOwn body "prompt")) :toBe false)
                         (js-call (expect (nativeGet (nativeGet body "location") "directory")) :toBe directory)
                         (setq posts (1+ posts))
                         (setq data (js-object :data (js-object :id "created-http-session" :projectID "other-project"
                           :location (nativeGet body "location") :title (nativeGet body "title"))))
                         (js-call sessions :set "created-http-session" (nativeGet data "data"))))
                     ((and (= path "/api/session/created-http-session") (= (nativeGet request "method") "PATCH"))
                       (let ((body (await (js-call request :json))))
                         (put (js-call sessions :get "created-http-session") :title (nativeGet body "title"))
                         (setq data (js-object :no_content t))))
                     ((= path "/api/session/active") (setq data (js-object :data (js-object))))
                     ((js-call path :startsWith "/api/session/")
                       (setq data (js-object :data (js-call sessions :get "created-http-session"))))
                     (t (throw (new globalThis.Error "unexpected native API"))))
                   (if (nativeGet data "no_content") (new globalThis.Response nil (js-object :status 204))
                     (js-call globalThis.Response :json data)))))))
             (file (resolve (nativeGet f "root") "opencode-service.json")) (port nil))
        (try
          (await (writeFile file (JSON/stringify (js-object :url (str "http://127.0.0.1:" (nativeGet server "port"))
            :pid (nativeGet globalThis.process "pid") :version "fixture")) (js-object :mode 384)))
          (let* ((endpoint (js-object :tool "opencode" :service_file file :instance_id "http-native"
                   :native_namespace "base-project" :workspace_ref "ws-base" :workspace_refs (js-array "ws-base")
                   :directory base :workspace_scope "instance"))
                 (host (createHostPorts)) (ctx (js-object :deadline (+ (performance/now) 15000)))
                 (ref (str "opencode-workspace-" (hashValue directory))))
            (setq port (createOpenCodePort (js-object :endpoints (js-array endpoint)) host))
            (let ((observed (await (js-call port :probeInstance endpoint ctx))))
              (put endpoint :instance_epoch (nativeGet observed "instance_epoch")))
            (put ctx :directory directory) (put ctx :title "HTTP empty chat")
            (let ((created (await (js-call port :create endpoint ref "http-key" ctx))))
              (js-call (expect (nativeGet created "state")) :toBe "ready")
              (js-call (expect (nativeGet (nativeGet created "session") "workspace_ref")) :toBe ref)
              (js-call (expect (nativeGet (nativeGet created "session") "project_id")) :toBe "other-project"))
            (let ((recovered (await (js-call port :lookupCreate endpoint "http-key" "created-http-session" ctx))))
              (js-call (expect (nativeGet recovered "state")) :toBe "ready"))
            (let* ((recovered (await (js-call port :lookupCreate endpoint "http-key" "created-http-session" ctx)))
                   (renamed (await (js-call port :rename (nativeGet recovered "session") "renamed HTTP chat" ctx))))
              (js-call (expect (nativeGet renamed "state")) :toBe "ready")
              (js-call (expect (nativeGet (nativeGet renamed "session") "title")) :toBe "renamed HTTP chat"))
            (js-call (expect posts) :toBe 1))
          (finally (when port (await (js-call port :close))) (js-call server :stop t)))))
    closeFixture)  (withCase "T53.native-initial-input.sqlite" setup
    (async (f)
      (let* ((peer (nativeGet f "opencode")) (create (nativeGet peer "create"))
             (instance (await (callOk f "O" "instance.get" (js-object :instance_id "oc-existing"))))
             (base (js-object :instance_id "oc-existing" :expected_instance_epoch (nativeGet instance "instance_epoch")
               :workspace_ref "ws-test" :idempotency_key "native-initial")))
        (put (nativeGet peer "capabilities") :creation_requires_content "supported")
        (put peer :create (async (instance workspace key context)
          (let ((report (await (funcall create instance workspace key context))))
            (js-call (expect (nativeGet (nativeGet context "creation_content") "text")) :toBe "Explicit native first input")
            (put report :initial_input_receipt_key "native-first-accepted") report)))
        (let ((denied (await (js-call f :call (nativeGet f "A") "session.create" base))))
          (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "invalid_argument"))
        (let ((action (await (callOk f "A" "session.create" (Object/assign (js-object) base
          (js-object :content (js-object :type "text" :text "Explicit native first input")))))))
          (await (until "native creation and input accepted" (async ()
            (await (js-call f :tick))
            (= (nativeGet (await (callOk f "A" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id")))) "state") "ready")) 5000))
          (let ((ready (await (callOk f "A" "lifecycle.get" (js-object :lifecycle_id (nativeGet action "lifecycle_id"))))))
            (js-call (expect (nativeGet ready "initial_input_state")) :toBe "native_queued")
            (js-call (expect (nativeGet ready "initial_input_receipt_key")) :toBe "native-first-accepted"))
          (await (js-call f :tick))
          (let ((page (await (callOk f "O" "delivery.list" (js-object :filters (js-object))))))
            (js-call (expect (js-length (nativeGet page "items"))) :toBe 0))
          (js-call (expect (js-length (nativeGet peer "creates"))) :toBe 1))))
    closeFixture)
)
