(module dj.tests.integration.instance-reconnect
  (import "../../src/core/native.eli" nativeGet)
  (import "../support/fixtures.eli" createFixture closeFixture callOk bindRecipient subscribe createdEvent)
  (import "../support/process.eli" until)
  (import "../support/case.eli" withCase)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defasync setup ()
    (let* ((state (js-object :epoch "process-one" :live t))
           (f (await (createFixture "instance-reconnect" "one" (js-object :configure (lambda (config ports)
             (put config :managed_profiles (js-array))
             (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "process-one")
             (let ((port (js-call (nativeGet ports "agent_ports") :get "opencode")))
               (js-call (nativeGet port "sessions") :forEach (lambda (row) (put row :instance_epoch "process-one")))
               (put port :probeInstance (async (instance context)
                 (js-object :state (if (nativeGet state "live") "ready" "offline")
                   :native_namespace "ns-opencode" :instance_epoch (nativeGet state "epoch")
                   :evidence_level (if (nativeGet state "live") "native_protocol" "none"))))
               (put port :probe (async (target session context)
                 (let ((row (js-call (nativeGet port "sessions") :find (lambda (candidate)
                   (= (nativeGet candidate "native_session_id") (nativeGet target "native_session_id"))))))
                   (if (nativeGet state "live")
                     (Object/assign (js-object) row (js-object :instance_epoch (nativeGet state "epoch")
                       :evidence_level "native_protocol" :model_selection (js-object :status "unknown")))
                     (js-object :runtime_state "offline" :live_receiver false :evidence_level "none"))))))))))))
      (put f :reconnect_state state) f))
  (defun inspect (f sql &rest args)
    (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite")))
           (query (js-call db :query sql)))
      (try (Reflect/apply (nativeGet query "all") query args) (finally (js-call db :close)))))
  (defun instance (f)
    (JSON/parse (nativeGet (aref (inspect f "SELECT payload FROM instances WHERE instance_id='oc-existing'") 0) "payload")))
  (defasync receive (f id expected)
    (await (js-call f :ingest (createdEvent "lark" id "same original recipient")))
    (await (until "original receiver accepts pending message" (async ()
      (await (js-call f :tick))
      (= (js-length (nativeGet (nativeGet f "opencode") "inputs")) expected)) 4000)))
  (withCase "T38.opencode-process-reconnect.integration" setup
    (async (f)
      (let* ((agent (await (bindRecipient f)))
             (sub (await (subscribe f agent "lark")))
             (state (nativeGet f "reconnect_state")))
        (await (receive f "before-restart" 1))
        (let ((bindings (inspect f "SELECT binding_id,payload FROM bindings")))
          (put state :epoch "process-two")
          (await (receive f "after-native-restart" 2))
          (js-call (expect (nativeGet (instance f) "instance_epoch")) :toBe "process-two")
          (js-call bindings :forEach (lambda (row)
            (js-call (expect (nativeGet (aref (inspect f "SELECT payload FROM bindings WHERE binding_id=?" (nativeGet row "binding_id")) 0) "payload"))
              :toBe (nativeGet row "payload")))))
        ;; An explicit closed gate is not an offline-recovery gate.
        (inspect f "UPDATE instance_gates SET state='closed',payload=json_set(payload,'$.state','closed','$.reason','instance_stop') WHERE instance_id='oc-existing'")
        (put state :epoch "process-three")
        (await (js-call f :ingest (createdEvent "lark" "while-stopped" "do not override stop")))
        (await (until "closed gate leaves input pending" (async ()
          (await (js-call f :tick))
          (> (js-length (inspect f "SELECT delivery_id FROM deliveries WHERE state='deferred'")) 0)) 4000))
        (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "inputs"))) :toBe 2)
        (js-call (expect (nativeGet (instance f) "instance_epoch")) :toBe "process-two")
        (inspect f "UPDATE instance_gates SET state='open',payload=json_set(payload,'$.state','open','$.reason','ready') WHERE instance_id='oc-existing'")
        (await (until "same pending input after explicit reopen" (async ()
          (await (js-call f :tick)) (= (js-length (nativeGet (nativeGet f "opencode") "inputs")) 3)) 4000))
        ;; DJ starts while the client is offline, then the original client returns.
        (put state :live false)
        (await (js-call f :restart))
        (js-call (expect (nativeGet (instance f) "state")) :toBe "offline")
        (put state :epoch "process-four") (put state :live t)
        (await (receive f "after-offline-start" 4))
        (js-call (expect (nativeGet (instance f) "state")) :toBe "ready")
        (js-call (expect (nativeGet (instance f) "instance_epoch")) :toBe "process-four")
        ;; Another DJ restart must adopt native proof despite a stale config epoch.
        (await (js-call f :restart))
        (js-call (expect (nativeGet (instance f) "state")) :toBe "ready")
        (js-call (expect (nativeGet (instance f) "instance_epoch")) :toBe "process-four")
        (await (receive f "after-dj-restart" 5))
        (js-call (expect (nativeGet (await (callOk f "A" "subscription.get"
          (js-object :subscription_id (nativeGet sub "subscription_id")))) "state")) :toBe "active")
        (js-call (expect (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") 4) "binding")) :toBeDefined)))
    closeFixture))
