(module dj.tests.integration.fixed-routes
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/application/operations.eli" operationCatalog)
  (import "../../src/interfaces/mcp.eli" validateResult)
  (import "../support/fixtures.eli" createFixture closeFixture callOk createdEvent)
  (import "../support/case.eli" withCase)
  (import "bun:test" expect)
  (import "bun:sqlite" Database)
  (import "node:path" resolve)
  (defun route (id recipient instance session &rest connections)
    (js-object :id id :owner_principal_id "O" :recipient_principal_id recipient
      :target (js-object :instance_id instance :native_session_id session)
      :sources (js-call connections :map (lambda (connection) (js-object :connection_id connection)))))
  (defun query (f sql &rest values)
    (let* ((db (new Database (resolve (nativeGet f "root") "state/dj.sqlite"))) (statement (js-call db :query sql)))
      (try (Reflect/apply (nativeGet statement "all") statement values)
        (finally (js-call statement :finalize) (js-call db :close)))))
  (defasync setup (&optional before)
    (await (createFixture "fixed-routes" "one" (js-object :configure (lambda (config ports)
      (put config :managed_profiles (js-array))
      (put (aref (nativeGet config "agent_endpoints") 0) :instance_epoch "epoch-1")
      (Object/assign (aref (nativeGet config "connections") 0)
        (js-object :identity "bot" :source_delivery "events" :event_scope "all_authorized" :event_app_id "cli_bot_a" :event_subject_id "ou_bot_a"))
      (let ((bot (Object/assign (js-object) (aref (nativeGet config "connections") 0)
        (js-object :connection_id "lark-b" :event_app_id "cli_bot_b" :event_subject_id "ou_bot_b"))))
        (js-call (nativeGet config "connections") :push bot)
        (js-call (nativeGet ports "im_ports") :set "lark-b" (js-call (nativeGet ports "im_ports") :get "lark")))
      (js-call (nativeGet config "agent_endpoints") :push (js-object :tool "pi" :instance_id "pi-existing"
        :native_namespace "ns-pi" :ownership "existing" :endpoint_ref "test:pi" :instance_epoch "epoch-1"
        :workspace_ref "ws-test" :directory "workspace-pi" :manifest_path "run/pi-receiver.json"))
      (let ((peer (js-call (nativeGet ports "agent_ports") :get "pi")))
        (put (aref (nativeGet peer "sessions") 0) :instance_id "pi-existing"))
      (put config :fixed_routes (js-array (route "bot-a" "A" "oc-existing" "s1" "lark")
        (route "bot-b" "B" "pi-existing" "s1" "lark-b")))
      (when before (funcall before config ports)))))))
  (defasync turns (f &optional n advance)
    (js-call (nativeGet f "clock") :advance (or advance 0))
    (let ((i 0)) (while (< i (or n 6))
      (await (js-call f :tick))
      (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 0))))
      (setq i (1+ i)))))
  (defasync status (f &optional actor)
    (nativeGet (await (callOk f (or actor "O") "service.status" (js-object))) "fixed_routes"))
  (defasync reload (f routes)
    (let ((config (JSON/parse (JSON/stringify (nativeGet f "config")))))
      (put config :fixed_routes routes)
      (let ((result (await (js-call (nativeGet f "core") :reloadConfig config))))
        (js-call (expect (nativeGet result "ok")) :toBe t))))
  (defasync message (f connection id &optional text thread chat)
    (let ((event (createdEvent connection id (or text id) thread)))
      (put event :addressed_self t) (put event :chat_type "group")
      (when chat (put (nativeGet event "conversation") :native_chat_id chat))
      (let ((result (await (js-call f :ingest event)))) (js-call (expect (nativeGet result "ok")) :toBe t))))
  (defun countInputs (f peer) (js-length (nativeGet (nativeGet f peer) "inputs")))
  (withCase "T38.fixed-routes-fanout.integration" setup (async (f)
    (await (turns f))
    (let* ((lines (await (status f))) (a (aref lines 0)) (b (aref lines 1))
      (probe (await (callOk f "O" "service.status" (js-object)))))
      (js-call (expect (js-call lines :map (lambda (line) (nativeGet line "state")))) :toEqual (js-array "active" "active"))
      (js-call (expect (nativeGet (validateResult (js-call operationCatalog :get "service.status")
        (js-object :ok t :data probe :warnings (js-array) :request_id "fixed-status" :evidence_level "service_record" :effect_state "none")) "ok")) :toBe t)
      (js-call (expect (js-length (await (status f "A")))) :toBe 1)
      (js-call (expect (nativeGet (await (callOk f "A" "subscription.get" (js-object :subscription_id (nativeGet a "subscription_id")))) "configuration_id")) :toBe "bot-a")
      (js-call (expect (js-length (nativeGet (await (callOk f "A" "subscription.list" (js-object))) "items"))) :toBe 1)
      (js-call (expect (js-length (await (status f "X")))) :toBe 0)
      (await (message f "lark" "only-a")) (await (message f "lark-b" "only-b")) (await (turns f))
      (js-call (expect (countInputs f "opencode")) :toBe 1) (js-call (expect (countInputs f "pi")) :toBe 1)
      (js-call (expect (nativeGet (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") 0) "binding") "native_session_id")) :toBe "s1")
      ;; One connection can fan out, and a line can accept several connections.
      (let ((routes (JSON/parse (JSON/stringify (nativeGet (nativeGet f "config") "fixed_routes")))))
        (js-call routes :push (route "both-to-a" "A" "oc-existing" "s1" "lark" "lark-b"))
        (await (reload f routes)) (await (turns f))
        (await (message f "lark-b" "fanout")) (await (turns f))
        (js-call (expect (countInputs f "opencode")) :toBe 2) (js-call (expect (countInputs f "pi")) :toBe 2)
        (await (message f "lark" "merged")) (await (turns f))
        (js-call (expect (countInputs f "opencode")) :toBe 3)
        (js-call (expect (nativeGet (aref (query f "SELECT count(*) AS n FROM contributions WHERE delivery_id=(SELECT d.delivery_id FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE e.native_message_id='merged')") 0) "n")) :toBe 2)
        (put (aref routes 1) :sources (js-array (js-object :connection_id "lark-b" :native_chat_id "c1" :native_thread_id "exact-thread")))
        (await (reload f routes)) (await (turns f))
        (js-call (expect (nativeGet (aref (await (status f)) 1) "state")) :toBe "active")
        (await (message f "lark-b" "exact-thread-hit" nil "exact-thread"))
        (await (message f "lark-b" "other-thread-miss" nil "other-thread")) (await (turns f))
        (js-call (expect (countInputs f "pi")) :toBe 3)))) closeFixture)
  (withCase "T38.fixed-routes-reload.integration" setup (async (f)
    (await (turns f))
    (let* ((a (aref (await (status f)) 0)) (id (nativeGet a "subscription_id"))
      (sub (await (callOk f "O" "subscription.get" (js-object :subscription_id id))))
      (preview (await (callOk f "A" "subscription.preview" (js-object :spec
        (js-object :agent_id (nativeGet a "agent_id") :selector (js-object :sources (js-array (js-object :connection_id "lark")))
          :predicate (js-object :field "text" :op "contains" :value "manual-only"))))))
      (manual (await (callOk f "A" "subscription.create" (js-object :preview_id (nativeGet preview "preview_id") :idempotency_key "manual-sub"))))
      (routes (JSON/parse (JSON/stringify (nativeGet (nativeGet f "config") "fixed_routes")))))
      (js-call (expect (nativeGet sub "configuration_id")) :toBe "bot-a")
      (let* ((agent (await (callOk f "O" "agent.get" (js-object :agent_id (nativeGet a "agent_id")))))
        (discovered (await (callOk f "O" "agent.discover" (js-object :tool "opencode" :scope "live"))))
        (candidate (js-call (nativeGet discovered "items") :find (lambda (item) (= (nativeGet item "native_session_id") "s1")))))
        (js-call (expect (nativeGet (nativeGet (await (js-call f :call (nativeGet f "O") "agent.rebind"
          (js-object :agent_id (nativeGet agent "agent_id") :expected_revision (nativeGet agent "revision")
            :candidate_ref (nativeGet candidate "candidate_ref") :idempotency_key "fixed-cannot-rebind"))) "error") "code")) :toBe "forbidden")
        (js-call (expect (nativeGet (nativeGet (await (js-call f :call (nativeGet f "O") "agent.unregister"
          (js-object :agent_id (nativeGet agent "agent_id") :expected_revision (nativeGet agent "revision")
            :idempotency_key "fixed-cannot-unregister"))) "error") "code")) :toBe "forbidden")
        (js-call (expect (nativeGet (await (callOk f "O" "agent.get" (js-object :agent_id (nativeGet agent "agent_id")))) "revision")) :toBe (nativeGet agent "revision")))
      (await (reload f routes)) (await (turns f))
      (js-call (expect (nativeGet (await (callOk f "O" "subscription.get" (js-object :subscription_id id))) "start_seq")) :toBe (nativeGet sub "start_seq"))
      (let ((denied (await (js-call f :call (nativeGet f "O") "subscription.pause"
        (js-object :subscription_id id :expected_revision (nativeGet sub "revision") :idempotency_key "cannot-pause-fixed")))))
        (js-call (expect (nativeGet (nativeGet denied "error") "code")) :toBe "forbidden"))
      (put (aref routes 0) :predicate (js-object :field "text" :op "contains" :value "new-rule"))
      (put (aref routes 0) :instruction_policy (js-object :prompt "Configured guidance" :task_template "处理 {{message.text}}"))
      (put (aref routes 0) :sources (js-array (js-object :connection_id "lark" :native_chat_id "c1")))
      (await (reload f routes)) (await (turns f))
      (await (message f "lark" "no-match")) (await (message f "lark" "matches" "new-rule" "thread-one"))
      (await (message f "lark" "other-chat" "new-rule" nil "other-chat")) (await (turns f))
      (js-call (expect (countInputs f "opencode")) :toBe 1)
      (let* ((envelope (nativeGet (aref (nativeGet (nativeGet f "opencode") "inputs") 0) "envelope"))
        (instruction (aref (nativeGet envelope "instructions") 0)))
        (js-call (expect (nativeGet instruction "prompt")) :toBe "Configured guidance")
        (js-call (expect (nativeGet instruction "task")) :toBe "处理 new-rule"))
      (put (aref routes 0) :enabled false) (await (reload f routes)) (await (turns f))
      (await (message f "lark" "disabled" "new-rule")) (await (turns f))
      (js-call (expect (countInputs f "opencode")) :toBe 1)
      (js-call (expect (nativeGet (aref (await (status f)) 0) "state")) :toBe "disabled")
      (put (aref routes 0) :enabled t) (await (reload f routes)) (await (turns f))
      (await (message f "lark" "reenabled" "new-rule")) (await (turns f))
      (js-call (expect (countInputs f "opencode")) :toBe 2)
      (await (reload f (js-array (aref routes 1)))) (await (turns f))
      (js-call (expect (js-length (await (status f)))) :toBe 1)
      (js-call (expect (nativeGet (await (callOk f "A" "subscription.get" (js-object :subscription_id (nativeGet manual "subscription_id")))) "state")) :toBe "active")
      (js-call (expect (nativeGet (await (callOk f "O" "subscription.get" (js-object :subscription_id id))) "state")) :toBe "paused")
      (let ((stable (query f "SELECT subscription_id,revision,payload FROM subscriptions ORDER BY subscription_id")))
        (await (js-call f :restart)) (await (turns f))
        (js-call (expect (query f "SELECT subscription_id,revision,payload FROM subscriptions ORDER BY subscription_id")) :toEqual stable)))) closeFixture)
  (defasync offlineSetup ()
    (await (setup (lambda (config ports)
      (let* ((peer (js-call (nativeGet ports "agent_ports") :get "opencode")) (probe (nativeGet peer "probe")))
        (put peer :original_probe probe)
        (put peer :probe (async (target binding call-context) (js-object :ok false :runtime_state "offline" :live_receiver false))))))))
  (withCase "T38.fixed-routes-offline.integration" offlineSetup (async (f)
    (await (turns f))
    (js-call (expect (nativeGet (aref (await (status f)) 0) "state")) :toBe "retrying")
    (js-call (expect (nativeGet (aref (await (status f)) 1) "state")) :toBe "active")
    (let ((peer (nativeGet f "opencode"))) (put peer :probe (nativeGet peer "original_probe")))
    (await (turns f 8 10000))
    (js-call (expect (nativeGet (aref (await (status f)) 0) "state")) :toBe "active")
    (await (message f "lark" "recovered")) (await (turns f))
    (js-call (expect (countInputs f "opencode")) :toBe 1)
    (js-call (expect (js-length (nativeGet (nativeGet f "opencode") "starts"))) :toBe 0)) closeFixture)
  (defasync raceSetup ()
    (await (setup (lambda (config ports) (put config :fixed_routes (js-array))))))
  (withCase "T38.fixed-routes-race.integration" raceSetup (async (f)
    (let* ((peer (nativeGet f "opencode")) (original (nativeGet peer "probe")) (entered false) (release nil)
      (line (route "race" "A" "oc-existing" "s1" "lark")))
      (put peer :probe (async (target binding call-context)
        (setq entered t) (await (new globalThis.Promise (lambda (done) (setq release done))))
        (await (funcall original target binding call-context))))
      (await (reload f (js-array line))) (await (turns f 2))
      (js-call (expect entered) :toBe t)
      (await (reload f (js-array)))
      (put peer :probe original) (funcall release nil) (await (turns f))
      (js-call (expect (js-length (await (status f)))) :toBe 0)
      (js-call (expect (js-length (query f "SELECT subscription_id FROM subscriptions WHERE state='active'"))) :toBe 0)
      (js-call (expect (js-length (nativeGet peer "inputs"))) :toBe 0))) closeFixture)
  (withCase "T38.fixed-routes-conflict.integration" raceSetup (async (f)
    (let* ((discovered (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live"))))
      (candidate (js-call (nativeGet discovered "items") :find (lambda (item) (= (nativeGet item "native_session_id") "s1"))))
      (manual (await (callOk f "A" "agent.register" (js-object :candidate_ref (nativeGet candidate "candidate_ref")
        :binding_mode "existing" :display_name "AI-owned target" :idempotency_key "self-owned-agent"))))
      (id (nativeGet manual "agent_id")))
      (await (reload f (js-array (route "conflict" "A" "oc-existing" "s1" "lark"))))
      (await (turns f))
      (js-call (expect (nativeGet (aref (await (status f)) 0) "state")) :toBe "blocked")
      (js-call (expect (nativeGet (aref (await (status f)) 0) "last_error")) :toBe "target_unbound")
      (js-call (expect (nativeGet (await (callOk f "A" "agent.get" (js-object :agent_id id))) "state")) :toBe "registered")
      (js-call (expect (js-length (query f "SELECT subscription_id FROM subscriptions"))) :toBe 0)
      ;; Lack of management permission blocks only this fixed route, and restoring
      ;; the configured authority retries through the same domain operations.
      (let* ((config (JSON/parse (JSON/stringify (nativeGet f "config"))))
        (operator (js-call (nativeGet config "principals") :find (lambda (p) (= (nativeGet p "principal_id") "O"))))
        (grants (nativeGet operator "grants")))
        (put config :fixed_routes (js-array (route "permission" "B" "pi-existing" "s1" "lark-b")))
        (put operator :grants (js-array)) (put operator :authorization_revision 2)
        (js-call (expect (nativeGet (await (js-call (nativeGet f "core") :reloadConfig config)) "ok")) :toBe t)
        (await (turns f))
        (js-call (expect (nativeGet (aref (query f "SELECT json_extract(payload,'$.last_error') AS code FROM fixed_routes") 0) "code")) :toBe "forbidden")
        (put operator :grants grants) (put operator :authorization_revision 3)
        (js-call (expect (nativeGet (await (js-call (nativeGet f "core") :reloadConfig config)) "ok")) :toBe t)
        (await (turns f))
        (js-call (expect (nativeGet (aref (await (status f)) 0) "state")) :toBe "active"))
      ;; An unrelated AI-owned Agent retains the ordinary management path.
      (let* ((discovered (await (callOk f "A" "agent.discover" (js-object :tool "opencode" :scope "live"))))
        (candidate (js-call (nativeGet discovered "items") :find (lambda (item) (= (nativeGet item "native_session_id") "s1"))))
        (rebound (await (callOk f "A" "agent.rebind" (js-object :agent_id id :candidate_ref (nativeGet candidate "candidate_ref")
          :expected_revision (nativeGet manual "revision") :idempotency_key "manual-rebind")))))
        (js-call (expect (nativeGet rebound "state")) :toBe "registered")
        (js-call (expect (nativeGet (await (callOk f "A" "agent.unregister" (js-object :agent_id id
          :expected_revision (nativeGet rebound "revision") :idempotency_key "manual-unregister"))) "state")) :toBe "closed")))) closeFixture))
