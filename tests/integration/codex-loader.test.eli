(module dj.tests.integration.codex-loader
  (import "../../src/core/native.eli" nativeGet nativeSetTimeout)
  (import "../../src/adapters/agent/desktop-transport.eli" socketIdentity)
  (import "../support/case.eli" withCase)
  (import "../support/process.eli" until)
  (import "../support/fixtures.eli" createFixture callOk)
  (import "node:net" createServer)
  (import "node:fs" existsSync)
  (import "node:fs/promises" mkdir mkdtemp writeFile rm)
  (import "node:path" resolve join)
  (import "bun:sqlite" Database)
  (import "bun:test" expect)
  (defconst thread "00000000-0000-4000-8000-000000000031")
  (defasync close (h)
    (when (nativeGet h "fixture") (await (js-call (nativeGet h "fixture") :close)))
    (when (nativeGet h "sockets") (js-call (nativeGet h "sockets") :forEach (lambda (s) (js-call s :destroy))))
    (when (nativeGet h "server")
      (await (new globalThis.Promise (lambda (done) (js-call (nativeGet h "server") :close done)))))
    (when (nativeGet h "root") (await (rm (nativeGet h "root") (js-object :force t :recursive t)))))
  (defasync setup ()
    (await (mkdir ".local/tests" (js-object :recursive t)))
    (let* ((root (await (mkdtemp (resolve ".local/tests/codex-loader-"))))
      (h (js-object :root root :inputs (js-array) :sockets (new globalThis.Set)))
      (marker (join root "loaded")) (workspace (join root "workspace")))
      (try
        (await (mkdir workspace))
        (await (writeFile (join root "metadata")
          (str "#!/bin/sh\nprintf '%s' '{\"pid\":" (nativeGet globalThis.process "pid")
            ",\"uid\":" (js-call globalThis.process :getuid)
            ",\"birth\":\"1:1\",\"executable\":\"/Applications/Codex.app/Contents/MacOS/Codex\"}'\n") (js-object :mode 448)))
        (await (writeFile (join root "loader")
          (str "#!/bin/sh\ncat >/dev/null\n: > '" marker "'\nprintf '%s' '{\"ok\":true}'\n") (js-object :mode 448)))
        (let ((db (new Database (join root "history.sqlite"))))
          (js-call db :exec "CREATE TABLE threads(id TEXT PRIMARY KEY,title TEXT,name TEXT,cwd TEXT,updated_at INTEGER,archived INTEGER)")
          (js-call (js-call db :query "INSERT INTO threads VALUES(?,?,?,?,1,0)") :run thread "Old receiver preview" "Existing receiver" workspace)
          (js-call db :close))
        (put h :server (createServer (lambda (socket)
          (js-call (nativeGet h "sockets") :add socket)
          (let ((bytes (Buffer/alloc 0)) (send (lambda (data)
            (let* ((body (Buffer/from (JSON/stringify data))) (header (Buffer/alloc 4)))
              (js-call header :writeUInt32LE (js-length body) 0)
              (js-call socket :write (Buffer/concat (js-array header body)))))))
            (js-call socket :on "data" (lambda (chunk)
              (setq bytes (Buffer/concat (js-array bytes chunk)))
              (while (and (>= (js-length bytes) 4) (>= (js-length bytes) (+ 4 (js-call bytes :readUInt32LE 0))))
                (let* ((length (js-call bytes :readUInt32LE 0))
                  (request (JSON/parse (js-call (js-call bytes :subarray 4 (+ 4 length)) :toString "utf8")))
                  (method (nativeGet request "method")) (params (nativeGet request "params")))
                  (setq bytes (js-call bytes :subarray (+ 4 length)))
                  (if (= (nativeGet request "type") "request")
                    (progn
                      (when (js-call method :startsWith "thread-follower-")
                        (let ((input (if (= method "thread-follower-start-turn")
                          (nativeGet (nativeGet params "turnStart") "request") params)))
                          (js-call (nativeGet h "inputs") :push (nativeGet (aref (nativeGet input "input") 0) "text"))))
                      ;; Deliberately ignore the request timeout, like an unloaded native owner.
                      (unless (and (= method "thread-owner-discovery") (not (existsSync marker)))
                        (funcall send (Object/assign (js-object :type "response" :requestId (nativeGet request "requestId")
                          :resultType "success" :result (js-object :clientId "client"))
                          (if (= method "thread-owner-discovery")
                            (js-object :handledByClientId "owner") (js-object))))))
                    (when (and (= method "thread-stream-following-changed") (= (nativeGet params "following") t))
                      (funcall send (js-object :type "broadcast" :method "thread-stream-state-changed" :sourceClientId "owner"
                        :params (js-object :hostId "local" :conversationId thread :change (js-object :type "snapshot"
                          :conversationState (js-object :id thread :cwd workspace :title "Existing receiver" :resumeState "resumed"
                            :threadRuntimeStatus (js-object :type "idle") :requests (js-array) :turns (js-array))))))))))))))))
        (await (new globalThis.Promise (lambda (done) (js-call (nativeGet h "server") :listen (join root "socket") done))))
        (put h :epoch (await (socketIdentity (join root "socket"))))
        (put h :fixture (await (createFixture "codex-loader" "one" (js-object :root root
          :configure (lambda (config ports)
            (put config :managed_profiles (js-array))
            (put (nativeGet ports "clock") :monoNow (lambda () (performance/now)))
            (put config :agent_endpoints (js-array (js-object :tool "codex" :instance_id "codex-native"
              :native_namespace "codex-local" :ownership "existing" :endpoint_ref "codex-native"
              :instance_epoch (nativeGet h "epoch") :socket_path (join root "socket") :directory workspace :workspace_ref "ws-test"
              :history_database (join root "history.sqlite") :process_helper_ref (join root "metadata")
              :receiver_loader_ref (join root "loader"))))
            (js-call (nativeGet config "principals") :forEach (lambda (p)
              (when (= (nativeGet p "principal_id") "A") (put p :target_constraint
                (js-object :tool "codex" :native_namespace "codex-local" :native_session_id thread)))))))))) h
        (catch error (await (close h)) (throw error)))))
  (withCase "T01.codex-loader.integration" setup (async (h)
    (let* ((f (nativeGet h "fixture")) (root (nativeGet h "root"))
      (session (await (callOk f "O" "session.resolve" (js-object :instance_id "codex-native" :native_session_id thread)))))
      (js-call (expect (nativeGet session "live_receiver")) :toBe false)
      (js-call (expect (nativeGet session "receiver_reason")) :toBe "receiver_discovery_timeout")
      (js-call (expect (existsSync (join root "loaded"))) :toBe false)
      (let* ((delivery (await (callOk f "O" "session.send" (js-object :session_ref (nativeGet session "session_ref")
        :content (js-object :type "text" :text "load the exact existing receiver") :idempotency_key "load-once"))))
        (id (nativeGet delivery "delivery_id")))
        (await (until "receiver outcome" (async ()
          (await (js-call f :tick))
          (not (= (nativeGet (await (callOk f "O" "delivery.get" (js-object :delivery_id id))) "state") "ready"))) 5000))
        (let ((read (await (callOk f "O" "delivery.get" (js-object :delivery_id id)))))
          (js-call (expect (nativeGet read "state")) :toBe "accepted")
          (js-call (expect (nativeGet read "submitted_at")) :toBeDefined)
          (js-call (expect (nativeGet read "accepted_at")) :toBeDefined)
          (js-call (expect (js-length (nativeGet read "receipts"))) :toBe 1))
        (js-call (expect (js-length (nativeGet h "inputs"))) :toBe 1)
        (await (js-call f :tick))
        (js-call (expect (js-length (nativeGet h "inputs"))) :toBe 1))
      (await (rm (join root "loaded")))
      (let* ((delivery (await (callOk f "O" "session.send" (js-object :session_ref (nativeGet session "session_ref")
        :content (js-object :type "text" :text "blocked receiver") :idempotency_key "load-blocked"))))
        (id (nativeGet delivery "delivery_id")))
        (await (until "receiver outcome" (async ()
          (await (js-call f :tick))
          (not (= (nativeGet (await (callOk f "O" "delivery.get" (js-object :delivery_id id))) "state") "ready"))) 5000))
        (let ((read (await (callOk f "O" "delivery.get" (js-object :delivery_id id)))))
          (js-call (expect (nativeGet read "state")) :toBe "deferred")
          (js-call (expect (nativeGet read "receiver_reason")) :toBe "receiver_load_backoff")
          (await (callOk f "O" "delivery.cancel" (js-object :delivery_id id
            :expected_revision (nativeGet read "revision") :idempotency_key "cancel-before-relay"))))
        (await (js-call f :tick))
        (js-call (expect (nativeGet (await (callOk f "O" "delivery.get" (js-object :delivery_id id))) "state")) :toBe "cancelled")
        (js-call (expect (js-length (nativeGet h "inputs"))) :toBe 1))
      (js-call (nativeGet h "sockets") :forEach (lambda (s) (js-call s :destroy)))
      (await (new globalThis.Promise (lambda (done) (js-call (nativeGet h "server") :close done))))
      (put h :server nil)
      (let* ((instance (await (callOk f "O" "instance.get" (js-object :instance_id "codex-native"))))
             (items (nativeGet (await (callOk f "O" "instance.list" (js-object :tools (js-array "codex")))) "items"))
             (saved (await (callOk f "O" "session.resolve" (js-object :instance_id "codex-native" :native_session_id thread))))
             (probe (await (callOk f "O" "session.probe" (js-object :session_ref (nativeGet saved "session_ref")))))
             (queued (await (callOk f "O" "session.send" (js-object :session_ref (nativeGet saved "session_ref")
               :content (js-object :type "text" :text "Hold until the same receiver recovers") :idempotency_key "hold-offline")))))
        (js-call (expect (nativeGet instance "state")) :toBe "offline")
        (js-call (expect (nativeGet instance "live_receiver")) :toBe false)
        (js-call (expect (nativeGet (aref items 0) "live_receiver")) :toBe false)
        (js-call (expect (nativeGet probe "instance_epoch")) :toBe (nativeGet saved "instance_epoch"))
        (js-call (expect (nativeGet probe "live_receiver")) :toBe false)
        (js-call (expect (nativeGet queued "state")) :toBe "ready")))) close))
