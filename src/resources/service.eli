(module dj.resources.service
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" hashValue addSeconds sliceUtf8 utf8Bytes conversationKey)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli" utcNow can requirePermission inTransaction must issueResourceHandle resolveResourceHandle nativeCallContext safeFields typedRef currentPrincipal)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../connections/manager.eli" imPort)
  (import "../adapters/im/lark-resources.eli" component)
  (import "../adapters/im/lark-resource-events.eli" peopleIn)
  (import "../ingestion/service.eli" acceptEvent)
  (import "../service/ownership.eli" ownerGuard)
  (defun resourceAddress (resource)
    (Object/assign (js-object :kind "resource" :native_thread_id (nativeGet resource "record_id" nil) :thread_kind "resource")
      (safeFields resource (js-array "connection_id" "table_id" "record_id"))
      (js-object :resource_kind (nativeGet resource "kind") :resource_token (nativeGet resource "token"))))
  (defun parseResource (connection url)
    (let* ((parsed (new globalThis.URL url)) (host (nativeGet parsed "hostname"))
      (feishu (= (nativeGet connection "brand") "feishu"))
      (parts (js-call (nativeGet parsed "pathname") :split "/"))
      (kind (nativeGet (js-object :wiki "wiki" :docx "docx" :sheets "sheet" :base "bitable") (aref parts 1)))
      (token (aref parts 2)) (query (nativeGet parsed "searchParams")))
      (unless (and (= (nativeGet parsed "protocol") "https:") (= (nativeGet parsed "port") "")
        (= (nativeGet parsed "username") "") (= (nativeGet parsed "password") "")
        (if feishu (js-call host :endsWith ".feishu.cn") (or (js-call host :endsWith ".larksuite.com") (js-call host :endsWith ".larksuite.cn")))
        kind token) (must (failure "invalid_argument")))
      (component token)
      (let ((result (js-object :connection_id (nativeGet connection "connection_id") :kind kind :token token :url url)))
        (when (js-call query :get "table") (component (js-call query :get "table")) (put result :table_id (js-call query :get "table")))
        (when (js-call query :get "record") (component (js-call query :get "record")) (put result :record_id (js-call query :get "record")))
        result)))
  (defun currentResource (context resource revision &optional action)
    (let* ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet resource "connection_id")))
      (address (resourceAddress resource)))
      (unless (and connection (not (nativeGet connection "disabled")) (= (nativeGet connection "platform") "lark")
        (can context (or action "resource.read") address)) (must (failure "forbidden")))
      (when (and revision (not (= revision (nativeGet connection "identity_revision" (nativeGet connection "revision"))))) (must (failure "stale_reference")))
      connection))
  (defun projectResource (context resource revision)
    (let* ((address (resourceAddress resource))
      (ref (must (issueResourceHandle context "resource" (str "resource_" (hashValue address))
        (js-object :resource resource :identity_revision revision) (nativeGet limits "handle_ttl_seconds"))))
      (source (must (issueResourceHandle context "conversation" (conversationKey address)
        (js-object :address address :identity_revision revision :source_revision revision) (nativeGet limits "handle_ttl_seconds")))))
      (Object/assign (js-object) resource (js-object :resource_ref (nativeGet ref "ref") :conversation_ref (nativeGet source "ref")))))
  (defun cacheKey (resource command parameters)
    (let ((query (Object/assign (js-object) parameters)))
      (unless (= (nativeGet query "kind") "wiki") (Reflect/deleteProperty query "space_id"))
      (hashValue (js-array (resourceAddress resource) command query))))
  (defun cached (context key revision)
    (let ((row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
      "SELECT payload FROM resource_cache WHERE cache_key=? AND identity_revision=? AND expires_at>?") :get key revision (utcNow context))))
      (and row (JSON/parse (nativeGet row "payload")))))
  (defasync fetchResource (context resource revision command parameters key)
    (currentResource context resource revision (if (= command "watch") "resource.subscribe" "resource.read"))
    (let* ((port (imPort context (nativeGet resource "connection_id")))
      (result (and (nativeGet port "resource") (must (await (js-call port :resource command parameters (nativeCallContext context)))))))
      (unless result (must (failure "unsupported")))
      (currentResource context resource revision (if (= command "watch") "resource.subscribe" "resource.read"))
      (when (nativeGet result "native_error") (must (failure "unavailable" (js-object :details (nativeGet result "native_error")))))
      (when key
        (must (await (enqueueWrite context (lambda ()
          (currentResource context resource revision)
          (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
            "INSERT INTO resource_cache(cache_key,connection_id,identity_revision,resource_token,expires_at,payload) VALUES(?,?,?,?,?,?) ON CONFLICT(cache_key) DO UPDATE SET identity_revision=excluded.identity_revision,expires_at=excluded.expires_at,payload=excluded.payload")
            :run key (nativeGet resource "connection_id") revision (nativeGet resource "token")
            (addSeconds (utcNow context) (nativeGet limits "body_retention_seconds"))
            (JSON/stringify (js-object :resource resource :data result :as_of (utcNow context))))
          (js-call (nativeGet (nativeGet context "store") "db") :run
            "DELETE FROM resource_cache WHERE rowid IN (SELECT rowid FROM resource_cache ORDER BY expires_at DESC,rowid DESC LIMIT -1 OFFSET 1000)")
          (success nil))))))
      (js-object :resource resource :data result :as_of (utcNow context))))
  (defasync resolveResource (context args)
    (let* ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet args "connection_id")))
      (resource (and connection (parseResource connection (nativeGet args "url"))))
      (revision (nativeGet connection "identity_revision" (nativeGet connection "revision")))
      (parameters (safeFields resource (js-array "kind" "token")))
      (key (cacheKey resource "resolve" parameters))
      (page (cached context key revision)))
      (unless resource (must (failure "forbidden")))
      (must (requirePermission context "resource.read" (resourceAddress resource)))
      (currentResource context resource revision)
      (when (= (nativeGet args "corpus") "native")
        (setq page (await (fetchResource context resource revision "resolve" parameters key))))
      (unless page (must (failure "content_unavailable")))
      (let* ((data (nativeGet page "data")) (node (nativeGet data "node"))
        (resolved (Object/assign (js-object) resource)))
        (when node
          (put resolved :node_token (nativeGet resource "token")) (when (nativeGet node "space_id") (put resolved :space_id (nativeGet node "space_id")))
          (put resolved :kind (nativeGet node "obj_type")) (put resolved :token (nativeGet node "obj_token"))
          (put resolved :title (nativeGet node "title" "")))
        (unless node
          (put resolved :title (or (nativeGet (nativeGet data "document") "title") (nativeGet (nativeGet data "app") "name")
            (nativeGet data "title") "")))
        (unless (js-call (js-array "docx" "sheet" "bitable") :includes (nativeGet resolved "kind")) (must (failure "unsupported")))
        (currentResource context resolved revision)
        (success (projectResource context resolved revision)))))
  (defasync readResource (context args)
    (let* ((handle (must (resolveResourceHandle context (nativeGet args "resource_ref") "resource")))
      (resource (Object/assign (js-object) (nativeGet handle "resource")))
      (revision (nativeGet handle "identity_revision")) (view (nativeGet args "view" "content"))
      (cursor (and (nativeGet args "cursor") (must (resolveResourceHandle context (nativeGet args "cursor") "cursor"))))
      (query (hashValue (Object/assign (js-object) args (js-object :cursor nil :request_id nil :offset_bytes nil))))
      (parameters nil) (key nil) (page nil) (offset (nativeGet args "offset_bytes" 0)) (cache-hit false))
      (js-call (js-array "table_id" "record_id") :forEach (lambda (field)
        (when (nativeGet args field)
          (component (nativeGet args field))
          (when (and (nativeGet resource field) (not (= (nativeGet resource field) (nativeGet args field)))) (must (failure "forbidden")))
          (put resource field (nativeGet args field)))))
      (currentResource context resource revision)
      (must (requirePermission context "resource.read" (resourceAddress resource)))
      (when (and (not (and (= view "children") (nativeGet resource "node_token")))
        (not (js-call (if (= (nativeGet resource "kind") "docx") (js-array "content" "comments")
          (if (= (nativeGet resource "kind") "sheet") (js-array "content" "children" "comments")
            (js-array "content" "children" "fields" "records" "comments"))) :includes view))) (must (failure "unsupported")))
      (when cursor
        (unless (and (= (nativeGet cursor "query_hash") query) (= (nativeGet cursor "identity_revision") revision)
          (= (nativeGet cursor "resource_key") (str "resource_" (hashValue resource)))) (must (failure "stale_reference")))
        (setq offset (nativeGet cursor "offset" 0)))
      (setq parameters (Object/assign (js-object) (safeFields resource (js-array "kind" "token" "table_id" "record_id" "space_id"))
        (js-object :view view :limit (nativeGet args "limit" 20) :page_token (nativeGet cursor "native_token" nil))))
      (when (nativeGet args "range") (put parameters :range (nativeGet args "range")))
      (when (and (= view "children") (nativeGet resource "node_token"))
        (let ((wiki (Object/assign (js-object) resource (js-object :kind "wiki" :token (nativeGet resource "node_token")))))
          (currentResource context wiki revision)
          (must (requirePermission context "resource.read" (resourceAddress wiki)))
          (put parameters :kind "wiki") (put parameters :token (nativeGet resource "node_token"))))
      (setq key (cacheKey resource "read" parameters))
      (setq page (cached context key revision) cache-hit (not (nil? page)))
      (when (and (= (nativeGet args "corpus") "native") (or (not cursor) (not (= key (nativeGet cursor "cache_key")))))
        (setq page (await (fetchResource context resource revision "read" parameters key)) cache-hit false))
      (unless page (must (failure "content_unavailable")))
      (let* ((data (nativeGet page "data")) (text (JSON/stringify data))
        (slice (sliceUtf8 text offset (nativeGet args "max_bytes" 16384)))
        (body-done (nativeGet slice "complete")) (native-more (= (nativeGet data "has_more") t))
        (next-token (if body-done (nativeGet data "page_token" nil) (nativeGet cursor "native_token" nil)))
        (next nil) (descriptor (projectResource context resource revision)))
        (unless (nativeGet slice "ok") (must slice))
        (when (and native-more (not (nativeGet data "page_token"))) (must (failure "incompatible")))
        (when (or (not body-done) native-more)
          (setq next (nativeGet (must (issueResourceHandle context "cursor" (str "resource_" (hashValue resource))
            (js-object :query_hash query :identity_revision revision :cache_key key
              :native_token next-token :offset (if body-done 0 (nativeGet slice "next_offset_bytes")))
            (nativeGet limits "handle_ttl_seconds"))) "ref")))
        (currentResource context resource revision)
        (let ((result (js-object :resource descriptor :text (nativeGet slice "text") :format "json"
          :offset_bytes offset :next_offset_bytes (nativeGet slice "next_offset_bytes") :total_bytes (nativeGet slice "total_bytes")
          :next_cursor next :complete (and body-done (not native-more)) :body_complete body-done :cache_hit cache-hit
          :as_of (nativeGet page "as_of") :coverage_complete false :external_data t)))
          (when (and (= offset 0) body-done) (put result :data data))
          (success result)))))
  (defun recoveryEvent (resource record observed-at)
    (unless (and (= (nativeGet resource "kind") "bitable") (nativeGet resource "table_id") (nativeGet resource "record_id")
      (= (nativeGet record "record_id") (nativeGet resource "record_id"))
      (= (nativeTypeOf (nativeGet record "fields")) "object") (not (nil? (nativeGet record "fields")))
      (not (Array/isArray (nativeGet record "fields")))) (must (failure "content_unavailable")))
    (let ((key (str "resource-recovery:" (hashValue (js-array (resourceAddress resource) record)))))
      (js-object :connection_id (nativeGet resource "connection_id") :source_key key :native_message_id key :event_kind "resource.changed"
        :conversation (resourceAddress resource)
        :resource (Object/assign (js-object) (safeFields resource (js-array "connection_id" "kind" "token" "table_id" "record_id"))
          (js-object :event_type "explicit_resource_recovery" :action "snapshot_recovered"))
        :sender (js-object :id "resource_recovery" :kind "unknown") :source_time observed-at :source_revision "1"
        :root_message_id (nativeGet resource "token") :people (peopleIn (nativeGet record "fields")) :mentions (js-array)
        :content (js-object :kind "text" :text (JSON/stringify (js-object :action "snapshot_recovered" :record record)) :truncated false)
        :attachments (js-array))))
  (defasync recoverResource (context args)
    (let* ((handle (must (resolveResourceHandle context (nativeGet args "resource_ref") "resource")))
      (resource (nativeGet handle "resource")) (revision (nativeGet handle "identity_revision"))
      (address (resourceAddress resource))
      (parameters (Object/assign (js-object) (safeFields resource (js-array "kind" "token" "table_id" "record_id"))
        (js-object :view "records" :limit 20 :page_token nil))))
      (currentResource context resource revision "resource.recover")
      (must (requirePermission context "resource.read" address))
      (unless (and (= (nativeGet resource "kind") "bitable") (nativeGet resource "table_id") (nativeGet resource "record_id"))
        (must (failure "invalid_argument")))
      (let* ((page (await (fetchResource context resource revision "read" parameters (cacheKey resource "read" parameters))))
        (event (recoveryEvent resource (nativeGet (nativeGet page "data") "record") (nativeGet page "as_of"))))
        (js-call context :accept (lambda (tx operation-id)
          (must (ownerGuard context)) (currentResource context resource revision "resource.recover")
          (must (requirePermission context "resource.read" address))
          (put event :ingress_evidence (js-object :kind "explicit_resource_recovery" :operation_id operation-id
            :requested_by (nativeGet (currentPrincipal context) "principal_id") :reason (nativeGet args "reason") :recovered_at (utcNow context)))
          (let ((result (must (acceptEvent context (nativeGet resource "connection_id") event undefined))))
            (unless (nativeGet result "accepted") (must (failure "content_unavailable")))
            (success (js-object :recovery_id operation-id :resource (safeFields resource (js-array "connection_id" "kind" "token" "table_id" "record_id"))
              :identity_revision revision :event_ids (js-array (nativeGet result "event_id"))
              :created_count (if (nativeGet result "duplicate") 0 1) :realtime false))))
          (lambda (data) (js-array (typedRef "resource_recovery" (nativeGet data "recovery_id"))))))))
  (defun projectResourceRecovery (context record)
    (try
      (let* ((data (nativeGet (nativeGet record "safe_result") "data")) (resource (nativeGet data "resource")))
        (currentResource context resource (nativeGet data "identity_revision") "resource.recover")
        (must (requirePermission context "resource.read" (resourceAddress resource))) (success data))
      (catch error (or (nativeGet error "domain_result") (failure "forbidden")))))
  (defun watchRequestable (watch)
    (or (not watch) (= (nativeGet watch "state") "blocked")))
  (defasync watchResource (context args)
    (let* ((handle (must (resolveResourceHandle context (nativeGet args "resource_ref") "resource")))
      (resource (nativeGet handle "resource")) (revision (nativeGet handle "identity_revision"))
      (key (str "watch_" (hashValue (js-array (nativeGet resource "connection_id") revision (nativeGet resource "token")))))
      (request-needed false) (accepted nil))
      (currentResource context resource revision "resource.subscribe")
      (must (requirePermission context "resource.subscribe" (resourceAddress resource)))
      (setq accepted (js-call context :accept (lambda (tx operation-id)
        (currentResource context resource revision "resource.subscribe")
        (let* ((row (js-call (js-call (nativeGet tx "db") :query "SELECT payload FROM resource_watches WHERE watch_id=?") :get key))
          (watch (and row (JSON/parse (nativeGet row "payload")))))
          (when (watchRequestable watch)
            (setq request-needed t)
            (setq watch (Object/assign (js-object :watch_id key) (or watch (js-object))
              (js-object :operation_id operation-id :resource resource :identity_revision revision :state "native_unknown")))
            (Reflect/deleteProperty watch "native_error") (Reflect/deleteProperty watch "event_channel")
            (js-call (js-call (nativeGet tx "db") :query
              "INSERT INTO resource_watches(watch_id,connection_id,identity_revision,resource_token,state,payload) VALUES(?,?,?,?,?,?) ON CONFLICT(watch_id) DO UPDATE SET state=excluded.state,payload=excluded.payload")
              :run key (nativeGet resource "connection_id") revision (nativeGet resource "token") "native_unknown" (JSON/stringify watch)))
          (success watch))) (lambda (data) (js-array (typedRef "resource_watch" key)))))
      (if (or (not (nativeGet accepted "ok")) (not request-needed)) accepted
        (let ((watch (nativeGet accepted "data")))
          (try
            (await (fetchResource context resource revision "watch" (safeFields resource (js-array "kind" "token")) nil))
            (put watch :state "subscribed")
            (put watch :event_channel (if (= (nativeGet (currentResource context resource revision "resource.subscribe") "source_delivery") "events") "configured" "not_configured"))
            (catch error
              (let* ((details (nativeGet (nativeGet (nativeGet error "domain_result") "error") "details"))
                (rejected (and (> (nativeGet details "code" 0) 0)
                  (js-call (js-array 400 401 403 404 422) :includes (nativeGet details "http_status")))))
                (put watch :state (if rejected "blocked" "native_unknown"))
                (put watch :native_error (or details (js-object :reason "native_status_unconfirmed"))))))
          (must (await (enqueueWrite context (lambda ()
            (must (ownerGuard context))
            (currentResource context resource revision "resource.subscribe")
            (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "UPDATE resource_watches SET state=?,payload=? WHERE watch_id=?")
              :run (nativeGet watch "state") (JSON/stringify watch) key) (success nil)))))
          (success watch (js-object :operation_id (nativeGet accepted "operation_id") :effect_state "recorded"))))))
  (defun resourceEnvelope (context recipient event)
    (let* ((scoped (Object/assign (js-object) context (js-object :principal recipient)))
      (resource (safeFields (nativeGet event "resource") (js-array "connection_id" "kind" "token" "table_id" "record_id" "event_type" "action"))))
      (currentResource scoped resource (nativeGet event "identity_revision"))
      (projectResource scoped resource (nativeGet event "identity_revision"))))
  (defun projectWatch (context watch)
    (try
      (currentResource context (nativeGet watch "resource") (nativeGet watch "identity_revision"))
      (must (requirePermission context "resource.read" (resourceAddress (nativeGet watch "resource"))))
      (success watch)
      (catch error (or (nativeGet error "domain_result") (failure "forbidden")))))
  (defasync handleOperation (context operation args)
    (try
      (cond ((= operation "resource.watch.get")
        (let* ((row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "SELECT payload FROM resource_watches WHERE watch_id=?") :get (nativeGet args "watch_id")))
          (watch (and row (JSON/parse (nativeGet row "payload")))))
          (unless watch (must (failure "not_found")))
          (currentResource context (nativeGet watch "resource") (nativeGet watch "identity_revision"))
          (must (requirePermission context "resource.read" (resourceAddress (nativeGet watch "resource"))))
          (success watch)))
        ((= operation "resource.resolve") (await (resolveResource context args)))
        ((= operation "resource.read") (await (readResource context args)))
        ((= operation "resource.watch") (await (watchResource context args)))
        ((= operation "resource.recover") (await (recoverResource context args))))
      (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))
  (export handleOperation resourceAddress resourceEnvelope parseResource projectWatch projectResourceRecovery recoveryEvent watchRequestable))
