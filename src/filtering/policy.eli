(module dj.filtering.policy
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/types.eli" utf8Bytes)
  (import "../core/rules.eli" validatePredicate evaluatePredicate)
  (import "../core/errors.eli" success invalidField)
  (defconst filterPolicyId "service")
  (defconst filterResource (Object/freeze (js-object :resource_key "message-filter:service")))
  (defun readFilterPolicy (context)
    (or (js-call (nativeGet context "repository") :get "message_filter_policies" filterPolicyId)
      (js-object :policy_id filterPolicyId :schema_version 1 :scope "service" :revision 1 :rules (js-array))))
  (defun validateFilterRules (rules)
    (let ((ids (new globalThis.Set)) (problem nil) (index 0) (visit nil))
      (unless (and (Array/isArray rules) (<= (js-length rules) 64))
        (setq problem (invalidField "/rules" "an array of at most 64 filter rules")))
      (setq visit (lambda (node)
        (cond ((object-has? node :all) (js-call (nativeGet node "all") :forEach visit))
          ((object-has? node :any) (js-call (nativeGet node "any") :forEach visit))
          ((object-has? node :not) (funcall visit (nativeGet node "not")))
          ((and (js-call (js-array "contains" "prefix") :includes (nativeGet node "op"))
                (= (nativeGet node "value") ""))
            (setq problem (invalidField (str "/rules/" index "/predicate") "a nonempty literal text pattern"))))))
      (when (not problem)
        (when (> (utf8Bytes (JSON/stringify rules)) 65536)
          (setq problem (invalidField "/rules" "at most 65536 UTF-8 bytes")))
        (while (and (not problem) (< index (js-length rules)))
          (let* ((rule (aref rules index)) (id (nativeGet rule "id"))
            (predicate (nativeGet rule "predicate")) (keys (and rule (Object/keys rule))))
            (if (not (and rule (= (nativeTypeOf rule) "object") (not (Array/isArray rule))
              (= (nativeTypeOf id) "string") (> (js-length id) 0) (<= (js-length id) 128)
              (not (js-call ids :has id)) (= (nativeTypeOf (nativeGet rule "enabled")) "boolean")
              (= (nativeGet rule "effect") "suppress_trigger") (= (js-length keys) 4)
              (js-call keys :every (lambda (key) (js-call (js-array "id" "enabled" "effect" "predicate") :includes key)))))
              (setq problem (invalidField (str "/rules/" index) "a unique id, boolean enabled, supported effect and predicate"))
              (let ((valid (validatePredicate predicate)))
                (if (nativeGet valid "ok")
                  (progn (js-call ids :add id) (funcall visit predicate))
                  (setq problem (invalidField (str "/rules/" index "/predicate") "a bounded typed all/any/not predicate"))))))
          (setq index (1+ index))))
      (or problem (success rules))))
  (defun evaluateTriggerFilters (context event)
    ;; A fresh policy is read inside the synchronous event/submission transaction.
    ;; No result is reused across events, policy revisions, or visibility checks.
    (let* ((policy (readFilterPolicy context)) (matches (js-array)) (uncertain (js-array)))
      (js-call (nativeGet policy "rules") :forEach (lambda (rule)
        (when (and (nativeGet rule "enabled") (= (nativeGet rule "effect") "suppress_trigger"))
          (let ((answer (evaluatePredicate (nativeGet rule "predicate") event)))
            (cond ((= answer "true") (js-call matches :push (nativeGet rule "id")))
              ((= answer "indeterminate") (js-call uncertain :push (nativeGet rule "id"))))))))
      (Object/freeze (js-object :policy_revision (nativeGet policy "revision")
        :suppressed (> (+ (js-length matches) (js-length uncertain)) 0)
        :matched_rule_ids (Object/freeze matches) :indeterminate_rule_ids (Object/freeze uncertain)))))
  (export filterPolicyId filterResource readFilterPolicy validateFilterRules evaluateTriggerFilters))
