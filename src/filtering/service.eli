(module dj.filtering.service
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" nextRevision)
  (import "../application/context.eli" requirePermission can must utcNow typedRef)
  (import "./policy.eli" filterPolicyId filterResource readFilterPolicy validateFilterRules)
  (defun projectFilterPolicy (context record)
    (if (or (can context "message.filter.inspect" filterResource) (can context "message.filter.manage" filterResource))
      (success record) (failure "forbidden")))
  (defun handleOperation (context operation args)
    (if (= operation "message.filter.get")
      (let ((permission (requirePermission context "message.filter.inspect" filterResource)))
        (if (nativeGet permission "ok") (projectFilterPolicy context (readFilterPolicy context)) permission))
      (let* ((permission (requirePermission context "message.filter.manage" filterResource))
             (valid (validateFilterRules (nativeGet args "rules"))))
        (cond ((not (nativeGet permission "ok")) permission)
          ((not (nativeGet valid "ok")) valid)
          (t (js-call context :accept
            (lambda (tx operation-id)
              (let* ((current (readFilterPolicy context)) (repository (nativeGet context "repository"))
                (record (js-object :policy_id filterPolicyId :schema_version 1 :scope "service"
                  :revision (nextRevision (nativeGet current "revision")) :rules (nativeGet valid "data")
                  :updated_at (utcNow context))))
                (if (not (= (nativeGet current "revision") (nativeGet args "expected_revision")))
                  (failure "revision_conflict")
                  (progn
                    (if (js-call repository :get "message_filter_policies" filterPolicyId)
                      (must (js-call repository :replace "message_filter_policies" record (nativeGet current "revision")))
                      (js-call repository :insert "message_filter_policies" record))
                    (projectFilterPolicy context record)))))
            (lambda (record) (js-array (typedRef "message_filter" filterPolicyId)))))))))
  (export handleOperation projectFilterPolicy))
