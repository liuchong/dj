(module dj.service.fixed-routes
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" hashValue stableSessionKey conversationKey addSeconds nextRevision nextSeq)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" inTransaction must utcNow nextId issueResourceHandle safeFields)
  (import "../application/schema.eli" validateRequest normalizeArgs)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../catalog/service.eli" resolveSession)
  (import "../registry/agents.eli" registerAgent)
  (import "../subscriptions/service.eli" previewSubscription commitSubscription changeSubscriptionState revokeVersion insertVersion)
  (import "./config.eli" fixedRouteTarget)
  (import "./ownership.eli" ownerGuard)
  (defun routeRecord (context id)
    (let ((row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "SELECT payload FROM fixed_routes WHERE id=?") :get id)))
      (and row (JSON/parse (nativeGet row "payload")))))
  (defun saveRoute (context record)
    (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
      "INSERT INTO fixed_routes(id,state,next_attempt_at,payload) VALUES(?,?,?,?) ON CONFLICT(id) DO UPDATE SET state=excluded.state,next_attempt_at=excluded.next_attempt_at,payload=excluded.payload")
      :run (nativeGet record "id") (nativeGet record "state") (nativeGet record "next_attempt_at") (JSON/stringify record)))
  (defun routeDesiredHash (config route)
    (hashValue (js-array route (fixedRouteTarget config route)
      (safeFields (configuredPrincipal (nativeGet config "principals") (nativeGet route "owner_principal_id")) (js-array "authorization_revision" "grants"))
      (safeFields (configuredPrincipal (nativeGet config "principals") (nativeGet route "recipient_principal_id")) (js-array "authorization_revision" "target_constraint" "grants"))
      (js-call (nativeGet route "sources") :map (lambda (source)
        (let ((connection (js-call (nativeGet config "connections") :find
          (lambda (item) (= (nativeGet item "connection_id") (nativeGet source "connection_id"))))))
          (js-array (nativeGet connection "connection_id") (nativeGet connection "identity_revision" (nativeGet connection "revision" 1)))))))))
  (defun pauseOwned (context record)
    (let* ((repository (nativeGet context "repository"))
      (sub (and (nativeGet record "subscription_id") (js-call repository :get "subscriptions" (nativeGet record "subscription_id")))))
      (when (and sub (= (nativeGet sub "state") "active"))
        (unless (= (nativeGet sub "configuration_id") (nativeGet record "id")) (must (failure "forbidden")))
        (let ((cutover (js-call repository :currentSequence "ingress")) (revision (nativeGet sub "revision")))
          (revokeVersion context (nativeGet sub "subscription_id") revision cutover)
          (put sub :revision (nextRevision revision)) (put sub :state "paused")
          (put sub :cutover_seq cutover) (put sub :start_seq (nextSeq cutover))
          (must (js-call repository :replace "subscriptions" sub revision)) (insertVersion context sub)))))
  (defun seedFixedRoutes (context config)
    (inTransaction context (lambda (tx)
      (must (ownerGuard context))
      (let* ((db (nativeGet tx "db")) (desired (nativeGet config "fixed_routes" (js-array)))
        (ids (new globalThis.Set (js-call desired :map (lambda (route) (nativeGet route "id"))))))
        (js-call (js-call (js-call db :query "SELECT payload FROM fixed_routes") :all) :forEach (lambda (row)
          (let ((record (JSON/parse (nativeGet row "payload"))))
            (unless (js-call ids :has (nativeGet record "id"))
              (pauseOwned context record)
              (js-call (js-call db :query "DELETE FROM fixed_routes WHERE id=?") :run (nativeGet record "id"))))))
        (js-call desired :forEach (lambda (route)
          (let* ((id (nativeGet route "id")) (old (routeRecord context id)) (digest (routeDesiredHash config route)))
            (unless (and old (= (nativeGet old "desired_hash") digest))
              (when old (pauseOwned context old))
              (let ((same-target (and old (= (hashValue (nativeGet old "target")) (hashValue (fixedRouteTarget config route)))
                (= (nativeGet old "recipient_principal_id") (nativeGet route "recipient_principal_id"))
                (= (nativeGet old "owner_principal_id") (nativeGet route "owner_principal_id")))))
                (saveRoute context (js-object :id id :desired_hash digest :generation (nextId context "fixed_route")
                  :owner_principal_id (nativeGet route "owner_principal_id") :recipient_principal_id (nativeGet route "recipient_principal_id")
                  :target (fixedRouteTarget config route) :state (if (= (nativeGet route "enabled") false) "disabled" "pending")
                  :next_attempt_at (utcNow context) :attempts 0 :last_error nil :applied_hash nil
                  :agent_id (if same-target (nativeGet old "agent_id" nil) nil)
                  :subscription_id (if same-target (nativeGet old "subscription_id" nil) nil))))))))
        (success nil)))))
  (defun fenced (context record)
    (must (ownerGuard context))
    (let ((current (routeRecord context (nativeGet record "id"))))
      (unless (and current (= (nativeGet current "generation") (nativeGet record "generation"))
        (not (= (nativeGet current "state") "disabled"))) (must (failure "stale_reference")))))
  (defun routeRetrySeconds (attempts)
    (Math/min 300 (* 5 (Math/pow 2 (Math/min 6 (Math/max 0 (1- attempts)))))))
  (defun makeRouteContext (context record phase)
    (let ((scoped (Object/assign (js-object) context (js-object
      :principal (configuredPrincipal (nativeGet (nativeGet context "config") "principals") (nativeGet record "owner_principal_id"))
      :now (utcNow context) :abort_signal (nativeGet (nativeGet (nativeGet context "runtime") "intake_abort") "signal") :fixed_route_id (nativeGet record "id")))))
      ;; Configuration is the durable management ledger. These are local domain
      ;; mutations, not fabricated API operations or native message submissions.
      (put scoped :accept (lambda (mutate refs)
        (inTransaction scoped (lambda (tx)
          (fenced scoped record)
          (let ((result (funcall mutate tx nil)))
            (when (nativeGet result "ok")
              (let ((data (nativeGet result "data")))
                (if (= phase "agent")
                  (progn
                    (when (and (nativeGet record "agent_id") (not (= (nativeGet record "agent_id") (nativeGet data "agent_id"))))
                      (pauseOwned scoped record) (put record :subscription_id nil) (put record :applied_hash nil))
                    (put record :agent_id (nativeGet data "agent_id")))
                  (when (nativeGet data "subscription_id")
                    (put record :subscription_id (nativeGet data "subscription_id"))
                    (put record :applied_hash (nativeGet record "desired_hash"))
                    (let* ((repository (nativeGet scoped "repository")) (sub (js-call repository :get "subscriptions" (nativeGet data "subscription_id"))))
                      (put sub :configuration_id (nativeGet record "id"))
                      (must (js-call repository :replace "subscriptions" sub (nativeGet sub "revision")))))))
              (saveRoute scoped record)) result))))) scoped))
  (defasync ensureAgent (context record)
    (let* ((repository (nativeGet context "repository")) (target (nativeGet record "target"))
      (row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
        "SELECT payload FROM agents WHERE recipient_principal_id=? AND state='registered'") :get (nativeGet record "recipient_principal_id")))
      (existing (and row (JSON/parse (nativeGet row "payload")))) (scoped (makeRouteContext context record "agent")))
      (if existing
        (progn
          (unless (and
            (= (nativeGet (js-call repository :get "sessions" (stableSessionKey target)) "instance_id") (nativeGet target "instance_id"))
            (= (nativeGet existing "owner_principal_id") (nativeGet record "owner_principal_id"))
            (js-call (js-array "tool" "native_namespace" "native_session_id") :every
              (lambda (key) (= (nativeGet existing key) (nativeGet target key))))) (must (failure "target_unbound")))
          (must (inTransaction context (lambda (tx) (fenced context record)
            (put record :agent_id (nativeGet existing "agent_id")) (saveRoute context record) (success nil)))))
        (progn
          (must (await (resolveSession scoped (safeFields target (js-array "instance_id" "native_session_id")))))
          (let* ((session (js-call repository :get "sessions" (stableSessionKey target)))
            (instance (js-call repository :get "instances" (nativeGet target "instance_id")))
            (candidate (must (issueResourceHandle scoped "candidate" (nativeGet session "session_key")
              (js-object :target session :instance_id (nativeGet target "instance_id")
                :instance_epoch (nativeGet instance "instance_epoch") :surface (nativeGet session "surface" "cli")) 300))))
            (must (await (registerAgent scoped (js-object :candidate_ref (nativeGet candidate "ref")
              :display_name (str "Fixed route " (nativeGet record "id")) :binding_mode "existing"
              :recipient_principal_id (nativeGet record "recipient_principal_id"))))))))
      (nativeGet record "agent_id")))
  (defun routeSpec (context route record)
    (let* ((scoped (makeRouteContext context record "subscription"))
      (sources (js-call (nativeGet route "sources") :map (lambda (source)
        (if (not (nativeGet source "native_chat_id")) (js-object :connection_id (nativeGet source "connection_id"))
          (let* ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet source "connection_id")))
            (address (Object/assign (js-object :native_thread_id nil :thread_kind "main")
              (safeFields source (js-array "connection_id" "native_chat_id" "native_thread_id"))))
            (handle (must (issueResourceHandle scoped "conversation" (conversationKey address)
              (js-object :address address :identity_revision (nativeGet connection "identity_revision") :source_revision (nativeGet connection "identity_revision")) 300))))
            (js-object :conversation_ref (nativeGet handle "ref")
              :include_threads (nativeGet source "include_threads" (not (nativeGet source "native_thread_id")))))))))
      (spec (Object/assign (js-object :agent_id (nativeGet record "agent_id") :selector (js-object :sources sources))
        (safeFields route (js-array "predicate" "context_policy" "delivery_policy" "instruction_policy")))))
      (when (nativeGet route "event_kinds") (put (nativeGet spec "selector") :event_kinds (nativeGet route "event_kinds")))
      (js-object :context scoped :args (js-object :spec spec))))
  (defasync reconcileRoute (context record route)
    (try
      (await (ensureAgent context record))
      (let* ((repository (nativeGet context "repository"))
        (sub (and (nativeGet record "subscription_id") (js-call repository :get "subscriptions" (nativeGet record "subscription_id"))))
        (scoped (makeRouteContext context record "subscription")))
        (unless (and sub (= (nativeGet record "applied_hash") (nativeGet record "desired_hash")) (not (= (nativeGet sub "state") "deleted")))
          (let* ((prepared (routeSpec context route record)) (args (nativeGet prepared "args")))
            (setq scoped (nativeGet prepared "context"))
            (when (and sub (not (= (nativeGet sub "state") "deleted")))
              (put args :subscription_id (nativeGet sub "subscription_id")) (put args :expected_revision (nativeGet sub "revision")))
            (must (validateRequest "subscription.preview" args))
            (let* ((preview (must (await (previewSubscription scoped (normalizeArgs "subscription.preview" args)))))
              (commit (js-object :preview_id (nativeGet preview "preview_id"))))
              (when (nativeGet args "subscription_id") (put commit :subscription_id (nativeGet args "subscription_id"))
                (put commit :expected_revision (nativeGet args "expected_revision")))
              (must (commitSubscription scoped (if (nativeGet args "subscription_id") "subscription.update" "subscription.create") commit)))))
        (setq sub (js-call repository :get "subscriptions" (nativeGet record "subscription_id")))
        (when (= (nativeGet sub "state") "paused")
          (must (changeSubscriptionState scoped "subscription.resume" (js-object :subscription_id (nativeGet sub "subscription_id") :expected_revision (nativeGet sub "revision")))))
        (inTransaction context (lambda (tx) (fenced context record)
          (put record :state "active") (put record :last_error nil) (put record :attempts 0)
          (put record :next_attempt_at (addSeconds (utcNow context) 30)) (saveRoute context record) (success nil))))
      (catch error
        (let ((code (nativeGet (nativeGet (nativeGet error "domain_result") "error") "code" "unavailable")))
          (inTransaction context (lambda (tx)
            (must (ownerGuard context))
            (let ((current (routeRecord context (nativeGet record "id"))))
              (when (and current (= (nativeGet current "generation") (nativeGet record "generation"))
                (not (= (nativeGet current "state") "disabled")))
                (put current :attempts (1+ (nativeGet current "attempts" 0)))
                (put current :state (if (js-call (js-array "forbidden" "target_unbound" "unsupported" "invalid_argument") :includes code) "blocked" "retrying"))
                (put current :last_error code)
                (put current :next_attempt_at (addSeconds (utcNow context) (routeRetrySeconds (nativeGet current "attempts"))))
                (saveRoute context current))) (success nil)))))))
  (defasync processFixedRoutes (context)
    (let ((rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
      "SELECT payload FROM fixed_routes WHERE state<>'disabled' AND next_attempt_at<=? ORDER BY next_attempt_at,id LIMIT 2") :all (utcNow context))) (index 0) (result (success nil)))
      (while (and (nativeGet result "ok") (< index (js-length rows)) (= (nativeGet (nativeGet context "runtime") "state") "ready"))
        (let* ((record (JSON/parse (nativeGet (aref rows index) "payload")))
          (route (js-call (nativeGet (nativeGet context "config") "fixed_routes" (js-array)) :find
            (lambda (item) (= (nativeGet item "id") (nativeGet record "id"))))))
          (when route (setq result (await (reconcileRoute context record route)))))
        (setq index (1+ index))) result))
  (defun projectFixedRoutes (context)
    (let* ((principal (nativeGet context "principal")) (pid (nativeGet principal "principal_id"))
      (operator (= (nativeGet principal "kind") "operator"))
      (rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "SELECT payload FROM fixed_routes ORDER BY id") :all))
      (items (js-array)))
      (js-call rows :forEach (lambda (row)
        (let ((record (JSON/parse (nativeGet row "payload"))))
          (when (or operator (= pid (nativeGet record "recipient_principal_id")))
            (js-call items :push (safeFields record (js-array "id" "state" "target" "owner_principal_id" "recipient_principal_id" "agent_id" "subscription_id" "last_error" "attempts" "next_attempt_at"))))))) items))
  (export seedFixedRoutes processFixedRoutes projectFixedRoutes routeDesiredHash routeRetrySeconds))
