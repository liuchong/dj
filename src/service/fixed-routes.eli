(module dj.service.fixed-routes
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" canonicalTargetKey hashValue stableSessionKey conversationKey addSeconds nextRevision nextSeq)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" inTransaction must utcNow nextId issueResourceHandle safeFields)
  (import "../application/schema.eli" validateRequest normalizeArgs)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../catalog/service.eli" resolveSession)
  (import "../registry/agents.eli" registerAgent)
  (import "../subscriptions/service.eli" previewSubscription commitSubscription changeSubscriptionState revokeVersion insertVersion)
  (import "./config.eli" fixedRouteTarget fixedRouteSlotKey)
  (import "./ownership.eli" ownerGuard)
  (defun routeRecord (context id)
    (let ((row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "SELECT payload FROM fixed_routes WHERE id=?") :get id)))
      (and row (JSON/parse (nativeGet row "payload")))))
  (defun saveRoute (context record)
    (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
      "INSERT INTO fixed_routes(id,state,next_attempt_at,payload) VALUES(?,?,?,?) ON CONFLICT(id) DO UPDATE SET state=excluded.state,next_attempt_at=excluded.next_attempt_at,payload=excluded.payload")
      :run (nativeGet record "id") (nativeGet record "state") (nativeGet record "next_attempt_at") (JSON/stringify record)))
  (defun routeDesiredHash (config route)
    (let ((target (fixedRouteTarget config route))
          (connections (js-call (nativeGet config "connections" (js-array)) :filter
            (lambda (item) (not (nativeGet item "disabled"))))))
      (hashValue
        (js-array
          route
          target
          (safeFields (configuredPrincipal (nativeGet config "principals") (nativeGet route "owner_principal_id"))
            (js-array "authorization_revision" "grants"))
          (safeFields (configuredPrincipal (nativeGet config "principals") (nativeGet route "recipient_principal_id"))
            (js-array "authorization_revision" "target_constraint" "grants"))
          (js-call connections :map (lambda (connection)
            (js-array (nativeGet connection "connection_id")
              (nativeGet connection "identity_revision" (nativeGet connection "revision" 1)))))))))
  (defun pauseOwned (context record)
    (let* ((repository (nativeGet context "repository"))
           (target-key (nativeGet record "target_key"))
           (sub (and target-key (js-call repository :get "subscriptions" target-key))))
      (when (and sub (= (nativeGet sub "configuration_id") (nativeGet record "id")))
        (when (= (nativeGet sub "state") "active")
          (let ((cutover (js-call repository :currentSequence "ingress"))
                (revision (nativeGet sub "revision")))
            (revokeVersion context target-key revision cutover)
            (put sub :revision (nextRevision revision))
            (put sub :state "paused")
            (put sub :cutover_seq cutover)
            (put sub :start_seq (nextSeq cutover))
            (put sub :configuration_id nil)
            (must (js-call repository :replace "subscriptions" sub revision))
            (insertVersion context sub)))
        (when (= (nativeGet sub "state") "paused")
          (when (nativeGet sub "configuration_id")
            (put sub :configuration_id nil)
            (must (js-call repository :replace "subscriptions" sub (nativeGet sub "revision"))))))))
  (defun seedFixedRoutes (context config)
    (inTransaction context (lambda (tx)
      (must (ownerGuard context))
      (let* ((db (nativeGet tx "db"))
             (desired (nativeGet config "fixed_routes" (js-array)))
             (ids (new globalThis.Set (js-call desired :map (lambda (route) (nativeGet route "id"))))))
        (js-call (js-call (js-call db :query "SELECT payload FROM fixed_routes") :all) :forEach (lambda (row)
          (let ((record (JSON/parse (nativeGet row "payload"))))
            (unless (js-call ids :has (nativeGet record "id"))
              (pauseOwned context record)
              (js-call (js-call db :query "DELETE FROM fixed_routes WHERE id=?") :run (nativeGet record "id"))))))
        (js-call desired :forEach (lambda (route)
          (let* ((id (nativeGet route "id"))
                 (old (routeRecord context id))
                 (digest (routeDesiredHash config route))
                 (target (fixedRouteTarget config route))
                 (slot-key (fixedRouteSlotKey route target)))
            (unless (and old (= (nativeGet old "desired_hash") digest))
              (when old (pauseOwned context old))
              (let ((same-target (and old
                                      (= (nativeGet old "target_key") slot-key)
                                      (= (nativeGet old "recipient_principal_id") (nativeGet route "recipient_principal_id"))
                                      (= (nativeGet old "owner_principal_id") (nativeGet route "owner_principal_id")))))
                (saveRoute context
                  (js-object
                    :id id
                    :desired_hash digest
                    :generation (nextId context "fixed_route")
                    :owner_principal_id (nativeGet route "owner_principal_id")
                    :recipient_principal_id (nativeGet route "recipient_principal_id")
                    :target target
                    :target_key slot-key
                    :state (if (= (nativeGet route "enabled") false) "disabled" "pending")
                    :next_attempt_at (utcNow context)
                    :attempts 0
                    :last_error nil
                    :applied_hash nil
                    :agent_id (if same-target (nativeGet old "agent_id" nil) nil))))))))
        (success nil)))))
  (defun fenced (context record)
    (must (ownerGuard context))
    (let ((current (routeRecord context (nativeGet record "id"))))
      (unless (and current
                   (= (nativeGet current "generation") (nativeGet record "generation"))
                   (not (= (nativeGet current "state") "disabled")))
        (must (failure "stale_reference")))))
  (defun routeRetrySeconds (attempts)
    (Math/min 300 (* 5 (Math/pow 2 (Math/min 6 (Math/max 0 (1- attempts)))))))
  (defun makeRouteContext (context record phase)
    (let ((scoped (Object/assign (js-object) context
            (js-object
              :principal (configuredPrincipal (nativeGet (nativeGet context "config") "principals") (nativeGet record "owner_principal_id"))
              :now (utcNow context)
              :abort_signal (nativeGet (nativeGet (nativeGet context "runtime") "intake_abort") "signal")
              :fixed_route_id (nativeGet record "id")))))
      (put scoped :accept (lambda (mutate refs)
        (inTransaction scoped (lambda (tx)
          (fenced scoped record)
          (let ((result (funcall mutate tx nil)))
            (when (nativeGet result "ok")
              (let ((data (nativeGet result "data")))
                (if (= phase "agent")
                  (progn
                    (when (and (nativeGet record "agent_id")
                               (not (= (nativeGet record "agent_id") (nativeGet data "agent_id"))))
                      (pauseOwned scoped record)
                      (put record :applied_hash nil))
                    (put record :agent_id (nativeGet data "agent_id")))
                  (when (nativeGet data "target_key")
                    (put record :target_key (nativeGet data "target_key"))
                    (put record :applied_hash (nativeGet record "desired_hash"))
                    (let* ((repository (nativeGet scoped "repository"))
                           (sub (js-call repository :get "subscriptions" (nativeGet data "target_key"))))
                      (put sub :configuration_id (nativeGet record "id"))
                      (must (js-call repository :replace "subscriptions" sub (nativeGet sub "revision")))))))
              (saveRoute scoped record))
            result)))))
      scoped))
  (defasync ensureAgent (context record)
    (let* ((repository (nativeGet context "repository"))
           (target (nativeGet record "target"))
           (row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
             "SELECT payload FROM agents WHERE recipient_principal_id=? AND canonical_target_key=? AND state='registered'")
             :get (nativeGet record "recipient_principal_id") (canonicalTargetKey target)))
           (existing (and row (JSON/parse (nativeGet row "payload"))))
           (scoped (makeRouteContext context record "agent")))
      (if existing
        (progn
          (unless (and
            (= (nativeGet (js-call repository :get "sessions" (stableSessionKey target)) "instance_id") (nativeGet target "instance_id"))
            (= (nativeGet existing "owner_principal_id") (nativeGet record "owner_principal_id"))
            (js-call (js-array "tool" "native_namespace" "native_session_id") :every
              (lambda (key) (= (nativeGet existing key) (nativeGet target key)))))
            (must (failure "target_unbound")))
          (must (inTransaction context (lambda (tx)
            (fenced context record)
            (put record :agent_id (nativeGet existing "agent_id"))
            (saveRoute context record)
            (success nil)))))
        (progn
          (must (await (resolveSession scoped (safeFields target (js-array "instance_id" "native_session_id")))))
          (let* ((session (js-call repository :get "sessions" (stableSessionKey target)))
                 (instance (js-call repository :get "instances" (nativeGet target "instance_id")))
                 (candidate (must (issueResourceHandle scoped "candidate" (nativeGet session "session_key")
                   (js-object :target session :instance_id (nativeGet target "instance_id")
                     :instance_epoch (nativeGet instance "instance_epoch") :surface (nativeGet session "surface" "cli"))
                   300))))
            (must (await (registerAgent scoped (js-object
              :candidate_ref (nativeGet candidate "ref")
              :display_name (str "Fixed route " (nativeGet record "id"))
              :binding_mode "existing"
              :recipient_principal_id (nativeGet record "recipient_principal_id"))))))))
      (nativeGet record "agent_id")))
  (defun routeSpec (context route record)
    (let* ((scoped (makeRouteContext context record "subscription"))
           (rules (js-call (nativeGet route "rules") :map (lambda (rule)
             (let ((mapped (safeFields rule (js-array "id" "enabled" "event_kinds" "predicate" "context_policy" "instruction_policy"))))
               (put mapped :sources
                 (js-call (nativeGet rule "sources" (js-array)) :map (lambda (source)
                   (if (not (nativeGet source "native_chat_id"))
                     (js-object :connection_id (nativeGet source "connection_id"))
                     (let* ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet source "connection_id")))
                            (address (Object/assign (js-object :native_thread_id nil :thread_kind "main")
                              (safeFields source (js-array "connection_id" "native_chat_id" "native_thread_id"))))
                            (handle (must (issueResourceHandle scoped "conversation" (conversationKey address)
                              (js-object :address address :identity_revision (nativeGet connection "identity_revision")
                                :source_revision (nativeGet connection "identity_revision")) 300))))
                       (js-object :conversation_ref (nativeGet handle "ref")
                         :include_threads (nativeGet source "include_threads" (not (nativeGet source "native_thread_id")))))))))
               mapped))))
           (spec (Object/assign
             (js-object :agent_id (nativeGet record "agent_id") :rules rules)
             (safeFields route (js-array "delivery_mode" "context_policy" "delivery_policy" "instruction_policy" "distribution")))))
      (when (nativeGet route "group_id")
        (Reflect/deleteProperty spec "agent_id")
        (put spec :group_id (nativeGet route "group_id")))
      (js-object :context scoped :args (js-object :spec spec))))
  (defasync reconcileRoute (context record route)
    (try
      (unless (nativeGet route "group_id") (await (ensureAgent context record)))
      (let* ((repository (nativeGet context "repository"))
             (target-key (nativeGet record "target_key"))
             (sub (and target-key (js-call repository :get "subscriptions" target-key)))
             (scoped (makeRouteContext context record "subscription")))
        ;; Never overwrite an active/paused subscription created independently by an AI.
        (when (and sub
                   (not (= (nativeGet sub "state") "deleted"))
                   (not (= (nativeGet sub "configuration_id" nil) (nativeGet record "id")))
                   (not (and (= (nativeGet sub "state") "paused")
                             (not (nativeGet sub "configuration_id"))
                             (= (nativeGet sub "owner_principal_id") (nativeGet record "owner_principal_id")))))
          (must (failure "forbidden")))
        (unless (and sub
                     (= (nativeGet record "applied_hash") (nativeGet record "desired_hash"))
                     (not (= (nativeGet sub "state") "deleted")))
          (let* ((prepared (routeSpec context route record))
                 (args (nativeGet prepared "args"))
                 (expected (if sub (nativeGet sub "revision") 0)))
            (setq scoped (nativeGet prepared "context"))
            (put args :expected_revision expected)
            (must (validateRequest "subscription.preview" args))
            (let* ((preview (must (await (previewSubscription scoped (normalizeArgs "subscription.preview" args)))))
                   (commit (js-object :preview_id (nativeGet preview "preview_id") :expected_revision expected)))
              (must (commitSubscription scoped commit)))))
        (setq sub (js-call repository :get "subscriptions" target-key))
        (when (= (nativeGet sub "state") "paused")
          (let ((resume-args (js-object :expected_revision (nativeGet sub "revision"))))
            (if (nativeGet route "group_id")
              (put resume-args :group_id (nativeGet route "group_id"))
              (put resume-args :agent_id (nativeGet record "agent_id")))
            (must (changeSubscriptionState scoped "subscription.resume" resume-args))))
        (inTransaction context (lambda (tx)
          (fenced context record)
          (put record :state "active")
          (put record :last_error nil)
          (put record :attempts 0)
          (put record :next_attempt_at (addSeconds (utcNow context) 30))
          (saveRoute context record)
          (success nil))))
      (catch error
        (let ((code (nativeGet (nativeGet (nativeGet error "domain_result") "error") "code" "unavailable")))
          (inTransaction context (lambda (tx)
            (must (ownerGuard context))
            (let ((current (routeRecord context (nativeGet record "id"))))
              (when (and current
                         (= (nativeGet current "generation") (nativeGet record "generation"))
                         (not (= (nativeGet current "state") "disabled")))
                (put current :attempts (1+ (nativeGet current "attempts" 0)))
                (put current :state
                  (if (js-call (js-array "forbidden" "target_unbound" "unsupported" "invalid_argument") :includes code)
                    "blocked"
                    "retrying"))
                (put current :last_error code)
                (put current :next_attempt_at (addSeconds (utcNow context) (routeRetrySeconds (nativeGet current "attempts"))))
                (saveRoute context current)))
            (success nil)))))))
  (defasync processFixedRoutes (context)
    (let ((rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
            "SELECT payload FROM fixed_routes WHERE state<>'disabled' AND next_attempt_at<=? ORDER BY next_attempt_at,id LIMIT 2")
            :all (utcNow context)))
          (index 0)
          (result (success nil)))
      (while (and (nativeGet result "ok")
                  (< index (js-length rows))
                  (= (nativeGet (nativeGet context "runtime") "state") "ready"))
        (let* ((record (JSON/parse (nativeGet (aref rows index) "payload")))
               (route (js-call (nativeGet (nativeGet context "config") "fixed_routes" (js-array)) :find
                 (lambda (item) (= (nativeGet item "id") (nativeGet record "id"))))))
          (when route (setq result (await (reconcileRoute context record route)))))
        (setq index (1+ index)))
      result))
  (defun projectFixedRoutes (context)
    (let* ((principal (nativeGet context "principal"))
           (pid (nativeGet principal "principal_id"))
           (operator (= (nativeGet principal "kind") "operator"))
           (rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query "SELECT payload FROM fixed_routes ORDER BY id") :all))
           (items (js-array)))
      (js-call rows :forEach (lambda (row)
        (let ((record (JSON/parse (nativeGet row "payload"))))
          (when (or operator (= pid (nativeGet record "recipient_principal_id")))
            (js-call items :push
              (safeFields record
                (js-array "id" "state" "target" "target_key" "owner_principal_id" "recipient_principal_id" "agent_id" "last_error" "attempts" "next_attempt_at")))))))
      items))
  (export seedFixedRoutes processFixedRoutes projectFixedRoutes routeDesiredHash routeRetrySeconds))
