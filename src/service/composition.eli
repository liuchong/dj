(module dj.service.composition
  (import "../../packages/rack/src/index.eli" createContext)
  (import "../core/native.eli" nativeGet)
  (defun createComposition ()
    (let ((rack (createContext)))
      (put rack :portCache (new globalThis.WeakMap)) rack))
  (defun managePort (port)
    (let ((closed false) (inflight nil))
      (new globalThis.Proxy port
        (js-object :get (lambda (target key receiver)
          (if (not (= key "close")) (Reflect/get target key receiver)
            (async ()
              (if closed (js-object :state "stopped")
                (progn
                  (unless inflight
                    (setq inflight (funcall (async ()
                      (let ((answer (if (nativeGet port "close")
                        (await (js-call port :close)) (js-object :state "stopped"))))
                        (unless (= (nativeGet answer "state") "draining") (setq closed t))
                        answer)))))
                  (try (await inflight) (finally (setq inflight nil))))))))))))
  (defun mountPort (rack name target key factory)
    (js-call rack :plugin
      (js-object :name name :inject (js-array "application")
        :apply (lambda (context config)
          (let* ((original (funcall factory)) (cache (nativeGet rack "portCache"))
            (lease (or (js-call cache :get original)
              (js-object :port (managePort original) :references 0)))
            (port (nativeGet lease "port")))
            (js-call cache :set original lease)
            ;; Register resource ownership before installing names or touching maps.
            (js-call context :effect (lambda ()
              (put lease :references (1+ (nativeGet lease "references")))
              (async ()
                (put lease :references (- (nativeGet lease "references") 1))
                (when (= (nativeGet lease "references") 0)
                  (let ((answer (await (js-call port :close))))
                    (when (= (nativeGet answer "state") "draining")
                      (throw (new globalThis.Error "Port must drain before composition disposal")))))
                (when (eq (js-call target :get key) port) (js-call target :delete key)))))
            (js-call target :set key port)
            (js-call context :provide (str "port:" name) port))))))
  (export createComposition managePort mountPort))
