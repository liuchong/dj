(module dj.lifecycle.restart
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" nextRevision)
  (import "../application/context.eli" currentPrincipal nextId utcNow requirePermission can must inTransaction typedRef agentPort nativeCallContext)
  (import "./gates.eli" assertGate)
  ;; Explicit application control. No task inference or automatic message replay.
  (defun acceptRestart (context args project)
    (let* ((repository (nativeGet context "repository"))
           (instance (js-call repository :get "instances" (nativeGet args "instance_id")))
           (permission (requirePermission context "instance.restart" instance))
           (port (and instance (agentPort context instance))))
      (cond
        ((not (nativeGet permission "ok")) permission)
        ((not instance) (failure "not_found"))
        ((not (= (nativeGet args "allow_interrupt") t)) (failure "invalid_argument"))
        ((not (and (nativeGet port "restart") (nativeGet port "snapshotRestart")
                   (= (nativeGet (nativeGet port "capabilities") "instance_restart") "supported"))) (failure "unsupported"))
        (t (js-call context :accept (lambda (tx operation-id)
          (let* ((gate (must (assertGate tx (nativeGet instance "instance_id") (nativeGet args "expected_instance_epoch") "open")))
                 (action (js-object :lifecycle_id (nextId context "lifecycle") :operation_id operation-id
                   :principal_id (nativeGet (currentPrincipal context) "principal_id") :action "restart"
                   :instance_id (nativeGet instance "instance_id") :instance_epoch (nativeGet instance "instance_epoch")
                   :launch_token nil :profile_id nil :state "recorded" :revision 1 :created_at (utcNow context))))
            (put gate :state "closed") (put gate :reason "instance_restart")
            (put gate :revision (nextRevision (nativeGet gate "revision")))
            (must (js-call repository :replace "instance_gates" gate))
            (js-call repository :insert "lifecycle_actions" action)
            (success (funcall project context action))))
          (lambda (data) (js-array (typedRef "lifecycle" (nativeGet data "lifecycle_id")))))))))
  (defun finishRestart (context action report project write-action)
    (inTransaction context (lambda (tx)
      (let* ((repository (nativeGet context "repository"))
             (current (js-call repository :get "lifecycle_actions" (nativeGet action "lifecycle_id")))
             (instance (js-call repository :get "instances" (nativeGet action "instance_id")))
             (gate (js-call repository :get "instance_gates" (nativeGet action "instance_id")))
             (epoch (nativeGet report "instance_epoch")))
        (if (and (= (nativeGet report "state") "ready") (= (nativeGet report "evidence_level") "native_protocol")
                 (= (nativeGet report "native_namespace") (nativeGet instance "native_namespace"))
                 (= (nativeGet gate "reason") "instance_restart")
                 (or (= (nativeGet instance "instance_epoch") (nativeGet action "instance_epoch"))
                     (= (nativeGet instance "instance_epoch") epoch))
                 epoch (not (= epoch (nativeGet action "instance_epoch"))))
          (progn
            (put instance :instance_epoch epoch) (put instance :state "ready")
            (put instance :revision (nextRevision (nativeGet instance "revision")))
            (must (js-call repository :replace "instances" instance))
            (put gate :instance_epoch epoch) (put gate :state "open") (put gate :reason "ready")
            (put gate :revision (nextRevision (nativeGet gate "revision")))
            (must (js-call repository :replace "instance_gates" gate))
            (put current :state "ready") (put current :result_instance_epoch epoch)
            (put current :evidence_level "native_protocol"))
          (put current :state "unknown"))
        (when (nativeGet current "attempt_id")
          (let ((attempt (js-call repository :get "attempts" (nativeGet current "attempt_id"))))
            (put attempt :state (if (= (nativeGet current "state") "ready") "accepted" "unknown"))
            (must (js-call repository :replace "attempts" attempt))))
        (funcall write-action context current) (success (funcall project context current))))))
  (defasync runRestart (context action project write-action &optional reconcile)
    (let* ((repository (nativeGet context "repository"))
           (instance (js-call repository :get "instances" (nativeGet action "instance_id")))
           (port (agentPort context instance))
           (permission (requirePermission context (if reconcile "lifecycle.reconcile" "instance.restart") (if reconcile action instance)))
           (call-context (nativeCallContext context (js-object :deadline
             (+ (js-call (nativeGet (nativeGet context "ports") "clock") :monoNow) 45000)))))
      (if (not (nativeGet permission "ok")) permission
        (if reconcile
          ;; Read-only reconciliation never issues a second restart.
          (if (and (nativeGet port "inspectRestart") (= (nativeGet action "state") "unknown"))
            (try (finishRestart context action (await (js-call port :inspectRestart instance call-context)) project write-action)
              (catch unavailable (success (funcall project context action))))
            (success (funcall project context action)))
          (if (or (nativeGet action "attempt_id") (not (= (nativeGet action "state") "recorded")))
            (success (funcall project context action))
            (try
              (let ((snapshot (await (js-call port :snapshotRestart instance call-context))))
                (setq action (must (inTransaction context (lambda (tx)
                  (let ((current (js-call repository :get "lifecycle_actions" (nativeGet action "lifecycle_id"))))
                    (unless (= (nativeGet current "state") "recorded") (throw (new globalThis.Error "restart already submitted")))
                    (put current :resume_sessions (nativeGet snapshot "items" (js-array)))
                    (put current :resume_coverage (nativeGet snapshot "coverage" "partial"))
                    (put current :restart_scope "application")
                    (let ((attempt (js-object :attempt_id (nextId context "attempt") :lifecycle_id (nativeGet current "lifecycle_id")
                      :delivery_id nil :outbound_id nil :dispatch_key (nativeGet current "lifecycle_id")
                      :state "submitting" :definite_not_sent false :created_at (utcNow context))))
                      (js-call repository :insert "attempts" attempt) (put current :attempt_id (nativeGet attempt "attempt_id")))
                    (put current :state "submitting") (funcall write-action context current) (success current))))))
                (finishRestart context action (await (js-call port :restart instance call-context)) project write-action))
              (catch unavailable
                (if (nativeGet action "attempt_id")
                  (finishRestart context action (js-object :state "unknown") project write-action)
                  (inTransaction context (lambda (tx)
                    ;; Snapshot failed before any native effect: release our gate.
                    (let ((gate (js-call repository :get "instance_gates" (nativeGet instance "instance_id"))))
                      (when (and (= (nativeGet gate "reason") "instance_restart")
                                 (= (nativeGet gate "instance_epoch") (nativeGet action "instance_epoch")))
                        (put gate :state "open") (put gate :reason "ready")
                        (put gate :revision (nextRevision (nativeGet gate "revision")))
                        (must (js-call repository :replace "instance_gates" gate))))
                    (put action :state "blocked") (funcall write-action context action)
                    (success (funcall project context action))))))))))))
  (export acceptRestart runRestart))
