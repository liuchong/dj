(module dj.lifecycle.initial-input
  (import "../core/native.eli" nativeGet)
  (import "../application/context.eli" inTransaction must)
  (import "../core/types.eli" nextRevision)
  (import "../core/errors.eli" success)
  ;; Creation and input are separate durable effects. A stable operation key
  ;; joins them after a crash without repeating either the creation or the input.
  (defasync processInitialInputs (context)
    (when (nativeGet context "sendCreatedSession")
      (let* ((repository (nativeGet context "repository"))
             (rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
               "SELECT payload FROM lifecycle_actions WHERE action='create' AND state='ready' AND json_extract(payload,'$.initial_input_state')='pending' ORDER BY lifecycle_id LIMIT 8") :all)))
        (let ((index 0))
          (while (< index (js-length rows))
            (let* ((record (JSON/parse (nativeGet (aref rows index) "payload")))
                   (result (await (js-call context :sendCreatedSession record))))
              (when (or (nativeGet result "ok")
                        (js-call (js-array "unauthenticated" "idempotency_conflict" "forbidden" "stale_reference" "not_found" "unsupported" "limit_exceeded")
                          :includes (nativeGet (nativeGet result "error") "code")))
                (inTransaction context (lambda (tx)
                  (let ((current (js-call repository :get "lifecycle_actions" (nativeGet record "lifecycle_id"))))
                    (when (= (nativeGet current "initial_input_state") "pending")
                      (put current :initial_input_state (if (nativeGet result "ok") "queued" "blocked"))
                      (if (nativeGet result "ok")
                        (put current :initial_delivery_id (nativeGet (nativeGet result "data") "delivery_id"))
                        (put current :initial_input_error (nativeGet (nativeGet result "error") "code")))
                      (put current :revision (nextRevision (nativeGet current "revision")))
                      (must (js-call repository :replace "lifecycle_actions" current)))
                    (success nil))))))
            (setq index (1+ index)))))))
  (export processInitialInputs))
