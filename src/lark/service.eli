(module dj.lark.service
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" must requirePermission can nativeCallContext typedRef utcNow)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../connections/manager.eli" imPort dispatchIm)
  (import "../service/ownership.eli" ownerGuard)
  (import "../../packages/lark/src/index.eli" apiUrl)
  (defun connectionFor (context id revision)
    (let ((connection (js-call (nativeGet context "repository") :get "connections" id)))
      (unless (and connection (not (nativeGet connection "disabled"))
        (= revision (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
        (must (failure "stale_reference")))
      (unless (= (nativeGet connection "platform") "lark") (must (failure "unsupported")))
      (unless (can context "connection.inspect" connection) (must (failure "forbidden"))) connection))
  (defun projectApi (context record)
    (try
      (unless (and record (= (nativeGet record "operation") "lark.api.call") (can context "operation.inspect" record))
        (must (failure "forbidden")))
      (let ((data (nativeGet (nativeGet record "safe_result") "data")))
        (connectionFor context (nativeGet data "connection_id") (nativeGet data "identity_revision")) (success data))
      (catch error (or (nativeGet error "domain_result") (failure "forbidden")))))
  (defun requestSpec (connection args reading)
    (let* ((path (nativeGet args "path"))
      (url (new globalThis.URL (apiUrl (nativeGet connection "brand" "lark") path (nativeGet args "query"))))
      (decoded (js-call (nativeGet url "pathname") :toLowerCase))
      (spec (js-object :path path :method (if reading "GET" (nativeGet args "method"))
        :response_mode (nativeGet args "response_mode" "json") :max_response_bytes 524288)))
      ;; OAuth and application credentials are managed by the connection, never
      ;; returned to AI callers or accepted from request bodies/headers.
      (when (or (js-call (new globalThis.RegExp "^/open-apis/[^/]*%" "i") :test decoded)
        (js-call (new globalThis.RegExp "^/open-apis/(?:auth|authen|oauth)(?:/|$)") :test decoded))
        (must (failure "invalid_argument")))
      (when (and (object-has? args "body") (object-has? args "form")) (must (failure "invalid_argument")))
      (js-call (js-array "query" "headers" "body") :forEach (lambda (key)
        (when (object-has? args key) (put spec key (nativeGet args key)))))
      (when (nativeGet args "form")
        (let ((form (js-object)))
          (js-call (Object/entries (nativeGet args "form")) :forEach (lambda (entry)
            (let ((value (aref entry 1)))
              (if (and value (= (nativeTypeOf value) "object"))
                (let* ((text (nativeGet value "base64")) (bytes (Buffer/from text "base64")))
                  (unless (= (js-call bytes :toString "base64") text) (must (failure "invalid_argument")))
                  (put form (aref entry 0) (new globalThis.File (js-array bytes)
                    (nativeGet value "filename") (js-object :type (nativeGet value "content_type" "application/octet-stream")))))
                (put form (aref entry 0) value)))))
          (put spec :form form)))
      spec))
  (defasync invoke (context connection spec)
    (await (dispatchIm context (nativeGet connection "connection_id") "apiCall"
      (js-array (js-object :connection_id (nativeGet connection "connection_id")
        :identity_revision (nativeGet connection "identity_revision" (nativeGet connection "revision")) :request spec)
        (nativeCallContext context)))))
  (defun responseData (connection args response)
    (let* ((wire (nativeGet response "wire")) (mode (nativeGet args "response_mode" "json"))
      (status (nativeGet response "status"))
      (native-ok (and (>= status 200) (< status 300)
        (or (not (= mode "json")) (= (nativeGet wire "code" 0) 0)))))
      (js-object :connection_id (nativeGet connection "connection_id")
        :identity_revision (nativeGet connection "identity_revision" (nativeGet connection "revision"))
        :identity (nativeGet connection "identity") :state (if native-ok "accepted" (if (< status 500) "rejected" "unknown"))
        :response_mode mode :http_status status :native_ok native-ok
        :headers (nativeGet response "headers" (js-object)) :retry_after_seconds (nativeGet response "retry_after" 0)
        :response (if (= mode "bytes") (js-call wire :toString "base64") wire))))
  (defasync handleOperation (context operation args)
    (try
      (if (= operation "lark.api.get")
        (let ((record (js-call (nativeGet context "repository") :get "operations" (nativeGet args "action_id"))))
          (must (requirePermission context "operation.inspect" record)) (projectApi context record))
        (let* ((connection (connectionFor context (nativeGet args "connection_id") (nativeGet args "identity_revision")))
          (revision (nativeGet connection "identity_revision" (nativeGet connection "revision")))
          (reading (= operation "lark.api.read")) (spec (requestSpec connection args reading)))
          (unless (nativeGet (imPort context (nativeGet args "connection_id")) "apiCall") (must (failure "unsupported")))
          (must (requirePermission context (if reading "message.read" "message.send") connection))
          (must (ownerGuard context))
          (if reading
            (let ((response (await (invoke context connection spec))))
              (connectionFor context (nativeGet args "connection_id") revision)
              (success (responseData connection args response)))
            (let* ((created false)
              (accepted (js-call context :accept (lambda (tx id)
                (must (ownerGuard context)) (connectionFor context (nativeGet args "connection_id") revision)
                (setq created t)
                (success (js-object :action_id id :connection_id (nativeGet args "connection_id")
                  :identity_revision revision :identity (nativeGet connection "identity") :state "unknown"
                  :method (nativeGet spec "method") :path (nativeGet (new globalThis.URL
                    (apiUrl (nativeGet connection "brand" "lark") (nativeGet spec "path"))) "pathname")
                  :updated_at (utcNow context))))
                (lambda (data) (js-array (typedRef "lark_api" (nativeGet data "action_id")))))))
              (if (or (not (nativeGet accepted "ok")) (not created)) accepted
                (let ((data (Object/assign (js-object) (nativeGet accepted "data"))))
                  (try
                    (must (ownerGuard context)) (connectionFor context (nativeGet args "connection_id") revision)
                    (Object/assign data (responseData connection args (await (invoke context connection spec))))
                    (catch uncertain (put data :error_code "unavailable")))
                  (put data :updated_at (utcNow context))
                  (await (enqueueWrite context (lambda ()
                    (must (ownerGuard context)) (connectionFor context (nativeGet args "connection_id") revision)
                    (unless (can context "message.send" connection) (must (failure "forbidden")))
                    (let* ((repository (nativeGet context "repository"))
                      (record (js-call repository :get "operations" (nativeGet data "action_id"))))
                      (put record :safe_result (success data (js-object :operation_id (nativeGet data "action_id") :effect_state "recorded")))
                      (must (js-call repository :replace "operations" record))
                      (success data (js-object :operation_id (nativeGet data "action_id") :effect_state "recorded"))))))))))))
      (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))
  (export handleOperation projectApi requestSpec responseData))
