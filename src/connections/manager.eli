(module dj.connections.manager
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "../adapters/im/lark.eli" createLarkPort)
  (import "../adapters/im/lark-events.eli" createLarkEventPort)
  (import "../adapters/im/slack.eli" createSlackPort)
  (import "../adapters/im/telegram.eli" createTelegramPort)
  (import "../people/registry.eli" personIdentitiesForConnection)
  (import "../service/composition.eli" createComposition mountPort)
  (defun createConnectionManager (connections host injected &optional composition)
    ;; One flat registry. Identity, account and native addresses are data, never
    ;; separate user/bot routing trees or connection-name branches.
    (let ((rack (or composition (createComposition)))
      (records (new globalThis.Map)) (ports (new globalThis.Map))
      (initialized (new globalThis.Set)) (closed (new globalThis.Set))
      (factories (new globalThis.Map (js-array
        (js-array "lark" (lambda (config)
          (if (= (nativeGet config "source_delivery") "events")
            (createLarkEventPort config host) (createLarkPort config host))))
        (js-array "slack" (lambda (config) (createSlackPort config host)))
        (js-array "telegram" (lambda (config) (createTelegramPort config host))))))
      (assemble nil) (get nil) (route nil) (dispatch nil))
      (js-call connections :forEach (lambda (connection)
        (let ((id (nativeGet connection "connection_id")))
          (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0) (not (js-call records :has id)))
            (throw (new globalThis.TypeError "duplicate or missing connection identity")))
          (js-call records :set id (Object/freeze (JSON/parse (JSON/stringify connection)))))))
      (setq assemble (async ()
        (when (and (not composition) (not (js-call rack :get "application")))
          (js-call rack :provide "application" (js-object :ports host)))
        (let ((loaded (js-array)))
        (js-call records :forEach (lambda (connection id)
          (unless (js-call ports :has id)
            (let ((factory (js-call factories :get (nativeGet connection "platform"))))
              (unless factory (throw (new globalThis.TypeError "unsupported IM platform")))
              (js-call loaded :push (mountPort rack (str "connection:" id) ports id
                (lambda () (or (and injected (js-call injected :get id)) (funcall factory connection)))))))))
        (await (Promise/all loaded)))))
      (setq get (lambda (id)
        (let ((connection (js-call records :get id)) (port (js-call ports :get id)))
          (and connection (not (nativeGet connection "disabled")) (not (js-call closed :has port)) port))))
      (setq route (lambda (address &optional people)
        (let ((matches (js-array))
          (keys (js-array "connection_id" "platform" "brand" "tenant_ref" "account_ref" "identity" "identity_revision")))
          (js-call records :forEach (lambda (connection id)
            (when (and (funcall get id)
              (or (not (nativeGet address "person_id"))
                (> (js-length (personIdentitiesForConnection (or people (js-array)) (nativeGet address "person_id") connection)) 0))
              (js-call keys :every (lambda (key)
                (or (not (object-has? address key)) (= (nativeGet address key) (nativeGet connection key))))))
              (let ((selected (js-object)))
                (js-call keys :forEach (lambda (key)
                  (when (object-has? connection key) (put selected key (nativeGet connection key)))))
                (when (nativeGet address "person_id")
                  (put selected :person_id (nativeGet address "person_id"))
                  (put selected :person_identities (personIdentitiesForConnection people (nativeGet address "person_id") connection)))
                (js-call matches :push selected)))))
          (cond ((= (js-length matches) 0) (failure "not_found"))
            ((> (js-length matches) 1) (failure "ambiguous_target"))
            (t (success (aref matches 0)))))))
      (setq dispatch (async (id method args)
        (let* ((record (aref args 0)) (selector (js-object :connection_id id))
          (version (nativeGet record "identity_revision")))
          (when version (put selector :identity_revision version))
          (let* ((target (funcall route selector)) (port (and (nativeGet target "ok") (funcall get id)))
            (work (nativeGet port method)))
          (unless (and port (= (nativeTypeOf work) "function"))
            (throw (new globalThis.TypeError "IM connection operation unavailable")))
          (when (js-call (js-array "send" "receive" "lookup") :includes method)
            (unless (= (nativeGet record "connection_id") id)
              (throw (new globalThis.TypeError "IM route does not match the record origin or destination"))))
          (let ((value (await (Reflect/apply work port args))))
            (when (= method "receive")
              (unless (and (Array/isArray (nativeGet value "items"))
                (js-call (nativeGet value "items") :every (lambda (event)
                  (= (nativeGet event "connection_id") id))))
                (throw (new globalThis.TypeError "IM receive returned a different connection"))))
            value)))))
      (Object/freeze (js-object :assemble assemble :get get :route route :dispatch dispatch
        :initialize (lambda (context)
          (js-call records :forEach (lambda (connection id)
            (let ((port (funcall get id)))
              (when (and port (not (js-call initialized :has port)))
                (when (nativeGet port "initialize") (js-call port :initialize context))
                (js-call initialized :add port))))))
        :close (async ()
          (let ((iterator (js-call ports :values)) (done false) (draining false))
            (while (and (not done) (not draining))
              (let ((next (js-call iterator :next)))
                (setq done (nativeGet next "done"))
                (unless done
                  (let ((port (nativeGet next "value")))
                    (unless (js-call closed :has port)
                      (let ((result (when (nativeGet port "close") (await (js-call port :close)))))
                        (if (= (nativeGet result "state") "draining") (setq draining t)
                          (js-call closed :add port))))))))
            (when (and (not draining) (not composition)) (await (js-call rack :dispose)))
            (js-object :state (if draining "draining" "stopped"))))))))
  (defun imPort (context connection-id)
    (let* ((ports (nativeGet context "ports")) (manager (nativeGet ports "connections")))
      (if manager (js-call manager :get connection-id)
        ;; Isolated callers may supply native ports without constructing a Core.
        (js-call (nativeGet ports "im_ports") :get connection-id))))
  (defasync dispatchIm (context connection-id method args)
    (let ((manager (nativeGet (nativeGet context "ports") "connections")))
      (if manager (await (js-call manager :dispatch connection-id method args))
        (let ((port (imPort context connection-id)))
          (await (Reflect/apply (nativeGet port method) port args))))))
  (export createConnectionManager imPort dispatchIm))
