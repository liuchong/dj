(module dj.connections.network
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (defun sameReplyNetwork (source destination)
    (and source destination (not (nativeGet source "disabled")) (not (nativeGet destination "disabled"))
      (= (nativeGet source "platform") (nativeGet destination "platform"))
      (= (nativeGet source "brand") (nativeGet destination "brand"))
      (or (not (nativeGet source "tenant_ref")) (not (nativeGet destination "tenant_ref"))
        (= (nativeGet source "tenant_ref") (nativeGet destination "tenant_ref")))
      (or (= (nativeGet source "connection_id") (nativeGet destination "connection_id"))
        (= (nativeGet source "platform") "lark")
        (and (= (nativeGet source "platform") "slack") (nativeGet source "tenant_ref")
          (= (nativeGet source "tenant_ref") (nativeGet destination "tenant_ref"))))))
  (defun replyNetworkKey (context source address)
    (let* ((platform (nativeGet address "platform" (nativeGet source "platform")))
      (brand (nativeGet source "brand" nil))
      (tenant (nativeGet address "tenant_ref" (nativeGet source "tenant_ref" nil))))
      (when (and (not tenant) (= platform "lark"))
        (let ((configured (nativeGet (nativeGet context "config") "connections"))
          (found nil) (ambiguous false))
          (when (Array/isArray configured)
            (js-call configured :forEach (lambda (item)
              (when (and (not (nativeGet item "disabled"))
                (= (nativeGet item "platform") platform)
                (= (nativeGet item "brand" nil) brand)
                (nativeGet item "tenant_ref"))
                (if (and found (not (= found (nativeGet item "tenant_ref"))))
                  (setq ambiguous t)
                  (setq found (nativeGet item "tenant_ref")))))))
          (when (and found (not ambiguous)) (setq tenant found))))
      (js-array platform brand tenant
        (if (or (= platform "lark") (and (= platform "slack") (nativeGet source "tenant_ref")))
          nil (nativeGet source "connection_id")))))
  (defun actorMatchesConnection (context source actor connection)
    (and (sameReplyNetwork source connection) actor connection
      (let* ((bot (= (nativeGet connection "identity") "bot"))
        (actor-id (nativeGet actor "id"))
        (platform (nativeGet connection "platform")))
        (and (= (nativeGet actor "kind") (if bot "bot" "human"))
          (= (nativeTypeOf actor-id) "string") (> (js-length actor-id) 0)
          (cond
            ((= platform "slack") (= actor-id (nativeGet connection "event_subject_id")))
            (bot (or (= actor-id (nativeGet connection "event_app_id"))
              (= actor-id (nativeGet connection "event_subject_id"))))
            (t
              (let* ((user-id (nativeGet connection "user_identity"))
                (conn-app (nativeGet connection "event_app_id" (nativeGet user-id "app_id")))
                (open-id (nativeGet user-id "open_id"))
                (tenant-uid (nativeGet user-id "user_id"))
                (union-id (nativeGet user-id "union_id"))
                (identities (nativeGet actor "identities" (js-array)))
                (db (nativeGet (nativeGet context "store") "db"))
                (source-rev (nativeGet source "identity_revision" (nativeGet source "revision")))
                (conn-rev (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
                (or
                  (and (= (nativeGet source "event_app_id") conn-app) (= actor-id open-id))
                  (and (Array/isArray identities) (js-call identities :some (lambda (entry)
                    (let ((scope (str (nativeGet entry "scope" ""))) (eid (nativeGet entry "id")))
                      (or (and tenant-uid (js-call scope :endsWith ":user_id") (= eid tenant-uid))
                        (and union-id (js-call scope :endsWith ":union_id") (= eid union-id)))))))
                  (and db (not (= (nativeGet source "connection_id") (nativeGet connection "connection_id")))
                    (js-call (js-call (js-call db :query "SELECT payload FROM session_rules LIMIT 64") :all) :some
                      (lambda (row)
                        (let ((rules (nativeGet (JSON/parse (nativeGet row "payload")) "reply_routes" (js-array))))
                          (and (Array/isArray rules) (js-call rules :some (lambda (route)
                            (and (= (nativeGet route "source_connection_id") (nativeGet source "connection_id"))
                              (= (nativeGet route "mention_id") actor-id)
                              (= (nativeGet route "reply_connection_id") (nativeGet connection "connection_id"))
                              (= (nativeGet route "source_identity_revision") source-rev)
                              (= (nativeGet route "reply_identity_revision") conn-rev)))))))))))))))))
  (defun canonicalReactionActor (context source actor)
    (let* ((configured (nativeGet (nativeGet context "config") "connections"))
      (repository (nativeGet context "repository"))
      (matched nil))
      (when (and actor (Array/isArray configured))
        (js-call configured :forEach (lambda (item)
          (let ((live (or (and repository (js-call repository :get "connections" (nativeGet item "connection_id"))) item)))
            (when (actorMatchesConnection context source actor live)
              (when (or (not matched) (< (js-call (nativeGet live "connection_id") :localeCompare (nativeGet matched "connection_id")) 0))
                (setq matched live)))))))
      (if matched
        (js-array "connection" (nativeGet matched "connection_id"))
        (let* ((identities (and actor (nativeGet actor "identities")))
          (tenant-user (and (Array/isArray identities) (js-call identities :find (lambda (entry)
            (js-call (str (nativeGet entry "scope" "")) :endsWith ":user_id"))))))
          (if tenant-user
            (js-array "tenant_user" (nativeGet tenant-user "scope") (nativeGet tenant-user "id"))
            (js-array "native" (nativeGet source "event_app_id" (nativeGet source "connection_id"))
              (nativeGet actor "kind" "") (nativeGet actor "id" "")))))))
  (export sameReplyNetwork replyNetworkKey actorMatchesConnection canonicalReactionActor))
