(module dj.connections.echo
  (import "../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "./network.eli" sameReplyNetwork actorMatchesConnection)
  (import "../messaging/echo.eli" outboundEchoState)
  (defun reactionEchoState (context event)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (reaction (nativeGet event "reaction")) (actor (nativeGet reaction "operator"))
      (emoji (nativeGet reaction "emoji_type")) (stamp (NativeNumber (nativeGet reaction "action_time")))
      (native-rid (nativeGet reaction "native_reaction_id"))
      (state "clear"))
      (when (js-call (js-array "Typing" "Get" "keyboard" "eyes") :includes emoji)
        (js-call (js-call (js-call db :query
          "SELECT payload FROM work_marks WHERE json_extract(payload,'$.native_message_id')=? AND json_extract(payload,'$.attempted_create')=1 LIMIT 64")
          :all (nativeGet event "native_message_id")) :forEach (lambda (row)
          (let* ((mark (JSON/parse (nativeGet row "payload")))
            (connection (js-call repository :get "connections" (nativeGet mark "connection_id")))
            (expected-emoji (if (= (nativeGet connection "platform") "slack")
              (if (nativeGet mark "acknowledgement") "eyes" "keyboard")
              (if (nativeGet mark "acknowledgement") "Get" "Typing")))
            (same-network (and (sameReplyNetwork source connection)
              (= (nativeGet mark "identity_revision") (nativeGet connection "identity_revision"))
              (= emoji expected-emoji)
              (not (nativeGet mark "preexisting"))))
            (exact-rid (and same-network (= (nativeTypeOf native-rid) "string") (> (js-length native-rid) 0)
              (= native-rid (nativeGet mark "reaction_id"))))
            (owned (and same-network (actorMatchesConnection context source actor connection)))
            (native (NativeNumber (nativeGet mark "native_action_time")))
            (native-ms (if (and (> native 0) (< native 100000000000)) (* native 1000) native))
            (requested (Date/parse (nativeGet mark "create_requested_at"))))
            (cond
              (exact-rid (setq state "echo"))
              (owned
                (cond
                  ((and (> native 0) (<= (Math/abs (- stamp native-ms)) 2000)) (setq state "echo"))
                  ((and (not (= state "echo")) (not (> native 0)) (Number/isFinite requested)
                    (>= stamp (- requested 1000)) (<= stamp (+ requested 15000))) (setq state "held")))))))))
      state))
  (defun echoState (context event)
    (cond ((= (nativeGet event "event_kind") "message.pinned") "clear")
      ((= (nativeGet event "event_kind") "message.reaction.added") (reactionEchoState context event))
      ((= (nativeGet (nativeGet event "conversation") "kind") "resource") "clear")
      (t (outboundEchoState context event))))
  (export echoState reactionEchoState))
