(module dj.connections.echo
  (import "../core/native.eli" nativeGet NativeNumber)
  (import "./replies.eli" sameReplyNetwork)
  (defun reactionEchoState (context event)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (reaction (nativeGet event "reaction")) (actor (nativeGet reaction "operator"))
      (emoji (nativeGet reaction "emoji_type")) (stamp (NativeNumber (nativeGet reaction "action_time")))
      (state "clear"))
      (when (js-call (js-array "Typing" "Get") :includes emoji)
        (js-call (js-call (js-call db :query
          "SELECT payload FROM work_marks WHERE json_extract(payload,'$.native_message_id')=? AND json_extract(payload,'$.attempted_create')=1 LIMIT 64")
          :all (nativeGet event "native_message_id")) :forEach (lambda (row)
          (let* ((mark (JSON/parse (nativeGet row "payload")))
            (connection (js-call repository :get "connections" (nativeGet mark "connection_id")))
            (bot (= (nativeGet connection "identity") "bot"))
            (owned (and (sameReplyNetwork source connection)
              (= (nativeGet mark "identity_revision") (nativeGet connection "identity_revision"))
              (= emoji (if (nativeGet mark "acknowledgement") "Get" "Typing"))
              (not (nativeGet mark "preexisting"))
              (= (nativeGet actor "kind") (if bot "bot" "human"))
              (= (nativeGet actor "id") (if bot (nativeGet connection "event_app_id")
                (nativeGet (nativeGet connection "user_identity") "open_id")))
              (or bot (= (nativeGet source "event_app_id") (nativeGet connection "event_app_id")))))
            (native (NativeNumber (nativeGet mark "native_action_time")))
            (requested (Date/parse (nativeGet mark "create_requested_at"))))
            (when owned
              (cond ((and (> native 0) (= (Math/floor (/ stamp 1000))
                (if (< native 100000000000) native (Math/floor (/ native 1000))))) (setq state "echo"))
                ((and (not (= state "echo")) (not (> native 0)) (Number/isFinite requested)
                  (>= stamp (- requested 1000)) (<= stamp (+ requested 15000))) (setq state "held"))))))))
      state))
  (defun sameNativeConversation (context outgoing event &optional same-thread)
    (let* ((repository (nativeGet context "repository"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (sent (js-call repository :get "connections" (nativeGet outgoing "connection_id")))
      (address (nativeGet outgoing "destination")) (incoming (nativeGet event "conversation"))
      (same-connection (= (nativeGet source "connection_id") (nativeGet sent "connection_id"))))
      (and source sent address incoming
        (= (nativeGet address "native_chat_id") (nativeGet incoming "native_chat_id"))
        (or (not same-thread) (= (nativeGet address "native_thread_id" nil) (nativeGet incoming "native_thread_id" nil)))
        (= (nativeGet event "identity_revision") (nativeGet source "identity_revision"))
        (= (nativeGet outgoing "identity_revision") (nativeGet sent "identity_revision"))
        (or same-connection
          (and (= (nativeGet source "platform") "lark") (= (nativeGet sent "platform") "lark")
            (= (nativeGet source "brand" "lark") (nativeGet sent "brand" "lark"))
            (or (not (nativeGet source "tenant_ref")) (not (nativeGet sent "tenant_ref"))
              (= (nativeGet source "tenant_ref") (nativeGet sent "tenant_ref"))))))))
  (defun echoState (context event)
    (if (= (nativeGet event "event_kind") "message.reaction.added") (reactionEchoState context event)
    (if (= (nativeGet (nativeGet event "conversation") "kind") "resource") "clear"
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (chat (nativeGet (nativeGet event "conversation") "native_chat_id"))
      (sent (js-call (js-call db :query "SELECT o.payload FROM echo_index e JOIN outbound o ON o.outbound_id=e.outbound_id WHERE e.native_message_id=? AND json_extract(o.payload,'$.destination.native_chat_id')=?")
        :all (nativeGet event "native_message_id") chat)))
      (if (js-call sent :some (lambda (row) (sameNativeConversation context (JSON/parse (nativeGet row "payload")) event))) "echo"
        (let ((pending (js-call (js-call db :query "SELECT o.payload FROM echo_gates g JOIN outbound o ON o.outbound_id=g.outbound_id WHERE json_extract(o.payload,'$.destination.native_chat_id')=?") :all chat)))
          (if (js-call pending :some (lambda (row) (sameNativeConversation context (JSON/parse (nativeGet row "payload")) event t))) "held" "clear")))))))
  (export echoState reactionEchoState sameNativeConversation))
