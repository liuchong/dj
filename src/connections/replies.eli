(module dj.connections.replies
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure invalidField)
  (defun sameReplyNetwork (source destination)
    (and source destination (not (nativeGet source "disabled")) (not (nativeGet destination "disabled"))
      (= (nativeGet source "platform") (nativeGet destination "platform"))
      (= (nativeGet source "brand") (nativeGet destination "brand"))
      (or (not (nativeGet source "tenant_ref")) (not (nativeGet destination "tenant_ref"))
        (= (nativeGet source "tenant_ref") (nativeGet destination "tenant_ref")))
      (or (= (nativeGet source "connection_id") (nativeGet destination "connection_id"))
        (= (nativeGet source "platform") "lark")
        (and (= (nativeGet source "platform") "slack") (nativeGet source "tenant_ref")
          (= (nativeGet source "tenant_ref") (nativeGet destination "tenant_ref"))))))
  (defun normalizeReplyRoutes (context routes)
    (let ((result (js-array)) (bad false) (seen (new globalThis.Set)) (repository (nativeGet context "repository")))
      (if (not (and (Array/isArray routes) (<= (js-length routes) 32))) (setq bad t)
        (let ((i 0))
          (while (< i (js-length routes))
            (let* ((item (aref routes i)) (keys (js-array "source_connection_id" "mention_id" "reply_connection_id"))
              (valid (and item (= (nativeTypeOf item) "object") (not (Array/isArray item))
                (= (js-length (Object/keys item)) 3)
                (js-call keys :every (lambda (key) (let ((value (nativeGet item key)))
                  (and (= (nativeTypeOf value) "string") (> (js-length value) 0) (<= (js-length value) 1024)))))))
              (source (and valid (js-call repository :get "connections" (nativeGet item "source_connection_id"))))
              (destination (and valid (js-call repository :get "connections" (nativeGet item "reply_connection_id"))))
              (key (JSON/stringify (js-array (nativeGet item "source_connection_id") (nativeGet item "mention_id")))))
              (if (or (not valid) (not (sameReplyNetwork source destination)) (js-call seen :has key)) (setq bad t)
                (progn (js-call seen :add key)
                  (js-call result :push (Object/assign (js-object) item (js-object
                    :source_identity_revision (nativeGet source "identity_revision" (nativeGet source "revision"))
                    :reply_identity_revision (nativeGet destination "identity_revision" (nativeGet destination "revision"))))))))
            (setq i (1+ i)))))
      (if bad (invalidField "/reply_routes" "at most 32 unique native mention routes within one IM network") (success result))))
  ;; Compare native identities only within one exact, retained message. A display
  ;; name is never an alias, and input records remain independent subscriptions.
  (defun replyViews (context event)
    (let* ((views (js-array event)) (db (nativeGet (nativeGet context "store") "db"))
      (repository (nativeGet context "repository"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id"))))
      (when (and db (= (nativeGet source "platform") "lark")
        (= (nativeGet event "event_kind") "message.created") (nativeGet event "native_message_id"))
        (let* ((clock (nativeGet (nativeGet context "ports") "clock"))
          (now (if clock (js-call clock :utcNow) (js-call (new globalThis.Date) :toISOString)))
          (rows (js-call (js-call db :query
            "SELECT payload FROM events WHERE native_message_id=? AND event_kind='message.created' AND connection_id<>? AND tombstone=0 AND body_expires_at>? AND json_extract(payload,'$.conversation.native_chat_id')=? ORDER BY ingress_seq LIMIT 65")
            :all (nativeGet event "native_message_id") (nativeGet event "connection_id") now
            (nativeGet (nativeGet event "conversation") "native_chat_id"))))
          (when (> (js-length rows) 64) (put views :overflow t))
          (js-call rows :forEach (lambda (row)
            (let* ((peer (JSON/parse (nativeGet row "payload")))
              (connection (js-call repository :get "connections" (nativeGet peer "connection_id"))))
              (when (and (sameReplyNetwork source connection)
                (= (nativeGet peer "identity_revision") (nativeGet connection "identity_revision" (nativeGet connection "revision")))
                (= (nativeGet peer "source_time") (nativeGet event "source_time")))
                (js-call views :push peer))))))) views))
  (defun selectReplyRoute (context event session-key)
    (let* ((repository (nativeGet context "repository"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (policy (js-call repository :get "session_rules" session-key)) (views (replyViews context event))
      (slots (new globalThis.Map)) (defaults (new globalThis.Map)) (stale false)
      (explicit (and (not (js-call (js-array "message.reaction.added" "message.pinned") :includes (nativeGet event "event_kind")))
        (js-call views :some (lambda (view) (> (js-length (nativeGet view "mentions" (js-array))) 0)))))
      (matched (js-array)) (add nil) (inspect nil))
      (when (and (nativeGet event "identity_revision")
        (not (= (nativeGet event "identity_revision") (nativeGet source "identity_revision" (nativeGet source "revision")))))
        (setq stale t))
      (setq add (lambda (slot destination)
        (when (sameReplyNetwork source destination)
          (unless (js-call slots :has slot) (js-call slots :set slot (new globalThis.Map)))
          (js-call (js-call slots :get slot) :set (nativeGet destination "connection_id") destination))))
      (setq inspect (lambda (view id slot)
        (let ((connection (js-call repository :get "connections" (nativeGet view "connection_id"))))
          (when (and id (or (= id (nativeGet connection "event_subject_id"))
            (= id (nativeGet (nativeGet connection "user_identity") "open_id"))
            (and (= (nativeGet connection "identity") "bot") (= id (nativeGet connection "event_app_id")))))
            (funcall add slot connection))
          (js-call (nativeGet policy "reply_routes" (js-array)) :forEach (lambda (route)
            (when (and (= (nativeGet route "source_connection_id") (nativeGet view "connection_id"))
              (= id (nativeGet route "mention_id")))
              (let ((destination (js-call repository :get "connections" (nativeGet route "reply_connection_id"))))
                (if (and (sameReplyNetwork connection destination)
                  (= (nativeGet route "source_identity_revision") (nativeGet view "identity_revision"))
                  (= (nativeGet route "source_identity_revision") (nativeGet connection "identity_revision" (nativeGet connection "revision")))
                  (= (nativeGet route "reply_identity_revision") (nativeGet destination "identity_revision" (nativeGet destination "revision"))))
                  (funcall add slot destination) (setq stale t)))))))))
      (js-call views :forEach (lambda (view)
        (let* ((connection (js-call repository :get "connections" (nativeGet view "connection_id")))
          (mentions (nativeGet view "mentions" (js-array))) (interaction (nativeGet view "interaction")))
          (when connection
            (if explicit
              (js-call mentions :forEach (lambda (mention)
                (let* ((id (nativeGet mention "id")) (key (nativeGet mention "key"))
                  (slot (cond ((= (js-length mentions) 1) "mention:single")
                    ((and (= (nativeTypeOf key) "string") (> (js-length key) 0)) (str "mention:" key))
                    (t (str "mention:" (nativeGet view "connection_id") ":" id)))))
                  (unless (js-call slots :has slot) (js-call slots :set slot (new globalThis.Map)))
                  (when (= (nativeGet view "connection_id") (nativeGet event "connection_id")) (js-call matched :push id))
                  (funcall inspect view id slot))))
              (if (= (nativeGet view "chat_type") "p2p")
                (funcall add "private" connection)
                (progn
                  (when (= (nativeGet interaction "state") "resolved")
                    (funcall inspect view (nativeGet interaction "target_id")
                      (str "interaction:" (nativeGet interaction "target_message_id"))))
                  (js-call defaults :set (nativeGet connection "connection_id") connection))))))))
      (when (= (nativeGet slots "size") 0) (js-call slots :set "default" defaults))
      (let ((found (new globalThis.Map)) (unmapped false))
        (js-call slots :forEach (lambda (values)
          (when (= (nativeGet values "size") 0) (setq unmapped t))
          (js-call values :forEach (lambda (value key) (js-call found :set key value)))))
        (let* ((status (cond (stale "stale_reference") ((nativeGet views "overflow") "ambiguous_target")
          ((> (nativeGet found "size") 1) "ambiguous_target") (unmapped "unmapped_target")
          ((not (= (nativeGet found "size") 1)) "unmapped_target") (t "ready")))
          (result (js-object :status status :mention_ids matched :session_key session-key
            :basis (cond (explicit (if (> (js-length views) 1) "shared_native_message" "native_mentions"))
              ((js-call slots :has "private") "private_recipient") ((js-call slots :has "default") "source_default") (t "native_interaction")))))
          (when (= status "ready")
            (let ((destination (nativeGet (js-call (js-call found :values) :next) "value")))
              (Object/assign result (js-object :connection destination :identity (nativeGet destination "identity")
                :connection_id (nativeGet destination "connection_id")
                :destination (Object/assign (js-object) (nativeGet event "conversation")
                  (js-object :connection_id (nativeGet destination "connection_id"))))))) result))))
  ;; A late second view or changed mapping may invalidate a frozen identity,
  ;; never rewrite it. This guard is shared by replies and automatic reactions.
  (defun checkReplyIdentity (context reply)
    (let* ((repository (nativeGet context "repository"))
      (event (js-call repository :get "events" (nativeGet reply "event_id")))
      (delivery (and (nativeGet reply "delivery_id") (js-call repository :get "deliveries" (nativeGet reply "delivery_id"))))
      (route (and delivery (js-call repository :get "routes" (nativeGet delivery "route_id"))))
      (session-key (or (nativeGet reply "session_key") (nativeGet route "session_key")))
      (selected (and event session-key (selectReplyRoute context event session-key))))
      (if (and selected (= (nativeGet selected "status") "ready")
        (= (nativeGet selected "connection_id") (nativeGet (nativeGet reply "destination") "connection_id")))
        (success nil)
        (failure "reply_identity_unresolved" (js-object :details (js-object
          :reason (if (= (nativeGet selected "status") "ready") "frozen_identity_changed"
            (nativeGet selected "status" "unmapped_target"))))))))
  (export normalizeReplyRoutes selectReplyRoute sameReplyNetwork checkReplyIdentity))
