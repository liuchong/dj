(module dj.adapters.im.lark-http
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber nativeEncodeURIComponent nativeSetTimeout nativeClearTimeout)
  (import "../../core/errors.eli" success failure)
  (import "../../core/types.eli" hashValue)
  (import "./telegram.eli" readJson)

  (import "./lark-identities.eli" larkIdentities)
  (defun formatLarkMessage (message thread &optional brand app)
    (let ((text nil))
      (when (= (nativeGet message "msg_type") "text")
        (try
          (setq text (nativeGet (JSON/parse (nativeGet (nativeGet message "body") "content" "{}")) "text"))
          (catch invalid nil)))
      (unless (= (nativeTypeOf text) "string")
        (setq text (str "[" (nativeGet message "msg_type" "unknown") "] " (nativeGet (nativeGet message "body") "content" ""))))
      (Object/assign (js-object) message
        (js-object :sender (Object/assign (js-object) (nativeGet message "sender")
          (js-object :identities (larkIdentities (or brand "lark") app nil
            (js-object :open_id (and (= (nativeGet (nativeGet message "sender") "id_type" "open_id") "open_id")
              (nativeGet (nativeGet message "sender") "id"))))))
          :content text :thread_id
          (or (nativeGet message "thread_id") thread nil)))))

  (defun createLarkHttpTransport (config host)
    (let* ((base (if (= (nativeGet config "brand") "feishu")
                   "https://open.feishu.cn" "https://open.larksuite.com"))
           (active (new globalThis.Set)) (closed false) (token nil) (token-until 0)
           (application-id nil) (request nil) (authorize nil) (acquire nil) (authorizing nil) (perform nil))
      (setq request (async (path method body bearer context)
        (when closed (throw (new globalThis.Error "Lark transport closed")))
        (let* ((controller (new globalThis.AbortController))
               (parent (nativeGet context "abort_signal"))
               (abort (lambda () (js-call controller :abort)))
               (remaining (Math/min 15000 (- (nativeGet context "deadline"
                    (+ (js-call (nativeGet host "clock") :monoNow) 15000))
                    (js-call (nativeGet host "clock") :monoNow))))
               (timer nil))
          (when (or (<= remaining 0) (nativeGet parent "aborted"))
            (throw (new globalThis.Error "Lark request cancelled")))
          (js-call active :add controller)
          (when parent (js-call parent :addEventListener "abort" abort (js-object :once t)))
          (setq timer (nativeSetTimeout abort remaining))
          (try
            (let* ((headers (js-object :content-type "application/json; charset=utf-8"))
                   (options (js-object :method method :headers headers
                              :signal (nativeGet controller "signal") :redirect "error")))
              (when bearer (put headers :authorization (str "Bearer " bearer)))
              (when body (put options :body (JSON/stringify body)))
              (let* ((response (await (js-call (nativeGet host "http") :fetch (str base path) options)))
                     (wire (await (readJson response 1048576))))
                (js-object :status (nativeGet response "status") :wire wire
                  :retry_after (NativeNumber (js-call (nativeGet response "headers") :get "retry-after")))))
            (finally
              (nativeClearTimeout timer)
              (when parent (js-call parent :removeEventListener "abort" abort))
              (js-call active :delete controller))))))
      (setq acquire (async (context)
        (let ((now (js-call (nativeGet host "clock") :monoNow)))
          (if (and token (< now token-until)) token
          (let ((credential (await (js-call (nativeGet host "credentials") :resolve
                                          (nativeGet config "credential_ref")))))
            (when (and (= (nativeGet config "identity") "user")
              (nativeGet credential "expires_at")
              (<= (Date/parse (nativeGet credential "expires_at")) (+ (Date/now) 120000)))
              (unless (and (nativeGet credential "refresh_token") (nativeGet (nativeGet host "credentials") "persist"))
                (throw (new globalThis.Error "Lark user OAuth renewal required")))
              (let* ((reply (await (funcall request "/open-apis/authen/v2/oauth/token" "POST"
                (js-object :grant_type "refresh_token" :client_id (nativeGet credential "app_id")
                  :client_secret (nativeGet credential "app_secret") :refresh_token (nativeGet credential "refresh_token")) nil context)))
                (wire (nativeGet reply "wire")) (fresh (nativeGet wire "data" wire)))
                (unless (and (= (nativeGet reply "status") 200)
                  (= (nativeGet wire "code" 0) 0) (= (nativeTypeOf (nativeGet fresh "access_token")) "string")
                  (Number/isFinite (nativeGet fresh "expires_in")) (> (nativeGet fresh "expires_in") 0))
                  (throw (new globalThis.Error "Lark user OAuth renewal unavailable")))
                (put credential :user_access_token (nativeGet fresh "access_token"))
                (when (nativeGet fresh "refresh_token") (put credential :refresh_token (nativeGet fresh "refresh_token")))
                (put credential :expires_at (js-call (new globalThis.Date (+ (Date/now) (* 1000 (nativeGet fresh "expires_in")))) :toISOString))
                (await (js-call (nativeGet host "credentials") :persist (nativeGet config "credential_ref") credential))))
            (when (= (nativeGet config "identity") "user")
              (unless (and (= (nativeTypeOf (nativeGet credential "user_access_token")) "string")
                (> (js-length (nativeGet credential "user_access_token")) 0)
                (= (nativeGet credential "app_id") (nativeGet (nativeGet config "user_identity") "app_id")))
                (throw (new globalThis.Error "Lark user OAuth credentials missing"))))
            (unless (and (= (nativeTypeOf (nativeGet credential "app_id")) "string")
                         (> (js-length (nativeGet credential "app_id")) 0)
                         (= (nativeTypeOf (nativeGet credential "app_secret")) "string")
                         (> (js-length (nativeGet credential "app_secret")) 0))
              (throw (new globalThis.Error "Lark application credentials missing")))
            (setq application-id (nativeGet credential "app_id"))
            (if (= (nativeGet config "identity") "user")
              (progn
                (let* ((value (nativeGet credential "user_access_token"))
                       (identity (await (funcall request "/open-apis/authen/v1/user_info" "GET" nil value context)))
                       (actual (nativeGet (nativeGet identity "wire") "data")))
                  (unless (and (= (nativeGet (nativeGet identity "wire") "code") 0)
                    (= (nativeGet actual "open_id") (nativeGet (nativeGet config "user_identity") "open_id")))
                    (throw (new globalThis.Error "Lark user OAuth identity mismatch")))
                  (setq token value token-until (+ now 60000)) value))
            (let* ((response (await (funcall request "/open-apis/auth/v3/tenant_access_token/internal"
                        "POST" (js-object :app_id (nativeGet credential "app_id")
                          :app_secret (nativeGet credential "app_secret")) nil context)))
                   (wire (nativeGet response "wire")) (value (nativeGet wire "tenant_access_token"))
                   (expiry (nativeGet wire "expire")))
              (unless (and (= (nativeGet response "status") 200) (= (nativeGet wire "code") 0)
                           (= (nativeTypeOf value) "string") (> (js-length value) 0)
                           (Number/isFinite expiry) (> expiry 0))
                (throw (new globalThis.Error "Lark application authentication unavailable")))
              (setq token value token-until (+ now (* 1000 (Math/max 0 (- expiry 60)))))
              value)))))))
      (setq authorize (async (context)
        (unless authorizing (setq authorizing (funcall acquire context)))
        (try (await authorizing) (finally (setq authorizing nil)))))
      (setq perform (async (command parameters context)
        (let ((result-token (js-object)) (result nil))
        (try
          (let* ((path nil) (method "GET") (body nil)
                 (thread (nativeGet parameters "thread_id")) (reading (js-call (js-array "list" "get") :includes command)))
            (cond
              ((= command "get")
                (setq path (str "/open-apis/im/v1/messages/" (nativeEncodeURIComponent (nativeGet parameters "message_id")))))
              ((= command "list")
                (let ((query (new globalThis.URLSearchParams)))
                  (js-call query :set "container_id_type" (if thread "thread" "chat"))
                  (js-call query :set "container_id" (or thread (nativeGet parameters "chat_id")))
                  (js-call query :set "page_size" (str (nativeGet parameters "limit" 50)))
                  (js-call query :set "sort_type" (if (= (nativeGet parameters "order") "desc") "ByCreateTimeDesc" "ByCreateTimeAsc"))
                  (when (nativeGet parameters "page_token") (js-call query :set "page_token" (nativeGet parameters "page_token")))
                  (when (and (not thread) (nativeGet parameters "start"))
                    (js-call query :set "start_time" (str (Math/floor (/ (Date/parse (nativeGet parameters "start")) 1000)))))
                  (when (and (not thread) (nativeGet parameters "end"))
                    (js-call query :set "end_time" (str (Math/ceil (/ (Date/parse (nativeGet parameters "end")) 1000)))))
                  (setq path (str "/open-apis/im/v1/messages?" (js-call query :toString)))))
              ((js-call (js-array "reaction_list" "reaction_create" "reaction_delete") :includes command)
                (setq path (str "/open-apis/im/v1/messages/" (nativeEncodeURIComponent (nativeGet parameters "message_id")) "/reactions"))
                (cond ((= command "reaction_list")
                  (setq path (str path "?reaction_type=Typing&user_id_type=open_id&page_size=50"
                    (if (nativeGet parameters "page_token") (str "&page_token=" (nativeEncodeURIComponent (nativeGet parameters "page_token"))) ""))))
                  ((= command "reaction_create") (setq method "POST" body (js-object :reaction_type (js-object :emoji_type "Typing"))))
                  (t (setq method "DELETE" path (str path "/" (nativeEncodeURIComponent (nativeGet parameters "reaction_id")))))))
              ((js-call (js-array "send" "reply") :includes command)
                (setq method "POST" body (js-object :msg_type "text"
                  :content (JSON/stringify (js-object :text (nativeGet parameters "text")))
                  :uuid (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 0 40)))
                (if (= command "reply")
                  (progn (setq path (str "/open-apis/im/v1/messages/" (nativeEncodeURIComponent (nativeGet parameters "message_id")) "/reply"))
                    (put body :reply_in_thread (= (nativeGet parameters "reply_in_thread") t)))
                  (progn (setq path "/open-apis/im/v1/messages?receive_id_type=chat_id")
                    (put body :receive_id (nativeGet parameters "chat_id")))))
              (t (setq result (failure "unsupported")) (throw result-token)))
            (let* ((bearer (await (funcall authorize context)))
                   (response (await (funcall request path method body bearer context)))
                   (wire (nativeGet response "wire")) (code (nativeGet wire "code")))
              (unless (and (= (nativeGet response "status") 200) (= code 0))
                (when (js-call (js-array 99991661 99991663 99991664) :includes code)
                  (setq token nil token-until 0))
                (setq result (failure (if (= (nativeGet response "status") 429) "rate_limited" "unavailable")
                  (js-object :details (js-object :native_code code :missing_scopes (nativeGet (nativeGet wire "error") "permission_violations" (js-array)) :reason (if (= (nativeGet response "status") 429)
                      "rate_limited" "native_api_rejected") :retry_after_seconds
                    (if (Number/isFinite (nativeGet response "retry_after"))
                      (Math/max 0 (nativeGet response "retry_after")) 0)))))
                (throw result-token))
              (let ((data (nativeGet wire "data")))
                (if reading
                  (if (and (Array/isArray (nativeGet data "items"))
                           (<= (js-length (nativeGet data "items")) 50)
                           (or (= command "get") (= (nativeTypeOf (nativeGet data "has_more")) "boolean")))
                    (success (js-object :ok t :identity (nativeGet config "identity") :data (js-object
                      :messages (js-call (nativeGet data "items") :map
                        (lambda (message) (formatLarkMessage message thread (nativeGet config "brand" "lark") application-id)))
                      :has_more (nativeGet data "has_more" false) :page_token (nativeGet data "page_token"))))
                    (failure "incompatible"))
                  (success (js-object :ok t :identity (nativeGet config "identity") :data data))))))
          (catch unavailable
            (if (eq unavailable result-token) result
              (failure "unavailable" (js-object :details
                (js-object :reason "native_api_unavailable")))))))))
      (js-object :perform perform
        :request (async (path method body context) (funcall request path method body (await (funcall authorize context)) context))
        :pendingWork (lambda () (nativeGet active "size"))
        :initialize (lambda () (setq closed false))
        :close (lambda () (setq closed t token nil token-until 0)
          (js-call active :forEach (lambda (controller) (js-call controller :abort)))))))
  (export createLarkHttpTransport formatLarkMessage))
