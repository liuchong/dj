(module dj.adapters.im.lark-resource-events
  (import "./lark-identities.eli" larkIdentities)
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (defconst resourceEvents (js-array "drive.file.bitable_record_changed_v1" "drive.file.bitable_field_changed_v1" "drive.file.edit_v1" "drive.notice.comment_add_v1"))
  (defun peopleIn (value &optional field)
    (let ((items (new globalThis.Map)) (visits 0) (walk nil))
      (setq walk (lambda (node depth)
        (setq visits (1+ visits))
        (when (and (< visits 4096) (< depth 16) node)
          (cond ((Array/isArray node) (js-call node :forEach (lambda (entry) (funcall walk entry (1+ depth)))))
            ((= (nativeTypeOf node) "object")
              (let ((id (nativeGet node "id" (nativeGet node "user_id" (nativeGet node "open_id")))))
                (when (and (= (nativeTypeOf id) "string") (js-call id :startsWith "ou_"))
                  (js-call items :set id (js-object :id id :name (nativeGet node "name" "")))))
              (js-call (Object/values node) :forEach (lambda (entry) (funcall walk entry (1+ depth)))))))))
      (funcall walk value 0) (Array/from (js-call items :values))))
  (defun recipientNoticeAllowed (config event)
    (and (= (nativeGet config "identity") "user")
      (= (nativeGet (nativeGet event "resource") "event_type") "drive.notice.comment_add_v1")
      (nativeGet (nativeGet config "user_identity") "open_id")
      (= (nativeGet (nativeGet event "resource") "recipient_id") (nativeGet (nativeGet config "user_identity") "open_id"))))
  (defun normalizeRecipientNotice (config wire)
    (let* ((header (nativeGet wire "header")) (notice (nativeGet wire "event")) (meta (nativeGet notice "notice_meta"))
      (token (nativeGet meta "file_token")) (kind (nativeGet meta "file_type")) (id (nativeGet header "event_id"))
      (stamp (NativeNumber (nativeGet header "create_time"))) (sender (nativeGet meta "from_user_id"))
      (recipient (nativeGet (nativeGet meta "to_user_id") "open_id"))
      (comment (nativeGet notice "comment_id")) (reply (nativeGet notice "reply_id" nil)) (mentioned (nativeGet notice "is_mentioned")))
      (unless (and (= (nativeGet header "event_type") "drive.notice.comment_add_v1")
        (= (nativeGet header "app_id") (nativeGet config "event_app_id"))
        (= (nativeTypeOf id) "string") (> (js-length id) 0) (= (nativeTypeOf token) "string") (> (js-length token) 0)
        (= (nativeTypeOf recipient) "string") (= (nativeTypeOf (nativeGet sender "open_id")) "string")
        (= (nativeTypeOf comment) "string") (> (js-length comment) 0) (Number/isSafeInteger stamp) (>= stamp 0)
        (= (nativeTypeOf mentioned) "boolean")
        (js-call (js-array "doc" "docx" "sheet" "bitable" "slides" "file") :includes kind)
        (js-call (js-array "add_comment" "add_reply") :includes (nativeGet meta "notice_type")))
        (throw (new globalThis.TypeError "invalid native recipient notice")))
      ;; Recipient notices are independent of file watches and content-reader coverage.
      (if (not (and (js-call (js-array "doc" "docx" "sheet" "bitable" "slides" "file") :includes kind)
        (= (nativeGet config "identity") "user") (= recipient (nativeGet (nativeGet config "user_identity") "open_id")))) (js-array)
        (js-array (js-object :connection_id (nativeGet config "connection_id") :source_key (str "notice:" id)
          :native_message_id (str "notice:" id) :event_kind "resource.changed" :source_revision "1"
          :conversation (js-object :kind "resource" :connection_id (nativeGet config "connection_id")
            :resource_kind kind :resource_token token :table_id nil :record_id nil :native_thread_id comment :thread_kind "resource")
          :resource (js-object :connection_id (nativeGet config "connection_id") :kind kind :token token
            :table_id nil :record_id nil :event_type "drive.notice.comment_add_v1" :action (nativeGet meta "notice_type")
            :recipient_id recipient :comment_id comment :reply_id reply :is_mentioned mentioned)
          :sender (js-object :id (nativeGet sender "open_id") :kind "human"
            :identities (larkIdentities (nativeGet config "brand" "lark") (nativeGet config "event_app_id") (nativeGet header "tenant_key") sender))
          :source_time (js-call (new globalThis.Date stamp) :toISOString) :root_message_id comment
          :addressed_self mentioned :mentions (if mentioned (js-array (js-object :id recipient :name "")) (js-array)) :people (js-array)
          :content (js-object :kind "text" :text (JSON/stringify notice) :truncated false) :attachments (js-array))))))
  (defun normalizeResourceEvents (config wire)
    (if (= (nativeGet (nativeGet wire "header") "event_type") "drive.notice.comment_add_v1")
      (normalizeRecipientNotice config wire)
    (let* ((header (nativeGet wire "header")) (event (nativeGet wire "event"))
      (type (nativeGet header "event_type")) (token (nativeGet event "file_token"))
      (kind (nativeGet event "file_type")) (table (nativeGet event "table_id" nil))
      (id (nativeGet header "event_id")) (stamp (NativeNumber (nativeGet header "create_time")))
      (actions (nativeGet event "action_list" (js-array (js-object :action "edited")))) (items (js-array)))
      (unless (and (js-call resourceEvents :includes type) (= (nativeGet header "app_id") (nativeGet config "event_app_id"))
        (= (nativeTypeOf id) "string") (= (nativeTypeOf token) "string") (js-call (js-array "docx" "sheet" "bitable") :includes kind)
        (Number/isSafeInteger stamp) (>= stamp 0) (Array/isArray actions) (<= (js-length actions) 128))
        (throw (new globalThis.TypeError "invalid native resource event")))
      (js-call actions :forEach (lambda (action index)
        (let* ((record (nativeGet action "record_id" nil)) (values (nativeGet action "after_value" (js-array)))
          (decoded (js-call values :map (lambda (value)
            (let ((data (nativeGet value "field_value")))
              (if (= (nativeTypeOf data) "string") (try (JSON/parse data) (catch invalid data)) data)))))
          (operator (nativeGet (nativeGet event "operator_id") "open_id" "unknown")))
          (js-call items :push (js-object :connection_id (nativeGet config "connection_id")
            :source_key (str id ":" index) :native_message_id (str id ":" index) :event_kind "resource.changed"
            :conversation (js-object :kind "resource" :connection_id (nativeGet config "connection_id")
              :resource_kind kind :resource_token token :table_id table :record_id record :native_thread_id record :thread_kind "resource")
            :resource (js-object :connection_id (nativeGet config "connection_id") :kind kind :token token :table_id table :record_id record
              :event_type type :action (nativeGet action "action" "edited"))
            :sender (js-object :id operator :identities (larkIdentities (nativeGet config "brand" "lark") (nativeGet config "event_app_id") (nativeGet header "tenant_key") (nativeGet event "operator_id" (js-object))) :kind (if (= operator "unknown") "unknown" "human"))
            :source_time (js-call (new globalThis.Date stamp) :toISOString) :source_revision "1"
            :root_message_id token :people (peopleIn decoded) :mentions (js-array)
            :content (js-object :kind "text" :text (JSON/stringify (js-object :action (nativeGet action "action" "edited") :fields values)) :truncated false)
            :attachments (js-array))))))
      items)))
  (export resourceEvents normalizeResourceEvents normalizeRecipientNotice recipientNoticeAllowed peopleIn))
