(module dj.adapters.im.lark-resource-events
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (defconst resourceEvents (js-array "drive.file.bitable_record_changed_v1" "drive.file.bitable_field_changed_v1" "drive.file.edit_v1"))
  (defun peopleIn (value &optional field)
    (let ((items (new globalThis.Map)) (visits 0) (walk nil))
      (setq walk (lambda (node depth)
        (setq visits (1+ visits))
        (when (and (< visits 4096) (< depth 16) node)
          (cond ((Array/isArray node) (js-call node :forEach (lambda (entry) (funcall walk entry (1+ depth)))))
            ((= (nativeTypeOf node) "object")
              (let ((id (nativeGet node "id" (nativeGet node "user_id" (nativeGet node "open_id")))))
                (when (and (= (nativeTypeOf id) "string") (js-call id :startsWith "ou_"))
                  (js-call items :set id (js-object :id id :name (nativeGet node "name" "")))))
              (js-call (Object/values node) :forEach (lambda (entry) (funcall walk entry (1+ depth)))))))))
      (funcall walk value 0) (Array/from (js-call items :values))))
  (defun normalizeResourceEvents (config wire)
    (let* ((header (nativeGet wire "header")) (event (nativeGet wire "event"))
      (type (nativeGet header "event_type")) (token (nativeGet event "file_token"))
      (kind (nativeGet event "file_type")) (table (nativeGet event "table_id" nil))
      (id (nativeGet header "event_id")) (stamp (NativeNumber (nativeGet header "create_time")))
      (actions (nativeGet event "action_list" (js-array (js-object :action "edited")))) (items (js-array)))
      (unless (and (js-call resourceEvents :includes type) (= (nativeGet header "app_id") (nativeGet config "event_app_id"))
        (= (nativeTypeOf id) "string") (= (nativeTypeOf token) "string") (js-call (js-array "docx" "sheet" "bitable") :includes kind)
        (Number/isSafeInteger stamp) (>= stamp 0) (Array/isArray actions) (<= (js-length actions) 128))
        (throw (new globalThis.TypeError "invalid native resource event")))
      (js-call actions :forEach (lambda (action index)
        (let* ((record (nativeGet action "record_id" nil)) (values (nativeGet action "after_value" (js-array)))
          (decoded (js-call values :map (lambda (value)
            (let ((data (nativeGet value "field_value")))
              (if (= (nativeTypeOf data) "string") (try (JSON/parse data) (catch invalid data)) data)))))
          (operator (nativeGet (nativeGet event "operator_id") "open_id" "unknown")))
          (js-call items :push (js-object :connection_id (nativeGet config "connection_id")
            :source_key (str id ":" index) :native_message_id (str id ":" index) :event_kind "resource.changed"
            :conversation (js-object :kind "resource" :connection_id (nativeGet config "connection_id")
              :resource_kind kind :resource_token token :table_id table :record_id record :native_thread_id record :thread_kind "resource")
            :resource (js-object :connection_id (nativeGet config "connection_id") :kind kind :token token :table_id table :record_id record
              :event_type type :action (nativeGet action "action" "edited"))
            :sender (js-object :id operator :kind (if (= operator "unknown") "unknown" "human"))
            :source_time (js-call (new globalThis.Date stamp) :toISOString) :source_revision "1"
            :root_message_id token :people (peopleIn decoded) :mentions (js-array)
            :content (js-object :kind "text" :text (JSON/stringify (js-object :action (nativeGet action "action" "edited") :fields values)) :truncated false)
            :attachments (js-array))))))
      items))
  (export resourceEvents normalizeResourceEvents peopleIn))
