(module dj.adapters.im.lark-inbox
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber nativeSetTimeout nativeClearTimeout)
  (import "../../core/errors.eli" success)
  (import "../../application/context.eli" inTransaction must utcNow nativeCallContext)
  (import "../../application/write-batch.eli" enqueueWrite)
  (import "../../application/diagnostics.eli" recordDiagnostic)
  (import "../../service/ownership.eli" ownerGuard)
  (import "./lark.eli" createReadLimiter)
  (import "./lark-reactions.eli" pollLarkReactions)
  (import "./lark-pins.eli" pollLarkPins)
  (import "../../connections/interactions.eli" resolveMessageInteraction)
  (import "./lark-reaction-policy.eli" reactionPollPolicy)
  (import "./lark-reaction-cache.eli" createReactionObservationCache)
  (import "./lark-edits.eli" pollLarkEdits editPollSeconds editWindowSeconds permanentMessageRefusal)
  (import "./lark-capabilities.eli" classifyCapabilityError errorHealthState)
  (import "../../../packages/lark/src/messages.eli" larkMessageMentionsAll)

  (defun knownCreated (db id message-id)
    (or
      (js-call (js-call db :query "SELECT 1 FROM events WHERE connection_id=? AND source_key=?")
        :get id (str message-id ":created"))
      (js-call (js-call db :query "SELECT 1 FROM im_event_inbox WHERE connection_id=? AND source_key=?")
        :get id (str message-id ":created"))))

  (defun filterPendingIds (db id items)
    (let ((seen (new globalThis.Set)) (kept (js-array)))
      (js-call (or items (js-array)) :forEach (lambda (item)
        (when (and (= (nativeTypeOf item) "string") (> (js-length item) 0) (not (js-call seen :has item)))
          (js-call seen :add item)
          (unless (knownCreated db id item)
            (js-call kept :push item)))))
      kept))

  (defun hotIntervalMs (idle-ms)
    (cond
      ((<= idle-ms 120000) 1000)
      ((<= idle-ms 300000) 2500)
      ((<= idle-ms 900000) 6000)
      ((<= idle-ms 1800000) 12000)
      (t nil)))

  (defun normalizeInboxMessage (config message chat-type normalize)
    (let* ((sender (nativeGet message "sender"))
      (raw-mentions (nativeGet message "mentions" (js-array)))
      (mentions (js-call raw-mentions :filter
        (lambda (mention) (and (= (nativeGet mention "id_type" "open_id") "open_id")
          (not (= (nativeGet mention "id") "all"))))))
      (event (funcall normalize config (js-object :type "im.message.receive_v1"
        :message_id (nativeGet message "message_id") :chat_id (nativeGet message "chat_id")
        :chat_type (if (js-call (js-array "p2p_chat" "p2p") :includes chat-type) "p2p" "group")
        :content (nativeGet message "content") :parsed_content (nativeGet message "parsed_content")
        :create_time (nativeGet message "create_time") :update_time (nativeGet message "update_time")
        :updated (nativeGet message "updated")
        :sender_id (nativeGet sender "id") :sender_type
          (if (= (nativeGet sender "sender_type") "user") "user" "bot")
        :sender_app_id (nativeGet config "event_app_id")
        :sender_native_ids (if (= (nativeGet sender "id_type" "open_id") "open_id")
          (js-object :open_id (nativeGet sender "id")) (js-object))
        :root_id (nativeGet message "root_id") :thread_id (nativeGet message "thread_id")
        :reply_to (nativeGet message "parent_id") :mentions mentions
        :mentions_all (larkMessageMentionsAll (nativeGet message "parsed_content") raw-mentions)))))
      (put event :receive_transport "poll")
      event))

  ;; One implementation, instantiated independently for every connection.
  ;; Only the official page-query shape differs between user and bot identities.
  (defun createLarkInboxPoller (config host base normalize)
    (let* ((interval (nativeGet config "inbox_poll_seconds" 2))
      (clock (nativeGet host "clock"))
      (id (nativeGet config "connection_id")) (user (= (nativeGet config "identity") "user"))
      (limiter (createReadLimiter clock))
      (policy (reactionPollPolicy config)) (running (new globalThis.Map))
      (bg-roles (js-array "edits" "pins")) (bg-cursor 0) (fg-streak 0)
      (idle-until (new globalThis.Map))
      (hot-targets (new globalThis.Map)) (hot-blocked-until 0) (hot-last-launch 0)
      (hot-activation (js-object :p2p 0 :group 0))
      (hot-identity-rev (nativeGet config "identity_revision"))
      (ws-covered (js-object :at -60000 :chats (new globalThis.Set)))
      (pin-sub (js-object :at -60000 :active false)) (repump-timer nil)
      (observations (createReactionObservationCache clock policy))
      (application nil) (closed false)
      (status (js-object :state "starting" :transport "poll" :interval_seconds interval
        :coverage (if user "authorized_user_messages" "discoverable_groups_and_known_private_chats")
        :last_success_at nil :last_received_at nil
        :reaction_poll (js-object :state "idle" :coverage "retained_local_messages" :limits_owner "dj"
          :budget_scope "application_across_connections" :policy policy :lanes (js-object) :native_error nil)))
      (load nil) (ensure nil) (persist nil) (persist-events nil)
      (refresh-ws-covered nil) (pin-subscribed nil) (evict-hot-kind nil)
      (touch-hot nil) (pick-hot-target nil) (run-hot-turn nil)
      (schedule-repump nil) (hot-counts nil) (turn nil) (pump nil) (known nil))
      (put status :pin_poll (js-object :state "idle" :transport "poll" :interval_seconds (nativeGet config "pin_poll_seconds" 15)
        :coverage "known_authorized_chats" :last_success_at nil :native_error nil))
      (put status :edit_poll (js-object :state "starting" :transport "poll" :interval_seconds editPollSeconds
        :window_seconds editWindowSeconds :last_success_at nil))
      (setq hot-counts (lambda ()
        (let ((chats 0) (threads 0)
              (blocked (and (> hot-blocked-until 0) (< (js-call clock :monoNow) hot-blocked-until))))
          (js-call hot-targets :forEach (lambda (entry)
            (if (= (nativeGet entry "kind") "thread")
              (setq threads (1+ threads))
              (setq chats (1+ chats)))))
          (js-object :enabled (and user (not blocked))
            :state (cond ((not user) "disabled") (blocked "blocked") (t "ready"))
            :active_chats chats :active_threads threads))))
      (put status :hot_poll (funcall hot-counts))
      (setq load (lambda (key)
        (js-call (nativeGet application "repository") :get "poll_checkpoints"
          (js-object :connection_id id :conversation_key key))))
      (setq ensure (lambda (key kind activation &optional chat fields)
        (let* ((repository (nativeGet application "repository")) (old (funcall load key))
          (identity (nativeGet (js-call repository :get "connections" id) "identity_revision")))
          (unless (and old (= (nativeGet old "identity_revision") identity))
            (let ((fresh (js-object :connection_id id :conversation_key key :kind kind :chat_id chat
              :generation (if old (1+ (nativeGet old "generation")) 1) :identity_revision identity
              :activation_at activation :next_due_at activation :pending_ids (js-array))))
              (when fields (Object/assign fresh fields))
              (if old (must (js-call repository :replace "poll_checkpoints" fresh))
                (js-call repository :insert "poll_checkpoints" fresh)))))))
      (setq known (lambda (activation)
        (let* ((db (nativeGet (nativeGet application "store") "db"))
          (rows (js-call (js-call db :query
            "SELECT DISTINCT json_extract(payload,'$.conversation.native_chat_id') AS chat_id,json_extract(payload,'$.chat_type') AS chat_type FROM events WHERE connection_id=? AND event_kind='message.created' AND json_extract(payload,'$.chat_type') IN ('group','p2p')") :all id)))
          (js-call rows :forEach (lambda (row)
            (when (nativeGet row "chat_id") (funcall ensure (str "inbox:pins:" (nativeGet row "chat_id")) "pins" activation (nativeGet row "chat_id")
              (js-object :pin_chat_type (nativeGet row "chat_type")))))))
        (js-call (nativeGet config "watches" (js-array)) :forEach (lambda (watch)
          (let ((chat (nativeGet watch "chat_id")))
            (when chat (funcall ensure (str "inbox:pins:" chat) "pins" activation chat)))))
        (unless user
          (let* ((db (nativeGet (nativeGet application "store") "db"))
            (rows (js-call (js-call db :query
              "SELECT json_extract(payload,'$.conversation.native_chat_id') AS chat_id,json_extract(payload,'$.chat_type') AS chat_type FROM events WHERE connection_id=? AND event_kind='message.created' GROUP BY conversation_key") :all id)))
            (js-call rows :forEach (lambda (row)
              (let ((chat (nativeGet row "chat_id")))
                (when chat (funcall ensure (str "inbox:chat:" chat)
                  (if (= (nativeGet row "chat_type") "p2p") "p2p" "group") activation chat)))))
            (js-call (nativeGet config "watches" (js-array)) :forEach (lambda (watch)
              (let ((chat (nativeGet watch "chat_id")))
                (funcall ensure (str "inbox:chat:" chat) "group" activation chat))))))))
      (setq persist-events (async (checkpoint events chats)
        (let ((index 0) (preceding (js-array)))
          (while (< index (js-length events))
            (await (resolveMessageInteraction config (aref events index) application base normalize preceding))
            (js-call preceding :push (aref events index))
            (setq index (1+ index))))
        (when (or checkpoint (> (js-length events) 0) (> (js-length chats) 0))
          (await (enqueueWrite application (lambda ()
            (inTransaction application (lambda (tx)
              (must (ownerGuard application))
              (let* ((repository (nativeGet application "repository"))
                (db (nativeGet (nativeGet application "store") "db"))
                (current (and checkpoint (js-call repository :get "poll_checkpoints" checkpoint)))
                (connection (js-call repository :get "connections" id))
                (revision (if checkpoint (nativeGet checkpoint "identity_revision") hot-identity-rev)))
                (when checkpoint
                  (unless (and current (= (nativeGet current "generation") (nativeGet checkpoint "generation")))
                    (throw (new globalThis.Error "inbox checkpoint identity changed"))))
                (unless (= (nativeGet connection "identity_revision") revision)
                  (throw (new globalThis.Error "inbox checkpoint identity changed")))
                (when (> (+ (nativeGet (js-call (js-call db :query
                  "SELECT COUNT(*) AS n FROM im_event_inbox WHERE connection_id=?") :get id) "n")
                  (js-length events)) 1000)
                  (throw (new globalThis.RangeError "event inbox full")))
                (let* ((now-iso (utcNow application))
                  (initial-discovery (and checkpoint (= (nativeGet checkpoint "kind") "discovery")
                    (not (nativeGet current "completed_until"))))
                  (discovered-chat-start (if initial-discovery (nativeGet checkpoint "activation_at") now-iso))
                  (discovered-pin-start (if initial-discovery (nativeGet (funcall load "inbox:pins") "activation_at") now-iso)))
                  (js-call events :forEach (lambda (event)
                    (put event :source_identity_revision revision)
                    (when (js-call (js-array "group" "p2p") :includes (nativeGet event "chat_type"))
                      (let ((chat (nativeGet (nativeGet event "conversation") "native_chat_id")))
                        (funcall ensure (str "inbox:pins:" chat) "pins" now-iso chat (js-object :pin_chat_type (nativeGet event "chat_type")))))
                    (js-call (js-call db :query
                      "INSERT OR IGNORE INTO im_event_inbox(connection_id,source_key,payload) VALUES(?,?,?)")
                      :run id (nativeGet event "source_key") (JSON/stringify event))))
                  (js-call chats :forEach (lambda (chat)
                    (funcall ensure (str "inbox:pins:" chat) "pins" discovered-pin-start chat)
                    (funcall ensure (str "inbox:chat:" chat) "group" discovered-chat-start chat))))
                (when checkpoint
                  (put checkpoint :generation (1+ (nativeGet checkpoint "generation")))
                  (must (js-call repository :replace "poll_checkpoints" checkpoint)))
                (success nil))))))))))
      (setq persist (async (checkpoint events chats)
        (await (funcall persist-events checkpoint events chats))))
      (setq refresh-ws-covered (lambda (force)
        (let ((now-mono (js-call clock :monoNow)))
          (when (and application (or force (< (nativeGet ws-covered "at") 0) (>= (- now-mono (nativeGet ws-covered "at")) 2000)))
            (let* ((db (nativeGet (nativeGet application "store") "db"))
              (cutoff (js-call (new globalThis.Date (- (Date/parse (utcNow application)) 86400000)) :toISOString))
              (rows (js-call (js-call db :query
                "SELECT DISTINCT chat_id FROM (SELECT json_extract(e.payload,'$.conversation.native_chat_id') AS chat_id FROM connections c JOIN events e ON e.connection_id=c.connection_id WHERE c.connection_id<>? AND json_extract(c.payload,'$.platform')='lark' AND e.event_kind='message.created' AND e.tombstone=0 AND e.received_at>=? AND json_extract(e.payload,'$.receive_transport')='websocket' UNION SELECT json_extract(i.payload,'$.conversation.native_chat_id') AS chat_id FROM connections c JOIN im_event_inbox i ON i.connection_id=c.connection_id WHERE c.connection_id<>? AND json_extract(c.payload,'$.platform')='lark' AND json_extract(i.payload,'$.event_kind')='message.created' AND json_extract(i.payload,'$.receive_transport')='websocket') WHERE chat_id IS NOT NULL") :all id cutoff id))
              (chats (new globalThis.Set)))
              (js-call rows :forEach (lambda (row)
                (when (nativeGet row "chat_id") (js-call chats :add (nativeGet row "chat_id")))))
              (put ws-covered :at now-mono)
              (put ws-covered :chats chats))))))
      (setq pin-subscribed (lambda ()
        (let ((now-mono (js-call clock :monoNow)))
          (when (or (< (nativeGet pin-sub "at") 0) (>= (- now-mono (nativeGet pin-sub "at")) 5000))
            (let* ((db (nativeGet (nativeGet application "store") "db"))
              (row (js-call (js-call db :query
                "SELECT 1 FROM subscription_sources i JOIN subscriptions s ON s.target_key=i.target_key AND s.revision=i.revision WHERE i.connection_id=? AND i.event_kind='message.pinned' AND s.state='active' LIMIT 1") :get id)))
              (put pin-sub :at now-mono)
              (put pin-sub :active (not (not row)))))
          (nativeGet pin-sub "active"))))
      (setq evict-hot-kind (lambda (target-kind max-count)
        (let ((matching (js-array)))
          (js-call hot-targets :forEach (lambda (entry)
            (when (= (nativeGet entry "kind") target-kind) (js-call matching :push entry))))
          (when (> (js-length matching) max-count)
            (js-call matching :sort (lambda (a b) (- (nativeGet a "last_activity_mono") (nativeGet b "last_activity_mono"))))
            (let ((drop (- (js-length matching) max-count)) (idx 0))
              (while (< idx drop)
                (js-call hot-targets :delete (nativeGet (aref matching idx) "key"))
                (setq idx (1+ idx))))))))
      (setq touch-hot (lambda (chat-id thread-id chat-type activity-mono &optional is-seed)
        (when (and user (or (= hot-blocked-until 0) (>= (js-call clock :monoNow) hot-blocked-until))
                (= (nativeTypeOf chat-id) "string") (> (js-length chat-id) 0))
          (unless (js-call hot-targets :has (str "chat:" chat-id))
            (funcall refresh-ws-covered t))
          (unless (js-call (nativeGet ws-covered "chats") :has chat-id)
            (let* ((now-mono (js-call clock :monoNow))
              (idle-ms (Math/max 0 (- now-mono activity-mono)))
              (interval-ms (hotIntervalMs idle-ms)))
              (when interval-ms
                (let ((upsert (lambda (target-kind key tid)
                    (let* ((existing (js-call hot-targets :get key))
                      (next-act (if existing (Math/max (nativeGet existing "last_activity_mono") activity-mono) activity-mono))
                      (target-due (+ now-mono (if is-seed interval-ms 1000)))
                      (entry (or existing (js-object :kind target-kind :key key :chat_id chat-id :thread_id tid
                        :chat_type (or chat-type "group") :last_activity_mono next-act
                        :next_due_mono target-due :backoff_ms 0))))
                      (when existing
                        (put entry :last_activity_mono next-act)
                        (when chat-type (put entry :chat_type chat-type))
                        (put entry :backoff_ms 0)
                        (put entry :next_due_mono (Math/min (nativeGet existing "next_due_mono") target-due)))
                      (js-call hot-targets :set key entry)
                      (funcall evict-hot-kind target-kind 8)))))
                  (funcall upsert "chat" (str "chat:" chat-id) nil)
                  (when (and (= (nativeTypeOf thread-id) "string") (> (js-length thread-id) 0))
                    (funcall upsert "thread" (str "thread:" thread-id) thread-id)))))))))
      (setq pick-hot-target (lambda ()
        (when (and user (or (= hot-blocked-until 0) (>= (js-call clock :monoNow) hot-blocked-until))
                (> (nativeGet hot-targets "size") 0))
          (let ((now-mono (js-call clock :monoNow)))
            (when (>= (- now-mono hot-last-launch) 500)
              (funcall refresh-ws-covered false)
              (let ((covered (nativeGet ws-covered "chats"))
                (stale (js-array)) (best nil))
                (js-call hot-targets :forEach (lambda (entry key)
                  (if (or (js-call covered :has (nativeGet entry "chat_id"))
                        (not (hotIntervalMs (Math/max 0 (- now-mono (nativeGet entry "last_activity_mono"))))))
                    (js-call stale :push key)
                    (when (>= now-mono (nativeGet entry "next_due_mono"))
                      (when (or (not best) (< (nativeGet entry "next_due_mono") (nativeGet best "next_due_mono")))
                        (setq best entry))))))
                (js-call stale :forEach (lambda (key) (js-call hot-targets :delete key)))
                best))))))
      (setq run-hot-turn (async (target)
        (let* ((now (utcNow application)) (now-ms (Date/parse now)) (now-mono (js-call clock :monoNow))
          (context (nativeCallContext application (js-object :abort_signal
            (nativeGet (nativeGet (nativeGet application "runtime") "intake_abort") "signal"))))
          (db (nativeGet (nativeGet application "store") "db"))
          (kind (nativeGet target "kind"))
          (params (if (= kind "thread")
            (js-object :thread_id (nativeGet target "thread_id") :order "desc" :limit 15)
            (js-object :chat_id (nativeGet target "chat_id") :order "desc" :limit 15)))
          (res (await (js-call base :history params context))))
          (if (not (nativeGet res "ok"))
            (let* ((err (nativeGet res "error"))
              (details (nativeGet err "details" (js-object)))
              (http-status (nativeGet details "http_status" 0))
              (missing-scopes (or (nativeGet details "missing_scopes") (js-array)))
              (retry-after (nativeGet details "retry_after_seconds" 0)))
              (cond
                ((or (= http-status 429) (= (nativeGet err "code") "rate_limited"))
                  (let ((pause-sec (Math/max 5 (if (Number/isFinite retry-after) retry-after 5))))
                    (js-call limiter :pause pause-sec)
                    (put target :next_due_mono (+ now-mono (* pause-sec 1000)))))
                ((> (js-length missing-scopes) 0)
                  (setq hot-blocked-until (+ now-mono 300000))
                  (js-call hot-targets :clear))
                ((permanentMessageRefusal err)
                  (js-call hot-targets :delete (nativeGet target "key")))
                (t
                  (let ((next-backoff (Math/min 60000 (Math/max 5000 (* (nativeGet target "backoff_ms" 0) 2)))))
                    (put target :backoff_ms next-backoff)
                    (put target :next_due_mono (+ now-mono next-backoff))))))
            (let* ((raw (js-call (js-call (nativeGet (nativeGet res "data") "messages" (js-array)) :slice) :reverse))
              (events (js-array)))
              (setq hot-blocked-until 0)
              (put target :backoff_ms 0)
              (js-call raw :forEach (lambda (msg)
                (let* ((msg-id (nativeGet msg "message_id"))
                  (stamp (NativeNumber (nativeGet msg "create_time")))
                  (raw-type (or (nativeGet msg "chat_type") (nativeGet target "chat_type") "group"))
                  (msg-chat-type (if (js-call (js-array "p2p_chat" "p2p") :includes raw-type) "p2p" "group"))
                  (act-floor (if (= msg-chat-type "p2p") (nativeGet hot-activation "p2p" 0) (nativeGet hot-activation "group" 0)))
                  (min-act (Math/max act-floor (- now-ms 120000))))
                  (when (and (= (nativeTypeOf msg-id) "string") (> (js-length msg-id) 0)
                    (Number/isSafeInteger stamp) (>= stamp min-act)
                    (not (nativeGet msg "deleted"))
                    (not (knownCreated db id msg-id)))
                    (js-call events :push (normalizeInboxMessage config msg msg-chat-type normalize))))))
              (when (> (js-length events) 0)
                (await (funcall persist-events nil events (js-array)))
                (put target :last_activity_mono now-mono)
                (js-call events :forEach (lambda (ev)
                  (funcall touch-hot
                    (nativeGet (nativeGet ev "conversation") "native_chat_id")
                    (nativeGet (nativeGet ev "conversation") "native_thread_id")
                    (nativeGet ev "chat_type")
                    now-mono)))
                (put status :last_received_at now))
              (put status :last_success_at now)
              (let ((next-delay (hotIntervalMs (Math/max 0 (- now-mono (nativeGet target "last_activity_mono"))))))
                (if next-delay
                  (put target :next_due_mono (+ now-mono next-delay))
                  (js-call hot-targets :delete (nativeGet target "key")))))))))
      (setq schedule-repump (lambda ()
        (let ((sig (nativeGet (nativeGet (nativeGet application "runtime") "intake_abort") "signal")))
          (when (and application (not closed) (not repump-timer) (not (nativeGet sig "aborted")))
            (setq repump-timer (nativeSetTimeout (lambda ()
              (setq repump-timer nil)
              (funcall pump)) 0))))))
      (setq turn (async (checkpoint)
        (let* ((now (utcNow application)) (kind (nativeGet checkpoint "kind"))
          (context (nativeCallContext application (js-object :abort_signal
            (nativeGet (nativeGet (nativeGet application "runtime") "intake_abort") "signal"))))
          (pending (nativeGet checkpoint "pending_ids" (js-array)))
          (db (nativeGet (nativeGet application "store") "db"))
          (events (js-array)) (chats (js-array)) (native nil) (messages (js-array))
          (response nil) (data nil) (page-more false) (page-token nil) (queried false))
          (if (= kind "edits")
            (progn
              (await (funcall persist checkpoint (await (pollLarkEdits config application base checkpoint context
                (lambda (message chat-type) (normalizeInboxMessage config message chat-type normalize)))) (js-array)))
              (let ((health (nativeGet status "edit_poll")))
                (put health :state (if (nativeGet checkpoint "native_error") "degraded" "ready"))
                (put health :last_success_at (nativeGet checkpoint "last_success_at"))
                (put health :native_error (nativeGet checkpoint "native_error"))))
          (if (= kind "pins")
            (progn
              (await (funcall persist checkpoint (await (pollLarkPins config application base checkpoint context normalize)) (js-array)))
              (let ((pin-health (nativeGet status "pin_poll")))
                (put pin-health :state (if (funcall pin-subscribed) "ready" "idle"))
                (put pin-health :last_success_at now)
                (put pin-health :native_error nil)))
          (if (= kind "reactions")
            (let* ((had-error (nativeGet checkpoint "native_error"))
              (result (await (pollLarkReactions config application base checkpoint context observations))))
              (try
                (let* ((lane (nativeGet checkpoint "reaction_lane" "archive"))
                  (queried (nativeGet result "queried")) (more (nativeGet result "more"))
                  (started (nativeGet checkpoint "reaction_sweep_started_at" now))
                  (delay (or (nativeGet result "retry_after_ms")
                    (cond ((= lane "new") (if more 0 (nativeGet policy "new_poll_ms")))
                      ((= lane "recent") (if more 0 (* 1000 (nativeGet policy "recent_poll_seconds"))))
                      ((= lane "engaged") 500)
                      (more 0)
                      (t (Math/max 0 (- (* 1000 (nativeGet policy "archive_cycle_seconds"))
                        (- (Date/parse now) (Date/parse started))))))))
                  (checkpoint-key (nativeGet checkpoint "conversation_key")))
                  (when (= lane "archive")
                    (if more (put checkpoint :reaction_sweep_started_at started)
                      (Reflect/deleteProperty checkpoint "reaction_sweep_started_at")))
                  (js-call idle-until :set checkpoint-key (+ (js-call (nativeGet host "clock") :monoNow) delay))
                  (when queried (put checkpoint :last_success_at now))
                  (put checkpoint :native_error nil)
                  ;; Idle probes use memory deadlines. No FULL transaction every
                  ;; 200ms just to announce that there is still no new message.
                  (when (or queried (nativeGet result "advanced") had-error)
                    (put checkpoint :next_due_at (js-call (new globalThis.Date (+ (Date/parse now) delay)) :toISOString))
                    (await (funcall persist checkpoint (nativeGet result "events") (js-array)))
                    (when (nativeGet result "observation")
                      (js-call observations :record (nativeGet result "observation"))))
                  (when queried
                    (put (nativeGet status "reaction_poll") :state "ready")
                    (put (nativeGet status "reaction_poll") :native_error nil))
                  (put (nativeGet (nativeGet status "reaction_poll") "lanes") lane
                    (js-object :state "ready" :last_scan_at now
                      :last_success_at (nativeGet checkpoint "last_success_at" nil) :sweep_complete (not more)))
                  (when (and queried (= (nativeGet status "state") "starting"))
                    (put status :state "ready"))
                  (when queried (put status :last_success_at now)))
                (finally
                  (when (nativeGet result "claim_key")
                    (js-call observations :release (nativeGet result "claim_key"))))))
            (progn
          (setq pending (filterPendingIds db id pending))
          (when (= (js-length pending) 0) (Reflect/deleteProperty checkpoint "pending_single_remaining"))
          (cond
            ((= kind "discovery")
              (let ((query (new globalThis.URLSearchParams (js-object :page_size "100"))))
                (when (nativeGet checkpoint "page_token") (js-call query :set "page_token" (nativeGet checkpoint "page_token")))
                (setq response (await (js-call base :nativeRequest
                  (str "/open-apis/im/v1/chats?" (js-call query :toString)) "GET" nil context)))
                (setq native (nativeGet response "wire"))))
            ((> (js-length pending) 0)
              (let ((single-rem (nativeGet checkpoint "pending_single_remaining" 0)))
                (if (or (= (js-length pending) 1) (> single-rem 0))
                  (let* ((target-id (aref pending 0))
                    (res (await (js-call base :history (js-object :message_id target-id) context))))
                    (setq response res)
                    (if (nativeGet res "ok")
                      (progn
                        (setq messages (nativeGet (nativeGet res "data") "messages"))
                        (unless (and (Array/isArray messages) (= (js-length messages) 1)
                          (= (nativeGet (aref messages 0) "message_id") target-id))
                          (throw (new globalThis.TypeError "invalid inbox message identity")))
                        (js-call pending :shift)
                        (when (> single-rem 0)
                          (if (> single-rem 1)
                            (put checkpoint :pending_single_remaining (1- single-rem))
                            (Reflect/deleteProperty checkpoint "pending_single_remaining"))))
                      (let ((err (nativeGet res "error")))
                        (if (permanentMessageRefusal err)
                          (progn
                            (js-call pending :shift)
                            (when (> single-rem 0)
                              (if (> single-rem 1)
                                (put checkpoint :pending_single_remaining (1- single-rem))
                                (Reflect/deleteProperty checkpoint "pending_single_remaining"))))
                          (throw err)))))
                  (let* ((batch (js-call pending :slice 0 20))
                    (batch-set (new globalThis.Set batch))
                    (res (await (js-call base :history (js-object :message_ids batch) context))))
                    (setq response res)
                    (if (nativeGet res "ok")
                      (progn
                        (setq messages (nativeGet (nativeGet res "data") "messages"))
                        (unless (and (Array/isArray messages) (<= (js-length messages) (js-length batch))
                          (js-call messages :every (lambda (m) (js-call batch-set :has (nativeGet m "message_id")))))
                          (throw (new globalThis.TypeError "invalid inbox batch messages")))
                        (setq pending (js-call pending :slice (js-length batch))))
                      (let ((err (nativeGet res "error")))
                        (if (or (permanentMessageRefusal err) (= (nativeGet err "code") "incompatible"))
                          (put checkpoint :pending_single_remaining (js-length batch))
                          (throw err))))))))
            ((not (and (nativeGet checkpoint "window_end") (not (nativeGet checkpoint "page_token"))))
              (unless (nativeGet checkpoint "window_end")
                (let* ((completed (Date/parse (nativeGet checkpoint "completed_until" (nativeGet checkpoint "activation_at"))))
                  (end (Math/min (Date/parse now) (+ completed 86400000)))
                  (start (Math/max (Date/parse (nativeGet checkpoint "activation_at")) (- completed 120000))))
                  (put checkpoint :window_start (js-call (new globalThis.Date start) :toISOString))
                  (put checkpoint :window_end (js-call (new globalThis.Date (Math/max start end)) :toISOString))))
              (setq queried t)
              (if user
                (let* ((query (new globalThis.URLSearchParams (js-object :page_size "50")))
                  (body (js-object :query "" :chat_type kind
                    :start_time (str (Math/floor (/ (Date/parse (nativeGet checkpoint "window_start")) 1000)))
                    :end_time (str (1+ (Math/ceil (/ (Date/parse (nativeGet checkpoint "window_end")) 1000)))))))
                  (when (nativeGet checkpoint "page_token") (js-call query :set "page_token" (nativeGet checkpoint "page_token")))
                  (setq response (await (js-call base :nativeRequest
                    (str "/open-apis/search/v2/message?" (js-call query :toString)) "POST" body context)))
                  (setq native (nativeGet response "wire")))
                (progn
                  (setq response (await (js-call base :history (js-object :chat_id (nativeGet checkpoint "chat_id")
                    :start (nativeGet checkpoint "window_start") :end (nativeGet checkpoint "window_end")
                    :limit 50 :order "asc" :page_token (nativeGet checkpoint "page_token")) context)))
                  (unless (nativeGet response "ok") (throw (nativeGet response "error")))
                  (setq data (nativeGet response "data") messages (nativeGet data "messages")
                    page-more (nativeGet data "has_more") page-token (nativeGet data "page_token"))))))
          (when native
            (unless (and (= (nativeGet response "status") 200) (= (nativeGet native "code") 0))
              (throw (js-object :native_code (nativeGet native "code") :http_status (nativeGet response "status")
                :missing_scopes (nativeGet (nativeGet native "error") "permission_violations" (js-array))
                :retry_after_seconds (if (Number/isFinite (nativeGet response "retry_after")) (nativeGet response "retry_after") 0))))
            (setq data (nativeGet native "data") page-more (nativeGet data "has_more") page-token (nativeGet data "page_token"))
            (let ((items (nativeGet data "items" (js-array))))
              (unless (and (Array/isArray items) (<= (js-length items) (if (= kind "discovery") 100 50)))
                (throw (new globalThis.TypeError "invalid inbox page size")))
              (if (= kind "discovery")
                (js-call items :forEach (lambda (chat)
                  (unless (and (= (nativeTypeOf (nativeGet chat "chat_id")) "string") (> (js-length (nativeGet chat "chat_id")) 0))
                    (throw (new globalThis.TypeError "invalid inbox conversation")))
                  (js-call chats :push (nativeGet chat "chat_id"))))
                (progn
                  (unless (js-call items :every (lambda (value) (and (= (nativeTypeOf value) "string") (> (js-length value) 0))))
                    (throw (new globalThis.TypeError "invalid inbox message keys")))
                  (setq pending (filterPendingIds db id items))))))
          (unless (and (Array/isArray messages) (<= (js-length messages) 50))
            (throw (new globalThis.TypeError "invalid inbox messages")))
          (js-call messages :forEach (lambda (message)
            (let ((stamp (NativeNumber (nativeGet message "create_time"))))
              (unless (Number/isSafeInteger stamp) (throw (new globalThis.TypeError "invalid inbox message time")))
              (when (and (>= stamp (Date/parse (nativeGet checkpoint "activation_at"))) (not (nativeGet message "deleted")))
                (js-call events :push (normalizeInboxMessage config message kind normalize))))))
          (when (or queried (= kind "discovery"))
            (let ((seen (nativeGet checkpoint "seen_page_tokens" (js-array))))
              (unless (and (= (nativeTypeOf page-more) "boolean") (< (js-length seen) 1000)
                (or (not page-more) (and (= (nativeTypeOf page-token) "string") (> (js-length page-token) 0)
                  (not (js-call seen :includes page-token)))))
                (throw (new globalThis.TypeError "invalid inbox pagination")))
              (when page-more (js-call seen :push page-token))
              (put checkpoint :seen_page_tokens seen) (put checkpoint :page_token (if page-more page-token nil))))
          (when (or (> (js-length events) 0) (> (js-length pending) 0))
            (put checkpoint :last_activity_at now))
          (put checkpoint :pending_ids pending) (put checkpoint :last_success_at now)
          (put checkpoint :native_error nil)
          (put checkpoint :next_due_at now)
          (when (and (= (js-length pending) 0) (not (nativeGet checkpoint "page_token")))
            (put checkpoint :completed_until (if (= kind "discovery") now (nativeGet checkpoint "window_end")))
            (put checkpoint :window_start nil) (put checkpoint :window_end nil) (put checkpoint :seen_page_tokens (js-array))
            (Reflect/deleteProperty checkpoint "pending_single_remaining")
            ;; Drain completed historical windows without the idle polling delay.
            ;; Pagination, admission limits and the shared request budget remain unchanged.
            (let* ((now-ms (Date/parse now))
              (completed-ms (Date/parse (nativeGet checkpoint "completed_until")))
              (last-act-str (nativeGet checkpoint "last_activity_at"))
              (last-act-ms (if last-act-str (Date/parse last-act-str) nil))
              (active-recent (and (Number/isFinite last-act-ms) (<= (- now-ms last-act-ms) 60000)))
              (p2p-idle (and (= kind "p2p_chat")
                (or (not (Number/isFinite last-act-ms)) (> (- now-ms last-act-ms) 300000))))
              (delay-seconds (cond
                ((= kind "discovery") 30)
                ((< completed-ms (- now-ms 2000)) 0)
                (user (cond
                  (active-recent (Math/min interval 1))
                  (p2p-idle (Math/max interval 3))
                  (t interval)))
                (t interval))))
              (put checkpoint :next_due_at (js-call (new globalThis.Date (+ now-ms (* delay-seconds 1000))) :toISOString))))
          (await (funcall persist checkpoint events chats))
          (let ((now-mono (js-call clock :monoNow)))
            (js-call events :forEach (lambda (ev)
              (funcall touch-hot
                (nativeGet (nativeGet ev "conversation") "native_chat_id")
                (nativeGet (nativeGet ev "conversation") "native_thread_id")
                (nativeGet ev "chat_type")
                now-mono))))
          (put status :state "ready") (put status :last_success_at now) (put status :native_error nil)
          (when (> (js-length events) 0) (put status :last_received_at now))
          (when (<= (Date/parse (nativeGet checkpoint "next_due_at" now)) (Date/parse now))
            (funcall schedule-repump)))))))))
      (setq pump (lambda ()
        (when (and application (not closed))
          ;; Independent message, hot-lane, fast-reaction and archive jobs use
          ;; independent checkpoints, while the HTTP transport owns app-wide quotas.
          (let* ((bg0 (aref bg-roles bg-cursor))
            (bg1 (aref bg-roles (% (1+ bg-cursor) (js-length bg-roles))))
            (limited (if (>= fg-streak 2)
              (js-array bg0 bg1 "messages" "hot")
              (js-array "messages" "hot" bg0 bg1)))
            (roles (js-call (js-array "reaction-fast" "reaction-archive") :concat limited)))
            (js-call roles :forEach (lambda (role)
              (unless (js-call running :has role)
                (cond
                  ((= role "hot")
                    (let ((target (funcall pick-hot-target)))
                      (when (and target (js-call limiter :acquire))
                        (setq fg-streak (1+ fg-streak) hot-last-launch (js-call clock :monoNow))
                        (js-call running :set role t)
                        (let ((job (funcall run-hot-turn target)))
                          (setq job (js-call job :catch (lambda (error)
                            (let ((backoff (Math/min 60000 (Math/max 5000 (* (nativeGet target "backoff_ms" 0) 2)))))
                              (put target :backoff_ms backoff)
                              (put target :next_due_mono (+ (js-call clock :monoNow) backoff))))))
                          (js-call job :finally (lambda ()
                            (js-call limiter :release)
                            (js-call running :delete role)))))))
                  ((not (and (= role "pins") (not (funcall pin-subscribed))))
                    (let* ((reaction (js-call role :startsWith "reaction-")) (pins (= role "pins"))
                      (rows (js-call (js-call (nativeGet (nativeGet application "store") "db") :query
                        (str "SELECT payload FROM poll_checkpoints WHERE connection_id=? AND conversation_key LIKE 'inbox:%' AND next_due_at<=? AND json_extract(payload,'$.kind')"
                          (cond ((= role "reaction-archive") "='reactions' AND conversation_key='inbox:reactions'")
                            (reaction "='reactions' AND conversation_key<>'inbox:reactions'")
                            (pins "='pins'") ((= role "edits") "='edits'")
                            (t " NOT IN ('reactions','pins','pins_root','edits')"))
                          " ORDER BY next_due_at,conversation_key LIMIT " (if reaction "3" "1"))) :all id (utcNow application)))
                      (candidates (js-call rows :map (lambda (row)
                        (let ((item (JSON/parse (nativeGet row "payload"))))
                          (js-object :checkpoint item :due (or (js-call idle-until :get (nativeGet item "conversation_key"))
                            (+ (js-call clock :monoNow)
                              (- (Date/parse (nativeGet item "next_due_at")) (Date/parse (utcNow application))))))))))
                      (eligible (js-call candidates :filter (lambda (item)
                        (>= (js-call clock :monoNow) (nativeGet item "due")))))
                      (candidate (aref (js-call eligible :sort (lambda (a b) (- (nativeGet a "due") (nativeGet b "due")))) 0))
                      (checkpoint (nativeGet candidate "checkpoint"))
                      (saved (and checkpoint (JSON/stringify checkpoint))))
                      (when (and checkpoint (or reaction (js-call limiter :acquire)))
                        (unless reaction
                          (if (= role "messages")
                            (setq fg-streak (1+ fg-streak))
                            (let ((slot (js-call bg-roles :indexOf role)))
                              (setq fg-streak 0)
                              (when (>= slot 0)
                                (setq bg-cursor (% (1+ slot) (js-length bg-roles)))))))
                        (js-call running :set role t)
                        (let ((job (funcall turn checkpoint)))
                          (setq job (js-call job :catch (async (error)
                            (let* ((edits (= role "edits")) (pins-job (= role "pins"))
                              (health (cond
                                (edits (nativeGet status "edit_poll"))
                                (pins-job (nativeGet status "pin_poll"))
                                (reaction (nativeGet status "reaction_poll"))
                                (t status)))
                              (classified (classifyCapabilityError error (if edits editPollSeconds 5)))
                              (problem (nativeGet classified "problem"))
                              (next-state (nativeGet classified "state"))
                              (seconds (nativeGet classified "retry_seconds")))
                            (put health :state next-state)
                            (when reaction
                              (put (nativeGet (nativeGet status "reaction_poll") "lanes")
                                (nativeGet checkpoint "reaction_lane" "archive")
                                (js-object :state next-state :native_error problem)))
                            (when (not (= (nativeGet (nativeGet checkpoint "native_error") "code") (nativeGet problem "code")))
                              (recordDiagnostic application (js-object :code "lark_poll_unavailable" :connection_id id
                                :state next-state :job_kind role :native_code (str (nativeGet problem "code"))
                                :reason (nativeGet problem "reason" "request_failed"))))
                            (put health :native_error problem)
                            (let ((retry (JSON/parse saved)))
                              (when (and (not reaction) (= (nativeGet classified "kind") "rate_limited"))
                                (js-call limiter :pause seconds))
                              (put retry :native_error problem)
                              (put retry :next_due_at (js-call (new globalThis.Date (+ (Date/parse (utcNow application)) (* seconds 1000))) :toISOString))
                              (try (await (funcall persist retry (js-array) (js-array)))
                                (catch stale (setq closed t) (put status :state "blocked"))))))))
                          (js-call job :finally (lambda ()
                            (unless reaction (js-call limiter :release))
                            (js-call running :delete role)))))))))))))))
      (js-object :pump pump :status (lambda ()
        (put (nativeGet status "reaction_poll") :observations (js-call observations :status))
        (put status :hot_poll (funcall hot-counts))
        (let* ((db (and application (nativeGet (nativeGet application "store") "db")))
               (query-err (lambda (where-clause)
                 (let ((row (when db (js-call (js-call db :query
                   (str "SELECT json_extract(payload,'$.native_error') AS error FROM poll_checkpoints WHERE connection_id=? AND "
                     where-clause " AND json_extract(payload,'$.native_error') IS NOT NULL LIMIT 1")) :get id))))
                   (and row (JSON/parse (nativeGet row "error"))))))
               (project-health (lambda (base-health where-clause)
                 (let ((err (funcall query-err where-clause)))
                   (if err
                     (Object/assign (js-object) base-health (js-object :state (errorHealthState err) :native_error err))
                     base-health))))
               (core-err (funcall query-err
                 "conversation_key LIKE 'inbox:%' AND conversation_key NOT IN ('inbox:edits','inbox:pins') AND conversation_key NOT LIKE 'inbox:pins:%' AND conversation_key NOT LIKE 'inbox:reaction%'"))
               (rx-health (funcall project-health (nativeGet status "reaction_poll") "conversation_key LIKE 'inbox:reaction%'"))
               (pin-health (funcall project-health (nativeGet status "pin_poll") "(conversation_key='inbox:pins' OR conversation_key LIKE 'inbox:pins:%')"))
               (edit-health (funcall project-health (nativeGet status "edit_poll") "conversation_key='inbox:edits'"))
               (view (Object/assign (js-object) status (js-object
                 :reaction_poll rx-health :pin_poll pin-health :edit_poll edit-health))))
          (if core-err
            (Object/assign view (js-object
              :state (if (= (nativeGet status "state") "blocked") "blocked" (errorHealthState core-err))
              :native_error core-err))
            view)))
        :remember (lambda (event)
          (let* ((now-iso (utcNow application))
            (now-ms (Date/parse now-iso))
            (discovery (and (not user) (funcall load "inbox:discovery")))
            (initial-discovery (and discovery (not (nativeGet discovery "completed_until"))))
            (pin-start (if initial-discovery (nativeGet (funcall load "inbox:pins") "activation_at") now-iso)))
            (when (and (= (nativeGet event "event_kind") "message.created") (js-call (js-array "group" "p2p") :includes (nativeGet event "chat_type")))
              (let ((chat (nativeGet (nativeGet event "conversation") "native_chat_id")))
                (when chat (funcall ensure (str "inbox:pins:" chat) "pins" pin-start chat (js-object :pin_chat_type (nativeGet event "chat_type"))))))
            (when (and user (= (nativeGet event "event_kind") "message.created") (nativeGet event "conversation"))
              (funcall touch-hot
                (nativeGet (nativeGet event "conversation") "native_chat_id")
                (nativeGet (nativeGet event "conversation") "native_thread_id")
                (nativeGet event "chat_type")
                (js-call clock :monoNow)))
            (when (and (not user) (= (nativeGet event "event_kind") "message.created"))
              (let* ((chat (nativeGet (nativeGet event "conversation") "native_chat_id"))
                (root-start (nativeGet discovery "activation_at" now-iso))
                (root-ms (Date/parse root-start))
                (src-ms (Date/parse (nativeGet event "source_time" "")))
                (chat-start (cond
                  (initial-discovery root-start)
                  ((and (Number/isFinite src-ms) (>= src-ms (Math/max root-ms (- now-ms 10000))) (<= src-ms now-ms))
                    (js-call (new globalThis.Date src-ms) :toISOString))
                  (t now-iso))))
                (when chat (funcall ensure (str "inbox:chat:" chat)
                  (if (= (nativeGet event "chat_type") "p2p") "p2p" "group")
                  chat-start chat))))))
        :initialize (lambda (context)
          (setq application context closed false hot-blocked-until 0 hot-last-launch 0)
          (when repump-timer (nativeClearTimeout repump-timer) (setq repump-timer nil))
          (js-call observations :clear) (js-call idle-until :clear) (js-call hot-targets :clear)
          (put ws-covered :at -60000) (put ws-covered :chats (new globalThis.Set))
          (put pin-sub :at -60000) (put pin-sub :active false)
          (must (inTransaction context (lambda (tx)
            (must (ownerGuard context))
            (let ((conn (js-call (nativeGet context "repository") :get "connections" id)))
              (setq hot-identity-rev (nativeGet conn "identity_revision" (nativeGet config "identity_revision"))))
            (funcall ensure "inbox:reactions" "reactions" (utcNow context))
            (funcall ensure "inbox:pins" "pins_root" (utcNow context))
            (funcall ensure "inbox:edits" "edits" (utcNow context))
            (let* ((activation (nativeGet (funcall load "inbox:reactions") "activation_at"))
              (row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                "SELECT CAST(COALESCE(MAX(ingress_seq),0) AS TEXT) AS seq FROM events WHERE connection_id=?") :get id)))
              (funcall ensure "inbox:reaction-new" "reactions" activation nil
                (js-object :reaction_lane "new" :reaction_new_after_seq (nativeGet row "seq")))
              (funcall ensure "inbox:reaction-recent" "reactions" activation nil (js-object :reaction_lane "recent"))
              (funcall ensure "inbox:reaction-engaged" "reactions" activation nil (js-object :reaction_lane "engaged")))
            (js-call (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
              "SELECT native_message_id,json_extract(payload,'$.reaction.action_time') AS activity FROM events WHERE connection_id=? AND event_kind='message.reaction.added' AND tombstone=0 AND json_extract(payload,'$.identity_revision')=? ORDER BY ingress_seq DESC LIMIT 32")
              :all id (nativeGet config "identity_revision")) :forEach (lambda (row)
                (let ((activity (NativeNumber (nativeGet row "activity"))))
                  (when (and (Number/isSafeInteger activity) (>= activity 0))
                    (js-call observations :seed (nativeGet row "native_message_id") activity)))))
            (if user
              (progn
                (js-call (js-array "p2p_chat" "group_chat") :forEach (lambda (kind)
                  (funcall ensure (str "inbox:" kind) kind (utcNow context))))
                (put hot-activation :p2p (Date/parse (nativeGet (funcall load "inbox:p2p_chat") "activation_at")))
                (put hot-activation :group (Date/parse (nativeGet (funcall load "inbox:group_chat") "activation_at")))
                (let* ((now-mono (js-call clock :monoNow))
                  (now-ms (Date/parse (utcNow context)))
                  (seed-cutoff (js-call (new globalThis.Date (- now-ms 900000)) :toISOString))
                  (seed-rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                    "SELECT received_at,json_extract(payload,'$.conversation.native_chat_id') AS chat_id,json_extract(payload,'$.conversation.native_thread_id') AS thread_id,json_extract(payload,'$.chat_type') AS chat_type FROM events WHERE connection_id=? AND event_kind='message.created' AND tombstone=0 AND received_at>=? ORDER BY received_at DESC,ingress_seq DESC LIMIT 32") :all id seed-cutoff)))
                  (js-call seed-rows :forEach (lambda (row)
                    (let* ((raw-rx (Date/parse (nativeGet row "received_at" "")))
                      (age-ms (if (Number/isFinite raw-rx) (Math/max 0 (- now-ms raw-rx)) 900000)))
                      (funcall touch-hot (nativeGet row "chat_id") (nativeGet row "thread_id")
                        (nativeGet row "chat_type") (- now-mono age-ms) t))))))
              (funcall ensure "inbox:discovery" "discovery" (utcNow context)))
            (funcall known (utcNow context))
            (success nil)))))
        :close (lambda ()
          (setq closed t)
          (when repump-timer (nativeClearTimeout repump-timer) (setq repump-timer nil)))
        :pendingWork (lambda () (nativeGet running "size")))))
  (export createLarkInboxPoller normalizeInboxMessage))
