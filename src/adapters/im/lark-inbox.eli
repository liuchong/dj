(module dj.adapters.im.lark-inbox
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "../../core/errors.eli" success)
  (import "../../application/context.eli" inTransaction must utcNow nativeCallContext)
  (import "../../application/write-batch.eli" enqueueWrite)
  (import "../../service/ownership.eli" ownerGuard)
  (import "./lark.eli" createReadLimiter)
  (import "./lark-reactions.eli" pollLarkReactions)
  (import "./lark-interactions.eli" resolveLarkInteraction)
  (import "./lark-reaction-policy.eli" reactionPollPolicy)
  (import "./lark-reaction-cache.eli" createReactionObservationCache)

  (defun normalizeInboxMessage (config message chat-type normalize)
    (let* ((sender (nativeGet message "sender"))
      (mentions (js-call (nativeGet message "mentions" (js-array)) :filter
        (lambda (mention) (= (nativeGet mention "id_type" "open_id") "open_id"))))
      (event (funcall normalize config (js-object :type "im.message.receive_v1"
        :message_id (nativeGet message "message_id") :chat_id (nativeGet message "chat_id")
        :chat_type (if (js-call (js-array "p2p_chat" "p2p") :includes chat-type) "p2p" "group")
        :content (nativeGet message "content") :create_time (nativeGet message "create_time")
        :sender_id (nativeGet sender "id") :sender_type
          (if (= (nativeGet sender "sender_type") "user") "user" "bot")
        :sender_app_id (nativeGet config "event_app_id")
        :sender_native_ids (if (= (nativeGet sender "id_type" "open_id") "open_id")
          (js-object :open_id (nativeGet sender "id")) (js-object))
        :root_id (nativeGet message "root_id") :thread_id (nativeGet message "thread_id")
        :reply_to (nativeGet message "parent_id") :mentions mentions))))
      (put event :receive_transport "poll")
      event))

  ;; One implementation, instantiated independently for every connection.
  ;; Only the official page-query shape differs between user and bot identities.
  (defun createLarkInboxPoller (config host base normalize)
    (let* ((interval (nativeGet config "inbox_poll_seconds" 2))
      (id (nativeGet config "connection_id")) (user (= (nativeGet config "identity") "user"))
      (limiter (createReadLimiter (nativeGet host "clock")))
      (policy (reactionPollPolicy config)) (running (new globalThis.Map))
      (idle-until (new globalThis.Map))
      (observations (createReactionObservationCache (nativeGet host "clock") policy))
      (application nil) (closed false)
      (status (js-object :state "starting" :transport "poll" :interval_seconds interval
        :coverage (if user "authorized_user_messages" "discoverable_groups_and_known_private_chats")
        :last_success_at nil :last_received_at nil
        :reaction_poll (js-object :coverage "retained_local_messages" :limits_owner "dj"
          :budget_scope "application_across_connections" :policy policy :lanes (js-object))))
      (load nil) (ensure nil) (persist nil) (turn nil) (pump nil) (known nil))
      (setq load (lambda (key)
        (js-call (nativeGet application "repository") :get "poll_checkpoints"
          (js-object :connection_id id :conversation_key key))))
      (setq ensure (lambda (key kind activation &optional chat fields)
        (let* ((repository (nativeGet application "repository")) (old (funcall load key))
          (identity (nativeGet (js-call repository :get "connections" id) "identity_revision")))
          (unless (and old (= (nativeGet old "identity_revision") identity))
            (let ((fresh (js-object :connection_id id :conversation_key key :kind kind :chat_id chat
              :generation (if old (1+ (nativeGet old "generation")) 1) :identity_revision identity
              :activation_at activation :next_due_at activation :pending_ids (js-array))))
              (when fields (Object/assign fresh fields))
              (if old (must (js-call repository :replace "poll_checkpoints" fresh))
                (js-call repository :insert "poll_checkpoints" fresh)))))))
      (setq known (lambda (activation)
        (unless user
          (let* ((db (nativeGet (nativeGet application "store") "db"))
            (rows (js-call (js-call db :query
              "SELECT json_extract(payload,'$.conversation.native_chat_id') AS chat_id,json_extract(payload,'$.chat_type') AS chat_type FROM events WHERE connection_id=? AND event_kind='message.created' GROUP BY conversation_key") :all id)))
            (js-call rows :forEach (lambda (row)
              (let ((chat (nativeGet row "chat_id")))
                (when chat (funcall ensure (str "inbox:chat:" chat)
                  (if (= (nativeGet row "chat_type") "p2p") "p2p" "group") activation chat)))))
            (js-call (nativeGet config "watches" (js-array)) :forEach (lambda (watch)
              (let ((chat (nativeGet watch "chat_id")))
                (funcall ensure (str "inbox:chat:" chat) "group" activation chat))))))))
      (setq persist (async (checkpoint events chats)
        (let ((index 0) (preceding (js-array)))
          (while (< index (js-length events))
            (await (resolveLarkInteraction config (aref events index) application base normalize preceding))
            (js-call preceding :push (aref events index))
            (setq index (1+ index))))
        (await (enqueueWrite application (lambda ()
          (inTransaction application (lambda (tx)
            (must (ownerGuard application))
            (let* ((repository (nativeGet application "repository"))
              (db (nativeGet (nativeGet application "store") "db"))
              (current (js-call repository :get "poll_checkpoints" checkpoint))
              (connection (js-call repository :get "connections" id)))
              (unless (and current (= (nativeGet current "generation") (nativeGet checkpoint "generation"))
                (= (nativeGet connection "identity_revision") (nativeGet checkpoint "identity_revision")))
                (throw (new globalThis.Error "inbox checkpoint identity changed")))
              (when (> (+ (nativeGet (js-call (js-call db :query
                "SELECT COUNT(*) AS n FROM im_event_inbox WHERE connection_id=?") :get id) "n")
                (js-length events)) 1000)
                (throw (new globalThis.RangeError "event inbox full")))
              (js-call events :forEach (lambda (event)
                (put event :source_identity_revision (nativeGet checkpoint "identity_revision"))
                (js-call (js-call db :query
                  "INSERT OR IGNORE INTO im_event_inbox(connection_id,source_key,payload) VALUES(?,?,?)")
                  :run id (nativeGet event "source_key") (JSON/stringify event))))
              (js-call chats :forEach (lambda (chat)
                (funcall ensure (str "inbox:chat:" chat) "group" (nativeGet checkpoint "activation_at") chat)))
              (put checkpoint :generation (1+ (nativeGet checkpoint "generation")))
              (must (js-call repository :replace "poll_checkpoints" checkpoint))
              (success nil)))))))))
      (setq turn (async (checkpoint)
        (let* ((now (utcNow application)) (kind (nativeGet checkpoint "kind"))
          (context (nativeCallContext application (js-object :abort_signal
            (nativeGet (nativeGet (nativeGet application "runtime") "intake_abort") "signal"))))
          (pending (nativeGet checkpoint "pending_ids" (js-array)))
          (db (nativeGet (nativeGet application "store") "db"))
          (events (js-array)) (chats (js-array)) (native nil) (messages (js-array))
          (response nil) (data nil) (page-more false) (page-token nil) (queried false))
          (if (= kind "reactions")
            (let* ((had-error (nativeGet checkpoint "native_error"))
              (result (await (pollLarkReactions config application base checkpoint context observations))))
              (try
                (let* ((lane (nativeGet checkpoint "reaction_lane" "archive"))
                  (queried (nativeGet result "queried")) (more (nativeGet result "more"))
                  (started (nativeGet checkpoint "reaction_sweep_started_at" now))
                  (delay (or (nativeGet result "retry_after_ms")
                    (cond ((= lane "new") (if more 0 (nativeGet policy "new_poll_ms")))
                      ((= lane "recent") (if more 0 (* 1000 (nativeGet policy "recent_poll_seconds"))))
                      ((= lane "engaged") 500)
                      (more 0)
                      (t (Math/max 0 (- (* 1000 (nativeGet policy "archive_cycle_seconds"))
                        (- (Date/parse now) (Date/parse started))))))))
                  (checkpoint-key (nativeGet checkpoint "conversation_key")))
                  (when (= lane "archive")
                    (if more (put checkpoint :reaction_sweep_started_at started)
                      (Reflect/deleteProperty checkpoint "reaction_sweep_started_at")))
                  (js-call idle-until :set checkpoint-key (+ (js-call (nativeGet host "clock") :monoNow) delay))
                  (when queried (put checkpoint :last_success_at now))
                  (put checkpoint :native_error nil)
                  ;; Idle probes use memory deadlines. No FULL transaction every
                  ;; 200ms just to announce that there is still no new message.
                  (when (or queried (nativeGet result "advanced") had-error)
                    (put checkpoint :next_due_at (js-call (new globalThis.Date (+ (Date/parse now) delay)) :toISOString))
                    (await (funcall persist checkpoint (nativeGet result "events") (js-array)))
                    (when (nativeGet result "observation")
                      (js-call observations :record (nativeGet result "observation"))))
                  (put (nativeGet (nativeGet status "reaction_poll") "lanes") lane
                    (js-object :state "ready" :last_scan_at now
                      :last_success_at (nativeGet checkpoint "last_success_at" nil) :sweep_complete (not more)))
                  (put status :state "ready")
                  (when queried (put status :last_success_at now)))
                (finally
                  (when (nativeGet result "claim_key")
                    (js-call observations :release (nativeGet result "claim_key"))))))
            (progn
          (while (and (> (js-length pending) 0)
            (or (js-call (js-call db :query "SELECT 1 FROM events WHERE connection_id=? AND source_key=?")
                  :get id (str (aref pending 0) ":created"))
                (js-call (js-call db :query "SELECT 1 FROM im_event_inbox WHERE connection_id=? AND source_key=?")
                  :get id (str (aref pending 0) ":created"))))
            (js-call pending :shift))
          (cond
            ((= kind "discovery")
              (let ((query (new globalThis.URLSearchParams (js-object :page_size "100"))))
                (when (nativeGet checkpoint "page_token") (js-call query :set "page_token" (nativeGet checkpoint "page_token")))
                (setq response (await (js-call base :nativeRequest
                  (str "/open-apis/im/v1/chats?" (js-call query :toString)) "GET" nil context)))
                (setq native (nativeGet response "wire"))))
            ((> (js-length pending) 0)
              (setq response (await (js-call base :history (js-object :message_id (aref pending 0)) context)))
              (unless (nativeGet response "ok") (throw (nativeGet response "error")))
              (setq messages (nativeGet (nativeGet response "data") "messages"))
              (unless (and (Array/isArray messages) (= (js-length messages) 1)
                (= (nativeGet (aref messages 0) "message_id") (aref pending 0)))
                (throw (new globalThis.TypeError "invalid inbox message identity")))
              (js-call pending :shift))
            ((not (and (nativeGet checkpoint "window_end") (not (nativeGet checkpoint "page_token"))))
              (unless (nativeGet checkpoint "window_end")
                (let* ((completed (Date/parse (nativeGet checkpoint "completed_until" (nativeGet checkpoint "activation_at"))))
                  (end (Math/min (- (Date/parse now) 2000) (+ completed 86400000)))
                  (start (Math/max (Date/parse (nativeGet checkpoint "activation_at")) (- completed 120000))))
                  (put checkpoint :window_start (js-call (new globalThis.Date start) :toISOString))
                  (put checkpoint :window_end (js-call (new globalThis.Date (Math/max start end)) :toISOString))))
              (setq queried t)
              (if user
                (let* ((query (new globalThis.URLSearchParams (js-object :page_size "50")))
                  (body (js-object :query "" :chat_type kind
                    :start_time (str (Math/floor (/ (Date/parse (nativeGet checkpoint "window_start")) 1000)))
                    :end_time (str (Math/ceil (/ (Date/parse (nativeGet checkpoint "window_end")) 1000))))))
                  (when (nativeGet checkpoint "page_token") (js-call query :set "page_token" (nativeGet checkpoint "page_token")))
                  (setq response (await (js-call base :nativeRequest
                    (str "/open-apis/search/v2/message?" (js-call query :toString)) "POST" body context)))
                  (setq native (nativeGet response "wire")))
                (progn
                  (setq response (await (js-call base :history (js-object :chat_id (nativeGet checkpoint "chat_id")
                    :start (nativeGet checkpoint "window_start") :end (nativeGet checkpoint "window_end")
                    :limit 50 :order "asc" :page_token (nativeGet checkpoint "page_token")) context)))
                  (unless (nativeGet response "ok") (throw (nativeGet response "error")))
                  (setq data (nativeGet response "data") messages (nativeGet data "messages")
                    page-more (nativeGet data "has_more") page-token (nativeGet data "page_token"))))))
          (when native
            (unless (and (= (nativeGet response "status") 200) (= (nativeGet native "code") 0))
              (throw (js-object :native_code (nativeGet native "code") :http_status (nativeGet response "status")
                :missing_scopes (nativeGet (nativeGet native "error") "permission_violations" (js-array)))))
            (setq data (nativeGet native "data") page-more (nativeGet data "has_more") page-token (nativeGet data "page_token"))
            (let ((items (nativeGet data "items" (js-array))))
              (unless (and (Array/isArray items) (<= (js-length items) (if (= kind "discovery") 100 50)))
                (throw (new globalThis.TypeError "invalid inbox page size")))
              (if (= kind "discovery")
                (js-call items :forEach (lambda (chat)
                  (unless (and (= (nativeTypeOf (nativeGet chat "chat_id")) "string") (> (js-length (nativeGet chat "chat_id")) 0))
                    (throw (new globalThis.TypeError "invalid inbox conversation")))
                  (js-call chats :push (nativeGet chat "chat_id"))))
                (progn
                  (unless (js-call items :every (lambda (value) (and (= (nativeTypeOf value) "string") (> (js-length value) 0))))
                    (throw (new globalThis.TypeError "invalid inbox message keys")))
                  (setq pending items)))))
          (unless (and (Array/isArray messages) (<= (js-length messages) 50))
            (throw (new globalThis.TypeError "invalid inbox messages")))
          (js-call messages :forEach (lambda (message)
            (let ((stamp (NativeNumber (nativeGet message "create_time"))))
              (unless (Number/isSafeInteger stamp) (throw (new globalThis.TypeError "invalid inbox message time")))
              (when (and (>= stamp (Date/parse (nativeGet checkpoint "activation_at"))) (not (nativeGet message "deleted")))
                (js-call events :push (normalizeInboxMessage config message kind normalize))))))
          (when (or queried (= kind "discovery"))
            (let ((seen (nativeGet checkpoint "seen_page_tokens" (js-array))))
              (unless (and (= (nativeTypeOf page-more) "boolean") (< (js-length seen) 1000)
                (or (not page-more) (and (= (nativeTypeOf page-token) "string") (> (js-length page-token) 0)
                  (not (js-call seen :includes page-token)))))
                (throw (new globalThis.TypeError "invalid inbox pagination")))
              (when page-more (js-call seen :push page-token))
              (put checkpoint :seen_page_tokens seen) (put checkpoint :page_token (if page-more page-token nil))))
          (put checkpoint :pending_ids pending) (put checkpoint :last_success_at now)
          (put checkpoint :native_error nil)
          (put checkpoint :next_due_at now)
          (when (and (= (js-length pending) 0) (not (nativeGet checkpoint "page_token")))
            (unless (= kind "discovery") (put checkpoint :completed_until (nativeGet checkpoint "window_end")))
            (put checkpoint :window_start nil) (put checkpoint :window_end nil) (put checkpoint :seen_page_tokens (js-array))
            ;; Drain completed historical windows without the idle polling delay.
            ;; Pagination, admission limits and the shared request budget remain unchanged.
            (put checkpoint :next_due_at (js-call (new globalThis.Date (+ (Date/parse now)
              (* (cond ((= kind "discovery") 30)
                ((< (Date/parse (nativeGet checkpoint "completed_until")) (- (Date/parse now) 2000)) 0)
                (t interval)) 1000))) :toISOString)))
          (await (funcall persist checkpoint events chats))
          (put status :state "ready") (put status :last_success_at now) (put status :native_error nil)
          (when (> (js-length events) 0) (put status :last_received_at now)))))))
      (setq pump (lambda ()
        (when (and application (not closed))
          ;; Independent message, fast-reaction and archive jobs use
          ;; independent checkpoints, while the HTTP transport owns app-wide quotas.
          (js-call (js-array "messages" "reaction-fast" "reaction-archive") :forEach (lambda (role)
            (unless (js-call running :has role)
              (let* ((reaction (not (= role "messages")))
                (rows (js-call (js-call (nativeGet (nativeGet application "store") "db") :query
                  (str "SELECT payload FROM poll_checkpoints WHERE connection_id=? AND conversation_key LIKE 'inbox:%' AND next_due_at<=? AND json_extract(payload,'$.kind')"
                    (cond ((= role "reaction-archive") "='reactions' AND conversation_key='inbox:reactions'")
                      (reaction "='reactions' AND conversation_key<>'inbox:reactions'") (t "<>'reactions'"))
                    " ORDER BY next_due_at,conversation_key LIMIT " (if reaction "3" "1"))) :all id (utcNow application)))
                (candidates (js-call rows :map (lambda (row)
                  (let ((item (JSON/parse (nativeGet row "payload"))))
                    (js-object :checkpoint item :due (or (js-call idle-until :get (nativeGet item "conversation_key"))
                      (+ (js-call (nativeGet host "clock") :monoNow)
                        (- (Date/parse (nativeGet item "next_due_at")) (Date/parse (utcNow application))))))))))
                (eligible (js-call candidates :filter (lambda (item)
                  (>= (js-call (nativeGet host "clock") :monoNow) (nativeGet item "due")))))
                (candidate (aref (js-call eligible :sort (lambda (a b) (- (nativeGet a "due") (nativeGet b "due")))) 0))
                (checkpoint (nativeGet candidate "checkpoint"))
                (saved (and checkpoint (JSON/stringify checkpoint))))
                (when (and checkpoint (or reaction (js-call limiter :acquire)))
                  (js-call running :set role t)
                  (let ((job (funcall turn checkpoint)))
                    (setq job (js-call job :catch (async (error)
                      (put status :state "degraded")
                      (when reaction
                        (put (nativeGet (nativeGet status "reaction_poll") "lanes")
                          (nativeGet checkpoint "reaction_lane" "archive") (js-object :state "degraded")))
                      (put status :native_error (js-object :code (nativeGet error "native_code"
                        (nativeGet (nativeGet error "details") "native_code" -1))
                        :missing_scopes (nativeGet error "missing_scopes"
                          (nativeGet (nativeGet error "details") "missing_scopes" (js-array)))))
                      (let* ((retry (JSON/parse saved))
                        (seconds (Math/max 5 (nativeGet error "retry_after_seconds" 0))))
                        (unless (Number/isFinite seconds) (setq seconds 5))
                        (put retry :native_error (nativeGet status "native_error"))
                        (put retry :next_due_at (js-call (new globalThis.Date (+ (Date/parse (utcNow application)) (* seconds 1000))) :toISOString))
                        (try (await (funcall persist retry (js-array) (js-array)))
                          (catch stale (setq closed t) (put status :state "blocked")))))))
                    (js-call job :finally (lambda ()
                      (unless reaction (js-call limiter :release))
                      (js-call running :delete role))))))))))))
      (js-object :pump pump :status (lambda ()
        (put (nativeGet status "reaction_poll") :observations (js-call observations :status))
        (let ((failed (when application (js-call (js-call (nativeGet (nativeGet application "store") "db") :query
          "SELECT json_extract(payload,'$.native_error') AS error FROM poll_checkpoints WHERE connection_id=? AND conversation_key LIKE 'inbox:%' AND json_extract(payload,'$.native_error') IS NOT NULL LIMIT 1") :get id))))
          (if failed (Object/assign (js-object) status (js-object :state
            (if (= (nativeGet status "state") "blocked") "blocked" "degraded")
            :native_error (JSON/parse (nativeGet failed "error")))) status)))
        :remember (lambda (event)
          (when (and (not user) (= (nativeGet event "event_kind") "message.created"))
            (let ((chat (nativeGet (nativeGet event "conversation") "native_chat_id")))
              (when chat (funcall ensure (str "inbox:chat:" chat)
                (if (= (nativeGet event "chat_type") "p2p") "p2p" "group")
                (nativeGet (funcall load "inbox:discovery") "activation_at") chat)))))
        :initialize (lambda (context)
          (setq application context closed false)
          (js-call observations :clear) (js-call idle-until :clear)
          (must (inTransaction context (lambda (tx)
            (must (ownerGuard context))
            (funcall ensure "inbox:reactions" "reactions" (utcNow context))
            (let* ((activation (nativeGet (funcall load "inbox:reactions") "activation_at"))
              (row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                "SELECT CAST(COALESCE(MAX(ingress_seq),0) AS TEXT) AS seq FROM events WHERE connection_id=?") :get id)))
              (funcall ensure "inbox:reaction-new" "reactions" activation nil
                (js-object :reaction_lane "new" :reaction_new_after_seq (nativeGet row "seq")))
              (funcall ensure "inbox:reaction-recent" "reactions" activation nil (js-object :reaction_lane "recent"))
              (funcall ensure "inbox:reaction-engaged" "reactions" activation nil (js-object :reaction_lane "engaged")))
            (js-call (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
              "SELECT native_message_id,json_extract(payload,'$.reaction.action_time') AS activity FROM events WHERE connection_id=? AND event_kind='message.reaction.added' AND tombstone=0 AND json_extract(payload,'$.identity_revision')=? ORDER BY ingress_seq DESC LIMIT 32")
              :all id (nativeGet config "identity_revision")) :forEach (lambda (row)
                (let ((activity (NativeNumber (nativeGet row "activity"))))
                  (when (and (Number/isSafeInteger activity) (>= activity 0))
                    (js-call observations :seed (nativeGet row "native_message_id") activity)))))
            (if user
              (js-call (js-array "p2p_chat" "group_chat") :forEach (lambda (kind)
                (funcall ensure (str "inbox:" kind) kind (utcNow context))))
              (progn (funcall ensure "inbox:discovery" "discovery" (utcNow context))
                (funcall known (nativeGet (funcall load "inbox:discovery") "activation_at"))))
            (success nil)))))
        :close (lambda () (setq closed t))
        :pendingWork (lambda () (nativeGet running "size")))))
  (export createLarkInboxPoller normalizeInboxMessage))
