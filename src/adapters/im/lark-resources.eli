(module dj.adapters.im.lark-resources
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeEncodeURIComponent)
  (import "../../core/errors.eli" success failure)
  (defun component (value)
    (unless (and (= (nativeTypeOf value) "string") (js-call (new globalThis.RegExp "^[A-Za-z0-9_-]{1,256}$") :test value))
      (throw (new globalThis.TypeError "invalid native resource component")))
    (nativeEncodeURIComponent value))
  (defasync requestResource (http command parameters context)
    (let* ((kind (nativeGet parameters "kind")) (token (component (nativeGet parameters "token")))
      (table (nativeGet parameters "table_id")) (record (nativeGet parameters "record_id"))
      (view (nativeGet parameters "view" "content"))
      (query (new globalThis.URLSearchParams)) (path nil) (method "GET") (body nil))
      (js-call query :set "user_id_type" "open_id")
      (js-call query :set "page_size" (str (nativeGet parameters "limit" 20)))
      (when (nativeGet parameters "page_token") (js-call query :set "page_token" (nativeGet parameters "page_token")))
      (cond ((= command "watch")
        (setq method "POST" path (str "/open-apis/drive/v1/files/" token "/subscribe"))
        (js-call query :set "file_type" kind))
        ((= command "resolve")
          (cond ((= kind "wiki") (setq path "/open-apis/wiki/v2/spaces/get_node") (js-call query :set "token" (nativeGet parameters "token")))
            ((= kind "docx") (setq path (str "/open-apis/docx/v1/documents/" token)))
            ((= kind "sheet") (setq path (str "/open-apis/sheets/v2/spreadsheets/" token "/metainfo")))
            ((= kind "bitable") (setq path (str "/open-apis/bitable/v1/apps/" token)))
            (t (throw (new globalThis.TypeError "unsupported resource kind")))))
        ((= view "comments")
          (setq path (str "/open-apis/drive/v1/files/" token "/comments"))
          (js-call query :set "file_type" kind) (js-call query :set "is_solved" "false"))
        ((= kind "wiki")
          (setq path (str "/open-apis/wiki/v2/spaces/" (component (nativeGet parameters "space_id")) "/nodes"))
          (js-call query :set "parent_node_token" (nativeGet parameters "token")))
        ((= kind "docx") (setq path (str "/open-apis/docx/v1/documents/" token "/raw_content")))
        ((= kind "sheet")
          (if (nativeGet parameters "range")
            (progn (setq path (str "/open-apis/sheets/v2/spreadsheets/" token "/values_batch_get"))
              (js-call query :set "ranges" (nativeGet parameters "range")))
            (setq path (str "/open-apis/sheets/v2/spreadsheets/" token "/metainfo"))))
        ((= kind "bitable")
          (setq path (str "/open-apis/bitable/v1/apps/" token "/tables"))
          (when table
            (setq path (str path "/" (component table)))
            (cond ((= view "fields") (setq path (str path "/fields")))
              (record (setq path (str path "/records/" (component record))))
              (t (setq path (str path "/records/search") method "POST" body (js-object))))))
        (t (throw (new globalThis.TypeError "unsupported resource request"))))
      (let* ((response (await (js-call http :request (str path "?" (js-call query :toString)) method body context)))
        (wire (nativeGet response "wire")))
        (if (and (= (nativeGet response "status") 200) (= (nativeGet wire "code") 0))
          (success (nativeGet wire "data" (js-object)))
          (success (js-object :native_error (js-object :code (nativeGet wire "code" -1) :http_status (nativeGet response "status")
            :message (nativeGet wire "msg" "native_api_unavailable")
            :missing_scopes (nativeGet (nativeGet wire "error") "permission_violations" (js-array))
            :required_events (if (= command "watch") (js-array "drive.file.bitable_record_changed_v1" "drive.file.edit_v1") (js-array)))))))))
  (export requestResource component))
