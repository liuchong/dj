(module dj.adapters.im.lark-event-inbox
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" utf8Bytes hashValue addSeconds)
  (import "../../core/errors.eli" success)
  (import "../../application/context.eli" utcNow inTransaction must)
  (import "../../application/write-batch.eli" enqueueWrite)
  (import "../../service/ownership.eli" ownerGuard)
  ;; The platform receipt is independent of enrichment, subscription matching and
  ;; Agent delivery. Only committed receipts may be acknowledged on the socket.
  (defun receiptEnvelope (native)
    (let ((header (nativeGet native "header")) (safe (js-object)))
      (js-call (js-array "event_id" "event_type" "app_id" "tenant_key" "create_time") :forEach
        (lambda (key) (when (object-has? header key) (put safe key (nativeGet header key)))))
      (js-object :header safe :event (nativeGet native "event" nil))))
  (defun receiptRetrySeconds (attempts)
    (Math/min 300 (* 2 (Math/pow 2 (Math/min 8 (Math/max 0 (1- attempts)))))))
  (defun receiptError (error)
    ;; Native messages may contain URLs, tokens or message bodies. Diagnostics
    ;; expose stable codes, never arbitrary exception text.
    (let ((code (nativeGet (nativeGet (nativeGet error "domain_result") "error") "code"))
      (native-code (nativeGet error "native_code")))
      (cond ((and (= (nativeTypeOf code) "string") (js-call code :match (new globalThis.RegExp "^[a-z_]{1,64}$"))) code)
        ((Number/isSafeInteger native-code) (str "native_" native-code))
        ((= (nativeGet error "name") "TypeError") "event_invalid")
        ((= (nativeGet error "name") "RangeError") "event_capacity_exceeded")
        (t "event_processing_failed"))))
  (defun createLarkEventInbox (config normalize remember)
    (let ((application nil) (running nil) (closed false) (last-error nil))
      (let ((db nil) (id nil) (revision nil) (guard nil) (write nil) (prune nil) (process nil))
      (setq db (lambda () (nativeGet (nativeGet application "store") "db")))
      (setq id (lambda () (nativeGet config "connection_id")))
      (setq revision (lambda () (nativeGet config "identity_revision")))
      (setq guard (lambda ()
          (must (ownerGuard application))
          (let ((current (js-call (nativeGet application "repository") :get "connections" (funcall id))))
            (unless (and current (not (nativeGet current "disabled"))
              (= (nativeGet current "identity_revision") (funcall revision)))
              (throw (new globalThis.Error "event source identity changed"))))))
      (setq write (lambda (mutate)
          (enqueueWrite application (lambda () (inTransaction application (lambda (tx) (funcall guard) (funcall mutate)))))))
      (setq prune (lambda ()
          (let ((now (utcNow application)))
            (js-call (js-call (funcall db) :query
              "DELETE FROM lark_event_receipts WHERE connection_id=? AND state IN ('processed','ignored') AND (received_at<? OR rowid IN (SELECT rowid FROM lark_event_receipts WHERE connection_id=? AND state IN ('processed','ignored') ORDER BY received_at DESC,rowid DESC LIMIT -1 OFFSET 1000))")
              :run (funcall id) (addSeconds now -604800) (funcall id)))))
      (setq process (lambda ()
          (async ()
            (let ((rows (js-call (js-call (funcall db) :query
              "SELECT event_id,event_type,payload,attempts FROM lark_event_receipts WHERE connection_id=? AND identity_revision=? AND state IN ('pending','retrying') AND next_attempt_at<=? ORDER BY next_attempt_at,received_at,event_id LIMIT 8")
              :all (funcall id) (funcall revision) (utcNow application))) (index 0))
              (while (and (not closed) (< index (js-length rows)))
                (let* ((row (aref rows index)) (key (nativeGet row "event_id"))
                  (attempts (1+ (nativeGet row "attempts"))) (started (utcNow application)))
                  (must (await (funcall write (lambda ()
                    (js-call (js-call (funcall db) :query "UPDATE lark_event_receipts SET state='retrying',attempts=?,next_attempt_at=? WHERE connection_id=? AND identity_revision=? AND event_id=?")
                      :run attempts (addSeconds started 30) (funcall id) (funcall revision) key) (success nil)))))
                  (try
                    (let* ((outcome (await (funcall normalize (JSON/parse (nativeGet row "payload")))))
                      (events (nativeGet outcome "events")) (reason (nativeGet outcome "reason" nil)))
                      (unless (and (Array/isArray events) (<= (js-length events) 128)
                        (or (> (js-length events) 0) (= (nativeTypeOf reason) "string")))
                        (throw (new globalThis.TypeError "event normalization needs events or an explicit ignore reason")))
                      (must (await (funcall write (lambda ()
                        (js-call events :forEach (lambda (event)
                          (put event :receive_transport "websocket")
                          (put event :source_identity_revision (funcall revision))
                          (let* ((resource (nativeGet event "resource"))
                            (existing (js-call (js-call (funcall db) :query "SELECT 1 FROM im_event_inbox WHERE connection_id=? AND source_key=?") :get (funcall id) (nativeGet event "source_key"))))
                            (unless existing
                              (when (>= (nativeGet (js-call (js-call (funcall db) :query "SELECT count(*) AS n FROM im_event_inbox WHERE connection_id=?") :get (funcall id)) "n") 1000)
                                (throw (new globalThis.RangeError "event inbox full")))
                              (js-call (js-call (funcall db) :query "INSERT INTO im_event_inbox(connection_id,source_key,payload) VALUES(?,?,?)")
                                :run (funcall id) (nativeGet event "source_key") (JSON/stringify event)))
                            (when resource (js-call (js-call (funcall db) :query "DELETE FROM resource_cache WHERE connection_id=? AND resource_token=?") :run (funcall id) (nativeGet resource "token"))))))
                        (js-call (js-call (funcall db) :query "UPDATE lark_event_receipts SET state=?,payload=NULL,raw_bytes=0,processed_at=?,next_attempt_at=?,last_error=?,normalized_count=? WHERE connection_id=? AND identity_revision=? AND event_id=?")
                          :run (if (> (js-length events) 0) "processed" "ignored") (utcNow application) (utcNow application) reason (js-length events) (funcall id) (funcall revision) key)
                        (success nil)))))
                      ;; In-memory poll hints may advance only after the inbox commit.
                      (when remember (js-call events :forEach remember)))
                    (catch error
                      (setq last-error (receiptError error))
                      (must (await (funcall write (lambda ()
                        (js-call (js-call (funcall db) :query "UPDATE lark_event_receipts SET state='retrying',next_attempt_at=?,last_error=? WHERE connection_id=? AND identity_revision=? AND event_id=? AND state='retrying'")
                          :run (addSeconds (utcNow application) (receiptRetrySeconds attempts)) last-error (funcall id) (funcall revision) key)
                        (success nil)))))))
                  (setq index (1+ index))))))))

      (js-object
        :stop (lambda () (setq closed t))
        :noteError (lambda (error) (setq last-error (receiptError error)))
        :initialize (lambda (context) (setq application context closed false))
        :accept (async (native)
          (let* ((envelope (receiptEnvelope native)) (header (nativeGet envelope "header"))
            (key (nativeGet header "event_id")) (type (nativeGet header "event_type"))
            (payload (JSON/stringify envelope)) (size (utf8Bytes payload)) (digest (hashValue envelope)))
            (unless (and (= (nativeTypeOf key) "string") (> (js-length key) 0) (<= (js-length key) 256)
              (= (nativeTypeOf type) "string") (> (js-length type) 0) (<= (js-length type) 256) (<= size 1048576))
              (throw (new globalThis.TypeError "invalid native event envelope")))
            (must (await (funcall write (lambda ()
              (let ((existing (js-call (js-call (funcall db) :query "SELECT payload_hash FROM lark_event_receipts WHERE connection_id=? AND identity_revision=? AND event_id=?") :get (funcall id) (funcall revision) key)))
                (if existing
                  (unless (= (nativeGet existing "payload_hash") digest) (throw (new globalThis.TypeError "native event identity collision")))
                  (progn
                    (funcall prune)
                    (let ((usage (js-call (js-call (funcall db) :query "SELECT count(*) AS n,COALESCE(sum(raw_bytes),0) AS bytes FROM lark_event_receipts WHERE connection_id=? AND state IN ('pending','retrying')") :get (funcall id))))
                      (when (or (>= (nativeGet usage "n") 1000) (> (+ (nativeGet usage "bytes") size) 67108864))
                        (throw (new globalThis.RangeError "native event inbox full"))))
                    (js-call (js-call (funcall db) :query "INSERT INTO lark_event_receipts(connection_id,identity_revision,event_id,event_type,received_at,next_attempt_at,state,payload,payload_hash,raw_bytes,attempts,normalized_count) VALUES(?,?,?,?,?,?,'pending',?,?,?,0,0)")
                      :run (funcall id) (funcall revision) key type (utcNow application) (utcNow application) payload digest size)))
                (success nil))))))))
        :pump (lambda ()
          (when (and application (not closed) (not running))
            (setq running (js-call (funcall (funcall process)) :catch (lambda (error) (setq last-error (receiptError error)))))
            (setq running (js-call running :finally (lambda () (setq running nil))))) nil)
        :status (lambda ()
          (when application
            (let* ((counts (js-call (js-call (funcall db) :query
              "SELECT count(*) AS retained,COALESCE(sum(state='pending'),0) AS pending,COALESCE(sum(state='retrying'),0) AS retrying,COALESCE(sum(state='processed'),0) AS processed,COALESCE(sum(state='ignored'),0) AS ignored,COALESCE(sum(raw_bytes),0) AS raw_bytes,min(CASE WHEN state IN ('pending','retrying') THEN received_at END) AS oldest_pending_at,max(received_at) AS last_received_at,max(CASE WHEN event_type='drive.notice.comment_add_v1' AND state='processed' AND identity_revision=? THEN processed_at END) AS last_document_notice_at,COALESCE(sum(identity_revision<>? AND state IN ('pending','retrying')),0) AS other_identity_pending FROM lark_event_receipts WHERE connection_id=?")
              :get (funcall revision) (funcall revision) (funcall id)))
              (latest (js-call (js-call (funcall db) :query "SELECT event_id,event_type,identity_revision,state,received_at,processed_at,attempts,next_attempt_at,last_error,normalized_count FROM lark_event_receipts WHERE connection_id=? ORDER BY received_at DESC,rowid DESC LIMIT 8") :all (funcall id))))
              (Object/assign counts (js-object :receipt_policy "persist_before_ack" :retention_seconds 604800
                :terminal_limit 1000 :pending_limit 1000 :raw_byte_limit 67108864 :last_error last-error :latest latest)))))
        :pendingWork (lambda () (if running 1 0))
        :close (async () (setq closed t) (when running (await running)))))))
  (export createLarkEventInbox receiptEnvelope receiptRetrySeconds receiptError))
