(module dj.adapters.im.lark-pins
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "../../core/types.eli" hashValue)
  (import "./lark-identities.eli" larkIdentities)
  (defun validPin (pin chat)
    (and (= (nativeGet pin "chat_id") chat)
      (= (nativeTypeOf (nativeGet pin "message_id")) "string") (> (js-length (nativeGet pin "message_id")) 0)
      (= (nativeTypeOf (nativeGet pin "operator_id")) "string") (> (js-length (nativeGet pin "operator_id")) 0)
      (js-call (js-array "open_id" "app_id") :includes (nativeGet pin "operator_id_type"))
      (= (nativeTypeOf (nativeGet pin "create_time")) "string")
      (Number/isSafeInteger (NativeNumber (nativeGet pin "create_time")))
      (>= (NativeNumber (nativeGet pin "create_time")) 0)))
  (defun pinKey (pin)
    (str "pin:" (hashValue (js-array (nativeGet pin "chat_id") (nativeGet pin "message_id")
      (nativeGet pin "operator_id_type") (nativeGet pin "operator_id") (nativeGet pin "create_time")))))
  (defun pinEvent (config pin original)
    (unless (and (validPin pin (nativeGet (nativeGet original "conversation") "native_chat_id"))
      (= (nativeGet pin "message_id") (nativeGet original "native_message_id"))
      (= (nativeGet config "connection_id") (nativeGet original "connection_id")))
      (throw (new globalThis.TypeError "invalid native conversation pin")))
    (let* ((human (= (nativeGet pin "operator_id_type") "open_id"))
      (actor (nativeGet pin "operator_id"))
      (event (Object/assign (js-object) original (js-object
        :source_key (pinKey pin) :event_kind "message.pinned" :source_revision "1"
        :source_time (js-call (new globalThis.Date (NativeNumber (nativeGet pin "create_time"))) :toISOString)
        :addressed_self false :addressed_bot false :receive_transport "poll"
        :pin (js-object :action_time (nativeGet pin "create_time") :message_source_time (nativeGet original "source_time" nil)
          :operator (js-object :id actor :kind (if human "human" "bot")
            :is_self (and (= human (= (nativeGet config "identity") "user"))
              (= actor (if human (nativeGet config "event_subject_id") (nativeGet config "event_app_id"))))
            :identities (if human (larkIdentities (nativeGet config "brand" "lark") (nativeGet config "event_app_id") nil
              (js-object :open_id actor)) (js-array))))))))
      ;; Original mentions/author remain context, never a fresh @ action.
      (Reflect/deleteProperty event "interaction") (Reflect/deleteProperty event "reaction") event))
  (defasync pollLarkPins (config application base checkpoint context normalize)
    (let* ((now (js-call (nativeGet (nativeGet application "ports") "clock") :utcNow))
      (db (nativeGet (nativeGet application "store") "db")) (id (nativeGet config "connection_id"))
      (chat (nativeGet checkpoint "chat_id")) (events (js-array))
      (pending (nativeGet checkpoint "pending_pins" (js-array))))
      (unless (nativeGet checkpoint "pin_window_end")
        (put checkpoint :pin_window_start (Math/max (Date/parse (nativeGet checkpoint "activation_at"))
          (- (Date/parse (nativeGet checkpoint "completed_until" (nativeGet checkpoint "activation_at"))) 120000)))
        (put checkpoint :pin_window_end (Math/max (1+ (nativeGet checkpoint "pin_window_start")) (Date/parse now))))
      (when (and (= (js-length pending) 0)
        (or (not (nativeGet checkpoint "pin_listed")) (nativeGet checkpoint "page_token")))
        (let* ((query (new globalThis.URLSearchParams (js-object :chat_id chat :page_size "50"
            :start_time (str (nativeGet checkpoint "pin_window_start")) :end_time (str (nativeGet checkpoint "pin_window_end")))))
          (seen (nativeGet checkpoint "seen_page_tokens" (js-array))))
          (when (nativeGet checkpoint "page_token") (js-call query :set "page_token" (nativeGet checkpoint "page_token")))
          (let* ((response (await (js-call base :nativeRequest (str "/open-apis/im/v1/pins?" (js-call query :toString)) "GET" nil context)))
            (wire (nativeGet response "wire")) (data (nativeGet wire "data"))
            (items (nativeGet data "items" (js-array))) (more (nativeGet data "has_more")) (token (nativeGet data "page_token")))
            (unless (and (= (nativeGet response "status") 200) (= (nativeGet wire "code") 0))
              (throw (js-object :native_code (nativeGet wire "code" -1) :retry_after_seconds (nativeGet response "retry_after" 5))))
            (unless (and (Array/isArray items) (<= (js-length items) 50)
              (js-call items :every (lambda (pin) (validPin pin chat)))
              (= (nativeTypeOf more) "boolean") (< (js-length seen) 1000)
              (or (not more) (and (= (nativeTypeOf token) "string") (> (js-length token) 0) (not (js-call seen :includes token)))))
              (throw (new globalThis.TypeError "invalid native pin page")))
            (setq pending (js-call items :filter (lambda (pin)
              (and (>= (NativeNumber (nativeGet pin "create_time")) (nativeGet checkpoint "pin_window_start"))
                (<= (NativeNumber (nativeGet pin "create_time")) (nativeGet checkpoint "pin_window_end"))))))
            (when more (js-call seen :push token))
            (put checkpoint :seen_page_tokens seen) (put checkpoint :page_token (if more token nil))
            (put checkpoint :pin_listed t))))
      ;; One old-message read per turn; large pin pages cannot monopolize intake.
      (when (> (js-length pending) 0)
        (let* ((pin (aref pending 0)) (key (pinKey pin)) (original nil)
          (exists (or (js-call (js-call db :query "SELECT 1 FROM events WHERE connection_id=? AND source_key=?") :get id key)
            (js-call (js-call db :query "SELECT 1 FROM im_event_inbox WHERE connection_id=? AND source_key=?") :get id key))))
          (unless exists
            (let ((row (js-call (js-call db :query
              "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind='message.created' AND tombstone=0 AND body_expires_at>? AND json_extract(payload,'$.identity_revision')=? LIMIT 1")
              :get id (nativeGet pin "message_id") now (nativeGet config "identity_revision"))))
              (when row (setq original (JSON/parse (nativeGet row "payload"))))))
          (unless (or exists original)
            (let* ((response (await (js-call base :history (js-object :message_id (nativeGet pin "message_id")) context)))
              (messages (nativeGet (nativeGet response "data") "messages"))
              (message (and (nativeGet response "ok") (Array/isArray messages) (= (js-length messages) 1) (aref messages 0))))
              (unless (and message (= (nativeGet message "message_id") (nativeGet pin "message_id"))
                (= (nativeGet message "chat_id") chat)) (throw (new globalThis.TypeError "pin message unavailable")))
              (unless (nativeGet message "deleted")
                (setq original (funcall normalize config (js-object :type "im.message.receive_v1"
                  :message_id (nativeGet message "message_id") :chat_id chat :chat_type (nativeGet checkpoint "pin_chat_type" "group")
                  :content (nativeGet message "content") :create_time (nativeGet message "create_time")
                  :sender_id (nativeGet (nativeGet message "sender") "id") :sender_type (nativeGet (nativeGet message "sender") "sender_type")
                  :thread_id (nativeGet message "thread_id") :root_id (nativeGet message "root_id") :reply_to (nativeGet message "parent_id")
                  :mentions (nativeGet message "mentions" (js-array))))))))
          (when original (js-call events :push (pinEvent config pin original)))
          (js-call pending :shift)))
      (put checkpoint :pending_pins pending) (put checkpoint :last_success_at now) (put checkpoint :native_error nil)
      (put checkpoint :next_due_at now)
      (when (and (= (js-length pending) 0) (not (nativeGet checkpoint "page_token")))
        (put checkpoint :completed_until (js-call (new globalThis.Date (nativeGet checkpoint "pin_window_end")) :toISOString))
        (put checkpoint :pin_window_end nil) (put checkpoint :pin_listed false) (put checkpoint :seen_page_tokens (js-array))
        (put checkpoint :next_due_at (js-call (new globalThis.Date (+ (Date/parse now) (* 1000 (nativeGet config "pin_poll_seconds" 15)))) :toISOString)))
      events))
  (export pinEvent pollLarkPins))
