(module dj.adapters.im.lark-edits
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "../../core/types.eli" addSeconds)
  (import "../../application/context.eli" utcNow nativeCallContext)
  (import "../../connections/interactions.eli" resolveMessageInteraction)
  (defconst editWindowSeconds 7200)
  (defconst editPollSeconds 15)
  (defconst editBatchSize 20)

  (defun permanentMessageRefusal (error)
    (let* ((details (nativeGet error "details"))
           (status (nativeGet details "http_status")))
      (and (js-call (js-array 200 400 403 404) :includes status)
           (= (nativeGet details "reason") "native_api_rejected")
           (= (js-length (nativeGet details "missing_scopes" (js-array))) 0)
           (not (js-call (js-array 99991661 99991663 99991664 99991668 99991672)
                  :includes (nativeGet details "native_code"))))))

  (defun findOriginalMessage (db connection id revision)
    (let ((stored (js-call (js-call db :query
            "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind='message.created' AND tombstone=0 AND json_extract(payload,'$.identity_revision')=? ORDER BY ingress_seq DESC LIMIT 1")
            :get connection id revision)))
      (if stored
        (JSON/parse (nativeGet stored "payload"))
        (let ((pending (js-call (js-call db :query
                "SELECT payload FROM im_event_inbox WHERE connection_id=? AND source_key=?")
                :get connection (str id ":created"))))
          (when pending
            (let ((parsed (JSON/parse (nativeGet pending "payload"))))
              (when (= (nativeGet parsed "source_identity_revision") revision) parsed)))))))

  (defun editTime (record)
    (or (nativeGet record "native_message_update_time") (Date/parse (nativeGet record "source_time"))))

  (defun previousEdit (db connection original)
    (let* ((id (nativeGet original "native_message_id"))
           (prefix (str id ":edited:"))
           (stored (js-call (js-call db :query
             "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind='message.edited' ORDER BY ingress_seq DESC LIMIT 1") :get connection id))
           (pending (js-call (js-call db :query
             "SELECT payload FROM im_event_inbox WHERE connection_id=? AND source_key>=? AND source_key<? ORDER BY source_key DESC LIMIT 1")
             :get connection prefix (str prefix "~")))
           (latest (if stored (JSON/parse (nativeGet stored "payload")) original)))
      (when pending
        (let ((event (JSON/parse (nativeGet pending "payload"))))
          (when (> (editTime event) (editTime latest)) (setq latest event))))
      latest))

  (defun normalizeEdit (original previous message activation normalize)
    (let ((stamp (NativeNumber (nativeGet message "update_time")))
          (created (NativeNumber (nativeGet message "create_time"))))
      (when (and (= (nativeGet message "updated") t)
        (not (nativeGet message "deleted"))
        (Number/isSafeInteger stamp)
        (<= stamp 8640000000000000)
        (> stamp created) (>= stamp activation) (> stamp (editTime previous))
        (= created (Date/parse (nativeGet original "source_time")))
        (= (nativeGet message "chat_id") (nativeGet (nativeGet original "conversation") "native_chat_id"))
        (= (nativeGet (nativeGet message "sender") "id") (nativeGet (nativeGet original "sender") "id")))
        (let* ((native-mentions (nativeGet message "mentions"))
               (all (if (Array/isArray native-mentions) native-mentions (js-array)))
               (known-ids (new globalThis.Set
                  (js-call (nativeGet previous "native_message_mentions" (nativeGet previous "mentions" (js-array)))
                    :map (lambda (mention) (nativeGet mention "id")))))
               (added (js-call all :filter
                 (lambda (mention) (not (js-call known-ids :has (nativeGet mention "id"))))))
               (original-address (nativeGet original "conversation"))
               (event (funcall normalize (Object/assign (js-object) message (js-object
                 :mentions added :root_id (nativeGet original "root_message_id")
                 :parent_id (nativeGet (nativeGet original "reply_to") "id")
                 :thread_id (nativeGet original-address "native_thread_id")))
                 (nativeGet original "chat_type"))))
          (put event :event_kind "message.edited")
          (put event :source_key (str (nativeGet original "native_message_id") ":edited:" stamp))
          (put event :source_revision (str stamp))
          (put event :source_time (js-call (new globalThis.Date stamp) :toISOString))
          (put event :sender (nativeGet original "sender"))
          (when (nativeGet original "interaction")
            (put event :interaction (nativeGet original "interaction")))
          (put event :native_message_mentions all)
          event))))

  (defun rememberPage (checkpoint rows more now sweep)
    (if more
      (let ((last (aref rows (1- (js-length rows)))))
        (put checkpoint :edit_after_at (nativeGet last "received_at"))
        (put checkpoint :edit_after_seq (nativeGet last "seq"))
        (put checkpoint :edit_sweep_at sweep)
        (put checkpoint :next_due_at now))
      (progn
        (Reflect/deleteProperty checkpoint "edit_after_at")
        (Reflect/deleteProperty checkpoint "edit_after_seq")
        (Reflect/deleteProperty checkpoint "edit_sweep_at")
        (Reflect/deleteProperty checkpoint "edit_retry_remaining")
        (put checkpoint :next_due_at (addSeconds sweep editPollSeconds)))))
  (defasync pollLarkEdits (config application base checkpoint context normalize)
    (let* ((now (utcNow application)) (from (addSeconds now (- editWindowSeconds)))
           (sweep (nativeGet checkpoint "edit_sweep_at" now))
           (activation-at (nativeGet checkpoint "activation_at"))
           (activation (Date/parse activation-at))
           (connection (nativeGet config "connection_id"))
           (revision (nativeGet checkpoint "identity_revision"))
           (db (nativeGet (nativeGet application "store") "db"))
           (after-at (nativeGet checkpoint "edit_after_at" sweep))
           (after-seq (nativeGet checkpoint "edit_after_seq" "9223372036854775807"))
           (retry (nativeGet checkpoint "edit_retry_remaining" 0))
           (size (if (> retry 0) 1 editBatchSize))
           (page (js-call (js-call db :query
             "SELECT native_message_id,received_at,CAST(ingress_seq AS TEXT) AS seq,payload FROM events WHERE connection_id=? AND event_kind='message.created' AND tombstone=0 AND received_at>=? AND (received_at,ingress_seq)<(?,CAST(? AS INTEGER)) AND json_extract(payload,'$.identity_revision')=? AND json_extract(payload,'$.source_time')>=? AND json_extract(payload,'$.message_source.msg_type') IN ('text','post') ORDER BY received_at DESC,ingress_seq DESC LIMIT ?")
             :all connection from after-at after-seq revision activation-at (1+ size)))
           (more (> (js-length page) size)) (rows (js-call page :slice 0 size))
           (events (js-array)) (refine false) (problem nil))
      (when (> (js-length rows) 0)
        (let* ((keys (js-call rows :map (lambda (row) (nativeGet row "native_message_id"))))
               (response (await (js-call base :history (js-object :message_ids keys) context)))
               (error (nativeGet response "error"))
               (details (nativeGet error "details"))
               (by-id (new globalThis.Map)))
          (if (nativeGet response "ok")
            (progn
              (js-call (nativeGet (nativeGet response "data") "messages") :forEach
                (lambda (message) (js-call by-id :set (nativeGet message "message_id") message)))
              (js-call rows :forEach (lambda (row)
                (let* ((original (JSON/parse (nativeGet row "payload")))
                       (message (js-call by-id :get (nativeGet row "native_message_id")))
                       (edit (and message (normalizeEdit original (previousEdit db connection original) message activation normalize))))
                  (when edit (js-call events :push edit))))))
            ;; Split an explicitly refused batch without launching extra requests in this turn.
            (if (permanentMessageRefusal error)
              (progn
                (setq problem (js-object :code (nativeGet details "native_code" -1) :missing_scopes (js-array)))
                (when (> (js-length rows) 1)
                  (setq refine t)
                  (put checkpoint :edit_sweep_at sweep)
                  (put checkpoint :edit_retry_remaining (js-length rows))
                  (put checkpoint :next_due_at now)))
              (throw error)))))
      (unless refine
        (when (> retry 0) (put checkpoint :edit_retry_remaining (1- retry)))
        (rememberPage checkpoint rows more now sweep))
      (put checkpoint :last_success_at (if problem (nativeGet checkpoint "last_success_at") now))
      (put checkpoint :native_error problem)
      events))

  (defasync resolveLarkMessageUpdate (config wire application base normalize-inbox normalize-message)
    (let* ((event (nativeGet wire "event"))
           (id (or (nativeGet event "message_id") (nativeGet (nativeGet event "message") "message_id"))))
      (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0) (<= (js-length id) 256))
        (throw (new globalThis.TypeError "invalid native message update event")))
      (let* ((db (nativeGet (nativeGet application "store") "db"))
             (connection (nativeGet config "connection_id"))
             (revision (nativeGet config "identity_revision"))
             (original (findOriginalMessage db connection id revision)))
        (if (not original)
          (js-object :events (js-array) :reason "edited_message_unknown")
          (let ((response (await (js-call base :history (js-object :message_ids (js-array id)) (nativeCallContext application)))))
            (if (not (nativeGet response "ok"))
              (let ((error (nativeGet response "error")))
                (if (permanentMessageRefusal error)
                  (js-object :events (js-array) :reason "edited_message_unavailable")
                  (throw error)))
              (let ((message (js-call (nativeGet (nativeGet response "data") "messages" (js-array)) :find
                      (lambda (item) (= (nativeGet item "message_id") id)))))
                (if (or (not message) (nativeGet message "deleted"))
                  (js-object :events (js-array) :reason "edited_message_unavailable")
                  (let ((edit (normalizeEdit original (previousEdit db connection original) message 0
                          (lambda (item chat-type) (funcall normalize-inbox config item chat-type normalize-message)))))
                    (if (not edit)
                      (js-object :events (js-array) :reason "edit_already_recorded")
                      (js-object :events (js-array (await (resolveMessageInteraction config edit application base normalize-message)))
                        :reason nil)))))))))))

  (export pollLarkEdits resolveLarkMessageUpdate editWindowSeconds editPollSeconds))
