(module dj.adapters.im.lark-reaction-cache
  (import "../../core/native.eli" nativeGet)
  ;; Disposable observations, not events or tasks. Update only after durable inbox
  ;; commit; eviction/restart only makes us query again, never acknowledges input.
  (defun createReactionObservationCache (clock policy)
    (let ((rows (new globalThis.Map)) (claims (new globalThis.Set)) (saved 0) (unchanged 0)
      (now (lambda () (Date/parse (js-call clock :utcNow)))))
      (js-object
        :clear (lambda () (js-call rows :clear) (js-call claims :clear) (setq saved 0 unchanged 0))
        :claim (lambda (message)
          (unless (js-call claims :has message) (js-call claims :add message) t))
        :release (lambda (message) (js-call claims :delete message))
        :drop (lambda (message) (js-call rows :delete message))
        :seed (lambda (message activity)
          (unless (js-call rows :has message)
            (js-call rows :set message (js-object :message_id message :signature nil :checked_at nil
              :has_reactions t :activity (Math/min activity (funcall now))))))
        :fresh (lambda (message)
          (let* ((row (js-call rows :get message)) (stamp (nativeGet row "checked_at"))
            (age (and stamp (- (funcall now) stamp))))
            (when (and row (not (nil? stamp)) (>= age 0) (< age 2000))
              (setq saved (1+ saved)) t)))
        :unchanged (lambda (message signature)
          (let ((same (and signature (= signature (nativeGet (js-call rows :get message) "signature")))))
            (when same (setq unchanged (1+ unchanged))) same))
        :record (lambda (observation)
          (let* ((message (nativeGet observation "message_id"))
            (old (js-call rows :get message)) (stamp (funcall now))
            (changed (and old (or
              (not (= (nativeGet old "has_reactions") (nativeGet observation "has_reactions")))
              (and (nativeGet old "signature") (nativeGet observation "signature")
                (not (= (nativeGet old "signature") (nativeGet observation "signature")))))))
            (activity (if changed stamp (Math/min stamp (Math/max (nativeGet observation "activity")
              (nativeGet old "activity" 0)))))
            (row (Object/assign (js-object) observation (js-object :checked_at stamp :activity activity
              :interest_until (if changed (+ stamp 60000) (nativeGet old "interest_until" 0))))))
            (js-call rows :delete message) (js-call rows :set message row)
            (while (> (nativeGet rows "size") 512)
              (js-call rows :delete (nativeGet (js-call (js-call rows :keys) :next) "value")))))
        :nextActive (lambda ()
          (let* ((stamp (funcall now))
            (candidates (js-call (Array/from (js-call rows :values)) :filter
              (lambda (row) (or (nativeGet row "has_reactions") (> (nativeGet row "interest_until" 0) stamp))))))
            (js-call candidates :sort (lambda (a b) (- (nativeGet b "activity") (nativeGet a "activity"))))
            (setq candidates (js-call candidates :slice 0 (nativeGet policy "engaged_messages")))
            (js-call candidates :sort (lambda (a b) (- (or (nativeGet a "checked_at") 0) (or (nativeGet b "checked_at") 0))))
            (let ((row (js-call candidates :find (lambda (item)
              (let* ((checked (nativeGet item "checked_at"))
                (interval (if (and (>= stamp (nativeGet item "activity"))
                    (< (- stamp (nativeGet item "activity")) 60000))
                  (nativeGet policy "recent_poll_seconds") (nativeGet policy "engaged_poll_seconds"))))
                (or (nil? checked) (< stamp checked) (>= (- stamp checked) (* interval 1000))))))))
              (nativeGet row "message_id" nil))))
        :status (lambda () (js-object :entries (nativeGet rows "size") :max_entries 512
          :in_flight (nativeGet claims "size") :saved_reads saved :unchanged_pages unchanged)))))
  (export createReactionObservationCache))
