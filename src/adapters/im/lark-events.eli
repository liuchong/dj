(module dj.adapters.im.lark-events
  (import "./lark-resource-events.eli" resourceEvents normalizeResourceEvents)
  (import "./lark-reactions.eli" resolveLarkReaction)
  (import "./lark-event-inbox.eli" createLarkEventInbox)
  (import "../../connections/interactions.eli" resolveMessageInteraction)
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber nativeSetTimeout nativeClearTimeout nativeSetInterval nativeClearInterval)
  (import "../../core/types.eli" utf8Bytes)
  (import "../../core/errors.eli" success)
  (import "../../application/context.eli" inTransaction)
  (import "../../application/write-batch.eli" enqueueWrite)
  (import "../../service/ownership.eli" ownerGuard)
  (import "./lark.eli" createLarkPort)
  (import "../../../packages/lark/src/wire.eli" decodeLarkFrame encodeLarkFrame)
  (import "./telegram.eli" readJson)
  (import "./lark-identities.eli" larkIdentities)
  (import "./lark-inbox.eli" createLarkInboxPoller)
  (defun flattenLarkEvent (wire)
    (let* ((event (nativeGet wire "event")) (message (nativeGet event "message"))
           (sender (nativeGet event "sender")) (type (nativeGet message "message_type"))
           (content (nativeGet message "content" ""))
           (text (if (= type "text") (nativeGet (JSON/parse content) "text") (str "[" type "] " content))))
      (js-object :type (nativeGet (nativeGet wire "header") "event_type") :message_id (nativeGet message "message_id")
        :chat_id (nativeGet message "chat_id") :chat_type (nativeGet message "chat_type")
        :content text :create_time (nativeGet message "create_time")
        :sender_native_ids (nativeGet sender "sender_id")
        :sender_tenant_key (nativeGet sender "tenant_key" (nativeGet (nativeGet wire "header") "tenant_key"))
        :sender_app_id (nativeGet (nativeGet wire "header") "app_id")
        :sender_id (nativeGet (nativeGet sender "sender_id") "open_id") :sender_type (nativeGet sender "sender_type")
        :root_id (nativeGet message "root_id" nil) :thread_id (nativeGet message "thread_id" nil) :reply_to (nativeGet message "parent_id" nil)
        :mentions (js-call (nativeGet message "mentions" (js-array)) :map (lambda (m)
          (js-object :id (nativeGet (nativeGet m "id") "open_id") :name (nativeGet m "name" "")))))))
  (defun normalizeLarkEvent (config wire)
    (let* ((id (nativeGet wire "message_id")) (chat (nativeGet wire "chat_id"))
           (raw-time (nativeGet wire "create_time"))
           (stamp (if (= (nativeTypeOf raw-time) "string") (NativeNumber raw-time) nil))
           (mentions (nativeGet wire "mentions" (js-array)))
           (self (nativeGet config "event_subject_id"))
           (addressed (and self (js-call mentions :some (lambda (mention) (= (nativeGet mention "id") self))))))
      (unless (and (= (nativeGet wire "type") "im.message.receive_v1")
        (= (nativeTypeOf id) "string") (> (js-length id) 0)
        (= (nativeTypeOf chat) "string") (> (js-length chat) 0)
        (= (nativeTypeOf (nativeGet wire "sender_id")) "string")
        (= (nativeTypeOf (nativeGet wire "content")) "string")
        (Number/isSafeInteger stamp) (>= stamp 0) (Array/isArray mentions))
        (throw (new globalThis.TypeError "invalid native message event")))
      (when (and (nativeGet wire "sender_app_id") (nativeGet config "event_app_id")
        (not (= (nativeGet wire "sender_app_id") (nativeGet config "event_app_id"))))
        (throw (new globalThis.TypeError "native event app identity mismatch")))
      (let ((event (js-object :connection_id (nativeGet config "connection_id") :source_key (str id ":created")
        :native_message_id id :event_kind "message.created" :source_revision "1"
        :conversation (js-object :connection_id (nativeGet config "connection_id") :platform "lark"
          :tenant_ref (nativeGet config "tenant_ref") :account_ref (nativeGet config "account_ref")
          :native_chat_id chat :native_thread_id (nativeGet wire "thread_id" nil)
          :thread_kind (if (nativeGet wire "thread_id") "thread" "main"))
        :sender (js-object :id (nativeGet wire "sender_id")
          :identities (larkIdentities (nativeGet config "brand" "lark") (nativeGet config "event_app_id")
            (nativeGet wire "sender_tenant_key") (nativeGet wire "sender_native_ids" (js-object :open_id (nativeGet wire "sender_id"))))
          :kind (if (= (nativeGet wire "sender_type") "user") "human" "bot"))
        :source_time (js-call (new globalThis.Date stamp) :toISOString)
        :content (js-object :kind "text" :text (nativeGet wire "content") :truncated false)
        :mentions (js-call mentions :map (lambda (mention) (js-object :id (nativeGet mention "id") :name (nativeGet mention "name" ""))))
        :attachments (js-array) :addressed_self (if addressed t false) :chat_type (nativeGet wire "chat_type" "unknown"))))
        (when (= (nativeGet config "identity") "bot") (put event :addressed_bot (if addressed t false)))
        (when (nativeGet wire "root_id") (put event :root_message_id (nativeGet wire "root_id")))
        (when (nativeGet wire "reply_to") (put event :reply_to (js-object :id (nativeGet wire "reply_to"))))
        event)))
  (defun createLarkEventPort (config host)
    (let* ((base (createLarkPort config host))
           (poller (createLarkInboxPoller config host base normalizeLarkEvent))
           (application nil) (inbox nil) (socket nil) (running nil) (closed false)
           (ready false) (state "connecting") (reason "event_connecting") (permissions (js-object))
           (last-received nil) (last-reaction nil) (notice-checked false) (notice-status (js-object :state "not_requested")) (timer nil) (heartbeat nil) (request-abort nil) (stop nil) (loop nil)
           (signal nil) (capabilities (Object/assign (js-object) (nativeGet base "capabilities")
             (js-object :replay "bounded_unacknowledged" :ack_control t :receive_events "supported"))))
      (setq inbox (createLarkEventInbox config (async (native)
        (let* ((header (nativeGet native "header")) (type (nativeGet header "event_type"))
          (events (js-array)) (ignored nil))
          (cond
            ((not (= (nativeGet header "app_id") (nativeGet config "event_app_id"))) (setq ignored "app_identity_mismatch"))
            ((= type "im.message.receive_v1")
              (setq events (js-array (await (resolveMessageInteraction config (normalizeLarkEvent config (flattenLarkEvent native)) application base normalizeLarkEvent)))))
            ((= type "im.message.reaction.created_v1")
              (setq events (js-array (await (resolveLarkReaction config native application base normalizeLarkEvent)))))
            ((js-call resourceEvents :includes type)
              (setq events (normalizeResourceEvents config native))
              (if (= (js-length events) 0)
                (setq ignored "recipient_not_current_user")
                (unless (= type "drive.notice.comment_add_v1")
                  (setq events (js-call events :filter (lambda (event)
                    (js-call (js-call (nativeGet (nativeGet application "store") "db") :query
                      "SELECT 1 AS found FROM resource_watches WHERE connection_id=? AND identity_revision=? AND resource_token=? AND state IN ('subscribed','native_unknown') LIMIT 1")
                      :get (nativeGet config "connection_id") (nativeGet config "identity_revision") (nativeGet (nativeGet event "resource") "token")))))
                  (when (= (js-length events) 0) (setq ignored "resource_not_watched")))))
            (t (setq ignored "event_type_unsupported")))
          (js-object :events events :reason ignored)))
        (lambda (event) (when poller (js-call poller :remember event)))))
      (setq stop (lambda ()
        (setq closed t ready false state "stopped" reason "event_stopped")
        (js-call inbox :stop)
        (when poller (js-call poller :close))
        (when request-abort (js-call request-abort :abort))
        (when socket (js-call socket :close 1000 "service stopping"))))
      (setq loop (async ()
        (while (not closed)
          (try
            (setq ready false state "connecting" reason "event_connecting" request-abort (new globalThis.AbortController))
            (let* ((credential (await (js-call (nativeGet host "credentials") :resolve (nativeGet config "credential_ref"))))
                   (identity-check (unless (= (nativeGet credential "app_id") (nativeGet config "event_app_id"))
                     (setq closed t state "blocked" reason "event_identity_changed")
                     (throw (new globalThis.Error "application identity mismatch"))))
                   (notice-check (when (and (= (nativeGet config "identity") "user") (not notice-checked))
              (setq notice-checked t)
              (setq notice-status (if (nativeGet (nativeGet config "user_identity") "open_id")
                (await (js-call base :userNotices (js-object :abort_signal signal
                  :deadline (+ (js-call (nativeGet host "clock") :monoNow) 45000))))
                (js-object :state "blocked" :reason "user_identity_missing")))))
                   (start-timeout (setq timer (nativeSetTimeout (lambda () (when request-abort (js-call request-abort :abort))) 15000)))
                   (domain (if (= (nativeGet config "brand") "feishu") "https://open.feishu.cn" "https://open.larksuite.com"))
                   (response (await (js-call (nativeGet host "http") :fetch (str domain "/callback/ws/endpoint")
                     (js-object :method "POST" :redirect "error" :signal (nativeGet request-abort "signal")
                       :headers (js-object :content-type "application/json")
                       :body (JSON/stringify (js-object :AppID (nativeGet credential "app_id") :AppSecret (nativeGet credential "app_secret")))))))
                   (wire (await (readJson response 1048576))))
              (nativeClearTimeout timer) (setq timer nil request-abort nil)
              (unless (= (nativeGet credential "app_id") (nativeGet config "event_app_id"))
                (setq closed t state "blocked" reason "event_identity_changed")
                (throw (new globalThis.Error "application identity mismatch")))
              (unless (= (nativeGet wire "code") 0)
                (setq permissions (js-object :native_code (nativeGet wire "code") :required_events (js-array "im.message.receive_v1")))
                (setq reason "event_api_rejected")
                (when (js-call (js-array 403 514) :includes (nativeGet wire "code")) (setq closed t state "blocked"))
                (throw (new globalThis.Error "WebSocket endpoint unavailable")))
              (let* ((data (nativeGet wire "data")) (url (new globalThis.URL (nativeGet data "URL")))
                     (suffix (if (= (nativeGet config "brand") "feishu") ".feishu.cn" ".larksuite.com"))
                     (service (NativeNumber (js-call (nativeGet url "searchParams") :get "service_id")))
                     (interval (* 1000 (nativeGet (nativeGet data "ClientConfig") "PingInterval" 90)))
                     (fragments (new globalThis.Map)) (chain (Promise/resolve)) (queued 0) (queued-bytes 0)
                     (last-input (Date/now)) (next-ping 0) (finished nil))
                (unless (and (= (nativeGet url "protocol") "wss:")
                  (js-call (nativeGet url "hostname") :endsWith suffix)
                  (= (nativeGet url "username") "") (= (nativeGet url "password") "")
                  (js-call (js-array "" "443") :includes (nativeGet url "port")) (Number/isSafeInteger service)
                  (> interval 0) (<= interval 3600000))
                  (throw (new globalThis.TypeError "invalid official WebSocket endpoint")))
                (setq socket (new globalThis.WebSocket (js-call url :toString)))
                (put socket :binaryType "arraybuffer")
                (setq finished (new globalThis.Promise (lambda (resolve)
                  (js-call socket :addEventListener "close" (lambda () (funcall resolve nil)) (js-object :once t)))))
                (js-call socket :addEventListener "open" (lambda () (setq ready t state "connected" reason nil)))
                (js-call socket :addEventListener "error" (lambda () (setq reason "event_network_error") (js-call socket :close)))
                (js-call socket :addEventListener "message" (lambda (message)
                  (let ((bytes (Buffer/from (nativeGet message "data"))) (arrived (Date/now)))
                    (when (or (>= queued 32) (> (+ queued-bytes (nativeGet bytes "length")) 4194304))
                      (setq reason "event_backpressure") (js-call socket :close 1013 "backpressure"))
                    (when (< (nativeGet socket "readyState") 2)
                      (setq queued (1+ queued) queued-bytes (+ queued-bytes (nativeGet bytes "length")))
                      (setq chain (js-call chain :then (async ()
                        (let* ((frame (decodeLarkFrame bytes)) (headers (js-object)))
                          (setq last-input (Date/now))
                          (js-call (nativeGet frame "headers") :forEach (lambda (h) (put headers (nativeGet h "key") (nativeGet h "value"))))
                          (when (and (= (nativeGet frame "method") 1) (= (nativeGet headers "type") "event"))
                            (let* ((count (NativeNumber (nativeGet headers "sum" "1"))) (part (NativeNumber (nativeGet headers "seq" "0")))
                                   (id (nativeGet headers "message_id")) (entry (js-call fragments :get id)))
                              (unless (and (= (nativeTypeOf id) "string") (Number/isSafeInteger count) (> count 0) (<= count 128)
                                (Number/isSafeInteger part) (>= part 0) (< part count)) (throw (new globalThis.TypeError "invalid fragment metadata")))
                              (js-call fragments :forEach (lambda (value key)
                                (when (> (- (Date/now) (nativeGet value "at")) 60000) (js-call fragments :delete key))))
                              (unless entry
                                (when (>= (nativeGet fragments "size") 32) (throw (new globalThis.RangeError "fragment capacity")))
                                (setq entry (js-object :count count :parts (new globalThis.Map) :bytes 0 :at (Date/now)))
                                (js-call fragments :set id entry))
                              (unless (= (nativeGet entry "count") count) (throw (new globalThis.TypeError "fragment count changed")))
                              (unless (js-call (nativeGet entry "parts") :has part)
                                (put entry :bytes (+ (nativeGet entry "bytes") (nativeGet (nativeGet frame "payload") "length"))))
                              (when (> (nativeGet entry "bytes") 1048576) (throw (new globalThis.RangeError "event exceeds frame budget")))
                              (js-call (nativeGet entry "parts") :set part (nativeGet frame "payload"))
                              (when (= (nativeGet (nativeGet entry "parts") "size") count)
                                (let ((parts (js-array)) (i 0))
                                  (while (< i count) (js-call parts :push (js-call (nativeGet entry "parts") :get i)) (setq i (1+ i)))
                                  (let ((native (JSON/parse (js-call (Buffer/concat parts) :toString "utf8"))))
                                    (await (js-call inbox :accept native))
                                    (setq last-received (js-call (new globalThis.Date) :toISOString))
                                    (when (= (nativeGet (nativeGet native "header") "event_type") "im.message.reaction.created_v1")
                                      (setq last-reaction last-received))
                                    ;; No HTTP enrichment or business processing precedes this
                                    ;; acknowledgement. A lost ACK is safe to repeat by event_id.
                                    (when (> (- (Date/now) arrived) 2500)
                                      (throw (new globalThis.Error "event receipt acknowledgement deadline")))
                                    (when (= (nativeGet socket "readyState") 1)
                                      (js-call socket :send (encodeLarkFrame (Object/assign (js-object) frame
                                        (js-object :payload (Buffer/from "{\"code\":200}" "utf8"))))))
                                    (js-call inbox :pump)))
                                (js-call fragments :delete id))))))
                        )))
                      (setq chain (js-call chain :catch (lambda (error)
                          (js-call inbox :noteError error)
                          (setq reason "event_receipt_failed") (when socket (js-call socket :close 1011 "event processing failed")))))
                      (setq chain (js-call chain :finally (lambda ()
                        (setq queued (1- queued) queued-bytes (- queued-bytes (nativeGet bytes "length")))))))))
                (setq heartbeat (nativeSetInterval (lambda ()
                  (when (and socket (= (nativeGet socket "readyState") 1))
                    (when (> (- (Date/now) last-input) (+ (* interval 2) 15000))
                      (setq reason "event_heartbeat_timeout") (js-call socket :close 1001 "heartbeat timeout"))
                    (when (>= (Date/now) next-ping)
                      (js-call socket :send (encodeLarkFrame (js-object :service service :method 0
                        :headers (js-array (js-object :key "type" :value "ping")))))
                      (setq next-ping (+ (Date/now) interval))))) 1000))
                (await finished) (await chain)))
            (catch failed (unless closed (unless reason (setq reason "event_api_unavailable")) (setq state "disconnected")))
            (finally
              (when timer (nativeClearTimeout timer)) (setq timer nil)
              (when heartbeat (nativeClearInterval heartbeat)) (setq heartbeat nil)
              (when socket (js-call socket :close)) (setq socket nil ready false)))
          (unless closed (await (new globalThis.Promise (lambda (resolve) (setq timer (nativeSetTimeout resolve 3000)))))))))
      (Object/assign (js-object) base (js-object :capabilities capabilities :pollDueSources nil
        :initialize (lambda (context)
          (setq application context signal (nativeGet (nativeGet (nativeGet context "runtime") "intake_abort") "signal"))
          (js-call inbox :initialize context)
          (when poller (js-call poller :initialize context))
          (when signal (js-call signal :addEventListener "abort" stop (js-object :once t)))
          (unless running (setq running (funcall loop))))
        :receive (async (connection cursor budget call-context)
          (js-call inbox :pump)
          (when poller (js-call poller :pump))
          (let* ((db (nativeGet (nativeGet application "store") "db")) (id (nativeGet config "connection_id"))
                 (after (or cursor "0"))
                 (rows (js-call (js-call db :query "SELECT CAST(seq AS TEXT) AS seq,payload FROM im_event_inbox WHERE connection_id=? AND seq>? ORDER BY seq LIMIT ?")
                   :all id after (Math/min 100 (nativeGet budget "max_events" 100))))
                 (items (js-array)) (bytes 0) (full false))
            (js-call rows :forEach (lambda (row)
              (let ((event (JSON/parse (nativeGet row "payload"))) (size (utf8Bytes (nativeGet row "payload"))))
                (unless (= (nativeGet event "source_identity_revision") (nativeGet config "identity_revision"))
                  (throw (new globalThis.Error "event source identity changed; pending inbox requires explicit reconciliation")))
                (if (> (+ bytes size) (nativeGet budget "max_bytes" 1048576)) (setq full t)
                (unless full
                  (setq bytes (+ bytes size))
                  (put event :source_cursor (nativeGet row "seq"))
                  (js-call items :push event))))))
            (when (not (= after "0")) (await (enqueueWrite application (lambda () (inTransaction application (lambda (tx)
              (js-call (js-call db :query "DELETE FROM im_event_inbox WHERE connection_id=? AND seq<=?") :run id after) (success nil)))))))
            (js-object :items items :cursor cursor :ready (or ready
              (and poller (= (nativeGet (js-call poller :status) "state") "ready"))) :gap_status "possible"
              :reason_codes (cond
                ((> (nativeGet (js-call inbox :status) "retrying" 0) 0) (js-array "event_normalization_retrying"))
                ((and poller (= (nativeGet (js-call poller :status) "state") "degraded")) (js-array "inbox_poll_degraded"))
                ((and reason (not (and poller (= (nativeGet (js-call poller :status) "state") "ready")))) (js-array reason))
                (t (js-array))))))
        :probe (async (connection context) (js-object :ok t :credential_state (if ready "ready" "unknown")
          :event_source (Object/assign (js-object :state state :reason reason :identity "application" :send_identity (nativeGet config "identity")
            :transport (if poller "lark-websocket+poll" "lark-websocket")
            :coverage (if poller "application_events_and_http_poll" "application_authorized_chats") :requested_coverage (nativeGet config "event_scope" "all_authorized")
            :personal_inbox (if poller "poll" "not_provided_by_im_message_receive_v1")
            :poll_fallback (when poller (js-call poller :status))
            :user_document_notices (let ((receipts (js-call inbox :status)))
              (Object/assign (js-object) notice-status (js-object
                :realtime_observed (not (nil? (nativeGet receipts "last_document_notice_at")))
                :last_event_at (nativeGet receipts "last_document_notice_at" nil))))
            :event_receipts (js-call inbox :status) :last_received_at last-received
            :reaction_event_type "im.message.reaction.created_v1" :last_reaction_at last-reaction) permissions)))
        :pendingWork (lambda () (+ (js-call base :pendingWork) (if socket 1 0)
          (if poller (js-call poller :pendingWork) 0) (js-call inbox :pendingWork)))
        :close (async () (funcall stop) (when running (await running)) (await (js-call inbox :close))
          (when signal (js-call signal :removeEventListener "abort" stop)) (await (js-call base :close)))))))
  (export createLarkEventPort normalizeLarkEvent flattenLarkEvent))
