(module dj.adapters.im.slack
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber nativeSetTimeout nativeClearTimeout)
  (import "../../core/errors.eli" success failure)
  (import "../../core/types.eli" utf8Bytes hashValue)
  (import "../../application/context.eli" inTransaction must)
  (import "../../application/write-batch.eli" enqueueWrite)
  (import "../../service/ownership.eli" ownerGuard)
  (import "../../connections/interactions.eli" resolveMessageInteraction)
  (import "../../../packages/slack/src/index.eli" createSlackClient createSlackSocket)
  (import "./slack-normalize.eli" slackMessageId splitSlackMessageId normalizeSlackMessage)
  (defconst hostSockets (new globalThis.WeakMap))
  (defun createSlackPort (config host)
    (let* ((id (nativeGet config "connection_id")) (application nil) (closed false) (hub nil)
      (busy false) (next-poll 0) (pump nil) (persist nil) (consume nil) (perform nil) (request nil) (history nil)
      (discovery-cursor nil) (next-discovery 0) (poll-error nil) (polled false) (last-received nil)
      (visibility (new globalThis.Map)) (users (new globalThis.Map))
      (client-host (js-object :credentials (nativeGet host "credentials") :budget_owner host
        :fetch (lambda (url options) (js-call (nativeGet host "http") :fetch url options))
        :monoNow (lambda () (js-call (nativeGet host "clock") :monoNow))))
      (client (createSlackClient config client-host))
      (signal nil) (stop nil) (stopping nil) (active-pump nil))
      (setq request (async (method parameters context)
        (let* ((reply (await (js-call client :request method parameters context))) (wire (nativeGet reply "wire")))
          (if (and (= (nativeGet reply "status") 200) (= (nativeGet wire "ok") t)) (success wire)
            (failure (if (= (nativeGet reply "status") 429) "rate_limited" "unavailable")
              (js-object :details (js-object :reason "native_api_rejected" :http_status (nativeGet reply "status")
                :native_code (nativeGet wire "error") :needed (nativeGet wire "needed")
                :retry_after_seconds (nativeGet reply "retry_after"))))))))
      (setq history (async (parameters context)
        (let* ((native-id (nativeGet parameters "message_id"))
          (target (when native-id (splitSlackMessageId native-id)))
          (channel (if target (nativeGet target "channel") (nativeGet parameters "chat_id")))
          (thread (nativeGet parameters "thread_id"))
          (method (cond (target "reactions.get") (thread "conversations.replies") (t "conversations.history")))
          (args (js-object :channel channel :limit (Math/min 15 (nativeGet parameters "limit" 15)))))
          (when target (put args :timestamp (nativeGet target "ts")) (put args :full t))
          (when thread (put args :ts thread))
          (when (nativeGet parameters "page_token") (put args :cursor (nativeGet parameters "page_token")))
          (when (nativeGet parameters "start") (put args :oldest (str (/ (Date/parse (nativeGet parameters "start")) 1000))))
          (when (nativeGet parameters "end") (put args :latest (str (/ (Date/parse (nativeGet parameters "end")) 1000))))
          (let ((response (await (funcall request method args context))))
            (if (not (nativeGet response "ok")) response
              (let* ((wire (nativeGet response "data"))
                (messages (if target (if (nativeGet wire "message") (js-array (nativeGet wire "message")) (js-array)) (nativeGet wire "messages" (js-array))))
                (cursor (nativeGet (nativeGet wire "response_metadata") "next_cursor" "")))
                (success (js-object :messages (js-call messages :map (lambda (message)
                  (let ((event (normalizeSlackMessage config message channel)))
                    (js-object :message_id (nativeGet event "native_message_id") :chat_id channel
                      :thread_id (nativeGet (nativeGet event "conversation") "native_thread_id")
                      :msg_type "text" :content (nativeGet message "text" "") :deleted false
                      :create_time (str (Math/floor (* (NativeNumber (nativeGet message "ts")) 1000)))
                      :sender (js-object :id (nativeGet (nativeGet event "sender") "id")
                        :sender_type (if (= (nativeGet (nativeGet event "sender") "kind") "human") "user" "bot"))
                      :mentions (nativeGet event "mentions") :root_id (nativeGet event "root_message_id")
                      :parent_id (nativeGet (nativeGet event "reply_to") "id")
                      :native_message message :normalized event)))) :has_more (> (js-length cursor) 0) :page_token (if (= cursor "") nil cursor)))))))))
      (setq persist (async (events checkpoint &optional children)
        (let ((result (await (enqueueWrite application (lambda () (inTransaction application (lambda (tx)
          (must (ownerGuard application))
          (let ((db (nativeGet (nativeGet application "store") "db")))
            (when (> (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM im_event_inbox WHERE connection_id=?") :get id) "n") 1000)
              (throw (new globalThis.RangeError "Slack durable inbox full")))
            (js-call events :forEach (lambda (event)
              (put event :source_identity_revision (nativeGet config "identity_revision"))
              (js-call (js-call db :query "INSERT INTO im_event_inbox(connection_id,source_key,payload) VALUES(?,?,?) ON CONFLICT(connection_id,source_key) DO NOTHING")
                :run id (nativeGet event "source_key") (JSON/stringify event))))
            (let ((checkpoints (js-call (or children (js-array)) :slice)))
              (when checkpoint (js-call checkpoints :push checkpoint))
              (js-call checkpoints :forEach (lambda (item)
                (js-call (js-call db :query "INSERT INTO poll_checkpoints(connection_id,conversation_key,generation,next_due_at,payload) VALUES(?,?,1,?,?) ON CONFLICT(connection_id,conversation_key) DO UPDATE SET generation=generation+1,next_due_at=excluded.next_due_at,payload=excluded.payload")
                  :run id (nativeGet item "conversation_key") (nativeGet item "next_due_at") (JSON/stringify item))))))
          (success nil))))))))
          (unless (nativeGet result "ok") (throw (new globalThis.Error "Slack persistence unavailable"))))))
      (setq consume (async (payload)
        (when closed (throw (new globalThis.Error "Slack intake stopped before persistence")))
        (when (= (nativeGet payload "team_id") (nativeGet config "tenant_ref"))
          (unless (= (nativeGet payload "api_app_id") (nativeGet config "event_app_id"))
            (throw (new globalThis.Error "Slack event application mismatch")))
          (let* ((wire (nativeGet payload "event")) (type (nativeGet wire "type"))
            (channel (nativeGet wire "channel" (nativeGet (nativeGet wire "item") "channel")))
            (allowed (or (= (nativeGet config "event_scope" "all_authorized") "all_authorized")
              (js-call (nativeGet config "watches" (js-array)) :some (lambda (watch) (= channel (nativeGet watch "chat_id")))))))
            (when (and channel allowed (js-call (js-array "message" "app_mention" "reaction_added" "reaction_removed") :includes type))
              ;; An app stream may include installations belonging to another user.
              ;; Verify visibility with this connection's own token, never trust the socket token.
              (let* ((cached (js-call visibility :get channel)) (now (js-call (nativeGet host "clock") :monoNow))
                (call-context (js-object :abort_signal signal :deadline (+ now 15000)))
                (visible (and cached (< now (nativeGet cached "until")) (nativeGet cached "visible"))))
                (unless (and cached (< now (nativeGet cached "until")))
                  (let* ((response (await (funcall request "conversations.info" (js-object :channel channel) call-context)))
                    (native-error (nativeGet (nativeGet (nativeGet response "error") "details") "native_code")))
                    (unless (or (nativeGet response "ok") (js-call (js-array "channel_not_found" "not_in_channel" "no_permission") :includes native-error))
                      (throw (new globalThis.Error "Slack visibility verification unavailable")))
                    (setq visible (and (nativeGet response "ok")
                      (or (js-call channel :startsWith "D")
                        (and (= (nativeGet config "identity") "user")
                          (not (nativeGet (nativeGet (nativeGet response "data") "channel") "is_private")))
                        (= (nativeGet (nativeGet (nativeGet response "data") "channel") "is_member") t))))
                    (when (>= (nativeGet visibility "size") 256) (js-call visibility :clear))
                    (js-call visibility :set channel (js-object :visible visible :until (+ now 60000)))))
                (when visible
                  (let ((event nil))
                    (cond
                      ((js-call (js-array "message" "app_mention") :includes type)
                        (let* ((subtype (nativeGet wire "subtype")) (message wire))
                          (unless (js-call (js-array "message_changed" "message_deleted" "message_replied" "channel_join" "channel_leave") :includes subtype)
                            (setq event (normalizeSlackMessage config message channel)))))
                      ((= type "reaction_added")
                        (let* ((target (slackMessageId channel (nativeGet (nativeGet wire "item") "ts")))
                          (reply (must (await (funcall history (js-object :message_id target) call-context))))
                          (original (nativeGet (aref (nativeGet reply "messages") 0) "normalized"))
                          (actor (nativeGet wire "user")) (user (js-call users :get actor)))
                          (unless original (throw (new globalThis.Error "Slack reaction message unavailable")))
                          (unless user
                            (setq user (nativeGet (must (await (funcall request "users.info" (js-object :user actor) call-context))) "user"))
                            (when (>= (nativeGet users "size") 256) (js-call users :clear)) (js-call users :set actor user))
                          (setq event (Object/assign (js-object) original))
                          (put event :event_kind "message.reaction.added")
                          (put event :source_time (js-call (new globalThis.Date (Math/floor (* (NativeNumber (nativeGet wire "event_ts")) 1000))) :toISOString))
                          (put event :source_key (str "reaction:" (nativeGet payload "event_id")))
                          (put event :addressed_self false) (put event :addressed_bot false)
                          (put event :reaction (js-object :native_event_id (nativeGet payload "event_id")
                            :emoji_type (nativeGet wire "reaction") :action_time (str (Math/floor (* (NativeNumber (nativeGet wire "event_ts")) 1000)))
                            :message_source_time (nativeGet original "source_time")
                            :operator (js-object :id actor :kind (if (nativeGet user "is_bot") "bot" "human")
                              :is_self (= actor (nativeGet config "event_subject_id")))))
                          (put event :interaction (js-object :kind "reaction" :state "resolved" :target_message_id target
                            :target_id (nativeGet (nativeGet original "sender") "id") :target_kind (nativeGet (nativeGet original "sender") "kind")
                            :addressed_self (= (nativeGet (nativeGet original "sender") "id") (nativeGet config "event_subject_id")))))))
                    (when event
                      (await (resolveMessageInteraction config event application (js-object :history history) nil))
                      (put event :receive_transport "websocket")
                      (await (funcall persist (js-array event) nil))
                      (setq last-received (js-call (new globalThis.Date) :toISOString)))))))))))
      (setq perform (async (command parameters context)
        (try
          (let* ((target (when (nativeGet parameters "message_id") (splitSlackMessageId (nativeGet parameters "message_id"))))
            (channel (if target (nativeGet target "channel") (nativeGet parameters "chat_id")))
            (args (js-object :channel channel)) (method nil) (emoji (nativeGet parameters "emoji_type")))
            (when target (put args :ts (nativeGet target "ts")))
            (cond
              ((js-call (js-array "send" "reply") :includes command)
                (setq method "chat.postMessage") (put args :text (nativeGet parameters "text"))
                (put args :unfurl_links false) (put args :unfurl_media false)
                (put args :client_msg_id (str (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 0 8) "-"
                  (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 8 12) "-4"
                  (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 13 16) "-8"
                  (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 17 20) "-"
                  (js-call (hashValue (nativeGet parameters "idempotency_key")) :slice 20 32)))
                (when (or target (nativeGet parameters "thread_id"))
                  (put args :thread_ts (or (nativeGet parameters "thread_id") (nativeGet target "ts"))))
                (Reflect/deleteProperty args "ts"))
              ((= command "recall") (setq method "chat.delete"))
              ((= command "edit") (setq method "chat.update") (put args :text (nativeGet parameters "text")))
              ((= command "reaction_list") (setq method "reactions.get") (put args :timestamp (nativeGet target "ts")) (Reflect/deleteProperty args "ts") (put args :full t))
              ((js-call (js-array "reaction_create" "reaction_delete") :includes command)
                (setq method (if (= command "reaction_create") "reactions.add" "reactions.remove"))
                (when (and (= command "reaction_delete") (nativeGet parameters "reaction_id")
                  (not (= (js-call (nativeGet parameters "reaction_id") :slice (1+ (js-call (nativeGet parameters "reaction_id") :lastIndexOf ":"))) (nativeGet config "event_subject_id"))))
                  (throw (new globalThis.TypeError "only the connection's own reaction may be removed")))
                (unless emoji (setq emoji (js-call (nativeGet parameters "reaction_id" "") :slice 0 (js-call (nativeGet parameters "reaction_id" "") :lastIndexOf ":"))))
                (unless (and (= (nativeTypeOf emoji) "string") (js-call (new globalThis.RegExp "^[a-zA-Z0-9_+\\-]+(?:::skin-tone-[2-6])?$") :test emoji))
                  (throw (new globalThis.TypeError "expected Slack emoji name")))
                (put args :name emoji) (put args :timestamp (nativeGet target "ts")) (Reflect/deleteProperty args "ts"))
              (t (throw (new globalThis.TypeError "unsupported Slack message action"))))
            (let* ((reply (await (funcall request method args context))) (wire (nativeGet reply "data")))
              (if (not (nativeGet reply "ok")) reply
                (cond
                  ((= command "reaction_list")
                    (let ((items (js-array)))
                      (js-call (nativeGet (nativeGet wire "message") "reactions" (js-array)) :forEach (lambda (reaction)
                        (when (or (not emoji) (= emoji (nativeGet reaction "name")))
                          (js-call (nativeGet reaction "users" (js-array)) :forEach (lambda (user)
                            (js-call items :push (js-object :reaction_id (str (nativeGet reaction "name") ":" user)
                              :reaction_type (js-object :emoji_type (nativeGet reaction "name"))
                              :operator (js-object :operator_id user :operator_type "user"))))))))
                      (let* ((offset (NativeNumber (nativeGet parameters "page_token" "0")))
                        (limit (Math/min 50 (nativeGet parameters "limit" 50))) (end (+ offset limit)))
                        (unless (and (Number/isSafeInteger offset) (>= offset 0) (<= offset (js-length items)))
                          (throw (new globalThis.TypeError "invalid Slack reaction cursor")))
                        (success (js-object :items (js-call items :slice offset end) :has_more (< end (js-length items))
                          :page_token (if (< end (js-length items)) (str end) nil))))))
                  ((= command "reaction_create") (success (js-object :reaction_id (str emoji ":" (nativeGet config "event_subject_id")))))
                  ((js-call (js-array "send" "reply") :includes command)
                    (success (js-object :message_id (slackMessageId (nativeGet wire "channel") (nativeGet wire "ts")) :chat_id (nativeGet wire "channel"))))
                  (t (success (js-object)))))))
          (catch error (failure "unavailable" (js-object :details (js-object :reason "native_api_unavailable")))))))
      ;; HTTP is bounded catch-up, not a second AI scheduler. Each page and its
      ;; checkpoint commit together. A partial page never advances the high water.
      (setq pump (async ()
        (unless (or closed busy (not application) (< (js-call (nativeGet host "clock") :monoNow) next-poll))
          (setq busy t next-poll (+ (js-call (nativeGet host "clock") :monoNow) 60000))
          (try
            (let* ((db (nativeGet (nativeGet application "store") "db")) (now (Date/parse (js-call (nativeGet host "clock") :utcNow)))
              (call-context (js-object :abort_signal signal :deadline (+ (js-call (nativeGet host "clock") :monoNow) 15000)))
              (ensure-channel (lambda (channel &optional thread)
                (let ((key (if thread (str "slack:thread:" channel ":" thread) (str "slack:history:" channel))))
                  (unless (js-call (js-call db :query "SELECT 1 FROM poll_checkpoints WHERE connection_id=? AND conversation_key=?") :get id key)
                    (js-object :connection_id id :conversation_key key :channel channel :kind (if thread "thread" "history") :thread thread
                      :identity_revision (nativeGet config "identity_revision") :since (str (/ (- now 300000) 1000))
                      :next_due_at (js-call (new globalThis.Date now) :toISOString)))))))
              (when (>= now next-discovery)
                (setq next-discovery (+ now 60000))
                (if (= (nativeGet config "event_scope" "all_authorized") "configured")
                  (let ((watches (nativeGet config "watches" (js-array))) (i 0))
                    (while (< i (js-length watches))
                      (let ((checkpoint (funcall ensure-channel (nativeGet (aref watches i) "chat_id") (nativeGet (aref watches i) "thread_id"))))
                        (when checkpoint (await (funcall persist (js-array) checkpoint)))) (setq i (1+ i))))
                  (let* ((args (js-object :types "public_channel,private_channel,mpim,im" :exclude_archived t :limit 100))
                    (ignored (when discovery-cursor (put args :cursor discovery-cursor)))
                    (reply (must (await (funcall request "conversations.list" args call-context))))
                    (channels (nativeGet reply "channels" (js-array))) (i 0))
                    (while (< i (js-length channels))
                      (let* ((channel (aref channels i))
                        (checkpoint (when (or (= (nativeGet config "identity") "user") (nativeGet channel "is_member") (nativeGet channel "is_im"))
                          (funcall ensure-channel (nativeGet channel "id")))))
                        (when checkpoint (await (funcall persist (js-array) checkpoint)))) (setq i (1+ i)))
                    (setq discovery-cursor (nativeGet (nativeGet reply "response_metadata") "next_cursor" nil)))))
              (let* ((row (js-call (js-call db :query "SELECT payload FROM poll_checkpoints WHERE connection_id=? AND conversation_key LIKE 'slack:%' AND next_due_at<=? ORDER BY next_due_at,conversation_key LIMIT 1")
                  :get id (js-call (new globalThis.Date now) :toISOString)))
                (checkpoint (when row (JSON/parse (nativeGet row "payload")))))
                (when checkpoint
                  (unless (= (nativeGet checkpoint "identity_revision") (nativeGet config "identity_revision"))
                    (throw (new globalThis.Error "Slack catch-up identity changed")))
                  (let* ((thread (= (nativeGet checkpoint "kind") "thread"))
                    (args (js-object :channel (nativeGet checkpoint "channel") :oldest (nativeGet checkpoint "since") :limit 15))
                    (events (js-array)) (threads (js-array)))
                    (unless (nativeGet checkpoint "upper") (put checkpoint :upper (str (/ now 1000))))
                    (put args :latest (nativeGet checkpoint "upper"))
                    (when thread (put args :ts (nativeGet checkpoint "thread")))
                    (when (nativeGet checkpoint "cursor") (put args :cursor (nativeGet checkpoint "cursor")))
                    (let* ((reply (await (funcall request (if thread "conversations.replies" "conversations.history") args call-context)))
                      (wire (nativeGet reply "data")))
                      (if (not (nativeGet reply "ok"))
                        (progn
                          (put checkpoint :native_error (nativeGet (nativeGet reply "error") "details"))
                          (put checkpoint :next_due_at (js-call (new globalThis.Date (+ now (* 1000 (Math/max 60
                            (nativeGet (nativeGet (nativeGet reply "error") "details") "retry_after_seconds" 60))))) :toISOString))
                          (await (funcall persist (js-array) checkpoint)) (setq poll-error "history_unavailable"))
                        (progn
                          (js-call (nativeGet wire "messages" (js-array)) :forEach (lambda (message)
                            (when (and (nativeGet message "ts") (not (js-call (js-array "message_deleted" "message_changed" "channel_join" "channel_leave") :includes (nativeGet message "subtype"))))
                              (let ((event (normalizeSlackMessage config message (nativeGet checkpoint "channel"))))
                                (put event :receive_transport "poll") (js-call events :push event)))
                            (when (and (not thread) (> (nativeGet message "reply_count" 0) 0))
                              (let ((key (str "slack:thread:" (nativeGet checkpoint "channel") ":" (nativeGet message "ts"))))
                                (unless (js-call (js-call db :query "SELECT 1 FROM poll_checkpoints WHERE connection_id=? AND conversation_key=?") :get id key)
                                  (js-call threads :push (js-object :connection_id id :conversation_key key :kind "thread"
                                    :channel (nativeGet checkpoint "channel") :thread (nativeGet message "ts")
                                    :identity_revision (nativeGet config "identity_revision") :since (nativeGet message "ts")
                                    :next_due_at (js-call (new globalThis.Date now) :toISOString))))))))
                          (put checkpoint :cursor (nativeGet (nativeGet wire "response_metadata") "next_cursor" nil))
                          (when (= (nativeGet checkpoint "cursor") "") (put checkpoint :cursor nil))
                          (when (and (= (nativeGet wire "has_more") t) (not (nativeGet checkpoint "cursor")))
                            ;; No cursor means completion is unproven; never skip the unread interval.
                            (throw (new globalThis.Error "Slack history pagination incomplete")))
                          (unless (nativeGet checkpoint "cursor")
                            (put checkpoint :since (nativeGet checkpoint "upper")) (put checkpoint :upper nil))
                          (put checkpoint :next_due_at (js-call (new globalThis.Date (+ now (* 1000 (nativeGet config "history_poll_seconds" 60)))) :toISOString))
                          (Reflect/deleteProperty checkpoint "native_error")
                          (let ((i 0) (preceding (js-array)))
                            (while (< i (js-length events))
                              (await (resolveMessageInteraction config (aref events i) application (js-object :history history) nil preceding))
                              (js-call preceding :push (aref events i)) (setq i (1+ i))))
                          (await (funcall persist events checkpoint threads))
                          (setq polled t poll-error nil))))))))
            (catch error (setq poll-error "history_unavailable"))
            (finally (setq busy false))))))
      (setq stop (lambda ()
        (unless closed
          (setq closed t)
          (when hub (setq stopping (js-call hub :unsubscribe id)))
          (js-call client :close))))
      (js-object :connection_id id
        :capabilities (js-object :receive_events "supported" :send "supported" :reply_thread "supported"
          :ack_control t :replay "bounded" :native_history "supported" :native_idempotency "unsupported"
          :lookup_send "unsupported" :max_text_bytes 40000)
        :working_emoji "keyboard" :acknowledgement_emoji "eyes"
        :message_action_scopes (js-object :recall (js-array "chat:write") :edit (js-array "chat:write")
          :reaction_create (js-array "reactions:write") :reaction_delete (js-array "reactions:write"))
        :reaction_identity (js-object :id (nativeGet config "event_subject_id") :type "user")
        :initialize (lambda (context)
          (setq application context signal (nativeGet (nativeGet (nativeGet context "runtime") "intake_abort") "signal"))
          (when signal (js-call signal :addEventListener "abort" stop (js-object :once t)))
          (let ((sockets (js-call hostSockets :get host)) (key (nativeGet config "event_app_id")))
            (unless sockets (setq sockets (new globalThis.Map)) (js-call hostSockets :set host sockets))
            (setq hub (js-call sockets :get key))
            (unless hub (setq hub (createSlackSocket (createSlackClient config client-host) (js-object :webSocket (nativeGet host "webSocket"))))
              (js-call sockets :set key hub))
            (js-call hub :subscribe id consume)))
        :resolveConversation (async (address context app)
          (let* ((reply (await (funcall request "conversations.info" (js-object :channel (nativeGet address "native_chat_id")) context)))
            (thread (nativeGet address "native_thread_id")))
            (when (and (nativeGet reply "ok") thread)
              (let ((root (await (funcall history (js-object :message_id (slackMessageId (nativeGet address "native_chat_id") thread)) context))))
                (unless (and (nativeGet root "ok") (= (js-length (nativeGet (nativeGet root "data") "messages")) 1)) (setq reply (failure "not_found")))))
            (if (nativeGet reply "ok") (js-object :ok t :address address :evidence_level "native_protocol")
              (js-object :ok false :reason "native_api_unavailable"))))
        :history history
        :messageAction (async (record context) (await (funcall perform (nativeGet record "command") (nativeGet record "parameters") context)))
        :reaction (async (command parameters context) (await (funcall perform (str "reaction_" command) parameters context)))
        :send (async (outbound key context)
          (let* ((destination (nativeGet outbound "destination")) (text (nativeGet (nativeGet outbound "content") "text"))
            (reply-to (nativeGet outbound "native_reply_to"))
            (target (when reply-to (splitSlackMessageId reply-to)))
            (thread (nativeGet destination "native_thread_id")))
            (when thread (slackMessageId (nativeGet destination "native_chat_id") thread))
            (if (or (not (= (nativeGet destination "connection_id") id)) (> (utf8Bytes text) 40000)
              (and target (not (= (nativeGet target "channel") (nativeGet destination "native_chat_id")))))
              (js-object :state "failed" :definite_not_sent t :retryable false :evidence_level "service_record")
              (let* ((reply (await (funcall perform (if reply-to "reply" "send")
                (js-object :chat_id (nativeGet destination "native_chat_id") :message_id reply-to
                  :thread_id (nativeGet destination "native_thread_id") :text text :idempotency_key key) context)))
                (details (nativeGet (nativeGet reply "error") "details")))
                (cond ((nativeGet reply "ok") (js-object :state "accepted" :native_message_id (nativeGet (nativeGet reply "data") "message_id") :evidence_level "native_protocol"))
                  ((and (= (nativeGet details "reason") "native_api_rejected") (< (nativeGet details "http_status" 500) 500)
                    (not (js-call (js-array "internal_error" "fatal_error" "request_timeout") :includes (nativeGet details "native_code"))))
                    (js-object :state "failed" :definite_not_sent t :retryable (= (nativeGet details "http_status") 429)
                      :retry_after_seconds (nativeGet details "retry_after_seconds") :evidence_level "native_protocol"))
                  (t (js-object :state "unknown" :definite_not_sent false :retryable false :evidence_level "none")))))))
        :lookup (async (record key context) (js-object :state "unknown" :evidence_level "none"))
        :ack (async (connection cursor context) (js-object :ok t))
        :receive (async (connection cursor budget context)
          (unless (or closed busy) (setq active-pump (funcall pump)))
          (let* ((db (nativeGet (nativeGet application "store") "db")) (after (or cursor "0"))
            (rows (js-call (js-call db :query "SELECT CAST(seq AS TEXT) AS seq,payload FROM im_event_inbox WHERE connection_id=? AND seq>? ORDER BY seq LIMIT ?")
              :all id after (Math/min 100 (nativeGet budget "max_events" 100)))) (items (js-array)) (size 0) (full false))
            (js-call rows :forEach (lambda (row)
              (let ((event (JSON/parse (nativeGet row "payload"))))
                (unless (= (nativeGet event "source_identity_revision") (nativeGet config "identity_revision"))
                  (throw (new globalThis.Error "Slack inbox identity changed")))
                (setq size (+ size (utf8Bytes (nativeGet row "payload"))))
                (when (> size (nativeGet budget "max_bytes" 1048576)) (setq full t))
                (unless full (put event :source_cursor (nativeGet row "seq")) (js-call items :push event)))))
            (unless (= after "0")
              (await (enqueueWrite application (lambda () (inTransaction application (lambda (tx)
                (must (ownerGuard application))
                (js-call (js-call db :query "DELETE FROM im_event_inbox WHERE connection_id=? AND seq<=?") :run id after) (success nil)))))))
            (js-object :items items :cursor cursor :ready (or polled (= (nativeGet (and hub (js-call hub :status)) "state") "connected"))
              :gap_status "possible" :reason_codes (if poll-error (js-array poll-error) (js-array)))))
        :probe (async (connection context)
          (js-object :ok t :credential_state (if (js-call client :identity) "ready" "unknown")
            :event_source (js-object :transport "slack-socket-mode+http" :state (if poll-error "degraded" (nativeGet (and hub (js-call hub :status)) "state" "connecting"))
              :reason (or poll-error (nativeGet (and hub (js-call hub :status)) "reason" nil)) :identity "application" :send_identity (nativeGet config "identity")
              :last_received_at last-received
              :coverage "authorized_channels_and_retained_threads")))
        :pendingWork (lambda () (+ (js-call client :pendingWork) (if busy 1 0)))
        :close (async ()
          (funcall stop) (when stopping (await stopping))
          (when (and hub (= (nativeGet (js-call hub :status) "state") "stopped"))
            (js-call (js-call hostSockets :get host) :delete (nativeGet config "event_app_id")))
          (when active-pump (await active-pump))
          (when signal (js-call signal :removeEventListener "abort" stop))
          (js-object :state "stopped")))))
  (export createSlackPort))
