(module dj.adapters.im.slack-normalize
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (defun slackMessageId (channel timestamp)
    (unless (and (= (nativeTypeOf channel) "string")
      (js-call (new globalThis.RegExp "^[CDG][A-Z0-9]+$") :test channel)
      (= (nativeTypeOf timestamp) "string")
      (js-call (new globalThis.RegExp "^[0-9]{1,16}\\.[0-9]{6}$") :test timestamp))
      (throw (new globalThis.TypeError "invalid Slack channel/message timestamp")))
    (str channel ":" timestamp))
  (defun splitSlackMessageId (id)
    (unless (= (nativeTypeOf id) "string") (throw (new globalThis.TypeError "expected channel:ts message ID")))
    (let ((parts (js-call id :split ":")))
      (unless (= (js-length parts) 2) (throw (new globalThis.TypeError "expected channel:ts message ID")))
      (slackMessageId (aref parts 0) (aref parts 1))
      (js-object :channel (aref parts 0) :ts (aref parts 1))))
  (defun slackMentions (text)
    (let ((matches (Array/from (js-call text :matchAll (new globalThis.RegExp "<@([A-Z0-9]+)(?:\\|([^>]+))?>" "g")))))
      (js-call matches :map (lambda (match) (js-object :id (aref match 1) :name (or (aref match 2) ""))))))
  (defun normalizeSlackMessage (config message channel &optional kind)
    (let* ((timestamp (nativeGet message "ts")) (id (slackMessageId channel timestamp))
      (thread (nativeGet message "thread_ts")) (self (nativeGet config "event_subject_id"))
      (text (nativeGet message "text" "")) (mentions (slackMentions text))
      (bot (or (nativeGet message "bot_id") (= (nativeGet message "subtype") "bot_message")
        (and (= (nativeGet config "identity") "bot") (= (nativeGet message "user") self))))
      (addressed (js-call mentions :some (lambda (mention) (= (nativeGet mention "id") self))))
      (event (js-object :connection_id (nativeGet config "connection_id") :source_key (str id ":created")
        :native_message_id id :event_kind (or kind "message.created") :source_revision "1"
        :conversation (js-object :connection_id (nativeGet config "connection_id") :platform "slack"
          :brand "slack" :tenant_ref (nativeGet config "tenant_ref") :account_ref (nativeGet config "account_ref")
          :native_chat_id channel :native_thread_id (if (and thread (not (= thread timestamp))) thread nil)
          :thread_kind (if (and thread (not (= thread timestamp))) "thread" "main"))
        :sender (js-object :id (nativeGet message "user" (nativeGet message "bot_id" "unknown"))
          :kind (if bot "bot" "human") :identities (js-array (js-object :platform "slack"
            :scope (str "workspace:" (nativeGet config "tenant_ref")) :id (nativeGet message "user" (nativeGet message "bot_id" "unknown")))))
        :source_time (js-call (new globalThis.Date (Math/floor (* (NativeNumber timestamp) 1000))) :toISOString)
        :content (js-object :kind "text" :text text :truncated false) :mentions mentions
        :attachments (js-array) :addressed_self addressed :addressed_bot (and addressed (= (nativeGet config "identity") "bot"))
        :chat_type (if (js-call channel :startsWith "D") "p2p" "group"))))
      (when (and thread (not (= thread timestamp)))
        (put event :root_message_id (slackMessageId channel thread))
        (put event :reply_to (js-object :id (slackMessageId channel thread))))
      event))
  (export slackMessageId splitSlackMessageId slackMentions normalizeSlackMessage))
