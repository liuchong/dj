(module dj.adapters.im.lark-wire
  (import "../../core/native.eli" nativeGet NativeBigInt NativeNumber)
  (defun writeVarint (value)
    (let ((n (NativeBigInt value)) (bytes (js-array)))
      (unless (and (>= n (NativeBigInt 0)) (<= n (NativeBigInt "18446744073709551615")))
        (throw (new globalThis.RangeError "invalid wire integer")))
      (while (>= n (NativeBigInt 128))
        (js-call bytes :push (+ (NativeNumber (% n (NativeBigInt 128))) 128))
        (setq n (/ n (NativeBigInt 128))))
      (js-call bytes :push (NativeNumber n)) (Buffer/from bytes)))
  (defun wireFields (bytes)
    (when (> (nativeGet bytes "length") 1048576) (throw (new globalThis.RangeError "wire frame too large")))
    (let ((offset 0) (fields (new globalThis.Map)) (read nil) (entries 0))
      (setq read (lambda ()
        (let ((value (NativeBigInt 0)) (factor (NativeBigInt 1)) (steps 0) (more t))
          (while more
            (when (or (>= offset (nativeGet bytes "length")) (>= steps 10)) (throw (new globalThis.TypeError "invalid wire varint")))
            (let ((byte (aref bytes offset)))
              (when (and (= steps 9) (> byte 1)) (throw (new globalThis.RangeError "wire integer overflow")))
              (setq offset (1+ offset) steps (1+ steps) value (+ value (* (NativeBigInt (% byte 128)) factor))
                factor (* factor (NativeBigInt 128)) more (>= byte 128))))
          value)))
      (while (< offset (nativeGet bytes "length"))
        (setq entries (1+ entries))
        (when (> entries 256) (throw (new globalThis.RangeError "too many wire fields")))
        (let* ((tag (NativeNumber (funcall read))) (id (Math/floor (/ tag 8))) (kind (% tag 8)) (value nil))
          (when (= id 0) (throw (new globalThis.TypeError "invalid field number")))
          (cond ((= kind 0) (setq value (funcall read)))
            ((= kind 2) (let ((size (NativeNumber (funcall read))))
              (unless (and (Number/isSafeInteger size) (>= size 0) (<= (+ offset size) (nativeGet bytes "length")))
                (throw (new globalThis.TypeError "invalid wire length")))
              (setq value (js-call bytes :subarray offset (+ offset size)) offset (+ offset size))))
            ((or (= kind 1) (= kind 5)) (setq offset (+ offset (if (= kind 1) 8 4))))
            (t (throw (new globalThis.TypeError "unsupported wire type"))))
          (when (> offset (nativeGet bytes "length")) (throw (new globalThis.TypeError "truncated wire field")))
          (unless (js-call fields :has id) (js-call fields :set id (js-array)))
          (js-call (js-call fields :get id) :push value)))
      fields))
  (defun decodeLarkFrame (bytes)
    (let* ((fields (wireFields bytes)) (first (lambda (id fallback) (aref (or (js-call fields :get id) (js-array fallback)) 0)))
           (headers (js-array)))
      (js-call (or (js-call fields :get 5) (js-array)) :forEach (lambda (item)
        (let ((entry (wireFields item)))
          (js-call headers :push (js-object :key (js-call (aref (js-call entry :get 1) 0) :toString "utf8")
            :value (js-call (aref (js-call entry :get 2) 0) :toString "utf8"))))))
      (js-object :SeqID (str (funcall first 1 (NativeBigInt 0))) :LogID (str (funcall first 2 (NativeBigInt 0)))
        :service (NativeNumber (funcall first 3 (NativeBigInt 0))) :method (NativeNumber (funcall first 4 (NativeBigInt 0)))
        :headers headers :payload (funcall first 8 (Buffer/alloc 0)))))
  (defun encodeLarkFrame (frame)
    (let ((parts (js-array)) (field nil))
      (setq field (lambda (id value length-delimited)
        (js-call parts :push (writeVarint (+ (* id 8) (if length-delimited 2 0))))
        (when length-delimited (js-call parts :push (writeVarint (nativeGet value "length"))))
        (js-call parts :push (if length-delimited value (writeVarint value)))))
      (funcall field 1 (nativeGet frame "SeqID" "0") false) (funcall field 2 (nativeGet frame "LogID" "0") false)
      (funcall field 3 (nativeGet frame "service" 0) false) (funcall field 4 (nativeGet frame "method" 0) false)
      (js-call (nativeGet frame "headers" (js-array)) :forEach (lambda (header)
        (let ((key (Buffer/from (nativeGet header "key") "utf8")) (value (Buffer/from (nativeGet header "value") "utf8")))
          (funcall field 5 (Buffer/concat (js-array (writeVarint 10) (writeVarint (nativeGet key "length")) key
            (writeVarint 18) (writeVarint (nativeGet value "length")) value)) t))))
      (when (nativeGet frame "payload") (funcall field 8 (nativeGet frame "payload") t))
      (Buffer/concat parts)))
  (export decodeLarkFrame encodeLarkFrame))
