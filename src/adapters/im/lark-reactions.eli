(module dj.adapters.im.lark-reactions
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber nativeEncodeURIComponent)
  (import "../../application/context.eli" nativeCallContext must)
  (import "../../core/types.eli" hashValue)
  (import "./lark-identities.eli" larkIdentities)
  (defun normalizeLarkReaction (config wire original)
    (let* ((header (nativeGet wire "header")) (notice (nativeGet wire "event"))
      (id (nativeGet header "event_id")) (message (nativeGet notice "message_id"))
      (emoji (nativeGet (nativeGet notice "reaction_type") "emoji_type"))
      (kind (nativeGet notice "operator_type")) (ids (nativeGet notice "user_id"))
      (operator-id (if (= kind "user") (nativeGet ids "open_id") (nativeGet notice "app_id")))
      (stamp (NativeNumber (nativeGet notice "action_time")))
      (self (if (= (nativeGet config "identity") "user")
        (nativeGet (nativeGet config "user_identity") "open_id") (nativeGet config "event_app_id"))))
      (unless (and (= (nativeGet header "event_type") "im.message.reaction.created_v1")
        (= (nativeGet header "app_id") (nativeGet config "event_app_id"))
        (= (nativeTypeOf id) "string") (> (js-length id) 0) (<= (js-length id) 256)
        (= message (nativeGet original "native_message_id"))
        (= (nativeGet original "connection_id") (nativeGet config "connection_id"))
        (= (nativeTypeOf emoji) "string") (> (js-length emoji) 0) (<= (js-length emoji) 128)
        (js-call (js-array "user" "app") :includes kind)
        (= (nativeTypeOf operator-id) "string") (> (js-length operator-id) 0)
        (= (nativeTypeOf (nativeGet notice "action_time")) "string")
        (Number/isSafeInteger stamp) (>= stamp 0))
        (throw (new globalThis.TypeError "invalid native reaction event")))
      (reactionEvent config original emoji (nativeGet notice "action_time")
        (js-object :id operator-id :kind (if (= kind "user") "human" "bot")
          :is_self (and (= operator-id self) (= kind (if (= (nativeGet config "identity") "user") "user" "app")))
          :identities (if (= kind "user") (larkIdentities (nativeGet config "brand" "lark")
            (nativeGet config "event_app_id") (nativeGet header "tenant_key") ids) (js-array))) id nil)))
  (defun reactionEvent (config original emoji action-time operator native-event-id native-reaction-id)
    (let ((event (Object/assign (js-object) original (js-object
      :source_key (str "reaction:" (hashValue (js-array (nativeGet original "native_message_id")
        emoji (nativeGet operator "kind") (nativeGet operator "id") action-time)))
      :event_kind "message.reaction.added" :source_revision "1"
      :source_time (js-call (new globalThis.Date (NativeNumber action-time)) :toISOString)
      :addressed_self false :addressed_bot false
      :reaction (js-object :native_event_id (or native-event-id "") :emoji_type emoji :action_time action-time
        :message_source_time (nativeGet original "source_time" nil) :operator operator)))))
      (when native-reaction-id (put (nativeGet event "reaction") :native_reaction_id native-reaction-id)) event))
  (defun normalizePolledReaction (config original record)
    (let* ((native (nativeGet record "operator")) (kind (nativeGet native "operator_type"))
      (id (nativeGet native "operator_id")) (emoji (nativeGet (nativeGet record "reaction_type") "emoji_type"))
      (rid (nativeGet record "reaction_id")) (stamp (nativeGet record "action_time"))
      (self (if (= (nativeGet config "identity") "user")
        (nativeGet (nativeGet config "user_identity") "open_id") (nativeGet config "event_app_id"))))
      (unless (and (= (nativeGet original "connection_id") (nativeGet config "connection_id"))
        (js-call (js-array "user" "app") :includes kind)
        (= (nativeTypeOf id) "string") (> (js-length id) 0)
        (= (nativeTypeOf rid) "string") (> (js-length rid) 0)
        (= (nativeTypeOf emoji) "string") (> (js-length emoji) 0) (<= (js-length emoji) 128)
        (= (nativeTypeOf stamp) "string") (> (js-length stamp) 0)
        (Number/isSafeInteger (NativeNumber stamp)) (>= (NativeNumber stamp) 0))
        (throw (new globalThis.TypeError "invalid polled reaction")))
      (let ((event (reactionEvent config original emoji stamp
        (js-object :id id :kind (if (= kind "user") "human" "bot")
          :is_self (and (= id self) (= kind (if (= (nativeGet config "identity") "user") "user" "app")))
          :identities (if (= kind "user") (larkIdentities (nativeGet config "brand" "lark")
            (nativeGet config "event_app_id") nil (js-object :open_id id)) (js-array))) nil rid)))
        (put event :receive_transport "poll") event)))
  (defasync pollLarkReactions (config application port checkpoint context)
    (let* ((db (nativeGet (nativeGet application "store") "db")) (id (nativeGet config "connection_id"))
      (events (js-array)) (now (js-call (nativeGet (nativeGet application "ports") "clock") :utcNow))
      (pending (nativeGet checkpoint "reaction_message_id"))
      (before (nativeGet checkpoint "reaction_before_seq" ""))
      (row nil))
      (when (js-call (js-call db :query
        "SELECT 1 FROM subscription_sources i JOIN subscriptions s ON s.subscription_id=i.subscription_id AND s.revision=i.revision WHERE i.connection_id=? AND i.event_kind='message.reaction.added' AND s.state='active' LIMIT 1") :get id)
        (setq row (if pending
          (js-call (js-call db :query "SELECT CAST(ingress_seq AS TEXT) AS seq,payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind='message.created' AND tombstone=0 AND body_expires_at>? LIMIT 1") :get id pending now)
          (let ((query (js-call db :query (str "SELECT CAST(ingress_seq AS TEXT) AS seq,payload FROM events WHERE connection_id=? AND event_kind='message.created' AND tombstone=0 AND body_expires_at>?"
            (if (= before "") "" " AND ingress_seq<CAST(? AS INTEGER)") " ORDER BY ingress_seq DESC LIMIT 1"))))
            (if (= before "") (js-call query :get id now) (js-call query :get id now before))))))
      (if (not row)
        (progn (put checkpoint :reaction_before_seq "") (put checkpoint :reaction_message_id nil)
          (put checkpoint :reaction_page_token nil) (put checkpoint :reaction_seen_tokens (js-array))
          (js-object :events events :more false))
        (let* ((original (JSON/parse (nativeGet row "payload")))
          (message (nativeGet original "native_message_id"))
          (query (new globalThis.URLSearchParams (js-object :user_id_type "open_id" :page_size "50")))
          (token (nativeGet checkpoint "reaction_page_token"))
          (seen (nativeGet checkpoint "reaction_seen_tokens" (js-array))))
          (unless (= (nativeGet original "identity_revision") (nativeGet config "identity_revision"))
            (throw (new globalThis.Error "reaction source identity changed")))
          (when token (js-call query :set "page_token" token))
          (let* ((response (await (js-call port :nativeRequest
              (str "/open-apis/im/v1/messages/" (nativeEncodeURIComponent message)
                "/reactions?" (js-call query :toString)) "GET" nil context)))
            (wire (nativeGet response "wire")) (data (nativeGet wire "data"))
            (items (nativeGet data "items")) (more (nativeGet data "has_more"))
            (next (nativeGet data "page_token")))
            (unless (and (= (nativeGet response "status") 200) (= (nativeGet wire "code") 0))
              (throw (js-object :native_code (nativeGet wire "code") :http_status (nativeGet response "status"))))
            (unless (and (Array/isArray items) (<= (js-length items) 50)
              (= (nativeTypeOf more) "boolean")
              (or (not more) (and (= (nativeTypeOf next) "string") (> (js-length next) 0)
                (< (js-length seen) 1000) (not (= next token)) (not (js-call seen :includes next)))))
              (throw (new globalThis.TypeError "invalid reaction pagination")))
            (js-call items :forEach (lambda (record)
              (let ((event (normalizePolledReaction config original record)))
                ;; A new observer never turns pre-activation reactions into tasks.
                (when (>= (NativeNumber (nativeGet (nativeGet event "reaction") "action_time"))
                  (Date/parse (nativeGet checkpoint "activation_at")))
                  (js-call events :push event)))))
            (put checkpoint :reaction_before_seq (nativeGet row "seq"))
            (put checkpoint :reaction_message_id (if more message nil))
            (put checkpoint :reaction_page_token (if more next nil))
            (put checkpoint :reaction_seen_tokens (if more (progn (js-call seen :push next) seen) (js-array)))
            (js-object :events events :more t))))))
  (defasync resolveLarkReaction (config wire context port normalize-message)
    (unless (and (= (nativeGet (nativeGet wire "header") "app_id") (nativeGet config "event_app_id"))
      (= (nativeTypeOf (nativeGet (nativeGet wire "event") "message_id")) "string")
      (> (js-length (nativeGet (nativeGet wire "event") "message_id")) 0))
      (throw (new globalThis.TypeError "invalid reaction source")))
    (let* ((id (nativeGet (nativeGet wire "event") "message_id"))
      (db (nativeGet (nativeGet context "store") "db"))
      (cached (js-call (js-call db :query
        "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind IN ('message.created','message.reaction.added') AND tombstone=0 AND body_expires_at>? ORDER BY ingress_seq DESC LIMIT 1")
        :get (nativeGet config "connection_id") id (js-call (nativeGet (nativeGet context "ports") "clock") :utcNow)))
      (original (and cached (JSON/parse (nativeGet cached "payload")))))
      (when (and original (not (= (nativeGet original "identity_revision") (nativeGet config "identity_revision"))))
        (setq original nil))
      (unless original
        (let ((row (js-call (js-call db :query
          "SELECT payload FROM context_messages WHERE connection_id=? AND identity_revision=? AND native_message_id=? AND expires_at>?")
          :get (nativeGet config "connection_id") (nativeGet config "identity_revision") id
          (js-call (nativeGet (nativeGet context "ports") "clock") :utcNow))))
          (when row (setq original (JSON/parse (nativeGet row "payload"))))))
      (when (nativeGet original "reaction")
        (setq original (Object/assign (js-object) original (js-object :source_time
          (nativeGet (nativeGet original "reaction") "message_source_time" nil)))))
      (unless original
        (let* ((page (must (await (js-call port :history (js-object :message_id id) (nativeCallContext context)))))
          (rows (nativeGet page "messages")) (message (and (Array/isArray rows) (= (js-length rows) 1) (aref rows 0)))
          (sender (nativeGet message "sender")))
          (unless (and message (= (nativeGet message "message_id") id) (not (nativeGet message "deleted")))
            (throw (new globalThis.Error "reaction original message unavailable")))
          (setq original (funcall normalize-message config (js-object :type "im.message.receive_v1" :message_id id
            :chat_id (nativeGet message "chat_id") :chat_type (nativeGet message "chat_type" "unknown")
            :thread_id (nativeGet message "thread_id" nil) :root_id (nativeGet message "root_id" nil)
            :reply_to (nativeGet message "parent_id" nil) :content (nativeGet message "content")
            :create_time (nativeGet message "create_time") :sender_id (nativeGet sender "id")
            :sender_type (nativeGet sender "sender_type") :mentions (nativeGet message "mentions" (js-array))
            :sender_native_ids (js-object :open_id (nativeGet sender "id")) :sender_tenant_key (nativeGet sender "tenant_key"))))))
      (normalizeLarkReaction config wire original)))
  (export normalizeLarkReaction normalizePolledReaction pollLarkReactions resolveLarkReaction))
