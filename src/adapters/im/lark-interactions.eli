(module dj.adapters.im.lark-interactions
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../application/context.eli" nativeCallContext utcNow)
  ;; A relation is native evidence, never a textual @ or a guessed topic.
  (defun messageInteraction (config target kind)
    (let* ((sender (nativeGet target "sender")) (id (nativeGet sender "id")))
      (when (and (= (nativeTypeOf id) "string") (> (js-length id) 0))
        (js-object :kind kind :state "resolved" :target_message_id (nativeGet target "native_message_id")
          :target_id id :target_kind (nativeGet sender "kind" "unknown")
          :addressed_self (and (or (= id (nativeGet config "event_subject_id"))
            (and (= (nativeGet config "identity") "bot") (= id (nativeGet config "event_app_id"))))
            (= (nativeGet sender "kind") (if (= (nativeGet config "identity") "bot") "bot" "human")))))))
  (defasync readInteractionTarget (config id event application port normalize)
    (let* ((db (nativeGet (nativeGet application "store") "db"))
      (row (js-call (js-call db :query
        "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND event_kind='message.created' AND tombstone=0 AND body_expires_at>? AND json_extract(payload,'$.identity_revision')=? LIMIT 1")
        :get (nativeGet config "connection_id") id (utcNow application) (nativeGet config "identity_revision")))
      (target (and row (JSON/parse (nativeGet row "payload")))))
      (unless target
        (let ((cached (js-call (js-call db :query
          "SELECT payload FROM context_messages WHERE connection_id=? AND identity_revision=? AND native_message_id=? AND expires_at>?")
          :get (nativeGet config "connection_id") (nativeGet config "identity_revision") id (utcNow application))))
          (when cached (setq target (JSON/parse (nativeGet cached "payload"))))))
      ;; No network I/O inside a write transaction. Failure to resolve this
      ;; relation must not discard a perfectly readable incoming message.
      (unless target
        (try
          (let* ((response (await (js-call port :history (js-object :message_id id) (nativeCallContext application))))
            (messages (nativeGet (nativeGet response "data") "messages"))
            (message (and (nativeGet response "ok") (Array/isArray messages) (= (js-length messages) 1) (aref messages 0)))
            (sender (nativeGet message "sender")))
            (when (and message (= (nativeGet message "message_id") id) (not (nativeGet message "deleted")))
              (setq target (funcall normalize config (js-object :type "im.message.receive_v1"
                :message_id id :chat_id (nativeGet message "chat_id") :chat_type (nativeGet message "chat_type" "unknown")
                :content (nativeGet message "content") :create_time (nativeGet message "create_time")
                :sender_id (nativeGet sender "id") :sender_type (nativeGet sender "sender_type")
                :mentions (js-array))))))
          (catch error (setq target nil))))
      (and target (= (nativeGet (nativeGet target "conversation") "native_chat_id")
        (nativeGet (nativeGet event "conversation") "native_chat_id")) target)))
  (defasync resolveLarkInteraction (config event application port normalize)
    (when (= (nativeGet event "event_kind") "message.created")
      (let* ((parent (nativeGet (nativeGet event "reply_to") "id")) (root (nativeGet event "root_message_id"))
        (thread (nativeGet (nativeGet event "conversation") "native_thread_id"))
        (ids (Array/from (new globalThis.Set (js-call (js-array parent root) :filter (lambda (id)
          (and id (not (= id (nativeGet event "native_message_id")))))))))
        (index 0) (selected nil))
        ;; At most two exact targets. A direct reply to us wins; otherwise a
        ;; reply under our native topic root still counts as a response to us.
        (while (and (< index (js-length ids)) (not (nativeGet selected "addressed_self")))
          (let* ((id (aref ids index)) (kind (if (and thread (= id root)) "thread" "reply"))
            (target (await (readInteractionTarget config id event application port normalize)))
            (interaction (and target (messageInteraction config target kind))))
            (when (and interaction (or (not selected) (nativeGet interaction "addressed_self")))
              (setq selected interaction)))
          (setq index (1+ index)))
        (when (> (js-length ids) 0)
          (put event :interaction (or selected (js-object :kind (if thread "thread" "reply") :state "unavailable"
            :target_message_id (aref ids 0) :addressed_self false))))))
    event)
  (export messageInteraction resolveLarkInteraction))
