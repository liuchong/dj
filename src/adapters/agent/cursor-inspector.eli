(module dj.adapters.agent.cursor-inspector
  (import "../../core/native.eli" nativeGet nativeBitAnd nativeSetTimeout)
  (import "./desktop-transport.eli" desktopDeadline desktopError)
  (import "node:child_process" execFile)
  (import "node:fs/promises" lstat)
  (import "node:net" createConnection)

  (defasync cursorProcessInfo (endpoint context)
    (let* ((api (nativeGet endpoint "native_api")) (path (nativeGet api "process_helper_ref"))
           (info (await (lstat path))))
      (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                   (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
                   (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (desktopError "cursor_process_helper_owner")))
      (let* ((text (await (new globalThis.Promise (lambda (resolve reject)
               (execFile path (js-array (str (nativeGet api "process_id")))
                 (js-object :encoding "utf8" :maxBuffer 8192 :timeout (Math/ceil (desktopDeadline context)))
                 (lambda (error stdout stderr)
                   (if error (funcall reject (desktopError "cursor_process_metadata")) (funcall resolve stdout))))))))
             (record (JSON/parse text)))
        (unless (and (= (nativeGet record "pid") (nativeGet api "process_id"))
                     (= (nativeGet record "uid") (js-call globalThis.process :getuid))
                     (= (nativeGet record "birth") (nativeGet api "process_birth"))
                     (= (nativeGet record "caught") t)
                     (js-call (nativeGet record "executable" "") :endsWith ".app/Contents/MacOS/Cursor"))
          (throw (desktopError "desktop_target_changed")))
        record)))
  (defasync cursorInspectorListening (endpoint)
    (let ((url (new globalThis.URL (nativeGet (nativeGet endpoint "native_api") "inspector_url"))))
      (await (new globalThis.Promise (lambda (resolve reject)
        (let* ((socket (createConnection (js-object :host "127.0.0.1" :port (nativeGet url "port"))))
               (done false) (finish nil))
          (setq finish (lambda (error value)
            (unless done
              (setq done t)
              (js-call socket :destroy)
              (if error (funcall reject error) (funcall resolve value)))))
          (js-call socket :once "connect" (lambda () (funcall finish nil t)))
          (js-call socket :once "error" (lambda (error)
            (if (= (nativeGet error "code") "ECONNREFUSED")
              (funcall finish nil false) (funcall finish (desktopError "cursor_inspector_port") nil))))
          (js-call socket :setTimeout 300 (lambda () (funcall finish (desktopError "cursor_inspector_port") nil)))))))))
  (defasync openCursorInspector (endpoint context ownership)
    (when (= (nativeGet (nativeGet endpoint "native_api") "manage_inspector") t)
      (unless (and (= (nativeGet globalThis.process "platform") "darwin")
                   (= (nativeGet (new globalThis.URL
                     (nativeGet (nativeGet endpoint "native_api") "inspector_url")) "port") "9229"))
        (throw (desktopError "cursor_inspector_platform")))
      (await (cursorProcessInfo endpoint context))
      (when (await (cursorInspectorListening endpoint)) (throw (desktopError "cursor_native_debugger_busy")))
      (desktopDeadline context)
      ;; Ownership is recorded before signaling so every post-signal failure
      ;; still enters the close path. The helper never sends any signal.
      (put ownership :issued t)
      (js-call globalThis.process :kill (nativeGet (nativeGet endpoint "native_api") "process_id") "SIGUSR1")
      (let ((attempt 0) (ready false))
        (while (and (not ready) (< attempt 30))
          (desktopDeadline context)
          (setq ready (await (cursorInspectorListening endpoint)))
          (unless ready (await (new globalThis.Promise (lambda (resolve) (nativeSetTimeout resolve 40)))))
          (setq attempt (1+ attempt)))
        (unless ready (throw (desktopError "cursor_inspector_open"))))))
  (export cursorProcessInfo cursorInspectorListening openCursorInspector))
