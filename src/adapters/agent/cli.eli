(module dj.adapters.agent.cli
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" utf8Bytes sliceUtf8)
  (import "../../core/errors.eli" failure)
  (import "../../delivery/envelope.eli" encodeEnvelope)
  (import "./json-rpc.eli" createJsonRpcChannel rpcError)

  (defun createCliPort (tool config host)
    (unless (js-call (js-array "codex" "cursor") :includes tool)
      (throw (new globalThis.TypeError "Unsupported CLI tool")))
    (let ((records (new globalThis.Map)) (launches (new globalThis.Map))
          (capabilities (js-object :session_list "supported" :session_messages "supported"
            :session_probe "supported" :session_send "supported" :start_idle "supported"
            :session_create "supported" :instance_start "supported" :instance_stop "supported"
            :lookup_send "positive_only" :native_idempotency "unsupported" :lookup_create "unsupported"
            :observe "supported" :max_input_frame_bytes 262144))
          (exact nil) (sessionRecord nil) (create nil) (start nil) (inspect nil)
          (event nil) (accept nil) (finish nil) (append nil) (page nil) (stop nil))
      (setq exact (lambda (target)
        (let ((record (js-call records :get (nativeGet target "instance_id"))))
          (unless (and record (= (nativeGet target "instance_epoch") (nativeGet record "instance_epoch"))
              (or (not (nativeGet target "tool")) (= tool (nativeGet target "tool")))
              (or (not (nativeGet target "native_namespace"))
                  (= (nativeGet target "native_namespace") (nativeGet record "native_namespace"))))
            (throw (rpcError "cli_target_changed")))
          record)))
      (setq sessionRecord (lambda (record session)
        (let ((channel (nativeGet record "channel")))
          (js-object :tool tool :native_namespace (nativeGet record "native_namespace")
            :native_session_id (nativeGet session "id") :instance_id (nativeGet record "instance_id")
            :instance_epoch (nativeGet record "instance_epoch")
            :workspace_ref (nativeGet session "workspace_ref")
            :title (nativeGet session "title" "") :surface "cli" :visibility (js-array "live" "managed" "history")
            :runtime_state (cond ((nativeGet record "exited") "offline")
              ((or (not channel) (nativeGet record "uncertain") (js-call channel :isClosed)) "unknown")
              ((> (js-call channel :pendingRequests) 0) "waiting_permission")
              ((nativeGet record "active") "busy") (t "idle"))
            :live_receiver (and channel (not (nativeGet record "exited")) (not (js-call channel :isClosed)))
            :coverage "covered" :capabilities capabilities :evidence_level "native_protocol"))))
      (setq append (lambda (session id role text)
        (when (= (nativeTypeOf text) "string")
          (let ((rows (nativeGet session "messages")) (size (utf8Bytes text)))
            (when (> size 1048576) (put session :partial t) (setq text (sliceUtf8 text 1048576)))
            (js-call rows :push (js-object :native_message_id id :role role :text text))
            (put session :bytes (+ (nativeGet session "bytes" 0) (utf8Bytes text)))
            (while (or (> (js-length rows) 1000) (> (nativeGet session "bytes") 4194304))
              (let ((removed (js-call rows :shift)))
                (put session :bytes (- (nativeGet session "bytes") (utf8Bytes (nativeGet removed "text")))))
              (put session :partial t))))))
      (setq accept (lambda (record ref)
        (let ((active (nativeGet record "active")))
          (when active
            (unless (nativeGet active "receipt")
              (let ((session (js-call (nativeGet record "sessions") :get (nativeGet active "session_id"))))
                (funcall append session (nativeGet active "key") "user" (nativeGet active "text"))))
            (let ((receipt (js-object :state "accepted" :kind "accepted" :native_ref ref
                    :native_receipt_key (nativeGet active "key") :evidence_level "native_protocol")))
              (put active :receipt receipt)
              (js-call (nativeGet record "inputs") :set (nativeGet active "key") receipt)
              (when (nativeGet active "resolve") (funcall (nativeGet active "resolve") receipt))
              (when (> (nativeGet (nativeGet record "inputs") "size") 1024)
                (js-call (nativeGet record "inputs") :delete
                  (nativeGet (js-call (js-call (nativeGet record "inputs") :keys) :next) "value"))))))))
      (setq finish (lambda (record ref)
        (when (nativeGet record "active")
          (funcall accept record ref)
          (when (< (js-length (nativeGet record "facts")) 1024)
            (js-call (nativeGet record "facts") :push (js-object :kind "settled" :native_ref ref
              :native_receipt_key (str (nativeGet (nativeGet record "active") "key") ":settled")
              :evidence_level "native_protocol")))
          (put record :active nil) (put record :uncertain false))))
      (setq event (lambda (record wire permission)
        (let* ((params (nativeGet wire "params")) (method (nativeGet wire "method"))
               (active (nativeGet record "active")))
          (when (and active permission (= tool "cursor")
              (= (nativeGet params "sessionId") (nativeGet active "session_id")))
            (funcall accept record (nativeGet active "ref")))
          (if (= tool "codex")
            (when (and active (= (nativeGet params "threadId") (nativeGet active "session_id")))
              (when (= method "item/completed")
                (let* ((item (nativeGet params "item"))
                       (session (js-call (nativeGet record "sessions") :get (nativeGet params "threadId"))))
                  (when (and session (= (nativeGet item "type") "agentMessage"))
                    (funcall append session (nativeGet item "id") "assistant" (nativeGet item "text")))))
              (when (= method "turn/completed")
                (let ((ref (nativeGet (nativeGet params "turn") "id")))
                  (if (nativeGet active "ref") (funcall finish record ref)
                    (put active :early_completed ref)))))
            (when (and active (= method "session/update")
                       (= (nativeGet params "sessionId") (nativeGet active "session_id")))
              (let* ((update (nativeGet params "update")) (type (nativeGet update "sessionUpdate")))
                (when (js-call (js-array "agent_message_chunk" "agent_thought_chunk" "tool_call") :includes type)
                  (funcall accept record (nativeGet active "ref")))
                (when (and (= type "agent_message_chunk") (= (nativeGet (nativeGet update "content") "type") "text"))
                  (let ((text (str (nativeGet active "output" "") (nativeGet (nativeGet update "content") "text" ""))))
                    (if (> (utf8Bytes text) 1048576)
                      (progn (put active :output (sliceUtf8 text 1048576)) (put active :partial t))
                      (put active :output text))))))))))
      (setq inspect (async (instance token context)
        (let ((record (js-call launches :get token)))
          (if (and record (= (nativeGet record "instance_id") (nativeGet instance "instance_id"))
                   (= (nativeGet record "instance_epoch") (nativeGet instance "instance_epoch")))
            (js-object :state (cond ((nativeGet record "exited") "stopped")
                 ((and (nativeGet record "initialized") (not (js-call (nativeGet record "channel") :isClosed))) "ready")
                 (t "unknown"))
              :launch_token token :ownership "managed" :pid (nativeGet (nativeGet record "child") "pid")
              :process_birth token :native_namespace (nativeGet record "native_namespace")
              :absence_verified (= (nativeGet record "exited") t) :evidence_level "native_protocol")
            (js-object :state "unknown" :launch_token token :ownership "managed" :absence_verified false)))))
      (setq start (async (profile token context)
        (if (js-call launches :has token) (await (funcall inspect profile token context))
          (let* ((trusted (js-call (nativeGet config "profiles") :find
                  (lambda (row) (and (= (nativeGet row "profile_id") (nativeGet profile "profile_id"))
                                    (= (nativeGet row "revision") (nativeGet profile "revision"))))))
                 (id (nativeGet profile "instance_id"))
                 (previous (js-call records :get id)))
            (unless (and trusted (or (not previous) (nativeGet previous "exited")))
              (throw (rpcError "cli_profile_conflict")))
            (let* ((child (js-call (nativeGet host "process") :spawn (nativeGet trusted "argv")
                    (js-object :cwd (nativeGet trusted "cwd") :launch_token token
                      :env (Object/assign (js-object) (nativeGet globalThis.process "env")
                             (nativeGet trusted "env" (js-object))) :stdin "pipe" :stdout "pipe" :stderr "pipe")))
                   (record (js-object :profile trusted :child child :instance_id id
                     :instance_epoch (nativeGet profile "instance_epoch")
                     :native_namespace (nativeGet trusted "native_namespace") :launch_token token
                     :sessions (new globalThis.Map) :inputs (new globalThis.Map) :facts (js-array)
                     :active nil :exited false :initialized false))
                   (channel (createJsonRpcChannel child (nativeGet host "clock")
                     (lambda (wire permission) (funcall event record wire permission)))))
              (put record :channel channel)
              (js-call records :set id record) (js-call launches :set token record)
              (js-call (nativeGet child "exited") :then (lambda (code) (put record :exited t)))
              (try
                (let ((initialized (await (js-call channel :request "initialize"
                  (if (= tool "codex")
                    (js-object :clientInfo (js-object :name "dj" :version "0.1.0"))
                    (js-object :protocolVersion 1 :clientInfo (js-object :name "dj" :version "0.1.0")
                      :clientCapabilities (js-object :fs (js-object :readTextFile false :writeTextFile false) :terminal false))) context))))
                  (when (nativeGet trusted "auth_method")
                    (unless (js-call (nativeGet initialized "authMethods" (js-array)) :some
                      (lambda (method) (= (nativeGet method "id") (nativeGet trusted "auth_method"))))
                      (throw (rpcError "cli_auth_method_unavailable")))
                    (await (js-call channel :request "authenticate"
                      (js-object :methodId (nativeGet trusted "auth_method")) context))))
                (when (= tool "codex") (await (js-call channel :notify "initialized" (js-object))))
                (put record :initialized t)
                (await (funcall inspect profile token context))
                (catch error
                  (js-call child :kill "SIGTERM")
                  (js-object :state "unknown" :launch_token token :ownership "managed"
                    :absence_verified false :reason "native_initialization_failed"))))))))
      (setq create (async (instance workspace key context)
        (let* ((record (funcall exact instance)) (profile (nativeGet record "profile")))
          (unless (and (< (nativeGet (nativeGet record "sessions") "size") 128)
                       (nativeGet record "initialized") (not (nativeGet record "exited"))
                       (js-call (nativeGet profile "workspace_refs") :includes workspace)
                       (not (nativeGet record "active")))
            (throw (rpcError "cli_create_unavailable")))
          (let* ((answer (await (js-call (nativeGet record "channel") :request
                    (if (= tool "codex") "thread/start" "session/new")
                    (if (= tool "codex") (js-object :cwd (nativeGet profile "cwd"))
                      (js-object :cwd (nativeGet profile "cwd") :mcpServers (js-array))) context)))
                 (id (if (= tool "codex") (nativeGet (nativeGet answer "thread") "id") (nativeGet answer "sessionId"))))
            (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0))
              (throw (rpcError "cli_invalid_session")))
            (let ((session (js-object :id id :title (nativeGet context "title" "")
                             :messages (js-array) :bytes 0 :workspace_ref workspace)))
              (js-call (nativeGet record "sessions") :set id session)
              (js-object :state "ready" :creation_key key :session (funcall sessionRecord record session)
                :evidence_level "native_protocol"))))))
      (setq page (lambda (rows cursor budget complete)
        (let* ((offset (nativeGet cursor "offset" 0))
               (limit (Math/min 100 (nativeGet budget "max_records" 100)))
               (end offset) (bytes 0) (items (js-array)))
          (unless (and (Number/isSafeInteger offset) (>= offset 0) (<= offset (js-length rows)))
            (throw (rpcError "cli_stale_cursor")))
          (while (and (< end (js-length rows)) (< (js-length items) limit)
              (<= (+ bytes (utf8Bytes (JSON/stringify (aref rows end)))) (nativeGet budget "max_bytes" 1048576)))
            (setq bytes (+ bytes (utf8Bytes (JSON/stringify (aref rows end)))))
            (js-call items :push (aref rows end)) (setq end (1+ end)))
          (when (and (< end (js-length rows)) (= end offset)) (throw (rpcError "cli_page_limit")))
          (js-object :items items :complete (and complete (= end (js-length rows)))
            :coverage (if complete "covered" "partial")
            :next_cursor (if (< end (js-length rows)) (js-object :offset end) nil)))))
      (setq stop (async (instance budget context)
        (let* ((record (funcall exact instance)) (child (nativeGet record "child")))
          (if (or (nativeGet record "active") (> (js-call (nativeGet record "channel") :pendingRequests) 0))
            (js-object :state "draining" :absence_verified false)
            (progn
              (unless (nativeGet record "exited")
                (js-call (nativeGet child "stdin") :end)
                (js-call child :kill "SIGTERM")
                (let ((timer nil))
                  (try (await (Promise/race (js-array (nativeGet child "exited")
                    (new globalThis.Promise (lambda (resolve reject)
                      (setq timer (nativeSetTimeout resolve (Math/max 1 (Math/min 5000
                        (- (nativeGet budget "deadline" (nativeGet context "deadline"))
                           (js-call (nativeGet host "clock") :monoNow)))))))))))
                    (finally (nativeClearTimeout timer)))))
              (js-object :state (if (nativeGet record "exited") "stopped" "draining")
                :absence_verified (= (nativeGet record "exited") t) :evidence_level "native_protocol"))))))
      (js-object :capabilities capabilities :start start :create create :inspectInstance inspect :stop stop
        :probeInstance (async (instance context)
          (try (let ((record (funcall exact instance)))
            (await (funcall inspect instance (nativeGet record "launch_token") context)))
            (catch error (js-object :state "unknown" :evidence_level "none"))))
        :probe (async (target binding context)
          (try (let* ((record (funcall exact binding))
                      (session (js-call (nativeGet record "sessions") :get (nativeGet target "native_session_id"))))
            (if session (funcall sessionRecord record session) (js-object :runtime_state "offline" :live_receiver false)))
            (catch error (js-object :runtime_state "unknown" :live_receiver false))))
        :listSessions (async (scope cursor budget context)
          (let ((rows (js-array)))
            (js-call records :forEach (lambda (record)
              (when (or (not (nativeGet scope "instance_ids"))
                        (js-call (nativeGet scope "instance_ids") :includes (nativeGet record "instance_id")))
                (js-call (nativeGet record "sessions") :forEach (lambda (session)
                  (when (or (not (nativeGet scope "workspace_refs"))
                    (js-call (nativeGet scope "workspace_refs") :includes (nativeGet session "workspace_ref")))
                    (js-call rows :push (funcall sessionRecord record session))))))))
            (funcall page rows cursor budget t)))
        :readMessages (async (target cursor budget context)
          (let* ((record (funcall exact target))
                 (session (js-call (nativeGet record "sessions") :get (nativeGet target "native_session_id"))))
            (unless session (throw (rpcError "cli_session_missing")))
            (when (and cursor (nativeGet session "partial")) (throw (rpcError "cli_stale_cursor")))
            (funcall page (nativeGet session "messages") cursor budget (not (nativeGet session "partial")))))
        :submit (async (binding envelope mode key context)
          (let ((written false))
            (try
              (let* ((record (funcall exact binding))
                     (session (js-call (nativeGet record "sessions") :get (nativeGet binding "native_session_id")))
                     (prior (js-call (nativeGet record "inputs") :get key)))
                (if prior prior
                  (progn
                    (unless (and session (= mode "start_idle")
                        (= (nativeGet (funcall sessionRecord record session) "runtime_state") "idle"))
                      (throw (rpcError "cli_not_idle")))
                    (let* ((text (encodeEnvelope envelope 250000))
                           (active (js-object :key key :text text :session_id (nativeGet session "id")
                                     :ref (if (= tool "cursor") key nil)))
                           (receipt nil) (timer nil))
                      (put record :active active)
                      (setq written t)
                      (if (= tool "codex")
                        (let* ((result (await (js-call (nativeGet record "channel") :request "turn/start"
                                 (js-object :threadId (nativeGet session "id")
                                   :input (js-array (js-object :type "text" :text text :text_elements (js-array)))) context)))
                               (ref (nativeGet (nativeGet result "turn") "id")))
                          (unless (= (nativeTypeOf ref) "string") (throw (rpcError "cli_unknown_receipt")))
                          (put active :ref ref) (funcall accept record ref)
                          (setq receipt (nativeGet active "receipt"))
                          (when (nativeGet active "early_completed") (funcall finish record ref))
                          receipt)
                        (let* ((accepted (new globalThis.Promise (lambda (resolve reject)
                                  (put active :resolve resolve)
                                  (setq timer (nativeSetTimeout (lambda () (funcall reject (rpcError "cli_prompt_unknown")))
                                    (Math/max 1 (- (nativeGet context "deadline") (js-call (nativeGet host "clock") :monoNow))))))))
                               (operation (js-call (nativeGet record "channel") :request "session/prompt"
                                 (js-object :sessionId (nativeGet session "id")
                                   :prompt (js-array (js-object :type "text" :text text)))
                                 (js-object :deadline (+ (js-call (nativeGet host "clock") :monoNow) 3600000)))))
                          (js-call operation :then (lambda (result)
                            (when (= (nativeGet record "active") active)
                              (when (nativeGet active "partial") (put session :partial t))
                              (when (nativeGet active "output")
                                (funcall append session (str key ":assistant") "assistant" (nativeGet active "output")))
                              (funcall finish record key)))
                            (lambda (error)
                              (unless (nativeGet active "receipt")
                                (put record :uncertain t))
                              (put record :uncertain t)))
                          (try (await accepted) (finally (nativeClearTimeout timer)))))))))
              (catch error
                (js-object :state (if written "unknown" "failed") :kind (if written "unknown" "rejected")
                  :definite_not_sent (not written) :retryable (not written) :evidence_level "none")))))
        :lookup (async (binding key ref context)
          (try (let ((record (funcall exact binding)))
            (or (js-call (nativeGet record "inputs") :get key)
              (js-object :state "unknown" :definite_not_sent false :evidence_level "none")))
            (catch error (js-object :state "unknown" :definite_not_sent false))))
        :lookupCreate (async (instance key ref context) (js-object :state "unknown" :definite_not_sent false))
        :observe (async (binding ref cursor budget context)
          (let* ((record (funcall exact binding))
                 (rows (js-call (nativeGet record "facts") :filter
                   (lambda (row) (or (not ref) (= ref (nativeGet row "native_ref")))))))
            (funcall page rows cursor budget false)))
        :discover (async (visibility options context)
          (let ((record (js-call records :get (nativeGet options "instance_id"))) (rows (js-array)))
            (unless record (throw (rpcError "cli_instance_missing")))
            (js-call (nativeGet record "sessions") :forEach (lambda (session)
              (js-call rows :push (funcall sessionRecord record session))))
            (funcall page rows (nativeGet options "cursor") (js-object) t)))
        :pendingWork (lambda () (js-call (Array/from (js-call records :values)) :filter
          (lambda (record) (not (nativeGet record "exited")))))
        :close (async () (js-object :state (if (js-call (Array/from (js-call records :values))
          :some (lambda (record) (not (nativeGet record "exited")))) "draining" "stopped"))))))
  (export createCliPort))
