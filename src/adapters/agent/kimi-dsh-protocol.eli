(module dj.adapters.agent.kimi-dsh-protocol
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeEncodeURIComponent)
  (import "./existing-local.eli" localHttp localWorkRpc)
  (import "./desktop-transport.eli" desktopError)
  (import "node:crypto" randomUUID)
  (defun nativeTextParts (parts &optional work)
    (js-call (js-call (js-call (or parts (js-array)) :filter (lambda (part)
      (and (= (nativeGet part (if work "kind" "type")) "text") (= (nativeTypeOf (nativeGet part "text")) "string")
        (not (js-call (new globalThis.RegExp "^\\s*<(?:hook_result|system-reminder)") :test (nativeGet part "text"))))))
      :map (lambda (part) (nativeGet part "text"))) :join "\n"))
  (defun createNativeClient (endpoint context)
    (let ((provider (nativeGet endpoint "native_provider")) (protocol nil) (epoch nil)
      (http nil) (work nil) (dsh nil) (api nil) (connect nil) (listing nil) (snapshot nil))
      (setq http (async (path body &optional write-state)
        (let* ((response (await (localHttp endpoint path body (Object/assign (js-object) context
          (if epoch (js-object :instance_epoch epoch) (js-object))
          (if write-state (js-object :write_state write-state) (js-object))))))
          (received (nativeGet response "instance_epoch")))
          (when (and epoch (not (= epoch received))) (throw (desktopError "local_agent_generation")))
          (setq epoch received) (nativeGet response "data"))))
      (setq work (async (method args &optional write-state)
        (let* ((response (await (localWorkRpc endpoint method args (Object/assign (js-object) context
          (if epoch (js-object :instance_epoch epoch) (js-object))
          (if write-state (js-object :write_state write-state) (js-object))))))
          (received (nativeGet response "instance_epoch")))
          (when (and epoch (not (= epoch received))) (throw (desktopError "local_agent_generation")))
          (setq epoch received) (nativeGet response "data"))))
      (setq api (async (path &optional body write-state)
        (let ((value (await (funcall http (str "/api/v1/" path) body write-state))))
          (unless (and (= (nativeGet value "code") 0) (object-has? value "data"))
            (throw (desktopError "local_agent_kimi_api"))) (nativeGet value "data"))))
      (setq dsh (async (name args &optional write-state)
        (let* ((method (str (if (= protocol "typert") "session/" "session.") name)) (id (randomUUID))
          (value (await (funcall http (str "/api/" method) (js-object :type "client-request" :rpcId id :method method
            :payload (if (= protocol "typert") (js-object :args args) args)) write-state))))
          (unless (and (= (nativeGet value "type") "server-response") (= (nativeGet value "rpcId") id)
            (= (nativeGet (nativeGet value "result") "ok") t)) (throw (desktopError "local_agent_dsh_rpc")))
          (nativeGet (nativeGet value "result") "value"))))
      (setq connect (async ()
        (cond ((= provider "kimi-desktop")
          (let ((value (await (funcall work "capabilities.get" (js-object)))))
            (unless (and (= (nativeGet value "protocolVersion") "control.v1") (= (nativeGet value "defaultAgentId") "main")
              (= (nativeGet (nativeGet value "flags") "clientOriginConversations") t))
              (throw (desktopError "local_agent_work_capabilities"))) (setq protocol "work")))
          ((= provider "kimi-web")
            (unless (nativeGet (await (funcall api "meta")) "server_id") (throw (desktopError "local_agent_kimi_meta")))
            (setq protocol "kimi"))
          (t (setq protocol "typert")
            (try (await (funcall dsh "list" (js-object :_request (js-object))))
              (catch error (if (= (nativeGet error "status") 404)
                (progn (setq protocol "legacy") (await (funcall dsh "list" (js-object)))) (throw error))))))
        epoch))
      (setq listing (async (cursor limit)
        (cond ((= protocol "work")
          (let* ((args (js-object :agentId "main" :origin "client" :limit limit))
            (value nil))
            (when cursor (put args :cursor cursor))
            (setq value (await (funcall work "conversations.list" args)))
            (let ((items (nativeGet value "conversations")) (page (nativeGet value "page")))
              (unless (and (Array/isArray items) (<= (js-length items) limit)
                (js-call items :every (lambda (row) (= (nativeGet row "origin") "client"))))
                (throw (desktopError "local_agent_work_list")))
              (js-object :items (js-call items :map (lambda (row) (Object/assign (js-object) row
                (js-object :id (nativeGet row "conversationKey") :directory (nativeGet row "workspacePath")))))
                :next (and (nativeGet page "hasMore") (nativeGet page "nextCursor"))))))
          ((= protocol "kimi")
            (let ((query (new globalThis.URLSearchParams (js-object :page_size (str limit) :include_archive "true" :exclude_empty "false"))))
              (when cursor (js-call query :set "before_id" cursor))
              (let* ((value (await (funcall api (str "sessions?" (js-call query :toString))))) (items (nativeGet value "items")))
                (unless (and (Array/isArray items) (<= (js-length items) limit)) (throw (desktopError "local_agent_kimi_list")))
                (js-object :items (js-call items :map (lambda (row) (Object/assign (js-object) row
                  (js-object :directory (nativeGet (nativeGet row "metadata") "cwd")))))
                  :next (and (nativeGet value "has_more") (> (js-length items) 0) (nativeGet (aref items (1- (js-length items))) "id"))))))
          (t (let* ((value (await (funcall dsh "list" (if (= protocol "typert") (js-object :_request (js-object)) (js-object)))))
            (items (nativeGet value "items")))
            (unless (Array/isArray items) (throw (desktopError "local_agent_dsh_list")))
            (setq items (js-call (js-call (js-call items :filter (lambda (row) (> (nativeGet row "sessionId") (or cursor ""))))
              :sort (lambda (a b) (if (= (nativeGet a "sessionId") (nativeGet b "sessionId")) 0 (if (< (nativeGet a "sessionId") (nativeGet b "sessionId")) -1 1)))) :map (lambda (row)
                (Object/assign (js-object) row (js-object :id (nativeGet row "sessionId") :directory (nativeGet row "cwd") :native_protocol protocol
                  :title (nativeGet (nativeGet (nativeGet row "projections") "values") "title" (nativeGet row "title" "DSH")))))))
            (js-object :items (js-call items :slice 0 limit)
              :next (and (> (js-length items) limit) (nativeGet (aref items (1- limit)) "id"))))))))
      (setq snapshot (async (id)
        (when (or (not (= (nativeTypeOf id) "string")) (= (js-length id) 0) (> (js-length id) 1024))
          (throw (desktopError "local_agent_session_id")))
        (if (= protocol "kimi")
          (let ((value (await (funcall api (str "sessions/" (nativeEncodeURIComponent id) "/snapshot")))))
            (unless (= (nativeGet (nativeGet value "session") "id") id) (throw (desktopError "local_agent_session_mismatch")))
            (Object/assign (js-object) (nativeGet value "session") (js-object :directory (nativeGet (nativeGet (nativeGet value "session") "metadata") "cwd"))))
          (let ((cursor nil) (found nil) (steps 0))
            (while (and (not found) (< steps 100))
              (let* ((page (await (funcall listing cursor 100))) (next (nativeGet page "next")))
                (setq found (js-call (nativeGet page "items") :find (lambda (row) (= (nativeGet row "id") id))))
                (when (or (not next) (= next cursor)) (setq steps 100)) (setq cursor next steps (1+ steps))))
            (unless found (throw (desktopError "local_agent_session_missing")))
            (when (= protocol "work")
              (let ((busy (await (funcall work "conversations.getBusy" (js-object :agentId "main" :conversationKey id)))))
                (unless (= (nativeGet busy "conversationKey") id) (throw (desktopError "local_agent_session_mismatch")))
                (Object/assign found busy))) found))))
      (js-object :connect connect :list listing :snapshot snapshot :api api :work work :dsh dsh
        :protocol (lambda () protocol) :epoch (lambda () epoch)
        :request (async (name args &optional state)
          (funcall dsh name (if (= protocol "typert") (js-object :request args) args) state)))))
  (export createNativeClient nativeTextParts))
