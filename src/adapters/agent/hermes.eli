(module dj.adapters.agent.hermes
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/limits.eli" limits)
  (import "../../host/bun/response.eli" readJson)
  (import "./gateway-channel.eli" gatewayDeadline)
  (import "node:path" isAbsolute)

  (defun sessionPath (id)
    (unless (and (= (nativeTypeOf id) "string") (js-call (new globalThis.RegExp "^[A-Za-z0-9_-]{1,256}$") :test id))
      (throw (new globalThis.TypeError "Invalid Hermes session id")))
    (str "/api/sessions/" id))

  (defasync fetchSession (host channel path context)
    (let* ((deadline (gatewayDeadline host context))
      (signal (nativeGet context "abort_signal"))
      (url (new globalThis.URL path (nativeGet channel "url"))))
      (unless (and (> deadline 0) (not (nativeGet signal "aborted")) (not (js-call channel :closed)))
        (throw (new globalThis.Error "Hermes request unavailable")))
      (let* ((timeout (js-call globalThis.AbortSignal :timeout (Math/ceil deadline)))
        (response (await (js-call (nativeGet host "http") :fetch url
          (js-object :redirect "error" :headers (js-object :authorization (str "Bearer " (nativeGet channel "token")))
            :signal (if signal (js-call globalThis.AbortSignal :any (js-array timeout signal)) timeout))))))
        (if (= (nativeGet response "status") 404) nil
          (progn
            (unless (and (nativeGet response "ok") (not (js-call channel :closed)))
              (throw (new globalThis.Error "Hermes HTTP request failed")))
            (await (readJson response (nativeGet limits "native_response_max_bytes"))))))))

  (defun archived (row)
    (js-call (js-array 1 t) :includes (nativeGet row "archived")))

  (defun projectRow (row state)
    (let ((directory (nativeGet row "cwd")))
      (js-object :id (nativeGet row "id") :title (nativeGet row "title" "")
        :directory (if (and (= (nativeTypeOf directory) "string") (isAbsolute directory)) directory nil)
        :model_id (nativeGet row "model" nil) :provider_id (nativeGet row "billing_provider" nil)
        :live_receiver (not (archived row)) :runtime_state state)))

  (defun hermesState (status)
    (cond ((= status "waiting") "waiting_permission")
      ((js-call (js-array "working" "starting") :includes status) "busy")
      (t "idle")))

  (defasync activeSession (channel id context)
    (let ((result (await (js-call channel :request "session.active_list" (js-object) context))))
      (js-call (nativeGet result "sessions") :find (lambda (row) (= (nativeGet row "session_key") id)))))

  ;; The REST id is durable. The JSON-RPC id identifies its live attachment only.
  (defasync attachSession (channel row context)
    (let* ((id (nativeGet row "id"))
      (result (await (js-call channel :request "session.resume"
        (js-object :session_id id :omit_messages t :inline_images false) context))))
      (unless (and (= (nativeGet result "session_key") id) (nativeGet result "session_id"))
        (throw (new globalThis.Error "Hermes resumed a different conversation")))
      (nativeGet result "session_id")))

  (defun createHermesProtocol (host)
    (let ((inspect (async (channel id context)
      (let ((row (await (fetchSession host channel (sessionPath id) context))))
        (when (and (= (nativeGet row "id") id) (not (archived row)))
          (let ((live (await (activeSession channel id context))))
            (projectRow row (hermesState (nativeGet live "status")))))))))
      (js-object :token (lambda (value) value)
        :list (async (channel cursor limit context)
          (let* ((offset (or cursor 0))
            (result (await (fetchSession host channel
              (str "/api/sessions?order=recent&exclude_sources=cron&limit=" limit "&offset=" offset) context)))
            (rows (nativeGet result "sessions")))
            (unless (Array/isArray rows) (throw (new globalThis.Error "Invalid Hermes session list")))
            (let ((next (+ offset (js-length rows))))
              (js-object :items (js-call rows :map (lambda (row) (projectRow row "unknown")))
                :next (when (and (> next offset) (< next (nativeGet result "total"))) next)))))
        :inspect inspect
        :create (async (channel directory title selection key context before-send)
          (let ((params (js-object :cwd directory :source "desktop" :idempotency_key key)))
            (when (nativeGet selection "variant")
              (throw (new globalThis.TypeError "This gateway does not accept model variant")))
            (when selection
              (put params :model (nativeGet selection "model_id"))
              (put params :provider (nativeGet selection "provider_id"))
              (when (nativeGet selection "reasoning_effort")
                (put params :reasoning_effort (nativeGet selection "reasoning_effort"))))
            (let* ((result (await (js-call channel :request "session.create" params context before-send)))
              (id (nativeGet result "stored_session_id")) (live (nativeGet result "session_id"))
              (actual-directory (nativeGet (nativeGet result "info") "cwd")))
              (unless (and id live (= directory actual-directory))
                (throw (new globalThis.Error "Hermes creation workspace unconfirmed")))
              ;; An explicit title persists the draft, allowing exact REST lookup before its first turn.
              (let ((named (await (js-call channel :request "session.title"
                (js-object :session_id live :title (or title "Untitled")) context))))
                (when (and (= (nativeGet named "pending") false) (= (nativeGet named "title") (or title "Untitled")))
                  (await (funcall inspect channel id context)))))))
        :rename (async (channel row title context)
          (let* ((id (nativeGet row "id")) (live (await (attachSession channel row context)))
            (result (await (js-call channel :request "session.title" (js-object :session_id live :title title) context))))
            (when (and (= (nativeGet result "pending") false) (= (nativeGet result "title") title))
              (await (funcall inspect channel id context)))))
        :submit (async (channel row text mode key context before-send)
          (let* ((live (await (attachSession channel row context)))
            (result (await (js-call channel :request "prompt.submit"
              (js-object :session_id live :text text :queued (= mode "steer")) context before-send))))
            (when (js-call (js-array "streaming" "queued") :includes (nativeGet result "status"))
              (or (nativeGet result "admission_id") (when (Number/isSafeInteger (nativeGet result "user_row_id"))
                (str "user-row:" (nativeGet result "user_row_id")))))))
        :history (async (channel row cursor limit max-bytes context)
          (let* ((id (nativeGet row "id")) (offset (or cursor 0))
            (result (await (fetchSession host channel
              (str (sessionPath id) "/messages?inline_images=false&order=latest&offset=" offset "&limit=" limit)
              context)))
            (rows (nativeGet result "messages")))
            (unless (and (= (nativeGet result "session_id") id) (Array/isArray rows))
              (throw (new globalThis.Error "Hermes history resolved to a different session")))
            (js-object :next (when (= (js-length rows) limit) (+ offset limit))
              :items (js-call rows :map (lambda (message)
                (js-object :id (nativeGet message "message_uid" nil)
                  :role (nativeGet message "role" nil) :content (nativeGet message "content" nil))))))))))
  (export createHermesProtocol))
