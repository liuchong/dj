(module dj.adapters.agent.antigravity
  (import "../../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "../../core/types.eli" utf8Bytes hashValue)
  (import "../../delivery/envelope.eli" renderEnvelope)
  (import "./native-local.eli" antigravityRpc expectedEpoch)
  (import "../../lifecycle/workspaces.eli" creationWorkspace)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:path" isAbsolute)
  (defconst antigravityCapabilities (Object/freeze
    (js-object :session_list "supported" :session_messages "supported" :session_probe "supported"
      :session_send "supported" :start_idle "supported" :message_during_run "supported" :max_dispatch_burst 32 :session_create "supported" :session_rename "supported" :creation_model_selection "supported"
      :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "unsupported"
      :lookup_send "unsupported" :lookup_create "positive_only" :observe "unsupported" :max_input_frame_bytes 262144)))
  (defun cascadeCreationId (key)
    (let ((hex (hashValue (js-array "dj-antigravity-create" key))))
      (str (js-call hex :slice 0 8) "-" (js-call hex :slice 8 12) "-5"
        (js-call hex :slice 13 16) "-a" (js-call hex :slice 17 20) "-" (js-call hex :slice 20 32))))
  (defun cascadeModel (selection)
    (let ((value (nativeGet selection "model_id" nil)))
      (when value
        (unless (and (= (nativeTypeOf value) "string")
          (js-call (new globalThis.RegExp "^(?:MODEL_[A-Z0-9_]+|[1-9][0-9]{0,8})$") :test value)
          (not (= value "MODEL_UNSPECIFIED"))
          (not (nativeGet selection "variant")) (not (nativeGet selection "reasoning_effort")))
          (throw (new globalThis.TypeError "Antigravity requires an exact native model enum without variant overrides")))
        (if (js-call (new globalThis.RegExp "^[0-9]+$") :test value) (NativeNumber value) value))))
  (defun cascadeState (status)
    (cond ((= status "CASCADE_RUN_STATUS_IDLE") "idle")
      ((= status "CASCADE_RUN_STATUS_RUNNING") "busy") (t "unknown")))
  (defun cascadeDirectory (endpoint row)
    (let* ((workspaces (nativeGet row "workspaces" (js-array)))
           (uris (nativeGet (nativeGet row "trajectoryMetadata") "workspaceUris" (js-array)))
           (candidate (or (and (Array/isArray workspaces) (> (js-length workspaces) 0)
                            (nativeGet (aref workspaces 0) "workspaceFolderAbsoluteUri"))
                          (and (Array/isArray uris) (> (js-length uris) 0) (aref uris 0)))))
      (if (and (= (nativeTypeOf candidate) "string") (> (js-length candidate) 0))
        (try
          (let ((resolved (fileURLToPath candidate)))
            (and (= (nativeTypeOf resolved) "string") (isAbsolute resolved) resolved))
          (catch invalid nil))
        (when (and (= (nativeGet endpoint "workspace_scope") "instance")
                   (= (nativeTypeOf (nativeGet endpoint "directory")) "string")
                   (isAbsolute (nativeGet endpoint "directory")))
          (nativeGet endpoint "directory")))))
  (defun cascadeWorkspace (endpoint row)
    (if (= (nativeGet endpoint "workspace_scope") "instance")
      (not (not (cascadeDirectory endpoint row)))
      (let ((uri (js-call (pathToFileURL (nativeGet endpoint "directory")) :toString)))
        (or (js-call (nativeGet row "workspaces" (js-array)) :some
              (lambda (workspace) (= (nativeGet workspace "workspaceFolderAbsoluteUri") uri)))
            (js-call (nativeGet (nativeGet row "trajectoryMetadata") "workspaceUris" (js-array)) :includes uri)))))
  (defun cascadeMessage (step)
    (let* ((user (nativeGet step "userInput")) (answer (nativeGet step "plannerResponse"))
           (id (if user (nativeGet (nativeGet step "metadata") "modelApiContentId") (nativeGet answer "messageId")))
           (text (if user
             (js-call (js-call (nativeGet user "items" (js-array)) :map (lambda (item) (nativeGet item "text" ""))) :join "\n")
             (nativeGet answer "response" (nativeGet answer "text" "")))))
      ;; Never publish planner thinking, tool arguments or synthetic message IDs.
      (when (and (= (nativeTypeOf id) "string") (> (js-length id) 0)
                 (= (nativeTypeOf text) "string") (> (js-length text) 0))
        (js-object :native_message_id id :role (if user "user" "assistant") :text text
          :created_at (nativeGet (nativeGet step "metadata") "createdAt")))))
  (defun createAntigravityPort (config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
          (rpc (nativeGet host "antigravity_rpc" antigravityRpc))
          (endpointFor nil) (summaries nil) (inspect nil) (project nil) (steps nil) (listSessions nil) (createSession nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (endpoint)
          (and (= (nativeGet target "instance_id") (nativeGet endpoint "instance_id"))
               (or (not (nativeGet target "native_namespace"))
                   (= (nativeGet target "native_namespace") (nativeGet endpoint "native_namespace"))))))))
          (unless (= (js-length rows) 1) (throw (new globalThis.TypeError "exact Antigravity endpoint required")))
          (aref rows 0))))
      (setq summaries (async (endpoint context)
        (when closed (throw (new globalThis.Error "Antigravity port closed")))
        (await (funcall rpc endpoint "GetAllCascadeTrajectories" (js-object :excludeSubtrajectories t) context))))
      (setq inspect (async (target context)
        (let* ((endpoint (funcall endpointFor target)) (response (await (funcall summaries endpoint context)))
               (row (nativeGet (nativeGet (nativeGet response "data") "trajectorySummaries")
                     (nativeGet target "native_session_id"))))
          (expectedEpoch (nativeGet response "instance_epoch") target)
          (unless (and row (cascadeWorkspace endpoint row))
            (throw (new globalThis.Error "original Antigravity workspace/session unavailable")))
          (js-object :endpoint endpoint :row row :instance_epoch (nativeGet response "instance_epoch")))))
      (setq project (lambda (endpoint id row epoch)
        (let* ((dir (or (cascadeDirectory endpoint row) (nativeGet endpoint "directory")))
               (ws (if (and (= (nativeGet endpoint "workspace_scope") "instance")
                            (= (nativeTypeOf dir) "string") (isAbsolute dir)
                            (not (= dir (nativeGet endpoint "directory"))))
                     (str "antigravity-workspace-" (hashValue dir))
                     (nativeGet endpoint "workspace_ref"))))
          (js-object :tool "antigravity" :surface "desktop" :native_namespace (nativeGet endpoint "native_namespace")
            :native_session_id id :instance_id (nativeGet endpoint "instance_id") :instance_epoch epoch
            :workspace_ref ws :directory dir
            :title (nativeGet (nativeGet row "annotations") "title" (nativeGet row "summary" "Antigravity"))
            :runtime_state (cascadeState (nativeGet row "status")) :live_receiver t
            :visibility (js-array "live") :coverage "partial" :evidence_level "native_protocol"
            :capabilities antigravityCapabilities))))
      (setq steps (async (endpoint id offset total context &optional include-config)
        (unless (and (Number/isSafeInteger total) (Number/isSafeInteger offset) (>= offset 0)
                     (<= offset total) (<= (- total offset) 128))
          (throw (new globalThis.RangeError "Antigravity continuation exceeded bounded tail; refresh session")))
        (let* ((response (await (funcall rpc endpoint "GetCascadeTrajectorySteps"
                 (js-object :cascadeId id :stepOffset offset :trajectoryVerbosity (if include-config
                     "CLIENT_TRAJECTORY_VERBOSITY_FULL" "CLIENT_TRAJECTORY_VERBOSITY_PROD_UI")
                   :disableRehydration t) context)))
               (rows (nativeGet (nativeGet response "data") "steps" (js-array))))
          (unless (and (Array/isArray rows) (<= (js-length rows) 128))
            (throw (new globalThis.RangeError "Antigravity response exceeded bounded tail")))
          rows)))
      (setq listSessions (async (scope cursor budget context)
        (let ((items (js-array)) (partial false) (index 0) (skip (nativeGet cursor "offset" 0))
              (maximum (Math/min 128 (nativeGet budget "max_records" 32))))
          (unless (and (Number/isSafeInteger skip) (>= skip 0)) (throw (new globalThis.TypeError "invalid Antigravity cursor")))
          (let ((i 0)) (while (< i (js-length endpoints))
            (let ((endpoint (aref endpoints i)))
              (when (and (or (not (nativeGet scope "instance_ids"))
                            (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                         (or (not (nativeGet scope "workspace_refs"))
                            (= (nativeGet endpoint "workspace_scope") "instance")
                            (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref"))))
                (try
                  (let* ((response (await (funcall summaries endpoint context)))
                         (rows (nativeGet (nativeGet response "data") "trajectorySummaries" (js-object)))
                         (ids (js-call (Object/keys rows) :sort)) (n 0))
                    (while (< n (js-length ids))
                      (let* ((id (aref ids n)) (row (nativeGet rows id)))
                        (when (cascadeWorkspace endpoint row)
                          (let ((projected (funcall project endpoint id row (nativeGet response "instance_epoch"))))
                            (when (or (not (nativeGet scope "workspace_refs"))
                                      (js-call (nativeGet scope "workspace_refs") :includes (nativeGet projected "workspace_ref")))
                              (when (and (>= index skip) (< (js-length items) maximum))
                                (js-call items :push projected))
                              (setq index (1+ index))))))
                      (setq n (1+ n))))
                  (catch unavailable (setq partial t)))))
            (setq i (1+ i))))
          (let ((next (+ skip (js-length items))))
            (js-object :items items :complete (>= next index) :coverage (if partial "partial" "covered")
              :next_cursor (if (< next index) (js-object :offset next) nil))))))
      (setq createSession (async (instance workspace key context lookup)
        (let ((started false) (id (cascadeCreationId key)))
          (try
            (let* ((endpoint (funcall endpointFor instance))
                   (resolved (creationWorkspace endpoint
                     (js-object :workspace_ref workspace :directory (nativeGet context "directory" nil)) nil))
                   (before (await (funcall summaries endpoint context)))
                   (row (nativeGet (nativeGet (nativeGet before "data") "trajectorySummaries") id))
                   (model (cascadeModel (nativeGet context "model_selection"))))
              (expectedEpoch (nativeGet before "instance_epoch") instance)
              (unless (nativeGet resolved "ok") (throw (new globalThis.TypeError "Antigravity creation workspace out of scope")))
              ;; A retry inspects the deterministic original ID. It never creates
              ;; a second conversation or treats absence as proof of non-creation.
              (unless (or row lookup)
                (let ((payload (js-object :cascadeId id :source "CORTEX_TRAJECTORY_SOURCE_CASCADE_CLIENT"
                        :workspaceUris (js-array (js-call (pathToFileURL
                          (nativeGet (nativeGet resolved "data") "directory")) :toString)))))
                  (when model (put payload :requestedModel model))
                  (setq started t)
                  (let ((created (await (funcall rpc endpoint "StartCascade" payload
                    (Object/assign (js-object) context (js-object :instance_epoch (nativeGet before "instance_epoch")))))))
                    (unless (= (nativeGet (nativeGet created "data") "cascadeId") id)
                      (throw (new globalThis.Error "Antigravity creation identity mismatch")))))
                (when (nativeGet context "title")
                  (await (funcall rpc endpoint "UpdateConversationAnnotations"
                    (js-object :cascadeId id :annotations (js-object :title (nativeGet context "title")) :mergeAnnotations t)
                    (Object/assign (js-object) context (js-object :instance_epoch (nativeGet before "instance_epoch"))))))
                (let ((after (await (funcall summaries endpoint context))))
                  (expectedEpoch (nativeGet after "instance_epoch") instance)
                  (setq row (nativeGet (nativeGet (nativeGet after "data") "trajectorySummaries") id))))
              (if (and row (cascadeWorkspace endpoint row))
                (let ((session (funcall project endpoint id row (nativeGet before "instance_epoch"))))
                  (unless (= (nativeGet session "workspace_ref") workspace)
                    (throw (new globalThis.Error "Antigravity creation workspace mismatch")))
                  (when model (put session :model_selection (nativeGet context "model_selection"))
                    (put session :initial_model_selection (nativeGet context "model_selection")))
                  (js-object :state "ready" :creation_key key :session session :native_ref id :evidence_level "native_protocol"))
                (js-object :state "unknown" :native_ref id :definite_not_sent false)))
            (catch invalid (js-object :state (if (or started lookup) "unknown" "failed")
              :native_ref id :definite_not_sent (not (or started lookup))))))))
      (js-object :capabilities antigravityCapabilities
        :rename (async (session title context)
          (let* ((before (await (funcall inspect session context)))
                 (endpoint (nativeGet before "endpoint")) (id (nativeGet session "native_session_id")))
            (expectedEpoch (nativeGet before "instance_epoch") session)
            (await (funcall rpc endpoint "UpdateConversationAnnotations"
              (js-object :cascadeId id :annotations (js-object :title title) :mergeAnnotations t)
              (Object/assign (js-object) context (js-object :instance_epoch (nativeGet before "instance_epoch")))))
            (let* ((after (await (funcall inspect session context)))
                   (record (funcall project endpoint id (nativeGet after "row") (nativeGet after "instance_epoch"))))
              (expectedEpoch (nativeGet after "instance_epoch") session)
              (js-object :state (if (= (nativeGet record "title") title) "ready" "unknown")
                :session record :native_ref id :evidence_level "native_protocol"))))
        :create (async (instance workspace key context) (funcall createSession instance workspace key context false))
        :lookupCreate (async (instance key ref context)
          (try
            (let ((row (await (funcall inspect (Object/assign (js-object) instance
              (js-object :native_session_id (cascadeCreationId key))) context))))
              (js-object :state "ready" :creation_key key :native_ref (cascadeCreationId key)
                :session (funcall project (nativeGet row "endpoint") (cascadeCreationId key)
                  (nativeGet row "row") (nativeGet row "instance_epoch")) :evidence_level "native_protocol"))
            (catch unavailable (js-object :state "unknown" :native_ref (cascadeCreationId key) :definite_not_sent false))))
        :initialize (lambda (context) (setq closed false)) :listSessions listSessions
        :probeInstance (async (instance context)
          (try (let* ((endpoint (funcall endpointFor instance)) (response (await (funcall summaries endpoint context))))
            (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
              :instance_epoch (nativeGet response "instance_epoch") :evidence_level "native_protocol"))
            (catch unavailable (js-object :state "offline" :evidence_level "none" :reason "antigravity_receiver_unavailable"))))
        :availability (async (target context)
          (let* ((endpoint (funcall endpointFor target))
            (response (await (funcall rpc endpoint "GetUserStatus" (js-object) context)))
            (configs (nativeGet (nativeGet (nativeGet response "data") "userStatus") "cascadeModelConfigData"))
            (rows (nativeGet configs "clientModelConfigs" (js-array)))
            (id (nativeGet (nativeGet target "model_selection") "model_id" nil)))
            (expectedEpoch (nativeGet response "instance_epoch") target)
            (unless (and (Array/isArray rows) (<= (js-length rows) 256))
              (throw (new globalThis.TypeError "invalid Antigravity quota catalog")))
            (let* ((model (and id (js-call rows :find (lambda (row) (= (nativeGet row "modelId") id)))))
              (quota (nativeGet model "quotaInfo")) (fraction (nativeGet quota "remainingFraction"))
              (known (and (= (nativeTypeOf fraction) "number") (Number/isFinite fraction) (>= fraction 0) (<= fraction 1))))
              ;; A zero baseline alone does not prove paid overage is unavailable.
              (js-object :state (if (and known (> fraction 0)) "available" "unknown")
                :reset_at (nativeGet quota "resetTime" nil) :source "antigravity:GetUserStatus"
                :reason (cond ((not known) "model_quota_unknown") ((= fraction 0) "baseline_exhausted_overage_unknown")
                  (t "native_quota_available"))))))
        :probe (async (target binding context)
          (let* ((checked (await (funcall inspect (Object/assign (js-object) binding target) context))))
            (let ((session (funcall project (nativeGet checked "endpoint") (nativeGet target "native_session_id")
              (nativeGet checked "row") (nativeGet checked "instance_epoch"))))
              (when (and (= (nativeGet (nativeGet checked "row") "stepCount") 0)
                         (nativeGet target "initial_model_selection"))
                (put session :model_selection (nativeGet target "initial_model_selection")))
              session)))
        :discover (async (visibility page context)
          (if (not (= visibility "live"))
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil)
            (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
              (nativeGet page "cursor") (js-object :max_records (Math/min 100 (nativeGet page "limit" 100))) context))))
        :refresh (async (page context)
          (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
            (nativeGet page "cursor") (js-object :max_records 100) context)))
        :readMessages (async (session cursor budget context)
          (let* ((checked (await (funcall inspect session context))) (row (nativeGet checked "row"))
                 (id (nativeGet session "native_session_id")) (total (nativeGet row "stepCount" 0))
                 (offset (if cursor (nativeGet cursor "offset") (Math/max 0 (- total 32))))
                 (maximum (Math/min 128 (nativeGet budget "max_records" 32)))
                 (max-bytes (Math/min 524288 (nativeGet budget "max_bytes" 524288)))
                 (items (js-array)) (size 0) (n 0))
            (when (and cursor (not (= (nativeGet cursor "session_id") id)))
              (throw (new globalThis.TypeError "Antigravity cursor belongs to another session")))
            (let ((rows (await (funcall steps (nativeGet checked "endpoint") id offset total context))) (running t))
              (while (and running (< n (js-length rows)))
                (let ((message (cascadeMessage (aref rows n))))
                  (if (and message (or (>= (js-length items) maximum)
                                     (> (+ size (utf8Bytes (JSON/stringify message))) max-bytes)))
                    (setq running false)
                    (progn (when message (js-call items :push message)
                      (setq size (+ size (utf8Bytes (JSON/stringify message))))) (setq n (1+ n))))))
              (js-object :items items :complete (= n (js-length rows)) :coverage "partial"
                :next_cursor (if (< n (js-length rows)) (js-object :session_id id :offset (+ offset n)) nil)))))
        :submit (async (binding envelope mode key context)
          (let ((started false))
            (try
              (unless (js-call (js-array "start_idle" "steer") :includes mode) (throw (new globalThis.Error "unsupported Antigravity mode")))
              (let* ((checked (await (funcall inspect binding context))) (row (nativeGet checked "row"))
                     (endpoint (nativeGet checked "endpoint")) (id (nativeGet binding "native_session_id"))
                     (offset (nativeGet row "lastUserInputStepIndex")) (total (nativeGet row "stepCount"))
                     (rows (if (= total 0) (js-array) (await (funcall steps endpoint id offset total context t))))
                     (user (nativeGet (aref rows 0) "userInput"))
                     (config (if (= total 0)
                       (js-object :plannerConfig (js-object :planModel (cascadeModel (nativeGet binding "model_selection"))))
                       (nativeGet user "userConfig")))
                     (model (nativeGet (nativeGet config "plannerConfig") "planModel"))
                     (text (renderEnvelope envelope)))
                (unless (and (or (= (cascadeState (nativeGet row "status")) "idle")
                                 (and (= mode "steer") (= (cascadeState (nativeGet row "status")) "busy")))
                             (or (and (= (nativeTypeOf model) "string") (> (js-length model) 0))
                                 (and (Number/isSafeInteger model) (> model 0))) (<= (utf8Bytes text) 262144))
                  (throw (new globalThis.Error "original Antigravity model/session is not sendable")))
                (setq started t)
                (await (funcall rpc endpoint "SendUserCascadeMessage"
                  (js-object :cascadeId id :items (js-array (js-object :text text))
                    :cascadeConfig config :deliveryStrategy (if (= mode "steer")
                      "MESSAGE_DELIVERY_STRATEGY_NEXT_INVOCATION" "MESSAGE_DELIVERY_STRATEGY_WHEN_IDLE"))
                  (Object/assign (js-object) context (js-object :instance_epoch (nativeGet checked "instance_epoch")))))
                (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                  :native_receipt_key (str "antigravity:" key)))
              (catch unavailable (js-object :state (if started "unknown" "failed")
                :kind (if started "unknown" "rejected") :definite_not_sent (not started)
                :retryable (not started) :evidence_level "none")))))
        :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
        :observe (async (binding ref cursor budget context)
          (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
        :close (async () (setq closed t)))))
  (export createAntigravityPort cascadeMessage cascadeWorkspace cascadeState cascadeCreationId cascadeModel))
