(module dj.adapters.agent.antigravity
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" utf8Bytes)
  (import "../../delivery/envelope.eli" encodeEnvelope)
  (import "./native-local.eli" antigravityRpc expectedEpoch)
  (import "node:url" pathToFileURL)
  (defconst antigravityCapabilities (Object/freeze
    (js-object :session_list "supported" :session_messages "supported" :session_probe "supported"
      :session_send "supported" :start_idle "supported" :message_during_run "unsupported" :session_create "unsupported"
      :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "unsupported"
      :lookup_send "unsupported" :lookup_create "unsupported" :observe "unsupported" :max_input_frame_bytes 262144)))
  (defun cascadeState (status)
    (cond ((= status "CASCADE_RUN_STATUS_IDLE") "idle")
      ((= status "CASCADE_RUN_STATUS_RUNNING") "busy") (t "unknown")))
  (defun cascadeWorkspace (endpoint row)
    (let ((uri (js-call (pathToFileURL (nativeGet endpoint "directory")) :toString)))
      (or (js-call (nativeGet row "workspaces" (js-array)) :some
            (lambda (workspace) (= (nativeGet workspace "workspaceFolderAbsoluteUri") uri)))
          (js-call (nativeGet (nativeGet row "trajectoryMetadata") "workspaceUris" (js-array)) :includes uri))))
  (defun cascadeMessage (step)
    (let* ((user (nativeGet step "userInput")) (answer (nativeGet step "plannerResponse"))
           (id (if user (nativeGet (nativeGet step "metadata") "modelApiContentId") (nativeGet answer "messageId")))
           (text (if user
             (js-call (js-call (nativeGet user "items" (js-array)) :map (lambda (item) (nativeGet item "text" ""))) :join "\n")
             (nativeGet answer "response" (nativeGet answer "text" "")))))
      ;; Never publish planner thinking, tool arguments or synthetic message IDs.
      (when (and (= (nativeTypeOf id) "string") (> (js-length id) 0)
                 (= (nativeTypeOf text) "string") (> (js-length text) 0))
        (js-object :native_message_id id :role (if user "user" "assistant") :text text
          :created_at (nativeGet (nativeGet step "metadata") "createdAt")))))
  (defun createAntigravityPort (config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
          (endpointFor nil) (summaries nil) (inspect nil) (project nil) (steps nil) (listSessions nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (endpoint)
          (and (= (nativeGet target "instance_id") (nativeGet endpoint "instance_id"))
               (or (not (nativeGet target "native_namespace"))
                   (= (nativeGet target "native_namespace") (nativeGet endpoint "native_namespace"))))))))
          (unless (= (js-length rows) 1) (throw (new globalThis.TypeError "exact Antigravity endpoint required")))
          (aref rows 0))))
      (setq summaries (async (endpoint context)
        (when closed (throw (new globalThis.Error "Antigravity port closed")))
        (await (antigravityRpc endpoint "GetAllCascadeTrajectories" (js-object :excludeSubtrajectories t) context))))
      (setq inspect (async (target context)
        (let* ((endpoint (funcall endpointFor target)) (response (await (funcall summaries endpoint context)))
               (row (nativeGet (nativeGet (nativeGet response "data") "trajectorySummaries")
                     (nativeGet target "native_session_id"))))
          (expectedEpoch (nativeGet response "instance_epoch") target)
          (unless (and row (cascadeWorkspace endpoint row))
            (throw (new globalThis.Error "original Antigravity workspace/session unavailable")))
          (js-object :endpoint endpoint :row row :instance_epoch (nativeGet response "instance_epoch")))))
      (setq project (lambda (endpoint id row epoch)
        (js-object :tool "antigravity" :native_namespace (nativeGet endpoint "native_namespace")
          :native_session_id id :instance_id (nativeGet endpoint "instance_id") :instance_epoch epoch
          :workspace_ref (nativeGet endpoint "workspace_ref") :title (nativeGet (nativeGet row "annotations") "title" (nativeGet row "summary" "Antigravity"))
          :runtime_state (cascadeState (nativeGet row "status")) :live_receiver t
          :visibility (js-array "live") :coverage "partial" :evidence_level "native_protocol"
          :capabilities antigravityCapabilities)))
      (setq steps (async (endpoint id offset total context &optional include-config)
        (unless (and (Number/isSafeInteger total) (Number/isSafeInteger offset) (>= offset 0)
                     (<= offset total) (<= (- total offset) 128))
          (throw (new globalThis.RangeError "Antigravity continuation exceeded bounded tail; refresh session")))
        (let* ((response (await (antigravityRpc endpoint "GetCascadeTrajectorySteps"
                 (js-object :cascadeId id :stepOffset offset :trajectoryVerbosity (if include-config
                     "CLIENT_TRAJECTORY_VERBOSITY_FULL" "CLIENT_TRAJECTORY_VERBOSITY_PROD_UI")
                   :disableRehydration t) context)))
               (rows (nativeGet (nativeGet response "data") "steps" (js-array))))
          (unless (and (Array/isArray rows) (<= (js-length rows) 128))
            (throw (new globalThis.RangeError "Antigravity response exceeded bounded tail")))
          rows)))
      (setq listSessions (async (scope cursor budget context)
        (let ((items (js-array)) (partial false) (index 0) (skip (nativeGet cursor "offset" 0))
              (maximum (Math/min 128 (nativeGet budget "max_records" 32))))
          (unless (and (Number/isSafeInteger skip) (>= skip 0)) (throw (new globalThis.TypeError "invalid Antigravity cursor")))
          (let ((i 0)) (while (< i (js-length endpoints))
            (let ((endpoint (aref endpoints i)))
              (when (and (or (not (nativeGet scope "instance_ids"))
                            (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                         (or (not (nativeGet scope "workspace_refs"))
                            (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref"))))
                (try
                  (let* ((response (await (funcall summaries endpoint context)))
                         (rows (nativeGet (nativeGet response "data") "trajectorySummaries" (js-object)))
                         (ids (js-call (Object/keys rows) :sort)) (n 0))
                    (while (< n (js-length ids))
                      (let* ((id (aref ids n)) (row (nativeGet rows id)))
                        (when (cascadeWorkspace endpoint row)
                          (when (and (>= index skip) (< (js-length items) maximum))
                            (js-call items :push (funcall project endpoint id row (nativeGet response "instance_epoch"))))
                          (setq index (1+ index))))
                      (setq n (1+ n))))
                  (catch unavailable (setq partial t)))))
            (setq i (1+ i))))
          (let ((next (+ skip (js-length items))))
            (js-object :items items :complete (>= next index) :coverage (if partial "partial" "covered")
              :next_cursor (if (< next index) (js-object :offset next) nil))))))
      (js-object :capabilities antigravityCapabilities
        :initialize (lambda (context) (setq closed false)) :listSessions listSessions
        :probeInstance (async (instance context)
          (try (let* ((endpoint (funcall endpointFor instance)) (response (await (funcall summaries endpoint context))))
            (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
              :instance_epoch (nativeGet response "instance_epoch") :evidence_level "native_protocol"))
            (catch unavailable (js-object :state "offline" :evidence_level "none" :reason "antigravity_receiver_unavailable"))))
        :probe (async (target binding context)
          (let* ((checked (await (funcall inspect (Object/assign (js-object) binding target) context))))
            (funcall project (nativeGet checked "endpoint") (nativeGet target "native_session_id")
              (nativeGet checked "row") (nativeGet checked "instance_epoch"))))
        :discover (async (visibility page context)
          (if (not (= visibility "live"))
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil)
            (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
              (nativeGet page "cursor") (js-object :max_records (Math/min 100 (nativeGet page "limit" 100))) context))))
        :refresh (async (page context)
          (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
            (nativeGet page "cursor") (js-object :max_records 100) context)))
        :readMessages (async (session cursor budget context)
          (let* ((checked (await (funcall inspect session context))) (row (nativeGet checked "row"))
                 (id (nativeGet session "native_session_id")) (total (nativeGet row "stepCount" 0))
                 (offset (if cursor (nativeGet cursor "offset") (Math/max 0 (- total 32))))
                 (maximum (Math/min 128 (nativeGet budget "max_records" 32)))
                 (max-bytes (Math/min 524288 (nativeGet budget "max_bytes" 524288)))
                 (items (js-array)) (size 0) (n 0))
            (when (and cursor (not (= (nativeGet cursor "session_id") id)))
              (throw (new globalThis.TypeError "Antigravity cursor belongs to another session")))
            (let ((rows (await (funcall steps (nativeGet checked "endpoint") id offset total context))) (running t))
              (while (and running (< n (js-length rows)))
                (let ((message (cascadeMessage (aref rows n))))
                  (if (and message (or (>= (js-length items) maximum)
                                     (> (+ size (utf8Bytes (JSON/stringify message))) max-bytes)))
                    (setq running false)
                    (progn (when message (js-call items :push message)
                      (setq size (+ size (utf8Bytes (JSON/stringify message))))) (setq n (1+ n))))))
              (js-object :items items :complete (= n (js-length rows)) :coverage "partial"
                :next_cursor (if (< n (js-length rows)) (js-object :session_id id :offset (+ offset n)) nil)))))
        :submit (async (binding envelope mode key context)
          (let ((started false))
            (try
              (unless (js-call (js-array "start_idle" "steer") :includes mode) (throw (new globalThis.Error "unsupported Antigravity mode")))
              (let* ((checked (await (funcall inspect binding context))) (row (nativeGet checked "row"))
                     (endpoint (nativeGet checked "endpoint")) (id (nativeGet binding "native_session_id"))
                     (offset (nativeGet row "lastUserInputStepIndex")) (total (nativeGet row "stepCount"))
                     (rows (await (funcall steps endpoint id offset total context t)))
                     (user (nativeGet (aref rows 0) "userInput")) (config (nativeGet user "userConfig"))
                     (model (nativeGet (nativeGet config "plannerConfig") "planModel"))
                     (text (encodeEnvelope envelope)))
                (unless (and (= (cascadeState (nativeGet row "status")) "idle")
                             (= (nativeTypeOf model) "string") (> (js-length model) 0) (<= (utf8Bytes text) 262144))
                  (throw (new globalThis.Error "original Antigravity model/session is not sendable")))
                (setq started t)
                (await (antigravityRpc endpoint "SendUserCascadeMessage"
                  (js-object :cascadeId id :items (js-array (js-object :text text))
                    :cascadeConfig config :deliveryStrategy "MESSAGE_DELIVERY_STRATEGY_WHEN_IDLE")
                  (Object/assign (js-object) context (js-object :instance_epoch (nativeGet checked "instance_epoch")))))
                (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                  :native_receipt_key (str "antigravity:" key)))
              (catch unavailable (js-object :state (if started "unknown" "failed")
                :kind (if started "unknown" "rejected") :definite_not_sent (not started)
                :retryable (not started) :evidence_level "none")))))
        :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
        :observe (async (binding ref cursor budget context)
          (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
        :close (async () (setq closed t)))))
  (export createAntigravityPort cascadeMessage cascadeWorkspace cascadeState))
