(module dj.adapters.agent.electron-recovery
  (import "../../core/native.eli" NativeNumber nativeGet nativeTypeOf)
  (import "./native-local.eli" metadataCommand trustedProcessHelper)
  (import "./electron-control.eli" electronControl)
  (import "./electron-inspector.eli" electronProcessInfo)
  (import "./desktop-transport.eli" desktopError)
  (import "./local-endpoint-resolver.eli" processRows originalProcessGone cloneEndpoint)
  ;; Shared Electron main-process and window rediscovery for existing-instance
  ;; desktop apps (Cursor, Claude Desktop). Never launches a client or mutates
  ;; persisted configuration; fails closed when process or window is ambiguous.
  (defun electronToolSpec (tool)
    (cond
      ((= tool "claude")
        (js-object :executable_suffix ".app/Contents/MacOS/Claude"
          :window_matches (lambda (window)
            (try (js-call (js-array "https://claude.ai" "https://claude.com" "app://localhost")
                   :includes (nativeGet (new globalThis.URL (nativeGet window "url" "")) "origin"))
              (catch invalid false)))))
      ((or (not tool) (= tool "cursor"))
        (js-object :executable_suffix ".app/Contents/MacOS/Cursor"
          :window_matches (lambda (window)
            (js-call (nativeGet window "url" "") :startsWith "vscode-file://vscode-app/"))))
      (t (throw (desktopError "electron_recovery_tool_unsupported")))))
  (defasync recoverElectronEndpoint (endpoint context &optional pid host)
    (let* ((tool (nativeGet endpoint "tool" "cursor"))
           (spec (electronToolSpec tool))
           (suffix (nativeGet spec "executable_suffix"))
           (api (nativeGet endpoint "native_api"))
           (helper (await (trustedProcessHelper (nativeGet api "process_helper_ref"))))
           (command (or (and host (= (nativeTypeOf (nativeGet host "electron_discovery_command")) "function")
                          (nativeGet host "electron_discovery_command"))
                        (and host (= (nativeTypeOf (nativeGet host "local_discovery_command")) "function")
                          (nativeGet host "local_discovery_command"))
                        (async (file args call-context)
                          (await (metadataCommand file args call-context
                            (if (and (= file "ps") (= (aref args 0) "-axo")) 1048576 65536))))))
           (inspect (or (and host (= (nativeTypeOf (nativeGet host "electron_inspect")) "function")
                          (nativeGet host "electron_inspect"))
                        (async (candidate call-context)
                          (await (electronControl candidate (js-object :operation "inspect") call-context)))))
           (rows (processRows (await (funcall command "ps" (js-array "-axo" "pid=,ppid=,uid=,comm=") context))))
           (uid (js-call globalThis.process :getuid))
           (matches (js-array)))
      (when (> (js-length rows) 32768) (throw (desktopError "native_process_limit")))
      (js-call rows :forEach (lambda (row)
        (when (and (= (nativeGet row "uid") uid)
                   (js-call (nativeGet row "executable" "") :endsWith suffix)
                   (or (not pid) (= (nativeGet row "pid") pid)))
          (js-call matches :push (nativeGet row "pid")))))
      (unless (= (js-length matches) 1) (throw (desktopError "cursor_recovery_process_ambiguous")))
      (let* ((info (JSON/parse (await (funcall command helper (js-array (str (aref matches 0))) context))))
             (candidate (cloneEndpoint endpoint)))
        (unless (and (= (nativeGet info "pid") (aref matches 0))
                     (= (nativeGet info "uid") uid)
                     (= (nativeGet info "caught") t)
                     (js-call (nativeGet info "executable" "") :endsWith suffix))
          (throw (desktopError "desktop_target_changed")))
        (put candidate :native_api (Object/assign (js-object) api
          (js-object :process_id (nativeGet info "pid") :process_birth (nativeGet info "birth") :process_origin 0)))
        (let* ((inspection (await (funcall inspect candidate
                 (Object/assign (js-object) context (js-object :expected_epoch nil)))))
               (data (nativeGet inspection "data"))
               (windows (js-call (nativeGet data "windows" (js-array)) :filter (nativeGet spec "window_matches")))
               (prior (js-call windows :find (lambda (window) (= (nativeGet window "id") (nativeGet endpoint "window_id")))))
               (selected (or prior (and (= (js-length windows) 1) (aref windows 0)))))
          (unless selected (throw (desktopError "cursor_recovery_window_ambiguous")))
          (put candidate :window_id (nativeGet selected "id"))
          (put (nativeGet candidate "native_api") :process_origin (nativeGet data "origin"))
          ;; Close a PID-reuse race before publishing the rebound endpoint.
          (if (and host (= (nativeTypeOf (nativeGet host "electron_discovery_command")) "function"))
            (let ((recheck (JSON/parse (await (funcall command helper (js-array (str (nativeGet info "pid"))) context)))))
              (unless (and (= (nativeGet recheck "pid") (nativeGet info "pid"))
                           (= (nativeGet recheck "birth") (nativeGet info "birth")))
                (throw (desktopError "desktop_target_changed"))))
            (await (electronProcessInfo candidate context)))
          candidate))))
  (defun createElectronEndpointRequest (raw-request &optional host)
    (let* ((cached (new globalThis.Map)) (pending (new globalThis.Map))
           (command (or (and host (= (nativeTypeOf (nativeGet host "electron_discovery_command")) "function")
                          (nativeGet host "electron_discovery_command"))
                        (and host (= (nativeTypeOf (nativeGet host "local_discovery_command")) "function")
                          (nativeGet host "local_discovery_command"))
                        nil))
           (invoke nil))
      (setq invoke (async (endpoint payload context)
        (let* ((key (nativeGet endpoint "instance_id" (nativeGet endpoint "endpoint_ref" "default")))
               (live (or (js-call cached :get key) (cloneEndpoint endpoint))))
          (try (let ((response (await (funcall raw-request live payload context))))
            (js-call cached :set key live) response)
            (catch error
              (unless (js-call (js-array "cursor_process_metadata" "desktop_target_changed") :includes (nativeGet error "code"))
                (throw error))
              ;; Never rebind while the bound process (pid + birth) is still alive;
              ;; expected_epoch mismatches and live origin mismatches must fail closed.
              (let ((api (nativeGet live "native_api")))
                (unless (await (originalProcessGone (nativeGet api "process_helper_ref")
                                 (nativeGet api "process_id") (nativeGet api "process_birth") context command))
                  (throw error)))
              (js-call cached :delete key)
              (let ((work (js-call pending :get key)))
                (unless work
                  (setq work (recoverElectronEndpoint live context nil host))
                  (js-call pending :set key work))
                (try
                  (setq live (await work))
                  (js-call cached :set key live)
                  (finally
                    (when (eq work (js-call pending :get key)) (js-call pending :delete key)))))
              (await (funcall raw-request live payload context)))))))
      (Object/assign invoke
        (js-object :request invoke
          :invalidate (lambda (key) (js-call cached :delete key))
          :clear (lambda () (js-call cached :clear) (js-call pending :clear))))))
  (export electronToolSpec recoverElectronEndpoint createElectronEndpointRequest))
