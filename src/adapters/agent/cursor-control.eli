(module dj.adapters.agent.cursor-control
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd)
  (import "node:http" createServer)
  (import "node:fs/promises" mkdir lstat open rename unlink chmod)
  (import "node:fs" constants)
  (import "node:path" join resolve dirname)
  (import "node:os" homedir)
  (import "node:crypto" createHash randomBytes randomUUID timingSafeEqual)

  (defun cursorCreationId (workspace key)
    (let ((hex (js-call (js-call (createHash "sha256") :update
                 (JSON/stringify (js-array "dj-cursor-create-v1" workspace key))) :digest "hex")))
      (str (js-call hex :slice 0 8) "-" (js-call hex :slice 8 12) "-4"
        (js-call hex :slice 13 16) "-8" (js-call hex :slice 17 20) "-" (js-call hex :slice 20 32))))
  (defun controlString (value maximum)
    (and (= (nativeTypeOf value) "string") (> (js-length value) 0)
         (<= (Buffer/byteLength value "utf8") maximum) (not (js-call value :includes "\u0000"))))
  (defasync controlDirectory (path)
    (await (mkdir path (js-object :recursive t :mode 448)))
    (let ((info (await (lstat path))))
      (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
                   (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                   (= (nativeBitAnd (nativeGet info "mode") 63) 0))
        (throw (new globalThis.Error "private_control_directory_required")))))
  (defasync controlRead (path)
    (let ((file nil))
      (try
        (setq file (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))
        (let ((info (await (js-call file :stat))))
          (unless (and (js-call info :isFile) (= (nativeGet info "nlink") 1)
                       (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                       (= (nativeBitAnd (nativeGet info "mode") 63) 0) (<= (nativeGet info "size") 262144))
            (throw (new globalThis.Error "private_control_file_required")))
          (JSON/parse (await (js-call file :readFile "utf8"))))
        (catch error (if (= (nativeGet error "code") "ENOENT") nil (throw error)))
        (finally (when file (await (js-call file :close)))))))
  (defasync controlWrite (path value)
    (let ((temporary (str path "." (randomUUID))) (file nil) (directory nil)
          (text (JSON/stringify value)))
      (when (> (Buffer/byteLength text "utf8") 262144)
        (throw (new globalThis.Error "control_journal_limit")))
      (try
        (setq file (await (open temporary "wx" 384)))
        (await (js-call file :writeFile text))
        (await (js-call file :sync))
        (await (js-call file :close)) (setq file nil)
        (await (rename temporary path))
        (setq directory (await (open (dirname path)
          (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_DIRECTORY") (nativeGet constants "O_NOFOLLOW")))))
        (await (js-call directory :sync))
        (finally
          (when file (await (js-call file :close)))
          (when directory (await (js-call directory :close)))
          (try (await (unlink temporary)) (catch missing nil))))))

  ;; The extension host supplies VS Code's existing command API. No child
  ;; process, shell, general RPC, prompt, or model configuration is exposed.
  (defasync activateCursorControl (vscode extension)
    (let* ((configuration (js-call (nativeGet vscode "workspace") :getConfiguration "dj.cursorControl"))
           (enabled (js-call configuration :get "enabled" false))
           (workspace (js-call configuration :get "workspaceRef" ""))
           (folders (nativeGet (nativeGet vscode "workspace") "workspaceFolders" (js-array))))
      (when enabled
        (unless (and (= (nativeGet (nativeGet vscode "workspace") "isTrusted") t)
                     (controlString workspace 1024) (= (js-length folders) 1)
                     (= (nativeGet (nativeGet (aref folders 0) "uri") "scheme") "file")
                     (js-call (nativeGet (nativeGet vscode "env") "appName" "") :startsWith "Cursor"))
          (throw (new globalThis.Error "exact_cursor_workspace_required")))
        (let* ((commands (nativeGet vscode "commands"))
               (available (await (js-call commands :getCommands t)))
               (directory (resolve (nativeGet (nativeGet (aref folders 0) "uri") "fsPath")))
               (root (join (homedir) ".dj"))
               (control-root (join root "cursor-control"))
               (run-root (join root "run"))
               (identity (js-call (js-call (createHash "sha256") :update
                           (JSON/stringify (js-array workspace directory))) :digest "hex"))
               (short-id (js-call identity :slice 0 16))
               (manifest-path (join control-root (str short-id ".json")))
               (journal-path (join control-root (str short-id ".journal.json")))
               (socket-path (join run-root (str "cc-" (js-call (randomUUID) :slice 0 12) ".sock")))
               (token (js-call (randomBytes 32) :toString "hex"))
               (journal nil) (server nil) (busy false) (closed false) (dispose nil))
          (unless (js-call available :includes "composer.createNew")
            (throw (new globalThis.Error "native_create_command_unavailable")))
          (await (controlDirectory root)) (await (controlDirectory control-root)) (await (controlDirectory run-root))
          (let ((previous (await (controlRead manifest-path))))
            (when previous
              (try
                (js-call globalThis.process :kill (nativeGet previous "pid") 0)
                (throw (new globalThis.Error "control_workspace_already_owned"))
                (catch error (unless (= (nativeGet error "code") "ESRCH") (throw error))))))
          (setq journal (or (await (controlRead journal-path))
                           (js-object :version 1 :workspace_ref workspace :directory directory :records (js-object))))
          (unless (and (= (nativeGet journal "version") 1)
                       (= (nativeGet journal "workspace_ref") workspace)
                       (= (nativeGet journal "directory") directory)
                       (= (nativeTypeOf (nativeGet journal "records")) "object")
                       (not (Array/isArray (nativeGet journal "records")))
                       (<= (js-length (Object/keys (nativeGet journal "records"))) 128))
            (throw (new globalThis.Error "control_journal_invalid")))
          (setq server (createServer (lambda (request response)
            (let ((chunks (js-array)) (bytes 0) (rejected false) (respond nil))
              (setq respond (lambda (status body)
                (unless (nativeGet response "destroyed")
                  (js-call response :writeHead status (js-object :Content-Type "application/json"))
                  (js-call response :end (JSON/stringify body)))))
              (let* ((authorization (nativeGet (nativeGet request "headers") "authorization" ""))
                     (expected (str "Bearer " token)))
                (unless (and (= (nativeTypeOf authorization) "string") (= (nativeGet request "method") "POST") (= (nativeGet request "url") "/")
                             (= (Buffer/byteLength authorization) (Buffer/byteLength expected))
                             (timingSafeEqual (Buffer/from authorization) (Buffer/from expected)))
                  (setq rejected t) (funcall respond 403 (js-object :state "rejected"))))
              (js-call request :on "error" (lambda (ignored) (setq rejected t)))
              (js-call request :on "data" (lambda (chunk)
                (setq bytes (+ bytes (js-length chunk)))
                (if (> bytes 8192)
                  (progn (setq rejected t) (js-call request :destroy))
                  (unless rejected (js-call chunks :push chunk)))))
              (js-call request :on "end" (async ()
                (unless rejected
                  (let ((held false))
                    (try
                      (let* ((input (JSON/parse (js-call (Buffer/concat chunks) :toString "utf8")))
                             (type (nativeGet input "type"))
                             (key (nativeGet input "creation_key"))
                             (title (nativeGet input "title" nil)))
                        (unless (and (js-call (js-array "createSession" "lookupSession") :includes type)
                                     (js-call (Object/keys input) :every (lambda (name)
                                       (js-call (js-array "type" "workspace_ref" "creation_key" "title") :includes name)))
                                     (= (nativeGet input "workspace_ref") workspace)
                                     (controlString key 256)
                                     (or (nil? title) (controlString title 1024)))
                          (throw (new globalThis.TypeError "control_arguments_invalid")))
                        (let* ((live-workspace (nativeGet vscode "workspace"))
                               (live-folders (nativeGet live-workspace "workspaceFolders" (js-array)))
                               (live-config (js-call live-workspace :getConfiguration "dj.cursorControl")))
                          (unless (and (= (nativeGet live-workspace "isTrusted") t)
                                       (= (js-call live-config :get "enabled" false) t)
                                       (= (js-call live-config :get "workspaceRef" "") workspace)
                                       (= (js-length live-folders) 1)
                                       (= (nativeGet (nativeGet (aref live-folders 0) "uri") "scheme") "file")
                                       (= (resolve (nativeGet (nativeGet (aref live-folders 0) "uri") "fsPath")) directory))
                            (throw (new globalThis.Error "control_workspace_changed"))))
                        (let* ((id (cursorCreationId workspace key))
                               (records (nativeGet journal "records")) (existing (nativeGet records id)))
                          (when (and (= type "createSession") existing
                                     (not (= (nativeGet existing "title") title)))
                            (throw (new globalThis.TypeError "control_key_conflict")))
                          (when (and (= type "createSession") (not existing))
                            (when (or busy closed (>= (js-length (Object/keys records)) 128))
                              (throw (new globalThis.Error "control_busy_or_full")))
                            (setq busy t held t)
                            ;; Persist uncertainty before invoking the native command;
                            ;; even a crash before command completion never reissues it.
                            (put records id (js-object :native_session_id id :state "issued" :title title))
                            (await (controlWrite journal-path journal))
                            (await (js-call commands :executeCommand "composer.createNew"
                              (js-object :autoSubmit false :skipShowAndFocus t :skipSelect t :openInNewTab t
                                :partialState (js-object :composerId id :name (or title "DJ empty session") :isDraft false)))))
                          (funcall respond 200 (js-object :state (if (nativeGet records id) "issued" "not_found")
                            :native_session_id id :creation_key key :workspace_ref workspace :directory directory))))
                      (catch error (funcall respond 400 (js-object :state "unknown")))
                      (finally (when held (setq busy false))))))))))))
          (put server :maxConnections 16)
          (put server :requestTimeout 5000)
          (setq dispose (async ()
            (unless closed
              (setq closed t)
              (js-call server :close)
              (try
                (let ((manifest (await (controlRead manifest-path))))
                  (when (= (nativeGet manifest "token") token) (await (unlink manifest-path))))
                (catch ignored nil))
              (try (await (unlink socket-path)) (catch ignored nil)))))
          (try
            (await (new globalThis.Promise (lambda (done reject)
              (js-call server :once "error" reject)
              (js-call server :listen socket-path done))))
            (await (chmod socket-path 384))
            (await (controlWrite manifest-path (js-object :protocolVersion 1
              :pid (nativeGet globalThis.process "pid") :socketPath socket-path :token token
              :kind "dj-cursor-create-only" :workspace_ref workspace :directory directory)))
            (js-call (nativeGet extension "subscriptions") :push (js-object :dispose dispose))
            (js-object :manifest_path manifest-path :dispose dispose)
            (catch error (await (funcall dispose)) (throw error)))))))
  (export cursorCreationId activateCursorControl))
