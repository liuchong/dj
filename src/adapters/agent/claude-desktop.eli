(module dj.adapters.agent.claude-desktop
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" utf8Bytes hashValue)
  (import "../../delivery/envelope.eli" renderEnvelope)
  (import "./electron-control.eli" electronControl)
  (import "./desktop-transport.eli" desktopError)
  (import "node:crypto" randomUUID)
  (defconst capabilities (Object/freeze (js-object :session_list "supported" :session_messages "supported"
    :session_probe "supported" :session_send "supported" :start_idle "supported" :message_during_run "supported"
    :creation_model_selection "supported" :session_create "supported" :session_rename "supported" :lookup_create "positive_only"
    :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "unsupported"
    :lookup_send "unsupported" :observe "unsupported" :max_input_frame_bytes 262144)))
  (defun createClaudeDesktopPort (config host)
    (let ((endpoints (nativeGet config "endpoints")) (closed false) (endpointFor nil) (request nil) (project nil)
          (probe nil) (listSessions nil) (createSession nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (endpoint)
          (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id"))))))
          (unless (= (js-length rows) 1) (throw (desktopError "claude_exact_endpoint"))) (aref rows 0))))
      (setq request (async (endpoint payload context)
        (when closed (throw (desktopError "desktop_closed")))
        (await (electronControl endpoint payload context))))
      (setq project (lambda (endpoint row epoch)
        (let ((directory (nativeGet row "cwd")))
          (unless (and (= (nativeTypeOf (nativeGet row "id")) "string")
            (= (nativeTypeOf directory) "string")
            (or (= directory (nativeGet endpoint "directory")) (= (nativeGet endpoint "workspace_scope") "instance")))
            (throw (desktopError "desktop_target_mismatch")))
          (js-object :tool "claude" :surface "desktop" :native_namespace (nativeGet endpoint "native_namespace")
            :native_session_id (nativeGet row "id") :instance_id (nativeGet endpoint "instance_id") :instance_epoch epoch
            :workspace_ref (if (= directory (nativeGet endpoint "directory")) (nativeGet endpoint "workspace_ref")
              (str "claude-workspace-" (hashValue directory))) :directory directory :title (nativeGet row "title" "")
            :runtime_state (cond ((js-call (js-array "running" "working" "busy") :includes (nativeGet row "status")) "busy")
              ((js-call (js-array "waiting_permission" "waiting-for-permission") :includes (nativeGet row "status")) "waiting_permission")
              ((js-call (js-array "idle" "completed" "interrupted" "error") :includes (nativeGet row "status")) "idle")
              (t "unknown"))
            :model_selection (js-object :model_id (nativeGet row "model" nil) :reasoning_effort (nativeGet row "effort" nil))
            :live_receiver t :visibility (js-array "live") :coverage "covered" :evidence_level "native_protocol" :capabilities capabilities))))
      (setq probe (async (target binding context)
        (let* ((endpoint (funcall endpointFor binding))
               (response (await (funcall request endpoint (js-object :operation "probe" :thread (nativeGet target "native_session_id"))
                 (Object/assign (js-object) context (js-object :expected_epoch (nativeGet binding "instance_epoch")))))))
          (funcall project endpoint (nativeGet (nativeGet response "data") "thread") (nativeGet response "instance_epoch")))))
      (setq listSessions (async (scope cursor budget context)
        (let ((index (nativeGet cursor "endpoint_index" 0)) (after (nativeGet cursor "after_id" ""))
              (items (js-array)) (next nil) (maximum (Math/min 100 (nativeGet budget "max_records" 32))))
          (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length endpoints)))
            (throw (desktopError "desktop_stale_cursor")))
          (when (< index (js-length endpoints))
            (let ((endpoint (aref endpoints index)))
              (if (and (or (not (nativeGet scope "instance_ids"))
                         (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                       (or (not (nativeGet scope "workspace_refs")) (= (nativeGet endpoint "workspace_scope") "instance")
                         (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref"))))
                (let* ((response (await (funcall request endpoint (js-object :operation "list") context)))
                       (rows (js-call (js-call (nativeGet (nativeGet response "data") "items") :filter (lambda (row)
                         (and (> (nativeGet row "id" "") after)
                           (or (= (nativeGet endpoint "workspace_scope") "instance") (= (nativeGet row "cwd") (nativeGet endpoint "directory"))))))
                         :sort (lambda (a b) (if (< (nativeGet a "id") (nativeGet b "id")) -1 1)))))
                  (js-call (js-call rows :slice 0 maximum) :forEach (lambda (row)
                    (js-call items :push (funcall project endpoint row (nativeGet response "instance_epoch")))))
                  (if (> (js-length rows) maximum)
                    (setq next (js-object :endpoint_index index :after_id (nativeGet (aref rows (1- maximum)) "id")))
                    (when (< (1+ index) (js-length endpoints)) (setq next (js-object :endpoint_index (1+ index) :after_id "")))))
                (when (< (1+ index) (js-length endpoints)) (setq next (js-object :endpoint_index (1+ index) :after_id ""))))))
          (js-object :items items :complete (not next) :coverage "covered" :next_cursor next))))
      (setq createSession (async (instance workspace key context lookup)
        (let* ((endpoint (funcall endpointFor instance))
               (directory (or (nativeGet context "directory") (nativeGet endpoint "directory"))))
          (unless (or (= workspace (nativeGet endpoint "workspace_ref"))
                      (and (= (nativeGet endpoint "workspace_scope") "instance")
                        (= workspace (str "claude-workspace-" (hashValue directory)))))
            (throw (desktopError "desktop_target_mismatch")))
          (let* ((response (await (funcall request endpoint
                   (js-object :operation (if lookup "lookup_create" "create") :key key :directory directory
                     :native_id (randomUUID) :title (nativeGet context "title" nil)
                     :model_selection (nativeGet context "model_selection" nil))
                   (Object/assign (js-object) context (js-object :expected_epoch (nativeGet instance "instance_epoch"))))))
                 (row (nativeGet (nativeGet response "data") "thread")))
            (if (not row) (js-object :state "unknown" :evidence_level "none")
              (js-object :state "ready" :creation_key key :native_ref (nativeGet row "id")
                :session (funcall project endpoint row (nativeGet response "instance_epoch")) :evidence_level "native_protocol"))))))
      (js-object :capabilities capabilities :probe probe :listSessions listSessions
        :initialize (lambda (context) (setq closed false)) :close (async () (setq closed t))
        :probeInstance (async (instance context)
          (let* ((endpoint (funcall endpointFor instance))
                 (response (await (funcall request endpoint (js-object :operation "list") context))))
            (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
              :instance_epoch (nativeGet response "instance_epoch") :evidence_level "native_protocol")))
        :discover (async (visibility page context)
          (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
            (nativeGet page "cursor") (js-object :max_records 100) context)))
        :create (async (instance workspace key context) (await (funcall createSession instance workspace key context false)))
        :lookupCreate (async (instance key ref context)
          (await (funcall createSession instance (nativeGet (funcall endpointFor instance) "workspace_ref") key context t)))
        :rename (async (session title context)
          (let* ((endpoint (funcall endpointFor session))
                 (response (await (funcall request endpoint
                   (js-object :operation "rename" :thread (nativeGet session "native_session_id") :title title)
                   (Object/assign (js-object) context (js-object :expected_epoch (nativeGet session "instance_epoch"))))))
                 (row (nativeGet (nativeGet response "data") "thread")))
            (unless (= (nativeGet row "title") title) (throw (desktopError "desktop_rename_unconfirmed")))
            (js-object :state "ready" :session (funcall project endpoint row (nativeGet response "instance_epoch")) :evidence_level "native_protocol")))
        :submit (async (binding envelope mode key context)
          (let ((started false))
            (try
              (let ((endpoint (funcall endpointFor binding)) (text (renderEnvelope envelope 262144)))
                (await (funcall probe binding binding context))
                (setq started t)
                (let ((response (await (funcall request endpoint
                  (js-object :operation "submit" :thread (nativeGet binding "native_session_id") :text text :dispatch_key (randomUUID))
                  (Object/assign (js-object) context (js-object :expected_epoch (nativeGet binding "instance_epoch")))))))
                  (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                    :native_receipt_key (nativeGet (nativeGet response "data") "native_receipt_key"))))
              (catch error (js-object :state (if started "unknown" "failed") :kind (if started "unknown" "rejected")
                :definite_not_sent (not started) :retryable (not started) :evidence_level "none")))))
        :readMessages (async (session cursor budget context)
          (let* ((endpoint (funcall endpointFor session))
                 (response (await (funcall request endpoint (js-object :operation "messages" :thread (nativeGet session "native_session_id"))
                   (Object/assign (js-object) context (js-object :expected_epoch (nativeGet session "instance_epoch"))))))
                 (rows (nativeGet (nativeGet response "data") "transcript"))
                 (items (js-array)) (bytes 2) (after (nativeGet cursor "after_id" nil)) (found (not after))
                 (more false) (last nil) (maximum (Math/min 128 (nativeGet budget "max_records" 32))))
            (unless (and (Array/isArray rows) (<= (js-length rows) 10000)) (throw (desktopError "desktop_frame_limit")))
            (js-call rows :forEach (lambda (row)
              (let* ((message (nativeGet row "message" row)) (role (nativeGet message "role" (nativeGet row "type")))
                     (id (nativeGet row "uuid" (nativeGet message "id"))) (content (nativeGet message "content"))
                     (text (if (= (nativeTypeOf content) "string") content
                       (if (Array/isArray content) (js-call (js-call (js-call content :filter (lambda (b) (= (nativeGet b "type") "text")))
                         :map (lambda (b) (nativeGet b "text" ""))) :join "\n") ""))))
                (if (not found) (when (= id after) (setq found t))
                  (when (and (not more) (= (nativeTypeOf id) "string") (> (js-length text) 0)
                    (js-call (js-array "user" "assistant") :includes role))
                    (let* ((item (js-object :native_message_id id :role role :text text)) (size (utf8Bytes (JSON/stringify item))))
                      (if (or (>= (js-length items) maximum) (> (+ bytes size) (Math/min 524288 (nativeGet budget "max_bytes" 524288))))
                        (setq more t)
                        (progn (js-call items :push item) (setq last id bytes (+ bytes size))))))))))
            (unless found (throw (desktopError "desktop_stale_cursor")))
            (when (and more (not last)) (throw (desktopError "desktop_frame_limit")))
            (js-object :items items :complete (not more) :coverage "partial"
              :next_cursor (when more (js-object :after_id last)))))
        :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
        :observe (async (binding ref cursor budget context) (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil)))))
  (export createClaudeDesktopPort))
