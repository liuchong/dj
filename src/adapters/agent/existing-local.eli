(module dj.adapters.agent.existing-local
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" hashValue)
  (import "./native-local.eli" ownedJson metadataCommand expectedEpoch)
  (import "./desktop-transport.eli" desktopDeadline desktopError)
  (import "node:fs/promises" open lstat realpath)
  (import "node:fs" constants)
  (import "node:path" dirname resolve relative)
  (import "node:http" request)
  (import "node:crypto" createHash randomUUID)
  (import "bun:sqlite" Database)
  (defconst localBodyLimit 8388608)
  (defun localOrigin (value &optional websocket)
    (let ((url (new globalThis.URL value)))
      (unless (and (= (nativeGet url "protocol") (if websocket "ws:" "http:"))
        (js-call (js-array "127.0.0.1" "[::1]") :includes (nativeGet url "hostname"))
        (> (js-length (nativeGet url "port")) 0)
        (= (nativeGet url "pathname") (if websocket "/control" "/"))
        (= (nativeGet url "username") "") (= (nativeGet url "password") "")
        (= (nativeGet url "search") "") (= (nativeGet url "hash") ""))
        (throw (desktopError "local_agent_origin"))) url))
  (defasync privateText (path)
    (let ((file (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW"))))))
      (try (let ((info (await (js-call file :stat))))
        (unless (and (js-call info :isFile) (= (nativeGet info "uid") (js-call globalThis.process :getuid))
          (= (nativeBitAnd (nativeGet info "mode") 63) 0) (> (nativeGet info "size") 0) (<= (nativeGet info "size") 8192))
          (throw (desktopError "local_agent_token")))
        (let ((text (js-call (await (js-call file :readFile "utf8")) :trim)))
          (unless (and (> (js-length text) 0) (not (js-call (new globalThis.RegExp "[\\r\\n]") :test text)))
            (throw (desktopError "local_agent_token"))) text))
        (finally (await (js-call file :close))))))
  (defasync processRow (binding context &optional parent)
    (let* ((helper (nativeGet binding "process_helper_ref")) (info (await (lstat helper)))
      (pid (nativeGet binding (if parent "parent_pid" "pid"))))
      (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
        (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
        (= (nativeBitAnd (nativeGet info "mode") 18) 0) (Number/isSafeInteger pid) (> pid 0))
        (throw (desktopError "local_agent_process")))
      (let ((row (JSON/parse (await (metadataCommand helper (js-array (str pid)) context)))))
        (unless (and (= (nativeGet row "pid") pid) (= (nativeGet row "uid") (js-call globalThis.process :getuid))
          (= (nativeGet row "birth") (nativeGet binding (if parent "parent_birth" "process_birth")))
          (= (nativeGet row "executable") (nativeGet binding (if parent "parent_executable_ref" "executable_ref"))))
          (throw (desktopError "local_agent_generation"))) row)))
  (defasync localIdentity (endpoint context)
    (let* ((provider (nativeGet endpoint "native_provider")) (binding (nativeGet endpoint "process_binding"))
      (row (await (processRow binding context))) (pid (nativeGet row "pid"))
      (exe (nativeGet row "executable")) (manifest nil) (parent nil)
      (url (localOrigin (nativeGet endpoint "base_url") (= provider "kimi-desktop"))))
      (when (js-call (js-array "kimi-desktop" "dsh-desktop") :includes provider)
        (setq parent (await (processRow binding context t)))
        (unless (= (js-call (await (metadataCommand "ps" (js-array "-p" (str pid) "-o" "ppid=") context)) :trim)
          (str (nativeGet parent "pid"))) (throw (desktopError "local_agent_parent"))))
      (cond
        ((= provider "kimi-desktop")
          (setq manifest (await (ownedJson (nativeGet endpoint "registry_path"))))
          (let* ((generation (nativeGet manifest "daemonGeneration"))
            (receiver (nativeGet (nativeGet manifest "control") "endpoint"))
            (main (nativeGet parent "executable")))
            (unless (and (= (nativeGet manifest "lifecycleStatus") "running")
              (= (nativeGet receiver "pid") pid) (= (nativeGet generation "pid") pid)
              (= (nativeGet receiver "url") (nativeGet endpoint "base_url"))
              (= (nativeGet (nativeGet generation "processStartIdentity") "kind") "darwin_ps_lstart")
              (= (nativeGet (nativeGet generation "processStartIdentity") "value")
                (js-call (await (metadataCommand "ps" (js-array "-p" (str pid) "-o" "lstart=") context)) :trim))
              (js-call main :endsWith "/Kimi.app/Contents/MacOS/Kimi")
              (js-call exe :startsWith (str (dirname (dirname main)) "/Frameworks/")))
              (throw (desktopError "local_agent_work_identity")))))
        ((= provider "kimi-web")
          (setq manifest (await (ownedJson (nativeGet endpoint "registry_path"))))
          (unless (and (= (nativeGet manifest "pid") pid)
            (= (str (nativeGet manifest "port")) (nativeGet url "port"))
            (js-call (js-array "127.0.0.1" "::1") :includes (nativeGet manifest "host"))
            (= (resolve (nativeGet endpoint "data_root") "server.token") (resolve (nativeGet endpoint "credential_ref")))
            (js-call (new globalThis.RegExp "(?:^|/)(?:kimi|kimi-code|kimi-cli|kimi-cod)$") :test exe))
            (throw (desktopError "local_agent_kimi_registry"))))
        ((= provider "dsh-desktop")
          (unless (and (= exe (nativeGet parent "executable"))
            (js-call exe :endsWith "/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness")
            (js-call (await (metadataCommand "ps" (js-array "-p" (str pid) "-o" "args=") context)) :includes "/@deepseek-ai/dsh-desktop-host/lib/index.js"))
            (throw (desktopError "local_agent_dsh_parent"))))
        ((= provider "dsh-web")
          (let* ((entry (nativeGet binding "entry_ref")) (package-ref (nativeGet binding "package_ref"))
            (package (await (ownedJson package-ref)))
            (args (await (metadataCommand "ps" (js-array "-p" (str pid) "-o" "args=") context)))
            (command (js-call args :match (new globalThis.RegExp "^\\S+\\s+(\\S+)\\s+([\\s\\S]*)$")))
            (observed-entry (and command (aref command 1))) (tail (if command (aref command 2) "")))
            (unless (and (= (nativeGet package "name") "@deepseek-ai/dsh")
              (not (js-call (relative (dirname package-ref) entry) :startsWith ".."))
              observed-entry (= (await (realpath observed-entry)) (await (realpath entry)))
              (js-call (new globalThis.RegExp "(?:^|/)(?:node|bun)$") :test exe)
              (js-call (new globalThis.RegExp "(?:^\\s*web(?:\\s|$)|(?:^|\\s)--profile(?:=|\\s+)web(?:\\s|$))") :test tail))
              (throw (desktopError "local_agent_dsh_web")))))
        (t (throw (desktopError "local_agent_provider"))))
      (let ((listeners (await (metadataCommand "lsof" (js-array "-nP" "-a" "-p" (str pid)
        (str "-iTCP:" (nativeGet url "port")) "-sTCP:LISTEN" "-Fn") context))))
        (unless (js-call (js-call listeners :split "\n") :includes (str "n" (nativeGet url "host")))
          (throw (desktopError "local_agent_listener"))))
      (js-object :manifest manifest :instance_epoch (str "local_" (hashValue (js-array provider pid
        (nativeGet row "birth") exe (nativeGet endpoint "base_url") (nativeGet parent "birth" nil)
        (nativeGet manifest "server_id" nil) (nativeGet (nativeGet manifest "daemonGeneration") "generationId" nil)))))))
  (defasync localHeaders (endpoint identity)
    (let ((provider (nativeGet endpoint "native_provider")))
      (cond ((= provider "kimi-desktop")
        (let ((auth (nativeGet (nativeGet (nativeGet (nativeGet identity "manifest") "control") "endpoint") "auth")))
          (unless (and (= (nativeGet auth "mode") "loopback-dev-token")
            (= (nativeTypeOf (nativeGet auth "token")) "string") (> (js-length (nativeGet auth "token")) 0)
            (not (js-call (new globalThis.RegExp "[\\r\\n]") :test (nativeGet auth "token"))))
            (throw (desktopError "local_agent_work_auth")))
          (js-object :Authorization (str "Bearer " (nativeGet auth "token")))))
        ((= provider "kimi-web") (js-object :Authorization (str "Bearer " (await (privateText (nativeGet endpoint "credential_ref"))))))
        ((nativeGet endpoint "credential_ref")
          (let ((auth (await (ownedJson (nativeGet endpoint "credential_ref") t))))
            (unless (and (= (nativeGet auth "endpoint") (nativeGet endpoint "base_url"))
              (= (nativeTypeOf (nativeGet auth "cookie")) "string")
              (not (js-call (new globalThis.RegExp "[\\r\\n]") :test (nativeGet auth "cookie"))))
              (throw (desktopError "local_agent_auth_target"))) (js-object :Cookie (nativeGet auth "cookie"))))
        ((= provider "dsh-desktop")
          (let* ((url (localOrigin (nativeGet endpoint "base_url")))
            (name (str "dsh-auth-" (js-call (js-call (createHash "sha256") :update (nativeGet url "host")) :digest "base64url")))
            (path (nativeGet endpoint "cookie_database")) (info (await (lstat path))))
            (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
              (= (nativeGet info "uid") (js-call globalThis.process :getuid)) (= (nativeBitAnd (nativeGet info "mode") 18) 0))
              (throw (desktopError "local_agent_cookie_file")))
            (let ((db (new Database path (js-object :readonly t :create false))))
              (try (let ((rows (js-call (js-call db :query "SELECT value FROM cookies WHERE host_key=? AND name=?") :all
                (nativeGet url "hostname") name)))
                (unless (and (= (js-length rows) 1) (> (js-length (nativeGet (aref rows 0) "value" "")) 0))
                  (throw (desktopError "local_agent_cookie_unavailable")))
                (js-object :Cookie (str name "=" (nativeGet (aref rows 0) "value"))))
                (finally (js-call db :close))))))
        (t (js-object)))))
  (defasync localHttp (endpoint path payload context)
    (let* ((identity (await (localIdentity endpoint context)))
      (headers (await (localHeaders endpoint identity))) (url (localOrigin (nativeGet endpoint "base_url")))
      (body (and payload (JSON/stringify payload))))
      (expectedEpoch (nativeGet identity "instance_epoch") context)
      (unless (and (js-call path :startsWith "/api/") (not (js-call path :includes "\r"))
        (not (js-call path :includes "\n")) (or (not body) (<= (Buffer/byteLength body "utf8") 1048576)))
        (throw (desktopError "local_agent_request")))
      (await (new globalThis.Promise (lambda (resolve reject)
        (let ((req nil) (done false) (timer nil) (finish nil) (abort nil) (signal (nativeGet context "abort_signal")))
          (setq finish (lambda (error result) (unless done (setq done t)
            (when timer (nativeClearTimeout timer)) (when signal (js-call signal :removeEventListener "abort" abort))
            (when req (js-call req :destroy)) (if error (funcall reject error) (funcall resolve result)))))
          (setq abort (lambda () (funcall finish (desktopError "local_agent_cancelled") nil)))
          (setq timer (nativeSetTimeout (lambda () (funcall finish (desktopError "local_agent_timeout") nil)) (desktopDeadline context)))
          (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
          (setq req (request (js-object :hostname (js-call (js-call (nativeGet url "hostname") :replaceAll "[" "") :replaceAll "]" "")
            :port (nativeGet url "port") :path path :method (if body "POST" "GET")
            :headers (Object/assign (js-object :Content-Type "application/json") headers))
            (lambda (response)
              (let ((parts (js-array)) (size 0))
                (js-call response :on "data" (lambda (chunk) (setq size (+ size (nativeGet chunk "length")))
                  (if (> size localBodyLimit) (funcall finish (desktopError "local_agent_response_limit") nil) (js-call parts :push chunk))))
                (js-call response :on "error" (lambda (unused) (funcall finish (desktopError "local_agent_response") nil)))
                (js-call response :on "end" (lambda () (try
                  (let ((code (nativeGet response "statusCode")))
                    (unless (and (>= code 200) (< code 300))
                      (let ((error (desktopError "local_agent_http"))) (put error :status code) (throw error)))
                    (funcall finish nil (js-object :data (JSON/parse (js-call (Buffer/concat parts) :toString "utf8"))
                      :instance_epoch (nativeGet identity "instance_epoch"))))
                  (catch error (funcall finish error nil)))))))))
          (js-call req :on "error" (lambda (unused) (funcall finish (desktopError "local_agent_transport") nil)))
          (when (and body (nativeGet context "write_state")) (put (nativeGet context "write_state") :sent t))
          (js-call req :end body)))))))
  (defasync localWorkRpc (endpoint method params context)
    (unless (js-call (js-array "capabilities.get" "conversations.list" "conversations.getBusy" "conversations.getMessages"
      "conversations.create" "conversations.rename" "conversations.send") :includes method)
      (throw (desktopError "local_agent_method")))
    (let* ((identity (await (localIdentity endpoint context))) (headers (await (localHeaders endpoint identity)))
      (id (randomUUID)) (wire (JSON/stringify (js-object :jsonrpc "2.0" :id id :method method :params params))))
      (expectedEpoch (nativeGet identity "instance_epoch") context)
      (await (new globalThis.Promise (lambda (resolve reject)
        (let ((socket nil) (timer nil) (done false) (finish nil) (abort nil) (signal (nativeGet context "abort_signal")))
          (setq finish (lambda (error value) (unless done (setq done t)
            (when timer (nativeClearTimeout timer)) (when signal (js-call signal :removeEventListener "abort" abort))
            (when socket (js-call socket :close)) (if error (funcall reject error)
              (funcall resolve (js-object :data value :instance_epoch (nativeGet identity "instance_epoch")))))))
          (setq abort (lambda () (funcall finish (desktopError "local_agent_cancelled") nil)))
          (setq timer (nativeSetTimeout (lambda () (funcall finish (desktopError "local_agent_timeout") nil)) (desktopDeadline context)))
          (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
          (setq socket (new globalThis.WebSocket (nativeGet endpoint "base_url") (js-object :headers headers :maxPayloadLength localBodyLimit)))
          (put socket :onopen (lambda ()
            (when (nativeGet context "write_state") (put (nativeGet context "write_state") :sent t))
            (js-call socket :send wire)))
          (put socket :onmessage (lambda (message) (try
            (let ((value (JSON/parse (nativeGet message "data"))))
              (when (= (nativeGet value "id") id)
                (unless (and (= (nativeGet value "jsonrpc") "2.0") (not (nativeGet value "error"))
                  (= (nativeTypeOf (nativeGet value "result")) "object")) (throw (desktopError "local_agent_work_rpc")))
                (funcall finish nil (nativeGet value "result"))))
            (catch error (funcall finish (desktopError "local_agent_work_response") nil)))))
          (put socket :onerror (lambda (unused) (funcall finish (desktopError "local_agent_work_transport") nil)))
          (put socket :onclose (lambda (unused) (unless done (funcall finish (desktopError "local_agent_work_closed") nil))))))))))
  (export localOrigin localIdentity localHeaders localHttp localWorkRpc))
