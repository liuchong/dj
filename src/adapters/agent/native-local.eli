(module dj.adapters.agent.native-local
  (import "../../core/native.eli" NativeNumber nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" hashValue)
  (import "./desktop-transport.eli" desktopError desktopDeadline socketIdentity)
  (import "node:fs/promises" open lstat)
  (import "node:fs" constants)
  (import "node:child_process" execFile)
  (import "node:crypto" createHash)
  (import "node:https" request)
  (import "node:tls" connect)

  (defun localDigest (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defasync ownedJson (path &optional private)
    (let ((file (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW"))))))
      (try
        (let ((info (await (js-call file :stat))))
          (unless (and (js-call info :isFile)
                       (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                       (= (nativeBitAnd (nativeGet info "mode") (if private 63 18)) 0)
                       (> (nativeGet info "size") 0) (<= (nativeGet info "size") 65536))
            (throw (desktopError "native_private_file")))
          (let ((bytes (Buffer/alloc 65537)))
            (let ((n (nativeGet (await (js-call file :read bytes 0 65537 0)) "bytesRead")))
              (unless (<= n 65536) (throw (desktopError "native_private_file")))
              (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode
                (js-call bytes :subarray 0 n))))))
        (finally (await (js-call file :close))))))
  ;; These are bounded metadata commands, never an Agent launch or prompt argv.
  (defun metadataCommand (file args context)
    (new globalThis.Promise (lambda (resolve reject)
      (execFile file args (js-object :timeout (Math/max 1 (Math/ceil (desktopDeadline context))) :maxBuffer 65536 :encoding "utf8")
        (lambda (error stdout stderr)
          (if error (funcall reject (desktopError "native_process_unavailable")) (funcall resolve stdout)))))))
  (defasync processProof (endpoint context)
    (let* ((binding (nativeGet endpoint "process_binding"))
           (pid (nativeGet binding "pid")) (helper (nativeGet binding "process_helper_ref"))
           (info (await (lstat helper))))
      (unless (and (Number/isSafeInteger pid) (> pid 0) (js-call info :isFile)
                   (not (js-call info :isSymbolicLink))
                   (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
                   (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (desktopError "native_process_helper")))
      (let* ((row (JSON/parse (await (metadataCommand helper (js-array (str pid)) context))))
             (tool (nativeGet endpoint "tool")) (exe (nativeGet row "executable" "")))
        (unless (and (= (nativeGet row "pid") pid)
                     (= (nativeGet row "uid") (js-call globalThis.process :getuid))
                     (= (nativeGet row "birth") (nativeGet binding "process_birth"))
                     (if (= tool "antigravity")
                       (js-call exe :endsWith ".app/Contents/Resources/bin/language_server")
                       (and (= tool "claude") (js-call exe :endsWith "/claude"))))
          (throw (desktopError "native_process_changed")))
        (if (= tool "antigravity")
          (let* ((url (new globalThis.URL (nativeGet endpoint "base_url")))
                 (port (nativeGet url "port"))
                 (listeners (await (metadataCommand "lsof"
                   (js-array "-nP" "-a" "-p" (str pid) (str "-iTCP:" port) "-sTCP:LISTEN" "-Fn") context))))
            (unless (and (= (nativeGet url "protocol") "https:") (= (nativeGet url "hostname") "127.0.0.1")
                         (= (nativeGet url "pathname") "/") (= (nativeGet url "search") "")
                         (= (nativeGet url "hash") "") (= (nativeGet url "username") "")
                         (= (nativeGet url "password") "")
                         (js-call (js-call listeners :split "\n") :includes (str "n127.0.0.1:" port)))
              (throw (desktopError "native_listener_changed"))))
          (let* ((socket (nativeGet endpoint "socket_path"))
                 (identity (await (socketIdentity socket)))
                 (listeners (await (metadataCommand "lsof" (js-array "-nP" "-a" "-p" (str pid) "-U" "-Fn") context))))
            (unless (js-call (js-call listeners :split "\n") :includes (str "n" socket))
              (throw (desktopError "native_listener_changed")))
            (put row :socket_identity identity)))
        (str "native_" (hashValue (js-array tool pid (nativeGet row "birth") exe
          (nativeGet row "socket_identity" nil) (nativeGet endpoint "base_url" nil)))))))
  (defun expectedEpoch (epoch target)
    (when (and (nativeGet target "instance_epoch") (not (= epoch (nativeGet target "instance_epoch"))))
      (throw (desktopError "native_process_changed"))))

  ;; Bootstrap obtains only the public certificate. No credential is sent until
  ;; the listener has been bound to its same-user process and its leaf pinned.
  (defasync localCertificate (endpoint context)
    (await (processProof endpoint context))
    (let ((url (new globalThis.URL (nativeGet endpoint "base_url"))))
      (new globalThis.Promise (lambda (resolve reject)
        (let ((socket nil) (timer nil) (done false) (finish nil))
          (setq finish (lambda (error value)
            (unless done (setq done t) (when timer (nativeClearTimeout timer))
              (when socket (js-call socket :destroy))
              (if error (funcall reject error) (funcall resolve value)))))
          (setq timer (nativeSetTimeout (lambda () (funcall finish (desktopError "native_tls_timeout") nil))
            (desktopDeadline context)))
          (setq socket (connect (js-object :host "127.0.0.1" :port (NativeNumber (nativeGet url "port"))
            :rejectUnauthorized false) (lambda ()
              (let ((raw (nativeGet (js-call socket :getPeerCertificate) "raw")))
                (if raw (funcall finish nil (js-object :certificate_sha256 (localDigest raw)
                  :certificate_pem (str "-----BEGIN CERTIFICATE-----\n"
                    (js-call raw :toString "base64") "\n-----END CERTIFICATE-----\n")))
                  (funcall finish (desktopError "native_tls_certificate") nil))))))
          (js-call socket :on "error" (lambda (unused) (funcall finish (desktopError "native_tls_certificate") nil))))))))
  (defasync antigravityRpc (endpoint method payload context)
    (unless (js-call (js-array "GetAllCascadeTrajectories" "GetCascadeTrajectorySteps" "SendUserCascadeMessage") :includes method)
      (throw (desktopError "native_rpc_method")))
    (let* ((epoch (await (processProof endpoint context)))
           (secret (await (ownedJson (nativeGet endpoint "credential_ref") t)))
           (body (JSON/stringify payload)) (url (new globalThis.URL (nativeGet endpoint "base_url"))))
      (expectedEpoch epoch context)
      (unless (and (= (nativeTypeOf (nativeGet secret "csrf_token")) "string")
                   (> (js-length (nativeGet secret "csrf_token")) 0)
                   (= (nativeTypeOf (nativeGet secret "certificate_pem")) "string")
                   (js-call (new globalThis.RegExp "^[a-f0-9]{64}$") :test
                     (nativeGet (nativeGet endpoint "process_binding") "certificate_sha256"))
                   (<= (Buffer/byteLength body) 1048576))
        (throw (desktopError "native_credential_schema")))
      (new globalThis.Promise (lambda (resolve reject)
        (let ((req nil) (timer nil) (done false) (finish nil) (abort nil)
              (signal (nativeGet context "abort_signal")))
          (setq finish (lambda (error value)
            (unless done (setq done t) (when timer (nativeClearTimeout timer))
              (when signal (js-call signal :removeEventListener "abort" abort))
              (when req (js-call req :destroy))
              (if error (funcall reject error) (funcall resolve (js-object :data value :instance_epoch epoch))))))
          (setq abort (lambda () (funcall finish (desktopError "native_cancelled") nil)))
          (setq timer (nativeSetTimeout (lambda () (funcall finish (desktopError "native_rpc_timeout") nil))
            (desktopDeadline context)))
          (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
          (setq req (request (js-object :hostname "127.0.0.1" :port (NativeNumber (nativeGet url "port"))
            :method "POST" :agent false :ca (nativeGet secret "certificate_pem") :servername "localhost"
            :checkServerIdentity (lambda (host cert)
              (unless (= (localDigest (nativeGet cert "raw"))
                         (nativeGet (nativeGet endpoint "process_binding") "certificate_sha256"))
                (desktopError "native_tls_pin")))
            :path (str "/exa.language_server_pb.LanguageServerService/" method)
            :headers (js-object :Content-Type "application/json" :Connect-Protocol-Version "1"
              :x-codeium-csrf-token (nativeGet secret "csrf_token") :Content-Length (Buffer/byteLength body)))
            (lambda (response)
              (let ((chunks (js-array)) (size 0))
                (js-call response :on "data" (lambda (chunk)
                  (setq size (+ size (js-length chunk)))
                  (if (> size 1048576) (funcall finish (desktopError "native_frame_limit") nil)
                    (js-call chunks :push chunk))))
                (js-call response :on "error" (lambda (unused) (funcall finish (desktopError "native_rpc_read") nil)))
                (js-call response :on "end" (lambda () (unless done
                  (try
                    (unless (= (nativeGet response "statusCode") 200) (throw (desktopError "native_rpc_rejected")))
                    (funcall finish nil (JSON/parse (js-call (Buffer/concat chunks) :toString "utf8")))
                    (catch invalid (funcall finish (desktopError "native_rpc_response") nil))))))))))
          (js-call req :on "error" (lambda (unused) (funcall finish (desktopError "native_rpc_transport") nil)))
          (js-call req :end body))))))
  (export ownedJson metadataCommand processProof expectedEpoch localCertificate antigravityRpc localDigest))
