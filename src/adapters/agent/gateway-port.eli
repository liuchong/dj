(module dj.adapters.agent.gateway-port
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" hashValue utf8Bytes)
  (import "../../delivery/envelope.eli" encodeAgentInput)
  (import "../../lifecycle/workspaces.eli" creationWorkspace)
  (import "./gateway-channel.eli" localGatewayUrl openGatewayChannel)
  (import "./openclaw.eli" createOpenClawProtocol)
  (import "./hermes.eli" createHermesProtocol)

  (defconst input-limit 262144)
  (defconst capabilities (js-object :session_list "supported" :session_messages "supported"
    :session_probe "supported" :session_create "supported" :session_rename "supported"
    :creation_model_selection "supported" :instance_start "unsupported" :instance_stop "unsupported"
    :session_send "supported" :start_idle "supported" :message_during_run "supported"
    :instance_epoch_refresh "supported" :lookup_send "unsupported" :lookup_create "unsupported"
    :observe "unsupported" :max_input_frame_bytes input-limit))

  (defun stringId (value)
    (and (= (nativeTypeOf value) "string") (> (js-length value) 0)))

  (defun nativeSession (tool endpoint channel row)
    (let* ((base (nativeGet endpoint "directory")) (directory (nativeGet row "directory"))
      (workspace (if (and directory (not (= directory base)))
        (str tool "-workspace-" (hashValue directory)) (nativeGet endpoint "workspace_ref"))))
      (when (and (stringId (nativeGet row "id"))
        (or (= (nativeGet endpoint "workspace_scope") "instance") (= directory base)))
        (js-object
          :tool tool :surface "cli" :native_namespace (nativeGet endpoint "native_namespace")
          :instance_id (nativeGet endpoint "instance_id") :instance_epoch (nativeGet channel "epoch")
          :native_session_id (nativeGet row "id") :workspace_ref workspace
          :directory directory
          :project_id (nativeGet row "project_id" nil) :title (or (nativeGet row "title") "")
          :live_receiver (nativeGet row "live_receiver") :runtime_state (nativeGet row "runtime_state")
          :visibility (if (nativeGet row "live_receiver") (js-array "history" "live") (js-array "history"))
          :coverage "covered" :evidence_level "native_protocol" :capabilities capabilities
          :model_selection (js-object :provider_id (nativeGet row "provider_id" nil)
            :model_id (nativeGet row "model_id" nil))))))

  (defun historyMessage (row)
    (let* ((role (nativeGet row "role")) (raw (nativeGet row "content")) (id (nativeGet row "id"))
      (body (if (Array/isArray raw)
        (js-call (js-call (js-call raw :filter (lambda (part)
          (and (= (nativeGet part "type") "text") (= (nativeTypeOf (nativeGet part "text")) "string"))))
          :map (lambda (part) (nativeGet part "text"))) :join "\n") raw)))
      (when (and (js-call (js-array "user" "assistant") :includes role)
        (stringId body) (or (stringId id) (Number/isSafeInteger id)))
        (js-object :native_message_id (str id) :role role :text body))))

  (defun unavailablePage ()
    (js-object :items (js-array) :coverage "partial" :complete false :next_cursor nil))

  (defun createGatewayPort (tool endpoints host)
    (let* ((protocol (if (= tool "hermes") (createHermesProtocol host) (createOpenClawProtocol)))
      (channels (new globalThis.Map)) (closed false)
      (endpointFor (lambda (target)
        (let ((endpoint (js-call endpoints :find (lambda (entry)
          (and (= (nativeGet entry "instance_id") (nativeGet target "instance_id"))
            (or (not (nativeGet target "native_namespace"))
              (= (nativeGet entry "native_namespace") (nativeGet target "native_namespace"))))))))
          (unless endpoint (throw (new globalThis.Error "Exact agent gateway endpoint required")))
          endpoint)))
      (open (async (endpoint context)
        (let ((slot (js-call channels :get (nativeGet endpoint "instance_id"))))
          (when closed (throw (new globalThis.Error "Agent gateway closed")))
          (unless (and slot (not (nativeGet slot "failed")) (not (and (nativeGet slot "socket")
            (js-call (nativeGet slot "socket") :closed))))
            (setq slot (js-object :socket nil :connecting nil :failed false))
            (js-call channels :set (nativeGet endpoint "instance_id") slot)
            (put slot :connecting (funcall (async ()
              (try
                (let* ((value (await (js-call (nativeGet host "credentials") :resolve (nativeGet endpoint "credential_ref"))))
                  (token (js-call protocol :token value)) (url (localGatewayUrl (nativeGet endpoint "base_url"))))
                  (unless (and (not closed) (stringId token)) (throw (new globalThis.Error "Agent gateway credentials unavailable")))
                  (let ((socket (openGatewayChannel tool url token host context)))
                    (put slot :socket socket)
                    (await (nativeGet socket "ready"))))
                (catch failure
                  (put slot :failed t)
                  (throw failure)))))))
          (await (nativeGet slot "connecting")))))
      (targetRow (async (channel endpoint target context)
        (let* ((row (await (js-call protocol :inspect channel (nativeGet target "native_session_id") context)))
          (record (when row (nativeSession tool endpoint channel row))))
          (unless (and record (= (nativeGet record "native_session_id") (nativeGet target "native_session_id"))
            (or (not (nativeGet target "workspace_ref")) (= (nativeGet record "workspace_ref") (nativeGet target "workspace_ref"))))
            (throw (new globalThis.Error "Agent gateway session changed or unavailable")))
          (js-object :row row :session record))))
      (listSessions (async (scope cursor budget context)
        (try
          (let* ((selected (js-call endpoints :filter (lambda (endpoint)
            (or (not (nativeGet scope "instance_ids"))
              (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id"))))))
            (index (nativeGet cursor "endpoint_index" 0)) (endpoint (aref selected index))
            (limit (Math/max 1 (Math/min 100 (nativeGet budget "max_records" 100)))))
            (if (not endpoint) (js-object :items (js-array) :coverage "covered" :complete t :next_cursor nil)
              (let* ((channel (await (funcall open endpoint context)))
                (page (await (js-call protocol :list channel (nativeGet cursor "native_cursor" nil) limit context)))
                (items (js-array)) (next (nativeGet page "next")))
                (js-call (nativeGet page "items") :forEach (lambda (row)
                  (let ((record (nativeSession tool endpoint channel row)))
                    (when (and record
                      (not (js-call (nativeGet scope "visibility" (js-array)) :includes "desktop-open"))
                      (or (not (nativeGet scope "workspace_refs"))
                        (js-call (nativeGet scope "workspace_refs") :includes (nativeGet record "workspace_ref"))))
                      (js-call items :push record)))))
                (js-object :items items :coverage "covered"
                  :complete (and (not next) (= (1+ index) (js-length selected)))
                  :next_cursor (cond (next (js-object :endpoint_index index :native_cursor next))
                    ((< (1+ index) (js-length selected)) (js-object :endpoint_index (1+ index))) (t nil))))))
          (catch unavailable (unavailablePage))))))
      (js-object :capabilities (Object/assign (js-object) capabilities
          (js-object :native_idempotency (if (= tool "openclaw") "supported" "unsupported")))
        :close (lambda ()
          (setq closed t)
          (js-call channels :forEach (lambda (slot)
            (when (nativeGet slot "socket") (js-call (nativeGet slot "socket") :close))))
          (js-call channels :clear))
        :probeInstance (async (instance context)
          (try
            (let* ((endpoint (funcall endpointFor instance)) (channel (await (funcall open endpoint context))))
              (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
                :instance_epoch (nativeGet channel "epoch") :evidence_level "native_protocol"))
            (catch unavailable (js-object :state "offline" :evidence_level "none"))))
        :probe (async (target binding context)
          (try
            (let* ((endpoint (funcall endpointFor binding)) (channel (await (funcall open endpoint context))))
              (nativeGet (await (funcall targetRow channel endpoint target context)) "session"))
            (catch unavailable (js-object :runtime_state "offline" :live_receiver false :reason "gateway_session_unavailable"))))
        :listSessions listSessions
        :discover (async (scope page context)
          (await (funcall listSessions
            (js-object :instance_ids (js-array (nativeGet page "instance_id")) :visibility (js-array scope))
            (nativeGet page "cursor") (js-object :max_records 100) context)))
        :readMessages (async (session cursor budget context)
          (try
            (let* ((endpoint (funcall endpointFor session)) (channel (await (funcall open endpoint context)))
              (id (nativeGet session "native_session_id"))
              (epoch (nativeGet channel "epoch"))
              (limit (Math/max 1 (Math/min 100 (nativeGet budget "max_records" 100))))
              (max-bytes (nativeGet budget "max_bytes" 1048576)))
              (unless (and (= epoch (nativeGet session "instance_epoch"))
                (or (not cursor) (and (= (nativeGet cursor "native_session_id") id)
                  (= (nativeGet cursor "instance_epoch") epoch))))
                (throw (new globalThis.Error "Agent history session changed")))
              (let* ((target (await (funcall targetRow channel endpoint session context)))
                (page (await (js-call protocol :history channel (nativeGet target "row")
                  (nativeGet cursor "native_cursor" nil) limit max-bytes context)))
                (items (js-call (js-call (nativeGet page "items") :map historyMessage) :filter (lambda (row) row)))
                (next (nativeGet page "next")))
                (when (> (utf8Bytes (JSON/stringify items)) max-bytes)
                  (throw (new globalThis.Error "Agent history budget exceeded")))
                (js-object :items items :coverage "covered" :complete (not next)
                  :next_cursor (when next (js-object :native_session_id id :instance_epoch epoch :native_cursor next)))))
            (catch unavailable (unavailablePage))))
        :create (async (instance workspace key context)
          (let ((sent false))
            (try
              (let* ((endpoint (funcall endpointFor instance)) (channel (await (funcall open endpoint context)))
                (resolved (creationWorkspace instance (js-object :workspace_ref workspace
                  :directory (nativeGet context "directory" nil)) nil))
                (directory (nativeGet (nativeGet resolved "data") "directory"))
                (title (nativeGet context "title")) (selection (nativeGet context "model_selection")))
                (unless (and (nativeGet resolved "ok") directory
                  (= (nativeGet channel "epoch") (nativeGet instance "instance_epoch")))
                  (throw (new globalThis.Error "Agent gateway creation target changed")))
                (let* ((row (await (js-call protocol :create channel directory title selection key context (lambda () (setq sent t)))))
                  (record (when (= (nativeGet row "directory") directory) (nativeSession tool endpoint channel row))))
                  (unless (and record (= (nativeGet record "workspace_ref") workspace))
                    (throw (new globalThis.Error "Agent gateway creation unconfirmed")))
                  (js-object :state "ready" :creation_key key :session record :evidence_level "native_protocol")))
              (catch unavailable (js-object :state (if sent "unknown" "failed") :definite_not_sent (not sent))))))
        :rename (async (session title context)
          (let* ((endpoint (funcall endpointFor session)) (channel (await (funcall open endpoint context)))
            (target (await (funcall targetRow channel endpoint session context))))
            (unless (= (nativeGet channel "epoch") (nativeGet session "instance_epoch"))
              (throw (new globalThis.Error "Agent gateway rename target changed")))
            (let* ((row (await (js-call protocol :rename channel (nativeGet target "row") title context)))
              (record (when row (nativeSession tool endpoint channel row))))
              (js-object :state (if (= (nativeGet record "title") title) "ready" "unknown")
                :session record :evidence_level "native_protocol"))))
        :submit (async (binding envelope mode key context)
          (let ((sent false))
            (try
              (let* ((endpoint (funcall endpointFor binding)) (channel (await (funcall open endpoint context)))
                (target (await (funcall targetRow channel endpoint binding context)))
                (session (nativeGet target "session")) (input (encodeAgentInput tool envelope key)))
                (unless (and (= (nativeGet channel "epoch") (nativeGet binding "instance_epoch"))
                  (nativeGet session "live_receiver")
                  (or (and (= mode "steer") (js-call (js-array "idle" "busy") :includes (nativeGet session "runtime_state")))
                    (and (= mode "start_idle") (= (nativeGet session "runtime_state") "idle")))
                  (<= (nativeGet input "frame_bytes") input-limit))
                  (throw (new globalThis.Error "Agent gateway session not sendable")))
                (let ((receipt (await (js-call protocol :submit channel (nativeGet target "row") (nativeGet (nativeGet input "value") "text") mode key context
                  (lambda () (setq sent t))))))
                  (if (stringId receipt)
                    (js-object :state "accepted" :kind "accepted" :native_ref receipt :evidence_level "native_protocol")
                    (js-object :state "unknown" :definite_not_sent false))))
              (catch unavailable (js-object :state (if sent "unknown" "failed")
                :retryable (not sent) :definite_not_sent (not sent)))))))))
  (export createGatewayPort))
