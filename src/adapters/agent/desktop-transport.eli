(module dj.adapters.agent.desktop-transport
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" hashValue)
  (import "node:net" createConnection)
  (import "node:http" request)
  (import "node:fs/promises" open lstat)
  (import "node:fs" constants)
  (import "node:path" isAbsolute)
  (import "node:crypto" randomUUID)

  (defconst desktopFrameLimit 16777216)
  (defun desktopError (code)
    (let ((error (new globalThis.Error "Desktop native interface unavailable")))
      (put error :code code)
      error))
  (defun desktopDeadline (context)
    (let ((remaining (- (nativeGet context "deadline" (+ (performance/now) 10000)) (performance/now))))
      (when (or (<= remaining 0) (nativeGet (nativeGet context "abort_signal") "aborted"))
        (throw (desktopError "desktop_cancelled")))
      (Math/min remaining 15000)))
  (defasync socketIdentity (path)
    (let ((info (await (lstat path (js-object :bigint t)))))
      (unless (and (js-call info :isSocket)
                   (not (js-call info :isSymbolicLink))
                   (= (str (nativeGet info "uid")) (str (js-call globalThis.process :getuid))))
        (throw (desktopError "desktop_socket_owner")))
      (str "desktop_" (hashValue (js-array path (str (nativeGet info "dev"))
        (str (nativeGet info "ino")) (str (nativeGet info "birthtimeNs")))))))
  (defasync readCursorManifest (endpoint)
    (let ((file (await (open (nativeGet endpoint "manifest_path")
                  (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW"))))))
      (try
        (let ((info (await (js-call file :stat))))
          (unless (and (js-call info :isFile)
                       (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                       (= (nativeBitAnd (nativeGet info "mode") 63) 0)
                       (> (nativeGet info "size") 0) (<= (nativeGet info "size") 65536))
            (throw (desktopError "desktop_manifest_owner")))
          (let* ((bytes (Buffer/alloc 65537))
                 (read (await (js-call file :read bytes 0 65537 0)))
                 (length (nativeGet read "bytesRead")))
            (unless (and (> length 0) (<= length 65536))
              (throw (desktopError "desktop_manifest_schema")))
            (let ((row (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
                         :decode (js-call bytes :subarray 0 length)))))
            (unless (and (= (nativeGet row "protocolVersion") 1)
                         (Number/isSafeInteger (nativeGet row "pid"))
                         (> (nativeGet row "pid") 0)
                         (= (nativeTypeOf (nativeGet row "socketPath")) "string")
                         (isAbsolute (nativeGet row "socketPath"))
                         (= (nativeTypeOf (nativeGet row "token")) "string")
                         (js-call (new globalThis.RegExp "^[a-f0-9]{64}$") :test (nativeGet row "token")))
              (throw (desktopError "desktop_manifest_schema")))
            (js-call globalThis.process :kill (nativeGet row "pid") 0)
            row)))
        (finally (await (js-call file :close))))))

  (defasync cursorRequest (endpoint payload context)
    (let* ((milliseconds (desktopDeadline context))
           (manifest (await (readCursorManifest endpoint)))
           (socket (nativeGet manifest "socketPath"))
           (identity (await (socketIdentity socket)))
           (body (JSON/stringify payload)))
      (when (and (nativeGet context "expected_epoch")
                 (not (= identity (nativeGet context "expected_epoch"))))
        (throw (desktopError "desktop_target_changed")))
      (when (or (> (Buffer/byteLength body "utf8") 1048576)
                (> (Buffer/byteLength (nativeGet payload "text" "") "utf8") 262144))
        (throw (desktopError "desktop_frame_limit")))
      (new globalThis.Promise
        (lambda (resolve reject)
          (let ((done false) (timer nil) (req nil)
                (signal (nativeGet context "abort_signal")) (finish nil) (abort nil))
            (setq finish (lambda (error value)
              (unless done
                (setq done t)
                (when timer (nativeClearTimeout timer))
                (when signal (js-call signal :removeEventListener "abort" abort))
                (when req (js-call req :destroy))
                (if error (funcall reject error)
                  (funcall resolve (js-object :data value :instance_epoch identity))))))
            (setq abort (lambda () (funcall finish (desktopError "desktop_cancelled") nil)))
            (setq timer (nativeSetTimeout
              (lambda () (funcall finish (desktopError "desktop_timeout") nil)) milliseconds))
            (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
            (setq req (request
              (js-object :socketPath socket :path "/" :method "POST" :agent false
                :headers (js-object :Authorization (str "Bearer " (nativeGet manifest "token"))
                  :Content-Type "application/json" :Content-Length (Buffer/byteLength body "utf8")))
              (lambda (response)
          (let ((chunks (js-array)) (size 0)
                (maximum (Math/min desktopFrameLimit (nativeGet context "max_response_bytes" desktopFrameLimit))))
                  (js-call response :on "data" (lambda (chunk)
                    (setq size (+ size (js-length chunk)))
                    (if (> size maximum)
                      (progn (funcall finish (desktopError "desktop_frame_limit") nil)
                        (js-call response :destroy))
                      (js-call chunks :push chunk))))
                  (js-call response :on "error" (lambda (unused)
                    (funcall finish (desktopError "desktop_transport") nil)))
                  (js-call response :on "end" (lambda ()
                    (unless done
                      (try
                        (unless (= (nativeGet response "statusCode") 200)
                          (throw (desktopError "desktop_response")))
                        (let ((text (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
                                      :decode (Buffer/concat chunks))))
                          (funcall finish nil (JSON/parse text)))
                        (catch invalid (funcall finish (desktopError "desktop_response") nil))))))))))
            (js-call req :on "error" (lambda (unused)
              (funcall finish (desktopError "desktop_transport") nil)))
            (if (nativeGet signal "aborted") (funcall abort) (js-call req :end body)))))))

  (defasync openCodexChannel (endpoint context)
    (let* ((milliseconds (desktopDeadline context))
           (identity (await (socketIdentity (nativeGet endpoint "socket_path"))))
           ;; Native IPC snapshots are indivisible vendor frames. The explicit
           ;; endpoint limit applies to that frame, not the projected port page.
           (frame-limit (Math/min desktopFrameLimit
             (nativeGet endpoint "snapshot_max_bytes" (nativeGet context "max_response_bytes" 1048576))))
           (socket (createConnection (js-object :path (nativeGet endpoint "socket_path"))))
           (buffer (Buffer/alloc 0)) (frames (js-array)) (queued-bytes 0)
           (waiting nil) (broken nil) (closed false) (client-id nil)
           (timer nil) (signal (nativeGet context "abort_signal"))
           (fail nil) (write nil) (next nil) (call nil) (abort nil) (close nil))
      (setq fail (lambda (error)
        (unless broken (setq broken error))
        (when waiting
          (funcall (nativeGet waiting "reject") broken)
          (setq waiting nil))
        (js-call socket :destroy)))
      (setq write (lambda (value)
        (when broken (throw broken))
        (let* ((body (Buffer/from (JSON/stringify value) "utf8")) (header (Buffer/alloc 4)))
          (when (> (js-length body) desktopFrameLimit) (throw (desktopError "desktop_frame_limit")))
          (js-call header :writeUInt32LE (js-length body) 0)
          (js-call socket :write (Buffer/concat (js-array header body))))))
      (setq next (lambda ()
        (new globalThis.Promise (lambda (resolve reject)
          (cond (broken (funcall reject broken))
            ((> (js-length frames) 0)
              (let ((entry (js-call frames :shift)))
                (setq queued-bytes (- queued-bytes (nativeGet entry "bytes")))
                (funcall resolve (nativeGet entry "value"))))
            (waiting (funcall reject (desktopError "desktop_concurrent_read")))
            (t (setq waiting (js-object :resolve resolve :reject reject))))))))
      (setq call (async (method params version &optional target)
        (let ((id (randomUUID)) (answer nil))
          (funcall write (Object/assign
            (js-object :type "request" :requestId id :method method :params params
              :version version :timeoutMs (Math/ceil (desktopDeadline context)))
            (if client-id (js-object :sourceClientId client-id) (js-object))
            (if target (js-object :targetClientId target) (js-object))))
          (while (not answer)
            (let ((frame (await (funcall next))))
              (when (and (= (nativeGet frame "type") "response") (= (nativeGet frame "requestId") id))
                (unless (= (nativeGet frame "resultType") "success")
                  (throw (desktopError "desktop_rejected")))
                (setq answer frame))))
          answer)))
      (setq abort (lambda () (funcall fail (desktopError "desktop_cancelled"))))
      (setq close (lambda ()
        (unless closed
          (setq closed t)
          (when timer (nativeClearTimeout timer))
          (when signal (js-call signal :removeEventListener "abort" abort))
          (funcall fail (desktopError "desktop_closed"))
          (setq frames (js-array) buffer (Buffer/alloc 0) queued-bytes 0))))
      (js-call socket :on "data" (lambda (chunk)
        (try
          (setq buffer (Buffer/concat (js-array buffer chunk)))
          (while (>= (js-length buffer) 4)
            (let ((size (js-call buffer :readUInt32LE 0)))
              (when (or (= size 0) (> size frame-limit))
                (throw (desktopError "desktop_frame_limit")))
              (if (< (js-length buffer) (+ size 4))
                (progn (setq chunk nil) (throw "desktop_partial_frame"))
                (let* ((text (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
                              :decode (js-call buffer :subarray 4 (+ size 4))))
                       (value (JSON/parse text)))
                  (setq buffer (js-call buffer :subarray (+ size 4)))
                  (cond
                    ((= (nativeGet value "type") "client-discovery-request")
                      (funcall write (js-object :type "client-discovery-response"
                        :requestId (nativeGet value "requestId") :response (js-object :canHandle false))))
                    (waiting
                      (let ((current waiting)) (setq waiting nil)
                        (funcall (nativeGet current "resolve") value)))
                    (t
                      (setq queued-bytes (+ queued-bytes size))
                      (when (or (>= (js-length frames) 32) (> queued-bytes desktopFrameLimit))
                        (throw (desktopError "desktop_frame_limit")))
                      (js-call frames :push (js-object :value value :bytes size))))))))
          (catch error
            (unless (= error "desktop_partial_frame")
              (funcall fail (desktopError "desktop_response")))))))
      (js-call socket :on "error" (lambda (unused) (funcall fail (desktopError "desktop_transport"))))
      (js-call socket :on "close" (lambda ()
        (unless closed (funcall fail (desktopError "desktop_eof")))))
      (setq timer (nativeSetTimeout (lambda () (funcall fail (desktopError "desktop_timeout"))) milliseconds))
      (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
      (try
        (when (nativeGet signal "aborted") (funcall abort))
        (let ((hello (await (funcall call "initialize" (js-object :clientType "external-text-command") 0))))
          (setq client-id (nativeGet (nativeGet hello "result") "clientId"))
          (unless (= (nativeTypeOf client-id) "string") (throw (desktopError "desktop_response"))))
        (js-object :instance_epoch identity :call call :close close
          :snapshot (async (thread)
            (let* ((discovery (await (funcall call "thread-owner-discovery"
                                (js-object :hostId "local" :conversationId thread) 1)))
                   (owner (nativeGet discovery "handledByClientId")) (snapshot nil))
              (unless (= (nativeTypeOf owner) "string") (throw (desktopError "desktop_no_owner")))
              (try
                (funcall write (js-object :type "broadcast" :method "thread-stream-following-changed"
                  :sourceClientId client-id :targetClientIds (js-array owner) :version 1
                  :params (js-object :hostId "local" :conversationId thread :following t)))
                (while (not snapshot)
                  (let* ((frame (await (funcall next))) (params (nativeGet frame "params"))
                         (change (nativeGet params "change")))
                    (when (and (= (nativeGet frame "type") "broadcast")
                               (= (nativeGet frame "method") "thread-stream-state-changed")
                               (= (nativeGet frame "sourceClientId") owner)
                               (= (nativeGet params "hostId") "local")
                               (= (nativeGet params "conversationId") thread)
                               (= (nativeGet change "type") "snapshot"))
                      (setq snapshot (nativeGet change "conversationState")))))
                (unless (= (nativeGet snapshot "id") thread) (throw (desktopError "desktop_target_mismatch")))
                (js-object :owner owner :state snapshot)
                (finally
                  (unless broken
                    (funcall write (js-object :type "broadcast" :method "thread-stream-following-changed"
                      :sourceClientId client-id :targetClientIds (js-array owner) :version 1
                      :params (js-object :hostId "local" :conversationId thread :following false)))))))))
        (catch error (funcall close) (throw error)))))
  (export desktopError desktopDeadline socketIdentity readCursorManifest cursorRequest openCodexChannel))
