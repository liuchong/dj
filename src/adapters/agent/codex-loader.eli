(module dj.adapters.agent.codex-loader
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd)
  (import "./desktop-transport.eli" desktopError desktopDeadline socketIdentity)
  (import "node:fs/promises" lstat)
  (import "node:child_process" execFile)
  (defconst pending (new globalThis.Map))
  (defconst attempts (new globalThis.Map))
  (defun command (file args context &optional input)
    (new globalThis.Promise (lambda (resolve reject)
      (let ((child (execFile file args
        (js-object :encoding "utf8" :timeout (Math/min 3000 (Math/ceil (desktopDeadline context))) :maxBuffer 65536)
        (lambda (error stdout stderr)
          (if (and error (not input)) (funcall reject (desktopError "receiver_load_process_unavailable"))
            (funcall resolve stdout))))))
        (when input (js-call (nativeGet child "stdin") :end input))))))
  (defasync trustedHelper (path)
    (let ((info (and path (await (lstat path)))))
      (unless (and info (js-call info :isFile) (not (js-call info :isSymbolicLink))
        (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
        (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (desktopError "receiver_loader_unconfigured"))) path))
  (defasync requestCodexLoad (endpoint id context)
    (unless (and (= (nativeTypeOf id) "string")
      (js-call (new globalThis.RegExp "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$" "i") :test id))
      (throw (desktopError "receiver_load_target_invalid")))
    (unless (= (nativeGet globalThis.process "platform") "darwin")
      (throw (desktopError "receiver_load_unsupported")))
    (let* ((loader (await (trustedHelper (nativeGet endpoint "receiver_loader_ref"))))
      (helper (await (trustedHelper (nativeGet endpoint "process_helper_ref"))))
      (epoch (await (socketIdentity (nativeGet endpoint "socket_path"))))
      (key (str epoch ":" id)))
      (when (and (nativeGet endpoint "instance_epoch") (not (= epoch (nativeGet endpoint "instance_epoch"))))
        (throw (desktopError "desktop_target_changed")))
      (when (js-call pending :has key) (throw (desktopError "receiver_load_in_progress")))
      (when (< (- (performance/now) (or (js-call attempts :get key) -60000)) 60000)
        (throw (desktopError "receiver_load_backoff")))
      (when (>= (nativeGet attempts "size") 256) (js-call attempts :clear))
      (js-call attempts :set key (performance/now))
      (let ((work (funcall (async ()
        (let* ((text (await (command "lsof" (js-array "-nP" "-a" "-U" "-Fp" (nativeGet endpoint "socket_path")) context)))
          (pids (Array/from (new globalThis.Set
            (js-call (js-call text :split "\n") :filter (lambda (line) (js-call (new globalThis.RegExp "^p[0-9]+$") :test line))))))
          (owners (js-array)))
          (when (> (js-length pids) 32) (throw (desktopError "receiver_load_owner_ambiguous")))
          (let ((index 0)) (while (< index (js-length pids))
            (let* ((pid (js-call (aref pids index) :slice 1))
              (row (JSON/parse (await (command helper (js-array pid) context))))
              (exe (nativeGet row "executable" "")))
              (when (and (= (nativeGet row "uid") (js-call globalThis.process :getuid))
                (js-call (new globalThis.RegExp "/(?:ChatGPT|Codex)\\.app/Contents/MacOS/(?:ChatGPT|Codex)$") :test exe))
                (js-call owners :push row)))
            (setq index (1+ index))))
          (unless (= (js-length owners) 1) (throw (desktopError "receiver_load_owner_ambiguous")))
          (unless (= epoch (await (socketIdentity (nativeGet endpoint "socket_path"))))
            (throw (desktopError "desktop_target_changed")))
          (let* ((owner (aref owners 0)) (result (JSON/parse (await (command loader (js-array) context
            (JSON/stringify (js-object :pid (nativeGet owner "pid") :birth (nativeGet owner "birth") :thread id)))))))
            (unless (= (nativeGet result "ok") t)
              (throw (desktopError (nativeGet result "reason" "receiver_load_rejected")))) result))))))
        (js-call pending :set key work)
        (try (await work) (finally (js-call pending :delete key))))))
  (export requestCodexLoad))
