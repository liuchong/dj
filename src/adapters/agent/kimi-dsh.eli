(module dj.adapters.agent.kimi-dsh
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeEncodeURIComponent)
  (import "../../core/types.eli" hashValue utf8Bytes)
  (import "../../delivery/envelope.eli" renderEnvelope)
  (import "./native-local.eli" expectedEpoch)
  (import "./desktop-transport.eli" desktopError)
  (import "./kimi-dsh-protocol.eli" createNativeClient nativeTextParts)
  (import "node:path" resolve)
  (defun nativeCapabilities (provider)
    (js-object :session_list "supported" :session_messages "supported" :session_probe "supported"
      :session_send "supported" :start_idle "supported" :session_create "supported"
      :message_during_run (if (= provider "kimi-desktop") "unsupported" "supported")
      :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "unsupported"
      :lookup_send "unsupported" :lookup_create (if (js-call provider :startsWith "dsh") "supported" "unsupported")
      :observe "unsupported" :max_input_frame_bytes 262144))
  (defun nativeRuntime (provider row)
    (cond ((or (nativeGet row "archived") (= (nativeGet row "formatStatus") "migration-required")
      (= (nativeGet row "agentAvailable") false)) "offline")
      ((and (js-call provider :startsWith "dsh") (not (= (nativeGet row "agentAvailable") t))
        (not (and (= provider "dsh-web") (= (nativeGet row "native_protocol") "legacy")))) "unknown")
      ((and (nativeGet row "pending_interaction") (not (= (nativeGet row "pending_interaction") "none"))) "waiting_permission")
      ((= (nativeGet row "busy" (nativeGet row "running")) t) "busy")
      ((= (nativeGet row "busy" (nativeGet row "running")) false) "idle") (t "unknown")))
  (defun createKimiDshPort (tool config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
      (endpointFor nil) (clientFor nil) (workspace nil) (project nil) (checked nil) (listSessions nil) (createSession nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (endpoint)
          (and (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id"))
            (or (not (nativeGet target "native_namespace")) (= (nativeGet endpoint "native_namespace") (nativeGet target "native_namespace"))))))))
          (unless (= (js-length rows) 1) (throw (desktopError "local_agent_exact_endpoint"))) (aref rows 0))))
      (setq clientFor (async (endpoint context)
        (when closed (throw (desktopError "local_agent_closed")))
        (let ((client (createNativeClient endpoint context))) (await (js-call client :connect)) client)))
      (setq workspace (lambda (endpoint row)
        (and (= (nativeTypeOf (nativeGet row "directory")) "string")
          (= (resolve (nativeGet endpoint "directory")) (resolve (nativeGet row "directory"))))))
      (setq project (lambda (endpoint row epoch)
        (let* ((provider (nativeGet endpoint "native_provider")) (state (nativeRuntime provider row)))
          (js-object :tool tool :native_namespace (nativeGet endpoint "native_namespace") :native_session_id (nativeGet row "id")
            :surface (if (js-call provider :endsWith "desktop") "desktop" "sdk")
            :instance_id (nativeGet endpoint "instance_id") :instance_epoch epoch :workspace_ref (nativeGet endpoint "workspace_ref")
            :title (nativeGet row "title" tool) :runtime_state state :live_receiver (not (= state "offline"))
            :visibility (if (= state "offline") (js-array "history") (js-array "live" "history"))
            :coverage "partial" :evidence_level "native_protocol" :capabilities (nativeCapabilities provider)))))
      (setq checked (async (target context)
        (let* ((endpoint (funcall endpointFor target)) (client (await (funcall clientFor endpoint context)))
          (row (await (js-call client :snapshot (nativeGet target "native_session_id")))) (epoch (js-call client :epoch)))
          (expectedEpoch epoch target)
          (unless (funcall workspace endpoint row) (throw (desktopError "local_agent_workspace")))
          (js-object :client client :endpoint endpoint :row row :instance_epoch epoch))))
      (setq listSessions (async (scope cursor budget context)
        (let* ((selected (js-call endpoints :filter (lambda (endpoint)
          (and (or (not (nativeGet scope "instance_ids")) (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
            (or (not (nativeGet scope "workspace_refs")) (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref")))))))
          (index (nativeGet cursor "endpoint_index" 0)) (native-cursor (nativeGet cursor "native_cursor" nil))
          (items (js-array)) (partial false) (maximum (Math/min 100 (nativeGet budget "max_records" 32))))
          (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length selected)))
            (throw (desktopError "local_agent_cursor")))
          (while (and (< index (js-length selected)) (< (js-length items) maximum))
            (let ((endpoint (aref selected index)))
              (try
                (let* ((client (await (funcall clientFor endpoint context)))
                  (page (await (js-call client :list native-cursor (- maximum (js-length items)))))
                  (next (nativeGet page "next")))
                  (when (and cursor (= index (nativeGet cursor "endpoint_index")) (nativeGet cursor "instance_epoch"))
                    (expectedEpoch (js-call client :epoch) cursor))
                  (js-call (nativeGet page "items") :forEach (lambda (row)
                    (when (funcall workspace endpoint row) (js-call items :push (funcall project endpoint row (js-call client :epoch))))))
                  (when (and next (= next native-cursor)) (throw (desktopError "local_agent_pagination")))
                  (setq native-cursor next)
                  (if next
                    (progn (setq cursor (js-object :endpoint_index index :native_cursor next :instance_epoch (js-call client :epoch)))
                      ;; One native page per budget turn, including filtered-empty pages.
                      (setq maximum (js-length items)))
                    (setq index (1+ index) cursor nil)))
                (catch error (setq partial t index (1+ index) native-cursor nil cursor nil)))))
          (js-object :items items :complete (>= index (js-length selected)) :coverage (if partial "partial" "covered")
            :next_cursor (if (< index (js-length selected)) (or cursor (js-object :endpoint_index index)) nil)))))
      (setq createSession (async (instance workspace-ref key context)
        (let ((write-state (js-object :sent false)) (id nil))
          (try
            (let* ((endpoint (funcall endpointFor instance)) (client (await (funcall clientFor endpoint context)))
              (provider (nativeGet endpoint "native_provider")) (directory (nativeGet endpoint "directory")) (row nil))
              (expectedEpoch (js-call client :epoch) instance)
              (unless (= workspace-ref (nativeGet endpoint "workspace_ref")) (throw (desktopError "local_agent_workspace")))
              (cond ((= provider "kimi-desktop")
                (let ((created (await (js-call client :work "conversations.create" (js-object :agentId "main" :sessionKey "agent:main:main"
                  :origin "client" :activate false :workspacePath directory) write-state))))
                  (setq id (nativeGet (nativeGet created "conversation") "conversationKey"))
                  (when (nativeGet context "title") (await (js-call client :work "conversations.rename"
                    (js-object :agentId "main" :conversationKey id :title (nativeGet context "title")) write-state)))))
                ((= provider "kimi-web")
                  (let ((created (await (js-call client :api "sessions" (js-object :metadata (js-object :cwd directory)
                    :title (nativeGet context "title" tool)) write-state)))) (setq id (nativeGet created "id"))))
                (t (setq id (str "session-" (js-call (hashValue key) :slice 0 32)))
                  (let ((created (await (js-call client :request "create" (js-object :cwd directory :sessionId id) write-state))))
                    (unless (= (nativeGet created "sessionId") id) (throw (desktopError "local_agent_create_ack"))))
                  (when (nativeGet context "title") (await (js-call client :request "rename"
                    (js-object :sessionId id :title (nativeGet context "title")) write-state)))))
              (setq row (await (js-call client :snapshot id)))
              (unless (funcall workspace endpoint row) (throw (desktopError "local_agent_create_workspace")))
              (js-object :state "ready" :creation_key key :session (funcall project endpoint row (js-call client :epoch)) :evidence_level "native_protocol"))
            (catch error (js-object :state (if (nativeGet write-state "sent") "unknown" "failed")
              :native_ref (if id (js-object :native_session_id id) nil) :definite_not_sent (not (nativeGet write-state "sent")) :evidence_level "none"))))))
      (js-object :capabilities (nativeCapabilities (if (= tool "dsh") "dsh" "kimi-desktop"))
        :initialize (lambda (context) (setq closed false)) :close (async () (setq closed t))
        :listSessions listSessions
        :discover (async (visibility page context)
          (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
            (nativeGet page "cursor") (js-object :max_records 100) context))
        :probeInstance (async (instance context)
          (try (let ((client (await (funcall clientFor (funcall endpointFor instance) context))))
            (js-object :state "ready" :native_namespace (nativeGet instance "native_namespace") :instance_epoch (js-call client :epoch)
              :evidence_level "native_protocol"))
            (catch error (js-object :state "offline" :reason "native_receiver_unavailable" :evidence_level "none"))))
        :probe (async (target context)
          (let ((result (await (funcall checked target context))))
            (funcall project (nativeGet result "endpoint") (nativeGet result "row") (nativeGet result "instance_epoch"))))
        :readMessages (async (session cursor budget context)
          (let* ((result (await (funcall checked session context))) (client (nativeGet result "client"))
            (provider (nativeGet (nativeGet result "endpoint") "native_provider")) (id (nativeGet session "native_session_id"))
            (maximum (Math/min 100 (nativeGet budget "max_records" 32))) (items (js-array)) (next nil))
            (when cursor
              (unless (= (nativeGet cursor "native_session_id") id) (throw (desktopError "local_agent_message_cursor")))
              (expectedEpoch (nativeGet result "instance_epoch") cursor))
            (cond ((= provider "kimi-desktop")
              (let* ((args (js-object :agentId "main" :conversationKey id :limit maximum :includeHeavyFields false)) (value nil))
                (when (nativeGet cursor "before_id") (put args :beforeMessageId (nativeGet cursor "before_id")))
                (setq value (await (js-call client :work "conversations.getMessages" args)))
                (unless (= (nativeGet value "conversationKey") id) (throw (desktopError "local_agent_session_mismatch")))
                (let ((rows (nativeGet value "messages")))
                  (js-call rows :forEach (lambda (row)
                    (when (js-call (js-array "user" "assistant") :includes (nativeGet row "role"))
                      (js-call items :push (js-object :native_message_id (nativeGet row "id") :role (nativeGet row "role")
                        :text (nativeTextParts (nativeGet row "parts") t))))))
                  (when (and (nativeGet value "hasMore") (> (js-length rows) 0)) (setq next (js-object :before_id (nativeGet (aref rows 0) "id")))))))
              ((= provider "kimi-web")
                (let ((query (new globalThis.URLSearchParams (js-object :page_size (str maximum)))))
                  (when (nativeGet cursor "before_id") (js-call query :set "before_id" (nativeGet cursor "before_id")))
                  (let* ((value (await (js-call client :api (str "sessions/" (nativeEncodeURIComponent id) "/messages?" (js-call query :toString)))))
                    (rows (nativeGet value "items")))
                    (js-call (js-call (js-call rows :slice) :reverse) :forEach (lambda (row)
                      (when (and (js-call (js-array "user" "assistant") :includes (nativeGet row "role"))
                        (not (= (nativeGet (nativeGet (nativeGet row "metadata") "origin") "kind") "injection")))
                        (js-call items :push (js-object :native_message_id (nativeGet row "id") :role (nativeGet row "role")
                          :text (nativeTextParts (nativeGet row "content")))))))
                    (when (and (nativeGet value "has_more") (> (js-length rows) 0)) (setq next (js-object :before_id (nativeGet (aref rows (1- (js-length rows))) "id")))))))
              (t (let* ((protocol (js-call client :protocol)) (args (js-object :sessionId id :maxMessages maximum))
                (value nil) (rows nil) (through (nativeGet cursor "through_seq" nil)))
                (when (= protocol "typert")
                  (unless through (setq through (nativeGet (await (js-call client :request "projections" (js-object :sessionId id))) "asOfSeq")))
                  (setq args (js-object :address (js-object :kind "session" :sessionId id) :throughSeq through :maxMessages maximum)))
                (when (nativeGet cursor "before_seq") (put args :beforeSeq (nativeGet cursor "before_seq")))
                (setq value (if (= protocol "typert") (await (js-call client :request "page" args)) (await (js-call client :dsh "history" args))))
                (setq rows (nativeGet value (if (= protocol "typert") "records" "events")))
                (let ((minimum nil))
                  (js-call rows :forEach (lambda (record)
                    (let* ((event (nativeGet record "event")) (seq (nativeGet event "seq")) (kind (nativeGet event "type"))
                      (data (nativeGet event "data")) (text nil) (role nil))
                      (when (Number/isSafeInteger seq) (setq minimum (if (nil? minimum) seq (Math/min minimum seq))))
                      (cond ((and (= kind "user/message") (= (nativeGet (nativeGet data "source") "kind") "user"))
                        (setq role "user" text (nativeTextParts (nativeGet data "content"))))
                        ((= kind "assistant/message") (setq role "assistant" text (nativeTextParts (nativeGet (nativeGet data "message") "content")))))
                      (when (and role text (> (js-length text) 0))
                        (js-call items :push (js-object :native_message_id (str seq) :role role :text text))))))
                  (when (and (nativeGet value "hasMore") minimum) (setq next (js-object :before_seq minimum :through_seq through)))))))
            (when (or (> (js-length items) maximum) (> (utf8Bytes (JSON/stringify items)) (nativeGet budget "max_bytes" 524288)))
              (throw (desktopError "local_agent_message_budget")))
            (js-object :items items :complete (not next) :coverage "partial" :next_cursor (and next
              (Object/assign next (js-object :native_session_id id :instance_epoch (nativeGet result "instance_epoch")))))))
        :submit (async (binding envelope mode key context)
          (let ((write-state (js-object :sent false)))
            (try
              (let* ((result (await (funcall checked binding context))) (client (nativeGet result "client"))
                (endpoint (nativeGet result "endpoint")) (provider (nativeGet endpoint "native_provider"))
                (row (nativeGet result "row")) (state (nativeRuntime provider row)) (text (renderEnvelope envelope 250000))
                (id (nativeGet binding "native_session_id")) (receipt nil))
                (unless (and (js-call (js-array "steer" "start_idle") :includes mode)
                  (or (= state "idle") (and (= mode "steer") (not (= provider "kimi-desktop"))
                    (js-call (js-array "busy" "waiting_permission") :includes state)))) (throw (desktopError "local_agent_not_sendable")))
                (cond ((= provider "kimi-desktop")
                  (let ((value (await (js-call client :work "conversations.send" (js-object :agentId "main" :conversationKey id :text text) write-state))))
                    (unless (and (= (nativeGet value "conversationKey") id) (= (nativeGet value "accepted") t) (nativeGet value "turnId"))
                      (throw (desktopError "local_agent_send_ack"))) (setq receipt (nativeGet value "turnId"))))
                  ((= provider "kimi-web")
                    (let ((value (await (js-call client :api (str "sessions/" (nativeEncodeURIComponent id) "/prompts")
                      (js-object :prompt_id key :content (js-array (js-object :type "text" :text text))) write-state))))
                      (unless (= (nativeGet value "prompt_id") key) (throw (desktopError "local_agent_send_ack"))) (setq receipt key)))
                  (t (let ((value (await (js-call client :request "prompt" (js-object :sessionId id :requestId key
                    :mode (if (= mode "steer") "steer" "queue") :content (js-array (js-object :type "text" :text text))) write-state))))
                    (unless (= (nativeGet value "accepted") t) (throw (desktopError "local_agent_send_ack"))) (setq receipt key))))
                (js-object :state "accepted" :kind "accepted" :native_receipt_key receipt :evidence_level "native_protocol"))
              (catch error (js-object :state (if (nativeGet write-state "sent") "unknown" "failed")
                :kind (if (nativeGet write-state "sent") "unknown" "not_sent") :definite_not_sent (not (nativeGet write-state "sent")) :evidence_level "none")))))
        :create createSession
        :lookupCreate (async (instance key ref context)
          (if (not (= tool "dsh")) (js-object :state "unknown" :status "unsupported" :evidence_level "none")
            (try (let* ((endpoint (funcall endpointFor instance)) (client (await (funcall clientFor endpoint context)))
              (row (await (js-call client :snapshot (str "session-" (js-call (hashValue key) :slice 0 32))))))
              (expectedEpoch (js-call client :epoch) instance)
              (unless (funcall workspace endpoint row) (throw (desktopError "local_agent_workspace")))
              (js-object :state "ready" :creation_key key :session (funcall project endpoint row (js-call client :epoch)) :evidence_level "native_protocol"))
              (catch error (js-object :state "unknown" :evidence_level "none")))))
        :lookupSend (async (binding key ref context) (js-object :state "unknown" :status "unsupported" :evidence_level "none"))
        :observe (async (binding ref cursor budget context) (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil)))))
  (export createKimiDshPort nativeCapabilities nativeRuntime))
