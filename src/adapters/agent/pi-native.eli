(module dj.adapters.agent.pi-native
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" utf8Bytes)
  (import "../../delivery/envelope.eli" encodeEnvelope)
  (import "./desktop-transport.eli" readCursorManifest cursorRequest)
  (defconst piCapabilities
    (js-object :session_list "supported" :session_messages "supported"
      :session_probe "supported" :session_send "supported" :start_idle "supported"
      :session_create "unsupported" :instance_start "unsupported" :instance_stop "unsupported"
      :native_idempotency "unsupported" :lookup_send "unsupported" :lookup_create "unsupported"
      :observe "unsupported" :max_input_frame_bytes 262144))
  (defun createPiNativePort (config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (closed false))
      (let ((endpointFor nil) (request nil) (project nil) (probe nil) (listSessions nil))
        (setq endpointFor (lambda (target)
          (let ((matches (js-call endpoints :filter (lambda (endpoint)
            (and (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id"))
                 (or (not (nativeGet target "native_namespace"))
                     (= (nativeGet endpoint "native_namespace") (nativeGet target "native_namespace"))))))))
            (unless (= (js-length matches) 1)
              (throw (new globalThis.TypeError "exact Pi endpoint is required")))
            (aref matches 0))))
        (setq request (async (endpoint target operation args context)
          (when closed (throw (new globalThis.Error "Pi port is closed")))
          (let ((manifest (await (readCursorManifest endpoint))))
            (unless (and (= (nativeGet manifest "tool") "pi")
                         (= (nativeGet manifest "apiVersion") "dj-pi-receiver-v1")
                         (= (nativeGet manifest "directory") (nativeGet endpoint "directory"))
                         (= (nativeGet manifest "nativeNamespace") (nativeGet endpoint "native_namespace"))
                         (= (nativeTypeOf (nativeGet manifest "instanceEpoch")) "string")
                         (> (js-length (nativeGet manifest "instanceEpoch")) 0)
                         (= (nativeTypeOf (nativeGet manifest "sessionId")) "string")
                         (> (js-length (nativeGet manifest "sessionId")) 0)
                         (or (not (nativeGet target "native_session_id"))
                             (= (nativeGet target "native_session_id") (nativeGet manifest "sessionId"))))
              (throw (new globalThis.TypeError "Pi receiver identity changed")))
            (let* ((call-context (Object/assign (js-object) context
                       (if (nativeGet target "instance_epoch")
                         (js-object :expected_epoch (nativeGet target "instance_epoch")) (js-object))))
                   (response (await (cursorRequest endpoint
                     (Object/assign (js-object :schema_version 1 :operation operation
                       :session_id (nativeGet manifest "sessionId") :receiver_epoch (nativeGet manifest "instanceEpoch")) args)
                     call-context)))
                   (wire (nativeGet response "data")) (data (nativeGet wire "data")))
              (unless (and (= (nativeGet wire "ok") t)
                           (= (nativeGet data "session_id") (nativeGet manifest "sessionId"))
                           (= (nativeGet data "receiver_epoch") (nativeGet manifest "instanceEpoch"))
                           (= (nativeGet data "directory") (nativeGet endpoint "directory")))
                (throw (new globalThis.Error "Pi receiver did not confirm the original session")))
              (js-object :data data :instance_epoch (nativeGet response "instance_epoch"))))))
        (setq project (lambda (endpoint response)
          (let ((data (nativeGet response "data")))
            (js-object :tool "pi" :native_namespace (nativeGet endpoint "native_namespace")
              :native_session_id (nativeGet data "session_id")
              :instance_id (nativeGet endpoint "instance_id") :instance_epoch (nativeGet response "instance_epoch")
              :workspace_ref (nativeGet endpoint "workspace_ref") :title (nativeGet data "title" "Pi")
              :runtime_state (nativeGet data "runtime_state" "unknown") :live_receiver t
              :visibility (js-array "live") :capabilities piCapabilities :coverage "current_session_only"
              :evidence_level "native_protocol"))))
        (setq probe (async (target binding context)
          (let ((endpoint (funcall endpointFor binding)))
            (funcall project endpoint (await (funcall request endpoint
              (Object/assign (js-object) target (js-object :instance_epoch (nativeGet binding "instance_epoch")))
              "probe" (js-object) context))))))
        (setq listSessions (async (scope cursor budget context)
          (let* ((selected (js-call endpoints :filter (lambda (endpoint)
                     (and (or (not (nativeGet scope "instance_ids"))
                              (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                          (or (not (nativeGet scope "workspace_refs"))
                              (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref")))))))
                 (index (nativeGet cursor "endpoint_index" 0)) (items (js-array)) (partial false))
            (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length selected)))
              (throw (new globalThis.TypeError "invalid Pi endpoint cursor")))
            (while (and (< index (js-length selected))
                        (< (js-length items) (nativeGet budget "max_records" 32)))
              (let ((endpoint (aref selected index)))
                (try
                  (js-call items :push (funcall project endpoint
                    (await (funcall request endpoint (js-object) "probe" (js-object) context))))
                  (catch unavailable (setq partial t))))
              (setq index (1+ index)))
            (js-object :items items :complete (= index (js-length selected))
              :coverage (if partial "partial" "covered")
              :next_cursor (if (< index (js-length selected)) (js-object :endpoint_index index) nil)))))
        (js-object :capabilities piCapabilities :probe probe :listSessions listSessions
          :initialize (lambda (context) (setq closed false))
          :probeInstance (async (instance context)
            (try
              (let* ((endpoint (funcall endpointFor instance))
                     (response (await (funcall request endpoint (js-object) "probe" (js-object) context))))
                (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
                  :instance_epoch (nativeGet response "instance_epoch") :evidence_level "native_protocol"))
              (catch unavailable (js-object :state "offline" :evidence_level "none" :reason "pi_receiver_unavailable"))))
          :discover (async (visibility page context)
            (if (not (= visibility "live"))
              (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil
                :reason "pi_history_not_exposed")
              (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
                (nativeGet page "cursor") (js-object :max_records 100) context))))
          :readMessages (async (session cursor budget context)
            (when cursor
              (unless (and (= (nativeGet cursor "native_session_id") (nativeGet session "native_session_id"))
                           (= (nativeTypeOf (nativeGet cursor "after_id")) "string")
                           (> (js-length (nativeGet cursor "after_id")) 0)
                           (<= (js-length (nativeGet cursor "after_id")) 256))
                (throw (new globalThis.TypeError "Pi message cursor belongs to another session"))))
            (let* ((endpoint (funcall endpointFor session))
                   (response (await (funcall request endpoint session "messages"
                     (js-object :cursor (nativeGet cursor "after_id" nil)
                       :max_records (Math/min 128 (nativeGet budget "max_records" 32))
                       :max_bytes (Math/min 524288 (nativeGet budget "max_bytes" 524288))) context)))
                   (data (nativeGet response "data")))
              (unless (and (Array/isArray (nativeGet data "items"))
                           (<= (js-length (nativeGet data "items")) (Math/min 128 (nativeGet budget "max_records" 32)))
                           (<= (utf8Bytes (JSON/stringify (nativeGet data "items")))
                             (Math/min 524288 (nativeGet budget "max_bytes" 524288))))
                (throw (new globalThis.Error "Pi native message page exceeded its budget")))
              (let ((ids (new globalThis.Set)))
                (js-call (nativeGet data "items") :forEach (lambda (item)
                  (unless (and (= (nativeTypeOf (nativeGet item "native_message_id")) "string")
                               (> (js-length (nativeGet item "native_message_id")) 0)
                               (not (js-call ids :has (nativeGet item "native_message_id")))
                               (js-call (js-array "user" "assistant") :includes (nativeGet item "role"))
                               (= (nativeTypeOf (nativeGet item "text")) "string"))
                    (throw (new globalThis.Error "invalid Pi native message")))
                  (js-call ids :add (nativeGet item "native_message_id"))))
                (unless (and (js-call (js-array t false) :includes (nativeGet data "complete"))
                             (if (= (nativeGet data "complete") t) (nil? (nativeGet data "next_cursor"))
                               (and (> (js-length (nativeGet data "items")) 0)
                                    (= (nativeGet data "next_cursor")
                                       (nativeGet (aref (nativeGet data "items") (1- (js-length (nativeGet data "items")))) "native_message_id")))))
                  (throw (new globalThis.Error "invalid Pi native continuation"))))
              (js-object :items (nativeGet data "items") :complete (nativeGet data "complete")
                :coverage "partial" :next_cursor (if (nativeGet data "next_cursor")
                  (js-object :after_id (nativeGet data "next_cursor")
                    :native_session_id (nativeGet session "native_session_id")) nil))))
          :submit (async (binding envelope mode key context)
            (let ((started false))
              (try
                (unless (= mode "start_idle") (throw (new globalThis.Error "unsupported Pi submit mode")))
                (let* ((endpoint (funcall endpointFor binding))
                       (before (await (funcall request endpoint binding "probe" (js-object) context)))
                       (text (encodeEnvelope envelope)))
                  (unless (and (= (nativeGet (nativeGet before "data") "runtime_state") "idle")
                               (<= (utf8Bytes text) 262144))
                    (throw (new globalThis.Error "Pi original target is not sendable")))
                  (setq started t)
                  (let* ((response (await (funcall request endpoint binding "submit"
                                    (js-object :text text :dispatch_key key) context)))
                         (data (nativeGet response "data")))
                    (if (= (nativeGet data "state") "accepted")
                      (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                        :native_receipt_key (nativeGet data "native_receipt_key"))
                      (js-object :state "unknown" :kind "unknown" :definite_not_sent false :evidence_level "none"))))
                (catch error (js-object :state (if started "unknown" "failed")
                  :kind (if started "unknown" "rejected") :definite_not_sent (not started)
                  :retryable (not started) :evidence_level "none")))))
          :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
          :observe (async (binding ref cursor budget context)
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
          :close (async () (setq closed t))))))
  (export createPiNativePort))
