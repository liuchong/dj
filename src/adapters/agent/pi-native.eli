(module dj.adapters.agent.pi-native
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" utf8Bytes)
  (import "../../delivery/envelope.eli" renderEnvelope)
  (import "./desktop-transport.eli" readCursorManifest cursorRequest)
  (import "./local-endpoint-resolver.eli" createLocalEndpointResolver)
  (import "node:path" dirname join resolve)
  (defconst piCapabilities
    (js-object :session_list "supported" :session_messages "supported"
      :session_probe "supported" :session_send "supported" :start_idle "supported" :message_during_run "unsupported"
      :creation_model_selection "supported" :session_create "supported" :session_rename "supported"
      :instance_epoch_refresh "supported" :instance_start "unsupported" :instance_stop "unsupported"
      :native_idempotency "unsupported" :lookup_send "unsupported" :lookup_create "positive_only"
      :observe "unsupported" :max_input_frame_bytes 262144))
  (defasync readPiManifest (endpoint)
    (let ((manifest (await (readCursorManifest endpoint))))
      (unless (and (= (nativeGet manifest "tool") "pi")
                   (= (nativeGet manifest "apiVersion") "dj-pi-receiver-v1")
                   (= (nativeGet manifest "directory") (nativeGet endpoint "directory"))
                   (= (nativeGet manifest "nativeNamespace") (nativeGet endpoint "native_namespace"))
                   (= (nativeTypeOf (nativeGet manifest "instanceEpoch")) "string")
                   (> (js-length (nativeGet manifest "instanceEpoch")) 0)
                   (= (nativeTypeOf (nativeGet manifest "sessionId")) "string")
                   (> (js-length (nativeGet manifest "sessionId")) 0))
        (throw (new globalThis.TypeError "Pi receiver identity changed")))
      manifest))
  (defun createPiEndpointResolver (host)
    (createLocalEndpointResolver
      (js-object :command_key "pi_discovery_command"
        :seed (lambda (endpoint helpers) (js-object :endpoint (js-call helpers :cloneEndpoint endpoint)))
        :verify (async (live context helpers)
          (await (readPiManifest (nativeGet live "endpoint"))))
        :discover (async (endpoint context helpers)
          (let* ((root (dirname (resolve (nativeGet endpoint "manifest_path"))))
                 (names (await (js-call helpers :privateDirectoryJsonNames root t)))
                 (target-session (nativeGet context "target_session_id" nil))
                 (live-candidates (js-array))
                 (index 0))
            (while (< index (js-length names))
              (let ((candidate (js-call helpers :cloneEndpoint endpoint)))
                (put candidate :manifest_path (join root (aref names index)))
                (try
                  (let ((manifest (await (readPiManifest candidate))))
                    (js-call live-candidates :push (js-object :endpoint candidate :manifest manifest)))
                  (catch stale nil)))
              (setq index (1+ index)))
            (when (or (= (js-length live-candidates) 0) (> (js-length live-candidates) 8))
              (throw (new globalThis.TypeError "Pi receiver identity changed")))
            (let ((verified-candidates (js-array)) (session-matches (js-array)) (i 0))
              (while (< i (js-length live-candidates))
                (let* ((entry (aref live-candidates i))
                       (candidate (nativeGet entry "endpoint"))
                       (manifest (nativeGet entry "manifest"))
                       (bounded (Object/assign (js-object) context
                         (js-object :expected_epoch nil
                           :deadline (Math/min (nativeGet context "deadline" (+ (performance/now) 10000)) (+ (performance/now) 1000))))))
                  (try
                    (let* ((response (await (cursorRequest candidate
                             (js-object :schema_version 1 :operation "list"
                               :session_id (nativeGet manifest "sessionId")
                               :receiver_epoch (nativeGet manifest "instanceEpoch")) bounded)))
                           (wire (nativeGet response "data"))
                           (data (nativeGet wire "data"))
                           (ids (nativeGet data "session_ids")))
                      (when (and (= (nativeGet wire "ok") t)
                                 (= (nativeGet data "receiver_epoch") (nativeGet manifest "instanceEpoch"))
                                 (= (nativeGet data "directory") (nativeGet endpoint "directory"))
                                 (Array/isArray ids))
                        (js-call verified-candidates :push (js-object :endpoint candidate))
                        (when (and target-session (js-call ids :includes target-session))
                          (js-call session-matches :push (js-object :endpoint candidate)))))
                    (catch unavailable nil)))
                (setq i (1+ i)))
              (let ((selected (if (and target-session (> (js-length verified-candidates) 1))
                                session-matches verified-candidates)))
                (unless (= (js-length selected) 1)
                  (throw (new globalThis.TypeError "Pi receiver identity changed")))
                (aref selected 0))))))
      host))
  (defun createPiNativePort (config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
          (resolve-endpoint (createPiEndpointResolver host)))
      (let ((endpointFor nil) (request nil) (project nil) (probe nil) (listSessions nil) (createSession nil))
        (setq endpointFor (lambda (target)
          (let ((matches (js-call endpoints :filter (lambda (endpoint)
            (and (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id"))
                 (or (not (nativeGet target "native_namespace"))
                     (= (nativeGet endpoint "native_namespace") (nativeGet target "native_namespace"))))))))
            (unless (= (js-length matches) 1)
              (throw (new globalThis.TypeError "exact Pi endpoint is required")))
            (aref matches 0))))
        (setq request (async (endpoint target operation args context)
          (when closed (throw (new globalThis.Error "Pi port is closed")))
          (let* ((resolve-context (if (nativeGet target "native_session_id")
                   (Object/assign (js-object) context (js-object :target_session_id (nativeGet target "native_session_id")))
                   context))
                 (live (await (funcall resolve-endpoint endpoint resolve-context)))
                 (active (nativeGet live "endpoint"))
                 (manifest (nativeGet live "verified"))
                 (call-context (Object/assign (js-object) context
                   (if (nativeGet target "instance_epoch")
                     (js-object :expected_epoch (nativeGet target "instance_epoch"))
                     (js-object :expected_epoch nil))))
                 (response (await (cursorRequest active
                   (Object/assign (js-object :schema_version 1 :operation operation
                     :session_id (nativeGet target "native_session_id" (nativeGet manifest "sessionId"))
                     :receiver_epoch (nativeGet manifest "instanceEpoch")) args)
                   call-context)))
                 (wire (nativeGet response "data")) (data (nativeGet wire "data")))
            (unless (and (= (nativeGet wire "ok") t)
                         (= (nativeGet data "session_id") (nativeGet target "native_session_id" (nativeGet manifest "sessionId")))
                         (= (nativeGet data "receiver_epoch") (nativeGet manifest "instanceEpoch"))
                         (= (nativeGet data "directory") (nativeGet endpoint "directory")))
              (throw (new globalThis.Error "Pi receiver did not confirm the original session")))
            (js-object :data data :instance_epoch (nativeGet response "instance_epoch")))))
        (setq project (lambda (endpoint response)
          (let ((data (nativeGet response "data")))
            (js-object :surface "cli" :model_selection (nativeGet data "model_selection") :tool "pi" :native_namespace (nativeGet endpoint "native_namespace")
              :native_session_id (nativeGet data "session_id")
              :instance_id (nativeGet endpoint "instance_id") :instance_epoch (nativeGet response "instance_epoch")
              :workspace_ref (nativeGet endpoint "workspace_ref")
              :directory (nativeGet data "directory" (nativeGet endpoint "directory"))
              :title (nativeGet data "title" "Pi")
              :runtime_state (nativeGet data "runtime_state" "unknown") :live_receiver t
              :visibility (js-array "live") :capabilities piCapabilities :coverage "host_sessions"
              :evidence_level "native_protocol"))))
        ;; Read-side probe observes the current live epoch of the original session;
        ;; submit, create, rename and readMessages enforce expected_epoch.
        (setq probe (async (target binding context)
          (let ((endpoint (funcall endpointFor (Object/assign (js-object) binding target))))
            (funcall project endpoint (await (funcall request endpoint
              (Object/assign (js-object) binding target (js-object :instance_epoch nil))
              "probe" (js-object) context))))))
        (setq listSessions (async (scope cursor budget context)
          (let* ((selected (js-call endpoints :filter (lambda (endpoint)
                     (and (or (not (nativeGet scope "instance_ids"))
                              (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                          (or (not (nativeGet scope "workspace_refs"))
                              (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref")))))))
                 (index (nativeGet cursor "endpoint_index" 0)) (items (js-array)) (partial false) (session-index (nativeGet cursor "session_index" 0)))
            (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length selected)))
              (throw (new globalThis.TypeError "invalid Pi endpoint cursor")))
            (while (and (< index (js-length selected))
                        (< (js-length items) (nativeGet budget "max_records" 32)))
              (let ((endpoint (aref selected index)))
                (try
                  (let* ((page (await (funcall request endpoint (js-object) "list" (js-object) context)))
                         (ids (nativeGet (nativeGet page "data") "session_ids")))
                    (unless (and (Array/isArray ids) (<= (js-length ids) 128)
                      (Number/isSafeInteger session-index) (>= session-index 0) (<= session-index (js-length ids)))
                      (throw (new globalThis.TypeError "invalid Pi host page")))
                    (while (and (< session-index (js-length ids)) (< (js-length items) (nativeGet budget "max_records" 32)))
                      (js-call items :push (funcall project endpoint (await (funcall request endpoint
                        (js-object :native_session_id (aref ids session-index)) "probe" (js-object) context))))
                      (setq session-index (1+ session-index)))
                    (when (= session-index (js-length ids)) (setq session-index 0 index (1+ index))))
                  (catch unavailable (setq partial t index (1+ index) session-index 0)))))
            (js-object :items items :complete (= index (js-length selected))
              :coverage (if partial "partial" "covered")
              :next_cursor (if (< index (js-length selected)) (js-object :endpoint_index index :session_index session-index) nil)))))
        (setq createSession (async (instance workspace key context lookup)
          (let* ((endpoint (funcall endpointFor instance))
                 (valid-workspace (unless (= workspace (nativeGet endpoint "workspace_ref"))
                   (throw (new globalThis.TypeError "Pi creation workspace changed"))))
                 (response (await (funcall request endpoint instance (if lookup "lookup_create" "create")
                   (js-object :creation_key key :directory (nativeGet endpoint "directory")
                     :title (nativeGet context "title" nil) :model_selection (nativeGet context "model_selection" nil)) context)))
                 (id (nativeGet (nativeGet response "data") "created_id")))
            (unless (= workspace (nativeGet endpoint "workspace_ref"))
              (throw (new globalThis.TypeError "Pi creation workspace changed")))
            (if (not id) (js-object :state "unknown" :evidence_level "none")
              (js-object :state "ready" :creation_key key :native_ref id :evidence_level "native_protocol"
                :session (funcall project endpoint (await (funcall request endpoint
                  (js-object :native_session_id id :instance_epoch (nativeGet instance "instance_epoch"))
                  "probe" (js-object) context))))))))
        (js-object :create (async (instance workspace key context)
                     (await (funcall createSession instance workspace key context false)))
          :lookupCreate (async (instance key ref context)
            (await (funcall createSession instance (nativeGet (funcall endpointFor instance) "workspace_ref") key context t)))
          :rename (async (session title context)
            (let* ((endpoint (funcall endpointFor session))
                   (response (await (funcall request endpoint session "rename" (js-object :title title) context))))
              (unless (= (nativeGet (nativeGet response "data") "title") title)
                (throw (new globalThis.Error "Pi rename unconfirmed")))
              (js-object :state "ready" :evidence_level "native_protocol"
                :session (await (funcall probe session session context)))))
          :capabilities piCapabilities :probe probe :listSessions listSessions
          :initialize (lambda (context) (setq closed false))
          :probeInstance (async (instance context)
            (try
              (let* ((endpoint (funcall endpointFor instance))
                     (response (await (funcall request endpoint (js-object) "probe" (js-object) context))))
                (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
                  :instance_epoch (nativeGet response "instance_epoch") :evidence_level "native_protocol"))
              (catch unavailable (js-object :state "offline" :evidence_level "none" :reason "pi_receiver_unavailable"))))
          :discover (async (visibility page context)
            (if (not (= visibility "live"))
              (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil
                :reason "pi_history_not_exposed")
              (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
                (nativeGet page "cursor") (js-object :max_records 100) context))))
          :readMessages (async (session cursor budget context)
            (when cursor
              (unless (and (= (nativeGet cursor "native_session_id") (nativeGet session "native_session_id"))
                           (= (nativeTypeOf (nativeGet cursor "after_id")) "string")
                           (> (js-length (nativeGet cursor "after_id")) 0)
                           (<= (js-length (nativeGet cursor "after_id")) 256))
                (throw (new globalThis.TypeError "Pi message cursor belongs to another session"))))
            (let* ((endpoint (funcall endpointFor session))
                   (response (await (funcall request endpoint session "messages"
                     (js-object :cursor (nativeGet cursor "after_id" nil)
                       :max_records (Math/min 128 (nativeGet budget "max_records" 32))
                       :max_bytes (Math/min 524288 (nativeGet budget "max_bytes" 524288))) context)))
                   (data (nativeGet response "data")))
              (unless (and (Array/isArray (nativeGet data "items"))
                           (<= (js-length (nativeGet data "items")) (Math/min 128 (nativeGet budget "max_records" 32)))
                           (<= (utf8Bytes (JSON/stringify (nativeGet data "items")))
                             (Math/min 524288 (nativeGet budget "max_bytes" 524288))))
                (throw (new globalThis.Error "Pi native message page exceeded its budget")))
              (let ((ids (new globalThis.Set)))
                (js-call (nativeGet data "items") :forEach (lambda (item)
                  (unless (and (= (nativeTypeOf (nativeGet item "native_message_id")) "string")
                               (> (js-length (nativeGet item "native_message_id")) 0)
                               (not (js-call ids :has (nativeGet item "native_message_id")))
                               (js-call (js-array "user" "assistant") :includes (nativeGet item "role"))
                               (= (nativeTypeOf (nativeGet item "text")) "string"))
                    (throw (new globalThis.Error "invalid Pi native message")))
                  (js-call ids :add (nativeGet item "native_message_id"))))
                (unless (and (js-call (js-array t false) :includes (nativeGet data "complete"))
                             (if (= (nativeGet data "complete") t) (nil? (nativeGet data "next_cursor"))
                               (and (> (js-length (nativeGet data "items")) 0)
                                    (= (nativeGet data "next_cursor")
                                       (nativeGet (aref (nativeGet data "items") (1- (js-length (nativeGet data "items")))) "native_message_id")))))
                  (throw (new globalThis.Error "invalid Pi native continuation"))))
              (js-object :items (nativeGet data "items") :complete (nativeGet data "complete")
                :coverage "partial" :next_cursor (if (nativeGet data "next_cursor")
                  (js-object :after_id (nativeGet data "next_cursor")
                    :native_session_id (nativeGet session "native_session_id")) nil))))
          :submit (async (binding envelope mode key context)
            (let ((started false))
              (try
                (unless (js-call (js-array "start_idle" "steer") :includes mode) (throw (new globalThis.Error "unsupported Pi submit mode")))
                (let* ((endpoint (funcall endpointFor binding))
                       (before (await (funcall request endpoint binding "probe" (js-object) context)))
                       (text (renderEnvelope envelope)))
                  (unless (and (= (nativeGet (nativeGet before "data") "runtime_state") "idle")
                               (<= (utf8Bytes text) 262144))
                    (throw (new globalThis.Error "Pi original target is not sendable")))
                  (setq started t)
                  (let* ((response (await (funcall request endpoint binding "submit"
                                    (js-object :text text :dispatch_key key) context)))
                         (data (nativeGet response "data")))
                    (if (= (nativeGet data "state") "accepted")
                      (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                        :native_receipt_key (nativeGet data "native_receipt_key"))
                      (js-object :state "unknown" :kind "unknown" :definite_not_sent false :evidence_level "none"))))
                (catch error (js-object :state (if started "unknown" "failed")
                  :kind (if started "unknown" "rejected") :definite_not_sent (not started)
                  :retryable (not started) :evidence_level "none")))))
          :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
          :observe (async (binding ref cursor budget context)
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
          :close (async () (setq closed t) (js-call resolve-endpoint :clear))))))
  (export createPiNativePort readPiManifest))
