(module dj.adapters.agent.json-rpc
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" utf8Bytes)
  (import "node:crypto" randomUUID)

  (defun rpcError (code)
    (Object/assign (new globalThis.Error code) (js-object :code code)))

  (defun createJsonRpcChannel (child clock on-event)
    (let ((pending (new globalThis.Map)) (requests (new globalThis.Map))
          (sequence 0) (nonce (randomUUID)) (closed false) (buffer (Buffer/alloc 0))
          (settle nil) (isolate nil) (consume nil) (request nil) (write nil))
      (setq settle (lambda (id error value)
        (let ((item (js-call pending :get id)))
          (when item
            (js-call pending :delete id)
            (nativeClearTimeout (nativeGet item "timer"))
            (when (nativeGet item "signal")
              (js-call (nativeGet item "signal") :removeEventListener "abort" (nativeGet item "abort")))
            (if error (funcall (nativeGet item "reject") error)
              (funcall (nativeGet item "resolve") value))))))
      (setq isolate (lambda ()
        (unless closed
          (setq closed t buffer (Buffer/alloc 0))
          (js-call (Array/from (js-call pending :keys)) :forEach
            (lambda (id) (funcall settle id (rpcError "rpc_closed_unknown") nil))))))
      (setq write (async (wire)
        (when closed (throw (rpcError "rpc_closed_unknown")))
        (let ((text (str (JSON/stringify wire) "\n")))
          (when (> (utf8Bytes text) 1048576) (throw (rpcError "rpc_frame_limit")))
          (await (Promise/resolve (js-call (nativeGet child "stdin") :write text)))
          (when (nativeGet (nativeGet child "stdin") "flush")
            (await (js-call (nativeGet child "stdin") :flush))))))
      (setq request (lambda (method params context)
        (new globalThis.Promise (lambda (resolve reject)
          (let* ((id (str nonce ":" (setq sequence (1+ sequence))))
                 (signal (nativeGet context "abort_signal"))
                 (remaining (- (nativeGet context "deadline" (+ (js-call clock :monoNow) 5000))
                               (js-call clock :monoNow)))
                 (abort (lambda () (funcall settle id (rpcError "rpc_cancelled_unknown") nil))))
            (if (or closed (>= (nativeGet pending "size") 64) (<= remaining 0)
                    (nativeGet signal "aborted"))
              (funcall reject (rpcError "rpc_unavailable_before_write"))
              (let ((item (js-object :resolve resolve :reject reject :signal signal :abort abort)))
                (js-call pending :set id item)
                (put item :timer (nativeSetTimeout abort remaining))
                (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
                (js-call (funcall write (js-object :jsonrpc "2.0" :id id :method method :params params))
                  :catch (lambda (error) (funcall settle id (rpcError "rpc_write_unknown") nil))))))))))
      (setq consume (lambda (wire)
        (unless (and wire (= (nativeTypeOf wire) "object") (not (Array/isArray wire)))
          (throw (rpcError "rpc_invalid_frame")))
        (if (nativeGet wire "method")
          (if (object-has? wire :id)
            (if (js-call (js-array "session/request_permission" "cursor/ask_question" "cursor/create_plan"
                       "item/commandExecution/requestApproval" "item/fileChange/requestApproval"
                       "item/tool/requestUserInput" "execCommandApproval" "applyPatchApproval")
                       :includes (nativeGet wire "method"))
              (progn
                (when (>= (nativeGet requests "size") 64) (throw (rpcError "rpc_request_limit")))
                (js-call requests :set (nativeGet wire "id") wire)
                (funcall on-event wire t))
              (js-call (funcall write (js-object :jsonrpc "2.0" :id (nativeGet wire "id")
                :error (js-object :code -32601 :message "Client method unsupported")))
                :catch (lambda (error) (funcall isolate))))
            (funcall on-event wire false))
          (when (object-has? wire :id)
            (funcall settle (nativeGet wire "id")
              (if (nativeGet wire "error") (rpcError "rpc_native_rejected") nil)
              (nativeGet wire "result"))))))
      (let ((pump (async ()
        (let ((reader (js-call (nativeGet child "stdout") :getReader)))
          (try
            (let ((done false))
              (while (not done)
                (let ((chunk (await (js-call reader :read))))
                  (setq done (nativeGet chunk "done"))
                  (unless done
                    (setq buffer (Buffer/concat (js-array buffer (nativeGet chunk "value"))))
                    (let ((position (js-call buffer :indexOf 10)))
                      (while (>= position 0)
                        (when (> position 1048576) (throw (rpcError "rpc_frame_limit")))
                        (let ((line (js-call buffer :subarray 0 position)))
                          (setq buffer (js-call buffer :subarray (1+ position)))
                          (when (> (js-length line) 0)
                            (funcall consume (JSON/parse (js-call
                              (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode line)))))
                        (setq position (js-call buffer :indexOf 10))))
                    (when (> (js-length buffer) 1048576) (throw (rpcError "rpc_frame_limit")))))))
            (catch error nil)
            (finally (js-call reader :releaseLock) (funcall isolate)))))))
        (js-call (funcall pump) :catch (lambda (error) (funcall isolate))))
      ;; stderr is continuously drained without logging credentials, prompts or native errors.
      (js-call (funcall (async ()
        (let ((reader (js-call (nativeGet child "stderr") :getReader)))
          (try (let ((done false))
            (while (not done) (setq done (nativeGet (await (js-call reader :read)) "done"))))
            (catch error nil) (finally (js-call reader :releaseLock))))))
        :catch (lambda (error) nil))
      (js-call (nativeGet child "exited") :then (lambda (code) (funcall isolate)))
      (js-object :request request
        :notify (lambda (method params) (funcall write (js-object :jsonrpc "2.0" :method method :params params)))
        :pendingRequests (lambda () (nativeGet requests "size"))
        :pendingWork (lambda () (nativeGet pending "size"))
        :isClosed (lambda () closed) :close isolate)))
  (export createJsonRpcChannel rpcError))
