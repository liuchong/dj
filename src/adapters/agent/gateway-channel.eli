(module dj.adapters.agent.gateway-channel
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" hashValue utf8Bytes)
  (import "../../core/limits.eli" limits)

  (defun localGatewayUrl (value)
    (let ((url (new globalThis.URL value)))
      (unless (and (= (nativeGet url "protocol") "http:")
        (js-call (js-array "127.0.0.1" "[::1]") :includes (nativeGet url "hostname"))
        (nativeGet url "port") (= (nativeGet url "pathname") "/")
        (= (nativeGet url "username") "") (= (nativeGet url "password") "")
        (= (nativeGet url "search") "") (= (nativeGet url "hash") ""))
        (throw (new globalThis.TypeError "Agent gateway requires a numeric loopback HTTP origin and explicit port")))
      url))

  (defun gatewayDeadline (host context)
    (let ((now (js-call (nativeGet host "clock") :monoNow)))
      (Math/min 15000 (- (nativeGet context "deadline" (+ now 15000)) now))))

  ;; An endpoint owns one socket. Requests are never replayed by the transport.
  (defun openGatewayChannel (tool url token host context)
    (let* ((ws-url (new globalThis.URL (if (= tool "hermes") "/api/ws" "/") url))
      (hermes (= tool "hermes"))
      (pending (new globalThis.Map))
      (ready-resolve nil) (ready-reject nil) (timer nil)
      (ready (new globalThis.Promise (lambda (resolve reject)
        (setq ready-resolve resolve ready-reject reject))))
      (closed false) (epoch nil) (sequence 0) (socket nil) (close nil) (request nil))
      (put ws-url :protocol "ws:")
      (when hermes (js-call (nativeGet ws-url "searchParams") :set "token" token))
      (setq close (lambda ()
        (unless closed
          (setq closed t)
          (when timer (nativeClearTimeout timer))
          (when socket (js-call socket :close))
          (let ((error (new globalThis.Error "Local agent gateway is unavailable")))
            (funcall ready-reject error)
            (js-call pending :forEach (lambda (entry) (js-call entry :reject error)))))))
      (setq request (lambda (method params call-context &optional on-send)
        (new globalThis.Promise (lambda (resolve reject)
          (let ((deadline (gatewayDeadline host call-context)) (signal (nativeGet call-context "abort_signal")))
            (unless (and (not closed) socket (= (nativeGet socket "readyState") 1)
              (> deadline 0) (not (nativeGet signal "aborted")) (< (nativeGet pending "size") 64))
              (throw (new globalThis.Error "Local gateway request unavailable")))
            (setq sequence (1+ sequence))
            (let* ((id (str sequence))
              (frame (JSON/stringify (Object/assign
                (if hermes (js-object :jsonrpc "2.0") (js-object :type "req"))
                (js-object :id id :method method :params params))))
              (request-timer nil) (abort nil) (finish nil))
              (when (> (utf8Bytes frame) (nativeGet limits "native_response_max_bytes"))
                (throw (new globalThis.Error "Local gateway request exceeds byte limit")))
              (setq finish (lambda (callback value)
                (when (js-call pending :delete id)
                  (nativeClearTimeout request-timer)
                  (when signal (js-call signal :removeEventListener "abort" abort))
                  (funcall callback value))))
              (setq abort (lambda () (funcall finish reject (new globalThis.Error "Local gateway request expired"))))
              (setq request-timer (nativeSetTimeout abort deadline))
              (js-call pending :set id (js-object
                :resolve (lambda (value) (funcall finish resolve value))
                :reject (lambda (error) (funcall finish reject error))))
              (when signal (js-call signal :addEventListener "abort" abort (js-object :once t)))
              (try
                (js-call socket :send frame)
                (when on-send (funcall on-send))
                (catch unavailable (funcall finish reject (new globalThis.Error "Local gateway send failed"))))))))))
      (let ((deadline (gatewayDeadline host context)))
        (unless (> deadline 0) (throw (new globalThis.Error "Local gateway handshake expired")))
        (setq socket (new globalThis.WebSocket (js-call ws-url :toString)))
        (setq timer (nativeSetTimeout close deadline)))
      (let ((accept (lambda (boot)
          (unless (and (= (nativeTypeOf boot) "string") (> (js-length boot) 0))
            (throw (new globalThis.Error "Local gateway did not identify its boot")))
          (unless epoch
            (setq epoch (str tool "_" (hashValue (js-array (nativeGet url "origin") boot))))
            (nativeClearTimeout timer)
            (funcall ready-resolve (js-object :epoch epoch :request request :url url :token token
              :close close :closed (lambda () closed)))))))
        (put socket :onclose close)
        (put socket :onerror close)
        (put socket :onmessage (async (event)
          (try
            (let ((data (nativeGet event "data")))
              (unless (and (= (nativeTypeOf data) "string")
                (<= (utf8Bytes data) (nativeGet limits "native_response_max_bytes")))
                (throw (new globalThis.Error "Invalid local gateway frame")))
              ;; Hermes uses JSON-RPC records separated by LF. OpenClaw sends one JSON object.
              (let ((frames (if hermes (js-call data :split "\n") (js-array data))) (index 0))
                (while (< index (js-length frames))
                  (let ((line (aref frames index)))
                    (setq index (1+ index))
                    (when (> (js-length (js-call line :trim)) 0)
                      (let* ((frame (JSON/parse line))
                        (entry (js-call pending :get (nativeGet frame "id")))
                        (event-params (nativeGet frame "params")))
                        (cond
                          ((and entry (if hermes (= (nativeGet frame "jsonrpc") "2.0") (= (nativeGet frame "type") "res")))
                            (if (if hermes (not (nativeGet frame "error")) (= (nativeGet frame "ok") t))
                              (js-call entry :resolve (nativeGet frame (if hermes "result" "payload")))
                              (js-call entry :reject (new globalThis.Error "Local gateway rejected the request"))))
                          ((and hermes (not epoch) (= (nativeGet frame "method") "event")
                            (= (nativeGet event-params "type") "gateway.ready"))
                            (funcall accept (nativeGet (nativeGet event-params "payload") "replay_epoch")))
                          ((and (not hermes) (not epoch) (= (nativeGet frame "event") "connect.challenge"))
                            (let* ((hello (await (funcall request "connect" (js-object
                              :minProtocol 4 :maxProtocol 4
                              :client (js-object :id "gateway-client" :version "dispatch-junction"
                                :platform (nativeGet globalThis.process "platform") :mode "backend")
                              :role "operator" :scopes (js-array "operator.read" "operator.write")
                              :auth (js-object :token token)) context)))
                              (scopes (nativeGet (nativeGet hello "auth") "scopes" (js-array))))
                              (unless (and (= (nativeGet hello "protocol") 4)
                                (js-call scopes :includes "operator.read") (js-call scopes :includes "operator.write"))
                                (throw (new globalThis.Error "OpenClaw gateway scopes unavailable")))
                              (funcall accept (nativeGet (nativeGet hello "server") "bootId")))))))))))
            (catch invalid (funcall close))))))
      (js-object :ready ready :close close :closed (lambda () closed))))
  (export localGatewayUrl openGatewayChannel gatewayDeadline))
