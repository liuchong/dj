(module dj.adapters.agent.antigravity-endpoint
  (import "../../core/native.eli" NativeNumber nativeGet nativeTypeOf)
  (import "./desktop-transport.eli" desktopError)
  (import "./native-local.eli" metadataCommand trustedProcessHelper processProof localCertificate antigravityRpc)
  ;; Secrets belong to this port's memory, never to endpoint projections or SQLite.
  ;; Discovery only inspects existing processes; it never starts a client.
  (defun processRows (text)
    (let ((rows (js-array)))
      (js-call (js-call text :split "\n") :forEach (lambda (line)
        (let ((m (js-call line :match (new globalThis.RegExp "^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(.+?)\\s*$"))))
          (when m (js-call rows :push (js-object :pid (NativeNumber (aref m 1)) :ppid (NativeNumber (aref m 2))
            :uid (NativeNumber (aref m 3)) :executable (aref m 4)))))))
      rows))
  (defun nativeArgument (args name)
    (let ((m (js-call args :match (new globalThis.RegExp (str "(?:^|\\s)--" name "(?:=|\\s+)([^\\s]+)(?:\\s|$)")))))
      (and m (aref m 1))))
  (defun createAntigravityEndpointResolver (host)
    (let ((cached (new globalThis.Map)) (pending (new globalThis.Map))
          (command (nativeGet host "antigravity_discovery_command" (async (file args context)
            (await (metadataCommand file args context (if (and (= file "ps") (= (aref args 0) "-axo")) 1048576 65536))))))
          (discover nil))
      (setq discover (async (endpoint context)
        (let* ((helper (await (trustedProcessHelper (nativeGet (nativeGet endpoint "process_binding") "process_helper_ref"))))
               (rows (processRows (await (funcall command "ps" (js-array "-axo" "pid=,ppid=,uid=,comm=") context))))
               (candidates (js-array)))
          (when (> (js-length rows) 32768) (throw (desktopError "native_process_limit")))
          (js-call rows :forEach (lambda (row)
            (let* ((exe (nativeGet row "executable"))
                   (suffix "/Contents/Resources/bin/language_server")
                   (root (and (js-call exe :endsWith suffix) (js-call exe :slice 0 (- (js-length suffix)))))
                   (parent (js-call rows :find (lambda (p) (= (nativeGet p "pid") (nativeGet row "ppid"))))))
              (when (and root (js-call root :endsWith ".app") parent
                (= (nativeGet row "uid") (js-call globalThis.process :getuid))
                (= (nativeGet parent "uid") (nativeGet row "uid"))
                (= (nativeGet parent "executable") (str root "/Contents/MacOS/Antigravity")))
                (js-call candidates :push row)))))
          (unless (= (js-length candidates) 1) (throw (desktopError "native_process_ambiguous")))
          (let* ((row (aref candidates 0)) (pid (nativeGet row "pid"))
                 (proof (JSON/parse (await (funcall command helper (js-array (str pid)) context))))
                 (parent (JSON/parse (await (funcall command helper (js-array (str (nativeGet row "ppid"))) context))))
                 (args (await (funcall command "ps" (js-array "-p" (str pid) "-o" "args=") context)))
                 (token (nativeArgument args "csrf_token"))
                 (listeners (await (funcall command "lsof" (js-array "-nP" "-a" "-p" (str pid) "-iTCP" "-sTCP:LISTEN" "-Fn") context)))
                 (ports (new globalThis.Set)) (matches (js-array)))
            (unless (and (= (nativeGet proof "uid") (js-call globalThis.process :getuid))
              (= (nativeGet proof "pid") pid) (= (nativeGet proof "executable") (nativeGet row "executable"))
              (= (nativeGet parent "uid") (nativeGet proof "uid"))
              (= (nativeGet parent "pid") (nativeGet row "ppid"))
              (= (nativeGet parent "executable") (str (js-call (nativeGet proof "executable") :slice 0 (- (js-length "/Contents/Resources/bin/language_server"))) "/Contents/MacOS/Antigravity"))
              (= (nativeArgument args "app_data_dir") "antigravity")
              (= (nativeTypeOf token) "string") (js-call (new globalThis.RegExp "^[A-Za-z0-9_-]+$") :test token))
              (throw (desktopError "native_process_changed")))
            (js-call (js-call listeners :split "\n") :forEach (lambda (line)
              (let ((m (js-call line :match (new globalThis.RegExp "^n127\\.0\\.0\\.1:(\\d+)$"))))
                (when m (js-call ports :add (NativeNumber (aref m 1)))))))
            (when (or (= (nativeGet ports "size") 0) (> (nativeGet ports "size") 8))
              (throw (desktopError "native_listener_ambiguous")))
            (let ((values (Array/from ports)) (i 0))
              (while (< i (js-length values))
                (let* ((candidate (Object/assign (js-object) endpoint (js-object
                         :base_url (str "https://127.0.0.1:" (aref values i))
                         :process_binding (js-object :pid pid :process_birth (nativeGet proof "birth") :process_helper_ref helper))))
                       (bounded (Object/assign (js-object) context (js-object :instance_epoch nil
                         :deadline (Math/min (nativeGet context "deadline") (+ (performance/now) 700))))))
                  (try
                    (let* ((certificate (await (localCertificate candidate bounded)))
                           (credential (js-object :csrf_token token :certificate_pem (nativeGet certificate "certificate_pem"))))
                      (put (nativeGet candidate "process_binding") :certificate_sha256 (nativeGet certificate "certificate_sha256"))
                      (let ((response (await (antigravityRpc candidate "GetAllCascadeTrajectories" (js-object :excludeSubtrajectories t) bounded credential))))
                        (when (and (nativeGet (nativeGet response "data") "trajectorySummaries")
                          (= (nativeTypeOf (nativeGet (nativeGet response "data") "trajectorySummaries")) "object"))
                          (js-call matches :push (js-object :endpoint candidate :credential credential)))))
                    (catch unavailable nil)))
                (setq i (1+ i))))
            (unless (= (js-length matches) 1) (throw (desktopError "native_listener_ambiguous")))
            ;; Close a PID-reuse race before retaining credentials for this process.
            (await (processProof (nativeGet (aref matches 0) "endpoint") context))
            (aref matches 0)))))
      (async (endpoint context)
        (let* ((key (nativeGet endpoint "instance_id")) (live (js-call cached :get key)))
          (when live
            (try (await (processProof (nativeGet live "endpoint") context))
              (catch changed (js-call cached :delete key) (setq live nil))))
          (unless live
            (let ((work (js-call pending :get key)))
              (unless work (setq work (funcall discover endpoint context)) (js-call pending :set key work))
              (try (setq live (await work)) (js-call cached :set key live)
                (finally (when (eq work (js-call pending :get key)) (js-call pending :delete key))))))
          live))))
  (export createAntigravityEndpointResolver processRows nativeArgument))
