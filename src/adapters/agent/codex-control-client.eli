(module dj.adapters.agent.codex-control-client
  (import "../../core/native.eli" nativeGet)
  (import "../../core/types.eli" hashValue)
  (import "./desktop-transport.eli" cursorRequest desktopError readCursorManifest socketIdentity)
  (import "./native-local.eli" metadataCommand trustedProcessHelper)
  (import "./local-endpoint-resolver.eli" processRows)
  (import "node:path" dirname join)
  (defconst appPath (new globalThis.RegExp "/(?:ChatGPT|Codex)\\.app/Contents/MacOS/(?:ChatGPT|Codex)$"))
  (defasync codexControlEndpoint (endpoint context &optional host)
    (let ((configured (nativeGet endpoint "control_manifest_path"))
          (helper (nativeGet endpoint "process_helper_ref"))
          (command (nativeGet host "codex_discovery_command" metadataCommand)))
      (unless (and configured helper) (throw (desktopError "receiver_control_unavailable")))
      (let* ((uid (js-call globalThis.process :getuid))
             (helper-path (await (trustedProcessHelper helper)))
             (rows (processRows (await (funcall command "ps" (js-array "-axo" "pid=,ppid=,uid=,comm=") context 1048576))))
             (apps (js-call rows :filter (lambda (row)
               (and (= (nativeGet row "uid") uid) (js-call appPath :test (nativeGet row "executable")))))))
        (unless (= (js-length apps) 1) (throw (desktopError
          (if (> (js-length apps) 1) "receiver_control_ambiguous" "receiver_control_unavailable"))))
        (let* ((pid (nativeGet (aref apps 0) "pid"))
               (dir (dirname configured))
               (transport (js-object :manifest_path (join dir (str pid ".json"))))
               (manifest (try (await (readCursorManifest transport))
                 (catch missing (throw (desktopError "receiver_control_unavailable")))))
               (owner (JSON/parse (await (funcall command helper-path (js-array (str pid)) context))))
               (socket (nativeGet manifest "socketPath"))
               (receiver-epoch (nativeGet manifest "instanceEpoch" "")))
          (unless (and (= (nativeGet manifest "pid") pid) (= (nativeGet owner "pid") pid)
            (= (nativeGet owner "uid") uid) (= (nativeGet owner "birth") (nativeGet manifest "processBirth"))
            (js-call appPath :test (nativeGet owner "executable"))
            (= (nativeGet manifest "tool") "codex") (= (nativeGet manifest "apiVersion") "dj-native-control")
            (js-call (new globalThis.RegExp "^[a-f0-9-]{36}$") :test receiver-epoch)
            (= socket (join dir (str pid "-" (js-call receiver-epoch :slice 0 13) ".sock"))))
            (throw (desktopError "receiver_control_unavailable")))
          (let ((socket-epoch (await (socketIdentity socket))))
            (js-object :transport transport :receiver_epoch receiver-epoch :socket_epoch socket-epoch
              :instance_epoch (str "codex_control_" (hashValue (js-array socket-epoch receiver-epoch)))))))))
  (defasync codexControlRequest (control request context)
    (try
      (let* ((wire (await (cursorRequest (nativeGet control "transport")
        (Object/assign (js-object) request (js-object :receiver_epoch (nativeGet control "receiver_epoch")))
        (Object/assign (js-object) context (js-object :expected_epoch (nativeGet control "socket_epoch"))))))
        (data (nativeGet (nativeGet wire "data") "data")))
        (unless data (throw (desktopError "receiver_control_unavailable")))
        (js-object :instance_epoch (nativeGet control "instance_epoch") :data data))
      (catch failed (throw (desktopError "receiver_control_unavailable")))))
  (export codexControlEndpoint codexControlRequest))
