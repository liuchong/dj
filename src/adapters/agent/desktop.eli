(module dj.adapters.agent.desktop
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd)
  (import "../../core/types.eli" utf8Bytes sliceUtf8)
  (import "../../core/limits.eli" limits)
  (import "../../delivery/envelope.eli" encodeEnvelope)
  (import "./cursor-control.eli" cursorCreationId)
  (import "./cursor-native.eli" cursorNativeRequest)
  (import "./desktop-transport.eli" desktopError desktopDeadline cursorRequest openCodexChannel)
  (import "bun:sqlite" Database)
  (import "node:fs/promises" lstat)
  (import "node:crypto" randomUUID)

  (defun codexInputRequest (id text running client-message-id)
    (let* ((input (js-array (js-object :type "text" :text text :text_elements (js-array))))
      (restore (js-object :text text :context (js-object))))
      (js-object :method (if running "thread-follower-steer-turn" "thread-follower-start-turn")
        :version (if running 1 2)
        :parameters (if running
          (js-object :conversationId id :input input :restoreMessage restore :clientUserMessageId client-message-id)
          (js-object :conversationId id :turnStart (js-object :request (js-object :threadId id :input input)
            :context (js-object :restoreMessage restore :inheritThreadSettings t)))))))
  (defun codexTurns (state)
    (let* ((history (nativeGet (nativeGet state "turnHistory") "history"))
           (turns (js-array)))
      (if (= (nativeGet (nativeGet state "turnHistory") "kind") "canonical")
        (js-call (nativeGet history "islands" (js-array)) :forEach
          (lambda (island)
            (js-call (nativeGet island "entries" (js-array)) :forEach
              (lambda (entry)
                (let ((turn (nativeGet (nativeGet history "entitiesByKey") (nativeGet entry "value"))))
                  (when turn (js-call turns :push turn)))))))
        (setq turns (nativeGet state "turns" (js-array))))
      turns))
  (defun codexRuntime (state)
    (let* ((requests (nativeGet state "requests"))
           (runtime (nativeGet (nativeGet state "threadRuntimeStatus") "type"))
           (pending (js-call (nativeGet state "unconfirmedTurnSubmissions" (js-array)) :some
                      (lambda (entry) (not (= (nativeGet entry "terminal") t))))))
      (cond
        ((and requests (> (js-length (Object/keys requests)) 0)) "waiting_permission")
        ((or pending (= runtime "active") (= (nativeGet state "resumeState") "resuming")
           (js-call (codexTurns state) :some (lambda (turn) (= (nativeGet turn "status") "inProgress")))) "busy")
        ((= runtime "idle") "idle")
        ((and (= (nativeGet state "resumeState") "resumed")
              (or (not (= (nativeGet (nativeGet state "turnHistory") "kind") "canonical"))
                  (= (nativeGet (nativeGet (nativeGet state "turnHistory") "history") "isComplete") t))
              (js-call (codexTurns state) :every
                (lambda (turn) (js-call (js-array "completed" "failed" "interrupted") :includes
                                  (nativeGet turn "status"))))) "idle")
        (t "unknown"))))
  (defun cursorRuntime (thread)
    (cond ((= (nativeGet thread "status") "running") "busy")
      ((js-call (js-array "idle" "completed") :includes (nativeGet thread "status")) "idle")
      (t "unknown")))
  (defun messagePage (rows cursor budget authoritative)
    (let ((position 0) (items (js-array)) (bytes 0)
          (maximum (Math/min 200 (nativeGet budget "max_records" 100)))
          (byte-limit (Math/min 1048576 (nativeGet budget "max_bytes" 1048576))))
      (when cursor
        (let ((index (js-call rows :findIndex
                  (lambda (row) (= (nativeGet row "native_message_id") (nativeGet cursor "after_id"))))))
          (when (< index 0) (throw (desktopError "desktop_stale_cursor")))
          (setq position (1+ index))))
      (while (and (< position (js-length rows)) (< (js-length items) maximum)
                  (<= (+ bytes (utf8Bytes (JSON/stringify (aref rows position)))) byte-limit))
        (setq bytes (+ bytes (utf8Bytes (JSON/stringify (aref rows position)))))
        (js-call items :push (aref rows position))
        (setq position (1+ position)))
      (when (and (< position (js-length rows)) (= (js-length items) 0)
                 (> (utf8Bytes (JSON/stringify (aref rows position))) byte-limit))
        (throw (desktopError "desktop_history_limit")))
      (js-object :items items :complete (and authoritative (= position (js-length rows)))
        :coverage (if authoritative "covered" "partial")
        :next_cursor (if (and (< position (js-length rows)) (> (js-length items) 0))
          (js-object :after_id (nativeGet (aref items (1- (js-length items))) "native_message_id")) nil))))
  (defasync openHistory (endpoint)
    (let* ((path (nativeGet endpoint "history_database")) (info (await (lstat path))))
      (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                   (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                   (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (desktopError "desktop_history_owner")))
      (new Database path (js-object :readonly t :create false :strict t))))
  (defasync assertCursorBridgeEnabled (endpoint)
    ;; A listening bridge can outlive the renderer's feature gate. Its empty
    ;; list in that state is not authoritative evidence of an empty catalog.
    ;; Read only the two native flags; never enable them or restart the app.
    (let ((db (await (openHistory endpoint))))
      (try
        (let* ((rows (js-call (js-call db :query
                  "SELECT key,value FROM ItemTable WHERE key IN ('cursor.desktopBridge.enabled','cursor/desktopBridgeUserEnabled')") :all))
               (enabled (js-call rows :filter (lambda (row) (= (nativeGet row "value") "true")))))
          (unless (= (js-length enabled) 2)
            (throw (desktopError "desktop_bridge_disabled"))))
        (finally (js-call db :close)))))
  (defun codexMessages (state)
    (let ((rows (js-array)) (complete t))
      (js-call (codexTurns state) :forEach (lambda (turn)
        (js-call (nativeGet turn "items" (js-array)) :forEach (lambda (item)
          (let* ((type (nativeGet item "type"))
                 (id (nativeGet item "id" (nativeGet item "itemId")))
                 (text (nativeGet item "text"))
                 (content (nativeGet item "content")))
            (when (js-call (js-array "userMessage" "agentMessage") :includes type)
              (when (and (not (= (nativeTypeOf text) "string")) (Array/isArray content))
                (setq text (js-call (js-call
                  (js-call content :filter (lambda (part) (= (nativeGet part "type") "text")))
                  :map (lambda (part) (nativeGet part "text" ""))) :join "\n")))
              (if (and (= (nativeTypeOf id) "string") (= (nativeTypeOf text) "string"))
                (js-call rows :push (js-object :native_message_id id
                  :role (if (= type "userMessage") "user" "assistant") :text text))
                (setq complete false))))))))
      (js-object :items rows :complete complete)))
  (defun cursorMessages (db thread cursor budget context)
    (let* ((head (js-call (js-call db :query
              "SELECT json_extract(value,'$.fullConversationHeadersOnly') AS headers FROM cursorDiskKV WHERE key=? AND length(value)<=8388608")
                  :get (str "composerData:" thread)))
           (headers (and (nativeGet head "headers") (JSON/parse (nativeGet head "headers"))))
           (rows (js-array)) (complete (Array/isArray headers)) (position 0) (bytes 0)
           (maximum (Math/min 200 (nativeGet budget "max_records" 100)))
           (byte-limit (Math/min 1048576 (nativeGet budget "max_bytes" 1048576)))
           (last nil) (stopped false))
      (when (Array/isArray headers)
        (when (> (js-length headers) 10000) (throw (desktopError "desktop_history_limit")))
        (when cursor
          (let ((index (js-call headers :findIndex
                  (lambda (header) (= (nativeGet header "bubbleId") (nativeGet cursor "after_id"))))))
            (when (< index 0) (throw (desktopError "desktop_stale_cursor")))
            (setq position (1+ index))))
        (while (and (< position (js-length headers)) (< (js-length rows) maximum) (not stopped))
          (desktopDeadline context)
          (let ((header (aref headers position)))
          (let* ((id (nativeGet header "bubbleId"))
                 (item (and (= (nativeTypeOf id) "string")
                   (js-call (js-call db :query
                     "SELECT json_extract(value,'$.bubbleId') AS id,json_extract(value,'$.type') AS type,json_extract(value,'$.text') AS text FROM cursorDiskKV WHERE key=? AND length(value)<=1048576")
                     :get (str "bubbleId:" thread ":" id)))))
            (if (and item (= (nativeGet item "id") id)
                     (js-call (js-array 1 2) :includes (nativeGet item "type"))
                     (= (nativeTypeOf (nativeGet item "text")) "string"))
              (let* ((message (js-object :native_message_id id
                        :role (if (= (nativeGet item "type") 1) "user" "assistant")
                        :text (nativeGet item "text")))
                     (size (utf8Bytes (JSON/stringify message))))
                (if (> (+ bytes size) byte-limit)
                  (if (= (js-length rows) 0)
                    (throw (desktopError "desktop_history_limit"))
                    (setq stopped t complete false))
                  (progn (setq bytes (+ bytes size)) (js-call rows :push message))))
              (setq complete false))
            (unless stopped (setq last id position (1+ position)))))))
      (js-object :items rows
        :complete (and complete (= position (js-length (or headers (js-array)))))
        :coverage (if complete "covered" "partial")
        :next_cursor (if (and last (< position (js-length headers))) (js-object :after_id last) nil))))

  (defun createDesktopPort (tool config host)
    (unless (js-call (js-array "codex" "cursor") :includes tool)
      (throw (new globalThis.TypeError "Unsupported desktop tool")))
    (let* ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
           (create-enabled (and (= tool "cursor") (> (js-length endpoints) 0)
             (js-call endpoints :every (lambda (endpoint) (nativeGet endpoint "control_manifest_path")))))
           (capabilities (js-object :session_list "supported" :session_messages "supported"
             :session_probe "supported" :session_send "supported" :start_idle "supported"
             :message_during_run (if (= tool "codex") "supported" "unsupported")
             :session_create (if create-enabled "supported" "unsupported") :instance_start "unsupported" :instance_stop "unsupported"
             :native_idempotency "unsupported" :lookup_send "unsupported" :lookup_create (if create-enabled "supported" "unsupported")
             :observe "unsupported" :max_input_frame_bytes 262144))
           (endpointFor nil) (sessionRecord nil) (cursorThreads nil) (codexSnapshot nil)
           (probe nil) (listSessions nil) (readMessages nil) (submit nil) (probeInstance nil)
           (createSession nil))
      (setq endpointFor (lambda (target)
        (when closed (throw (desktopError "desktop_closed")))
        (when (and (nativeGet target "tool") (not (= (nativeGet target "tool") tool)))
          (throw (desktopError "desktop_target_mismatch")))
        (let ((selected (js-call endpoints :filter (lambda (endpoint)
          (and (or (not (nativeGet target "endpoint_ref"))
                   (= (nativeGet endpoint "endpoint_ref") (nativeGet target "endpoint_ref")))
               (or (not (nativeGet target "instance_id"))
                   (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id")))
               (or (not (nativeGet target "native_namespace"))
                   (= (nativeGet endpoint "native_namespace") (nativeGet target "native_namespace"))))))))
          (unless (= (js-length selected) 1) (throw (desktopError "desktop_ambiguous_endpoint")))
          (aref selected 0))))
      (setq sessionRecord (lambda (endpoint id title state epoch)
        (js-object :tool tool :native_namespace (nativeGet endpoint "native_namespace")
          :native_session_id id :instance_id (nativeGet endpoint "instance_id") :instance_epoch epoch
          :workspace_ref (nativeGet endpoint "workspace_ref")
          :title (nativeGet (sliceUtf8 (or title "") 0 (nativeGet limits "title_bytes")) "text" "") :runtime_state state
          :live_receiver (not (= state "offline"))
          :visibility (if (nativeGet endpoint "native_api") (js-array "live") (js-array "history" "live"))
          :capabilities capabilities :coverage "covered" :evidence_level "native_protocol")))
      (setq cursorThreads (async (endpoint context)
        (desktopDeadline context)
        (unless (nativeGet endpoint "native_api") (await (assertCursorBridgeEnabled endpoint)))
        (let* ((response (if (nativeGet endpoint "native_api")
                          (await (cursorNativeRequest endpoint (js-object :operation "list") context))
                          (await (cursorRequest endpoint (js-object :type "listThreads") context))))
               (threads (nativeGet (nativeGet response "data") "threads")))
          (unless (and (Array/isArray threads) (<= (js-length threads) 200))
            (throw (desktopError "desktop_response")))
          (js-object :instance_epoch (nativeGet response "instance_epoch")
            :complete (if (nativeGet endpoint "native_api") (nativeGet (nativeGet response "data") "complete")
                        (< (js-length threads) 200))
            :items (js-call threads :filter (lambda (row)
              (and (= (nativeGet row "windowId") (nativeGet endpoint "window_id"))
                   (= (nativeTypeOf (nativeGet row "id")) "string")
                   (= (nativeGet row "source") "local"))))))))
      (setq codexSnapshot (async (endpoint id context work)
        (let ((channel (await (openCodexChannel endpoint context))))
          (try
            (let* ((result (await (js-call channel :snapshot id))) (state (nativeGet result "state")))
              (unless (= (nativeGet state "cwd") (nativeGet endpoint "directory"))
                (throw (desktopError "desktop_target_mismatch")))
              (await (funcall work channel result)))
            (finally (js-call channel :close))))))
      (setq probe (async (target binding context)
        (try
          (let ((endpoint (funcall endpointFor binding)) (id (nativeGet target "native_session_id")))
            (if (= tool "cursor")
              (let* ((response (when (nativeGet endpoint "native_api")
                                (await (cursorNativeRequest endpoint (js-object :operation "probe" :thread id) context))))
                     (page (if response
                             (js-object :instance_epoch (nativeGet response "instance_epoch")
                               :items (js-array (nativeGet (nativeGet response "data") "thread")))
                             (await (funcall cursorThreads endpoint context))))
                     (matches (js-call (nativeGet page "items") :filter
                       (lambda (row) (and (= (nativeGet row "id") id)
                         (= (nativeGet row "source") "local") (= (nativeGet row "windowId") (nativeGet endpoint "window_id")))))))
                (unless (= (js-length matches) 1) (throw (desktopError "desktop_no_owner")))
                (let ((row (aref matches 0)))
                  (funcall sessionRecord endpoint id (nativeGet row "title" "")
                    (cursorRuntime row) (nativeGet page "instance_epoch"))))
              (await (funcall codexSnapshot endpoint id context (async (channel result)
                (let ((state (nativeGet result "state")))
                  (funcall sessionRecord endpoint id (nativeGet state "title" "")
                    (codexRuntime state) (nativeGet channel "instance_epoch"))))))))
          (catch unavailable (js-object :runtime_state
            (if (js-call (js-array "ENOENT" "desktop_no_owner") :includes (nativeGet unavailable "code"))
              "offline" "unknown") :live_receiver false :evidence_level "none"
            :reason (if (= (nativeGet unavailable "code") "desktop_bridge_disabled")
              "desktop_bridge_disabled" "desktop_receiver_unavailable"))))))
      (setq listSessions (async (scope cursor budget context)
        (desktopDeadline context)
        (when closed (throw (desktopError "desktop_closed")))
        (let* ((selected (js-call endpoints :filter (lambda (endpoint)
                  (and (or (not (nativeGet scope "instance_ids"))
                           (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                       (or (not (nativeGet scope "workspace_refs"))
                           (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref")))))))
               (index (nativeGet cursor "endpoint_index" 0))
               (after (nativeGet cursor "after_id" ""))
               (maximum (Math/min 100 (nativeGet budget "max_records" 100)))
               (items (js-array)) (more false) (covered t) (last after))
          (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length selected)))
            (throw (desktopError "desktop_stale_cursor")))
          (when (< index (js-length selected))
            (let ((endpoint (aref selected index)))
              (if (= tool "cursor")
                (let* ((page (await (funcall cursorThreads endpoint context)))
                       (rows (js-call (js-call (nativeGet page "items") :filter
                                (lambda (row) (> (nativeGet row "id") after)))
                               :sort (lambda (left right)
                                 (if (< (nativeGet left "id") (nativeGet right "id")) -1 1)))))
                  (setq covered (nativeGet page "complete") more (> (js-length rows) maximum))
                  (js-call (js-call rows :slice 0 maximum) :forEach (lambda (row)
                    (setq last (nativeGet row "id"))
                    (js-call items :push (funcall sessionRecord endpoint last (nativeGet row "title" "")
                      (cursorRuntime row) (nativeGet page "instance_epoch"))))))
                (let ((db (await (openHistory endpoint))))
                  (try
                    (let ((rows (js-call (js-call db :query
                      "SELECT id,title,cwd,updated_at FROM threads WHERE cwd=? AND id>? AND archived=0 ORDER BY id LIMIT ?")
                      :all (nativeGet endpoint "directory") after maximum)))
                      (setq more (= (js-length rows) maximum))
                      (js-call rows :forEach (lambda (row)
                        (setq last (nativeGet row "id"))
                        (when (= (nativeGet row "cwd") (nativeGet endpoint "directory"))
                          (let ((session (funcall sessionRecord endpoint last (nativeGet row "title" "")
                                           "unknown" (nativeGet endpoint "instance_epoch"))))
                            (put session :live_receiver false)
                            (put session :visibility (js-array "history"))
                            (js-call items :push session))))))
                    (finally (js-call db :close)))))))
          (let ((continuation (cond (more (js-object :endpoint_index index :after_id last))
                    ((< (1+ index) (js-length selected)) (js-object :endpoint_index (1+ index) :after_id ""))
                    (t nil))))
            (js-object :items items :complete (and covered (not continuation))
              :coverage (if covered "covered" "partial") :next_cursor continuation)))))
      (setq readMessages (async (target cursor budget context)
        (desktopDeadline context)
        (let ((endpoint (funcall endpointFor target)) (id (nativeGet target "native_session_id")))
          (if (= tool "cursor")
            (if (nativeGet endpoint "native_api")
              (nativeGet (await (cursorNativeRequest endpoint
                (js-object :operation "messages" :thread id :after (nativeGet cursor "after_id" nil)
                  :maximum (Math/min 200 (nativeGet budget "max_records" 100))
                  :bytes (Math/min 1048576 (nativeGet budget "max_bytes" 1048576))) context)) "data")
            (let* ((page (await (funcall cursorThreads endpoint context)))
                   (found (js-call (nativeGet page "items") :some (lambda (row) (= (nativeGet row "id") id)))))
              (unless found (throw (desktopError "desktop_no_owner")))
                (let ((db (await (openHistory endpoint))))
                  (try
                    (cursorMessages db id cursor budget context)
                    (finally (js-call db :close))))))
            (await (funcall codexSnapshot endpoint id context (async (channel result)
              (let* ((state (nativeGet result "state")) (messages (codexMessages state))
                     (history (nativeGet (nativeGet state "turnHistory") "history"))
                     (complete (if history
                       (and (= (nativeGet history "isComplete") t) (= (js-length (nativeGet history "islands")) 1))
                       (= (nativeGet (nativeGet state "turnsPagination") "hasLoadedOldest") t))))
                (messagePage (nativeGet messages "items") cursor budget
                  (and complete (nativeGet messages "complete")))))))))))
      (setq submit (async (binding envelope mode key context)
        (let ((started false))
          (try
            (unless (js-call (js-array "start_idle" "steer") :includes mode) (throw (desktopError "desktop_send_mode")))
            (let* ((endpoint (funcall endpointFor binding)) (id (nativeGet binding "native_session_id"))
                   (text (encodeEnvelope envelope 250000)))
              (if (= tool "cursor")
                (let* ((response (when (nativeGet endpoint "native_api")
                                  (await (cursorNativeRequest endpoint (js-object :operation "probe" :thread id) context))))
                       (page (if response (js-object :instance_epoch (nativeGet response "instance_epoch"))
                                 (await (funcall cursorThreads endpoint context))))
                       (row (if response (nativeGet (nativeGet response "data") "thread")
                                (js-call (nativeGet page "items") :find (lambda (item) (= (nativeGet item "id") id))))))
                  (unless (and row (= (cursorRuntime row) "idle")
                               (= (nativeGet row "id") id) (= (nativeGet row "source") "local")
                               (= (nativeGet row "windowId") (nativeGet endpoint "window_id"))
                               (= (nativeGet page "instance_epoch") (nativeGet binding "instance_epoch")))
                    (throw (desktopError "desktop_target_changed")))
                  (setq started t)
                  (let* ((send-context (Object/assign (js-object) context
                              (js-object :expected_epoch (nativeGet binding "instance_epoch"))))
                         (response (if (nativeGet endpoint "native_api")
                           (await (cursorNativeRequest endpoint
                             (js-object :operation "submit" :thread id :text text :bubble (randomUUID)) send-context))
                           (await (cursorRequest endpoint
                             (js-object :type "sendMessage" :threadId id :text text :force false) send-context))))
                         (data (nativeGet response "data"))
                         (status (nativeGet data "status" (nativeGet data "outcome" "unknown"))))
                    (cond
                      ((js-call (js-array "submitted" "queued") :includes status)
                        (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                          :native_receipt_key (nativeGet data "native_receipt_key" nil)))
                      ((js-call (js-array "not-sendable" "not-found" "unknown-thread") :includes status)
                        (js-object :state "failed" :kind "rejected" :definite_not_sent t :retryable false
                          :evidence_level "native_protocol"))
                      (t (js-object :state "unknown" :kind "unknown" :definite_not_sent false :evidence_level "none")))))
                (await (funcall codexSnapshot endpoint id context (async (channel result)
                  (unless (and (or (= (codexRuntime (nativeGet result "state")) "idle")
                                 (and (= mode "steer") (js-call (js-array "busy" "waiting_permission") :includes (codexRuntime (nativeGet result "state")))))
                               (= (nativeGet channel "instance_epoch") (nativeGet binding "instance_epoch")))
                    (throw (desktopError "desktop_target_changed")))
                  (setq started t)
                  (let* ((running (not (= (codexRuntime (nativeGet result "state")) "idle")))
                    (request (codexInputRequest id text running (randomUUID)))
                    (answer (await (js-call channel :call (nativeGet request "method")
                      (nativeGet request "parameters") (nativeGet request "version") (nativeGet result "owner")))))
                    (js-object :state "accepted" :kind "accepted" :native_receipt_key (nativeGet answer "requestId")
                      :evidence_level "native_protocol")))))))
            (catch unavailable
              (js-object :state (if started "unknown" "failed") :kind (if started "unknown" "rejected")
                :definite_not_sent (not started) :retryable (not started) :evidence_level "none"))))))
      (setq createSession (async (instance workspace key context lookup)
        (unless create-enabled (throw (desktopError "desktop_create_unsupported")))
        (let* ((endpoint (funcall endpointFor instance))
               (before (await (funcall cursorThreads endpoint context)))
               (id (cursorCreationId workspace key)))
          (unless (and (= (nativeGet before "instance_epoch") (nativeGet instance "instance_epoch"))
                       (= workspace (nativeGet endpoint "workspace_ref")))
            (throw (desktopError "desktop_target_changed")))
          (let* ((response (await (cursorRequest
                    (js-object :manifest_path (nativeGet endpoint "control_manifest_path"))
                    (js-object :type (if lookup "lookupSession" "createSession")
                      :workspace_ref workspace :creation_key key :title (nativeGet context "title" nil)) context)))
                 (data (nativeGet response "data"))
                 (after (await (funcall cursorThreads endpoint context)))
                 (row (js-call (nativeGet after "items") :find (lambda (item) (= (nativeGet item "id") id)))))
            (unless (and (= (nativeGet data "native_session_id") id)
                         (= (nativeGet data "creation_key") key)
                         (= (nativeGet data "workspace_ref") workspace)
                         (= (nativeGet data "directory") (nativeGet endpoint "directory"))
                         (= (nativeGet after "instance_epoch") (nativeGet instance "instance_epoch")))
              (throw (desktopError "desktop_target_mismatch")))
            (if (and row (= (nativeGet data "state") "issued"))
              (js-object :state "ready" :creation_key key :evidence_level "native_protocol"
                :session (funcall sessionRecord endpoint id (nativeGet row "title" "")
                           (cursorRuntime row) (nativeGet after "instance_epoch")))
              (js-object :state "unknown" :creation_key key :definite_not_sent false :evidence_level "none"))))))
      (setq probeInstance (async (instance context)
        (try
          (let* ((endpoint (funcall endpointFor instance))
                 (epoch (if (= tool "cursor")
                   (nativeGet (await (funcall cursorThreads endpoint context)) "instance_epoch")
                   (let ((channel (await (openCodexChannel endpoint context))))
                     (try (nativeGet channel "instance_epoch") (finally (js-call channel :close)))))))
            (js-object :state "ready" :native_namespace (nativeGet endpoint "native_namespace")
              :instance_epoch epoch :evidence_level "native_protocol"))
          (catch unavailable (js-object :state
            (if (= (nativeGet unavailable "code") "ENOENT") "offline" "unknown")
            :evidence_level "none"
            :reason (if (= (nativeGet unavailable "code") "desktop_bridge_disabled")
              "desktop_bridge_disabled" "desktop_receiver_unavailable"))))))
      (js-object :create (when create-enabled (async (instance workspace key context)
                    (await (funcall createSession instance workspace key context false))))
        :lookupCreate (when create-enabled (async (instance key ref context)
          (let ((endpoint (funcall endpointFor instance)))
            (await (funcall createSession instance (nativeGet endpoint "workspace_ref") key context t)))))
        :capabilities capabilities :probe probe :listSessions listSessions :readMessages readMessages
        :submit submit :probeInstance probeInstance
        :initialize (lambda (context) (setq closed false))
        :discover (async (visibility page context)
          (if (or (not (js-call (js-array "history" "live") :includes visibility))
                  (and (= visibility "history")
                    (js-call endpoints :some (lambda (endpoint)
                      (and (nativeGet endpoint "native_api")
                        (or (not (nativeGet page "instance_id"))
                          (= (nativeGet page "instance_id") (nativeGet endpoint "instance_id"))))))))
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil
              :reason "desktop_visibility_unsupported")
            (let ((result (await (funcall listSessions
                   (js-object :instance_ids (js-array (nativeGet page "instance_id")))
                   (nativeGet page "cursor") (js-object :max_records 100) context))))
            (unless (= visibility "history")
              (let ((items (js-array)) (index 0))
                (while (< index (js-length (nativeGet result "items")))
                  (let* ((row (aref (nativeGet result "items") index))
                         (current (await (funcall probe row row context))))
                    (when (= (nativeGet current "live_receiver") t) (js-call items :push current)))
                  (setq index (1+ index)))
                (put result :items items)))
            result)))
        :lookup (async (binding key ref context) (js-object :state "unknown" :evidence_level "none"))
        :observe (async (binding ref cursor budget context)
          (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
        :close (async () (setq closed t)))))
  (export codexInputRequest createDesktopPort codexRuntime cursorRuntime))
