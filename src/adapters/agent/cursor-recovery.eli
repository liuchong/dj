(module dj.adapters.agent.cursor-recovery
  (import "../../core/native.eli" nativeGet nativeBitAnd nativeSetTimeout NativeNumber)
  (import "./native-local.eli" metadataCommand)
  (import "./electron-control.eli" electronControl)
  (import "./electron-inspector.eli" electronProcessInfo)
  (import "./desktop-transport.eli" desktopDeadline desktopError)
  (import "node:child_process" execFile)
  (import "node:fs/promises" lstat)
  ;; Rebind only a verified existing Cursor main process. Never launch here;
  ;; ordinary delivery cannot turn a closed client into a business restart.
  (defasync recoverCursorEndpoint (endpoint context &optional pid)
    (let* ((api (nativeGet endpoint "native_api")) (helper (nativeGet api "process_helper_ref"))
           (rows (js-call (await (metadataCommand "pgrep" (js-array "-x" "Cursor") context)) :split "\n"))
           (matches (js-array)))
      (js-call rows :forEach (lambda (line)
        (let ((match (js-call line :match (new globalThis.RegExp "^\\s*(\\d+)\\s*$"))))
          (when (and match (or (not pid) (= (NativeNumber (aref match 1)) pid)))
            (js-call matches :push (NativeNumber (aref match 1)))))))
      (unless (= (js-length matches) 1) (throw (desktopError "cursor_recovery_process_ambiguous")))
      (let ((stat (await (lstat helper))))
        (unless (and (js-call stat :isFile) (not (js-call stat :isSymbolicLink))
                     (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet stat "uid"))
                     (= (nativeBitAnd (nativeGet stat "mode") 18) 0))
          (throw (desktopError "cursor_process_helper_owner"))))
      (let* ((info (JSON/parse (await (metadataCommand helper (js-array (str (aref matches 0))) context))))
             (candidate (Object/assign (js-object) endpoint (js-object :native_api
               (Object/assign (js-object) api (js-object :process_id (nativeGet info "pid")
                 :process_birth (nativeGet info "birth") :process_origin 0)))))
             (inspection (await (electronControl candidate (js-object :operation "inspect") context)))
             (windows (js-call (nativeGet (nativeGet inspection "data") "windows") :filter
               (lambda (window) (js-call (nativeGet window "url" "") :startsWith "vscode-file://vscode-app/"))))
             (prior (js-call windows :find (lambda (window) (= (nativeGet window "id") (nativeGet endpoint "window_id")))))
             (selected (or prior (and (= (js-length windows) 1) (aref windows 0)))))
        (unless selected (throw (desktopError "cursor_recovery_window_ambiguous")))
        (put candidate :window_id (nativeGet selected "id"))
        (put (nativeGet candidate "native_api") :process_origin (nativeGet (nativeGet inspection "data") "origin"))
        ;; Workspace/session validation remains in the native repository request.
        (Object/assign endpoint candidate) endpoint)))
  (defasync restartCursorProcess (endpoint context)
    (let* ((api (nativeGet endpoint "native_api")) (helper (nativeGet api "restart_helper_ref"))
           (info (await (lstat helper))))
      (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                   (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
                   (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (desktopError "cursor_restart_helper_owner")))
      (await (electronProcessInfo endpoint context))
      (let ((result (await (new globalThis.Promise (lambda (done failed)
        (let ((child (execFile helper (js-array) (js-object :encoding "utf8" :maxBuffer 8192
          :timeout (Math/ceil (desktopDeadline context)))
          (lambda (error stdout stderr)
            (if error (funcall failed (desktopError "cursor_restart_unconfirmed"))
              (try (funcall done (JSON/parse stdout))
                (catch malformed (funcall failed (desktopError "cursor_restart_unconfirmed")))))))))
          (js-call (nativeGet child "stdin") :end (JSON/stringify (js-object :pid (nativeGet api "process_id")
            :birth (nativeGet api "process_birth"))))))))))
        (unless (= (nativeGet result "ok") t) (throw (desktopError "cursor_restart_unconfirmed")))
        (let ((ready false) (attempt 0))
          (while (and (not ready) (< attempt 30))
            (desktopDeadline context)
            (try (await (recoverCursorEndpoint endpoint context (nativeGet result "pid"))) (setq ready t)
              (catch pending
                (await (new globalThis.Promise (lambda (done) (nativeSetTimeout done 200))))))
            (setq attempt (1+ attempt)))
          (unless ready (throw (desktopError "cursor_restart_rebind_pending"))))
        endpoint)))
  (export recoverCursorEndpoint restartCursorProcess))
