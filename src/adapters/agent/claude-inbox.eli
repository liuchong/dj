(module dj.adapters.agent.claude-inbox
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout nativeClearTimeout)
  (import "../../core/types.eli" utf8Bytes)
  (import "../../delivery/envelope.eli" renderEnvelope)
  (import "./native-local.eli" ownedJson processProof expectedEpoch)
  (import "./desktop-transport.eli" desktopError desktopDeadline socketIdentity)
  (import "node:net" createServer createConnection)
  (import "node:fs/promises" lstat chmod unlink open)
  (import "node:fs" constants)
  (import "node:path" dirname join basename)
  (import "node:crypto" randomUUID)
  (defconst claudeCapabilities (Object/freeze
    (js-object :session_list "supported" :session_messages "supported" :session_probe "supported"
      :session_send "supported" :start_idle "supported" :message_during_run "supported" :session_create "unsupported"
      :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "unsupported"
      :lookup_send "positive_only" :lookup_create "unsupported" :observe "unsupported" :max_input_frame_bytes 262144)))
  (defasync claudeTarget (endpoint context)
    (let* ((epoch (await (processProof endpoint context)))
           (registry (await (ownedJson (nativeGet endpoint "registry_path") false)))
           (binding (nativeGet endpoint "process_binding")))
      (unless (and (= (nativeGet registry "pid") (nativeGet binding "pid"))
                   (= (nativeGet registry "sessionId") (nativeGet endpoint "native_session_id"))
                   (= (nativeGet registry "cwd") (nativeGet endpoint "directory"))
                   (= (nativeGet registry "messagingSocketPath" (nativeGet registry "sock")) (nativeGet endpoint "socket_path"))
                   (js-call (nativeGet registry "peerFeatures" (js-array)) :includes "notify_idle"))
        (throw (desktopError "claude_native_identity")))
      (js-object :registry registry :instance_epoch epoch)))
  (defasync claudeMessages (endpoint cursor budget)
    (let* ((path (nativeGet endpoint "history_log")) (id (nativeGet endpoint "native_session_id"))
           (items (js-array)) (ids (new globalThis.Set)) (bytes 0) (index 0)
           (maximum (Math/min 128 (nativeGet budget "max_records" 32)))
           (limit (Math/min 524288 (nativeGet budget "max_bytes" 524288))))
      (when (and cursor (not (= (nativeGet cursor "session_id") id)))
        (throw (desktopError "claude_message_cursor")))
      (if (not path) (js-object :items items :coverage "partial" :complete t :next_cursor nil)
        (progn
          (unless (= (basename path) (str id ".jsonl")) (throw (desktopError "claude_history_identity")))
          (let ((file (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW"))))))
            (try
              (let* ((info (await (js-call file :stat))) (total (nativeGet info "size"))
                     (start (if cursor (nativeGet cursor "offset") (Math/max 0 (- total 4194304)))))
                (unless (and (js-call info :isFile) (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                             (= (nativeBitAnd (nativeGet info "mode") 18) 0)
                             (Number/isSafeInteger start) (>= start 0) (<= start total))
                  (throw (desktopError "claude_history_identity")))
                (let* ((buffer (Buffer/alloc (Math/min 4194304 (- total start))))
                       (read (nativeGet (await (js-call file :read buffer 0 (js-length buffer) start)) "bytesRead"))
                       (scan (if (and (not cursor) (> start 0)) (1+ (js-call buffer :indexOf 10)) 0))
                       (offset (+ start scan)) (running t))
                  (when (and (> start 0) (not cursor) (= scan 0)) (setq running false))
                  (while (and running (< scan read) (< index 256) (< (js-length items) maximum))
                    (let ((end (js-call buffer :indexOf 10 scan)))
                      (if (or (< end 0) (>= end read)) (setq running false)
                        (let ((row nil) (message nil))
                          (try (setq row (JSON/parse (js-call (js-call buffer :subarray scan end) :toString "utf8")))
                            (catch invalid (setq row nil)))
                          (when (and row (= (nativeGet row "sessionId") id)
                                     (js-call (js-array "user" "assistant") :includes (nativeGet row "type")))
                            (let* ((native (nativeGet row "message")) (content (nativeGet native "content"))
                                   (text (if (= (nativeTypeOf content) "string") content
                                     (if (Array/isArray content)
                                       (js-call (js-call (js-call content :filter (lambda (block) (= (nativeGet block "type") "text")))
                                         :map (lambda (block) (nativeGet block "text" ""))) :join "\n") "")))
                                   (message-id (nativeGet native "id" (nativeGet row "uuid"))))
                              (when (and (= (nativeTypeOf message-id) "string") (> (js-length text) 0)
                                         (not (js-call ids :has message-id)))
                                (setq message (js-object :native_message_id message-id :role (nativeGet row "type")
                                  :text text :created_at (nativeGet row "timestamp"))))))
                          (if (and message (> (+ bytes (utf8Bytes (JSON/stringify message))) limit))
                            (setq running false)
                            (progn (when message (js-call items :push message)
                              (js-call ids :add (nativeGet message "native_message_id"))
                              (setq bytes (+ bytes (utf8Bytes (JSON/stringify message)))))
                              (setq scan (1+ end) offset (+ start scan) index (1+ index))))))))
                  (when (and (< offset total) (= offset start))
                    (throw (desktopError "claude_history_line_limit")))
                  (js-object :items items :coverage "partial" :complete (>= offset total)
                    :next_cursor (if (< offset total) (js-object :session_id id :offset offset) nil))))
              (finally (await (js-call file :close)))))))))
  (defun createClaudeInboxPort (config host)
    (let ((endpoints (nativeGet config "endpoints" (js-array))) (servers (new globalThis.Map))
          (pending (new globalThis.Map)) (idle (new globalThis.Map)) (receipts (new globalThis.Map))
          (closed false) (endpointFor nil) (serverFor nil) (sendFrame nil) (probe nil) (project nil) (listSessions nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (endpoint)
          (and (= (nativeGet endpoint "instance_id") (nativeGet target "instance_id"))
               (or (not (nativeGet target "native_namespace"))
                   (= (nativeGet endpoint "native_namespace") (nativeGet target "native_namespace")))
               (or (not (nativeGet target "native_session_id"))
                   (= (nativeGet endpoint "native_session_id") (nativeGet target "native_session_id"))))))))
          (unless (= (js-length rows) 1) (throw (desktopError "claude_exact_endpoint")))
          (aref rows 0))))
      (setq serverFor (async (endpoint)
        (let* ((directory (dirname (nativeGet endpoint "socket_path"))) (old (js-call servers :get directory)))
          (if old (await old)
            (let ((promise (funcall (async ()
              (let* ((info (await (lstat directory))) (path (join directory (str (nativeGet globalThis.process "pid") ".sock")))
                     (connections (new globalThis.Set)) (server nil))
                (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
                             (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                             (= (nativeBitAnd (nativeGet info "mode") 63) 0))
                  (throw (desktopError "claude_callback_directory")))
                (setq server (createServer (lambda (socket)
                  (js-call connections :add socket)
                  (js-call socket :setTimeout 2000 (lambda () (js-call socket :destroy)))
                  (let ((buffer "") (size 0))
                    (js-call socket :on "data" (lambda (chunk)
                      (setq size (+ size (js-length chunk)))
                      (if (> size 65536) (js-call socket :destroy)
                        (progn (setq buffer (str buffer (js-call chunk :toString "utf8")))
                          (let ((position (js-call buffer :indexOf "\n")))
                            (while (>= position 0)
                              (try
                                (let* ((frame (JSON/parse (js-call buffer :slice 0 position)))
                                       (entry (js-call pending :get (nativeGet frame "orig_msg_id"))))
                                  (when (and entry (= (nativeGet frame "msgV") 1) (= (nativeGet frame "type") "control")
                                             (or (not (nativeGet frame "from"))
                                                 (= (nativeGet frame "from") (str "uds:" (nativeGet entry "peer")))))
                                    (cond
                                      ((and (= (nativeGet entry "kind") "idle") (= (nativeGet frame "action") "peer_idle_notice"))
                                        (put entry :notice frame) (js-call pending :delete (nativeGet frame "orig_msg_id")))
                                      ((and (= (nativeGet entry "kind") "send") (= (nativeGet frame "action") "peer_message_status"))
                                        (when (js-call (js-array "delivered" "held" "denied" "refused" "expired" "dropped") :includes (nativeGet frame "status"))
                                          (put entry :notice frame)
                                          (when (= (nativeGet frame "status") "delivered")
                                            (when (>= (nativeGet receipts "size") 4096)
                                              (js-call receipts :delete (nativeGet (js-call (js-call receipts :keys) :next) "value")))
                                            (js-call receipts :set (nativeGet entry "key") frame))
                                          (unless (= (nativeGet frame "status") "held")
                                            (js-call pending :delete (nativeGet frame "orig_msg_id"))))))))
                                (catch invalid nil))
                              (setq buffer (js-call buffer :slice (1+ position)) position (js-call buffer :indexOf "\n"))))))))
                    (js-call socket :on "error" (lambda (unused) nil))
                    (js-call socket :on "close" (lambda () (js-call connections :delete socket)))))))
                ;; listen fails on any existing path; never remove somebody else's socket.
                (await (new globalThis.Promise (lambda (resolve reject)
                  (js-call server :once "error" (lambda (unused) (funcall reject (desktopError "claude_callback_bind"))))
                  (js-call server :listen path (lambda () (funcall resolve t))))))
                (await (chmod path 384))
                (js-object :server server :path path :identity (await (socketIdentity path)) :connections connections))))))
              (js-call servers :set directory promise) (await promise))))))
      (setq sendFrame (async (endpoint frame context)
        (when closed (throw (desktopError "claude_closed")))
        (let ((epoch (nativeGet (await (claudeTarget endpoint context)) "instance_epoch")))
          (expectedEpoch epoch context)
          (let ((callback (await (funcall serverFor endpoint))))
            (put frame :from (str "uds:" (nativeGet callback "path")))
            (await (new globalThis.Promise (lambda (resolve reject)
              (let ((socket nil) (timer nil) (done false) (finish nil))
                (setq finish (lambda (error)
                  (unless done (setq done t) (when timer (nativeClearTimeout timer))
                    (when socket (js-call socket :destroy))
                    (if error (funcall reject error) (funcall resolve t)))))
                (setq timer (nativeSetTimeout (lambda () (funcall finish (desktopError "claude_socket_timeout")))
                  (desktopDeadline context)))
                (setq socket (createConnection (js-object :path (nativeGet endpoint "socket_path"))
                  (lambda () (js-call socket :end (str (JSON/stringify frame) "\n") (lambda () (funcall finish nil))))))
                (js-call socket :on "error" (lambda (unused) (funcall finish (desktopError "claude_socket_write")))))))))
          epoch)))
      (setq project (lambda (endpoint checked state)
        (js-object :tool "claude" :native_namespace (nativeGet endpoint "native_namespace")
          :native_session_id (nativeGet endpoint "native_session_id") :instance_id (nativeGet endpoint "instance_id")
          :instance_epoch (nativeGet checked "instance_epoch") :workspace_ref (nativeGet endpoint "workspace_ref")
          :title (nativeGet (nativeGet checked "registry") "name" "Claude Code") :visibility (js-array "live")
          :runtime_state state :live_receiver t :coverage "current_session_only"
          :evidence_level "native_protocol" :capabilities claudeCapabilities)))
      (setq probe (async (target binding context)
        (let* ((endpoint (funcall endpointFor (Object/assign (js-object) binding target)))
               (checked (await (claudeTarget endpoint context))) (peer (nativeGet endpoint "socket_path"))
               (entry (js-call idle :get peer)))
          (expectedEpoch (nativeGet checked "instance_epoch") binding)
          (unless entry
            (when (>= (nativeGet pending "size") 256) (throw (desktopError "claude_pending_limit")))
            (let ((id (randomUUID)))
              (setq entry (js-object :kind "idle" :peer peer :id id :notice nil))
              (js-call idle :set peer entry) (js-call pending :set id entry)
              (try (await (funcall sendFrame endpoint (js-object :msgV 1 :msg_id id :type "control" :action "notify_when_idle") context))
                (catch unavailable (js-call idle :delete peer) (js-call pending :delete id) (throw unavailable)))))
          (let ((until (+ (performance/now) (Math/min 1000 (desktopDeadline context)))))
            (while (and (not (nativeGet entry "notice")) (< (performance/now) until)
                        (not (nativeGet (nativeGet context "abort_signal") "aborted")))
              (await (new globalThis.Promise (lambda (resolve) (nativeSetTimeout resolve 10))))))
          (let* ((notice (nativeGet entry "notice")) (state (if (= (nativeGet notice "state") "idle") "idle" "unknown")))
            (when notice (js-call idle :delete peer))
            (expectedEpoch (nativeGet (await (claudeTarget endpoint context)) "instance_epoch") checked)
            (funcall project endpoint checked state)))))
      (setq listSessions (async (scope cursor budget context)
        (let ((items (js-array)) (index (nativeGet cursor "offset" 0)) (partial false))
          (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length endpoints)))
            (throw (desktopError "claude_endpoint_cursor")))
          (while (and (< index (js-length endpoints)) (< (js-length items) (nativeGet budget "max_records" 32)))
            (let ((endpoint (aref endpoints index)))
              (when (and (or (not (nativeGet scope "instance_ids"))
                            (js-call (nativeGet scope "instance_ids") :includes (nativeGet endpoint "instance_id")))
                         (or (not (nativeGet scope "workspace_refs"))
                            (js-call (nativeGet scope "workspace_refs") :includes (nativeGet endpoint "workspace_ref"))))
                (try (js-call items :push (await (funcall probe endpoint (js-object) context)))
                  (catch unavailable (setq partial t)))))
            (setq index (1+ index)))
          (js-object :items items :complete (= index (js-length endpoints)) :coverage (if partial "partial" "covered")
            :next_cursor (if (< index (js-length endpoints)) (js-object :offset index) nil)))))
      (js-object :capabilities claudeCapabilities :initialize (lambda (context) (setq closed false)) :listSessions listSessions
        :probe probe
        :probeInstance (async (instance context)
          (try (let ((checked (await (claudeTarget (funcall endpointFor instance) context))))
            (js-object :state "ready" :native_namespace (nativeGet instance "native_namespace")
              :instance_epoch (nativeGet checked "instance_epoch") :evidence_level "native_protocol"))
            (catch unavailable (js-object :state "offline" :evidence_level "none" :reason "claude_receiver_unavailable"))))
        :discover (async (visibility page context)
          (if (not (= visibility "live"))
            (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil)
            (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")))
              (nativeGet page "cursor") (js-object :max_records (Math/min 100 (nativeGet page "limit" 100))) context))))
        :refresh (async (page context) (await (funcall listSessions
          (js-object :instance_ids (js-array (nativeGet page "instance_id"))) (nativeGet page "cursor") (js-object :max_records 100) context)))
        :readMessages (async (session cursor budget context)
          (let ((endpoint (funcall endpointFor session)))
            (let ((checked (await (claudeTarget endpoint context)))) (expectedEpoch (nativeGet checked "instance_epoch") session))
            (await (claudeMessages endpoint cursor budget))))
        :submit (async (binding envelope mode key context)
          (let ((started false) (entry nil))
            (try
              (let* ((endpoint (funcall endpointFor binding)) (text (renderEnvelope envelope))
                     (checked (await (funcall probe binding binding context))) (id (randomUUID)))
                (unless (and (js-call (js-array "start_idle" "steer") :includes mode) (or (= (nativeGet checked "runtime_state") "idle")
                               (and (= mode "steer") (= (nativeGet checked "runtime_state") "busy")))
                             (<= (utf8Bytes text) 262144) (< (nativeGet pending "size") 256))
                  (throw (desktopError "claude_not_sendable")))
                (setq entry (js-object :kind "send" :peer (nativeGet endpoint "socket_path") :key key :notice nil))
                (js-call pending :set id entry) (js-call idle :delete (nativeGet endpoint "socket_path"))
                (setq started t)
                (await (funcall sendFrame endpoint (js-object :msgV 1 :msg_id id :type "user" :priority "next"
                  :message (js-object :role "user" :content text)) (Object/assign (js-object) context binding)))
                (let ((until (+ (performance/now) (Math/min 2000 (desktopDeadline context)))))
                  (while (and (not (nativeGet entry "notice")) (< (performance/now) until)
                              (not (nativeGet (nativeGet context "abort_signal") "aborted")))
                    (await (new globalThis.Promise (lambda (resolve) (nativeSetTimeout resolve 10))))))
                (let ((notice (nativeGet entry "notice")))
                  (cond ((= (nativeGet notice "status") "delivered")
                    (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
                      :native_receipt_key (nativeGet notice "msg_id" id)))
                    ((js-call (js-array "denied" "refused" "expired" "dropped") :includes (nativeGet notice "status"))
                      (js-object :state "failed" :kind "rejected" :definite_not_sent t :retryable false :evidence_level "native_protocol"))
                    (t (js-object :state "unknown" :kind "unknown" :definite_not_sent false :evidence_level "none")))))
              (catch unavailable (js-object :state (if started "unknown" "failed") :kind (if started "unknown" "rejected")
                :definite_not_sent (not started) :retryable (not started) :evidence_level "none")))))
        :lookup (async (binding key ref context)
          (let ((notice (js-call receipts :get key)))
            (if notice (js-object :state "accepted" :kind "accepted" :evidence_level "native_protocol"
              :native_receipt_key (nativeGet notice "msg_id")) (js-object :state "unknown" :evidence_level "none"))))
        :observe (async (binding ref cursor budget context) (js-object :items (js-array) :complete t :coverage "partial" :next_cursor nil))
        :close (async ()
          (setq closed t)
          (let ((entries (Array/from (js-call servers :values))) (i 0))
            (while (< i (js-length entries))
              (try (let ((server (await (aref entries i))))
                (js-call (nativeGet server "connections") :forEach (lambda (socket) (js-call socket :destroy)))
                (await (new globalThis.Promise (lambda (resolve) (js-call (nativeGet server "server") :close resolve))))
                (when (= (await (socketIdentity (nativeGet server "path"))) (nativeGet server "identity"))
                  (await (unlink (nativeGet server "path")))))
                (catch unavailable nil))
              (setq i (1+ i))))
          (js-call servers :clear) (js-call pending :clear) (js-call idle :clear) (js-call receipts :clear)))))
  (export createClaudeInboxPort claudeTarget claudeMessages))
