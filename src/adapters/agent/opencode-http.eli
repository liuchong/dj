(module dj.adapters.agent.opencode-http
  (import "../../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout nativeBitAnd nativeEncodeURIComponent)
  (import "../../core/types.eli" utf8Bytes hashValue)
  (import "../../core/limits.eli" limits)
  (import "../../delivery/envelope.eli" encodeAgentInput openCodeMessageId)
  (import "../im/telegram.eli" readJson)
  (import "./native-local.eli" ownedJson metadataCommand)
  (import "node:fs/promises" lstat readdir)
  (import "node:path" join)
  (defun localUrl (text)
    (let ((url (new globalThis.URL text)))
      (unless (and (= (nativeGet url "protocol") "http:")
        (js-call (js-array "127.0.0.1" "localhost" "[::1]") :includes (nativeGet url "hostname"))
        (= (nativeGet url "username") "") (= (nativeGet url "password") ""))
        (throw (new globalThis.TypeError "OpenCode requires a local HTTP origin"))) url))
  (defasync processOwner (pid url context &optional desktop)
    (unless (and (Number/isSafeInteger pid) (> pid 0)) (throw (new globalThis.Error "invalid OpenCode PID")))
    (let* ((line (js-call (await (metadataCommand "/bin/ps" (js-array "-p" (str pid) "-o" "uid=,lstart=,comm=") context)) :trim))
           (uid (aref (js-call line :split (new globalThis.RegExp "\\s+")) 0))
           (ports (await (metadataCommand "/usr/sbin/lsof" (js-array "-nP" "-a" "-p" (str pid) "-iTCP" "-sTCP:LISTEN" "-Fn") context)))
           (port (nativeGet (localUrl url) "port")))
      (unless (and (= uid (str (js-call globalThis.process :getuid)))
        (or (not desktop) (js-call (new globalThis.RegExp "OpenCode\\.app/Contents/MacOS/OpenCode$") :test line))
        (js-call (js-call ports :split "\n") :some (lambda (entry)
          (and (js-call entry :startsWith "n")
            (js-call (js-array (str "n127.0.0.1:" port) (str "n[::1]:" port) (str "n*:" port)) :includes entry)))))
        (throw (new globalThis.Error "OpenCode listener owner mismatch")))
      (str "opencode_" (hashValue (js-array pid line)))))
  (defun nativeSession (endpoint native &optional state epoch opened)
    (unless (and (= (nativeTypeOf (nativeGet native "id")) "string")
      (= (nativeGet native "projectID") (nativeGet endpoint "native_namespace"))
      (= (nativeGet (nativeGet native "location") "directory") (nativeGet endpoint "directory")))
      (throw (new globalThis.TypeError "OpenCode session project mismatch")))
    (let* ((model (nativeGet native "model"))
      (record (js-object :tool "opencode" :surface (if opened "desktop" "cli")
        :native_namespace (nativeGet endpoint "native_namespace") :native_session_id (nativeGet native "id")
        :instance_id (nativeGet endpoint "instance_id") :instance_epoch (or epoch (nativeGet endpoint "instance_epoch"))
        :workspace_ref (nativeGet endpoint "workspace_ref") :title (nativeGet native "title" "")
        :runtime_state (or state "unknown") :live_receiver t :coverage "covered"
        :visibility (if opened (js-array "history" "live" "desktop-open") (js-array "history" "live"))
        :model_selection (js-object :provider_id (nativeGet model "providerID") :model_id (nativeGet model "id")
          :variant (nativeGet model "variant")))))
      (js-call (js-array "created" "updated") :forEach (lambda (field)
        (let ((ms (nativeGet (nativeGet native "time") field)))
          (when (Number/isSafeInteger ms) (put record (str field "_at") (js-call (new globalThis.Date ms) :toISOString)))))) record))
  (defun createOpenCodePort (config host)
    (let* ((endpoints (nativeGet config "endpoints" (js-array))) (closed false)
      (capabilities (js-object :session_list "supported" :session_messages "supported" :session_probe "supported"
        :session_create "supported" :session_send "supported" :start_idle "supported" :message_during_run "supported"
        :instance_start "unsupported" :instance_stop "unsupported" :native_idempotency "supported"
        :lookup_send "positive_only" :lookup_create "unsupported" :observe "unsupported" :max_input_frame_bytes 262144))
      (endpointFor nil) (request nil) (connect nil) (desktop nil) (readMessages nil) (probe nil) (listSessions nil))
      (setq endpointFor (lambda (target)
        (let ((rows (js-call endpoints :filter (lambda (e)
          (and (= (nativeGet e "instance_id") (nativeGet target "instance_id"))
            (or (not (nativeGet target "native_namespace")) (= (nativeGet e "native_namespace") (nativeGet target "native_namespace"))))))))
          (unless (= (js-length rows) 1) (throw (new globalThis.Error "exact OpenCode endpoint required"))) (aref rows 0))))
      (setq request (async (client path method body context &optional token)
        (when closed (throw (new globalThis.Error "OpenCode adapter closed")))
        (let* ((url (new globalThis.URL path (nativeGet client "url")))
          (controller (new globalThis.AbortController))
          (parent (nativeGet context "abort_signal")) (abort (lambda () (js-call controller :abort)))
          (remaining (- (nativeGet context "deadline" (+ (js-call (nativeGet host "clock") :monoNow) 15000))
            (js-call (nativeGet host "clock") :monoNow))) (timer nil)
          (headers (js-object :accept "application/json")))
          (localUrl (js-call url :toString))
          (unless (> remaining 0) (throw (new globalThis.Error "OpenCode deadline")))
          (when (nativeGet parent "aborted") (throw (new globalThis.Error "OpenCode cancelled")))
          (when token (put headers :authorization (str "Bearer " token)))
          (when (and (not token) (nativeGet client "password"))
            (put headers :authorization (str "Basic " (js-call (Buffer/from
              (str "opencode:" (nativeGet client "password"))) :toString "base64"))))
          (when body (put headers :content-type "application/json"))
          (try
            (setq timer (nativeSetTimeout abort remaining))
            (when parent (js-call parent :addEventListener "abort" abort (js-object :once t)))
            (let* ((response (await (js-call (nativeGet host "http") :fetch url
              (js-object :method method :headers headers :body (if body (JSON/stringify body) nil)
                :signal (nativeGet controller "signal") :redirect "error"))))
              (status (nativeGet response "status"))
              (content-type (js-call (nativeGet response "headers") :get "content-type")))
              (unless (and content-type (js-call content-type :includes "application/json"))
                (throw (new globalThis.Error "OpenCode returned a non-JSON protocol")))
              (let ((wire (await (readJson response (nativeGet limits "native_response_max_bytes")))))
                (js-object :ok (nativeGet response "ok") :status status :wire wire)))
            (finally (when timer (nativeClearTimeout timer))
              (when parent (js-call parent :removeEventListener "abort" abort)))))))
      (setq connect (async (endpoint context)
        (let* ((file (nativeGet endpoint "service_file"))
          (registration (when file (await (ownedJson file t))))
          (credentials (when (and (not file) (nativeGet endpoint "credential_ref"))
            (await (js-call (nativeGet host "credentials") :resolve (nativeGet endpoint "credential_ref")))))
          (client (js-object :url (if registration (nativeGet registration "url") (nativeGet endpoint "base_url"))
            :password (nativeGet (or registration credentials) "password")))
          (health (await (funcall request client "/api/info" "GET" nil context)))
          (info (nativeGet health "wire")))
          (unless (and (nativeGet health "ok") (Number/isSafeInteger (nativeGet info "pid"))
            (= (nativeTypeOf (nativeGet info "version")) "string")
            (or (not registration) (and (= (nativeGet info "pid") (nativeGet registration "pid"))
              (= (nativeGet info "version") (nativeGet registration "version")))))
            (throw (new globalThis.Error "OpenCode service registration mismatch")))
          (put client :epoch (if file (await (processOwner (nativeGet info "pid") (nativeGet client "url") context))
            (nativeGet endpoint "instance_epoch")))
          (put client :pid (nativeGet info "pid")) client)))
      (setq desktop (async (endpoint client input context)
        (let* ((root (nativeGet endpoint "desktop_registry_path")) (info (await (lstat root))) (matches (js-array)))
          (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
            (= (nativeGet info "uid") (js-call globalThis.process :getuid)) (= (nativeBitAnd (nativeGet info "mode") 63) 0))
            (throw (new globalThis.Error "OpenCode desktop registry ownership")))
          (let ((names (await (readdir root))) (i 0))
            (while (< i (js-length names))
              (let ((name (aref names i)))
                (when (js-call (new globalThis.RegExp "^[0-9]+\\.json$") :test name)
                  (try
                    (let* ((row (await (ownedJson (join root name) t)))
                      (epoch (await (processOwner (nativeGet row "pid") (nativeGet row "endpoint") context t)))
                      (r (await (funcall request (js-object :url (nativeGet row "endpoint")) "/control" "POST"
                        (js-object :action "list" :windowId (nativeGet endpoint "window_id")) context (nativeGet row "token"))))
                      (wire (nativeGet r "wire")))
                      (when (and (nativeGet r "ok") (= (nativeGet wire "ok") t) (= (nativeGet wire "pid") (nativeGet row "pid")))
                        (js-call (nativeGet wire "windows" (js-array)) :forEach (lambda (win)
                          (when (and (= (nativeGet win "windowId") (nativeGet endpoint "window_id"))
                            (js-call (nativeGet win "servers" (js-array)) :some (lambda (server)
                              (and (= (nativeGet server "serverKey") (nativeGet endpoint "server_key"))
                                (= (nativeGet server "endpoint") (nativeGet client "url")) (= (nativeGet server "localTarget") t)))))
                            (js-call matches :push (js-object :registry row :window win)))))))
                    (catch stale nil))))
              (setq i (1+ i))))
          (unless (= (js-length matches) 1) (throw (new globalThis.Error "exact OpenCode desktop window unavailable")))
          (let* ((match (aref matches 0)) (row (nativeGet match "registry")))
            (if (= (nativeGet input "action") "list") (nativeGet match "window")
              (let* ((r (await (funcall request (js-object :url (nativeGet row "endpoint")) "/control" "POST"
                (Object/assign (js-object :windowId (nativeGet endpoint "window_id") :serverKey (nativeGet endpoint "server_key")
                  :endpoint (nativeGet client "url")) input) context (nativeGet row "token")))) (wire (nativeGet r "wire")))
                (unless (and (nativeGet r "ok") (= (nativeGet wire "ok") t) (= (nativeGet wire "pid") (nativeGet row "pid"))
                  (= (js-length (nativeGet wire "windows" (js-array))) 1))
                  (throw (new globalThis.Error "OpenCode desktop action not confirmed")))
                (aref (nativeGet wire "windows") 0)))))))
      (setq probe (async (target binding context)
        (try
          (let* ((e (funcall endpointFor binding)) (c (await (funcall connect e context)))
            (id (nativeGet target "native_session_id"))
            (response (await (funcall request c (str "/api/session/" (nativeEncodeURIComponent id)) "GET" nil context)))
            (active (await (funcall request c "/api/session/active" "GET" nil context)))
            (row (nativeGet (nativeGet response "wire") "data"))
            (state (if (nativeGet (nativeGet (nativeGet active "wire") "data") id) "busy" "idle"))
            (opened nil))
            (unless (and (nativeGet response "ok") (nativeGet active "ok") (= (nativeGet row "id") id))
              (throw (new globalThis.Error "OpenCode session unavailable")))
            (when (nativeGet e "desktop_registry_path")
              (let ((win (await (funcall desktop e c (js-object :action "list") context))))
                (setq opened (js-call (nativeGet win "tabs") :some (lambda (tab)
                  (and (= (nativeGet tab "id") id) (= (nativeGet tab "endpoint") (nativeGet c "url"))
                    (= (nativeGet tab "serverKey") (nativeGet e "server_key"))))))
                (unless opened (throw (new globalThis.Error "OpenCode session is not desktop-open")))))
            (Object/assign (nativeSession e row state (nativeGet c "epoch") opened)
              (js-object :capabilities capabilities :evidence_level "native_protocol")))
          (catch invalid (js-object :runtime_state "offline" :live_receiver false :reason "opencode_receiver_unavailable")))))
      (setq listSessions (async (scope cursor budget context)
        (let* ((selected (js-call endpoints :filter (lambda (e)
            (and (or (not (nativeGet scope "instance_ids")) (js-call (nativeGet scope "instance_ids") :includes (nativeGet e "instance_id")))
              (or (not (nativeGet scope "workspace_refs")) (js-call (nativeGet scope "workspace_refs") :includes (nativeGet e "workspace_ref")))))))
          (index (nativeGet cursor "endpoint_index" 0)) (e (aref selected index)))
          (unless (and (Number/isSafeInteger index) (>= index 0) (<= index (js-length selected)))
            (throw (new globalThis.Error "invalid OpenCode endpoint cursor")))
          (if (not e) (js-object :items (js-array) :complete t :coverage "covered" :next_cursor nil)
            (let* ((c (await (funcall connect e context))) (token (nativeGet cursor "native_cursor"))
              (path (str "/api/session?limit=" (Math/min 200 (nativeGet budget "max_records" 100))
                (if token (str "&cursor=" (nativeEncodeURIComponent token)) "&order=desc")))
              (r (await (funcall request c path "GET" nil context))) (wire (nativeGet r "wire"))
              (rows (nativeGet wire "data")) (next (nativeGet (nativeGet wire "cursor") "next"))
              (win (when (nativeGet e "desktop_registry_path") (await (funcall desktop e c (js-object :action "list") context))))
              (items (js-array)))
              (unless (and (nativeGet r "ok") (Array/isArray rows) (not (and next (= next token))))
                (throw (new globalThis.Error "OpenCode session page incompatible")))
              (js-call rows :forEach (lambda (row)
                (when (and (= (nativeGet row "projectID") (nativeGet e "native_namespace"))
                  (= (nativeGet (nativeGet row "location") "directory") (nativeGet e "directory")))
                  (let ((opened (and win (js-call (nativeGet win "tabs") :some (lambda (tab)
                    (and (= (nativeGet tab "id") (nativeGet row "id")) (= (nativeGet tab "endpoint") (nativeGet c "url"))
                      (= (nativeGet tab "serverKey") (nativeGet e "server_key"))))))))
                    (when (or (not (js-call (nativeGet scope "visibility" (js-array)) :includes "desktop-open")) opened)
                      (js-call items :push (Object/assign (nativeSession e row "unknown" (nativeGet c "epoch") opened) (js-object :capabilities capabilities))))))))
              (js-object :items items :complete (and (not next) (= (1+ index) (js-length selected))) :coverage "covered"
                :next_cursor (cond (next (js-object :endpoint_index index :native_cursor next))
                  ((< (1+ index) (js-length selected)) (js-object :endpoint_index (1+ index))) (t nil))))))))
      (setq readMessages (async (session cursor budget context)
        (let* ((e (funcall endpointFor session)) (c (await (funcall connect e context)))
          (token (nativeGet cursor "native_cursor")) (id (nativeGet session "native_session_id"))
          (r (await (funcall request c (str "/api/session/" (nativeEncodeURIComponent id) "/message?limit="
            (Math/min 200 (nativeGet budget "max_records" 100)) (if token (str "&cursor=" (nativeEncodeURIComponent token)) "&order=desc")) "GET" nil context)))
          (wire (nativeGet r "wire")) (rows (nativeGet wire "data")) (next (nativeGet (nativeGet wire "cursor") "next"))
          (items (js-array)) (bytes 0))
          (unless (and (nativeGet r "ok") (Array/isArray rows) (not (and next (= next token)))
            (not (and cursor (not (= (nativeGet cursor "native_session_id") id)))))
            (throw (new globalThis.Error "OpenCode message page incompatible")))
          (js-call rows :forEach (lambda (row)
            (unless (and (= (nativeTypeOf (nativeGet row "id")) "string") (= (nativeTypeOf (nativeGet row "type")) "string"))
              (throw (new globalThis.Error "OpenCode native message incompatible")))
            (when (js-call (js-array "user" "assistant") :includes (nativeGet row "type"))
              (let* ((text (if (= (nativeGet row "type") "user") (nativeGet row "text" "")
                (js-call (js-call (js-call (nativeGet row "content" (js-array)) :filter (lambda (part) (= (nativeGet part "type") "text")))
                  :map (lambda (part) (nativeGet part "text" ""))) :join "\n")))
                (item (js-object :native_message_id (nativeGet row "id") :role (nativeGet row "type") :text text)))
                (setq bytes (+ bytes (utf8Bytes (JSON/stringify item)))) (js-call items :push item)))))
          (when (> bytes (nativeGet budget "max_bytes" 1048576)) (throw (new globalThis.Error "OpenCode message budget exceeded")))
          (js-object :items items :complete (not next) :coverage "covered"
            :next_cursor (if next (js-object :native_session_id id :native_cursor next) nil)))))
      (js-object :capabilities capabilities :initialize (lambda (context) (setq closed false)) :close (lambda () (setq closed t))
        :probe probe
        :listSessions (async (scope cursor budget context)
          (try (await (funcall listSessions scope cursor budget context))
            (catch invalid (js-object :items (js-array) :complete false :coverage "partial" :next_cursor nil))))
        :readMessages (async (session cursor budget context)
          (try (await (funcall readMessages session cursor budget context))
            (catch invalid (js-object :items (js-array) :complete false :coverage "partial" :next_cursor nil))))
        :probeInstance (async (instance context)
          (try (let* ((e (funcall endpointFor instance)) (c (await (funcall connect e context))))
            (js-object :state "ready" :native_namespace (nativeGet e "native_namespace") :instance_epoch (nativeGet c "epoch") :evidence_level "native_protocol"))
            (catch invalid (js-object :state "offline" :evidence_level "none"))))
        :discover (async (scope page context)
          (await (funcall listSessions (js-object :instance_ids (js-array (nativeGet page "instance_id")) :visibility (js-array scope))
            (nativeGet page "cursor") (js-object :max_records 100) context)))
        :submit (async (binding envelope mode key context)
          (let ((sent false))
            (try
              (unless (js-call (js-array "start_idle" "steer") :includes mode) (throw (new globalThis.Error "unsupported OpenCode delivery mode")))
              (let* ((observation (await (funcall probe binding binding context))) (e (funcall endpointFor binding)))
                (unless (and (nativeGet observation "live_receiver") (= (nativeGet observation "instance_epoch") (nativeGet binding "instance_epoch"))
                  (or (= (nativeGet observation "runtime_state") "idle") (= mode "steer")))
                  (throw (new globalThis.Error "OpenCode not sendable")))
                (let* ((c (await (funcall connect e context))) (input (encodeAgentInput "opencode" envelope key))
                  (body (Object/assign (js-object :delivery "steer") (nativeGet input "value"))))
                  (when (> (nativeGet input "frame_bytes") 262144) (throw (new globalThis.Error "OpenCode input limit")))
                  (setq sent t)
                  (let* ((r (await (funcall request c (str "/api/session/" (nativeEncodeURIComponent (nativeGet binding "native_session_id")) "/prompt") "POST" body context)))
                    (receipt (nativeGet (nativeGet r "wire") "data")))
                    (cond ((and (nativeGet r "ok") (= (nativeGet receipt "id") (openCodeMessageId key))
                      (= (nativeGet receipt "sessionID") (nativeGet binding "native_session_id")) (= (nativeGet receipt "delivery") "steer"))
                      (js-object :state "accepted" :kind "accepted" :native_ref (nativeGet receipt "id") :evidence_level "native_protocol"))
                      ((js-call (js-array 400 401 403 404 409 413 422 429) :includes (nativeGet r "status"))
                        (js-object :state "failed" :definite_not_sent t :retryable (= (nativeGet r "status") 429)))
                      (t (js-object :state "unknown" :definite_not_sent false))))))
              (catch invalid (js-object :state (if sent "unknown" "failed") :definite_not_sent (not sent) :retryable (not sent))))))
        :lookup (async (binding key ref context)
          (try
          (let* ((e (funcall endpointFor binding)) (c (await (funcall connect e context))) (id (or ref (openCodeMessageId key)))
            (r (await (funcall request c (str "/api/session/" (nativeEncodeURIComponent (nativeGet binding "native_session_id")) "/inbox") "GET" nil context)))
            (rows (nativeGet (nativeGet r "wire") "data"))
            (found (and (nativeGet r "ok") (Array/isArray rows) (js-call rows :some (lambda (row)
              (and (= (nativeGet row "id") id) (= (nativeGet row "sessionID") (nativeGet binding "native_session_id"))))))))
            (unless found
              (let ((page (await (funcall readMessages binding nil (js-object :max_records 200 :max_bytes 1048576) context))))
                (setq found (js-call (nativeGet page "items") :some (lambda (row)
                  (and (= (nativeGet row "native_message_id") id) (= (nativeGet row "role") "user")))))))
            (if found (js-object :state "accepted" :kind "accepted" :native_ref id :evidence_level "native_protocol")
              (js-object :state "unknown" :definite_not_sent false)))
          (catch unavailable (js-object :state "unknown" :status "not_proven" :definite_not_sent false))))
        :observe (async (binding ref cursor budget context) (js-object :items (js-array) :complete t :next_cursor nil))
        :create (async (instance workspace key context)
          (let ((created nil))
            (try
              (let* ((e (funcall endpointFor instance)) (c (await (funcall connect e context)))
                (selection (nativeGet context "model_selection")) (model nil))
                (when selection
                  (let* ((r (await (funcall request c (str "/api/model?location[directory]=" (nativeEncodeURIComponent (nativeGet e "directory"))) "GET" nil context)))
                    (rows (nativeGet (nativeGet r "wire") "data"))
                    (found (and (nativeGet r "ok") (Array/isArray rows) (js-call rows :find (lambda (row)
                      (and (= (nativeGet row "providerID") (nativeGet selection "provider_id"))
                        (= (nativeGet row "id") (nativeGet selection "model_id"))))))))
                    (unless (and found (or (not (nativeGet selection "variant"))
                      (js-call (nativeGet found "variants" (js-array)) :some (lambda (v) (= (nativeGet v "id") (nativeGet selection "variant"))))))
                      (throw (new globalThis.Error "OpenCode exact model unavailable")))
                    (setq model (js-object :providerID (nativeGet selection "provider_id") :id (nativeGet selection "model_id")))
                    (when (nativeGet selection "variant") (put model :variant (nativeGet selection "variant")))))
                (unless (= workspace (nativeGet e "workspace_ref")) (throw (new globalThis.Error "OpenCode workspace mismatch")))
                (if (nativeGet e "desktop_registry_path")
                  (let ((win (await (funcall desktop e c (js-object :action "create" :directory (nativeGet e "directory") :title (nativeGet context "title") :model model) context))))
                    (setq created (nativeGet win "created"))
                    (unless (= (nativeGet created "desktopRegistered") t) (throw (new globalThis.Error "OpenCode desktop registration incomplete"))))
                  (let* ((location (await (funcall request c (str "/api/location?location[directory]=" (nativeEncodeURIComponent (nativeGet e "directory"))) "GET" nil context)))
                    (checked (and (nativeGet location "ok") (= (nativeGet (nativeGet (nativeGet location "wire") "project") "id") (nativeGet e "native_namespace")))))
                    (unless checked (throw (new globalThis.Error "OpenCode resolved project mismatch")))
                    (let ((body (js-object :location (js-object :directory (nativeGet e "directory")))))
                      (when (nativeGet context "title") (put body :title (nativeGet context "title")))
                      (when model (put body :model model))
                      (let ((r (await (funcall request c "/api/session" "POST" body context))))
                      (setq created (nativeGet (nativeGet r "wire") "data"))))))
                (js-object :state "ready" :creation_key key :session (nativeSession e created "idle" (nativeGet c "epoch") (not (not (nativeGet e "desktop_registry_path")))) :evidence_level "native_protocol"))
              (catch invalid (js-object :state "unknown" :native_ref (nativeGet created "id") :definite_not_sent false)))))
        :lookupCreate (async (instance key ref context)
          (if (not ref) (js-object :state "unknown" :definite_not_sent false)
            (try
              (let* ((e (funcall endpointFor instance)) (c (await (funcall connect e context)))
                (row (if (nativeGet e "desktop_registry_path")
                  (nativeGet (await (funcall desktop e c (js-object :action "register" :thread ref :directory (nativeGet e "directory")) context)) "created")
                  (nativeGet (nativeGet (await (funcall request c (str "/api/session/" (nativeEncodeURIComponent ref)) "GET" nil context)) "wire") "data"))))
                (unless (and (= (nativeGet row "id") ref)
                  (or (not (nativeGet e "desktop_registry_path")) (= (nativeGet row "desktopRegistered") t)))
                  (throw (new globalThis.Error "OpenCode creation recovery not confirmed")))
                (js-object :state "ready" :creation_key key
                  :session (nativeSession e row "idle" (nativeGet c "epoch") (not (not (nativeGet e "desktop_registry_path"))))
                  :evidence_level "native_protocol"))
              (catch unavailable (js-object :state "unknown" :native_ref ref :definite_not_sent false)))))
        :start (async (profile token context) (js-object :state "failed" :definite_not_sent t :reason "existing_receiver_only"))
        :stop (async (instance token deadline context) (js-object :state "unknown" :absence_verified false :definite_not_sent t :reason "existing_receiver_only")))))
  (export createOpenCodePort nativeSession))
