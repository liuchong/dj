(module dj.adapters.agent.pi-rpc
  (import "../../core/native.eli" nativeTypeOf nativeClearTimeout nativeSetTimeout nativeGet)
  (import "node:crypto" randomUUID)
  (import "../../core/errors.eli" success failure)
  (import "../../core/types.eli" utf8Bytes isUtcTime)
  (import "../../core/limits.eli" limits)
  (import "../../delivery/envelope.eli" encodeAgentInput renderEnvelope)
  (defun channelFailure
    (code definite &optional reason)
    (Object/assign
      (failure
        code
        (js-object
          :effect_state
          (if definite "none" "unknown")
          :details
          (if reason (js-object :reason reason) (js-object))))
      (js-object :definite_not_sent definite)))
  (defun createPiChannel
    (io options)
    (let*
      ((maximum (nativeGet options "max_frame_bytes" (nativeGet limits "native_frame_max_bytes")))
        (drain-timeout
          (nativeGet options "drain_timeout_ms" (* 1000 (nativeGet limits "frame_drain_seconds"))))
        (clock (nativeGet io "clock"))
        (pending (new globalThis.Map))
        (events (js-array))
        (buffer (Buffer/alloc 0))
        (state "open")
        (discard-since nil)
        (oversized 0)
        (event-bytes 0)
        (nonce (randomUUID))
        (sequence 0))
      (let
        ((settle nil) (isolate nil) (oversizedFrame nil) (consumeFrame nil) (feed nil))
        (setq
          settle
          (lambda
            (record result)
            (when (= (js-call pending :get (nativeGet record "id")) record)
              (js-call pending :delete (nativeGet record "id"))
              (when (nativeGet record "timer") (nativeClearTimeout (nativeGet record "timer")))
              (when (nativeGet record "signal")
                (js-call
                  (nativeGet record "signal")
                  :removeEventListener
                  "abort"
                  (nativeGet record "abort")))
              (funcall (nativeGet record "resolve") result))))
        (setq
          isolate
          (lambda
            (reason)
            (setq state "isolated" buffer (Buffer/alloc 0) discard-since nil)
            (js-call
              (Array/from (js-call pending :values))
              :forEach
              (lambda
                (record)
                (settle
                  record
                  (channelFailure
                    "unavailable"
                    (not (nativeGet record "write_started"))
                    reason))))))
        (setq
          oversizedFrame
          (lambda
            ()
            (setq oversized (1+ oversized) buffer (Buffer/alloc 0))
            (if (> (nativeGet pending "size") 0)
              (isolate "ambiguous_oversized_frame")
              (setq state "discarding" discard-since (js-call clock :monoNow)))))
        (setq
          consumeFrame
          (lambda
            (bytes)
            (let ((djReturn1Token (js-object)) (djReturn1Value nil))
              (try
                (let ((size (js-length bytes)))
                  (when (and (> size 0) (= (aref bytes (1- size)) 13))
                    (setq bytes (js-call bytes :subarray 0 (1- size))))
                  (when (= (js-length bytes) 0)
                    (progn (setq djReturn1Value nil) (throw djReturn1Token)))
                  (try
                    (let*
                      (
                        (text
                          (js-call
                            (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
                            :decode
                            bytes))
                        (wire (JSON/parse text))
                        (type (nativeGet wire "type")))
                      (unless
                        (and
                          wire
                          (= (nativeTypeOf wire) "object")
                          (= (nativeTypeOf type) "string"))
                        (isolate "invalid_native_record")
                        (progn (setq djReturn1Value nil) (throw djReturn1Token)))
                      (if (= type "response")
                        (let ((record (js-call pending :get (nativeGet wire "id"))))
                          (when record
                            (unless
                              (and
                                (= (nativeGet wire "command") (nativeGet record "command"))
                                (= (nativeTypeOf (nativeGet wire "success")) "boolean"))
                              (isolate "response_command_mismatch")
                              (progn (setq djReturn1Value nil) (throw djReturn1Token)))
                            (settle
                              record
                              (if (= (nativeGet wire "success") t)
                                (Object/assign
                                  (success
                                    (nativeGet wire "data" (js-object))
                                    (js-object :evidence_level "native_protocol"))
                                  (js-object :native_request_id (nativeGet record "id")))
                                (Object/assign
                                  (channelFailure "unavailable" t "native_refused")
                                  (js-object
                                    :evidence_level
                                    "native_protocol"
                                    :native_request_id
                                    (nativeGet record "id")))))))
                        (if
                          (or
                            (>= (js-length events) 1024)
                            (> (+ event-bytes (js-length bytes)) (* 4 maximum)))
                          (isolate "native_event_backlog_full")
                          (progn
                            (js-call events :push wire)
                            (setq event-bytes (+ event-bytes (js-length bytes)))))))
                    (catch malformed
                      (when (eq malformed djReturn1Token) (throw malformed))
                      (isolate "malformed_native_record"))))
                (catch djReturn1Error
                  (if (eq djReturn1Error djReturn1Token)
                    djReturn1Value
                    (throw djReturn1Error)))))))
        (setq
          feed
          (lambda
            (chunk)
            (let ((djReturn2Token (js-object)) (djReturn2Value nil))
              (try
                (when (js-call (js-array "isolated" "closed") :includes state)
                  (progn (setq djReturn2Value nil) (throw djReturn2Token)))
                (let*
                  (
                    (bytes
                      (if (= (nativeTypeOf chunk) "string")
                        (Buffer/from chunk "utf8")
                        (Buffer/from chunk)))
                    (start 0)
                    (size (js-length bytes)))
                  (while
                    (and
                      (< start size)
                      (not (js-call (js-array "isolated" "closed") :includes state)))
                    (let*
                      ((lf (js-call bytes :indexOf 10 start))
                        (end (if (< lf 0) size lf))
                        (part (js-call bytes :subarray start end)))
                      (if (= state "discarding")
                        (when (>= lf 0) (setq state "open" discard-since nil))
                        (if
                          (>
                            (+ (js-length buffer) (js-length part) (if (>= lf 0) 1 0))
                            maximum)
                          (progn
                            (oversizedFrame)
                            (when (and (= state "discarding") (>= lf 0))
                              (setq state "open" discard-since nil)))
                          (progn
                            (setq buffer (Buffer/concat (js-array buffer part)))
                            (when (>= lf 0)
                              (let ((frame buffer))
                                (setq buffer (Buffer/alloc 0))
                                (consumeFrame frame))))))
                      (setq start (if (< lf 0) size (1+ lf))))))
                (catch djReturn2Error
                  (if (eq djReturn2Error djReturn2Token)
                    djReturn2Value
                    (throw djReturn2Error)))))))
    (let ((request nil))
      (setq
        request
        (async
          (command args &optional context)
          (let ((djReturn3Token (js-object)) (djReturn3Value nil))
            (try
              (unless (= state "open")
                (progn
                  (setq
                    djReturn3Value
                    (channelFailure "unavailable" t "channel_not_ready"))
                  (throw djReturn3Token)))
              (when (>= (nativeGet pending "size") 128)
                (progn
                  (setq
                    djReturn3Value
                    (channelFailure "limit_exceeded" t "pending_request_limit"))
                  (throw djReturn3Token)))
              (setq sequence (1+ sequence))
              (let*
                ((id (nativeGet context "wire_id" (str "pi_" nonce "_" sequence)))
                  (wire
                    (Object/assign (js-object) args (js-object :id id :type command)))
                  (text
                    (str
                      (js-call
                        (js-call (JSON/stringify wire) :replaceAll "\u2028" "\\u2028")
                        :replaceAll
                        "\u2029"
                        "\\u2029")
                      "\n"))
                  (deadline (nativeGet context "deadline" (+ (js-call clock :monoNow) 15000)))
                  (signal (nativeGet context "abort_signal"))
                  (record nil)
                  (answer nil))
                (when
                  (or
                    (> (utf8Bytes text) maximum)
                    (> (utf8Bytes text) (nativeGet context "max_frame_bytes" maximum)))
                  (progn
                    (setq
                      djReturn3Value
                      (channelFailure "limit_exceeded" t "native_input_frame"))
                    (throw djReturn3Token)))
                (when
                  (or
                    (<= deadline (js-call clock :monoNow))
                    (= (nativeGet signal "aborted") t))
                  (progn
                    (setq djReturn3Value (channelFailure "unavailable" t "deadline"))
                    (throw djReturn3Token)))
                (when (js-call pending :has id)
                  (progn
                    (setq
                      djReturn3Value
                      (channelFailure
                        "idempotency_conflict"
                        t
                        "native_request_id_in_use"))
                    (throw djReturn3Token)))
                (setq
                  answer
                  (new
                    globalThis.Promise
                    (lambda
                      (resolve reject)
                      (setq
                        record
                        (js-object
                          :id
                          id
                          :command
                          command
                          :deadline
                          deadline
                          :resolve
                          resolve
                          :write_started
                          false
                          :signal
                          signal
                          :timer
                          nil
                          :abort
                          nil)))))
                (put
                  record
                  :abort
                  (lambda
                    ()
                    (settle
                      record
                      (channelFailure
                        "unavailable"
                        (not (nativeGet record "write_started"))
                        "request_aborted"))))
                (js-call pending :set id record)
                (put
                  record
                  :timer
                  (nativeSetTimeout
                    (lambda
                      ()
                      (settle
                        record
                        (channelFailure
                          "unavailable"
                          (not (nativeGet record "write_started"))
                          "deadline")))
                    (Math/max 1 (- deadline (js-call clock :monoNow)))))
                (when signal
                  (js-call
                    signal
                    :addEventListener
                    "abort"
                    (nativeGet record "abort")
                    (js-object :once t)))
                ;; Register the pending record before writing: a native peer may
                ;; respond synchronously while the pipe's flush is still pending.
                (put record :write_started t)
                (try
                  (let ((writing (funcall (nativeGet io "write") text)))
                    (js-call
                      (Promise/resolve writing)
                      :catch
                      (lambda
                        (error)
                        (settle
                          record
                          (channelFailure "unavailable" false "write_outcome_unknown")))))
                  (catch write-failed
                    (when (eq write-failed djReturn3Token) (throw write-failed))
                    (settle
                      record
                      (channelFailure "unavailable" false "write_outcome_unknown"))))
                (await answer))
              (catch djReturn3Error
                (if (eq djReturn3Error djReturn3Token)
                  djReturn3Value
                  (throw djReturn3Error)))))))
      (js-object
        :request
        request
        :feed
        feed
        :tick
        (async
          ()
          (let ((now (js-call clock :monoNow)))
            (when (and (= state "discarding") (>= (- now discard-since) drain-timeout))
              (isolate "oversized_drain_timeout"))
            (js-call
              (Array/from (js-call pending :values))
              :forEach
              (lambda
                (record)
                (when (<= (nativeGet record "deadline") now)
                  (settle
                    record
                    (channelFailure
                      "unavailable"
                      (not (nativeGet record "write_started"))
                      "deadline")))))))
        :drainEvents
        (lambda
          ()
          (let ((result (js-call events :splice 0))) (setq event-bytes 0) result))
        :status
        (lambda
          ()
          (js-object
            :state
            state
            :buffered_bytes
            (js-length buffer)
            :oversized_frames
            oversized
            :pending_requests
            (nativeGet pending "size")
            :queued_events
            (js-length events)))
        :end
        (lambda
          ()
          (when (> (js-length buffer) 0) (isolate "truncated_native_frame"))
          (when (> (nativeGet pending "size") 0) (isolate "native_stream_ended"))
          (unless (= state "isolated") (setq state "closed")))
        :close
        (lambda
          ()
          (if (> (nativeGet pending "size") 0)
            (js-object :state "draining")
            (progn (setq state "closed") (js-object :state "stopped")))))))))
  (defun piRuntimeState
    (state)
    (cond ((= (nativeGet state "waitingPermission") t) "waiting_permission")
      (
        (or
          (= (nativeGet state "isStreaming") t)
          (= (nativeGet state "isCompacting") t)
          (and
            (Number/isSafeInteger (nativeGet state "pendingMessageCount"))
            (> (nativeGet state "pendingMessageCount") 0)))
        "busy")
      (
        (and
          (= (nativeGet state "isStreaming") false)
          (= (nativeGet state "isCompacting") false)
          (= (nativeGet state "pendingMessageCount") 0))
        "idle")
      (t "unknown")))
  (defun piSession
    (record native)
    (unless
      (and
        (= (nativeTypeOf (nativeGet native "sessionId")) "string")
        (> (js-length (nativeGet native "sessionId")) 0))
      (throw (new globalThis.TypeError "Pi did not report a native session identity")))
    (let ((profile (nativeGet record "profile")))
      (js-object
        :tool
        "pi"
        :native_namespace
        (nativeGet profile "native_namespace" (str "pi:" (nativeGet profile "profile_id")))
        :native_session_id
        (nativeGet native "sessionId")
        :instance_id
        (nativeGet record "instance_id")
        :instance_epoch
        (nativeGet record "instance_epoch")
        :workspace_ref
        (aref (nativeGet profile "workspace_refs") 0)
        :title
        (nativeGet native "sessionName" "")
        :runtime_state
        (piRuntimeState native)
        :live_receiver
        t
        :visibility
        (js-array "live" "managed")
        :coverage
        "current_session_only")))
  (defun createPiPort
    (config host)
    (let ((managed (new globalThis.Map))
        (by-instance (new globalThis.Map))
        (capabilities
          (js-object
            :session_list
            "supported"
            :session_messages
            "supported"
            :session_probe
            "supported"
            :session_send
            "supported"
            :session_create
            "unsupported"
            :start_idle
            "supported"
            :managed_rpc
            "supported"
            :instance_start
            "supported"
            :instance_stop
            "supported"
            :native_idempotency
            "unsupported"
            :lookup_send
            "unsupported"
            :observe
            "supported"
            :max_input_frame_bytes
            (nativeGet limits "native_frame_max_bytes"))))
(let ((exactRecord nil) (recordEvents nil) (stateOf nil) (pumpOutput nil) (pumpErrors nil) (inspectInstance nil) (start nil) (probe nil) (listSessions nil) (readMessages nil) (submit nil) (observe nil) (stop nil))


(setq exactRecord (lambda
            (target)
            (let ((djReturn4Token (js-object)) (djReturn4Value nil))
              (try
                (let ((record (js-call by-instance :get (nativeGet target "instance_id"))))
                  (unless
                    (and
                      record
                      (= (nativeGet record "instance_epoch") (nativeGet target "instance_epoch"))
                      (or
                        (not (nativeGet target "native_namespace"))
                        (=
                          (nativeGet target "native_namespace")
                          (nativeGet (nativeGet record "session") "native_namespace")))
                      (or
                        (not (nativeGet target "native_session_id"))
                        (=
                          (nativeGet target "native_session_id")
                          (nativeGet (nativeGet record "session") "native_session_id"))))
                    (progn (setq djReturn4Value nil) (throw djReturn4Token)))
                  record)
                (catch djReturn4Error
                  (if (eq djReturn4Error djReturn4Token)
                    djReturn4Value
                    (throw djReturn4Error)))))))
(setq recordEvents (lambda
            (record)
            (let ((events (js-call (nativeGet record "channel") :drainEvents)))
              (js-call
                events
                :forEach
                (lambda
                  (event)
                  (let ((djReturn5Token (js-object)) (djReturn5Value nil))
                    (try
                      (when
                        (and
                          (= (nativeGet event "type") "agent_end")
                          (= (nativeGet event "willRetry") t))
                        (put record :pending_retry t))
                      (when (= (nativeGet event "type") "agent_settled")
                        (put record :pending_retry false))
                      (let* ((type (nativeGet event "type")) (kind
                            (cond ((= type "agent_start") "started")
                              ((= type "agent_end") "ended")
                              ((= type "agent_settled") "settled")
                              ((= type "turn_end") "turn_finished")
                              (t nil))))
                        (when kind
                          (let ((facts (nativeGet record "facts")))
                            (when (>= (js-length facts) 1024)
                              (put record :observation_overflow t)
                              (progn (setq djReturn5Value nil) (throw djReturn5Token)))
                            (put record :event_seq (1+ (nativeGet record "event_seq" 0)))
                            (js-call
                              facts
                              :push
                              (js-object
                                :kind
                                kind
                                :native_ref
                                (nativeGet record "current_ref" nil)
                                :native_receipt_key
                                (str
                                  (nativeGet record "launch_token")
                                  ":event:"
                                  (nativeGet record "event_seq"))
                                :evidence_level
                                "native_protocol"))
                            (when (= kind "settled")
                              (put record :settled_ref (nativeGet record "current_ref" nil))
                              (put record :current_ref nil)))))
                      (catch djReturn5Error
                        (if (eq djReturn5Error djReturn5Token)
                          djReturn5Value
                          (throw djReturn5Error))))))))))
(setq stateOf (async
          (record context)
          (let ((djReturn6Token (js-object)) (djReturn6Value nil))
            (try
              (when (nativeGet record "exited")
                (progn
                  (setq djReturn6Value (failure "target_offline"))
                  (throw djReturn6Token)))
              (let ((response
                    (await
                      (js-call
                        (nativeGet record "channel")
                        :request
                        "get_state"
                        (js-object)
                        context))))
                (unless (nativeGet response "ok")
                  (progn (setq djReturn6Value response) (throw djReturn6Token)))
                (let ((session (piSession record (nativeGet response "data"))))
                  (when
                    (and
                      (nativeGet record "session")
                      (not
                        (=
                          (nativeGet session "native_session_id")
                          (nativeGet (nativeGet record "session") "native_session_id"))))
                    (put record :identity_changed t)
                    (progn
                      (setq djReturn6Value (failure "stale_reference"))
                      (throw djReturn6Token)))
                  (put session :capabilities capabilities)
                  (put record :session session)
                  (recordEvents record)
                  (when (nativeGet record "pending_retry") (put session :runtime_state "busy"))
                  (success session)))
              (catch djReturn6Error
                (if (eq djReturn6Error djReturn6Token)
                  djReturn6Value
                  (throw djReturn6Error)))))))
(setq pumpOutput (async
          (record stream)
          (let ((reader (js-call stream :getReader)))
            (try
              (let ((done false))
                (while (not done)
                  (let ((part (await (js-call reader :read))))
                    (setq done (nativeGet part "done"))
                    (unless done
                      (js-call (nativeGet record "channel") :feed (nativeGet part "value"))
                      (recordEvents record)))))
              (catch unavailable (put record :pipe_error t))
              (finally
                (js-call reader :releaseLock)
                (js-call (nativeGet record "channel") :end))))))
(setq pumpErrors (async
          (record stream)
          (let ((reader (js-call stream :getReader)))
            (try
              (let ((done false))
                (while (not done)
                  (let ((part (await (js-call reader :read))))
                    (setq done (nativeGet part "done"))
                    (unless done
                      (put
                        record
                        :stderr_bytes
                        (+ (nativeGet record "stderr_bytes" 0) (js-length (nativeGet part "value"))))))))
              (catch unavailable (put record :pipe_error t))
              (finally (js-call reader :releaseLock))))))
(setq inspectInstance (async
          (instance token context)
          (let ((djReturn7Token (js-object)) (djReturn7Value nil))
            (try
              (let ((record (js-call managed :get token)))
                (unless
                  (and
                    record
                    (= (nativeGet record "instance_id") (nativeGet instance "instance_id"))
                    (= (nativeGet record "instance_epoch") (nativeGet instance "instance_epoch")))
                  (progn
                    (setq
                      djReturn7Value
                      (js-object :state "unknown" :absence_verified false))
                    (throw djReturn7Token)))
                (when (nativeGet record "exited")
                  (progn
                    (setq
                      djReturn7Value
                      (js-object
                        :state
                        "stopped"
                        :absence_verified
                        t
                        :evidence_level
                        "native_protocol"
                        :launch_token
                        token))
                    (throw djReturn7Token)))
                (let ((observation (await (stateOf record context))))
                  (if (nativeGet observation "ok")
                    (js-object
                      :state
                      "ready"
                      :ownership
                      "managed"
                      :launch_token
                      token
                      :native_instance_id
                      (str "pi-owned:" token)
                      :initial_session
                      (nativeGet observation "data")
                      :absence_verified
                      false
                      :evidence_level
                      "native_protocol")
                    (js-object
                      :state
                      "unknown"
                      :launch_token
                      token
                      :absence_verified
                      false))))
              (catch djReturn7Error
                (if (eq djReturn7Error djReturn7Token)
                  djReturn7Value
                  (throw djReturn7Error)))))))
(setq start (async
          (profile token context)
          (let ((djReturn8Token (js-object)) (djReturn8Value nil))
            (try
              (when (js-call managed :has token)
                (progn
                  (setq djReturn8Value (await (inspectInstance profile token context)))
                  (throw djReturn8Token)))
              (let* ((trusted
                    (js-call
                      (nativeGet config "profiles" (js-array))
                      :find
                      (lambda
                        (candidate)
                        (and
                          (= (nativeGet candidate "profile_id") (nativeGet profile "profile_id"))
                          (= (nativeGet candidate "revision") (nativeGet profile "revision")))))) (instance-id (nativeGet profile "instance_id" (nativeGet profile "profile_id"))) (epoch (nativeGet profile "instance_epoch" token)))
                (unless
                  (and
                    trusted
                    (Array/isArray (nativeGet trusted "argv"))
                    (> (js-length (nativeGet trusted "workspace_refs")) 0))
                  (progn
                    (setq
                      djReturn8Value
                      (js-object :state "failed" :definite_not_sent t))
                    (throw djReturn8Token)))
                (when (js-call by-instance :has instance-id)
                  (progn
                    (setq
                      djReturn8Value
                      (js-object :state "unknown" :absence_verified false))
                    (throw djReturn8Token)))
                (let* ((child
                      (js-call
                        (nativeGet host "process")
                        :spawn
                        (nativeGet trusted "argv")
                        (js-object
                          :cwd
                          (nativeGet trusted "cwd")
                          :env
                          (nativeGet trusted "env")
                          :launch_token
                          token
                          :stdin
                          "pipe"
                          :stdout
                          "pipe"
                          :stderr
                          "pipe"))) (record
                      (js-object
                        :profile
                        trusted
                        :child
                        child
                        :instance_id
                        instance-id
                        :instance_epoch
                        epoch
                        :launch_token
                        token
                        :exited
                        false
                        :facts
                        (js-array)
                        :inputs
                        (new globalThis.Map)
                        :event_seq
                        0)) (channel
                      (createPiChannel
                        (js-object
                          :clock
                          (nativeGet host "clock")
                          :write
                          (async
                            (text)
                            (when (nativeGet record "stdin_closed")
                              (throw
                                (new globalThis.Error "owned Pi input stream is closed")))
                            (let ((written (js-call (nativeGet child "stdin") :write text)))
                              (await (Promise/resolve written))
                              (when (nativeGet (nativeGet child "stdin") "flush")
                                (await (js-call (nativeGet child "stdin") :flush))))))
                        (js-object
                          :max_frame_bytes
                          (nativeGet limits "native_frame_max_bytes")
                          :drain_timeout_ms
                          5000))))
                  (put record :channel channel)
                  (js-call managed :set token record)
                  (js-call by-instance :set instance-id record)
                  (put record :stdout_task (pumpOutput record (nativeGet child "stdout")))
                  (put record :stderr_task (pumpErrors record (nativeGet child "stderr")))
                  (js-call
                    (nativeGet child "exited")
                    :then
                    (lambda
                      (code)
                      (put record :exited t)
                      (put record :exit_code code)
                      (js-call channel :end)))
                  (let ((report
                        (await
                          (inspectInstance
                            (js-object :instance_id instance-id :instance_epoch epoch)
                            token
                            context))))
                    report)))
              (catch djReturn8Error
                (if (eq djReturn8Error djReturn8Token)
                  djReturn8Value
                  (throw djReturn8Error)))))))
(setq probe (async
          (target binding context)
          (let ((djReturn9Token (js-object)) (djReturn9Value nil))
            (try
              (let ((record (exactRecord binding)))
                (unless record
                  (progn
                    (setq
                      djReturn9Value
                      (js-object :runtime_state "offline" :live_receiver false))
                    (throw djReturn9Token)))
