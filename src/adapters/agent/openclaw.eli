(module dj.adapters.agent.openclaw
  (import "../../core/native.eli" nativeGet nativeTypeOf)
  (import "../../core/types.eli" hashValue)
  (import "node:path" isAbsolute)

  (defun nonempty (value)
    (and (= (nativeTypeOf value) "string") (> (js-length value) 0)))

  (defun openClawToken (value)
    (if (= (nativeTypeOf value) "string") value
      (nativeGet (nativeGet (nativeGet value "gateway") "auth") "token")))

  (defun identity (row)
    (let ((id (nativeGet row "sessionId")) (key (nativeGet row "key")))
      (when (and (nonempty id) (nonempty key) (not (nativeGet row "archived"))) id)))

  (defun projectRow (row)
    (let* ((directory (nativeGet row "workspaceDir" nil))
      (busy (nativeGet row "hasActiveRun"))
      (reason (nativeGet row "sendDisabledReason")))
      (js-object :id (identity row) :key (nativeGet row "key")
        :title (or (nativeGet row "label") (nativeGet row "displayName") "")
        :directory (if (and (nonempty directory) (isAbsolute directory)) directory nil)
        :project_id (nativeGet row "projectId" nil)
        :model_id (nativeGet row "model" nil) :provider_id (nativeGet row "modelProvider" nil)
        :live_receiver (not (nonempty reason))
        :runtime_state (cond ((nonempty reason) "offline") (busy "busy") (t "idle")))))

  (defasync page (channel cursor limit context)
    (let* ((result (await (js-call channel :request "sessions.list"
      (js-object :limit limit :offset (or cursor 0) :archived false :excludeSystem t :excludeCron t :excludeSubagents t)
      context)))
      (rows (nativeGet result "sessions"))
      (next (when (nativeGet result "hasMore") (nativeGet result "nextOffset"))))
      (unless (and (Array/isArray rows)
        (or (not next) (and (Number/isSafeInteger next) (> next (or cursor 0)))))
        (throw (new globalThis.Error "Invalid OpenClaw session page")))
      (js-object :items (js-call (js-call rows :filter identity) :map projectRow) :next next)))

  (defasync describe (channel key id context)
    (let* ((result (await (js-call channel :request "sessions.describe" (js-object :key key) context)))
      (row (nativeGet result "session")))
      (when (and (= (nativeGet row "key") key) (= (identity row) id))
        (projectRow row))))

  (defun createOpenClawProtocol ()
    (let* ((session-keys (new globalThis.WeakMap))
      (index (lambda (channel)
        (or (js-call session-keys :get channel)
          (let ((keys (new globalThis.Map)))
            (js-call session-keys :set channel keys)
            keys))))
      (remember (lambda (channel row)
        (let ((keys (funcall index channel)) (id (nativeGet row "id")))
          (when (> (nativeGet keys "size") 4096) (js-call keys :clear))
          (js-call keys :set id (nativeGet row "key")) row)))
      (lookup (async (channel id context)
        (let* ((keys (funcall index channel))
          (key (js-call keys :get id))
          (current (when key (await (describe channel key id context))))
          (cursor 0) (pages 0))
          (while (and (not current) (not (nil? cursor)) (< pages 100))
            (let* ((batch (await (page channel cursor 100 context)))
              (found (js-call (nativeGet batch "items") :find (lambda (row) (= (nativeGet row "id") id)))))
              (when found
                (setq current (await (describe channel (nativeGet found "key") id context))))
              (setq cursor (nativeGet batch "next" nil) pages (1+ pages))))
          (when current (funcall remember channel current))))))
      (js-object :token openClawToken
        :list (async (channel cursor limit context)
          (let ((result (await (page channel cursor limit context))))
            (js-call (nativeGet result "items") :forEach (lambda (row) (funcall remember channel row)))
            result))
        :inspect lookup
        :create (async (channel directory title selection key context before-send)
          (let ((params (js-object :idempotencyKey key :cwd directory)))
            (when title (put params :displayName title))
            (when (nativeGet selection "variant")
              (throw (new globalThis.TypeError "This gateway does not accept model variant")))
            (when selection
              (put params :model (str (nativeGet selection "provider_id") "/" (nativeGet selection "model_id")))
              (when (nativeGet selection "reasoning_effort")
                (put params :thinkingLevel (nativeGet selection "reasoning_effort"))))
            (let* ((created (await (js-call channel :request "sessions.create" params context before-send)))
              (id (nativeGet created "sessionId")) (key (nativeGet created "key"))
              (row (when (and (= (nativeGet created "ok") t) (nonempty id) (nonempty key))
                (await (describe channel key id context)))))
              (when row (funcall remember channel row)))))
        :rename (async (channel row title context)
          (let* ((key (nativeGet row "key")) (id (nativeGet row "id"))
            (result (await (js-call channel :request "sessions.patch"
              (js-object :key key :expectedSessionId id :label title) context))))
            (when (nativeGet result "ok") (await (describe channel key id context)))))
        :submit (async (channel row text mode key context before-send)
          (let* ((id (str "dj-" (hashValue key)))
            (receipt (await (js-call channel :request "chat.send"
              (js-object :sessionKey (nativeGet row "key") :sessionId (nativeGet row "id")
                :message text :deliver false :queueMode (if (= mode "steer") "steer" "followup")
                :idempotencyKey id) context before-send))))
            (when (and (= (nativeGet receipt "runId") id)
              (js-call (js-array "started" "accepted" "queued" "in_flight" "ok") :includes (nativeGet receipt "status")))
              id)))
        :history (async (channel row cursor limit max-bytes context)
          (let ((params (js-object :sessionKey (nativeGet row "key") :limit limit :maxBytes (Math/max 1024 max-bytes))))
            (when cursor (put params :cursor cursor))
            (let* ((result (await (js-call channel :request "chat.history" params context)))
              (rows (nativeGet result "messages"))
              (next (when (nativeGet result "hasMore") (nativeGet result "olderCursor"))))
              (unless (and (= (nativeGet result "sessionId") (nativeGet row "id")) (Array/isArray rows)
                (or (not (nativeGet result "hasMore")) (and (nonempty next) (not (= next cursor)))))
                (throw (new globalThis.Error "OpenClaw history identity or cursor changed")))
              (js-object :next next :items (js-call rows :map (lambda (message)
                (js-object :id (nativeGet (nativeGet message "__openclaw") "id" nil)
                  :role (nativeGet message "role" nil) :content (nativeGet message "content" nil)))))))))))
  (export createOpenClawProtocol))
