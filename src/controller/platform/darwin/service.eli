(module dj.controller.platform.darwin.service
  (import "../../../core/native.eli" nativeGet NativeNumber)
  (import "../../model.eli" projectStatus)
  (defconst serviceLabel "dev.dispatch-junction.local")
  (defun parseLaunchStatus (result)
    (let ((text (nativeGet result "stdout" "")))
      (if (= (nativeGet result "code") 0)
        (let ((match (js-call text :match (new globalThis.RegExp "(?:^|\\n)\\s*pid = ([0-9]+)"))))
          (js-object :known t :loaded t :pid (if match (NativeNumber (aref match 1)) nil)))
        (if (or (= (nativeGet result "code") 3) (= (nativeGet result "code") 113)
          (js-call (nativeGet result "stderr" "") :includes "Could not find service"))
          (js-object :known t :loaded false :pid nil)
          (js-object :known false :loaded false :pid nil)))))
  (defun createServiceController (options ports)
    (let* ((target (str "gui/" (nativeGet options "uid") "/" serviceLabel))
      (domain (str "gui/" (nativeGet options "uid"))) (in-flight nil) (busy false) (intent nil)
      (deadline 0) (error nil) (error-intent nil) (last nil) (refresh nil))
      (setq refresh (lambda ()
        (or in-flight
          (progn
            (setq in-flight (funcall (async ()
              (try
                (let* ((installed (await (js-call ports :inspectPlist)))
                  (launch (parseLaunchStatus (await (js-call ports :run "launchctl" (js-array "print" target)))))
                  (protocol (await (js-call ports :probe))))
                  (when (or intent error-intent)
                    (cond
                      ((or (and (= (or intent error-intent) "start") (nativeGet protocol "ok") (= (nativeGet (nativeGet protocol "data") "state") "ready"))
                           (and (= (or intent error-intent) "stop") (nativeGet launch "known") (not (nativeGet launch "loaded")) (not (nativeGet protocol "ok"))))
                        (setq intent nil error nil error-intent nil))
                      ((and intent (>= (js-call ports :now) deadline))
                        (setq error-intent intent intent nil error "操作尚未收敛，请检查服务日志后刷新"))))
                  (setq last (projectStatus installed launch protocol intent error)))
                (catch problem
                  (setq last (projectStatus t (js-object :known false) nil nil "无法读取服务状态，请检查登录项和客户端配置"))))
              last)))
            (js-call in-flight :finally (lambda () (setq in-flight nil))) in-flight))))
      (js-object :refresh refresh :action (async (action)
        (when (and (not busy) (not intent) (js-call (js-array "start" "stop") :includes action))
          (setq busy t error nil error-intent nil)
          (try
            (let ((status (await (funcall refresh))))
              (when (nativeGet status (if (= action "start") "can_start" "can_stop"))
                (setq intent action deadline (+ (js-call ports :now) 30000))
                (let* ((enabled (await (js-call ports :run "launchctl" (js-array (if (= action "start") "enable" "disable") target)))))
                  (unless (= (nativeGet enabled "code") 0) (throw (new globalThis.Error "launchctl failed"))))
                (let* ((loaded (parseLaunchStatus (await (js-call ports :run "launchctl" (js-array "print" target)))))
                  (command (if (= action "stop") (js-array "bootout" target)
                    (if (nativeGet loaded "loaded") (js-array "kickstart" target)
                      (js-array "bootstrap" domain (nativeGet options "launch_agent")))))
                  (result (await (js-call ports :run "launchctl" command))))
                  (unless (= (nativeGet result "code") 0) (throw (new globalThis.Error "launchctl failed"))))))
            (catch problem (setq error-intent action intent nil error "服务控制未完成，请检查登录项或服务日志后重试"))
            (finally (setq busy false))))
        (await (funcall refresh))))))
  (export serviceLabel parseLaunchStatus createServiceController))
