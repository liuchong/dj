(module dj.controller.platform.darwin.main
  (import "../../../core/native.eli" nativeGet nativeBitAnd nativeSetInterval nativeClearInterval nativeSetTimeout nativeClearTimeout)
  (import "node:path" resolve dirname)
  (import "node:os" homedir)
  (import "node:fs/promises" lstat)
  (import "node:readline" createInterface)
  (import "../../../interfaces/client.eli" callService)
  (import "./service.eli" serviceLabel createServiceController)
  (defconst commandChildren (new globalThis.Set))
  (defasync runCommand (name args)
    (let* ((executable (Bun/which name)) (child nil) (timer nil) (timed-out false))
      (unless executable (throw (new globalThis.Error "system command unavailable")))
      (setq child (Bun/spawn (js-call (js-array executable) :concat args)
        (js-object :stdin "ignore" :stdout "pipe" :stderr "pipe")))
      (js-call commandChildren :add child)
      (let ((read (async (stream)
        (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder)) (text "") (done false))
          (try
            (while (not done)
              (let ((part (await (js-call reader :read))))
                (setq done (nativeGet part "done"))
                (unless done (setq text (str text (js-call decoder :decode (nativeGet part "value") (js-object :stream t)))))
                (when (> (js-length text) 65536) (throw (new globalThis.Error "system output limit")))))
            text
            (finally (js-call reader :releaseLock)))))))
        (setq timer (nativeSetTimeout (lambda () (setq timed-out t) (js-call child :kill "SIGKILL")) 10000))
        (try
          (let ((result (await (Promise/all (js-array (nativeGet child "exited") (funcall read (nativeGet child "stdout")) (funcall read (nativeGet child "stderr")))))))
            (when timed-out (throw (new globalThis.Error "system command timeout")))
            (js-object :code (aref result 0) :stdout (aref result 1) :stderr (aref result 2)))
          (finally
            (nativeClearTimeout timer)
            (when (= (nativeGet child "exitCode") nil) (js-call child :kill "SIGKILL"))
            (await (nativeGet child "exited"))
            (js-call commandChildren :delete child))))))
  (defasync runController (root)
    (let* ((launch-agent (resolve (homedir) "Library/LaunchAgents" (str serviceLabel ".plist")))
      (profile (resolve root "client.json")) (timer nil) (closed false)
      (controller (createServiceController (js-object :uid (js-call globalThis.process :getuid) :launch_agent launch-agent)
        (js-object :run runCommand :now (lambda () (Date/now))
          :inspectPlist (async ()
            (try
              (let ((info (await (lstat launch-agent))) (parent (await (lstat (dirname launch-agent)))))
                (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                  (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                  (= (nativeBitAnd (nativeGet info "mode") 18) 0)
                  (not (js-call parent :isSymbolicLink))
                  (= (nativeGet parent "uid") (js-call globalThis.process :getuid))
                  (= (nativeBitAnd (nativeGet parent "mode") 18) 0)) (throw (new globalThis.Error "unsafe launch agent")))
                (let ((result (await (runCommand "plutil" (js-array "-extract" "Label" "raw" "-o" "-" launch-agent)))))
                  (unless (and (= (nativeGet result "code") 0) (= (js-call (nativeGet result "stdout") :trim) serviceLabel))
                    (throw (new globalThis.Error "unexpected service label")))) t)
              (catch problem (if (= (nativeGet problem "code") "ENOENT") false (throw problem)))))
          :probe (async () (await (callService profile "service.status" (js-object) 1))))))
      (emit (lambda (value) (unless closed (js-call (nativeGet globalThis.process "stdout") :write (str (JSON/stringify value) "\n")))))
      (refresh (async () (funcall emit (await (js-call controller :refresh)))))
      (input (createInterface (js-object :input (nativeGet globalThis.process "stdin") :crlfDelay 100))))
      (js-call input :on "line" (lambda (line)
        (when (<= (js-length line) 4096)
          (try
            (let ((action (nativeGet (JSON/parse line) "action")))
              (if (= action "refresh") (funcall refresh)
                (when (js-call (js-array "start" "stop") :includes action)
                  (funcall (async ()
                    (funcall emit (js-object :type "status" :state (if (= action "start") "starting" "stopping")
                      :label (if (= action "start") "启动中" "停止中") :detail "" :can_start false :can_stop false))
                    (funcall emit (await (js-call controller :action action))))))))
            (catch ignored nil)))))
      (js-call input :on "close" (lambda () (setq closed t) (nativeClearInterval timer)
        (js-call commandChildren :forEach (lambda (child) (js-call child :kill "SIGTERM")))
        (js-call globalThis.process :exit 0)))
      (js-call globalThis.process :on "SIGTERM" (lambda () (js-call input :close)))
      (await (funcall refresh))
      (unless closed (setq timer (nativeSetInterval (lambda () (funcall refresh)) 3000)))))
  (when (js-call (nativeGet globalThis.process "argv") :some (lambda (value) (js-call value :endsWith "/darwin/main.mjs")))
    (let* ((args (js-call (nativeGet globalThis.process "argv") :slice 2)) (root (resolve (or (aref args 0) (resolve (homedir) ".dj")))))
      (js-call (runController root) :catch (lambda (error)
        (js-call (nativeGet globalThis.process "stderr") :write "DJ controller could not initialize\n")
        (js-call globalThis.process :exit 1)))))
  (export runCommand runController))
