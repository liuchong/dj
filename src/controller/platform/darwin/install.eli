(module dj.controller.platform.darwin.install
  (import "../../../core/native.eli" nativeGet nativeBitAnd)
  (import "node:fs/promises" mkdir readFile writeFile copyFile chmod lstat realpath rename rm)
  (import "node:path" resolve)
  (import "node:os" homedir)
  (import "node:crypto" randomUUID createHash)
  (import "./main.eli" runCommand)
  (import "../../../interfaces/client.eli" loadClientProfile)
  (defun sha256 (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun xml (value)
    (js-call (js-call (js-call (js-call (str value) :replaceAll "&" "&amp;") :replaceAll "<" "&lt;") :replaceAll ">" "&gt;") :replaceAll "\"" "&quot;"))
  (defun plist (body) (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?><plist version=\"1.0\"><dict>" body "</dict></plist>\n"))
  (defasync installDarwinController (bundle runtime)
    (let* ((user-root (resolve (homedir))) (root (resolve user-root ".dj"))
      (apps nil) (destination nil) (staging nil)
      (agent (resolve user-root "Library/LaunchAgents/dev.dispatch-junction.controller.plist"))
      (service (resolve user-root "Library/LaunchAgents/dev.dispatch-junction.local.plist"))
      (manifest (JSON/parse (await (readFile (resolve bundle "package-manifest.json") "utf8")))))
      (unless (and (= (nativeGet manifest "name") "dispatch-junction") (nativeGet manifest "build_id"))
        (throw (new globalThis.Error "not a DJ directory package")))
      (js-call (js-array "libexec/dj-status-bar" "libexec/darwin/main.mjs" "libexec/dj-mark.icns") :forEach (lambda (name)
        (unless (js-call (nativeGet manifest "files") :some (lambda (file) (= (nativeGet file "path") name)))
          (throw (new globalThis.Error "This package has no controller; choose a package built with --with-controller")))))
      (let ((names (js-array "libexec/dj-status-bar" "libexec/darwin/main.mjs" "libexec/dj-mark.icns")) (index 0))
        (while (< index (js-length names))
          (let* ((name (aref names index)) (row (js-call (nativeGet manifest "files") :find (lambda (f) (= (nativeGet f "path") name)))))
            (unless (= (sha256 (await (readFile (resolve bundle name)))) (nativeGet row "sha256")) (throw (new globalThis.Error "controller asset digest mismatch"))))
          (setq index (1+ index))))
      (let ((directory (await (runCommand (resolve bundle "libexec/dj-status-bar") (js-array "--application-directory")))))
        (unless (= (nativeGet directory "code") 0) (throw (new globalThis.Error "system Applications directory unavailable")))
        (setq apps (js-call (nativeGet directory "stdout") :trim))
        (unless apps (throw (new globalThis.Error "system Applications directory unavailable")))
        (setq destination (resolve apps "DJ Control.app") staging (resolve apps (str ".dj-control-" (randomUUID) ".app"))))
      (let ((info (await (lstat runtime)))) (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))) (throw (new globalThis.Error "invalid Bun runtime"))))
      (let ((info (await (lstat service))))
        (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
          (= (nativeGet info "uid") (js-call globalThis.process :getuid)))
          (throw (new globalThis.Error "unsafe DJ service login item"))))
      (try
        (let ((info (await (lstat agent))))
          (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
            (= (nativeGet info "uid") (js-call globalThis.process :getuid)))
            (throw (new globalThis.Error "unsafe controller login item")))
          (let ((result (await (runCommand "plutil" (js-array "-extract" "Label" "raw" "-o" "-" agent)))))
            (unless (= (js-call (nativeGet result "stdout" "") :trim) "dev.dispatch-junction.controller")
              (throw (new globalThis.Error "existing login item is not DJ controller")))))
        (catch absent (unless (= (nativeGet absent "code") "ENOENT") (throw absent)))) (await (mkdir (resolve root "run") (js-object :recursive t :mode 448)))
      (unless (nativeGet (await (loadClientProfile (resolve root "client.json"))) "ok")
        (throw (new globalThis.Error "DJ private client profile is unavailable")))
      (await (mkdir apps (js-object :recursive t)))
      (let ((info (await (lstat apps))))
        (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
          (or (= (nativeGet info "uid") 0) (= (nativeGet info "uid") (js-call globalThis.process :getuid)))
          (= (nativeBitAnd (nativeGet info "mode") 2) 0))
          (throw (new globalThis.Error "unsafe Applications directory"))))
      (let ((info nil))
        (try (setq info (await (lstat destination)))
          (catch absent (unless (= (nativeGet absent "code") "ENOENT") (throw absent))))
        (when info
          (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
            (= (nativeGet info "uid") (js-call globalThis.process :getuid))
            (= (js-call (await (readFile (resolve destination "Contents/Resources/dj-controller-owner") "utf8")) :trim) "dev.dispatch-junction.controller"))
            (throw (new globalThis.Error "existing app is not owned by DJ controller")))))
      (await (mkdir (resolve staging "Contents/MacOS") (js-object :recursive t)))
      (await (mkdir (resolve staging "Contents/Resources/darwin") (js-object :recursive t)))
      (await (copyFile (resolve bundle "libexec/dj-status-bar") (resolve staging "Contents/MacOS/dj-status-bar")))
      (await (copyFile (resolve bundle "libexec/dj-mark.icns") (resolve staging "Contents/Resources/dj-mark.icns")))
      (await (chmod (resolve staging "Contents/MacOS/dj-status-bar") 493))
      (await (copyFile (resolve bundle "libexec/darwin/main.mjs") (resolve staging "Contents/Resources/darwin/main.mjs")))
      (await (writeFile (resolve staging "Contents/Resources/dj-controller-owner") "dev.dispatch-junction.controller\n"))
      (await (writeFile (resolve staging "Contents/Info.plist") (plist (str
        "<key>CFBundleIdentifier</key><string>dev.dispatch-junction.controller</string><key>CFBundleName</key><string>DJ Control</string>"
        "<key>CFBundleDisplayName</key><string>DJ Control</string><key>NSPrincipalClass</key><string>NSApplication</string>"
        "<key>CFBundleExecutable</key><string>dj-status-bar</string><key>CFBundlePackageType</key><string>APPL</string>"
        "<key>CFBundleIconFile</key><string>dj-mark.icns</string><key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>"
        "<key>LSUIElement</key><true/><key>NSHighResolutionCapable</key><true/>"
        "<key>DJRootDirectory</key><string>" (xml root) "</string><key>DJRuntimePath</key><string>" (xml (await (realpath runtime))) "</string>"))))
      (let ((signed (await (runCommand "codesign" (js-array "--force" "--options" "runtime" "--sign" "-" "--identifier" "dev.dispatch-junction.controller" staging)))))
        (unless (= (nativeGet signed "code") 0) (throw (new globalThis.Error "controller code signing failed"))))
      ;; Updating the controller login item never stops the DJ service.
      (await (runCommand "launchctl" (js-array "bootout" (str "gui/" (js-call globalThis.process :getuid) "/dev.dispatch-junction.controller"))))
      (let ((closed (await (runCommand (resolve staging "Contents/MacOS/dj-status-bar") (js-array "--quit-controller")))))
        (unless (= (nativeGet closed "code") 0) (throw (new globalThis.Error "existing controller is still running"))))
      (let ((old (str destination ".previous")))
        (try (await (lstat old)) (throw (new globalThis.Error "previous app needs explicit inspection"))
          (catch absent (unless (= (nativeGet absent "code") "ENOENT") (throw absent))))
        (try (await (rename destination old)) (catch missing (unless (= (nativeGet missing "code") "ENOENT") (throw missing))))
        (try (await (rename staging destination))
          (catch problem
            (try (await (rename old destination)) (catch missing nil))
            (throw problem)))
        (await (rm old (js-object :recursive t :force t))))
      (let ((registered (await (runCommand (resolve destination "Contents/MacOS/dj-status-bar") (js-array "--register-app")))))
        (unless (= (nativeGet registered "code") 0) (throw (new globalThis.Error "controller application registration failed"))))
      (await (writeFile agent (plist (str "<key>Label</key><string>dev.dispatch-junction.controller</string>"
        "<key>ProgramArguments</key><array><string>" (xml (resolve destination "Contents/MacOS/dj-status-bar")) "</string></array>"
        "<key>RunAtLoad</key><true/><key>KeepAlive</key><false/><key>LimitLoadToSessionType</key><string>Aqua</string>")) (js-object :mode 384)))
      (let ((started (await (runCommand "launchctl" (js-array "bootstrap" (str "gui/" (js-call globalThis.process :getuid)) agent)))))
        (unless (= (nativeGet started "code") 0) (throw (new globalThis.Error "controller login item could not start"))))
      (js-object :application destination :launch_agent agent :service_unchanged t)))
  (export installDarwinController))
