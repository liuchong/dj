(module dj.interfaces.native
  (import "../core/native.eli" nativeGet nativeTypeOf nativeBitAnd)
  (import "../core/errors.eli" success failure)
  (import "../adapters/agent/native-local.eli" ownedJson metadataCommand processProof localCertificate)
  (import "../adapters/agent/claude-inbox.eli" claudeTarget)
  (import "node:fs/promises" lstat mkdir writeFile unlink)
  (import "node:path" resolve join)
  (defconst nativeHelp
    "dj native configure --input PRIVATE_JSON\nBinds an already running Antigravity language server or Claude Code native inbox. Input: tool, pid, directory, workspace_ref, instance_id, native_namespace, output_directory, process_helper_ref; Antigravity also base_url; Claude also registry_path. Writes a new private endpoint.json (and Antigravity credential.json). Does not start an AI, create a conversation, send a message, change permissions or install anything. Merge the endpoint into service.agent_endpoints explicitly.\n")
  (defasync configureNative (input)
    (unless (and (js-call (js-array "claude" "antigravity") :includes (nativeGet input "tool"))
                 (Number/isSafeInteger (nativeGet input "pid")) (> (nativeGet input "pid") 0)
                 (js-call (js-array "directory" "workspace_ref" "instance_id" "native_namespace" "output_directory" "process_helper_ref")
                   :every (lambda (key) (and (= (nativeTypeOf (nativeGet input key)) "string") (> (js-length (nativeGet input key)) 0)))))
      (throw (new globalThis.TypeError "exact native process and workspace configuration required")))
    (let* ((context (js-object :deadline (+ (performance/now) 10000)))
           (helper (resolve (nativeGet input "process_helper_ref")))
           (info (await (lstat helper))) (pid (nativeGet input "pid")))
      (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                   (js-call (js-array 0 (js-call globalThis.process :getuid)) :includes (nativeGet info "uid"))
                   (= (nativeBitAnd (nativeGet info "mode") 18) 0))
        (throw (new globalThis.TypeError "trusted process metadata helper required")))
      (let* ((process (JSON/parse (await (metadataCommand helper (js-array (str pid)) context))))
             (directory (resolve (nativeGet input "output_directory")))
             (endpoint (js-object :tool (nativeGet input "tool") :instance_id (nativeGet input "instance_id")
               :native_namespace (nativeGet input "native_namespace") :ownership "existing"
               :endpoint_ref (str "native-" (nativeGet input "instance_id"))
               :directory (resolve (nativeGet input "directory")) :workspace_ref (nativeGet input "workspace_ref")
               :process_binding (js-object :pid pid :process_birth (nativeGet process "birth") :process_helper_ref helper)))
             (credential nil) (written false) (credential-path (join directory "credential.json"))
             (endpoint-path (join directory "endpoint.json")))
        (if (= (nativeGet input "tool") "antigravity")
          (progn
            (put endpoint :base_url (nativeGet input "base_url"))
            (await (processProof endpoint context))
            ;; Read only this verified language-server's own argv; never print it.
            (let* ((args (await (metadataCommand "ps" (js-array "-p" (str pid) "-o" "args=") context)))
                   (match (js-call args :match (new globalThis.RegExp "(?:^|\\s)--csrf_token(?:=|\\s+)([A-Za-z0-9_-]+)(?:\\s|$)")))
                   (certificate (await (localCertificate endpoint context))))
              (unless match (throw (new globalThis.TypeError "native CSRF credential unavailable")))
              (put (nativeGet endpoint "process_binding") :certificate_sha256 (nativeGet certificate "certificate_sha256"))
              (setq credential (js-object :csrf_token (aref match 1) :certificate_pem (nativeGet certificate "certificate_pem")))
              (put endpoint :credential_ref credential-path)))
          (let* ((path (resolve (nativeGet input "registry_path"))) (registry (await (ownedJson path false))))
            (put endpoint :registry_path path)
            (put endpoint :native_session_id (nativeGet registry "sessionId"))
            (put endpoint :socket_path (nativeGet registry "messagingSocketPath" (nativeGet registry "sock")))
            (when (nativeGet registry "logPath") (put endpoint :history_log (nativeGet registry "logPath")))
            (await (claudeTarget endpoint context))))
        (put endpoint :instance_epoch (await (processProof endpoint context)))
        (await (mkdir directory (js-object :recursive t :mode 448)))
        (let ((parent (await (lstat directory))))
          (unless (and (js-call parent :isDirectory) (not (js-call parent :isSymbolicLink))
                       (= (nativeGet parent "uid") (js-call globalThis.process :getuid))
                       (= (nativeBitAnd (nativeGet parent "mode") 63) 0))
            (throw (new globalThis.TypeError "native output directory must be owner-private"))))
        (try
          (when credential (await (writeFile credential-path (JSON/stringify credential nil 2) (js-object :flag "wx" :mode 384)))
            (setq written t))
          (await (writeFile endpoint-path (JSON/stringify endpoint nil 2) (js-object :flag "wx" :mode 384)))
          (success (js-object :endpoint_file endpoint-path :tool (nativeGet endpoint "tool") :ownership "existing"
            :sent false :client_configuration_changed false))
          (catch error (when written (await (unlink credential-path))) (throw error))))))
  (defasync runNativeCommand (argv io)
    (if (js-call argv :includes "--help") (progn (funcall (nativeGet io "stdout") nativeHelp) 0)
      (let ((result nil))
        (try
          (unless (and (= (js-length argv) 4) (= (aref argv 1) "configure") (= (aref argv 2) "--input"))
            (throw (new globalThis.TypeError "use native configure --input PRIVATE_JSON")))
          (setq result (await (configureNative (await (ownedJson (resolve (aref argv 3)) t)))))
          (catch unavailable (setq result (failure "target_unavailable"))))
        (funcall (nativeGet io "stdout") (str (JSON/stringify result) "\n"))
        (if (nativeGet result "ok") 0 1))))
  (export configureNative runNativeCommand))
