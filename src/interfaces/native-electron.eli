(module dj.interfaces.native-electron
  (import "../core/native.eli" nativeGet)
  (import "../adapters/agent/electron-control.eli" electronControl)
  (defasync configureElectronEndpoint (input endpoint context)
    (unless (= (nativeGet endpoint "tool") "claude")
      (throw (new globalThis.TypeError "Desktop Inspector endpoint requires Claude")))
    (let* ((binding (nativeGet endpoint "process_binding"))
           (api (js-object :inspector_url "http://127.0.0.1:9229/" :process_origin 0
             :process_id (nativeGet binding "pid") :process_birth (nativeGet binding "process_birth")
             :process_helper_ref (nativeGet binding "process_helper_ref") :manage_inspector t)))
      (put endpoint :native_api api)
      (when (nativeGet input "workspace_scope") (put endpoint :workspace_scope (nativeGet input "workspace_scope")))
      (let* ((inspection (await (electronControl endpoint (js-object :operation "inspect") context)))
             (data (nativeGet inspection "data"))
             (windows (js-call (nativeGet data "windows") :filter (lambda (row)
               (and (or (not (nativeGet input "window_id")) (= (nativeGet row "id") (nativeGet input "window_id")))
                 (js-call (js-array "https://claude.ai" "https://claude.com" "app://localhost")
                   :includes (nativeGet (new globalThis.URL (nativeGet row "url")) "origin")))))))
        (unless (= (js-length windows) 1) (throw (new globalThis.TypeError "exact existing native window required")))
        (put endpoint :window_id (nativeGet (aref windows 0) "id"))
        (put api :process_origin (nativeGet data "origin")))
      (put endpoint :instance_epoch (nativeGet (await (electronControl endpoint (js-object :operation "list") context)) "instance_epoch"))
      endpoint))
  (export configureElectronEndpoint))
