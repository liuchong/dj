(module dj.interfaces.skill
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "node:fs/promises" lstat realpath readdir readFile mkdir writeFile unlink rmdir)
  (import "node:path" resolve dirname join)
  (import "node:os" homedir)
  (import "node:crypto" createHash)
  (import "./hooks.eli" hookConfig)

  ;; Local instruction locations; installation never starts a client or edits
  ;; its MCP configuration, trust, permissions or subscription state.
  (defconst skillTargets (Object/freeze (js-object
    :dj (js-object :user ".dj/skills" :project ".dj/skills")
    :agents (js-object :user ".agents/skills" :project ".agents/skills")
    :codex (js-object :user ".agents/skills" :project ".agents/skills")
    :cursor (js-object :user ".cursor/skills" :project ".cursor/skills")
    :claude (js-object :user ".claude/skills" :project ".claude/skills")
    :openclaw (js-object :user ".openclaw/skills" :project "skills")
    :hermes (js-object :user ".hermes/skills")
    :opencode (js-object :user ".config/opencode/skills" :project ".opencode/skills")
    :pi (js-object :user ".agents/skills" :project ".agents/skills")
    :kimi (js-object :user ".agents/skills" :project ".agents/skills")
    :dsh (js-object :user ".dsh/skills" :project ".dsh/skills")
    :antigravity (js-object :user ".gemini/config/skills" :project ".agents/skills")
    :agy (js-object :user ".gemini/antigravity-cli/skills" :project ".agents/skills"))))
  (defconst skillHelp
    "dj skill targets\ndj skill install|check --target TOOL --scope user|project [--project DIRECTORY] [--update] [--dry-run]\ndj skill config --target TOOL --client-profile FILE [--mcp-url LOCAL_URL] [--server-name NAME] [--no-control] [--tools LIST]\ndj skill hooks --target codex|cursor --client-profile FILE --agent ID [--group ID]\nTargets: dj (shared Skill directory), agents, codex, cursor, claude, opencode, pi, kimi, dsh, antigravity, agy, openclaw, hermes.\nCopies the complete bundled dj Skill. Different existing files or links are conflicts unless install --update explicitly refreshes an existing Markdown Skill directory. Config/hooks print snippets only; no client configuration changes or Agent starts.\n")
  (defasync fileInfo (path)
    (try (await (lstat path))
      (catch error (if (= (nativeGet error "code") "ENOENT") nil (throw error)))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun skillDestination (options &optional home)
    (let* ((target (nativeGet options "target")) (scope (nativeGet options "scope"))
           (entry (nativeGet skillTargets target)) (project (nativeGet options "project")))
      (unless (and (object-has? skillTargets target) entry (js-call (js-array "user" "project") :includes scope)
        (nativeGet entry scope)
        (if (= scope "project") (and (= (nativeTypeOf project) "string") (> (js-length project) 0)) (not project)))
        (throw (new globalThis.TypeError "choose a known target and explicit user/project scope")))
      (resolve (if (= scope "user") (or home (homedir)) project) (nativeGet entry scope) "dj")))
  (defasync skillFiles (root)
    (let ((files (js-array)) (total 0) (visit nil))
      (setq visit (async (directory prefix depth)
        (let ((info (await (lstat directory))))
          (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink)) (<= depth 4))
            (throw (new globalThis.TypeError "Skill contains a link or unsupported directory"))))
        (let ((entries (await (readdir directory (js-object :withFileTypes t)))) (i 0))
          (while (< i (js-length entries))
            (let* ((entry (aref entries i)) (name (nativeGet entry "name"))
                   (path (join directory name)) (key (if prefix (str prefix "/" name) name)))
              (unless (js-call (new globalThis.RegExp "^[A-Za-z0-9][A-Za-z0-9._-]*$") :test name)
                (throw (new globalThis.TypeError "unsupported Skill asset name")))
              (cond
                ((js-call entry :isDirectory) (await (visit path key (1+ depth))))
                ((and (js-call entry :isFile) (or (js-call name :endsWith ".md") (js-call name :endsWith ".mdp")))
                  (let ((info (await (lstat path))))
                    (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                      (<= (nativeGet info "size") 262144) (< (js-length files) 64))
                      (throw (new globalThis.RangeError "Skill asset limit"))))
                  (let ((bytes (await (readFile path))))
                    (setq total (+ total (nativeGet bytes "length")))
                    (when (> total 1048576) (throw (new globalThis.RangeError "Skill byte limit")))
                    (js-call files :push (js-object :path key :bytes bytes :sha256 (digest bytes)))))
                (t (throw (new globalThis.TypeError "Skill assets must be regular Markdown or MDP files")))))
            (setq i (1+ i))))))
      (await (visit root nil 0))
      (unless (js-call files :some (lambda (file) (= (nativeGet file "path") "SKILL.md")))
        (throw (new globalThis.TypeError "Skill manifest missing")))
      (js-call files :sort (lambda (a b) (js-call (nativeGet a "path") :localeCompare (nativeGet b "path"))))
      files))
  (defasync skillParents (base destination create)
    (let ((info (await (lstat base))))
      (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
        (= (await (realpath base)) base))
        (throw (new globalThis.TypeError "Skill base must be a real directory"))))
    (let ((cursor base)
          (parts (js-call (js-call (dirname destination) :slice (1+ (js-length base))) :split "/")) (i 0))
      (while (< i (js-length parts))
        (setq cursor (join cursor (aref parts i)))
        (let ((info (await (fileInfo cursor))))
          (when (and (not info) create)
            (try (await (mkdir cursor (js-object :mode 448)))
              (catch race (unless (= (nativeGet race "code") "EEXIST") (throw race))))
            (setq info (await (fileInfo cursor))))
          (when (and info (or (not (js-call info :isDirectory)) (js-call info :isSymbolicLink)))
            (throw (new globalThis.TypeError "Skill parent conflicts with a file or link"))))
        (setq i (1+ i)))))
  (defasync installSkill (source options &optional home)
    (let* ((destination (skillDestination options home))
           (base (resolve (if (= (nativeGet options "scope") "user") (or home (homedir)) (nativeGet options "project"))))
           (files (await (skillFiles source)))
           (rows (js-call files :map (lambda (file) (js-object :path (nativeGet file "path") :sha256 (nativeGet file "sha256")))))
           (info nil) (existing nil) (same false))
      (await (skillParents base destination false))
      (setq info (await (fileInfo destination)))
      (when info
        (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink)))
          (throw (new globalThis.TypeError "existing Skill is a conflict")))
        (setq existing (await (skillFiles destination)))
        (setq same (= (JSON/stringify rows) (JSON/stringify (js-call existing :map
                  (lambda (file) (js-object :path (nativeGet file "path") :sha256 (nativeGet file "sha256")))))))
        (unless (or same (nativeGet options "update"))
          (throw (new globalThis.TypeError "existing Skill differs; preserve it for an explicit update"))))
      (let ((state (cond ((and info same) "unchanged")
                     ((= (nativeGet options "action") "check") "absent")
                     ((nativeGet options "dry_run") "planned")
                     (info "updated")
                     (t "installed"))))
        (when (= state "installed")
          (await (skillParents base destination t))
          ;; Exclusive creation: even an existing empty directory is not replaced.
          (await (mkdir destination (js-object :mode 448)))
          (let ((i 0))
            (while (< i (js-length files))
              (let* ((file (aref files i)) (path (join destination (nativeGet file "path"))))
                (await (mkdir (dirname path) (js-object :recursive t :mode 448)))
                (await (writeFile path (nativeGet file "bytes") (js-object :flag "wx" :mode 384))))
              (setq i (1+ i)))))
        (when (= state "updated")
          (let ((keep (new globalThis.Set)) (i 0))
            (while (< i (js-length files))
              (let* ((file (aref files i)) (rel (nativeGet file "path")) (path (join destination rel))
                     (current (await (fileInfo path))))
                (js-call keep :add rel)
                (when current
                  (unless (and (js-call current :isFile) (not (js-call current :isSymbolicLink)))
                    (throw (new globalThis.TypeError "existing Skill file conflict"))))
                (await (mkdir (dirname path) (js-object :recursive t :mode 448)))
                (await (writeFile path (nativeGet file "bytes") (js-object :mode 384))))
              (setq i (1+ i)))
            (setq i 0)
            (while (< i (js-length existing))
              (let ((rel (nativeGet (aref existing i) "path")))
                (unless (js-call keep :has rel)
                  (let ((obsolete (join destination rel)))
                    (await (unlink obsolete))
                    (let ((dir (dirname obsolete)))
                      (while (not (= dir destination))
                        (let ((removed false))
                          (try (progn (await (rmdir dir)) (setq removed t)) (catch nonempty (setq removed false)))
                          (setq dir (if removed (dirname dir) destination))))))))
              (setq i (1+ i)))))
        (success (js-object :state state :target (nativeGet options "target") :destination destination
          :files rows :client_config_modified false :agent_started false :client_adoption "unverified")))))
  (defun validServerName (value)
    (unless (and (= (nativeTypeOf value) "string")
                 (js-call (new globalThis.RegExp "^[A-Za-z0-9_-]+$") :test value))
      (throw (new globalThis.TypeError "invalid MCP server name")))
    value)

  (defun parseToolList (value)
    (unless (and (= (nativeTypeOf value) "string") (> (js-length (js-call value :trim)) 0))
      (throw (new globalThis.TypeError "invalid MCP tool list")))
    (let* ((parts (js-call value :split ","))
           (seen (new globalThis.Set))
           (items (js-array))
           (pattern (new globalThis.RegExp "^[A-Za-z0-9_.-]+$"))
           (i 0))
      (while (< i (js-length parts))
        (let ((name (js-call (aref parts i) :trim)))
          (when (> (js-length name) 0)
            (unless (js-call pattern :test name)
              (throw (new globalThis.TypeError "invalid MCP tool name")))
            (unless (js-call seen :has name)
              (js-call seen :add name)
              (js-call items :push name))))
        (setq i (1+ i)))
      (when (= (js-length items) 0)
        (throw (new globalThis.TypeError "invalid MCP tool list")))
      (js-call items :join ",")))

  (defun namedEntry (name value)
    (let ((entry (js-object)))
      (put entry name value)
      entry))

  (defun httpSkillConfig (target value &optional command extra)
    (let* ((url (new globalThis.URL value))
      (name (if (and extra (nativeGet extra "server_name"))
              (validServerName (nativeGet extra "server_name"))
              "dj"))
      (no-ctrl (and extra (= (nativeGet extra "no_control") t)))
      (tools-csv (when (and extra (nativeGet extra "tools"))
        (parseToolList (nativeGet extra "tools"))))
      (headers (js-object :Authorization "Bearer <DJ_CLIENT_TOKEN>"))
      (endpoint (js-object :url value :headers headers)))
      (unless (and (= (nativeGet url "protocol") "http:")
        (= (nativeGet url "hostname") "127.0.0.1") (nativeGet url "port")
        (= (nativeGet url "pathname") "/mcp") (= (nativeGet url "username") "")
        (= (nativeGet url "password") "") (= (nativeGet url "search") "") (= (nativeGet url "hash") ""))
        (throw (new globalThis.TypeError "MCP requires a numeric loopback URL and /mcp path")))
      (when (and (or no-ctrl tools-csv) (not (= target "codex")))
        (throw (new globalThis.TypeError "--no-control and --tools apply only to codex HTTP proxy")))
      (cond
        ((= target "codex")
          (let ((launcher (if (and (= (nativeTypeOf command) "string") (js-call command :endsWith "/bin/dj"))
                            (resolve (dirname (dirname command)) "connectors/codex/launch-mcp.sh")
                            "connectors/codex/launch-mcp.sh"))
                (proxy-args (js-array "--url" value "--token-file" "<PRIVATE_MCP_TOKEN_FILE>"))
                (proxy-env (if no-ctrl
                             (js-array "CODEX_MCP_NODE_PATH")
                             (js-array "CODEX_APP_TOOLS_PIPE_PATH" "CODEX_MCP_NODE_PATH" "CODEX_HOME"))))
            (when no-ctrl (js-call proxy-args :push "--no-control"))
            (when tools-csv (js-call proxy-args :push "--tools" tools-csv))
            (str "[mcp_servers." name "]\ncommand = " (JSON/stringify launcher)
              "\nargs = " (JSON/stringify proxy-args)
              "\nenv_vars = " (JSON/stringify proxy-env) "\n")))
        ((= target "opencode") (js-object :mcp (js-object :servers
          (namedEntry name (Object/assign endpoint (js-object :type "remote" :oauth false :pool t))))))
        ((= target "openclaw") (js-object :mcp (js-object :servers
          (namedEntry name (Object/assign endpoint (js-object :transport "streamable-http"))))))
        ((= target "hermes") (js-object :mcp_servers (namedEntry name endpoint)))
        ((= target "claude") (js-object :mcpServers (namedEntry name (Object/assign endpoint (js-object :type "http")))))
        ((js-call (js-array "antigravity" "agy") :includes target)
          (js-object :mcpServers (namedEntry name (js-object :serverUrl value :headers headers))))
        ((= target "cursor") (js-object :mcpServers (namedEntry name endpoint)))
        (t nil))))

  (defun skillConfig (target command profile &optional mcp-url extra)
    (unless (and (object-has? skillTargets target) (= (nativeTypeOf command) "string")
      (> (js-length command) 0) (= (nativeTypeOf profile) "string") (> (js-length profile) 0))
      (throw (new globalThis.TypeError "target, command and private client profile required")))
    (when (and (not mcp-url) extra (or (= (nativeGet extra "no_control") t) (nativeGet extra "tools")))
      (throw (new globalThis.TypeError "--no-control and --tools require --mcp-url")))
    (let* ((name (if (and extra (nativeGet extra "server_name"))
                   (validServerName (nativeGet extra "server_name"))
                   "dj"))
           (args (js-array "mcp" "serve" "--transport" "stdio" "--client-profile" profile))
           (server (js-object :command command :args args))
           (config (cond
             (mcp-url (httpSkillConfig target mcp-url command extra))
             ((= target "codex") (str "[mcp_servers." name "]\ncommand = " (JSON/stringify command)
               "\nargs = " (JSON/stringify args) "\n"))
             ((= target "opencode") (js-object :mcp (namedEntry name (js-object :type "local"
               :command (js-call (js-array command) :concat args) :enabled t))))
             ((= target "openclaw") (js-object :mcp (js-object :servers (namedEntry name server))))
             ((= target "hermes") (js-object :mcp_servers (namedEntry name server)))
             ((js-call (js-array "dj" "agents" "pi" "dsh") :includes target) nil)
             (t (js-object :mcpServers (namedEntry name server))))))
      (success (js-object :target target :format (if (= target "codex") "toml" "json")
        :config config :cli_command command :client_profile profile
        :instructions (if mcp-url
          (if (= target "codex")
            (str "Store the selected client profile Bearer token in a 0600 file inside a 0700 directory as --token-file, then merge [mcp_servers." name "] into ~/.codex/config.toml without printing tokens or restarting the Codex app.")
            "Merge the dj entry into the private client configuration and substitute the selected profile token without exposing it in prompts or logs.")
          "Merge only the dj entry into local client configuration, preserving all other entries and approval policy. Pi/shared targets use CLI unless the host supplies an MCP client. See references/clients.md. GEPO uses the private UDS; it is not an MCP HTTP endpoint.")
        :client_config_modified false :agent_started false))))
  (defasync runSkillCommand (argv io root &optional command-root)
    (let ((launcher-root (or command-root root)))
    (if (or (js-call argv :includes "--help") (= (js-length argv) 1))
      (progn (funcall (nativeGet io "stdout") skillHelp) 0)
      (let ((result nil))
        (try
          (let ((action (aref argv 1)) (options (js-object)) (i 2))
            (unless (js-call (js-array "targets" "install" "check" "config" "hooks") :includes action)
              (throw (new globalThis.TypeError "unknown Skill command")))
            (while (< i (js-length argv))
              (let ((flag (aref argv i)))
                (cond
                  ((= flag "--json") nil)
                  ((= flag "--dry-run")
                    (when (object-has? options :dry_run) (throw (new globalThis.TypeError "missing or repeated Skill option")))
                    (put options :dry_run t))
                  ((= flag "--update")
                    (when (object-has? options :update) (throw (new globalThis.TypeError "missing or repeated Skill option")))
                    (put options :update t))
                  ((= flag "--no-control")
                    (when (object-has? options :no_control) (throw (new globalThis.TypeError "missing or repeated Skill option")))
                    (put options :no_control t))
                  ((js-call (js-array "--target" "--scope" "--project" "--client-profile" "--agent" "--group" "--mcp-url" "--server-name" "--tools") :includes flag)
                    (let ((key (js-call (js-call flag :slice 2) :replaceAll "-" "_")))
                      (when (or (object-has? options key) (>= (1+ i) (js-length argv))
                        (js-call (aref argv (1+ i)) :startsWith "--"))
                        (throw (new globalThis.TypeError "missing or repeated Skill option")))
                      (setq i (1+ i)) (put options key (aref argv i))))
                  (t (throw (new globalThis.TypeError "unknown Skill option")))))
              (setq i (1+ i)))
            (setq result
              (cond
                ((= action "targets")
                  (unless (= (js-length (Object/keys options)) 0) (throw (new globalThis.TypeError "targets takes no options")))
                  (success skillTargets))
                ((= action "config")
                  (unless (js-call (Object/keys options) :every (lambda (k) (js-call (js-array "target" "client_profile" "mcp_url" "server_name" "no_control" "tools") :includes k)))
                    (throw (new globalThis.TypeError "config accepts target, client-profile, mcp-url, server-name, no-control and tools only")))
                  (skillConfig (nativeGet options "target") (resolve launcher-root "bin/dj")
                    (if (nativeGet options "client_profile") (resolve (nativeGet options "client_profile")) nil)
                    (nativeGet options "mcp_url")
                    (js-object :server_name (nativeGet options "server_name")
                      :no_control (= (nativeGet options "no_control") t)
                      :tools (nativeGet options "tools"))))
                ((= action "hooks")
                  (unless (js-call (Object/keys options) :every
                    (lambda (k) (js-call (js-array "target" "client_profile" "agent" "group") :includes k)))
                    (throw (new globalThis.TypeError "hooks accepts target/profile/agent/group only")))
                  (if (not (js-call (js-array "codex" "cursor") :includes (nativeGet options "target")))
                    (failure "unsupported")
                    (progn
                      (when (nativeGet options "client_profile")
                        (put options :client_profile (resolve (nativeGet options "client_profile"))))
                      (hookConfig options (resolve launcher-root "bin/dj")))))
                (t
                  (when (and (= action "check") (nativeGet options "update"))
                    (throw (new globalThis.TypeError "check does not accept --update")))
                  (when (or (nativeGet options "agent") (nativeGet options "group") (nativeGet options "mcp_url")
                            (nativeGet options "server_name") (nativeGet options "no_control") (nativeGet options "tools"))
                    (throw (new globalThis.TypeError "install/check do not accept callback binding")))
                  (when (nativeGet options "client_profile") (throw (new globalThis.TypeError "install/check do not read profiles")))
                  (put options :action action)
                  (await (installSkill (resolve root "skills/dj") options))))))
          (catch error
            ;; Never echo asset contents, credentials or filesystem diagnostics.
            (setq result (failure (if (or (eq (nativeGet error "constructor") globalThis.TypeError)
              (= (nativeGet error "code") "EEXIST")) "invalid_argument" "unavailable")))))
        (funcall (nativeGet io (if (nativeGet result "ok") "stdout" "stderr")) (str (JSON/stringify result) "\n"))
        (if (nativeGet result "ok") 0 2)))))
  (export skillTargets skillDestination skillConfig installSkill runSkillCommand))
