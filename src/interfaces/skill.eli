(module dj.interfaces.skill
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "node:fs/promises" lstat realpath readdir readFile mkdir writeFile)
  (import "node:path" resolve dirname join)
  (import "node:os" homedir)
  (import "node:crypto" createHash)
  (import "./hooks.eli" hookConfig)

  ;; Local instruction locations; installation never starts a client or edits
  ;; its MCP configuration, trust, permissions or subscription state.
  (defconst skillTargets (Object/freeze (js-object
    :agents (js-object :user ".agents/skills" :project ".agents/skills")
    :codex (js-object :user ".agents/skills" :project ".agents/skills")
    :cursor (js-object :user ".cursor/skills" :project ".cursor/skills")
    :claude (js-object :user ".claude/skills" :project ".claude/skills")
    :opencode (js-object :user ".config/opencode/skills" :project ".opencode/skills")
    :pi (js-object :user ".agents/skills" :project ".agents/skills")
    :antigravity (js-object :user ".gemini/config/skills" :project ".agents/skills")
    :agy (js-object :user ".gemini/antigravity-cli/skills" :project ".agents/skills"))))
  (defconst skillHelp
    "dj skill targets\ndj skill install|check --target TOOL --scope user|project [--project DIRECTORY] [--dry-run]\ndj skill config --target TOOL --client-profile FILE\ndj skill hooks --target codex|cursor --client-profile FILE --agent ID --subscription ID\nTargets: agents, codex, cursor, claude, opencode, pi, antigravity, agy.\nCopies the complete bundled dj Skill. Different existing files or links are conflicts, never overwritten. Config/hooks print snippets only; no client configuration changes or Agent starts.\n")
  (defasync fileInfo (path)
    (try (await (lstat path))
      (catch error (if (= (nativeGet error "code") "ENOENT") nil (throw error)))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun skillDestination (options &optional home)
    (let* ((target (nativeGet options "target")) (scope (nativeGet options "scope"))
           (entry (nativeGet skillTargets target)) (project (nativeGet options "project")))
      (unless (and (object-has? skillTargets target) entry (js-call (js-array "user" "project") :includes scope)
        (if (= scope "project") (and (= (nativeTypeOf project) "string") (> (js-length project) 0)) (not project)))
        (throw (new globalThis.TypeError "choose a known target and explicit user/project scope")))
      (resolve (if (= scope "user") (or home (homedir)) project) (nativeGet entry scope) "dj")))
  (defasync skillFiles (root)
    (let ((files (js-array)) (total 0) (visit nil))
      (setq visit (async (directory prefix depth)
        (let ((info (await (lstat directory))))
          (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink)) (<= depth 4))
            (throw (new globalThis.TypeError "Skill contains a link or unsupported directory"))))
        (let ((entries (await (readdir directory (js-object :withFileTypes t)))) (i 0))
          (while (< i (js-length entries))
            (let* ((entry (aref entries i)) (name (nativeGet entry "name"))
                   (path (join directory name)) (key (if prefix (str prefix "/" name) name)))
              (unless (js-call (new globalThis.RegExp "^[A-Za-z0-9][A-Za-z0-9._-]*$") :test name)
                (throw (new globalThis.TypeError "unsupported Skill asset name")))
              (cond
                ((js-call entry :isDirectory) (await (visit path key (1+ depth))))
                ((and (js-call entry :isFile) (js-call name :endsWith ".md"))
                  (let ((info (await (lstat path))))
                    (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
                      (<= (nativeGet info "size") 262144) (< (js-length files) 64))
                      (throw (new globalThis.RangeError "Skill asset limit"))))
                  (let ((bytes (await (readFile path))))
                    (setq total (+ total (nativeGet bytes "length")))
                    (when (> total 1048576) (throw (new globalThis.RangeError "Skill byte limit")))
                    (js-call files :push (js-object :path key :bytes bytes :sha256 (digest bytes)))))
                (t (throw (new globalThis.TypeError "Skill assets must be regular Markdown files")))))
            (setq i (1+ i))))))
      (await (visit root nil 0))
      (unless (js-call files :some (lambda (file) (= (nativeGet file "path") "SKILL.md")))
        (throw (new globalThis.TypeError "Skill manifest missing")))
      (js-call files :sort (lambda (a b) (js-call (nativeGet a "path") :localeCompare (nativeGet b "path"))))
      files))
  (defasync skillParents (base destination create)
    (let ((info (await (lstat base))))
      (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
        (= (await (realpath base)) base))
        (throw (new globalThis.TypeError "Skill base must be a real directory"))))
    (let ((cursor base)
          (parts (js-call (js-call (dirname destination) :slice (1+ (js-length base))) :split "/")) (i 0))
      (while (< i (js-length parts))
        (setq cursor (join cursor (aref parts i)))
        (let ((info (await (fileInfo cursor))))
          (when (and (not info) create)
            (try (await (mkdir cursor (js-object :mode 448)))
              (catch race (unless (= (nativeGet race "code") "EEXIST") (throw race))))
            (setq info (await (fileInfo cursor))))
          (when (and info (or (not (js-call info :isDirectory)) (js-call info :isSymbolicLink)))
            (throw (new globalThis.TypeError "Skill parent conflicts with a file or link"))))
        (setq i (1+ i)))))
  (defasync installSkill (source options &optional home)
    (let* ((destination (skillDestination options home))
           (base (resolve (if (= (nativeGet options "scope") "user") (or home (homedir)) (nativeGet options "project"))))
           (files (await (skillFiles source)))
           (rows (js-call files :map (lambda (file) (js-object :path (nativeGet file "path") :sha256 (nativeGet file "sha256")))))
           (info nil))
      (await (skillParents base destination false))
      (setq info (await (fileInfo destination)))
      (when info
        (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink)))
          (throw (new globalThis.TypeError "existing Skill is a conflict")))
        (let ((existing (await (skillFiles destination))))
          (unless (= (JSON/stringify rows) (JSON/stringify (js-call existing :map
                    (lambda (file) (js-object :path (nativeGet file "path") :sha256 (nativeGet file "sha256"))))))
            (throw (new globalThis.TypeError "existing Skill differs; preserve it for an explicit update")))))
      (let ((state (cond (info "unchanged") ((= (nativeGet options "action") "check") "absent")
                     ((nativeGet options "dry_run") "planned") (t "installed"))))
        (when (= state "installed")
          (await (skillParents base destination t))
          ;; Exclusive creation: even an existing empty directory is not replaced.
          (await (mkdir destination (js-object :mode 448)))
          (let ((i 0))
            (while (< i (js-length files))
              (let* ((file (aref files i)) (path (join destination (nativeGet file "path"))))
                (await (mkdir (dirname path) (js-object :recursive t :mode 448)))
                (await (writeFile path (nativeGet file "bytes") (js-object :flag "wx" :mode 384))))
              (setq i (1+ i)))))
        (success (js-object :state state :target (nativeGet options "target") :destination destination
          :files rows :client_config_modified false :agent_started false :client_adoption "unverified")))))
  (defun skillConfig (target command profile)
    (unless (and (object-has? skillTargets target) (= (nativeTypeOf command) "string")
      (> (js-length command) 0) (= (nativeTypeOf profile) "string") (> (js-length profile) 0))
      (throw (new globalThis.TypeError "target, command and private client profile required")))
    (let* ((args (js-array "mcp" "serve" "--transport" "stdio" "--client-profile" profile))
           (server (js-object :command command :args args))
           (config (cond
             ((= target "codex") (str "[mcp_servers.dj]\ncommand = " (JSON/stringify command)
               "\nargs = " (JSON/stringify args) "\n"))
             ((= target "opencode") (js-object :mcp (js-object :dj (js-object :type "local"
               :command (js-call (js-array command) :concat args) :enabled t))))
             ((js-call (js-array "agents" "pi") :includes target) nil)
             (t (js-object :mcpServers (js-object :dj server))))))
      (success (js-object :target target :format (if (= target "codex") "toml" "json")
        :config config :cli_command command :client_profile profile
        :instructions "Merge only the dj entry into local client configuration, preserving all other entries and approval policy. Pi/shared targets use CLI unless the host supplies an MCP client. See references/clients.md. GEPO uses the private UDS; it is not an MCP HTTP endpoint."
        :client_config_modified false :agent_started false))))
  (defasync runSkillCommand (argv io root)
    (if (or (js-call argv :includes "--help") (= (js-length argv) 1))
      (progn (funcall (nativeGet io "stdout") skillHelp) 0)
      (let ((result nil))
        (try
          (let ((action (aref argv 1)) (options (js-object)) (i 2))
            (unless (js-call (js-array "targets" "install" "check" "config" "hooks") :includes action)
              (throw (new globalThis.TypeError "unknown Skill command")))
            (while (< i (js-length argv))
              (let ((flag (aref argv i)))
                (cond
                  ((= flag "--json") nil)
                  ((= flag "--dry-run") (put options :dry_run t))
                  ((js-call (js-array "--target" "--scope" "--project" "--client-profile" "--agent" "--subscription") :includes flag)
                    (let ((key (js-call (js-call flag :slice 2) :replaceAll "-" "_")))
                      (when (or (object-has? options key) (>= (1+ i) (js-length argv))
                        (js-call (aref argv (1+ i)) :startsWith "--"))
                        (throw (new globalThis.TypeError "missing or repeated Skill option")))
                      (setq i (1+ i)) (put options key (aref argv i))))
                  (t (throw (new globalThis.TypeError "unknown Skill option")))))
              (setq i (1+ i)))
            (setq result
              (cond
                ((= action "targets")
                  (unless (= (js-length (Object/keys options)) 0) (throw (new globalThis.TypeError "targets takes no options")))
                  (success skillTargets))
                ((= action "config")
                  (unless (js-call (Object/keys options) :every (lambda (k) (js-call (js-array "target" "client_profile") :includes k)))
                    (throw (new globalThis.TypeError "config accepts target and client-profile only")))
                  (skillConfig (nativeGet options "target") (resolve root "bin/dj")
                    (if (nativeGet options "client_profile") (resolve (nativeGet options "client_profile")) nil)))
                ((= action "hooks")
                  (unless (js-call (Object/keys options) :every
                    (lambda (k) (js-call (js-array "target" "client_profile" "agent" "subscription") :includes k)))
                    (throw (new globalThis.TypeError "hooks accepts target/profile/agent/subscription only")))
                  (if (not (js-call (js-array "codex" "cursor") :includes (nativeGet options "target")))
                    (failure "unsupported")
                    (progn
                      (when (nativeGet options "client_profile")
                        (put options :client_profile (resolve (nativeGet options "client_profile"))))
                      (hookConfig options (resolve root "bin/dj")))))
                (t
                  (when (or (nativeGet options "agent") (nativeGet options "subscription"))
                    (throw (new globalThis.TypeError "install/check do not accept callback binding")))
                  (when (nativeGet options "client_profile") (throw (new globalThis.TypeError "install/check do not read profiles")))
                  (put options :action action)
                  (await (installSkill (resolve root "skills/dj") options))))))
          (catch error
            ;; Never echo asset contents, credentials or filesystem diagnostics.
            (setq result (failure (if (or (eq (nativeGet error "constructor") globalThis.TypeError)
              (= (nativeGet error "code") "EEXIST")) "invalid_argument" "unavailable")))))
        (funcall (nativeGet io (if (nativeGet result "ok") "stdout" "stderr")) (str (JSON/stringify result) "\n"))
        (if (nativeGet result "ok") 0 2))))
  (export skillTargets skillDestination skillConfig installSkill runSkillCommand))
