(module dj.interfaces.mcp-http
  (import "../core/native.eli" nativeGet nativeTypeOf nativeSetInterval nativeClearInterval)
  (import "../core/errors.eli" failure)
  (import "../core/limits.eli" limits)
  (import "node:crypto" randomUUID)
  (import "@modelcontextprotocol/server" WebStandardStreamableHTTPServerTransport)
  (import "./mcp-runtime.eli" mcpRuntime)
  (import "./mcp.eli" createMcpServer)

  (defconst session-idle-ms 1800000)
  (defconst session-limit 128)
  (defconst request-limit 64)

  (defun transportError (status code message)
    (js-call globalThis.Response :json
      (js-object :jsonrpc "2.0" :id nil :error (js-object :code code :message message))
      (js-object :status status :headers (if (= status 401)
        (js-object :www-authenticate "Bearer") (js-object)))))

  (defun samePrincipal (left right)
    (and (= (nativeGet left "principal_id") (nativeGet right "principal_id"))
      (= (nativeGet left "authorization_revision") (nativeGet right "authorization_revision"))))

  ;; One listener lives in the service process. Each MCP session carries its
  ;; own protocol lifecycle and authenticated principal; no client PID is held.
  (defun startMcpHttp (core port)
    (let* ((host (str "127.0.0.1:" port))
      (sessions (new globalThis.Map)) (in-flight 0) (server nil) (timer nil)
      (closed false) (remove nil) (handle nil))
      (setq remove (async (id entry)
        (when (eq (js-call sessions :get id) entry)
          (js-call sessions :delete id)
          (await (js-call (nativeGet entry "mcp") :close)))))
      (setq handle (async (request)
        (let* ((headers (nativeGet request "headers")) (method (nativeGet request "method"))
          (url (new globalThis.URL (nativeGet request "url")))
          (authorization (or (js-call headers :get "authorization") ""))
          (session-id (js-call headers :get "mcp-session-id")))
          (cond
            ((not (= (nativeGet url "pathname") "/mcp")) (transportError 404 -32601 "Not found"))
            ((or (not (= (js-call headers :get "host") host)) (js-call headers :get "origin"))
              (transportError 403 -32000 "Local MCP access only"))
            ((or closed (not (js-call (js-array "ready" "draining") :includes (js-call core :transportState))))
              (transportError 503 -32000 "DJ is unavailable"))
            ((and (not (= method "GET")) (>= in-flight request-limit))
              (transportError 429 -32000 "Too many MCP requests"))
            (t
              (let ((identity (js-call core :authenticate (if (js-call authorization :startsWith "Bearer ")
                (js-call authorization :slice 7) ""))))
                (if (not (nativeGet identity "ok")) (transportError 401 -32000 "Authentication required")
                  (let* ((principal (nativeGet identity "data"))
                    (existing (when session-id (js-call sessions :get session-id))))
                    (cond
                      ((and session-id (not (and existing (samePrincipal principal (nativeGet existing "principal")))))
                        (transportError 404 -32001 "MCP session ended; initialize again"))
                      ((and (not session-id) (not (= method "POST")))
                        (transportError 400 -32000 "Initialize MCP session first"))
                      ((and (not session-id) (>= (nativeGet sessions "size") session-limit))
                        (transportError 429 -32000 "Too many MCP sessions"))
                      (t
                        (let* ((id (or session-id (randomUUID))) (entry existing) (counted (not (= method "GET"))))
                          (when counted (setq in-flight (1+ in-flight)))
                          (try
                            (unless entry
                              (let* ((mcp (createMcpServer nil nil (lambda () (js-call sessions :delete id))
                                (lambda () mcpRuntime)
                                (async (runtime operation args) (await (js-call core :execute principal operation args)))))
                                (transport (new WebStandardStreamableHTTPServerTransport
                                  (js-object :sessionIdGenerator (lambda () id)
                                    :enableJsonResponse t :keepAliveMs 10000 :maxRequestBodySize (nativeGet limits "api_response_bytes")
                                    :onsessionclosed (lambda (unused) (js-call sessions :delete id))))))
                                (setq entry (js-object :mcp mcp :transport transport :principal principal :touched (performance/now)))
                                (js-call sessions :set id entry)
                                (await (js-call mcp :connect transport))))
                            (put entry :touched (performance/now))
                            (let* ((transport (nativeGet entry "transport"))
                              (response (await (js-call transport :handleRequest request))))
                              (when (and (not existing) (not (= (nativeGet transport "sessionId") id)))
                                (await (funcall remove id entry)))
                              response)
                            (catch invalid
                              (when (and entry (not existing)) (await (funcall remove id entry)))
                              (transportError 500 -32603 "DJ MCP transport unavailable"))
                            (finally (when counted (setq in-flight (1- in-flight))))))))))))))))
      (setq server (Bun/serve (js-object :hostname "127.0.0.1" :port port :idleTimeout 0
        :fetch handle)))
      (setq host (str "127.0.0.1:" (nativeGet server "port")))
      (setq timer (nativeSetInterval (lambda ()
        (let ((old (- (performance/now) session-idle-ms)))
          (js-call sessions :forEach (lambda (entry id)
            (when (< (nativeGet entry "touched") old)
              (js-call (funcall remove id entry) :catch (lambda (unused) nil))))))) 60000))
      (js-call timer :unref)
      (js-object :port (nativeGet server "port")
        :status (lambda () (js-object :active_sessions (nativeGet sessions "size") :in_flight in-flight))
        :close (async ()
          (unless closed
            (setq closed t)
            (nativeClearInterval timer)
            (let ((pending (js-array)))
              (js-call sessions :forEach (lambda (entry id) (js-call pending :push (funcall remove id entry))))
              (await (Promise/allSettled pending)))
            (await (js-call server :stop false)))))))
  (export startMcpHttp))
