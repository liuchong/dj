(module dj.tasks.commands
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" sliceUtf8 conversationKey hashValue)
  (import "../core/errors.eli" success)
  (import "../application/context.eli" utcNow must inTransaction issueResourceHandle can)
  (import "../application/execute.eli" executeOperation)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../people/registry.eli" identityKey eventIdentities)
  (import "./service.eli" inspectionScope listTasks taskTree)
  (defun stageCommand (context event)
    (let ((text (nativeGet (nativeGet event "content") "text" "")))
      (when (and (nativeGet (nativeGet context "config") "task_inspection")
        (= (nativeGet event "event_kind") "message.created")
        (= (nativeGet (nativeGet event "sender") "kind") "human")
        (js-call (new globalThis.RegExp "^/dj(?:\\s|$)") :test (js-call text :trim)))
        (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
          "INSERT INTO task_commands(event_id,state) VALUES (?,'pending') ON CONFLICT(event_id) DO NOTHING") :run (nativeGet event "event_id"))
        t)))
  (defun commandPrincipal (context event)
    (let* ((config (nativeGet (nativeGet context "config") "task_inspection"))
      (keys (new globalThis.Set (js-call (eventIdentities context event) :map identityKey)))
      (users (js-call (nativeGet config "users" (js-array)) :filter (lambda (user)
        (js-call (nativeGet user "identities" (js-array)) :some (lambda (identity) (js-call keys :has (identityKey identity))))))))
      (when (= (js-length users) 1)
        (configuredPrincipal (nativeGet (nativeGet context "config") "principals") (nativeGet (aref users 0) "principal_id")))))
  (defun renderTask (task)
    (let ((source (nativeGet task "source")))
      (str (nativeGet task "delivery_id") "\n"
        (nativeGet source "connection_id") " · " (nativeGet source "native_chat_id" "资源")
        (if (nativeGet source "native_thread_id") (str " / " (nativeGet source "native_thread_id")) "") "\n"
        "消息 " (nativeGet source "native_message_id") "：" (nativeGet source "summary") "\n"
        "└─ " (nativeGet task "tool") " · " (nativeGet task "title") " [" (nativeGet task "state")
        (if (nativeGet task "blocked_reason") (str " / " (nativeGet task "blocked_reason")) "") "]\n"
        "   会话 " (nativeGet task "native_session_id") " · 任务 " (nativeGet task "task_state"))))
  (defun renderChildren (nodes parent depth)
    (if (> depth 8) ""
      (js-call (js-call (js-call nodes :filter (lambda (node) (= (nativeGet node "parent_session_key") parent))) :map
        (lambda (node) (str (js-call "  " :repeat depth) "└─ " (nativeGet node "tool") " · " (nativeGet node "title")
          " [已登记，归属未原生确认] " (nativeGet node "native_session_id") "\n"
          (renderChildren nodes (nativeGet node "session_key") (1+ depth))))) :join "")))
  (defun commandText (context event scope)
    (let* ((parts (js-call (js-call (nativeGet (nativeGet event "content") "text" "") :trim) :split (new globalThis.RegExp "\\s+")))
      (name (aref parts 1)))
      (cond ((not (= (nativeGet event "chat_type") "p2p")) "请在与本连接的私聊中使用 /dj tasks 或 /dj tree 投递ID，避免向群内泄露其他任务。")
        ((and (= name "tasks") (<= (js-length parts) 3))
          (let* ((result (listTasks context (js-object :after (or (aref parts 2) "") :limit 5) scope))
            (data (nativeGet result "data")) (items (nativeGet data "items" (js-array))))
            (str "DJ 任务巡查\n" (if (= (js-length items) 0) "当前可见范围内没有任务。" (js-call (js-call items :map renderTask) :join "\n\n"))
              (if (nativeGet data "next_after") (str "\n下一页：/dj tasks " (nativeGet data "next_after")) ""))))
        ((and (= name "tree") (= (js-length parts) 3))
          (let* ((result (taskTree context (js-object :delivery_id (aref parts 2)) scope)) (data (nativeGet result "data")))
            (if (not (nativeGet result "ok")) "任务不存在或不在你的查询范围内。"
              (str (renderTask (nativeGet data "task")) "\n"
                (renderChildren (nativeGet data "nodes") (nativeGet (nativeGet data "task") "session_key") 1)
                "\n子对话关联信息仅包含已登记项，未提供的关联不推测。"
                (if (nativeGet data "truncated") "\n结果已截断，可使用 task.tree 调整深度。" "")))))
        (t "DJ 任务巡查：\n/dj tasks [翻页标识]\n/dj tree 投递ID\n管理员可查全部；普通用户仅查明确绑定的连接。accepted 仅表示 AI 已接收，不代表任务完成。"))))
  (defun saveCommand (context id state &optional text principal-id destination-ref policy-hash)
    (must (inTransaction context (lambda (tx)
      (js-call (js-call (nativeGet tx "db") :query
        "UPDATE task_commands SET state=?,response_text=COALESCE(?,response_text),principal_id=COALESCE(?,principal_id),destination_ref=COALESCE(?,destination_ref),policy_hash=COALESCE(?,policy_hash) WHERE event_id=?")
        :run state (or text nil) (or principal-id nil) (or destination-ref nil) (or policy-hash nil) id)
      (success nil)))))
  (defasync processCommands (context)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (rows (js-call (js-call db :query "SELECT * FROM task_commands WHERE state IN ('pending','prepared') ORDER BY rowid LIMIT 2") :all)) (index 0))
      (while (and (< index (js-length rows)) (= (nativeGet (nativeGet context "runtime") "state") "ready"))
        (let* ((row (aref rows index)) (id (nativeGet row "event_id")) (event (js-call repository :get "events" id))
          (connection (js-call repository :get "connections" (nativeGet event "connection_id")))
          (principal (and event (commandPrincipal context event)))
          (actor (Object/assign (js-object) context (js-object :principal principal
            :authorization_revision (nativeGet principal "authorization_revision") :now (utcNow context))))
          (scope (and principal (inspectionScope actor)))
          (policy-hash (hashValue (js-object :policy (nativeGet (nativeGet context "config") "task_inspection") :scope scope))))
          (if (not (and (or (not (nativeGet row "policy_hash")) (= (nativeGet row "policy_hash") policy-hash)) scope (can actor "task.inspect" "task-inspection") connection (not (nativeGet connection "disabled"))
              (or (not (nativeGet row "principal_id")) (= (nativeGet row "principal_id") (nativeGet principal "principal_id")))
              (= (nativeGet connection "identity_revision" (nativeGet connection "revision")) (nativeGet event "identity_revision"))))
            (saveCommand context id "forbidden")
            (let* ((text (or (nativeGet row "response_text") (nativeGet (sliceUtf8 (commandText actor event scope) 0 12000) "text" "")))
              (address (nativeGet event "conversation")) (revision (nativeGet event "identity_revision")))
              (unless (nativeGet row "response_text") (saveCommand context id "prepared" text (nativeGet principal "principal_id") nil policy-hash))
              (let* ((reference (or (nativeGet row "destination_ref")
                  (nativeGet (must (issueResourceHandle actor "conversation" (conversationKey address)
                    (js-object :address address :source_revision revision :identity_revision revision) 300)) "ref"))))
                (saveCommand context id "prepared" text (nativeGet principal "principal_id") reference policy-hash)
                (put actor :task_command_event_id id)
                (put actor :task_command_policy_hash policy-hash)
                (let* (
                (result (await (executeOperation actor "message.send" (js-object
                  :destination_ref reference :content (js-object :type "text" :text text)
                  :idempotency_key (str "task-command-" id))))))
                (if (nativeGet result "ok") (saveCommand context id "recorded")
                  (saveCommand context id "failed")))))))
        (setq index (1+ index)))))
  (defun taskOutboundAllowed (context record)
    (let* ((id (nativeGet record "task_command_event_id"))
      (event (and id (js-call (nativeGet context "repository") :get "events" id)))
      (principal (and event (commandPrincipal context event)))
      (actor (Object/assign (js-object) context (js-object :principal principal)))
      (connection (and event (js-call (nativeGet context "repository") :get "connections" (nativeGet event "connection_id")))))
      (or (not id) (and principal connection (not (nativeGet connection "disabled"))
        (= (nativeGet principal "principal_id") (nativeGet record "principal_id"))
        (= (nativeGet record "task_command_policy_hash") (hashValue (js-object :policy (nativeGet (nativeGet context "config") "task_inspection") :scope (inspectionScope actor))))
        (= (nativeGet event "identity_revision") (nativeGet connection "identity_revision" (nativeGet connection "revision")))
        (inspectionScope actor) (can actor "task.inspect" "task-inspection")))))
  (export stageCommand commandPrincipal renderTask renderChildren commandText processCommands taskOutboundAllowed))
