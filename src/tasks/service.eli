(module dj.tasks.service
  (import "../core/native.eli" nativeGet)
  (import "../ingestion/visibility.eli" eventContentAvailable)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" sliceUtf8)
  (import "../application/context.eli" currentPrincipal can must utcNow inTransaction typedRef safeFields requirePermission)
  (import "../policy/principals.eli" configuredPrincipal)
  (defun inspectionScope (context)
    (let* ((config (nativeGet (nativeGet context "config") "task_inspection"))
      (principal (currentPrincipal context)) (id (nativeGet principal "principal_id"))
      (user (js-call (nativeGet config "users" (js-array)) :find (lambda (row) (= (nativeGet row "principal_id") id))))
      (admin (js-call (nativeGet config "administrators" (js-array)) :includes id))
      (connections (js-call (js-call (nativeGet user "connections" (js-array)) :filter (lambda (binding)
        (let ((record (js-call (nativeGet context "repository") :get "connections" (nativeGet binding "connection_id"))))
          (and record (not (nativeGet record "disabled")) (= (nativeGet binding "identity_revision")
            (nativeGet record "identity_revision" (nativeGet record "revision"))))))) :map (lambda (binding) (nativeGet binding "connection_id")))))
      (if (and principal (not (nativeGet principal "disabled")) (or admin (> (js-length connections) 0)))
        (js-object :administrator admin :connection_ids connections) nil)))
  (defun visibleDelivery (context id scope)
    (let* ((repository (nativeGet context "repository")) (delivery (js-call repository :get "deliveries" id))
      (event (and delivery (js-call repository :get "events" (nativeGet delivery "event_id")))))
      (and scope delivery event (= (nativeGet delivery "origin") "subscription_event")
        (or (nativeGet scope "administrator") (js-call (nativeGet scope "connection_ids") :includes (nativeGet event "connection_id"))) delivery)))
  (defun projectTask (context delivery)
    (let* ((repository (nativeGet context "repository"))
      (event (js-call repository :get "events" (nativeGet delivery "event_id")))
      (route (js-call repository :get "routes" (nativeGet delivery "route_id")))
      (session (js-call repository :get "sessions" (nativeGet route "session_key")))
      (working (js-call repository :get "work_items" (nativeGet delivery "delivery_id")))
      (reason (nativeGet working "reason" ""))
      (ended (and (= (nativeGet working "state") "completed") (js-call (js-array "completed" "no_reply" "failed" "cancelled" "replied" "settled" "ended" "turn_finished") :includes reason)))
      (source (Object/assign (js-object) (safeFields (nativeGet event "conversation") (js-array "connection_id" "native_chat_id" "native_thread_id" "thread_kind" "kind" "resource_kind" "resource_token" "table_id" "record_id")) (js-object
        :event_id (nativeGet event "event_id") :native_message_id (nativeGet event "native_message_id")
        :received_at (nativeGet event "received_at") :summary (if (eventContentAvailable context event) (nativeGet (sliceUtf8 (nativeGet (nativeGet event "content") "text" "") 0 240) "text" "") "[正文已过期或不可用]")))))
      (js-object :delivery_id (nativeGet delivery "delivery_id") :event_id (nativeGet event "event_id")
        :source source :tool (nativeGet session "tool" "unknown")
        :session_key (nativeGet route "session_key") :native_session_id (nativeGet session "native_session_id" "")
        :title (nativeGet session "title" "") :state (nativeGet delivery "state")
        :blocked_reason (if (= (nativeGet delivery "state") "accepted") "" (or (nativeGet delivery "blocked_reason") ""))
        :task_state (if ended reason (if (= (nativeGet delivery "state") "accepted") "accepted_not_confirmed_complete" (if (js-call (js-array "ready" "deferred" "blocked") :includes (nativeGet delivery "state")) "queued" (nativeGet delivery "state"))))
        :observed_at (nativeGet session "observed_at" "")
        :runtime_state (nativeGet session "runtime_state" "unknown")
        :runtime_stale (or (not (nativeGet session "observation_expires_at"))
          (<= (Date/parse (nativeGet session "observation_expires_at")) (Date/parse (utcNow context)))))))
  (defun listTasks (context args scope)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (keys (nativeGet scope "connection_ids" (js-array)))
      (parameters (js-array (nativeGet args "after" "")))
      (where (if (nativeGet scope "administrator") "" (str " AND e.connection_id IN ("
        (js-call (js-call keys :map (lambda (key) "?")) :join ",") ")")))
      (limit (nativeGet args "limit" 10)) (items (js-array)))
      (if (and (not (nativeGet scope "administrator")) (= (js-length keys) 0))
        (success (js-object :items items :next_after nil))
        (progn
          (js-call keys :forEach (lambda (key) (unless (nativeGet scope "administrator") (js-call parameters :push key))))
          (js-call parameters :push (1+ limit))
          (let ((rows (js-call (js-call db :query (str
            "SELECT d.payload FROM deliveries d JOIN events e ON e.event_id=d.event_id WHERE d.origin='subscription_event' AND d.delivery_id>?"
            where " ORDER BY d.delivery_id LIMIT ?")) :all parameters)))
            (js-call (js-call rows :slice 0 limit) :forEach (lambda (row)
              (js-call items :push (projectTask context (JSON/parse (nativeGet row "payload"))))))
            (success (js-object :items items :next_after (if (> (js-length rows) limit)
              (nativeGet (aref items (- (js-length items) 1)) "delivery_id") nil))))))))
  (defun taskTree (context args scope)
    (let* ((delivery (visibleDelivery context (nativeGet args "delivery_id") scope))
      (repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db")))
      (if (not delivery) (failure "forbidden")
        (let* ((task (projectTask context delivery)) (root (nativeGet task "session_key"))
          (nodes (js-array (js-object :session_key root :parent_session_key nil :depth 0
            :tool (nativeGet task "tool") :native_session_id (nativeGet task "native_session_id")
            :title (nativeGet task "title") :runtime_state (nativeGet task "runtime_state") :evidence "delivery")))
          (seen (new globalThis.Set (js-array root))) (position 0) (truncated false)
          (depth (nativeGet args "max_depth" 4)))
          (while (and (< position (js-length nodes)) (< (js-length nodes) 128))
            (let* ((parent (aref nodes position))
              (rows (js-call (js-call db :query "SELECT child_session_key FROM task_links WHERE delivery_id=? AND parent_session_key=? ORDER BY child_session_key LIMIT 129")
                :all (nativeGet delivery "delivery_id") (nativeGet parent "session_key"))))
              (if (>= (nativeGet parent "depth") depth)
                (when (> (js-length rows) 0) (setq truncated t))
                (js-call rows :forEach (lambda (row)
                  (let* ((key (nativeGet row "child_session_key")) (session (js-call repository :get "sessions" key)))
                    (if (or (js-call seen :has key) (>= (js-length nodes) 128)) (setq truncated t)
                      (progn (js-call seen :add key)
                        (js-call nodes :push (js-object :session_key key :parent_session_key (nativeGet parent "session_key")
                          :depth (1+ (nativeGet parent "depth")) :tool (nativeGet session "tool" "unknown")
                          :native_session_id (nativeGet session "native_session_id" "") :title (nativeGet session "title" "")
                          :runtime_state (nativeGet session "runtime_state" "unknown") :evidence "reported_unverified")))))))))
            (setq position (1+ position)))
          (success (js-object :task task :nodes nodes :truncated truncated :as_of (utcNow context)
            :children_coverage "reported_only_unknown_children_not_inferred"))))))
  (defun handleOperation (context operation args)
    (let* ((scope (inspectionScope context)) (action (if (= operation "task.link") "task.link" "task.inspect")))
      (if (or (not scope) (not (nativeGet (requirePermission context action "task-inspection") "ok"))) (failure "forbidden")
        (cond ((= operation "task.list") (listTasks context args scope))
          ((= operation "task.tree") (taskTree context args scope))
          (t (let* ((repository (nativeGet context "repository"))
              (delivery (js-call repository :get "deliveries" (nativeGet args "delivery_id")))
              (recipient (= (nativeGet delivery "recipient_principal_id") (nativeGet (currentPrincipal context) "principal_id")))
              (parent (js-call repository :get "sessions" (nativeGet args "parent_session_key")))
              (child (js-call repository :get "sessions" (nativeGet args "child_session_key"))))
            (if (not (and delivery (= (nativeGet delivery "state") "accepted") parent child
                (or (nativeGet scope "administrator") (and recipient (visibleDelivery context (nativeGet args "delivery_id") scope)))
                (nativeGet (requirePermission context "session.inspect" parent) "ok") (nativeGet (requirePermission context "session.inspect" child) "ok"))) (failure "forbidden")
              (js-call context :accept (lambda (tx operation-id)
                (let* ((db (nativeGet tx "db")) (id (nativeGet args "delivery_id"))
                  (root (nativeGet (js-call repository :get "routes" (nativeGet delivery "route_id")) "session_key"))
                  (p (nativeGet parent "session_key")) (c (nativeGet child "session_key"))
                  (existing (js-call (js-call db :query "SELECT parent_session_key FROM task_links WHERE delivery_id=? AND child_session_key=?") :get id c))
                  (known (or (= p root) (js-call (js-call db :query "SELECT 1 AS found FROM task_links WHERE delivery_id=? AND child_session_key=?") :get id p))))
                  (cond ((or (not known) (= c root) (= p c)) (failure "invalid_argument"))
                    ((and (not existing) (>= (nativeGet (js-call (js-call db :query "SELECT COUNT(*) AS n FROM task_links WHERE delivery_id=?") :get id) "n") 127)) (failure "limit_exceeded"))
                    ((and existing (not (= (nativeGet existing "parent_session_key") p))) (failure "revision_conflict"))
                    (t (let ((cursor p) (steps 0) (cycle false))
                      (while (and cursor (< steps 128))
                        (when (= cursor c) (setq cycle t))
                        (setq cursor (nativeGet (js-call (js-call db :query "SELECT parent_session_key FROM task_links WHERE delivery_id=? AND child_session_key=?") :get id cursor) "parent_session_key"))
                        (setq steps (1+ steps)))
                      (if (or cycle cursor) (failure "invalid_argument")
                        (progn (js-call (js-call db :query "INSERT INTO task_links(delivery_id,parent_session_key,child_session_key,reported_by,reported_at) VALUES (?,?,?,?,?) ON CONFLICT(delivery_id,child_session_key) DO NOTHING")
                          :run id p c (nativeGet (currentPrincipal context) "principal_id") (utcNow context))
                          (success (js-object :delivery_id id :parent_session_key p :child_session_key c :evidence "reported_unverified")))))))))
                (lambda (data) (js-array (typedRef "delivery" (nativeGet data "delivery_id"))))))))))))
  (defun projectTaskLink (context data)
    (let* ((scope (inspectionScope context))
      (delivery (visibleDelivery context (nativeGet data "delivery_id") scope))
      (repository (nativeGet context "repository"))
      (parent (js-call repository :get "sessions" (nativeGet data "parent_session_key")))
      (child (js-call repository :get "sessions" (nativeGet data "child_session_key"))))
      (if (and delivery parent child (can context "task.link" "task-inspection")
        (or (nativeGet scope "administrator") (= (nativeGet delivery "recipient_principal_id") (nativeGet (currentPrincipal context) "principal_id")))
        (can context "session.inspect" parent) (can context "session.inspect" child))
        (success data) (failure "forbidden"))))
  (export inspectionScope visibleDelivery projectTask listTasks taskTree handleOperation projectTaskLink))
