(module dj.routing.matcher
  (import "../core/types.eli" sourceContainer stableJson utf8Bytes)
  (import "../connections/echo.eli" echoState)
  (import "../core/native.eli" nativeNullish nativeTypeOf nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/limits.eli" limits)
  (import "../triggers/rules.eli" rulesUsePerson evaluateSubscriptionRules)
  (import "../application/context.eli" inTransaction must)
  (import "../delivery/service.eli" planDelivery)
  (import "../delivery/planning-scope.eli" withEventPlans)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../delivery/group-dispatch.eli" queueGroupDispatch)
  (defconst storeVersionCaches (new globalThis.WeakMap))
  (defun storeVersionCache (context)
    (let* ((store (nativeGet context "store"))
           (existing (and store (js-call storeVersionCaches :get store))))
      (if existing
        existing
        (let ((created (js-object :entries (new globalThis.Map) :bytes 0)))
          (when store (js-call storeVersionCaches :set store created))
          created))))
  (defun targetRank (target-key)
    (if (and (= (nativeTypeOf target-key) "string") (js-call target-key :startsWith "session:")) 0 1))
  (defun targetBeforeOrEqual (one two)
    (let ((r1 (targetRank (nativeGet one "target_key")))
          (r2 (targetRank (nativeGet two "target_key"))))
      (or (< r1 r2)
          (and (= r1 r2)
               (or (< (nativeGet one "target_key") (nativeGet two "target_key"))
                   (and (= (nativeGet one "target_key") (nativeGet two "target_key"))
                        (<= (nativeGet one "revision") (nativeGet two "revision"))))))))
  (defun compiledVersion (context row)
    (let ((djReturn1Token (js-object)) (djReturn1Value nil))
      (try
        (let* ((cache (storeVersionCache context))
               (entries (nativeGet cache "entries"))
               (key (str (nativeGet row "target_key") ":" (nativeGet row "revision")))
               (cached (js-call entries :get key)))
          (when cached
            (js-call entries :delete key)
            (js-call entries :set key cached)
            (progn (setq djReturn1Value (nativeGet cached "value")) (throw djReturn1Token)))
          (let* ((text (or (nativeGet row "payload")
                           (nativeGet
                             (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                               "SELECT payload FROM subscription_versions WHERE target_key=? AND revision=?")
                               :get (nativeGet row "target_key") (nativeGet row "revision"))
                             "payload")))
                 (bytes (utf8Bytes text))
                 (version (JSON/parse text)))
            (while (and (> (nativeGet entries "size") 0)
                        (or (>= (nativeGet entries "size") (nativeGet limits "compiled_rule_cache_entries"))
                            (> (+ (nativeGet cache "bytes") bytes) (nativeGet limits "compiled_rule_cache_bytes"))))
              (let* ((oldest (nativeGet (js-call (js-call entries :keys) :next) "value"))
                     (entry (js-call entries :get oldest)))
                (put cache :bytes (- (nativeGet cache "bytes") (nativeGet entry "bytes")))
                (js-call entries :delete oldest)))
            (when (<= bytes (nativeGet limits "compiled_rule_cache_bytes"))
              (js-call entries :set key (js-object :value version :bytes bytes))
              (put cache :bytes (+ (nativeGet cache "bytes") bytes)))
            version))
        (catch djReturn1Error
          (if (eq djReturn1Error djReturn1Token) djReturn1Value (throw djReturn1Error))))))
  (defun candidateSliceRows (db event prefix-lo prefix-hi after revision limit)
    (let* ((address (nativeGet event "conversation"))
           (thread-key (stableJson (nativeGet address "native_thread_id" nil)))
           (sql
             "SELECT i.target_key,i.revision FROM subscription_sources i JOIN subscription_versions v ON v.target_key=i.target_key AND v.revision=i.revision WHERE i.connection_id=? AND i.native_chat_id IN (?, '') AND i.event_kind=? AND i.thread_key=? AND (?=0 OR i.include_threads=1) AND i.target_key>=? AND i.target_key<? AND (i.target_key>? OR (i.target_key=? AND i.revision>?)) AND v.state='active' AND v.start_seq<=? AND (v.cutover_seq IS NULL OR v.cutover_seq>=?) ORDER BY i.target_key,i.revision LIMIT ?")
           (exact
             (js-call (js-call db :query sql) :all
               (nativeGet event "connection_id")
               (sourceContainer address)
               (nativeGet event "event_kind")
               thread-key
               0
               prefix-lo
               prefix-hi
               after
               after
               revision
               (nativeGet event "ingress_seq")
               (nativeGet event "ingress_seq")
               limit))
           (parent
             (if (nativeNullish (nativeGet address "native_thread_id"))
               (js-array)
               (js-call (js-call db :query sql) :all
                 (nativeGet event "connection_id")
                 (sourceContainer address)
                 (nativeGet event "event_kind")
                 "null"
                 1
                 prefix-lo
                 prefix-hi
                 after
                 after
                 revision
                 (nativeGet event "ingress_seq")
                 (nativeGet event "ingress_seq")
                 limit)))
           (rows (js-array))
           (a 0)
           (b 0)
           (seen (new globalThis.Set)))
      (while (and (< (js-length rows) limit)
                  (or (< a (js-length exact)) (< b (js-length parent))))
        (let* ((one (aref exact a))
               (two (aref parent b))
               (choose-a (or (not two) (and one (targetBeforeOrEqual one two))))
               (row (if choose-a one two))
               (key (str (nativeGet row "target_key") ":" (nativeGet row "revision"))))
          (if choose-a (setq a (1+ a)) (setq b (1+ b)))
          (unless (js-call seen :has key)
            (js-call seen :add key)
            (js-call rows :push row))))
      rows))
  (defun candidateRows (context work event maximum)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
           (after (or (nativeGet work "last_target_key") ""))
           (after-rank (if (= after "") -1 (targetRank after)))
           (revision (or (nativeGet work "last_revision") 0))
           (wanted (1+ maximum))
           (rows (if (<= after-rank 0)
                   (candidateSliceRows db event "session:" "session;"
                     (if (= after-rank 0) after "") (if (= after-rank 0) revision 0) wanted)
                   (js-array))))
      (when (< (js-length rows) wanted)
        (let ((group-rows
                (candidateSliceRows db event "group:" "group;"
                  (if (= after-rank 1) after "") (if (= after-rank 1) revision 0)
                  (- wanted (js-length rows)))))
          (js-call group-rows :forEach (lambda (row) (js-call rows :push row)))))
      rows))
  (defun publishMatchMetrics (context meter started cpu-ms position)
    (let ((runtime (nativeGet context "runtime")))
      (when runtime
        (put runtime :max_match_batch_candidates
          (Math/max (nativeGet runtime "max_match_batch_candidates" 0) position))
        (unless (nativeGet runtime "routing_samples")
          (put runtime :routing_samples (js-array)))
        (let ((samples (nativeGet runtime "routing_samples")))
          (when (>= (js-length samples) (nativeGet limits "routing_sample_count"))
            (js-call samples :shift))
          (js-call samples :push (- (js-call meter :monoNow) started)))
        (unless (nativeNullish cpu-ms)
          (unless (nativeGet runtime "routing_cpu_samples")
            (put runtime :routing_cpu_samples (js-array)))
          (let ((samples (nativeGet runtime "routing_cpu_samples")))
            (when (>= (js-length samples) (nativeGet limits "routing_sample_count"))
              (js-call samples :shift))
            (js-call samples :push cpu-ms))))))
  (defasync matchWithWriter (context routing-checkpoint budget write &optional capacity-state)
    (let ((djReturn2Token (js-object)) (djReturn2Value nil))
      (try
        (let* ((repository (nativeGet context "repository"))
               (event-id (if (= (nativeTypeOf routing-checkpoint) "string")
                 routing-checkpoint
                 (nativeGet routing-checkpoint "event_id")))
               (work (js-call repository :get "routing_work" event-id))
               (event (js-call repository :get "events" event-id))
               (maximum (Math/min (nativeGet limits "match_batch_candidates")
                 (nativeGet budget "max_candidates" (nativeGet limits "match_batch_default_candidates"))))
               (connection nil)
               (meter (nativeGet (nativeGet context "ports") "measurement" (nativeGet (nativeGet context "ports") "clock")))
               (started (js-call meter :monoNow)))
          (unless (and work event)
            (progn (setq djReturn2Value (failure "not_found")) (throw djReturn2Token)))
          (when (= (nativeGet work "state") "done")
            (progn (setq djReturn2Value (success work)) (throw djReturn2Token)))
          (setq connection (js-call repository :get "connections" (nativeGet event "connection_id")))
          (let ((echo (echoState context event)))
            (unless (= echo "clear")
              (setq djReturn2Value
                (funcall write (lambda (tx)
                  (put work :state (if (= echo "held") "held" "done"))
                  (put work :reason (if (= echo "held") "echo_gate" "own_echo"))
                  (must (js-call repository :replace "routing_work" work))
                  (success work))))
              (throw djReturn2Token)))
          (let* ((cpu-start (and (nativeGet meter "cpuNow") (js-call meter :cpuNow)))
                 (rows (candidateRows context work event maximum))
                 (prepared (js-array))
                 (memo (new globalThis.Map (nativeGet work "predicate_memo" (js-array))))
                 (characters 0)
                 (yielded false)
                 (index 0)
                 (cpu-ms nil)
                 (meter-budget
                   (js-object
                     :visit
                     (lambda (count)
                       (when (> (+ characters count) (nativeGet limits "match_character_visits"))
                         (let ((error (new globalThis.Error "routing turn budget exhausted")))
                           (put error :code "routing_budget_exhausted")
                           (throw error)))
                       (setq characters (+ characters count))))))
            (let ((djLoop1Break (js-object)))
              (try
                (while (< index (Math/min maximum (js-length rows)))
                  (let* ((row (aref rows index))
                         (version (compiledVersion context row)))
                    (try
                      (let ((evaluated (evaluateSubscriptionRules context version event connection memo meter-budget)))
                        (js-call prepared :push (js-object :version version :evaluated evaluated)))
                      (catch error
                        (when (eq error djLoop1Break) (throw error))
                        (when (eq error djReturn2Token) (throw error))
                        (if (= (nativeGet error "code") "routing_budget_exhausted")
                          (setq yielded t)
                          (throw error)))))
                  (when yielded (throw djLoop1Break))
                  (setq index (1+ index)))
                (catch djLoop1Error
                  (unless (eq djLoop1Error djLoop1Break) (throw djLoop1Error)))))
            (unless (nativeNullish cpu-start)
              (setq cpu-ms (/ (- (js-call meter :cpuNow) cpu-start) 1000)))
            (when (nativeGet (nativeGet context "ports") "faults")
              (await (js-call (nativeGet (nativeGet context "ports") "faults")
                :hit "routing.before_checkpoint_commit" work)))
            (let* ((target-keys
                     (js-call (js-call prepared :filter
                       (lambda (plan) (= (nativeGet (nativeGet plan "evaluated") "result") "match")))
                       :map (lambda (plan) (nativeGet (nativeGet plan "version") "target_key"))))
                   (result (await (funcall write (lambda (tx)
                     (withEventPlans context event (lambda (planning)
                       (let ((djReturn3Token (js-object)) (djReturn3Value nil))
                         (try
                           (let* ((current (js-call repository :get "routing_work" event-id))
                                  (db (nativeGet tx "db"))
                                  (state-map (new globalThis.Map))
                                  (read-cache (new globalThis.Map))
                                  (position 0)
                                  (blocked false)
                                  (needs-unlock false)
                                  (decisions (js-array))
                                  (echo (echoState context event)))
                             (unless (and (= (nativeGet current "last_target_key" nil) (nativeGet work "last_target_key" nil))
                                          (= (nativeGet current "last_revision" nil) (nativeGet work "last_revision" nil)))
                               (progn (setq djReturn3Value (failure "revision_conflict")) (throw djReturn3Token)))
                             (unless (= echo "clear")
                               (put current :state (if (= echo "held") "held" "done"))
                               (put current :reason (if (= echo "held") "echo_gate" "own_echo"))
                               (js-call planning :finish (nativeGet current "state"))
                               (must (js-call repository :replace "routing_work" current))
                               (progn (setq djReturn3Value (success current)) (throw djReturn3Token)))
                             (when (> (js-length target-keys) 0)
                               (js-call target-keys :forEach (lambda (tk) (js-call state-map :set tk nil)))
                               (js-call (js-call repository :getSubscriptionStates target-keys) :forEach
                                 (lambda (row) (js-call state-map :set (nativeGet row "target_key") row))))
                             (let ((read (lambda (table key)
                                     (if (= table "subscriptions")
                                       (if (js-call state-map :has key)
                                         (js-call state-map :get key)
                                         (js-call repository :getSubscriptionState key))
                                       (let ((ckey (str table ":" key)))
                                         (if (js-call read-cache :has ckey)
                                           (js-call read-cache :get ckey)
                                           (let ((rec (js-call repository :get table key)))
                                             (when (< (nativeGet read-cache "size") 256)
                                               (js-call read-cache :set ckey rec))
                                             rec))))))
                                   (djLoop2Break (js-object)))
                               (try
                                 (while (< position (js-length prepared))
                                   (let* ((plan (aref prepared position))
                                          (version (nativeGet plan "version"))
                                          (evaluated
                                            (if (rulesUsePerson (nativeGet version "resolved_rules"))
                                              (evaluateSubscriptionRules context version event connection)
                                              (nativeGet plan "evaluated")))
                                          (verdict (nativeGet evaluated "result"))
                                          (decision
                                            (js-object
                                              :event_id event-id
                                              :target_key (nativeGet version "target_key")
                                              :revision (nativeGet version "revision")
                                              :result verdict
                                              :matched_rule_ids (nativeGet evaluated "matched_rule_ids")
                                              :context_policy (nativeGet evaluated "context_policy")
                                              :instruction_policies (nativeGet evaluated "instruction_policies")
                                              :reason_codes
                                              (js-array (if (= verdict "indeterminate") "source_incomplete" "literal_predicate")))))
                                     (when (>= (js-length decisions) 128)
                                       (throw (new globalThis.TypeError "event decision buffer exhausted")))
                                     (js-call decisions :push decision)
                                     (when (= verdict "match")
                                       (let ((planned
                                               (if (nativeGet version "group_id")
                                                 (queueGroupDispatch tx event version decision)
                                                 (planDelivery tx event version decision read planning))))
                                         (unless (nativeGet planned "ok")
                                           (if (= (nativeGet (nativeGet planned "error") "code") "limit_exceeded")
                                             (setq blocked t)
                                             (progn (setq djReturn3Value planned) (throw djReturn3Token))))))
                                     (when blocked (throw djLoop2Break))
                                     (put current :last_target_key (nativeGet version "target_key"))
                                     (put current :last_revision (nativeGet version "revision")))
                                   (setq position (1+ position)))
                                 (catch djLoop2Error
                                   (unless (eq djLoop2Error djLoop2Break) (throw djLoop2Error)))))
                             (put current :predicate_memo (Array/from (js-call memo :entries)))
                             (put current :state
                               (cond (blocked "blocked")
                                 ((or yielded (< position (js-length rows))) "ready")
                                 (t "done")))
                             (put current :reason (if blocked "delivery_capacity" nil))
                             (setq needs-unlock (js-call planning :finish (nativeGet current "state")))
                             (js-call repository :insertManyIfAbsent "match_decisions" decisions)
                             (must (js-call repository :replace "routing_work" current))
                             (when needs-unlock
                               (js-call (js-call db :query
                                 "UPDATE deliveries SET state='ready',revision=revision+1,payload=json_set(payload,'$.state','ready','$.revision',revision+1,'$.blocked_reason',NULL) WHERE event_id=? AND origin='subscription_event' AND state='blocked' AND json_extract(payload,'$.blocked_reason')='routing_incomplete'")
                                 :run event-id))
                             (success
                               (js-object
                                 :event_id event-id
                                 :state (nativeGet current "state")
                                 :processed_candidates position
                                 :character_visits characters
                                 :complete (= (nativeGet current "state") "done"))))
                           (catch djReturn3Error
                             (if (eq djReturn3Error djReturn3Token) djReturn3Value (throw djReturn3Error))))))
                       (and (nativeNullish (nativeGet work "last_target_key"))
                            (not yielded)
                            (= (js-length prepared) (js-length rows)))
                       t
                       capacity-state))))))
              (when (nativeGet result "ok")
                (publishMatchMetrics context meter started cpu-ms
                  (nativeGet (nativeGet result "data") "processed_candidates" 0)))
              result)))
        (catch djReturn2Error
          (if (eq djReturn2Error djReturn2Token) djReturn2Value (throw djReturn2Error))))))
  (defasync matchBatch (context routing-checkpoint &optional budget)
    (await (matchWithWriter context routing-checkpoint budget
      (lambda (mutate) (inTransaction context mutate)))))
  (defasync matchTurn (context works &optional budget)
    (let ((djTurnReturn (js-object)) (djTurnValue nil) (capacity-state nil))
      (try
        (unless (and (Array/isArray works) (<= (js-length works) 16))
          (setq djTurnValue (failure "invalid_argument"))
          (throw djTurnReturn))
        (when (= (js-length works) 0)
          (setq djTurnValue (success (js-array)))
          (throw djTurnReturn))
        (unless (and (nativeGet context "runtime")
                     (not (js-call (nativeGet context "store") :inTransaction)))
          (setq djTurnValue (failure "invalid_transaction"))
          (throw djTurnReturn))
        (setq capacity-state (Object/seal (js-object :store (nativeGet context "store") :count nil :active t)))
        (let ((slots (js-array)))
          (js-call works :forEach (lambda (work)
            (let ((slot (js-object :queued false :prepare_failed false)))
              (put slot :ready (new globalThis.Promise (lambda (resolve reject) (put slot :ready_resolve resolve))))
              (put slot :execution (js-call
                (matchWithWriter context work budget (lambda (mutate)
                  (when (nativeGet slot "queued")
                    (throw (new globalThis.TypeError "matching write was already prepared")))
                  (put slot :queued t)
                  (put slot :mutate mutate)
                  (let ((waiting (new globalThis.Promise (lambda (resolve reject) (put slot :finish resolve)))))
                    (js-call slot :ready_resolve)
                    waiting)) capacity-state)
                :then
                (lambda (result)
                  (unless (nativeGet slot "queued") (js-call slot :ready_resolve))
                  result)
                (lambda (error)
                  (put slot :prepare_failed t)
                  (js-call slot :ready_resolve)
                  (failure "unavailable"))))
              (js-call slots :push slot))))
          (await (Promise/all (js-call slots :map (lambda (slot) (nativeGet slot "ready")))))
          (if (js-call slots :some (lambda (slot) (nativeGet slot "prepare_failed")))
            (progn
              (js-call slots :forEach (lambda (slot)
                (when (nativeGet slot "queued") (js-call slot :finish (failure "unavailable")))))
              (await (Promise/all (js-call slots :map (lambda (slot) (nativeGet slot "execution")))))
              (failure "unavailable"))
            (progn
              (js-call slots :forEach (lambda (slot)
                (when (nativeGet slot "queued")
                  (js-call (js-call
                    (enqueueWrite context (lambda () (inTransaction context (nativeGet slot "mutate"))))
                    :then (lambda (result) (js-call slot :finish result)))
                    :catch (lambda (error) (js-call slot :finish (failure "storage_unavailable")))))))
              (let* ((results (await (Promise/all (js-call slots :map (lambda (slot) (nativeGet slot "execution"))))))
                     (fatal (js-call results :find (lambda (result)
                       (and (not (nativeGet result "ok"))
                            (js-call (js-array "storage_unavailable" "capacity_exceeded" "unavailable")
                              :includes (nativeGet (nativeGet result "error") "code")))))))
                (or fatal (success results))))))
        (catch error
          (if (eq error djTurnReturn) djTurnValue (throw error)))
        (finally
          (when capacity-state
            (put capacity-state :count nil)
            (put capacity-state :active false))))))
  (export matchBatch matchTurn candidateRows))
