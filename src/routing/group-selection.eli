(module dj.routing.group-selection
  (import "../core/native.eli" nativeGet)
  (defun distributionPolicy (config requested)
    (let ((defaults (nativeGet config "group_distribution")))
      (js-object :algorithm (nativeGet requested "algorithm" (nativeGet defaults "algorithm" "round_robin"))
        :eligibility (js-object :quota (nativeGet (nativeGet requested "eligibility") "quota"
          (nativeGet (nativeGet defaults "eligibility") "quota" "exclude_exhausted"))))))
  (defun quotaEligible (policy state)
    (cond ((= policy "ignore") t) ((= policy "require_available") (= state "available"))
      (t (not (= state "exhausted")))))
  (defun chooseGroupMember (members algorithm last-id random-index)
    (let ((ordered (js-call (js-call members :slice) :sort (lambda (a b)
      (let ((aa (nativeGet a "agent_id")) (bb (nativeGet b "agent_id")))
        (if (= aa bb) 0 (if (< aa bb) -1 1)))))))
      (when (> (js-length ordered) 0)
        (cond
          ((= algorithm "random")
            (unless (and (Number/isSafeInteger random-index) (>= random-index 0) (< random-index (js-length ordered)))
              (throw (new globalThis.TypeError "random group index outside candidate set")))
            (aref ordered random-index))
          ((= algorithm "priority")
            (aref (js-call ordered :sort (lambda (a b)
              (- (nativeGet a "priority" 0) (nativeGet b "priority" 0)))) 0))
          ((= algorithm "round_robin")
            (or (js-call ordered :find (lambda (member) (> (nativeGet member "agent_id") (or last-id ""))))
              (aref ordered 0)))
          (t (throw (new globalThis.TypeError "unknown group algorithm")))))))
  (export distributionPolicy quotaEligible chooseGroupMember))
