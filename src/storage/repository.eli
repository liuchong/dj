    "attempt_id delivery_id outbound_id lifecycle_id dispatch_key state definite_not_sent")
  (defineTable
    "receipts"
    "receipt_id"
    "receipt_id attempt_id native_receipt_key kind evidence_level")
  (defineTable "claims" "route_id" "route_id claim_owner claim_epoch")
  (defineTable
    "reply_contexts"
    "reply_context_id"
    "reply_context_id delivery_id recipient_principal_id expires_at")
  (defineTable
    "echo_gates"
    "connection_id conversation_key outbound_id"
    "connection_id conversation_key outbound_id")
  (defineTable
    "catalog_runs"
    "catalog_run_id"
    "catalog_run_id operation_id principal_id authorization_revision state")
  (defineTable
    "catalog_checkpoints"
    "catalog_run_id source_id"
    "catalog_run_id source_id")
  (defineTable
    "session_messages"
    "message_key"
    "message_key session_key native_message_id content_version catalog_seq acquired_at expires_at tombstone body_bytes")
  (defineTable
    "text_documents"
    "document_id"
    "document_id session_key message_key field content_version catalog_seq body_bytes")
  (defineTable
    "query_snapshots"
    "snapshot_id"
    "snapshot_id principal_id authorization_revision catalog_seq expires_at state")
  (defineTable
    "snapshot_results"
    "snapshot_id ordinal"
    "snapshot_id ordinal resource_key content_version")
  (defun tableInfo
    (name)
    (unless (object-has? tables name)
      (throw (new globalThis.TypeError "unknown internal repository table")))
    (nativeGet tables name))
  (defun sqlValue
    (record column)
    (let
      (
        (value
          (if (and (= column "tool_id") (not (object-has? record column)))
            (nativeGet record "tool")
            (nativeGet record column))))
      (cond ((undefined? value) nil)
        ((= (nativeTypeOf value) "boolean") (if value 1 0))
        (t value))))
  (defun keyObject
    (info key)
    (if (= (nativeTypeOf key) "string")
      (let ((record (js-object)))
        (unless (= (js-length (nativeGet info "keys")) 1)
          (throw (new globalThis.TypeError "composite repository key required")))
        (put record (aref (nativeGet info "keys") 0) key)
        record)
      key))
  (defun createRepository
    (store)
    (let ((db (nativeGet store "db")) (repository (js-object)))
      (let
        ((assertTransaction nil)
          (getRecord nil)
          (getSubscriptionState nil)
          (getSubscriptionStates nil)
          (insertRecord nil)
          (insertMany nil)
          (insertIfAbsent nil)
          (insertManyIfAbsent nil)
          (replaceRecord nil)
          (replaceProgress nil)
          (deleteRecord nil)
          (readRecords nil))
        (setq
          assertTransaction
          (lambda
            ()
            (unless (js-call store :inTransaction)
              (throw
                (new
                  globalThis.Error
                  "repository mutation requires the current transaction")))))
        (setq
          getRecord
          (lambda
            (table key)
            (let* ((info (tableInfo table))
              (record (keyObject info key))
              (values (js-call (nativeGet info "keys") :map
                (lambda (column) (sqlValue record column))))
              (row (js-call (js-call db :query (nativeGet info "select_sql")) :get values)))
              (when row (JSON/parse (nativeGet row "payload"))))))
        (setq
          getSubscriptionState
          (lambda (subscription-id)
            (unless (and (= (nativeTypeOf subscription-id) "string")
              (> (js-length subscription-id) 0))
              (throw (new globalThis.TypeError "subscription state requires a nonempty identifier")))
            (or (js-call (js-call db :query
              "SELECT subscription_id,owner_principal_id,state,revision FROM subscriptions WHERE subscription_id=?")
              :get subscription-id) nil)))
        (setq
          getSubscriptionStates
          (lambda (ids)
            (unless (and (js-call store :inTransaction) (Array/isArray ids)
              (<= (js-length ids) 128))
              (throw (new globalThis.TypeError "subscription batch requires a bounded synchronous transaction")))
            ;; Validate every requested key before executing even the first block.
            (let ((index 0))
              (while (< index (js-length ids))
                (unless (and (object-has? ids index)
                  (= (nativeTypeOf (aref ids index)) "string")
                  (> (js-length (aref ids index)) 0))
                  (throw (new globalThis.TypeError "subscription batch requires dense nonempty identifiers")))
                (setq index (1+ index))))
            (let ((keys (Array/from (new globalThis.Set ids)))
              (start 0) (rows (js-array)))
              (while (< start (js-length keys))
                (let ((count (Math/min 16 (- (js-length keys) start))))
                  (js-call
                    (js-call (js-call db :query (aref subscriptionStateSql count))
                      :all (js-call keys :slice start (+ start count)))
                    :forEach (lambda (row) (js-call rows :push row)))
                  (setq start (+ start count))))
              rows)))
        (setq
          insertRecord
          (lambda
            (table record)
            (assertTransaction)
            (let* ((info (tableInfo table))
              (values (js-call (nativeGet info "columns") :map
                (lambda (column) (sqlValue record column)))))
              (js-call values :push (stableJson record))
              (js-call (js-call db :query (nativeGet info "insert_sql")) :run values)
              record)))
        (setq
          insertIfAbsent
          (lambda
            (table record)
            (assertTransaction)
            (unless (js-call (js-array "match_decisions" "contributions") :includes table)
              (throw (new globalThis.TypeError "unsupported insert-if-absent table")))
            (let* ((info (tableInfo table))
              (values (js-call (nativeGet info "columns") :map
                (lambda (column) (sqlValue record column)))))
              (js-call values :push (stableJson record))
              ;; Only the declared primary-key conflict is a duplicate. Other
              ;; constraints still throw and are handled by the enclosing write.
              (= (nativeGet (js-call
                (js-call db :query (nativeGet info "insert_if_absent_sql")) :run values) "changes") 1))))
        (setq
          insertMany
          (lambda (table records)
            (assertTransaction)
            (unless (and (= table "deliveries") (Array/isArray records)
              (<= (js-length records) 128))
              (throw (new globalThis.TypeError "invalid strict delivery batch")))
            (let ((index 0))
              ;; Validate every block's shape before issuing the first INSERT.
              (while (< index (js-length records))
                (let ((record (aref records index)))
                  (unless (and (object-has? records index)
                    (not (nativeNullish record))
                    (= (nativeTypeOf record) "object")
                    (not (Array/isArray record)))
                    (throw (new globalThis.TypeError "delivery batch requires dense object rows"))))
                (setq index (1+ index))))
            (let ((info (tableInfo table)) (start 0) (inserted 0))
              (while (< start (js-length records))
                (let ((count (Math/min 16 (- (js-length records) start)))
                  (offset 0) (values (js-array)))
                  (while (< offset count)
                    (let ((record (aref records (+ start offset))))
                      (js-call (nativeGet info "columns") :forEach
                        (lambda (column) (js-call values :push (sqlValue record column))))
                      (js-call values :push (stableJson record)))
                    (setq offset (1+ offset)))
                  ;; Strict INSERT: all uniqueness and other constraints throw.
                  ;; Atomicity across blocks belongs to the enclosing write item.
                  (setq inserted (+ inserted (nativeGet
                    (js-call (js-call db :query
                      (aref (nativeGet info "batch_insert_strict_sql") count)) :run values)
                    "changes")))
                  (setq start (+ start count))))
              inserted)))
        (setq
          insertManyIfAbsent
          (lambda (table records)
            (assertTransaction)
            (unless (and
              (js-call (js-array "match_decisions" "contributions") :includes table)
              (Array/isArray records)
              (<= (js-length records) 128))
              (throw (new globalThis.TypeError "invalid bounded insert batch")))
            (let ((index 0))
              ;; Validate the entire batch before the first SQL statement, even
              ;; when a hole or malformed row belongs to a later block.
              (while (< index (js-length records))
                (let ((record (aref records index)))
                  (unless (and (object-has? records index)
                    (not (nativeNullish record))
                    (= (nativeTypeOf record) "object")
                    (not (Array/isArray record)))
                    (throw (new globalThis.TypeError "insert batch requires dense object rows"))))
                (setq index (1+ index))))
            (let ((info (tableInfo table)) (start 0) (inserted 0))
              (while (< start (js-length records))
                (let ((count (Math/min 16 (- (js-length records) start)))
                  (offset 0) (values (js-array)))
                  (while (< offset count)
                    (let ((record (aref records (+ start offset))))
                      (js-call (nativeGet info "columns") :forEach
                        (lambda (column) (js-call values :push (sqlValue record column))))
                      (js-call values :push (stableJson record)))
                    (setq offset (1+ offset)))
                  (setq inserted (+ inserted (nativeGet
                    (js-call (js-call db :query (aref (nativeGet info "batch_insert_sql") count)) :run values)
                    "changes")))
                  (setq start (+ start count))))
              inserted)))
        (setq
          replaceRecord
          (lambda
            (table record &optional expected-revision)
            (assertTransaction)
            (let* ((info (tableInfo table))
              (values (js-call (nativeGet info "update_columns") :map
                (lambda (column) (sqlValue record column))))
              (guarded (not (nativeNullish expected-revision))))
              (js-call values :push (stableJson record))
              (js-call (nativeGet info "keys") :forEach
                (lambda (column) (js-call values :push (sqlValue record column))))
              (when guarded
                (unless (js-call (nativeGet info "columns") :includes "revision")
                  (throw (new globalThis.TypeError "revision guard on a nonrevisioned table")))
                (js-call values :push expected-revision))
              (let ((result (js-call
                (js-call db :query (nativeGet info (if guarded "update_revision_sql" "update_sql")))
                :run values)))
                (if (= (nativeGet result "changes") 1)
                  (success record)
                  (failure "revision_conflict"))))))
        (setq
          replaceProgress
          (lambda (table record &optional expected-revision)
            (assertTransaction)
            (unless (js-call (js-array "deliveries" "attempts" "routes") :includes table)
              (throw (new globalThis.TypeError "unsupported progress update table")))
            (let* ((info (tableInfo table))
              (guarded (not (nativeNullish expected-revision))))
              (when (and guarded (not (js-call (nativeGet info "columns") :includes "revision")))
                (throw (new globalThis.TypeError "revision guard on a nonrevisioned table")))
              (let ((values (js-call (nativeGet info "progress_columns") :map
                (lambda (column) (sqlValue record column)))))
                (js-call values :push (stableJson record))
                (js-call (nativeGet info "keys") :forEach
                  (lambda (column) (js-call values :push (sqlValue record column))))
                ;; Omitted typed columns must still agree with the complete payload.
                (js-call (nativeGet info "progress_invariants") :forEach
                  (lambda (column) (js-call values :push (sqlValue record column))))
                (when guarded (js-call values :push expected-revision))
                (let ((result (js-call (js-call db :query
                  (nativeGet info (if guarded "progress_revision_sql" "progress_sql"))) :run values)))
                  (if (= (nativeGet result "changes") 1)
                    (success record)
                    (failure "revision_conflict")))))))
        (setq
          deleteRecord
          (lambda
            (table key)
            (assertTransaction)
            (let* ((info (tableInfo table))
              (record (keyObject info key)))
              (js-call (js-call db :query (nativeGet info "delete_sql")) :run
                (js-call (nativeGet info "keys") :map
                  (lambda (column) (sqlValue record column)))))))
        (setq
          readRecords
          (lambda
            (table &optional options)
            (let*
              ((info (tableInfo table))
                (columns (nativeGet info "columns"))
                (filters (nativeGet options "filters" (js-object)))
                (clauses (js-array))
                (values (js-array))
                (limit (nativeGet options "limit" 100))
                (sort (nativeGet options "sort" (aref (nativeGet info "keys") 0))))
              (unless
                (and
                  (Number/isSafeInteger limit)
                  (> limit 0)
                  (<= limit 1000)
                  (js-call columns :includes sort))
                (throw (new globalThis.TypeError "invalid internal bounded page")))
              (js-call
                (Object/keys filters)
                :forEach
                (lambda
                  (column)
                  (unless (js-call columns :includes column)
                    (throw (new globalThis.TypeError "unknown internal filter column")))
                  (let ((value (nativeGet filters column)))
                    (cond
                      ((nativeNullish value)
                        (js-call clauses :push (str column " IS NULL")))
                      ((Array/isArray value)
                        (unless (and (> (js-length value) 0) (<= (js-length value) 100))
                          (throw
                            (new
                              globalThis.TypeError
                              "internal filter array is outside the bounded scope")))
                        (js-call
                          clauses
                          :push
                          (str
                            column
                            " IN ("
                            (js-call (js-call value :map (lambda (item) "?")) :join ",")
                            ")"))
                        (js-call
                          value
                          :forEach
                          (lambda (item) (js-call values :push item))))
                      (t
                        (js-call clauses :push (str column "=?"))
                        (js-call values :push value))))))
              (when (object-has? options :after_key)
                (js-call clauses :push (str sort ">?"))
                (js-call values :push (nativeGet options "after_key")))
              (js-call values :push limit)
              (js-call
                (js-call
                  (js-call
                    db
                    :query
                    (str
                      "SELECT payload FROM "
                      table
                      (if (> (js-length clauses) 0)
                        (str " WHERE " (js-call clauses :join " AND "))
                        "")
                      " ORDER BY "
                      sort
                      " ASC LIMIT ?"))
                  :all
                  values)
                :map
                (lambda (row) (JSON/parse (nativeGet row "payload")))))))
        (Object/assign
          repository
          (js-object
            :get
            getRecord
            :getSubscriptionState
            getSubscriptionState
            :getSubscriptionStates
            getSubscriptionStates
            :insert
            insertRecord
            :insertMany
            insertMany
            :insertIfAbsent
            insertIfAbsent
            :insertManyIfAbsent
            insertManyIfAbsent
            :replace
            replaceRecord
            :replaceProgress
            replaceProgress
            :delete
            deleteRecord
            :page
            readRecords
            :store
            store
            :nextSequence
            (lambda
              (name)
              (assertTransaction)
              (unless (js-call (js-array "ingress" "catalog") :includes name)
                (throw (new globalThis.TypeError "unknown exact sequence")))
              (let
                (
                  (row
                    (js-call
                      (js-call
                        db
                        :query
                        "UPDATE counters SET value=value+1 WHERE name=? AND value<9223372036854775807 RETURNING CAST(value AS TEXT) AS value")
                      :get
                      name)))
                (unless row
                  (throw (new globalThis.RangeError "durable sequence exhausted")))
                (encodeSeq (nativeGet row "value"))))
            :currentSequence
            (lambda
              (name)
              (let
                (
                  (row
                    (js-call
                      (js-call
                        db
                        :query
                        "SELECT CAST(value AS TEXT) AS value FROM counters WHERE name=?")
                      :get
                      name)))
                (unless row (throw (new globalThis.TypeError "unknown exact sequence")))
                (encodeSeq (nativeGet row "value"))))
            :lookupOperation
            (lambda
              (principal operation key-hash)
              (let
                (
                  (row
                    (js-call
                      (js-call
                        db
                        :query
                        "SELECT payload FROM operations WHERE principal_id=? AND operation=? AND key_hash=?")
                      :get
                      principal
                      operation
                      key-hash)))
                (when row (JSON/parse (nativeGet row "payload")))))
            :recordIdempotency
            (lambda
              (record)
              (assertTransaction)
              (js-call
                (js-call
                  db
                  :query
                  "INSERT INTO idempotency(principal_id,operation,key_hash,request_hash,operation_id) VALUES (?,?,?,?,?)")
                :run
                (nativeGet record "principal_id")
                (nativeGet record "operation")
                (nativeGet record "key_hash")
                (nativeGet record "request_hash")
                (nativeGet record "operation_id")))
            :handleRecords
            (js-object
              :get
              (lambda (ref) (getRecord "handles" ref))
              :set
              (lambda (ref record) (insertRecord "handles" record))
              :delete
              (lambda (ref) (deleteRecord "handles" ref)))
            :versionResource
            (lambda
              (kind key payload tombstone)
              (assertTransaction)
              (let ((sequence (js-call repository :nextSequence "catalog")))
                (js-call
                  (js-call
                    db
                    :query
                    "UPDATE catalog_versions SET valid_to=? WHERE resource_kind=? AND resource_key=? AND valid_to IS NULL")
                  :run
                  sequence
                  kind
                  key)
                (js-call
                  (js-call
                    db
                    :query
                    "INSERT INTO catalog_versions(resource_kind,resource_key,valid_from,valid_to,tombstone,payload) VALUES (?,?,?,NULL,?,?)")
                  :run
                  kind
                  key
                  sequence
                  (if tombstone 1 0)
                  (stableJson payload))
                (when tombstone
                  (js-call
                    (js-call
                      db
                      :query
                      "UPDATE query_snapshots SET state='invalidated' WHERE snapshot_id IN (SELECT snapshot_id FROM snapshot_results WHERE resource_key=?)")
                    :run
                    key))
                sequence))))
        repository)))
  (export createRepository tables))
