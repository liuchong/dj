(module dj.storage.repository
  (import "../core/native.eli" nativeNullish nativeTypeOf nativeGet)
  (import "../core/types.eli" encodeSeq stableJson)
  (import "../core/errors.eli" success failure)
  ;; Only these internal names can become SQL identifiers. Every value is bound.
  (defconst tables (js-object))
  (defconst subscriptionStateSql (js-array nil))
  (let ((count 1) (placeholders (js-array)))
    (while (<= count 16)
      (js-call placeholders :push "?")
      (js-call subscriptionStateSql :push
        (str "SELECT subscription_id,owner_principal_id,state,revision FROM subscriptions WHERE subscription_id IN ("
          (js-call placeholders :join ",") ")"))
      (setq count (1+ count))))
  (defun defineTable
    (table key-names column-names)
    (let* ((keys (js-call key-names :split " "))
      (columns (js-call column-names :split " "))
      (insert-columns (js-call (js-array) :concat columns (js-array "payload")))
      (update-columns (js-call columns :filter
        (lambda (column) (not (js-call keys :includes column)))))
      (where (js-call (js-call keys :map (lambda (column) (str column "=?"))) :join " AND "))
      (assignments (js-call
        (js-call (js-call update-columns :map (lambda (column) (str column "=?")))
          :concat (js-array "payload=?")) :join ","))
      (insert-sql (str "INSERT INTO " table "(" (js-call insert-columns :join ",")
        ") VALUES (" (js-call (js-call insert-columns :map (lambda (column) "?")) :join ",") ")"))
      (update-sql (str "UPDATE " table " SET " assignments " WHERE " where))
      (progress-columns (cond
        ((= table "deliveries") (js-array "state" "revision"))
        ((= table "attempts") (js-array "state" "definite_not_sent"))
        ((= table "routes") (js-array "binding_id" "claim_owner" "unknown_delivery_id"))
        (t nil)))
      (progress-invariants (and progress-columns (js-call update-columns :filter
        (lambda (column) (not (js-call progress-columns :includes column))))))
      (progress-sql (and progress-columns (str "UPDATE " table " SET "
        (js-call (js-call (js-call progress-columns :map (lambda (column) (str column "=?")))
          :concat (js-array "payload=?")) :join ",")
        " WHERE " where
        (js-call (js-call progress-invariants :map (lambda (column) (str " AND " column " IS ?"))) :join ""))))
      (batch-insert-sql (and (js-call (js-array "match_decisions" "contributions") :includes table)
        (js-array nil)))
      (strict-batch-insert-sql (and (= table "deliveries") (js-array nil))))
      (when batch-insert-sql
        (let ((count 1) (rows (js-array))
          (row-sql (str "(" (js-call (js-call insert-columns :map (lambda (column) "?")) :join ",") ")")))
          (while (<= count 16)
            (js-call rows :push row-sql)
            (js-call batch-insert-sql :push
              (str "INSERT INTO " table "(" (js-call insert-columns :join ",") ") VALUES "
                (js-call rows :join ",") " ON CONFLICT(" (js-call keys :join ",") ") DO NOTHING"))
            (setq count (1+ count)))))
      (when strict-batch-insert-sql
        (let ((count 1) (rows (js-array))
          (row-sql (str "(" (js-call (js-call insert-columns :map (lambda (column) "?")) :join ",") ")")))
          (while (<= count 16)
            (js-call rows :push row-sql)
            (js-call strict-batch-insert-sql :push
              (str "INSERT INTO " table "(" (js-call insert-columns :join ",") ") VALUES "
                (js-call rows :join ",")))
            (setq count (1+ count)))))
      (put tables table (js-object
        :keys keys :columns columns :update_columns update-columns
        :select_sql (str "SELECT payload FROM " table " WHERE " where)
        :insert_sql insert-sql
        :insert_if_absent_sql (str insert-sql " ON CONFLICT(" (js-call keys :join ",") ") DO NOTHING")
        :batch_insert_sql batch-insert-sql
        :batch_insert_strict_sql strict-batch-insert-sql
        :update_sql update-sql :update_revision_sql (str update-sql " AND revision=?")
        :progress_columns progress-columns :progress_invariants progress-invariants
        :progress_sql progress-sql
        :progress_revision_sql (and progress-sql (str progress-sql " AND revision=?"))
        :delete_sql (str "DELETE FROM " table " WHERE " where)))))
  (defineTable "session_rules" "session_key" "session_key revision")
  (defineTable "message_filter_policies" "policy_id" "policy_id revision")
  (defineTable "connections" "connection_id" "connection_id revision state")
  (defineTable
    "principal_registry"
    "principal_id"
    "principal_id kind authorization_revision retired")
  (defineTable "tools" "tool_id" "tool_id")
  (defineTable "profiles" "profile_id" "profile_id tool_id revision")
  (defineTable
    "instances"
    "instance_id"
    "instance_id tool_id native_namespace instance_epoch ownership profile_id state revision")
  (defineTable
    "instance_gates"
    "instance_id"
    "instance_id instance_epoch state revision")
  (defineTable
    "managed_slots"
    "profile_id"
    "profile_id instance_id instance_epoch launch_token state")
  (defineTable
    "sessions"
    "session_key"
    "session_key tool_id native_namespace native_session_id instance_id instance_epoch workspace_ref updated_at runtime_state tombstone catalog_seq")
  (defineTable
    "routes"
    "route_id"
    "route_id canonical_target_key session_key binding_id next_delivery_seq claim_epoch claim_owner unknown_delivery_id")
  (defineTable
    "agents"
    "agent_id"
    "agent_id route_id owner_principal_id recipient_principal_id canonical_target_key state revision")
  (defineTable
    "bindings"
    "binding_id"
    "binding_id route_id instance_id instance_epoch expires_at")
  (defineTable
    "handles"
    "ref"
    "ref kind principal_id resource_key authorization_revision expires_at")
  (defineTable
    "previews"
    "preview_id"
    "preview_id principal_id expires_at committed_operation_id")
  (defineTable
    "operations"
    "operation_id"
    "operation_id principal_id operation key_hash request_hash state created_at result_expires_at")
  (defineTable
    "lifecycle_actions"
    "lifecycle_id"
    "lifecycle_id operation_id principal_id action instance_id instance_epoch launch_token state revision")
  (defineTable
    "source_progress"
    "connection_id"
    "connection_id cursor last_ingress_seq gap_status")
  (defineTable
    "poll_checkpoints"
    "connection_id conversation_key"
    "connection_id conversation_key generation next_due_at")
  (defineTable
    "events"
    "event_id"
    "event_id connection_id source_key conversation_key native_message_id event_kind ingress_seq received_at body_expires_at tombstone")
  (defineTable
    "subscriptions"
    "subscription_id"
    "subscription_id owner_principal_id agent_id state revision")
  (defineTable
    "subscription_versions"
    "subscription_id revision"
    "subscription_id revision start_seq cutover_seq state")
  (defineTable "inbox_entries" "inbox_id"
    "inbox_id subscription_id revision event_id agent_id state expires_at lease_until claim_principal_id claim_ref")
  (defineTable "inbox_pulls" "pull_id" "pull_id subscription_id principal_id")
  (defineTable "inbox_reply_contexts" "reply_context_id" "reply_context_id inbox_id recipient_principal_id expires_at")
  (defineTable
    "routing_work"
    "event_id"
    "event_id ingress_seq state last_subscription_id last_revision")
  (defineTable
    "match_decisions"
    "event_id subscription_id revision"
    "event_id subscription_id revision result")
  (defineTable
    "deliveries"
    "delivery_id"
    "delivery_id route_id origin principal_id operation_id agent_id event_id delivery_seq state revision expires_at")
  (defineTable
    "contributions"
    "delivery_id subscription_id revision"
    "delivery_id subscription_id revision state expires_at")
  (defineTable
    "outbound"
    "outbound_id"
    "outbound_id operation_id principal_id connection_id conversation_key state revision")
  (defineTable
    "parts"
    "part_id"
    "part_id outbound_id part_index dispatch_key state native_message_id")
  (defineTable
    "attempts"
