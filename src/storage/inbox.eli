(module dj.storage.inbox
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli" utcNow nextId must)
  (defun planPullEntry (context event plan agent)
    (let* ((repository (nativeGet context "repository"))
           (db (nativeGet (nativeGet context "store") "db"))
           (target-key (nativeGet plan "target_key"))
           (revision (nativeGet plan "subscription_revision"))
           (existing (js-call (js-call db :query
             "SELECT payload FROM inbox_entries WHERE target_key=? AND revision=? AND event_id=?")
             :get target-key revision (nativeGet event "event_id"))))
      (when (and existing (nativeGet plan "group_id"))
        (let ((entry (JSON/parse (nativeGet existing "payload"))))
          (when (= (nativeGet entry "state") "revoked")
            (put entry :state "ready")
            (put entry :agent_id (nativeGet agent "agent_id"))
            (put entry :recipient_principal_id (nativeGet agent "recipient_principal_id"))
            (put entry :matched_rule_ids (nativeGet plan "matched_rule_ids"))
            (put entry :context_policy (nativeGet plan "context_policy"))
            (put entry :delivery_policy (nativeGet plan "delivery_policy"))
            (put entry :instruction_policies (nativeGet plan "instruction_policies"))
            (put entry :claim_ref nil)
            (put entry :claim_principal_id nil)
            (put entry :lease_until nil)
            (must (js-call repository :replace "inbox_entries" entry))
            (put existing :payload (JSON/stringify entry)))))
      (if existing
        (success (JSON/parse (nativeGet existing "payload")))
        (let* ((now (utcNow context))
               (capacity (js-call (js-call db :query
                 "SELECT COUNT(*) AS total,COALESCE(SUM(i.target_key=?),0) AS own FROM inbox_entries i JOIN subscriptions s ON s.target_key=i.target_key AND s.revision=i.revision AND s.state='active' WHERE i.state IN ('ready','claimed') AND i.expires_at>?")
                 :get target-key now)))
          (if (or (>= (nativeGet capacity "total") (nativeGet limits "global_queue"))
                  (>= (nativeGet capacity "own") (nativeGet limits "route_queue")))
            (failure "limit_exceeded")
            (let ((entry
                    (js-object
                      :inbox_id (nextId context "inbox")
                      :target_key target-key
                      :revision revision
                      :subscription_revision revision
                      :event_id (nativeGet event "event_id")
                      :agent_id (nativeGet agent "agent_id")
                      :group_id (nativeGet plan "group_id" nil)
                      :owner_principal_id (nativeGet plan "owner_principal_id")
                      :recipient_principal_id (nativeGet agent "recipient_principal_id")
                      :matched_rule_ids (nativeGet plan "matched_rule_ids")
                      :context_policy (nativeGet plan "context_policy")
                      :delivery_policy (nativeGet plan "delivery_policy")
                      :instruction_policies (nativeGet plan "instruction_policies")
                      :state "ready"
                      :expires_at (nativeGet plan "expires_at")
                      :lease_until nil
                      :claim_principal_id nil
                      :claim_ref nil)))
              (js-call repository :insert "inbox_entries" entry)
              (success entry)))))))
  (export planPullEntry))
