(module dj.attachments.notification
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "node:path" isAbsolute)
  (import "node:fs/promises" open)
  (import "node:crypto" randomUUID)

  (defconst imageTypes (js-array "image/png" "image/jpeg" "image/webp" "image/gif"))

  (defun checkedSpan (offset length text)
    (and (Number/isSafeInteger offset) (>= offset 0) (Number/isSafeInteger length) (>= length 0)
      (<= (+ offset length) (js-length text))))

  (defun markdownLink (label href)
    (try
      (let* ((url (new globalThis.URL href))
             (protocol (nativeGet url "protocol"))
             (safe-label (js-call label :replaceAll (new globalThis.RegExp "[\\\\\\[\\]]" "g")
                 (lambda (char) (str "\\" char)))))
        (if (and (js-call (js-array "https:" "http:") :includes protocol)
          (= (nativeGet url "username") "") (= (nativeGet url "password") ""))
          (str "[" safe-label "](<" (nativeGet url "href") ">)") label))
      (catch invalid label)))

  (defun notificationBody (text links attachments)
    (let ((spans (new globalThis.Map)) (trailing (js-array)) (cursor 0) (parts (js-array)))
      (js-call links :forEach (lambda (link)
        (let ((start (nativeGet link "offset")) (length (nativeGet link "length")))
          (when (checkedSpan start length text)
            (js-call spans :set start
              (js-object :length length :text (markdownLink
                (js-call text :slice start (+ start length)) (nativeGet link "href")) :anchors (js-array)))))))
      (js-call attachments :forEach (lambda (attachment index)
        (let* ((start (nativeGet attachment "offset")) (length (nativeGet attachment "length"))
               (label (str "[" (nativeGet attachment "anchor" (str "附件 " (1+ index))) "]"))
               (span (js-call spans :get start)))
          (if (checkedSpan start length text)
            (progn
              (unless span (setq span (js-object :length length :text "" :anchors (js-array)))
                (js-call spans :set start span))
              (js-call (nativeGet span "anchors") :push label))
            (js-call trailing :push label)))))
      (let ((starts (Array/from (js-call spans :keys))))
        (js-call starts :sort (lambda (left right) (- left right)))
        (js-call starts :forEach (lambda (start)
          (when (>= start cursor)
            (let ((span (js-call spans :get start)))
              (js-call parts :push (js-call text :slice cursor start) (nativeGet span "text")
                (js-call (nativeGet span "anchors") :join " "))
              (setq cursor (+ start (nativeGet span "length"))))))))
      (js-call parts :push (js-call text :slice cursor))
      (when (> (js-length trailing) 0) (js-call parts :push "\n" (js-call trailing :join " ")))
      (js-call parts :join "")))

  (defun codexAttachmentInputs (attachments)
    (let ((parts (js-array)))
      (js-call attachments :forEach (lambda (attachment)
        (let ((path (nativeGet attachment "local_path"))
              (mime (nativeGet attachment "mime_type"))
              (size (nativeGet attachment "size_bytes")))
          (when (and (= (nativeGet attachment "state") "ready") (= (nativeTypeOf path) "string")
            (isAbsolute path) (Number/isSafeInteger size) (> size 0) (<= size 10485760)
            (< (js-length parts) 4) (js-call imageTypes :includes mime))
            (js-call parts :push (js-object :type "localImage" :path path))))))
      parts))

  (defun jpegDimensions (bytes)
    (let ((cursor 2) (size (js-length bytes)) (result nil))
      (when (and (> size 4) (= (aref bytes 0) 255) (= (aref bytes 1) 216))
        (while (and (not result) (< (+ cursor 8) size) (= (aref bytes cursor) 255))
          (let* ((marker (aref bytes (1+ cursor))) (length (js-call bytes :readUInt16BE (+ cursor 2))))
            (cond
              ((js-call (js-array 192 193 194 195 197 198 199 201 202 203 205 206 207) :includes marker)
                (when (>= length 7)
                  (setq result (js-object :width (js-call bytes :readUInt16BE (+ cursor 7))
                    :height (js-call bytes :readUInt16BE (+ cursor 5)))))
                (setq cursor size))
              ((or (< length 2) (= marker 218) (= marker 217)) (setq cursor size))
              (t (setq cursor (+ cursor 2 length)))))))
      result))

  (defun imageDimensions (bytes)
    (let* ((size (js-length bytes)) (tag (js-call bytes :toString "ascii" 0 4))
           (webp (and (>= size 30) (= tag "RIFF") (= (js-call bytes :toString "ascii" 8 12) "WEBP")))
           (subtype (and webp (js-call bytes :toString "ascii" 12 16))))
      (cond
        ((and (>= size 24) (= (js-call bytes :toString "hex" 0 8) "89504e470d0a1a0a")
          (= (js-call bytes :toString "ascii" 12 16) "IHDR"))
          (js-object :width (js-call bytes :readUInt32BE 16) :height (js-call bytes :readUInt32BE 20)))
        ((and (>= size 10) (or (= (js-call bytes :toString "ascii" 0 6) "GIF87a")
                            (= (js-call bytes :toString "ascii" 0 6) "GIF89a")))
          (js-object :width (js-call bytes :readUInt16LE 6) :height (js-call bytes :readUInt16LE 8)))
        ((= subtype "VP8X") (js-object :width (1+ (js-call bytes :readUIntLE 24 3))
          :height (1+ (js-call bytes :readUIntLE 27 3))))
        ((and (= subtype "VP8L") (= (aref bytes 20) 47))
          (js-object :width (1+ (+ (aref bytes 21) (* 256 (mod (aref bytes 22) 64))))
            :height (1+ (+ (Math/floor (/ (aref bytes 22) 64)) (* 4 (aref bytes 23)) (* 1024 (mod (aref bytes 24) 16))))))
        ((and (= subtype "VP8 ") (= (js-call bytes :toString "hex" 23 26) "9d012a"))
          (js-object :width (mod (js-call bytes :readUInt16LE 26) 16384)
            :height (mod (js-call bytes :readUInt16LE 28) 16384)))
        (t (jpegDimensions bytes)))))

  (defasync imageFileDimensions (path size)
    (try
      (let ((file (await (open path "r"))) (header (Buffer/alloc (Math/min size 65536))))
        (try
          (let* ((read (await (js-call file :read header 0 (js-length header) 0)))
                 (dimension (imageDimensions (js-call header :subarray 0 (nativeGet read "bytesRead"))))
                 (width (nativeGet dimension "width" 0)) (height (nativeGet dimension "height" 0)))
            (when (and (> width 0) (> height 0) (<= (* width height) 40000000)) dimension))
          (finally (await (js-call file :close)))))
      (catch unavailable nil)))

  (defasync cursorAttachmentContext (attachments)
    (let ((images (js-array)) (documents (js-array)) (videos (js-array)) (index 0) (count 0))
      (while (and (< index (js-length attachments)) (< count 4))
        (let* ((item (aref attachments index)) (path (nativeGet item "local_path"))
               (mime (nativeGet item "mime_type")) (size (nativeGet item "size_bytes")))
          (when (and (= (nativeGet item "state") "ready") (= (nativeTypeOf path) "string")
            (isAbsolute path) (Number/isSafeInteger size) (> size 0) (<= size 10485760))
            (let ((record (js-object :uuid (randomUUID) :path path :loadedAt (Date/now))))
              (cond
                ((js-call imageTypes :includes mime)
                  (let ((dimension (await (imageFileDimensions path size))))
                    (when dimension (put record :dimension dimension)
                      (js-call images :push record) (setq count (1+ count)))))
                ((or (= mime "application/pdf") (js-call (js-array "video/mp4" "video/quicktime") :includes mime))
                  (put record :filename (nativeGet item "file_name" "attachment"))
                  (put record :mimeType mime)
                  (js-call (if (= mime "application/pdf") documents videos) :push record)
                  (setq count (1+ count)))))))
        (setq index (1+ index)))
      (when (> count 0)
        (js-object :selectedImages images :selectedDocuments documents :selectedVideos videos))))

  (export notificationBody codexAttachmentInputs cursorAttachmentContext imageDimensions))
