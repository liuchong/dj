(module dj.attachments.notification
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "node:path" isAbsolute)

  (defun checkedSpan (offset length text)
    (and (Number/isSafeInteger offset) (>= offset 0) (Number/isSafeInteger length) (>= length 0)
      (<= (+ offset length) (js-length text))))

  (defun markdownLink (label href)
    (try
      (let* ((url (new globalThis.URL href))
             (protocol (nativeGet url "protocol"))
             (safe-label (js-call label :replaceAll (new globalThis.RegExp "[\\\\\\[\\]]" "g")
                 (lambda (char) (str "\\" char)))))
        (if (and (js-call (js-array "https:" "http:") :includes protocol)
          (= (nativeGet url "username") "") (= (nativeGet url "password") ""))
          (str "[" safe-label "](<" (nativeGet url "href") ">)") label))
      (catch invalid label)))

  (defun notificationBody (text links attachments)
    (let ((spans (new globalThis.Map)) (trailing (js-array)) (cursor 0) (parts (js-array)))
      (js-call links :forEach (lambda (link)
        (let ((start (nativeGet link "offset")) (length (nativeGet link "length")))
          (when (checkedSpan start length text)
            (js-call spans :set start
              (js-object :length length :text (markdownLink
                (js-call text :slice start (+ start length)) (nativeGet link "href")) :anchors (js-array)))))))
      (js-call attachments :forEach (lambda (attachment index)
        (let* ((start (nativeGet attachment "offset")) (length (nativeGet attachment "length"))
               (label (str "[" (nativeGet attachment "anchor" (str "附件 " (1+ index))) "]"))
               (span (js-call spans :get start)))
          (if (checkedSpan start length text)
            (progn
              (unless span (setq span (js-object :length length :text "" :anchors (js-array)))
                (js-call spans :set start span))
              (js-call (nativeGet span "anchors") :push label))
            (js-call trailing :push label)))))
      (let ((starts (Array/from (js-call spans :keys))))
        (js-call starts :sort (lambda (left right) (- left right)))
        (js-call starts :forEach (lambda (start)
          (when (>= start cursor)
            (let ((span (js-call spans :get start)))
              (js-call parts :push (js-call text :slice cursor start) (nativeGet span "text")
                (js-call (nativeGet span "anchors") :join " "))
              (setq cursor (+ start (nativeGet span "length"))))))))
      (js-call parts :push (js-call text :slice cursor))
      (when (> (js-length trailing) 0) (js-call parts :push "\n" (js-call trailing :join " ")))
      (js-call parts :join "")))

  (defun codexAttachmentInputs (attachments)
    (let ((parts (js-array)))
      (js-call attachments :forEach (lambda (attachment)
        (let ((path (nativeGet attachment "local_path"))
              (mime (nativeGet attachment "mime_type"))
              (size (nativeGet attachment "size_bytes")))
          (when (and (= (nativeGet attachment "state") "ready") (= (nativeTypeOf path) "string")
            (isAbsolute path) (Number/isSafeInteger size) (> size 0) (<= size 10485760)
            (< (js-length parts) 4) (js-call (js-array "image/png" "image/jpeg" "image/webp" "image/gif") :includes mime))
            (js-call parts :push (js-object :type "localImage" :path path))))))
      parts))

  (export notificationBody codexAttachmentInputs))
