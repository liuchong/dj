(module dj.subscriptions.inbox
  (import "../core/native.eli" nativeGet nativeNullish)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" addSeconds utf8Bytes)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli" currentPrincipal utcNow can requirePermission must safeFields typedRef resolveResourceHandle)
  (import "../policy/handles.eli" issueHandle)
  (import "../delivery/service.eli" isContributionEffective)
  (import "../delivery/scheduler.eli" freezeEnvelope)
  (import "../delivery/envelope.eli" encodeEnvelope)
  (import "../delivery/snapshot.eli" packEnvelope unpackEnvelope)
  (defun consumer (context subscription-id register)
    (let* ((repository (nativeGet context "repository"))
           (subscription (js-call repository :get "subscriptions" subscription-id))
           (agent (and subscription (js-call repository :get "agents" (nativeGet subscription "agent_id"))))
           (principal (currentPrincipal context))
           (resource (and agent (Object/assign (js-object) subscription
                       (js-object :owner_principal_id (nativeGet agent "recipient_principal_id"))))))
      (if (and subscription agent (= (nativeGet subscription "state") "active")
          (= (nativeGet subscription "delivery_mode" "push") "pull")
          (= (nativeGet agent "state") "registered")
          (= (nativeGet principal "principal_id") (nativeGet agent "recipient_principal_id")))
        (let ((permission (if register (requirePermission context "subscription.consume" resource)
                            (if (can context "subscription.consume" resource) (success nil) (failure "forbidden")))))
          (if (nativeGet permission "ok") (success (js-object :subscription subscription :agent agent)) permission))
        (failure "forbidden"))))
  (defun effectiveEntry (context entry)
    (let* ((repository (nativeGet context "repository"))
           (agent (js-call repository :get "agents" (nativeGet entry "agent_id")))
           (event (js-call repository :get "events" (nativeGet entry "event_id"))))
      (and agent event (isContributionEffective context (nativeGet entry "contribution") event agent))))
  (defun projectInbox (context entry &optional expected-claim)
    (let ((parent (consumer context (nativeGet entry "subscription_id") false)))
      (if (not (nativeGet parent "ok")) parent
        (let ((data (safeFields entry (js-array "inbox_id" "subscription_id" "event_id" "state" "expires_at"))))
          (when (and expected-claim (= (nativeGet entry "claim_ref") expected-claim)
              (= (nativeGet entry "claim_principal_id") (nativeGet (currentPrincipal context) "principal_id"))
              (= (nativeGet entry "state") "claimed")
              (> (Date/parse (nativeGet entry "lease_until")) (Date/parse (utcNow context)))
              (nativeGet (resolveResourceHandle context expected-claim "inbox_claim") "ok")
              (effectiveEntry context entry))
            (put data :claim_ref expected-claim)
            (put data :lease_until (nativeGet entry "lease_until"))
            (put data :envelope (unpackEnvelope (nativeGet entry "envelope_snapshot"))))
          (success data)))))
  (defun projectPull (context pull)
    (let ((parent (consumer context (nativeGet pull "subscription_id") false)))
      (if (or (not (nativeGet parent "ok"))
              (not (= (nativeGet pull "principal_id") (nativeGet (currentPrincipal context) "principal_id"))))
        (failure "forbidden")
        (let ((data (js-object :pull_id (nativeGet pull "pull_id") :subscription_id (nativeGet pull "subscription_id")
                      :empty (nativeGet pull "empty") :more (nativeGet pull "more" false))))
          (unless (nativeGet pull "empty")
            (let* ((entry (js-call (nativeGet context "repository") :get "inbox_entries" (nativeGet pull "inbox_id")))
                   (projected (and entry (projectInbox context entry (nativeGet pull "claim_ref")))))
              (unless (and projected (nativeGet projected "ok")) (throw (new globalThis.Error "inbox projection unavailable")))
              (put data :item (nativeGet projected "data"))))
          (success data)))))
  (defun pullInbox (context args)
    (let ((permission (consumer context (nativeGet args "subscription_id") t)))
      (if (not (nativeGet permission "ok")) permission
        (js-call context :accept
          (lambda (tx operation-id)
            (let* ((parent (must (consumer context (nativeGet args "subscription_id") false)))
                   (subscription (nativeGet parent "subscription")) (agent (nativeGet parent "agent"))
                   (repository (nativeGet context "repository")) (now (utcNow context))
                   (rows (js-call (js-call (nativeGet tx "db") :query
                     "SELECT i.payload FROM inbox_entries i JOIN events e ON e.event_id=i.event_id JOIN routing_work w ON w.event_id=i.event_id AND w.state='done' WHERE i.subscription_id=? AND i.revision=? AND i.state IN ('ready','claimed') AND i.expires_at>? AND (i.lease_until IS NULL OR i.lease_until<=?) ORDER BY e.ingress_seq,i.inbox_id LIMIT 50")
                     :all (nativeGet subscription "subscription_id") (nativeGet subscription "revision") now now))
                   (position 0) (entry nil)
                   (pull (js-object :pull_id operation-id :subscription_id (nativeGet subscription "subscription_id")
                           :principal_id (nativeGet (currentPrincipal context) "principal_id") :empty t
                           :more (= (js-length rows) 50))))
              (while (and (not entry) (< position (js-length rows)))
                (let ((candidate (JSON/parse (nativeGet (aref rows position) "payload"))))
                  (if (effectiveEntry context candidate) (setq entry candidate)
                    (progn (put candidate :state "revoked") (put candidate :envelope_snapshot nil)
                      (must (js-call repository :replace "inbox_entries" candidate)))))
                (setq position (1+ position)))
              (when entry
                (let ((until (addSeconds now (nativeGet args "lease_seconds" 60))))
                  (when (> (Date/parse until) (Date/parse (nativeGet entry "expires_at")))
                    (setq until (nativeGet entry "expires_at")))
                  (let* ((handle (issueHandle context "inbox_claim" (currentPrincipal context)
                                   (nativeGet entry "inbox_id") (js-object) until))
                         (claim-ref (nativeGet handle "ref"))
                         (record (js-object :delivery_id nil :origin "subscription_event"
                                   :agent_id (nativeGet agent "agent_id") :inbox_id (nativeGet entry "inbox_id")
                                   :inbox_claim_ref claim-ref))
                         (event (js-call repository :get "events" (nativeGet entry "event_id")))
                         (envelope (freezeEnvelope context record event (js-array (nativeGet entry "contribution")) agent)))
                    (when (or (nativeGet envelope "instruction_overflow")
                              (> (utf8Bytes (encodeEnvelope envelope)) (nativeGet limits "native_frame_max_bytes")))
                      (must (failure "limit_exceeded")))
                    (put entry :state "claimed") (put entry :lease_until until)
                    (put entry :claim_ref claim-ref)
                    (put entry :claim_principal_id (nativeGet (currentPrincipal context) "principal_id"))
                    (put entry :envelope_snapshot (packEnvelope envelope))
                    (must (js-call repository :replace "inbox_entries" entry))
                    (put pull :empty false) (put pull :inbox_id (nativeGet entry "inbox_id"))
                    (put pull :claim_ref claim-ref))))
              (js-call repository :insert "inbox_pulls" pull)
              (projectPull context pull)))
          (lambda (data) (js-array (typedRef "inbox_pull" (nativeGet data "pull_id"))))))))
  (defun ackInbox (context args)
    (let* ((resolved (resolveResourceHandle context (nativeGet args "claim_ref") "inbox_claim"))
           (entry (and (nativeGet resolved "ok") (js-call (nativeGet context "repository") :get "inbox_entries"
                    (nativeGet (nativeGet resolved "data") "resource_key"))))
           (permission (and entry (consumer context (nativeGet entry "subscription_id") t))))
      (if (not (and entry permission (nativeGet permission "ok"))) (failure "stale_reference")
        (js-call context :accept
          (lambda (tx operation-id)
            (let* ((repository (nativeGet context "repository"))
                   (current (js-call repository :get "inbox_entries" (nativeGet entry "inbox_id"))))
              (unless (and (nativeGet (resolveResourceHandle context (nativeGet args "claim_ref") "inbox_claim") "ok")
                  (= (nativeGet current "state") "claimed")
                  (= (nativeGet current "claim_ref") (nativeGet args "claim_ref"))
                  (> (Date/parse (nativeGet current "lease_until")) (Date/parse (utcNow context)))
                  (nativeGet (consumer context (nativeGet current "subscription_id") false) "ok")
                  (effectiveEntry context current))
                (must (failure "stale_reference")))
              (put current :state (if (= (nativeGet args "disposition") "consumed") "consumed" "ready"))
              (put current :envelope_snapshot nil)
              (when (= (nativeGet current "state") "ready")
                (put current :claim_ref nil) (put current :claim_principal_id nil) (put current :lease_until nil))
              (must (js-call repository :replace "inbox_entries" current))
              (projectInbox context current)))
          (lambda (data) (js-array (typedRef "inbox" (nativeGet data "inbox_id"))))))))
  (export pullInbox ackInbox projectInbox projectPull))
