(module dj.subscriptions.inbox
  (import "../dispatch/contexts.eli" prepareIdentity activateIdentity)
  (import "../dispatch/notifications.eli" notificationState)
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" addSeconds utf8Bytes)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli" currentPrincipal utcNow can requirePermission must safeFields typedRef resolveResourceHandle)
  (import "../policy/handles.eli" issueHandle)
  (import "../delivery/service.eli" isSubscriptionDeliveryEffective)
  (import "../connections/echo.eli" echoState)
  (import "../triggers/suppression.eli" evaluateTriggerFilters)
  (import "../sessions/rules.eli" attachConversationRules)
  (import "../delivery/scheduler.eli" freezeEnvelope)
  (import "../delivery/envelope.eli" encodeEnvelope)
  (import "../delivery/snapshot.eli" packEnvelope unpackEnvelope)
  (import "./groups.eli" groupMember resolveSubscriptionTarget)
  (defun pullTargetKey (context args)
    (if (nativeGet args "group_id")
      (str "group:" (nativeGet args "group_id"))
      (nativeGet (resolveSubscriptionTarget context (js-object :agent_id (nativeGet args "agent_id"))) "target_key")))
  (defun consumer (context target-key register &optional selected-agent)
    (let* ((repository (nativeGet context "repository"))
           (subscription (and target-key (js-call repository :get "subscriptions" target-key)))
           (agent (and subscription (js-call repository :get "agents"
             (if (nativeGet subscription "group_id") selected-agent (nativeGet subscription "agent_id")))))
           (principal (currentPrincipal context))
           (resource (and agent (Object/assign (js-object) subscription
             (js-object :owner_principal_id (nativeGet agent "recipient_principal_id"))))))
      (if (and subscription agent
               (or (not (nativeGet subscription "group_id"))
                   (and selected-agent (groupMember context (nativeGet subscription "group_id") selected-agent)))
               (= (nativeGet subscription "state") "active")
               (= (nativeGet subscription "delivery_mode" "push") "pull")
               (= (nativeGet agent "state") "registered")
               (= (nativeGet principal "principal_id") (nativeGet agent "recipient_principal_id")))
        (let ((permission (if register
                            (requirePermission context "subscription.consume" resource)
                            (if (can context "subscription.consume" resource) (success nil) (failure "forbidden")))))
          (if (nativeGet permission "ok") (success (js-object :subscription subscription :agent agent)) permission))
        (failure "forbidden"))))
  (defun effectiveEntry (context entry)
    (let* ((repository (nativeGet context "repository"))
           (agent (js-call repository :get "agents" (nativeGet entry "agent_id")))
           (event (js-call repository :get "events" (nativeGet entry "event_id"))))
      (and agent event (isSubscriptionDeliveryEffective context entry event agent))))
  (defun projectInbox (context entry &optional expected-claim)
    (let ((parent (consumer context (nativeGet entry "target_key") false (nativeGet entry "agent_id"))))
      (if (not (nativeGet parent "ok")) parent
        (let ((data (safeFields entry (js-array "inbox_id" "target_key" "event_id" "state" "expires_at" "matched_rule_ids"))))
          (put data :subscription_revision (nativeGet entry "revision"))
          (when (and expected-claim (= (nativeGet entry "claim_ref") expected-claim)
              (= (nativeGet entry "claim_principal_id") (nativeGet (currentPrincipal context) "principal_id"))
              (= (nativeGet entry "state") "claimed")
              (> (Date/parse (nativeGet entry "lease_until")) (Date/parse (utcNow context)))
              (nativeGet (resolveResourceHandle context expected-claim "inbox_claim") "ok")
              (effectiveEntry context entry))
            (put data :claim_ref expected-claim)
            (put data :lease_until (nativeGet entry "lease_until"))
            (put data :envelope (unpackEnvelope (nativeGet entry "envelope_snapshot"))))
          (success data)))))
  (defun projectPull (context pull)
    (let ((parent (consumer context (nativeGet pull "target_key") false (nativeGet pull "agent_id"))))
      (if (or (not (nativeGet parent "ok"))
              (not (= (nativeGet pull "principal_id") (nativeGet (currentPrincipal context) "principal_id"))))
        (failure "forbidden")
        (let ((data (js-object
                      :pull_id (nativeGet pull "pull_id")
                      :target_key (nativeGet pull "target_key")
                      :agent_id (nativeGet pull "agent_id")
                      :empty (nativeGet pull "empty")
                      :more (nativeGet pull "more" false))))
          (unless (nativeGet pull "empty")
            (let* ((entry (js-call (nativeGet context "repository") :get "inbox_entries" (nativeGet pull "inbox_id")))
                   (projected (and entry (projectInbox context entry (nativeGet pull "claim_ref")))))
              (unless (and projected (nativeGet projected "ok")) (throw (new globalThis.Error "inbox projection unavailable")))
              (put data :item (nativeGet projected "data"))))
          (success data)))))
  (defun pullInbox (context args)
    (let* ((target-key (pullTargetKey context args))
           (permission (consumer context target-key t (nativeGet args "agent_id"))))
      (if (not (nativeGet permission "ok")) permission
        (js-call context :accept
          (lambda (tx operation-id)
            (let* ((current-target-key (pullTargetKey context args))
                   (parent (must (consumer context current-target-key false (nativeGet args "agent_id"))))
                   (subscription (nativeGet parent "subscription"))
                   (agent (nativeGet parent "agent"))
                   (repository (nativeGet context "repository"))
                   (now (utcNow context))
                   (rows (js-call (js-call (nativeGet tx "db") :query
                     "SELECT i.payload FROM inbox_entries i JOIN events e ON e.event_id=i.event_id JOIN routing_work w ON w.event_id=i.event_id AND w.state='done' WHERE i.target_key=? AND i.revision=? AND i.agent_id=? AND i.state IN ('ready','claimed') AND i.expires_at>? AND (i.lease_until IS NULL OR i.lease_until<=?) ORDER BY e.ingress_seq,i.inbox_id LIMIT 50")
                     :all (nativeGet subscription "target_key") (nativeGet subscription "revision") (nativeGet agent "agent_id") now now))
                   (position 0)
                   (entry nil)
                   (pull (js-object
                           :pull_id operation-id
                           :target_key (nativeGet subscription "target_key")
                           :principal_id (nativeGet (currentPrincipal context) "principal_id")
                           :agent_id (nativeGet agent "agent_id")
                           :empty t
                           :more (= (js-length rows) 50))))
              (while (and (not entry) (< position (js-length rows)))
                (let ((candidate (JSON/parse (nativeGet (aref rows position) "payload"))))
                  (let* ((event (js-call repository :get "events" (nativeGet candidate "event_id")))
                         (echo (echoState context event))
                         (suppressed (or (= echo "echo") (nativeGet (evaluateTriggerFilters context event) "suppressed"))))
                    (cond
                      ((= echo "held") (put pull :more t))
                      ((and (not suppressed) (effectiveEntry context candidate))
                        (let* ((route (js-call repository :get "routes" (nativeGet agent "route_id")))
                               (probe (js-object
                                        :inbox_id (nativeGet candidate "inbox_id")
                                        :route_id (nativeGet route "route_id")
                                        :agent_id (nativeGet agent "agent_id")
                                        :group_id (nativeGet subscription "group_id" nil)
                                        :target_key (nativeGet subscription "target_key")))
                               (state (notificationState context probe event (nativeGet route "session_key") "pull")))
                          (cond
                            ((= state "coalesced")
                              (put candidate :state "coalesced")
                              (put candidate :notification_key (nativeGet probe "notification_key"))
                              (put candidate :coalesced_into (nativeGet probe "coalesced_into"))
                              (must (js-call repository :replace "inbox_entries" candidate)))
                            ((= state "pending") (put pull :more t))
                            (t (setq entry candidate)))))
                      (t
                        (put candidate :state (if suppressed "suppressed" "revoked"))
                        (when suppressed (put candidate :suppressed_reason (if (= echo "echo") "own_echo" "trigger_suppressed")))
                        (put candidate :envelope_snapshot nil)
                        (must (js-call repository :replace "inbox_entries" candidate))))))
                (setq position (1+ position)))
              (when entry
                (let ((until (addSeconds now (nativeGet args "lease_seconds" 60))))
                  (when (> (Date/parse until) (Date/parse (nativeGet entry "expires_at")))
                    (setq until (nativeGet entry "expires_at")))
                  (let* ((handle (issueHandle context "inbox_claim" (currentPrincipal context)
                                   (nativeGet entry "inbox_id") (js-object) until))
                         (claim-ref (nativeGet handle "ref"))
                         (route (js-call repository :get "routes" (nativeGet agent "route_id")))
                         (target (nativeGet route "session_key"))
                         (record (js-object
                                   :delivery_id nil
                                   :origin "subscription_event"
                                   :route_id (nativeGet route "route_id")
                                   :agent_id (nativeGet agent "agent_id")
                                   :group_id (nativeGet subscription "group_id" nil)
                                   :target_key (nativeGet entry "target_key")
                                   :subscription_revision (nativeGet entry "revision")
                                   :matched_rule_ids (nativeGet entry "matched_rule_ids" (js-array))
                                   :context_policy (nativeGet entry "context_policy")
                                   :instruction_policies (nativeGet entry "instruction_policies" (js-array))
                                   :inbox_id (nativeGet entry "inbox_id")
                                   :inbox_claim_ref claim-ref))
                         (event (js-call repository :get "events" (nativeGet entry "event_id")))
                         (identity (and (not (= (nativeGet (nativeGet event "conversation") "kind") "resource"))
                                        (prepareIdentity context record event target)))
                         (envelope (attachConversationRules context
                           (js-object :session_key target)
                           (freezeEnvelope context record event agent nil identity))))
                    (when (or (nativeGet envelope "instruction_overflow")
                              (> (utf8Bytes (encodeEnvelope envelope)) (nativeGet limits "native_frame_max_bytes")))
                      (must (failure "limit_exceeded")))
                    (notificationState context record event target "pull" t)
                    (put entry :notification_key (nativeGet record "notification_key"))
                    (activateIdentity context record)
                    (put entry :state "claimed")
                    (put entry :lease_until until)
                    (put entry :claim_ref claim-ref)
                    (put entry :claim_principal_id (nativeGet (currentPrincipal context) "principal_id"))
                    (put entry :envelope_snapshot (packEnvelope envelope))
                    (must (js-call repository :replace "inbox_entries" entry))
                    (put pull :empty false)
                    (put pull :inbox_id (nativeGet entry "inbox_id"))
                    (put pull :claim_ref claim-ref))))
              (js-call repository :insert "inbox_pulls" pull)
              (projectPull context pull)))
          (lambda (data) (js-array (typedRef "inbox_pull" (nativeGet data "pull_id"))))))))
  (defun ackInbox (context args)
    (let* ((resolved (resolveResourceHandle context (nativeGet args "claim_ref") "inbox_claim"))
           (entry (and (nativeGet resolved "ok") (js-call (nativeGet context "repository") :get "inbox_entries"
                    (nativeGet (nativeGet resolved "data") "resource_key"))))
           (permission (and entry (consumer context (nativeGet entry "target_key") t (nativeGet entry "agent_id")))))
      (if (not (and entry permission (nativeGet permission "ok"))) (failure "stale_reference")
        (js-call context :accept
          (lambda (tx operation-id)
            (let* ((repository (nativeGet context "repository"))
                   (current (js-call repository :get "inbox_entries" (nativeGet entry "inbox_id"))))
              (unless (and (nativeGet (resolveResourceHandle context (nativeGet args "claim_ref") "inbox_claim") "ok")
                  (= (nativeGet current "state") "claimed")
                  (= (nativeGet current "claim_ref") (nativeGet args "claim_ref"))
                  (> (Date/parse (nativeGet current "lease_until")) (Date/parse (utcNow context)))
                  (nativeGet (consumer context (nativeGet current "target_key") false (nativeGet current "agent_id")) "ok")
                  (effectiveEntry context current))
                (must (failure "stale_reference")))
              (put current :state (if (= (nativeGet args "disposition") "consumed") "consumed" "ready"))
              (put current :envelope_snapshot nil)
              (when (= (nativeGet current "state") "ready")
                (put current :claim_ref nil)
                (put current :claim_principal_id nil)
                (put current :lease_until nil))
              (must (js-call repository :replace "inbox_entries" current))
              (projectInbox context current)))
          (lambda (data) (js-array (typedRef "inbox" (nativeGet data "inbox_id"))))))))
  (export pullInbox ackInbox projectInbox projectPull))
