(module dj.subscriptions.service
  (import "../core/types.eli" sourceReadAction hashValue nextSeq nextRevision)
  (import "../core/native.eli" nativeNullish nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/limits.eli" limits)
  (import "../triggers/sources.eli" recipientCan)
  (import "../triggers/suppression.eli" evaluateTriggerFilters)
  (import "../triggers/rules.eli"
    resolveSubscriptionRules
    checkSubscriptionRules
    subscriptionIndexEntries
    evaluateSubscriptionRules
    normalizeMentionAllPolicy)
  (import "../application/context.eli"
    utcNow
    nextId
    currentPrincipal
    can
    requirePermission
    must
    inTransaction
    typedRef
    resolveResourceHandle
    issueResourceHandle
    safeFields
    agentPort
    nativeCallContext)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../lifecycle/gates.eli" assertGate)
  (import "../catalog/snapshots.eli" openSnapshot resumeSnapshot advanceSnapshot)
  (import "../ingestion/visibility.eli" eventReadable)
  (import "./replay.eli" replayEvents)
  (import "./inbox.eli" pullInbox ackInbox)
  (import "../sessions/models.eli" subscriberMetadata modelSelection)
  (import "../catalog/records.eli" writeSessionVersion putSession)
  (import "./groups.eli" resolveSubscriptionTarget groupFingerprint handleGroupOperation projectGroup)
  (import "../routing/group-selection.eli" distributionPolicy)
  (defun projectSubscription (record)
    (let ((projected
            (safeFields
              record
              (js-array
                "target_key"
                "configuration_id"
                "owner_principal_id"
                "subscriber_model"
                "subscriber"
                "agent_id"
                "group_id"
                "distribution"
                "rules"
                "resolved_sources"
                "rule_sources"
                "context_policy"
                "delivery_policy"
                "instruction_policy"
                "delivery_mode"
                "start_seq"
                "cutover_seq"
                "state"
                "revision"))))
      (put projected :mention_all_policy (normalizeMentionAllPolicy (nativeGet record "mention_all_policy")))
      projected))
  (defun inspectSubscriptionAllowed (context record)
    (or (can context "subscription.manage" record)
      (and (nativeGet record "configuration_id")
        (= (nativeGet record "recipient_principal_id") (nativeGet (currentPrincipal context) "principal_id")))))
  (defun configurationManaged (context subscription)
    (let ((id (nativeGet subscription "configuration_id")))
      (and id (not (= id (nativeGet context "fixed_route_id")))
        (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
          "SELECT 1 FROM fixed_routes WHERE id=? AND json_extract(payload,'$.target_key')=?")
          :get id (nativeGet subscription "target_key")))))
  (defun targetManageAllowed (context target)
    (and target
      (or
        (and (nativeGet target "group_id") (can context "subscription.manage" target))
        (= (nativeGet (currentPrincipal context) "principal_id") (nativeGet target "recipient_principal_id"))
        (can context "subscription.manage"
          (safeFields target (js-array "agent_id" "route_id" "tool" "native_namespace" "native_session_id"))))))
  (defun targetState (context agent)
    (let ((djReturn1Token (js-object)) (djReturn1Value nil))
      (try
        (when (nativeGet agent "group_id")
          (unless (and (= (nativeGet agent "state") "active") (targetManageAllowed context agent))
            (setq djReturn1Value (failure "forbidden"))
            (throw djReturn1Token))
          (setq djReturn1Value (success (js-object :group_fingerprint (groupFingerprint context agent)
            :session nil :instance nil :gate nil)))
          (throw djReturn1Token))
        (let* ((repository (nativeGet context "repository"))
               (route (js-call repository :get "routes" (nativeGet agent "route_id")))
               (session (and route (js-call repository :get "sessions" (nativeGet route "session_key"))))
               (instance (and session (js-call repository :get "instances" (nativeGet session "instance_id")))))
          (unless (and (= (nativeGet agent "state") "registered") instance)
            (progn (setq djReturn1Value (failure "target_unbound")) (throw djReturn1Token)))
          (let ((gate (assertGate (nativeGet context "store") (nativeGet instance "instance_id")
                        (nativeGet instance "instance_epoch") "open")))
            (unless (nativeGet gate "ok")
              (progn (setq djReturn1Value gate) (throw djReturn1Token)))
            (success (js-object :session session :instance instance :gate (nativeGet gate "data")))))
        (catch djReturn1Error
          (if (eq djReturn1Error djReturn1Token) djReturn1Value (throw djReturn1Error))))))
  (defasync refreshSubscriberModel (context agent)
    (let* ((repository (nativeGet context "repository"))
           (route (js-call repository :get "routes" (nativeGet agent "route_id")))
           (session (and route (js-call repository :get "sessions" (nativeGet route "session_key"))))
           (instance (and session (js-call repository :get "instances" (nativeGet session "instance_id"))))
           (port (and instance (agentPort context instance)))
           (observation nil))
      (when (and session port)
        (try (setq observation (await (js-call port :probe session session (nativeCallContext context))))
          (catch unavailable (setq observation nil)))
        (inTransaction context (lambda (tx)
          (let ((current (js-call repository :get "sessions" (nativeGet session "session_key"))))
            (when (= (nativeGet current "instance_epoch") (nativeGet session "instance_epoch"))
              (if (and (= (nativeGet observation "native_session_id") (nativeGet session "native_session_id"))
                       (= (nativeGet observation "native_namespace") (nativeGet session "native_namespace"))
                       (= (nativeGet observation "instance_epoch") (nativeGet session "instance_epoch")))
                (must (putSession context observation instance))
                (must (writeSessionVersion context (Object/assign (js-object) current
                  (js-object :model_selection (modelSelection nil "unavailable" (utcNow context)))))))))
          (success nil))))))
  (defasync previewSubscription (context args)
    (let ((djReturn2Token (js-object)) (djReturn2Value nil))
      (try
        (let* ((spec (nativeGet args "spec"))
               (repository (nativeGet context "repository"))
               (resolved-target (resolveSubscriptionTarget context spec))
               (target-key (nativeGet resolved-target "target_key"))
               (agent (nativeGet resolved-target "target"))
               (principal (currentPrincipal context))
               (recipient (and agent (configuredPrincipal
                 (nativeGet (nativeGet context "config") "principals")
                 (nativeGet agent "recipient_principal_id"))))
               (existing (and target-key (js-call repository :get "subscriptions" target-key))))
          (when (and existing (configurationManaged context existing))
            (setq djReturn2Value (failure "forbidden"))
            (throw djReturn2Token))
          (unless (and target-key agent recipient (targetManageAllowed context agent))
            (progn (setq djReturn2Value (failure "forbidden")) (throw djReturn2Token)))
          (let ((permission (requirePermission context "subscription.manage"
                  (or existing
                      (js-object
                        :owner_principal_id (nativeGet principal "principal_id")
                        :target_key target-key
                        :agent_id (nativeGet spec "agent_id" nil)
                        :group_id (nativeGet spec "group_id" nil))))))
            (unless (nativeGet permission "ok")
              (progn (setq djReturn2Value permission) (throw djReturn2Token))))
          (let* ((current-revision (if existing (nativeGet existing "revision") 0))
                 (has-expected (object-has? args :expected_revision))
                 (expected-revision (if has-expected (nativeGet args "expected_revision") (if existing -1 0))))
            (unless (= expected-revision current-revision)
              (let ((details (js-object :current_revision current-revision)))
                (when has-expected (put details :expected_revision expected-revision))
                (setq djReturn2Value (failure "revision_conflict" (js-object :details details)))
                (throw djReturn2Token)))
            (if (nativeGet spec "group_id")
              (put spec :distribution (distributionPolicy (nativeGet context "config") (nativeGet spec "distribution")))
              (await (refreshSubscriberModel context agent)))
            (let* ((target (targetState context agent))
                   (resolved-rules-result (resolveSubscriptionRules context spec recipient)))
              (unless (nativeGet target "ok")
                (progn (setq djReturn2Value target) (throw djReturn2Token)))
              (unless (nativeGet resolved-rules-result "ok")
                (progn (setq djReturn2Value resolved-rules-result) (throw djReturn2Token)))
              (let* ((rule-bundle (nativeGet resolved-rules-result "data"))
                     (resolved-rules (nativeGet rule-bundle "resolved_rules"))
                     (sources (nativeGet rule-bundle "resolved_sources"))
                     (rule-sources (nativeGet rule-bundle "rule_sources"))
                     (preview-version (Object/assign (js-object) spec
                       (js-object :target_key target-key :revision (1+ current-revision) :resolved_rules resolved-rules)))
                     (samples (js-array))
                     (warnings (js-array)))
                (js-call (nativeGet args "sample_event_ids" (js-array)) :forEach (lambda (id)
                  (let* ((event (js-call repository :get "events" id))
                         (connection (and event (js-call repository :get "connections" (nativeGet event "connection_id")))))
                    (unless (and event
                                 (eventReadable context event)
                                 (recipientCan context recipient
                                   (sourceReadAction (nativeGet event "conversation"))
                                   (nativeGet event "conversation")))
                      (setq djReturn2Value (failure "forbidden"))
                      (throw djReturn2Token))
                    (let* ((evaluated (evaluateSubscriptionRules context preview-version event connection))
                           (verdict (nativeGet evaluated "result")))
                      (js-call samples :push
                        (js-object
                          :event_id id
                          :result (cond ((= verdict "match") "true") ((= verdict "no_match") "false") (t "indeterminate"))
                          :matched_rule_ids (nativeGet evaluated "matched_rule_ids")
                          :reason_codes (if (nativeGet (evaluateTriggerFilters context event) "suppressed")
                            (js-array "trigger_suppressed")
                            (js-array))))))))
                (unless (js-call sources :every (lambda (source) (recipientCan context recipient "message.reply" source)))
                  (js-call warnings :push
                    (js-object
                      :code "reply_not_authorized"
                      :pointer "/spec/rules"
                      :message "The recipient can receive input without a usable IM reply context.")))
                (inTransaction context (lambda (tx)
                  (let* ((id (nextId context "preview"))
                         (handle (must (issueResourceHandle context "preview" id (js-object) (nativeGet limits "handle_ttl_seconds"))))
                         (record
                           (js-object
                             :preview_id id
                             :public_ref (nativeGet handle "ref")
                             :principal_id (nativeGet principal "principal_id")
                             :target_key target-key
                             :expected_revision current-revision
                             :normalized_spec spec
                             :spec_hash (hashValue spec)
                             :resolved_rules resolved-rules
                             :resolved_sources sources
                             :rule_sources rule-sources
                             :group_fingerprint (nativeGet (nativeGet target "data") "group_fingerprint" nil)
                             :target_revision (nativeGet agent "revision")
                             :target_constraint (nativeGet recipient "target_constraint" nil)
                             :authorization_revision (nativeGet principal "authorization_revision")
                             :recipient_authorization_revision (nativeGet recipient "authorization_revision")
                             :instance_id (nativeGet (nativeGet (nativeGet target "data") "instance") "instance_id" nil)
                             :instance_epoch (nativeGet (nativeGet (nativeGet target "data") "instance") "instance_epoch" nil)
                             :gate_revision (nativeGet (nativeGet (nativeGet target "data") "gate") "revision" nil)
                             :expires_at (nativeGet handle "expires_at")
                             :committed_operation_id nil)))
                    (js-call repository :insert "previews" record)
                    (success
                      (js-object
                        :preview_id (nativeGet handle "ref")
                        :target_key target-key
                        :expected_revision current-revision
                        :expires_at (nativeGet record "expires_at")
                        :normalized_spec spec
                        :spec_hash (nativeGet record "spec_hash")
                        :resolved_sources sources
                        :rule_sources rule-sources
                        :target (if (nativeGet agent "group_id")
                          (projectGroup agent)
                          (safeFields agent
                            (js-array "agent_id" "group_id" "members" "tool" "native_namespace" "native_session_id" "display_name" "revision")))
                        :warnings warnings
                        :blocking_issues (js-array)
                        :samples samples)))))))))
        (catch djReturn2Error
          (if (eq djReturn2Error djReturn2Token) djReturn2Value (throw djReturn2Error))))))
  (defun loadPreview (context ref)
    (let ((djReturn3Token (js-object)) (djReturn3Value nil))
      (try
        (let* ((repository (nativeGet context "repository"))
               (handle (js-call repository :get "handles" ref)))
          (unless (and handle
                       (= (nativeGet handle "kind") "preview")
                       (= (nativeGet handle "principal_id") (nativeGet (currentPrincipal context) "principal_id")))
            (progn (setq djReturn3Value (failure "preview_invalid")) (throw djReturn3Token)))
          (when (<= (Date/parse (nativeGet handle "expires_at")) (Date/parse (utcNow context)))
            (progn (setq djReturn3Value (failure "preview_expired")) (throw djReturn3Token)))
          (let ((resolved (resolveResourceHandle context ref "preview")))
            (unless (nativeGet resolved "ok")
              (progn (setq djReturn3Value (failure "preview_stale")) (throw djReturn3Token)))
            (let ((preview (js-call repository :get "previews" (nativeGet handle "resource_key"))))
              (unless preview
                (progn (setq djReturn3Value (failure "preview_invalid")) (throw djReturn3Token)))
              (success preview))))
        (catch djReturn3Error
          (if (eq djReturn3Error djReturn3Token) djReturn3Value (throw djReturn3Error))))))
  (defun revokeVersion (context target-key revision cutover)
    (let ((db (nativeGet (nativeGet context "store") "db")))
      (js-call (js-call db :query
        "UPDATE subscription_versions SET cutover_seq=?,payload=json_set(payload,'$.cutover_seq',?) WHERE target_key=? AND revision=? AND cutover_seq IS NULL")
        :run cutover cutover target-key revision)
      (js-call (js-call db :query
        "UPDATE deliveries SET state='cancelled',revision=revision+1,payload=json_set(payload,'$.state','cancelled','$.revision',revision+1) WHERE origin='subscription_event' AND state IN ('ready','deferred','blocked') AND json_extract(payload,'$.target_key')=? AND json_extract(payload,'$.subscription_revision')=?")
        :run target-key revision)
      (js-call (js-call db :query
        "UPDATE inbox_entries SET state='revoked',payload=json_set(payload,'$.state','revoked') WHERE target_key=? AND revision=? AND state='ready'")
        :run target-key revision)))
  (defun insertVersion (context subscription)
    (let* ((repository (nativeGet context "repository"))
           (db (nativeGet (nativeGet context "store") "db"))
           (version (Object/assign (js-object) subscription (js-object :cutover_seq nil))))
      (js-call repository :insert "subscription_versions" version)
      (when (= (nativeGet subscription "state") "active")
        (let ((entries (subscriptionIndexEntries
                (nativeGet subscription "target_key")
                (nativeGet subscription "revision")
                (nativeGet subscription "resolved_rules"))))
          (js-call entries :forEach (lambda (entry)
            (js-call (js-call db :query
              "INSERT OR IGNORE INTO subscription_sources(connection_id,native_chat_id,thread_key,event_kind,target_key,revision,include_threads) VALUES (?,?,?,?,?,?,?)")
              :run
              (nativeGet entry "connection_id")
              (nativeGet entry "native_chat_id")
              (nativeGet entry "thread_key")
              (nativeGet entry "event_kind")
              (nativeGet entry "target_key")
              (nativeGet entry "revision")
              (nativeGet entry "include_threads"))))))))
  (defun commitSubscription (context args)
    (let ((djReturn4Token (js-object)) (djReturn4Value nil))
      (try
        (let* ((loaded (loadPreview context (nativeGet args "preview_id")))
               (repository (nativeGet context "repository")))
          (unless (nativeGet loaded "ok")
            (progn (setq djReturn4Value loaded) (throw djReturn4Token)))
          (let* ((preview (nativeGet loaded "data"))
                 (spec (nativeGet preview "normalized_spec"))
                 (target-key (nativeGet preview "target_key"))
                 (resolved (resolveSubscriptionTarget context spec))
                 (agent (nativeGet resolved "target"))
                 (current (and target-key (js-call repository :get "subscriptions" target-key)))
                 (permission (requirePermission context "subscription.manage"
                   (or current
                       (js-object
                         :owner_principal_id (nativeGet (currentPrincipal context) "principal_id")
                         :target_key target-key
                         :agent_id (nativeGet spec "agent_id" nil)
                         :group_id (nativeGet spec "group_id" nil))))))
            (unless (nativeGet permission "ok")
              (progn (setq djReturn4Value permission) (throw djReturn4Token)))
            (when (and current (configurationManaged context current))
              (setq djReturn4Value (failure "forbidden"))
              (throw djReturn4Token))
            (unless (and agent (= target-key (nativeGet resolved "target_key")) (targetManageAllowed context agent))
              (progn (setq djReturn4Value (failure "forbidden")) (throw djReturn4Token)))
            (js-call context :accept
              (lambda (tx operation-id)
                (let ((djReturn5Token (js-object)) (djReturn5Value nil))
                  (try
                    (let* ((ticket (must (loadPreview context (nativeGet args "preview_id"))))
                           (resolved-now (resolveSubscriptionTarget context spec))
                           (target-agent (nativeGet resolved-now "target"))
                           (recipient (and target-agent (configuredPrincipal
                             (nativeGet (nativeGet context "config") "principals")
                             (nativeGet target-agent "recipient_principal_id"))))
                           (target (and target-agent (targetState context target-agent)))
                           (old (js-call repository :get "subscriptions" target-key))
                           (actual-revision (if old (nativeGet old "revision") 0)))
                      (when (and old (configurationManaged context old))
                        (must (failure "forbidden")))
                      (when (nativeGet ticket "committed_operation_id")
                        (progn (setq djReturn5Value (failure "already_committed")) (throw djReturn5Token)))
                      (unless (= actual-revision (nativeGet args "expected_revision"))
                        (progn (setq djReturn5Value (failure "revision_conflict")) (throw djReturn5Token)))
                      (unless (and target-agent
                                   (= target-key (nativeGet resolved-now "target_key"))
                                   (= (nativeGet ticket "expected_revision") (nativeGet args "expected_revision"))
                                   (= (nativeGet ticket "target_revision") (nativeGet target-agent "revision"))
                                   (nativeGet target "ok")
                                   (= (nativeGet ticket "group_fingerprint" nil)
                                      (nativeGet (nativeGet target "data") "group_fingerprint" nil))
                                   (= (nativeGet ticket "recipient_authorization_revision")
                                      (nativeGet recipient "authorization_revision"))
                                   (= (nativeGet ticket "instance_epoch")
                                      (nativeGet (nativeGet (nativeGet target "data") "instance") "instance_epoch" nil))
                                   (= (nativeGet ticket "gate_revision")
                                      (nativeGet (nativeGet (nativeGet target "data") "gate") "revision" nil)))
                        (progn (setq djReturn5Value (failure "preview_stale")) (throw djReturn5Token)))
                      (let ((checked (checkSubscriptionRules context (nativeGet ticket "resolved_rules") recipient)))
                        (unless (nativeGet checked "ok")
                          (progn (setq djReturn5Value checked) (throw djReturn5Token))))
                      (when (nativeGet spec "subscriber_model")
                        (let ((session (Object/assign (js-object) (nativeGet (nativeGet target "data") "session"))))
                          (put session :reported_model (modelSelection (nativeGet spec "subscriber_model") "subscriber_report" (utcNow context)))
                          (put session :reported_model_at (utcNow context))
                          (must (writeSessionVersion context session))))
                      (let* ((cutover (js-call repository :currentSequence "ingress"))
                             (keep-paused (and old
                                               (= (nativeGet old "state") "paused")
                                               (= (nativeGet old "agent_id" nil) (nativeGet spec "agent_id" nil))))
                             (subscription
                               (Object/assign (js-object) spec
                                 (js-object
                                   :target_key target-key
                                   :agent_id (nativeGet spec "agent_id" nil)
                                   :group_id (nativeGet spec "group_id" nil)
                                   :owner_principal_id
                                   (if (and old (not (= (nativeGet old "state") "deleted")))
                                     (nativeGet old "owner_principal_id")
                                     (nativeGet (currentPrincipal context) "principal_id"))
                                   :recipient_principal_id (nativeGet target-agent "recipient_principal_id")
                                   :subscriber
                                   (if (nativeGet spec "group_id")
                                     nil
                                     (subscriberMetadata (nativeGet (nativeGet target "data") "session")
                                       (utcNow context) (nativeGet spec "subscriber_model")))
                                   :resolved_rules (nativeGet ticket "resolved_rules")
                                   :resolved_sources (nativeGet ticket "resolved_sources")
                                   :rule_sources (nativeGet ticket "rule_sources")
                                   :start_seq (nextSeq cutover)
                                   :cutover_seq nil
                                   :state (if keep-paused "paused" "active")
                                   :revision (if old (nextRevision (nativeGet old "revision")) 1)))))
                        (if old
                          (progn
                            (revokeVersion context target-key (nativeGet old "revision") cutover)
                            (must (js-call repository :replace "subscriptions" subscription (nativeGet old "revision"))))
                          (js-call repository :insert "subscriptions" subscription))
                        (insertVersion context subscription)
                        (put ticket :committed_operation_id operation-id)
                        (must (js-call repository :replace "previews" ticket))
                        (success (projectSubscription subscription))))
                    (catch djReturn5Error
                      (if (eq djReturn5Error djReturn5Token) djReturn5Value (throw djReturn5Error))))))
              (lambda (data) (js-array (typedRef "subscription" (nativeGet data "target_key")))))))
        (catch djReturn4Error
          (if (eq djReturn4Error djReturn4Token) djReturn4Value (throw djReturn4Error))))))
  (defun changeSubscriptionState (context operation args)
    (let ((djReturn6Token (js-object)) (djReturn6Value nil))
      (try
        (let* ((repository (nativeGet context "repository"))
               (resolved (resolveSubscriptionTarget context args))
               (target-key (nativeGet resolved "target_key"))
               (subscription (and target-key (js-call repository :get "subscriptions" target-key))))
          (unless subscription
            (if (and (nativeGet resolved "target") (targetManageAllowed context (nativeGet resolved "target")))
              (progn (setq djReturn6Value (failure "not_found")) (throw djReturn6Token))
              (progn (setq djReturn6Value (failure "forbidden")) (throw djReturn6Token))))
          (when (configurationManaged context subscription)
            (setq djReturn6Value (failure "forbidden"))
            (throw djReturn6Token))
          (let ((permission (requirePermission context "subscription.manage" subscription)))
            (unless (nativeGet permission "ok")
              (progn (setq djReturn6Value permission) (throw djReturn6Token))))
          (js-call context :accept
            (lambda (tx operation-id)
              (let ((djReturn7Token (js-object)) (djReturn7Value nil))
                (try
                  (let* ((current (js-call repository :get "subscriptions" target-key))
                         (cutover (js-call repository :currentSequence "ingress")))
                    (when (configurationManaged context current) (must (failure "forbidden")))
                    (unless (= (nativeGet current "revision") (nativeGet args "expected_revision"))
                      (progn (setq djReturn7Value (failure "revision_conflict")) (throw djReturn7Token)))
                    (when (= (nativeGet current "state") "deleted")
                      (progn (setq djReturn7Value (failure "revision_conflict")) (throw djReturn7Token)))
                    (when (= operation "subscription.resume")
                      (let* ((resolved-now (resolveSubscriptionTarget context args))
                             (agent (nativeGet resolved-now "target"))
                             (recipient (and agent (configuredPrincipal
                               (nativeGet (nativeGet context "config") "principals")
                               (nativeGet agent "recipient_principal_id"))))
                             (target (and agent (targetState context agent))))
                        (unless (and agent (= target-key (nativeGet resolved-now "target_key")) (nativeGet target "ok"))
                          (progn (setq djReturn7Value (or target (failure "target_unbound"))) (throw djReturn7Token)))
                        (unless (targetManageAllowed context agent)
                          (progn (setq djReturn7Value (failure "forbidden")) (throw djReturn7Token)))
                        (let ((checked (checkSubscriptionRules context (nativeGet current "resolved_rules") recipient)))
                          (unless (nativeGet checked "ok")
                            (progn (setq djReturn7Value checked) (throw djReturn7Token))))
                        (when (nativeGet resolved-now "agent_id")
                          (put current :agent_id (nativeGet resolved-now "agent_id"))
                          (put current :recipient_principal_id (nativeGet agent "recipient_principal_id")))))
                    (revokeVersion context target-key (nativeGet current "revision") cutover)
                    (put current :revision (nextRevision (nativeGet current "revision")))
                    (put current :cutover_seq cutover)
                    (put current :state
                      (cond ((= operation "subscription.resume") "active")
                        ((= operation "subscription.delete") "deleted")
                        (t "paused")))
                    (put current :start_seq (nextSeq cutover))
                    (must (js-call repository :replace "subscriptions" current (nativeGet args "expected_revision")))
                    (insertVersion context current)
                    (success (projectSubscription current)))
                  (catch djReturn7Error
                    (if (eq djReturn7Error djReturn7Token) djReturn7Value (throw djReturn7Error))))))
            (js-array (typedRef "subscription" target-key))))
        (catch djReturn6Error
          (if (eq djReturn6Error djReturn6Token) djReturn6Value (throw djReturn6Error))))))
  (defun listSubscriptions (context args)
    (let ((djReturn8Token (js-object)) (djReturn8Value nil))
      (try
        (let* ((filters (nativeGet args "filters" (js-object)))
               (repository (nativeGet context "repository"))
               (opened (if (nativeGet args "cursor")
                 (resumeSnapshot context (nativeGet args "cursor") filters args "target_key_asc")
                 (openSnapshot context filters args "target_key_asc"))))
          (unless (nativeGet opened "ok")
            (progn (setq djReturn8Value opened) (throw djReturn8Token)))
          (let* ((snapshot (nativeGet opened "data"))
                 (options (js-object :limit 1000))
                 (last-key (nativeGet snapshot "last_scan_key"))
                 (items (js-array))
                 (keys (js-array))
                 (index 0)
                 (rows nil))
            (when last-key (put options :after_key last-key))
            (setq rows (js-call repository :page "subscriptions" options))
            (while (and (< index (js-length rows)) (< (js-length items) (nativeGet args "limit" 50)))
              (let ((record (aref rows index)))
                (setq last-key (nativeGet record "target_key"))
                (when (and (inspectSubscriptionAllowed context record)
                           (js-call (Object/keys filters) :every
                             (lambda (field) (= (nativeGet filters field) (nativeGet record field)))))
                  (js-call items :push (projectSubscription record))
                  (js-call keys :push (js-object :resource_key last-key))))
              (setq index (1+ index)))
            (advanceSnapshot context snapshot
              (js-object
                :items items
                :result_keys keys
                :next_scan_key last-key
                :complete (and (= index (js-length rows)) (< (js-length rows) 1000))
                :coverage_complete t))))
        (catch djReturn8Error
          (if (eq djReturn8Error djReturn8Token) djReturn8Value (throw djReturn8Error))))))
  (defasync handleOperation (context operation args)
    (let ((djReturn9Token (js-object)) (djReturn9Value nil))
      (try
        (cond
          ((js-call operation :startsWith "subscription.group.") (handleGroupOperation context operation args))
          ((= operation "subscription.replay") (replayEvents context args projectSubscription))
          ((= operation "subscription.pull") (pullInbox context args))
          ((= operation "subscription.ack") (ackInbox context args))
          ((= operation "subscription.preview") (await (previewSubscription context args)))
          ((= operation "subscription.set") (commitSubscription context args))
          ((js-call (js-array "subscription.pause" "subscription.resume" "subscription.delete") :includes operation)
            (changeSubscriptionState context operation args))
          ((= operation "subscription.list") (listSubscriptions context args))
          ((= operation "subscription.get")
            (let* ((resolved (resolveSubscriptionTarget context args))
                   (target-key (nativeGet resolved "target_key"))
                   (target (nativeGet resolved "target"))
                   (record (and target-key (js-call (nativeGet context "repository") :get "subscriptions" target-key))))
              (cond
                ((and record (inspectSubscriptionAllowed context record))
                  (success (projectSubscription record)))
                ((and (not record) target (targetManageAllowed context target))
                  (failure "not_found"))
                (t (failure "forbidden")))))
          (t (failure "invalid_argument")))
        (catch djReturn9Error
          (if (eq djReturn9Error djReturn9Token) djReturn9Value (throw djReturn9Error))))))
  (export
    previewSubscription
    commitSubscription
    changeSubscriptionState
    projectSubscription
    revokeVersion
    insertVersion
    handleOperation))
