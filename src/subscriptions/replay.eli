(module dj.subscriptions.replay
  (import "../connections/echo.eli" echoState)
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../triggers/sources.eli" matchesSource)
  (import "../triggers/rules.eli" evaluateSubscriptionRules)
  (import "../application/context.eli" requirePermission must typedRef)
  (import "../ingestion/visibility.eli" eventReadable)
  (import "../delivery/planning-scope.eli" withEventPlans)
  (import "../delivery/service.eli" planDelivery)
  (import "../delivery/group-dispatch.eli" queueGroupDispatch)
  (import "./groups.eli" resolveSubscriptionTarget)
  (defun replayEvents (context args project)
    (let* ((repository (nativeGet context "repository"))
           (resolved (resolveSubscriptionTarget context args))
           (target-key (nativeGet resolved "target_key"))
           (subscription (and target-key (js-call repository :get "subscriptions" target-key)))
           (permission (and subscription (requirePermission context "subscription.manage" subscription))))
      (if (not (and subscription permission (nativeGet permission "ok")))
        (failure "forbidden")
        (js-call context :accept
          (lambda (tx operation-id)
            (let* ((current (js-call repository :get "subscriptions" target-key))
                   (db (nativeGet (nativeGet context "store") "db")))
              (unless (and current (= (nativeGet current "state") "active")
                           (= (nativeGet current "revision") (nativeGet args "expected_revision")))
                (must (failure "revision_conflict")))
              (js-call (nativeGet args "event_ids") :forEach (lambda (id)
                (let* ((event (js-call repository :get "events" id))
                       (routing (js-call repository :get "routing_work" id))
                       (connection (and event (js-call repository :get "connections" (nativeGet event "connection_id")))))
                  (unless (and event
                               (eventReadable context event)
                               (= (nativeGet routing "state") "done")
                               (js-call (nativeGet current "resolved_rules" (js-array)) :some (lambda (rule)
                                 (and (= (nativeGet rule "enabled") t)
                                      (js-call (nativeGet rule "resolved_sources" (js-array)) :some (lambda (source)
                                        (matchesSource source (nativeGet source "include_threads") event)))))))
                    (must (failure "forbidden")))
                  (unless (= (echoState context event) "clear") (must (failure "forbidden")))
                  (let* ((evaluated (evaluateSubscriptionRules context current event connection))
                         (decision
                           (js-object
                             :event_id id
                             :target_key (nativeGet current "target_key")
                             :revision (nativeGet current "revision")
                             :result (nativeGet evaluated "result")
                             :matched_rule_ids (nativeGet evaluated "matched_rule_ids")
                             :context_policy (nativeGet evaluated "context_policy")
                             :instruction_policies (nativeGet evaluated "instruction_policies")
                             :reason_codes (js-array "explicit_replay"))))
                    (withEventPlans context event
                      (lambda (planning)
                        (when (= (nativeGet evaluated "result") "match")
                          (must (if (nativeGet current "group_id")
                            (queueGroupDispatch tx event current decision)
                            (planDelivery tx event current decision nil planning))))
                        (let ((unlock (js-call planning :finish "done")))
                          (when unlock
                            (js-call (js-call db :query
                              "UPDATE deliveries SET state='ready',revision=revision+1,payload=json_set(payload,'$.state','ready','$.revision',revision+1,'$.blocked_reason',NULL) WHERE event_id=? AND state='blocked' AND json_extract(payload,'$.blocked_reason')='routing_incomplete'")
                              :run id)))
                        (js-call repository :insertManyIfAbsent "match_decisions" (js-array decision))
                        (success nil))
                      t t)))))
              (success (funcall project current))))
          (lambda (data) (js-array (typedRef "subscription" (nativeGet data "target_key"))))))))
  (export replayEvents))
