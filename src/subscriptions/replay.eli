(module dj.subscriptions.replay
  (import "../connections/echo.eli" echoState)
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/rules.eli" evaluatePredicate matchesSource)
  (import "../application/context.eli" requirePermission must typedRef)
  (import "../ingestion/visibility.eli" eventReadable)
  (import "../delivery/planning-scope.eli" withEventPlans)
  (import "../delivery/service.eli" planContribution)
  (defun replayEvents (context args project)
    (let* ((repository (nativeGet context "repository"))
      (subscription (js-call repository :get "subscriptions" (nativeGet args "subscription_id")))
      (permission (and subscription (requirePermission context "subscription.manage" subscription))))
      (if (not (nativeGet permission "ok")) (failure "forbidden")
        (js-call context :accept (lambda (tx operation-id)
          (let* ((current (js-call repository :get "subscriptions" (nativeGet args "subscription_id")))
            (db (nativeGet (nativeGet context "store") "db")))
            (unless (and (= (nativeGet current "state") "active")
              (= (nativeGet current "revision") (nativeGet args "expected_revision"))) (must (failure "revision_conflict")))
            (js-call (nativeGet args "event_ids") :forEach (lambda (id)
              (let* ((event (js-call repository :get "events" id))
                (routing (js-call repository :get "routing_work" id))
                (connection (and event (js-call repository :get "connections" (nativeGet event "connection_id")))))
                (unless (and event (eventReadable context event) (= (nativeGet routing "state") "done")
                  (js-call (nativeGet current "resolved_sources") :some (lambda (source)
                    (matchesSource source (nativeGet source "include_threads") event)))) (must (failure "forbidden")))
                (unless (and (js-call (nativeGet connection "allowed_sender_kinds" (js-array "human")) :includes
                  (nativeGet (if (= (nativeGet event "event_kind") "message.reaction.added")
                    (nativeGet (nativeGet event "reaction") "operator") (nativeGet event "sender")) "kind"))
                  (= (echoState context event) "clear"))
                  (must (failure "forbidden")))
                (let* ((answer (evaluatePredicate (nativeGet current "predicate") event))
                  (decision (js-object :event_id id :subscription_id (nativeGet current "subscription_id") :revision (nativeGet current "revision")
                    :result (if (= answer "true") "match" (if (= answer "false") "no_match" "indeterminate"))
                    :reason_codes (js-array "explicit_replay"))))
                  (withEventPlans context event (lambda (planning)
                    (let ((pending (js-array)))
                      (when (= answer "true") (must (planContribution tx event current decision nil planning pending)))
                      (let ((unlock (js-call planning :finish "done")))
                        (when unlock (js-call (js-call db :query "UPDATE deliveries SET state='ready',revision=revision+1,payload=json_set(payload,'$.state','ready','$.revision',revision+1,'$.blocked_reason',NULL) WHERE event_id=? AND state='blocked' AND json_extract(payload,'$.blocked_reason')='routing_incomplete'") :run id)))
                      (js-call repository :insertManyIfAbsent "match_decisions" (js-array decision))
                      (js-call repository :insertManyIfAbsent "contributions" pending)
                      (success nil))) t t)))))
            (success (funcall project current))))
          (lambda (data) (js-array (typedRef "subscription" (nativeGet data "subscription_id"))))))))
  (export replayEvents))
