(module dj.subscriptions.groups
  (import "../core/native.eli" nativeGet nativeNullish)
  (import "../core/types.eli" hashValue)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" currentPrincipal can requirePermission must nextId safeFields typedRef utcNow)
  (defun projectGroup (record)
    (safeFields record (js-array "group_id" "owner_principal_id" "name" "members" "state" "revision")))
  (defun groupFor (context id)
    (and id (js-call (nativeGet context "repository") :get "subscription_groups" id)))
  (defun subscriptionTarget (context spec)
    (if (nativeGet spec "group_id")
      (let ((group (groupFor context (nativeGet spec "group_id"))))
        (when group (Object/assign (js-object) group
          (js-object :recipient_principal_id (nativeGet group "owner_principal_id")))))
      (js-call (nativeGet context "repository") :get "agents" (nativeGet spec "agent_id"))))
  (defun groupMember (context group-id agent-id)
    (let ((group (groupFor context group-id)))
      (and group (= (nativeGet group "state") "active")
        (js-call (nativeGet group "members") :find (lambda (member)
          (and (= (nativeGet member "agent_id") agent-id) (nativeGet member "enabled" t)))))))
  (defun checkMembers (context members)
    (let ((seen (new globalThis.Set)) (repository (nativeGet context "repository")))
      (js-call members :forEach (lambda (member)
        (let* ((id (nativeGet member "agent_id")) (agent (js-call repository :get "agents" id)))
          (when (js-call seen :has id) (must (failure "invalid_argument")))
          (js-call seen :add id)
          (unless (and agent (= (nativeGet agent "state") "registered")
            (or (= (nativeGet (currentPrincipal context) "principal_id") (nativeGet agent "recipient_principal_id"))
              (can context "agent.bind" agent))) (must (failure "forbidden")))
          (unless (object-has? member :priority) (put member :priority 0))
          (unless (object-has? member :enabled) (put member :enabled t)))))
      members))
  (defun groupFingerprint (context group)
    (let ((repository (nativeGet context "repository")))
      (hashValue (js-array (projectGroup group)
        (js-call (nativeGet group "members") :map (lambda (member)
          (let* ((agent (js-call repository :get "agents" (nativeGet member "agent_id")))
            (route (and agent (js-call repository :get "routes" (nativeGet agent "route_id"))))
            (session (and route (js-call repository :get "sessions" (nativeGet route "session_key")))))
            (js-object :agent_id (nativeGet member "agent_id") :revision (nativeGet agent "revision" nil)
              :recipient_principal_id (nativeGet agent "recipient_principal_id" nil)
              :instance_epoch (nativeGet session "instance_epoch" nil)))))))))
  (defun handleGroupOperation (context operation args)
    (let* ((repository (nativeGet context "repository")) (id (nativeGet args "group_id"))
      (record (and id (groupFor context id))))
      (cond
        ((= operation "subscription.group.dispatches")
          (let ((sub (js-call repository :get "subscriptions" (nativeGet args "subscription_id"))))
            (unless (and sub (nativeGet sub "group_id") (can context "subscription.manage" sub)) (must (failure "forbidden")))
            (let* ((rows (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
              "SELECT payload FROM group_dispatches WHERE subscription_id=? AND event_id>? ORDER BY event_id LIMIT ?")
              :all (nativeGet args "subscription_id") (nativeGet args "after_id" "") (1+ (nativeGet args "limit" 32))))
              (more (> (js-length rows) (nativeGet args "limit" 32)))
              (items (js-call (js-call rows :slice 0 (nativeGet args "limit" 32)) :map
                (lambda (row) (JSON/parse (nativeGet row "payload"))))))
              (success (js-object :items items :next_after (if more (nativeGet (aref items (1- (js-length items))) "event_id") nil))))))
        ((= operation "subscription.group.list")
          (let* ((rows (js-call repository :page "subscription_groups"
            (js-object :after_key (nativeGet args "after_id" "") :limit 1000)))
            (items (js-array)) (last nil) (index 0))
            (while (and (< index (js-length rows)) (< (js-length items) (nativeGet args "limit" 32)))
              (let ((row (aref rows index)))
                (setq last (nativeGet row "group_id"))
                (when (can context "subscription.manage" row) (js-call items :push (projectGroup row))))
              (setq index (1+ index)))
            (success (js-object :items items :next_after (if (or (< index (js-length rows)) (= (js-length rows) 1000)) last nil)))))
        ((= operation "subscription.group.get")
          (if (and record (can context "subscription.manage" record)) (success (projectGroup record)) (failure "forbidden")))
        (t
          (let ((resource (or record (js-object :owner_principal_id (nativeGet (currentPrincipal context) "principal_id")))))
            (must (requirePermission context "subscription.manage" resource))
            (when (and id (not record)) (must (failure "not_found")))
            (when (nativeGet args "members") (checkMembers context (nativeGet args "members")))
            (js-call context :accept (lambda (tx operation-id)
              (let* ((current (and id (groupFor context id)))
                (group (Object/assign (js-object) (or current
                  (js-object :group_id (nextId context "group") :owner_principal_id (nativeGet (currentPrincipal context) "principal_id")
                    :state "active" :revision 0)))))
                (when id
                  (unless (and current (can context "subscription.manage" current)
                    (= (nativeGet current "revision") (nativeGet args "expected_revision"))
                    (= (nativeGet current "state") "active")) (must (failure "revision_conflict"))))
                (if (= operation "subscription.group.delete")
                  (progn
                    (when (js-call (js-call (nativeGet tx "db") :query
                      "SELECT 1 FROM subscriptions WHERE state!='deleted' AND json_extract(payload,'$.group_id')=? LIMIT 1") :get id)
                      (must (failure "revision_conflict")))
                    (put group :state "deleted"))
                  (progn
                    (put group :name (nativeGet args "name"))
                    (put group :members (checkMembers context (nativeGet args "members")))))
                (put group :revision (1+ (nativeGet group "revision")))
                (if current (must (js-call repository :replace "subscription_groups" group (nativeGet current "revision")))
                  (js-call repository :insert "subscription_groups" group))
                (success (projectGroup group))))
              (lambda (data) (js-array (typedRef "subscription_group" (nativeGet data "group_id"))))))))))
  (export projectGroup groupFor groupMember subscriptionTarget groupFingerprint handleGroupOperation))
