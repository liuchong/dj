(module dj.people.registry
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success invalidField)
  (defun identityKey (identity)
    (JSON/stringify (js-array (nativeGet identity "platform") (nativeGet identity "scope") (nativeGet identity "id"))))
  (defun validIdentity (identity)
    (and identity (= (nativeTypeOf identity) "object") (not (Array/isArray identity))
      (= (js-length (Object/keys identity)) 3)
      (js-call (js-array "platform" "scope" "id") :every (lambda (key)
        (let ((value (nativeGet identity key)))
          (and (= (nativeTypeOf value) "string") (> (js-length value) 0) (<= (js-length value) 512)))))))
  (defun validatePeople (people)
    (let ((bad nil) (ids (new globalThis.Set)) (aliases (new globalThis.Set)))
      (if (not (and (Array/isArray people) (<= (js-length people) 64)))
        (setq bad "/people")
        (js-call people :forEach (lambda (person index)
          (let ((id (nativeGet person "id")) (identities (nativeGet person "identities")))
            (if (not (and person (= (nativeTypeOf person) "object") (not (Array/isArray person))
              (= (js-length (Object/keys person)) 2) (= (nativeTypeOf id) "string")
              (> (js-length id) 0) (<= (js-length id) 128) (not (js-call ids :has id))
              (Array/isArray identities) (> (js-length identities) 0) (<= (js-length identities) 128)))
              (setq bad (str "/people/" index))
              (progn
                (js-call ids :add id)
                (js-call identities :forEach (lambda (identity)
                  (if (or (not (validIdentity identity)) (js-call aliases :has (identityKey identity)))
                    (setq bad (str "/people/" index "/identities"))
                    (js-call aliases :add (identityKey identity)))))))))))
      (if bad (invalidField bad "bounded people with unique scoped native identities") (success people))))
  (defun validatePersonReferences (rules people)
    (let ((ids (new globalThis.Set)) (bad nil) (visit nil))
      (js-call people :forEach (lambda (person) (js-call ids :add (nativeGet person "id"))))
      (setq visit (lambda (node)
        (cond ((object-has? node :all) (js-call (nativeGet node "all") :forEach visit))
          ((object-has? node :any) (js-call (nativeGet node "any") :forEach visit))
          ((object-has? node :not) (funcall visit (nativeGet node "not")))
          ((= (nativeGet node "field") "sender.person_id")
            (let ((wanted (nativeGet node "value")))
              (unless (if (= (nativeGet node "op") "in")
                (js-call wanted :every (lambda (id) (js-call ids :has id)))
                (js-call ids :has wanted)) (setq bad t)))))))
      (js-call rules :forEach (lambda (rule) (funcall visit (nativeGet rule "predicate"))))
      (if bad (invalidField "/rules" "person references must exist in people") (success nil))))
  (defun resolvePerson (people identities)
    (let ((found "") (conflict false) (keys (new globalThis.Set)))
      (js-call identities :forEach (lambda (identity)
        (when (validIdentity identity) (js-call keys :add (identityKey identity)))))
      (js-call people :forEach (lambda (person)
        (when (js-call (nativeGet person "identities") :some (lambda (identity) (js-call keys :has (identityKey identity))))
          (when (and (not (= found "")) (not (= found (nativeGet person "id")))) (setq conflict t))
          (setq found (nativeGet person "id")))))
      ;; No known alias is a non-match. Contradictory native evidence is unknown.
      (if conflict nil found)))
  (defun eventIdentities (context event)
    (let* ((sender (nativeGet event "sender")) (identities (if (Array/isArray (nativeGet sender "identities"))
        (js-call (nativeGet sender "identities") :slice 0 16) (js-array)))
      (connection (js-call (nativeGet context "repository") :get "connections" (nativeGet event "connection_id")))
      (platform (nativeGet connection "platform"))
      (app (or (nativeGet connection "event_app_id") (nativeGet (nativeGet connection "user_identity") "app_id")))
      (id (nativeGet sender "id")))
      ;; Old Events retain their app-scoped OpenID; never treat it as a global ID.
      (when (and (= (nativeGet event "identity_revision") (nativeGet connection "identity_revision")) (= platform "lark") app (= (nativeTypeOf id) "string") (js-call id :startsWith "ou_"))
        (js-call identities :push (js-object :platform (nativeGet connection "brand" "lark") :scope (str "app:" app ":open_id") :id id)))
      (when (and (= platform "telegram") (= (nativeTypeOf id) "string"))
        (js-call identities :push (js-object :platform "telegram" :scope "user_id" :id id)))
      identities))
  (defun personIdentitiesForConnection (people person-id connection)
    (let* ((person (js-call people :find (lambda (entry) (= (nativeGet entry "id") person-id))))
      (platform (nativeGet connection "platform"))
      (brand (nativeGet connection "brand" platform))
      (app (or (nativeGet connection "event_app_id") (nativeGet (nativeGet connection "user_identity") "app_id")))
      (tenant (nativeGet connection "tenant_ref")))
      (js-call (nativeGet person "identities" (js-array)) :filter (lambda (identity)
        (and (= (nativeGet identity "platform") brand)
          (cond ((= platform "lark") (or
            (and app (= (nativeGet identity "scope") (str "app:" app ":open_id")))
            (and tenant (= (nativeGet identity "scope") (str "tenant:" tenant ":user_id")))))
            ((= platform "telegram") (= (nativeGet identity "scope") "user_id"))
            (t false)))))))
  (export personIdentitiesForConnection identityKey validIdentity validatePeople validatePersonReferences resolvePerson eventIdentities))
