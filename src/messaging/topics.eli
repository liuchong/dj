(module dj.messaging.topics
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" hashValue conversationKey)
  (defun topicOf (event)
    (let* ((address (nativeGet event "conversation"))
      (thread (nativeGet address "native_thread_id" nil))
      (parent (nativeGet (nativeGet event "reply_to") "id" nil))
      (root (nativeGet event "root_message_id" (or parent (nativeGet event "native_message_id"))))
      (kind (cond ((= (nativeGet address "kind") "resource") "resource_record") (thread "native_thread") (parent "reply_chain") (t "conversation"))))
      (js-object :topic_key (str "topic_" (hashValue (js-array (nativeGet event "connection_id")
        (nativeGet address "native_chat_id" (nativeGet address "resource_token")) kind
        (if (= kind "conversation") nil (or thread root))
        (nativeGet address "table_id" nil))))
        :kind kind :native_thread_id thread :root_message_id root :parent_message_id parent)))
  (defun sameTopic (anchor message)
    (let ((topic (topicOf anchor)) (other (topicOf message)))
      (or (= (nativeGet topic "kind") "conversation")
        (= (nativeGet topic "topic_key") (nativeGet other "topic_key"))
        (= (nativeGet topic "root_message_id") (nativeGet message "native_message_id")))))
  (defun trackedTopic (context event)
    (let* ((topic (topicOf event)) (db (nativeGet (nativeGet context "store") "db"))
      (address (nativeGet event "conversation")))
      (when (and db (= (nativeGet topic "kind") "conversation"))
        (let ((row (js-call (js-call db :query "SELECT 1 AS found FROM events WHERE connection_id=? AND conversation_key=? AND tombstone=0 AND body_expires_at>? AND (json_extract(payload,'$.root_message_id')=? OR json_extract(payload,'$.reply_to.id')=?) LIMIT 1")
          :get (nativeGet event "connection_id") (conversationKey address)
          (js-call (nativeGet (nativeGet context "ports") "clock") :utcNow)
          (nativeGet event "native_message_id") (nativeGet event "native_message_id"))))
          (when row
            (setq topic (topicOf (Object/assign (js-object) event
              (js-object :root_message_id (nativeGet event "native_message_id") :reply_to (js-object :id (nativeGet event "native_message_id"))))))
            (put topic :parent_message_id nil))))
      topic))
  (export topicOf trackedTopic sameTopic))
