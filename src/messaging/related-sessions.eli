(module dj.messaging.related-sessions
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" conversationKey utf8Bytes)
  (import "../application/context.eli" can safeFields utcNow)
  (import "./topics.eli" trackedTopic)
  ;; Recorded receivers are query evidence, never inferred task ownership.
  (defun relatedRecipients (context anchor budget)
    (let* ((address (nativeGet anchor "conversation")) (topic (and anchor (trackedTopic context anchor)))
      (repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (root (if (= (nativeGet topic "kind") "reply_chain") (nativeGet topic "root_message_id") nil))
      (items (js-array)) (truncated false) (rows nil))
      (when (and anchor (js-call (js-array "native_thread" "reply_chain") :includes (nativeGet topic "kind")))
        (setq rows (js-call (js-call db :query
          "SELECT json_extract(d.payload,'$.session_key') AS session_key,MAX(e.ingress_seq) AS latest_seq FROM events e JOIN deliveries d ON d.event_id=e.event_id WHERE e.connection_id=? AND e.conversation_key=? AND json_extract(e.payload,'$.identity_revision')=? AND e.native_message_id<>? AND d.state='accepted' AND (? IS NULL OR e.native_message_id=? OR json_extract(e.payload,'$.root_message_id')=? OR json_extract(e.payload,'$.reply_to.id')=?) GROUP BY session_key ORDER BY latest_seq DESC LIMIT 33")
          :all (nativeGet anchor "connection_id") (conversationKey address) (nativeGet anchor "identity_revision") (nativeGet anchor "native_message_id") root root root root))
        (setq truncated (= (js-length rows) 33))
        (js-call rows :forEach (lambda (row)
          (let ((session (js-call repository :get "sessions" (nativeGet row "session_key"))))
            (when (and session (can context "session.inspect" session))
              (let* ((item (safeFields session (js-array "session_key" "tool" "native_namespace" "native_session_id"
                  "instance_id" "workspace_ref" "title" "runtime_state" "live_receiver" "observed_at")))
                (size (+ 2 (utf8Bytes (JSON/stringify item)))))
                (put item :stale (or (not (nativeGet session "observation_expires_at"))
                  (<= (Date/parse (nativeGet session "observation_expires_at")) (Date/parse (utcNow context)))))
                (if (and (< (js-length items) 8) (< size (- budget 192)))
                  (progn (js-call items :push item) (setq budget (- budget size 16)))
                  (setq truncated t))))))))
      (and (> (js-length items) 0) (js-object :basis "same_topic_history_not_task_ownership" :items items :truncated truncated))))
  (export relatedRecipients))
