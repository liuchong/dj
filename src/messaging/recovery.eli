(module dj.messaging.recovery
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" must requirePermission can nativeCallContext typedRef currentPrincipal utcNow)
  (import "../connections/manager.eli" imPort)
  (import "../adapters/im/lark-events.eli" normalizeLarkEvent)
  (import "../ingestion/service.eli" acceptEvent allowedAddress)
  (import "../service/ownership.eli" ownerGuard)
  (defun currentConnection (context id revision)
    (let ((connection (js-call (nativeGet context "repository") :get "connections" id)))
      (unless (and connection (js-call (js-array "lark" "slack") :includes (nativeGet connection "platform")) (not (nativeGet connection "disabled"))
        (= (nativeGet connection "identity_revision") revision)) (must (failure "stale_reference"))) connection))
  (defun projectRecovery (context record)
    (let* ((data (nativeGet (nativeGet record "safe_result") "data"))
      (resource (js-object :connection_id (nativeGet data "connection_id"))))
      (try (currentConnection context (nativeGet data "connection_id") (nativeGet data "identity_revision"))
        (if (and (can context "message.recover" resource) (can context "message.read" resource)) (success data) (failure "forbidden"))
        (catch error (or (nativeGet error "domain_result") (failure "forbidden"))))))
  (defasync handleOperation (context operation args)
    (try
      (let* ((id (nativeGet args "connection_id")) (repository (nativeGet context "repository"))
        (connection (js-call repository :get "connections" id)) (revision (nativeGet connection "identity_revision"))
        (resource (js-object :connection_id id)) (port (imPort context id)) (messages (js-array))
        (ids (Array/from (new globalThis.Set (nativeGet args "native_message_ids")))))
        (must (requirePermission context "message.recover" resource))
        (must (requirePermission context "message.read" resource))
        (currentConnection context id revision)
        (unless (nativeGet port "history") (must (failure "unsupported")))
        (let ((index 0))
          (while (< index (js-length ids))
            (let* ((native-id (aref ids index))
              (result (must (await (js-call port :history (js-object :message_id native-id) (nativeCallContext context)))))
              (rows (nativeGet result "messages")) (message (and (Array/isArray rows) (= (js-length rows) 1) (aref rows 0))))
              (unless (and message (= (nativeGet message "message_id") native-id) (not (nativeGet message "deleted"))) (must (failure "content_unavailable")))
              (let* ((sender (nativeGet message "sender"))
                (event (if (= (nativeGet connection "platform") "slack") (nativeGet message "normalized")
                  (normalizeLarkEvent connection (js-object :type "im.message.receive_v1" :message_id native-id
                  :chat_id (nativeGet message "chat_id") :thread_id (nativeGet message "thread_id" nil)
                  :root_id (nativeGet message "root_id" nil) :reply_to (nativeGet message "parent_id" nil)
                  :content (nativeGet message "content") :create_time (nativeGet message "create_time")
                  :sender_id (nativeGet sender "id") :sender_type (nativeGet sender "sender_type")
                  :sender_native_ids (js-object :open_id (nativeGet sender "id")) :sender_tenant_key (nativeGet sender "tenant_key")
                  :chat_type (nativeGet message "chat_type" "unknown") :mentions (nativeGet message "mentions" (js-array)))))))
                (unless (allowedAddress connection (nativeGet event "conversation")) (must (failure "forbidden")))
                (must (requirePermission context "message.read" (nativeGet event "conversation")))
                (js-call messages :push event)))
            (setq index (1+ index))))
        (currentConnection context id revision)
        (js-call context :accept (lambda (tx operation-id)
          (must (ownerGuard context)) (currentConnection context id revision)
          (let ((event-ids (js-array)) (created 0))
            (js-call messages :forEach (lambda (event)
              (put event :ingress_evidence (js-object :kind "explicit_native_recovery" :operation_id operation-id
                :requested_by (nativeGet (currentPrincipal context) "principal_id") :reason (nativeGet args "reason") :recovered_at (utcNow context)))
              (let ((result (must (acceptEvent context id event undefined))))
                (unless (nativeGet result "accepted") (must (failure "content_unavailable")))
                (js-call event-ids :push (nativeGet result "event_id"))
                (unless (nativeGet result "duplicate") (setq created (1+ created))))))
            (success (js-object :connection_id id :identity_revision revision :event_ids event-ids :native_message_ids ids
              :recovery_id operation-id :created_count created :recovered_count (js-length event-ids) :realtime false))))
          (lambda (data) (js-array (typedRef "message_recovery" (nativeGet data "recovery_id"))))))
      (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))
  (export handleOperation projectRecovery))
