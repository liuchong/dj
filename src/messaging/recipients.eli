(module dj.messaging.recipients
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/types.eli" stableJson nextRevision)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" must utcNow requirePermission typedRef inTransaction)

  (defconst optOutNotice "不再接收 AI 消息，请回复 TD 或退订。")
  (defun recipientContent (content)
    (let ((text (nativeGet content "text" "")))
      (Object/assign (js-object) content (js-object :text
        (if (js-call text :endsWith (str "\n\n" optOutNotice)) text (str text "\n\n" optOutNotice))))))
  (defun recipientCommand (event)
    (when (and (= (nativeGet event "event_kind") "message.created")
      (= (nativeGet (nativeGet event "sender") "kind") "human")
      (not (nativeGet (nativeGet event "content") "truncated")))
      (let ((text (js-call (js-call (nativeGet (nativeGet event "content") "text" "") :trim) :toUpperCase)))
        (cond ((js-call (js-array "TD" "退订") :includes text) "deny")
          ((= text "恢复接收") "allow") (t nil)))))
  (defun dbOf (context) (nativeGet (nativeGet context "store") "db"))
  (defun queryOne (context sql &rest values)
    (let* ((statement (js-call (dbOf context) :query sql))) (Reflect/apply (nativeGet statement "get") statement values)))
  (defun policyFor (context id)
    (or (js-call (nativeGet context "repository") :get "recipient_policies" id)
      (js-object :connection_id id :revision 0 :default_action "allow"
        :allow (js-object :recipient_ids (js-array) :chat_ids (js-array))
        :deny (js-object :recipient_ids (js-array) :chat_ids (js-array)))))
  (defun recipientScope (connection)
    (let* ((platform (nativeGet connection "platform"))
      (app (nativeGet connection "event_app_id" (nativeGet (nativeGet connection "user_identity") "app_id"))))
      (cond ((and (= platform "lark") app) (stableJson (js-array (nativeGet connection "brand" "lark") "app" app)))
        ((and (= platform "slack") (nativeGet connection "tenant_ref"))
          (stableJson (js-array "slack" (nativeGet connection "tenant_ref"))))
        ((= platform "telegram") "telegram:user")
        (t (stableJson (js-array "connection" (nativeGet connection "connection_id")))))))
  (defun recipientDenied (context connection person)
    ;; Shared consent only where native ID namespaces are demonstrably equal.
    ;; In particular, user/bot connections of one Lark application cannot evade TD.
    (let* ((rows (js-call (js-call (dbOf context) :query
      "SELECT p.payload,c.payload AS connection_payload FROM recipient_optouts p JOIN connections c ON c.connection_id=p.connection_id WHERE p.recipient_id=? LIMIT 1025") :all person))
      (scope (recipientScope connection)) (latest nil))
      (if (> (js-length rows) 1024) t
        (progn
          (js-call rows :forEach (lambda (row)
            (when (= scope (recipientScope (JSON/parse (nativeGet row "connection_payload"))))
              (let* ((choice (JSON/parse (nativeGet row "payload")))
                (time (Date/parse (nativeGet choice "source_time")))
                (previous (and latest (Date/parse (nativeGet latest "source_time")))))
                (when (or (not latest) (> time previous)
                  (and (= time previous) (= (nativeGet choice "state") "deny")))
                  (setq latest choice))))))
          (= (nativeGet latest "state") "deny")))))
  (defun stageRecipientCommand (context event)
    ;; Native identity only. Never infer a recipient from a display name or AI text.
    (let* ((id (nativeGet event "connection_id")) (chat (nativeGet (nativeGet event "conversation") "native_chat_id"))
      (sender (nativeGet event "sender")) (person (nativeGet sender "id"))
      (connection (js-call (nativeGet context "repository") :get "connections" id))
      (self (= person (nativeGet connection "event_subject_id")))
      (echo (queryOne context "SELECT 1 AS found FROM echo_index WHERE connection_id=? AND native_message_id=?" id (nativeGet event "native_message_id")))
      (human (and (= (nativeGet sender "kind") "human") (= (nativeTypeOf person) "string")
        (not (= person "unknown")) (not self) (not echo)))
      (p2p (= (nativeGet event "chat_type") "p2p")))
      (when (and human p2p)
        (js-call (js-call (dbOf context) :query
          "INSERT INTO recipient_peers(connection_id,native_chat_id,recipient_id) VALUES (?,?,?) ON CONFLICT(connection_id,native_chat_id) DO UPDATE SET recipient_id=excluded.recipient_id") :run id chat person))
      (let ((command (and human (recipientCommand event))))
        ;; The sender controls their own consent, independently of group reply targets.
        (when command
          (let* ((repository (nativeGet context "repository")) (key (js-object :connection_id id :recipient_id person))
            (old (js-call repository :get "recipient_optouts" key))
            (record (js-object :connection_id id :recipient_id person :state command :event_id (nativeGet event "event_id")
              :updated_at (utcNow context) :source_time (nativeGet event "source_time" (nativeGet event "received_at")))))
            ;; Late HTTP catch-up must not undo a newer explicit preference.
            (when (or (not old) (>= (Date/parse (nativeGet record "source_time")) (Date/parse (nativeGet old "source_time"))))
              (if old (must (js-call repository :replace "recipient_optouts" record))
                (js-call repository :insert "recipient_optouts" record)))
            t)))))
  (defun recoverRecipientCommands (context)
    ;; Re-derive missed choices from persisted native input before any outbound resumes.
    ;; Bounded pages, immutable source times, no message delivery or AI-controlled state.
    (let* ((db (dbOf context))
      (ceiling (nativeGet (js-call (js-call db :query "SELECT COALESCE(MAX(ingress_seq),0) AS n FROM events") :get) "n"))
      (after 0) (done false) (count 0))
      (while (not done)
        (let ((result (inTransaction context (lambda (tx)
          (let ((rows (js-call (js-call db :query
            "SELECT ingress_seq,payload FROM events WHERE ingress_seq>? AND ingress_seq<=? AND event_kind='message.created' AND (json_extract(payload,'$.content.text') LIKE '%TD%' OR json_extract(payload,'$.content.text') LIKE '%退订%' OR json_extract(payload,'$.content.text') LIKE '%恢复接收%') ORDER BY ingress_seq LIMIT 256") :all after ceiling)))
            (js-call rows :forEach (lambda (row)
              (let ((event (JSON/parse (nativeGet row "payload"))))
                (when (recipientCommand event)
                  (when (stageRecipientCommand context event) (setq count (1+ count)))))
              (setq after (nativeGet row "ingress_seq"))))
            (setq done (< (js-length rows) 256))
            (success nil))))))
          (unless (nativeGet result "ok") (must result))))
      (success (js-object :processed count))))
  (defun recipientTargets (context address reply-to content)
    (let* ((id (nativeGet address "connection_id")) (chat (nativeGet address "native_chat_id"))
      (targets (new globalThis.Set))
      (peer (queryOne context "SELECT recipient_id FROM recipient_peers WHERE connection_id=? AND native_chat_id=?" id chat)))
      (when peer (js-call targets :add (nativeGet peer "recipient_id")))
      (when reply-to
        (let* ((sent (queryOne context "SELECT o.payload FROM outbound o JOIN echo_index e ON e.outbound_id=o.outbound_id WHERE e.connection_id=? AND e.native_message_id=?" id reply-to))
          (parent (if sent (nativeGet (JSON/parse (nativeGet sent "payload")) "native_reply_to") reply-to))
          (row (and parent (queryOne context
            "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? AND json_extract(payload,'$.conversation.native_chat_id')=? AND event_kind='message.created' ORDER BY ingress_seq DESC LIMIT 1" id parent chat))))
          (when row (js-call targets :add (nativeGet (nativeGet (JSON/parse (nativeGet row "payload")) "sender") "id")))))
      (js-call (Array/from (js-call (nativeGet content "text" "") :matchAll
        (new globalThis.RegExp "<at\\s+user_id=[\"']([^\"']+)[\"'][^>]*>|<@([A-Z0-9]+)(?:\\|[^>]+)?>" "g"))) :forEach
        (lambda (match) (js-call targets :add (or (aref match 1) (aref match 2)))))
      (Array/from targets)))
  (defun checkRecipients (context address reply-to content &optional force-send)
    ;; Explicit, durable exception for this outbound only; never mutates consent.
    (if (= force-send t) (success nil)
    (let* ((id (nativeGet address "connection_id")) (chat (nativeGet address "native_chat_id"))
      (targets (recipientTargets context address reply-to content)) (policy (policyFor context id))
      (connection (js-call (nativeGet context "repository") :get "connections" id))
      (matches (lambda (list)
        (or (js-call (nativeGet list "chat_ids" (js-array)) :includes chat)
          (js-call targets :some (lambda (person) (js-call (nativeGet list "recipient_ids" (js-array)) :includes person))))))
      (opted-out (js-call targets :some (lambda (person) (recipientDenied context connection person)))))
      (if opted-out (failure "recipient_opted_out")
        (if (or (funcall matches (nativeGet policy "deny"))
          (and (= (nativeGet policy "default_action") "deny") (not (funcall matches (nativeGet policy "allow")))))
          (failure "recipient_blocked") (success nil))))))
  (defun policyOperation (context operation args)
    (try
    (let* ((id (nativeGet args "connection_id")) (repository (nativeGet context "repository"))
      (connection (js-call repository :get "connections" id)))
      (must (requirePermission context "connection.manage" connection))
      (unless connection (must (failure "not_found")))
      (if (= operation "message.recipient_policy.get")
        (let* ((policy (policyFor context id)) (rows (js-call (js-call (dbOf context) :query
          "SELECT payload FROM recipient_optouts WHERE connection_id=? AND recipient_id>? ORDER BY recipient_id LIMIT 101")
          :all id (nativeGet args "after" ""))) (more (> (js-length rows) 100)) (items (js-call rows :slice 0 100)))
          (success (Object/assign (js-object) policy (js-object
            :optouts (js-call items :map (lambda (row) (JSON/parse (nativeGet row "payload"))))
            :has_more more :next_after (if more (nativeGet (JSON/parse (nativeGet (aref items 99) "payload")) "recipient_id") nil)))))
        (js-call context :accept (lambda (tx operation-id)
          (must (requirePermission context "connection.manage" connection))
          (let* ((old (js-call repository :get "recipient_policies" id)) (expected (nativeGet args "expected_revision"))
            (record (Object/assign (js-object) (nativeGet args "policy")
              (js-object :connection_id id :revision (if old (nextRevision (nativeGet old "revision")) 1)))))
            (unless (= expected (nativeGet old "revision" 0)) (must (failure "revision_conflict")))
            (if old (must (js-call repository :replace "recipient_policies" record))
              (js-call repository :insert "recipient_policies" record))
            (success record)))
          (lambda (data) (js-array (typedRef "recipient_policy" id))))))
      (catch error (or (nativeGet error "domain_result") (failure "internal_error")))))
  (export optOutNotice recipientContent recipientCommand stageRecipientCommand recoverRecipientCommands checkRecipients policyOperation recipientTargets))
