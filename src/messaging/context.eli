(module dj.messaging.context
  (import "./topics.eli" topicOf trackedTopic sameTopic)
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" conversationKey addSeconds sliceUtf8 utf8Bytes hashValue sourceReadAction)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli" utcNow can requirePermission must issueResourceHandle resolveResourceHandle nativeCallContext safeFields)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../connections/manager.eli" imPort)
  (import "../ingestion/service.eli" allowedAddress)
  (import "../ingestion/visibility.eli" eventReadable)
  (import "./service.eli" resolveConversation)

  (defun scopedConnection (context address &optional revision)
    (let ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet address "connection_id"))))
      (unless (and connection (allowedAddress connection address) (can context (sourceReadAction address) address))
        (must (failure "forbidden")))
      (when (and revision (not (= revision (nativeGet connection "identity_revision" (nativeGet connection "revision")))))
        (must (failure "stale_reference")))
      connection))
  (defun matchesAddress (address event)
    (let ((actual (nativeGet event "conversation")))
      (and (= (nativeGet address "connection_id") (nativeGet event "connection_id"))
        (= (nativeGet address "native_chat_id") (nativeGet actual "native_chat_id"))
        (= (nativeGet address "native_thread_id" nil) (nativeGet actual "native_thread_id" nil)))))
  (defun scopeHandle (context address revision &optional event)
    (nativeGet (must (issueResourceHandle context "message_context" (conversationKey address)
      (js-object :address address :identity_revision revision :anchor_event_id (nativeGet event "event_id" nil)
        :native_message_id (nativeGet event "native_message_id" nil) :topic (and event (trackedTopic context event)))
      (nativeGet limits "handle_ttl_seconds"))) "ref"))
  (defun localMessage (context address id)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (row (js-call (js-call db :query "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? LIMIT 1") :get (nativeGet address "connection_id") id))
      (event (and row (JSON/parse (nativeGet row "payload")))))
      (cond (event (and (matchesAddress address event) (eventReadable context event) event))
        (t (let* ((connection (scopedConnection context address))
          (cached (js-call (js-call db :query "SELECT payload FROM context_messages WHERE connection_id=? AND identity_revision=? AND native_message_id=? AND expires_at>?")
            :get (nativeGet address "connection_id") (nativeGet connection "identity_revision" (nativeGet connection "revision")) id (utcNow context)))
          (message (and cached (JSON/parse (nativeGet cached "payload")))))
          (and message (matchesAddress address message) message))))))
  (defun resolveScope (context args)
    (let ((address nil) (event nil) (revision nil) (handle nil))
      (cond ((nativeGet args "conversation_ref")
        (setq address (nativeGet (must (resolveConversation context (nativeGet args "conversation_ref") "message.read")) "address")))
        ((nativeGet args "context_ref")
          (setq handle (must (resolveResourceHandle context (nativeGet args "context_ref") "message_context"))
            address (nativeGet handle "address") revision (nativeGet handle "identity_revision"))
          (when (nativeGet handle "anchor_event_id")
            (setq event (js-call (nativeGet context "repository") :get "events" (nativeGet handle "anchor_event_id")))
            (unless (and event (eventReadable context event)) (must (failure "content_unavailable")))))
        (t (let ((id (nativeGet args "event_id")))
          (when (nativeGet args "message_ref")
            (setq handle (must (resolveResourceHandle context (nativeGet args "message_ref") "message"))
              id (nativeGet handle "resource_key") revision (nativeGet handle "identity_revision")))
          (setq event (js-call (nativeGet context "repository") :get "events" id))
          (unless (and event (eventReadable context event)) (must (failure "forbidden")))
          (setq address (nativeGet event "conversation")))))
      (let* ((connection (scopedConnection context address revision))
        (fence (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
        (must (requirePermission context (sourceReadAction address) address))
        (when (and (nativeGet args "native_message_id") (not (nativeGet args "context_ref"))) (must (failure "invalid_argument")))
        (let ((id (nativeGet args "native_message_id" (nativeGet event "native_message_id" (nativeGet handle "native_message_id")))))
          (success (js-object :address address :identity_revision fence :connection connection :anchor event :native_message_id id :topic (nativeGet handle "topic" (and event (trackedTopic context event)))))))))
  (defun projectMessage (context message maximum &optional offset)
    (let* ((result (safeFields message (js-array "event_id" "native_message_id" "connection_id" "conversation" "sender" "mentions" "reaction" "interaction" "reply_to" "root_message_id" "source_time" "received_at" "attachments")))
      (body (nativeGet message "content")) (page (sliceUtf8 (nativeGet body "text" "") (or offset 0) (Math/max 4 maximum))))
      (unless (nativeGet page "ok") (must page))
      (Object/assign result (safeFields page (js-array "offset_bytes" "next_offset_bytes" "complete" "total_bytes")))
      (put result :topic (trackedTopic context message))
      (put result :corpus (if (nativeGet message "cached_native") "native" "local"))
      (put result :content (js-object :kind "text" :text (nativeGet page "text")
        :truncated (or (not (nativeGet page "complete")) (= (nativeGet body "truncated") t))
        :original_bytes (nativeGet body "original_bytes" (nativeGet page "total_bytes"))))
      result))
  (defun fitMessage (context message budget &optional offset)
    (let ((size (Math/min budget 8192)) (result nil) (done false))
      (while (and (not done) (>= size 4))
        (setq result (projectMessage context message size offset))
        (if (<= (utf8Bytes (JSON/stringify result)) budget) (setq done t)
          (setq size (Math/floor (/ size 2)))))
      (and done result)))
  (defun localHistory (context address &optional last-key ascending count range topic)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (connection (scopedConnection context address)) (fence (nativeGet connection "identity_revision" (nativeGet connection "revision")))
      (cap (or count 51)) (operator (if ascending ">" "<")) (direction (if ascending " ASC" " DESC"))
      (from (nativeGet range "from" "")) (until (nativeGet range "to" "9999"))
      (root (nativeGet topic "root_message_id" nil))
      (narrow (and topic (not (= (nativeGet topic "kind") "conversation")) (not (= (nativeGet topic "kind") "native_thread"))))
      (topic-clause (if narrow " AND (native_message_id=? OR json_extract(payload,'$.root_message_id')=? OR json_extract(payload,'$.reply_to.id')=?)" ""))
      (topic-values (if narrow (js-array root root root) (js-array)))
      (event-key "COALESCE(json_extract(payload,'$.source_time'),received_at)||'/'||native_message_id")
      (cache-key "source_time||'/'||native_message_id")
      (rows (js-call (js-call db :query (str "SELECT payload," event-key " AS scan_key FROM events WHERE connection_id=? AND conversation_key=? AND COALESCE(json_extract(payload,'$.source_time'),received_at)>=? AND COALESCE(json_extract(payload,'$.source_time'),received_at)<?"
        topic-clause (if last-key (str " AND (" event-key ")" operator "?") "") " ORDER BY scan_key" direction " LIMIT ?"))
        :all (js-call (js-array (nativeGet address "connection_id") (conversationKey address) from until) :concat
          topic-values (if last-key (js-array last-key cap) (js-array cap)))))
      (cached (js-call (js-call db :query (str "SELECT payload," cache-key " AS scan_key FROM context_messages WHERE connection_id=? AND identity_revision=? AND conversation_key=? AND expires_at>? AND source_time>=? AND source_time<?"
        topic-clause (if last-key (str " AND (" cache-key ")" operator "?") "") " ORDER BY scan_key" direction " LIMIT ?"))
        :all (js-call (js-array (nativeGet address "connection_id") fence (conversationKey address) (utcNow context) from until) :concat
          topic-values (if last-key (js-array last-key cap) (js-array cap)))))
      (messages (new globalThis.Map)) (bytes 0) (last nil))
      (js-call rows :forEach (lambda (row)
        (setq bytes (+ bytes (utf8Bytes (nativeGet row "payload"))))
        (when (<= bytes 1048576)
          (setq last (nativeGet row "scan_key"))
          (let ((event (JSON/parse (nativeGet row "payload"))))
            (js-call messages :set (nativeGet event "native_message_id") (and (eventReadable context event) event))))))
      (js-call cached :forEach (lambda (row)
        (setq bytes (+ bytes (utf8Bytes (nativeGet row "payload"))))
        (when (<= bytes 1048576)
          (let* ((event (JSON/parse (nativeGet row "payload")))
            (existing (js-call (js-call db :query "SELECT payload FROM events WHERE connection_id=? AND native_message_id=? LIMIT 1") :get (nativeGet address "connection_id") (nativeGet event "native_message_id"))))
            (unless (or (js-call messages :has (nativeGet event "native_message_id")) existing)
              (js-call messages :set (nativeGet event "native_message_id") event))))))
      (let ((items (js-call (js-call (Array/from (js-call messages :values)) :filter (lambda (event) event)) :sort
        (lambda (a b) (js-call (messageKey a) :localeCompare (messageKey b))))))
        (put items :scan_truncated (or (= (js-length rows) cap) (= (js-length cached) cap) (> bytes 1048576)))
        (put items :last_scan_key last) items)))
  (defun messageKey (message)
    (str (nativeGet message "source_time" (nativeGet message "received_at" "")) "/" (nativeGet message "native_message_id")))
  (defun cacheMessage (context address revision message)
    (let* ((text (nativeGet message "content" ""))
      (time (nativeGet message "create_time"))
      (stamp (if (= (nativeTypeOf time) "string") (new globalThis.Date (globalThis.Number time)) nil))
      (id (nativeGet message "message_id")) (sender (nativeGet message "sender"))
      (actual (Object/assign (js-object) address (js-object :native_thread_id (nativeGet message "thread_id" nil)
        :thread_kind (if (nativeGet message "thread_id") "thread" "main"))))
      (event (js-object :connection_id (nativeGet address "connection_id") :conversation actual
        :native_message_id id :identity_revision revision :cached_native t :fetched_at (utcNow context)
        :source_time (and stamp (Number/isFinite (js-call stamp :getTime)) (js-call stamp :toISOString))
        :sender (js-object :id (nativeGet sender "id" "unknown") :kind (if (= (nativeGet sender "sender_type") "user") "human" "bot"))
        :mentions (js-call (nativeGet message "mentions" (js-array)) :map (lambda (m)
          (js-object :id (nativeGet m "id" "") :name (nativeGet m "name" ""))))
        :content (js-object :kind "text" :text (nativeGet (sliceUtf8 text 0 262144) "text")
          :original_bytes (utf8Bytes text) :truncated (> (utf8Bytes text) 262144)) :attachments (js-array))))
      (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0) (nativeGet event "source_time")
        (not (= (nativeGet message "deleted") t)) (= (nativeGet message "chat_id") (nativeGet address "native_chat_id"))
        (matchesAddress address event)) (must (failure "content_unavailable")))
      (when (nativeGet message "parent_id") (put event :reply_to (js-object :id (nativeGet message "parent_id"))))
      (when (nativeGet message "root_id") (put event :root_message_id (nativeGet message "root_id")))
      event))
  (defasync nativeRead (context scope parameters)
    (let* ((address (nativeGet scope "address")) (revision (nativeGet scope "identity_revision"))
      (port (imPort context (nativeGet address "connection_id")))
      (connection (scopedConnection context address revision)))
      (unless (and port (nativeGet port "history")) (must (failure "unsupported")))
      (let* ((call (nativeCallContext context))
        (response nil))
        (setq response (must (await (js-call port :history parameters call))))
        (scopedConnection context address revision)
        (unless (and (Array/isArray (nativeGet response "messages")) (<= (js-length (nativeGet response "messages")) 50)
          (= (nativeTypeOf (nativeGet response "has_more")) "boolean")) (must (failure "incompatible")))
        (when (and (nativeGet response "has_more") (or (not (nativeGet response "page_token")) (= (nativeGet response "page_token") (nativeGet parameters "page_token")))) (must (failure "incompatible")))
        (let ((items (js-array)))
          (js-call (nativeGet response "messages") :forEach (lambda (message)
            (if (= (nativeGet message "deleted") t)
              nil
              (js-call items :push (cacheMessage context address revision message)))))
          (must (await (enqueueWrite context (lambda ()
            (scopedConnection context address revision)
            (let ((db (nativeGet (nativeGet context "store") "db")))
              (js-call items :forEach (lambda (event)
                (js-call (js-call db :query "INSERT INTO context_messages(connection_id,identity_revision,native_message_id,conversation_key,source_time,expires_at,payload) VALUES(?,?,?,?,?,?,?) ON CONFLICT(connection_id,identity_revision,native_message_id) DO UPDATE SET conversation_key=excluded.conversation_key,source_time=excluded.source_time,expires_at=excluded.expires_at,payload=excluded.payload")
                  :run (nativeGet address "connection_id") revision (nativeGet event "native_message_id") (conversationKey address)
                  (nativeGet event "source_time") (addSeconds (utcNow context) (nativeGet limits "body_retention_seconds")) (JSON/stringify event))))
              (js-call db :run "DELETE FROM context_messages WHERE rowid IN (SELECT rowid FROM context_messages ORDER BY expires_at DESC,rowid DESC LIMIT -1 OFFSET 10000)"))
            (success nil)))))
          (js-object :items items :more (nativeGet response "has_more") :token (nativeGet response "page_token" nil))))))
  (defun collectContext (context scope args)
    (let* ((address (nativeGet scope "address")) (anchor (or (nativeGet scope "anchor") (localMessage context address (nativeGet scope "native_message_id"))))
      (before (nativeGet args "before" 10)) (after (nativeGet args "after" 0)) (depth (nativeGet args "reference_depth" 4))
      (maximum (nativeGet args "max_bytes" 16384))
      (result (js-object :context_ref (scopeHandle context address (nativeGet scope "identity_revision") anchor)
        :as_of (utcNow context) :corpus (nativeGet args "corpus" "local") :scope (if (= (nativeGet args "scope" "topic") "topic") "topic" "conversation") :topic (trackedTopic context anchor)
        :coverage_complete false :coverage_reason "bounded_local_and_recent_native_cache" :truncated false
        :external_data t :query_available t :messages (js-array) :references (js-array)))
      (budget (- maximum (utf8Bytes (JSON/stringify result)) 128)) (rows nil)
      (references (nativeGet result "references")) (seen (new globalThis.Set)) (pending (js-array))
      (append nil))
      (setq append (lambda (message field &optional offset)
        (let ((projected (fitMessage context message budget offset)))
          (if projected
            (progn (setq budget (- budget (utf8Bytes (JSON/stringify projected)) 2))
              (if (= field "anchor") (put result :anchor projected) (js-call (nativeGet result field) :push projected))
              (when (nativeGet (nativeGet projected "content") "truncated") (put result :truncated t)))
            (put result :truncated t)))))
      (when anchor
        (funcall append anchor "anchor" (nativeGet args "offset_bytes" 0))
        (when (nativeGet (nativeGet anchor "reply_to") "id") (js-call pending :push (js-object :id (nativeGet (nativeGet anchor "reply_to") "id") :relation "parent")))
        (when (nativeGet anchor "root_message_id") (js-call pending :push (js-object :id (nativeGet anchor "root_message_id") :relation "root"))))
      (let ((count 0))
        (while (and (> (js-length pending) 0) (< count depth))
          (let* ((item (js-call pending :shift)) (id (nativeGet item "id")))
            (unless (or (js-call seen :has id) (= id (nativeGet anchor "native_message_id")))
              (js-call seen :add id) (setq count (1+ count))
              (let* ((message (localMessage context address id))
                (reference (js-object :native_message_id id :relation (nativeGet item "relation")
                  :status (if message "available" "unavailable"))))
                (if message
                  (let ((projection (fitMessage context message (Math/max 0 (- budget 160)))))
                    (if projection (put reference :message projection) (progn (put reference :status "unavailable") (put reference :reason "byte_budget")))
                    (when (nativeGet (nativeGet message "reply_to") "id")
                      (js-call pending :push (js-object :id (nativeGet (nativeGet message "reply_to") "id") :relation "ancestor"))))
                  (put reference :reason "not_in_authorized_cache"))
                (let ((size (utf8Bytes (JSON/stringify reference))))
                  (if (< size budget) (progn (js-call references :push reference) (setq budget (- budget size 1))) (put result :truncated t)))))))
        (when (> (js-length pending) 0) (put result :truncated t)))
      (when anchor
        (let* ((key (messageKey anchor))
          (older (if (> before 0) (localHistory context address key false before nil (if (= (nativeGet args "scope" "topic") "topic") (trackedTopic context anchor) nil)) (js-array)))
          (newer (if (> after 0) (localHistory context address key t after nil (if (= (nativeGet args "scope" "topic") "topic") (trackedTopic context anchor) nil)) (js-array))))
          (js-call (js-call older :slice (Math/max 0 (- (js-length older) before))) :forEach (lambda (row) (funcall append row "messages")))
          (js-call (js-call newer :slice 0 after) :forEach (lambda (row) (funcall append row "messages"))))
      )
      result))
  (defasync enrichScope (context scope args)
    (let* ((address (nativeGet scope "address")) (id (nativeGet scope "native_message_id"))
      (maximum (nativeGet args "before" 10)) (failure-code nil))
      (try
        (when id
          (let* ((page (await (nativeRead context scope (js-object :message_id id))))
            (found (js-call (nativeGet page "items") :find (lambda (message) (= (nativeGet message "native_message_id") id)))))
            (unless found (must (failure "content_unavailable")))
            (put scope :anchor found)))
        (when (> maximum 0)
          (await (nativeRead context scope (js-object :chat_id (nativeGet address "native_chat_id")
            :thread_id (nativeGet address "native_thread_id") :order "desc" :limit (Math/min 50 (+ maximum 1))
            :end (nativeGet (or (nativeGet scope "anchor") (localMessage context address id)) "source_time")))))
        (when (> (nativeGet args "after" 0) 0)
          (await (nativeRead context scope (js-object :chat_id (nativeGet address "native_chat_id")
            :thread_id (nativeGet address "native_thread_id") :order "asc" :limit (1+ (nativeGet args "after"))
            :start (nativeGet (or (nativeGet scope "anchor") (localMessage context address id)) "source_time")))))
        (let* ((anchor (or (nativeGet scope "anchor") (localMessage context address id)))
          (pending (js-array (nativeGet (nativeGet anchor "reply_to") "id") (nativeGet anchor "root_message_id")))
          (seen (new globalThis.Set)) (count 0))
          (while (and (> (js-length pending) 0) (< count (nativeGet args "reference_depth" 4)))
            (let ((ref (js-call pending :shift)))
              (when (and ref (not (js-call seen :has ref)) (not (= ref id)))
                (js-call seen :add ref) (setq count (1+ count))
                (unless (localMessage context address ref) (await (nativeRead context scope (js-object :message_id ref))))
                (let ((parent (localMessage context address ref)))
                  (when (nativeGet (nativeGet parent "reply_to") "id") (js-call pending :push (nativeGet (nativeGet parent "reply_to") "id"))))))))
        (catch error (setq failure-code (nativeGet (nativeGet error "domain_result") "error" (js-object :code "unavailable")))))
      failure-code))
  (defun policyFor (contributions)
    (let ((before (if (> (js-length contributions) 0) 19 0)) (maximum 16384))
      (js-call contributions :forEach (lambda (item)
        (let ((policy (nativeGet item "context_policy")))
          (setq before (Math/min before (if (= (nativeGet policy "mode") "recent") (1- (nativeGet policy "max_events" 10)) 0)))
          (setq maximum (Math/min maximum (nativeGet policy "max_bytes" 16384))))))
      (js-object :before before :after 0 :reference_depth 4 :max_bytes maximum)))
  (defun envelopeContext (context recipient event contributions)
    (let* ((scoped (Object/assign (js-object) context (js-object :principal recipient)))
      (address (nativeGet event "conversation")) (connection (scopedConnection scoped address))
      (scope (js-object :address address :anchor event :native_message_id (nativeGet event "native_message_id")
        :identity_revision (nativeGet connection "identity_revision" (nativeGet connection "revision")))))
      (collectContext scoped scope (policyFor contributions))))
  (defasync handleOperation (context operation args)
    (try
      (let* ((scope (must (resolveScope context args))) (address (nativeGet scope "address"))
        (revision (nativeGet scope "identity_revision")))
        (if (= operation "message.context")
          (progn
            (when (nativeGet args "native_message_id")
              (put scope :native_message_id (nativeGet args "native_message_id"))
              (put scope :anchor (localMessage context address (nativeGet args "native_message_id"))))
            (let ((error nil))
              (when (= (nativeGet args "corpus") "native") (setq error (await (enrichScope context scope args))))
              (scopedConnection context address revision)
              (let ((result (collectContext context scope args)))
                (unless (nativeGet result "anchor") (must (failure "content_unavailable")))
                (when (and error (js-call (js-array "content_unavailable" "forbidden" "stale_reference") :includes (nativeGet error "code"))) (must (failure (nativeGet error "code"))))
                (when error (put result :coverage_reason (str "native_" (nativeGet error "code" "unavailable"))))
                (success result))))
          (let* ((native (= (nativeGet args "corpus") "native"))
            (query (hashValue (Object/assign (js-object) args (js-object :cursor nil :request_id nil))))
            (cursor (and (nativeGet args "cursor") (must (resolveResourceHandle context (nativeGet args "cursor") "cursor"))))
            (maximum (nativeGet args "max_bytes" 16384)) (budget (- maximum 320))
            (items (js-array)) (more false) (last nil) (page nil) (rows nil))
            (when (and cursor (or (not (= (nativeGet cursor "query_hash") query))
              (not (= (nativeGet cursor "identity_revision") revision)) (not (= (nativeGet cursor "resource_key") (conversationKey address)))))
              (must (failure "stale_reference")))
            (if native
              (progn
                (setq page (if (nativeGet cursor "native_ids")
                  (js-object :items (js-call (js-call (nativeGet cursor "native_ids") :map (lambda (id) (localMessage context address id))) :filter (lambda (item) item))
                    :more (not (nil? (nativeGet cursor "native_token" nil))) :token (nativeGet cursor "native_token" nil))
                  (await (nativeRead context scope (js-object :chat_id (nativeGet address "native_chat_id")
                  :thread_id (nativeGet address "native_thread_id") :order (nativeGet args "order" "desc")
                  :limit (nativeGet args "limit" 20) :page_token (nativeGet cursor "native_token" nil)
                  :start (nativeGet (nativeGet args "time_range") "from") :end (nativeGet (nativeGet args "time_range") "to"))))))
                (setq rows (nativeGet page "items") more (nativeGet page "more"))
                (when (and (= (nativeGet args "scope" "topic") "topic")
                  (= (nativeGet (nativeGet scope "topic") "kind") "reply_chain"))
                  (setq rows (js-call rows :filter (lambda (item)
                    (let ((root (nativeGet (nativeGet scope "topic") "root_message_id")))
                      (or (= (nativeGet item "native_message_id") root)
                        (= (nativeGet item "root_message_id") root)
                        (= (nativeGet (nativeGet item "reply_to") "id") root))))))))
              (progn
                (setq rows (localHistory context address (nativeGet cursor "last_key") (= (nativeGet args "order" "desc") "asc") (1+ (nativeGet args "limit" 20)) (nativeGet args "time_range") (if (= (nativeGet args "scope" "topic") "topic") (nativeGet scope "topic") nil)))
                (setq more (nativeGet rows "scan_truncated" false))
                (when (= (nativeGet args "order" "desc") "desc") (js-call rows :reverse))))
            (let ((position 0) (i 0))
              (js-call rows :forEach (lambda (message)
                (let* ((key (messageKey message)) (time (Date/parse (nativeGet message "source_time" (nativeGet message "received_at"))))
                  (from (nativeGet (nativeGet args "time_range") "from")) (to (nativeGet (nativeGet args "time_range") "to"))
                  (key-ok (or native (not cursor) (if (= (nativeGet args "order" "desc") "desc") (< (js-call key :localeCompare (nativeGet cursor "last_key")) 0) (> (js-call key :localeCompare (nativeGet cursor "last_key")) 0)))))
                  (when (and key-ok (>= i position) (or (not from) (>= time (Date/parse from))) (or (not to) (< time (Date/parse to))))
                    (if (or (>= (js-length items) (nativeGet args "limit" 20)) (< budget 256))
                      (progn (setq more t) (unless last (setq last (js-object :key key :position i))))
                      (let ((projection (fitMessage context message budget)))
                        (unless projection (when (= (js-length items) 0) (must (failure "limit_exceeded"))))
                        (when projection (js-call items :push projection) (setq budget (- budget (utf8Bytes (JSON/stringify projection)) 1))
                          (setq last (js-object :key key :position (1+ i)))))))
                  (setq i (1+ i)))))
              ;; Native pages resume within the same page when a byte bound cuts it short.
              (unless last (when (nativeGet rows "last_scan_key") (setq last (js-object :key (nativeGet rows "last_scan_key")))))
              (let* ((unfinished (and native last (< (nativeGet last "position") (js-length rows))))
                (next (when more (nativeGet (must (issueResourceHandle context "cursor" (conversationKey address)
                  (js-object :query_hash query :identity_revision revision :last_key (nativeGet last "key" "")
                    :native_token (nativeGet page "token" nil)
                    :native_ids (if unfinished (js-call (js-call rows :slice (nativeGet last "position")) :map (lambda (item) (nativeGet item "native_message_id"))) nil)) (nativeGet limits "handle_ttl_seconds"))) "ref"))))
                (scopedConnection context address revision)
                (success (js-object :context_ref (scopeHandle context address revision) :items items :next_cursor next
                  :complete (not more) :corpus (if native "native" "local") :as_of (utcNow context)
                  :coverage_complete false :coverage_reason (if native "authorized_native_page" "bounded_local_and_recent_native_cache")
                  :truncated (or unfinished (< budget 256)))))))))
      (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))
  (export resolveScope handleOperation envelopeContext collectContext matchesAddress projectMessage messageKey policyFor))
