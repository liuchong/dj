(module dj.messaging.actions
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" must requirePermission can nativeCallContext typedRef utcNow)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../connections/manager.eli" imPort dispatchIm)
  (import "../ingestion/service.eli" allowedAddress)
  (import "../service/ownership.eli" ownerGuard)
  (import "./context.eli" resolveScope)
  (import "./service.eli" resolveConversation projectOutbound)

  (defconst mutations (js-array "message.recall" "message.edit" "message.reaction.add" "message.reaction.remove"))
  (defun currentConnection (context address revision)
    (let ((connection (js-call (nativeGet context "repository") :get "connections" (nativeGet address "connection_id"))))
      (unless (and connection (not (nativeGet connection "disabled")) (allowedAddress connection address)
        (= revision (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
        (must (failure "stale_reference")))
      (unless (= (nativeGet connection "platform") "lark") (must (failure "unsupported")))
      (unless (can context "message.read" address) (must (failure "forbidden"))) connection))
  (defun projectAction (context record)
    (try
      (unless (and record (js-call mutations :includes (nativeGet record "operation")) (can context "operation.inspect" record))
        (must (failure "forbidden")))
      (let ((data (nativeGet (nativeGet record "safe_result") "data")))
        (currentConnection context (nativeGet data "destination") (nativeGet data "identity_revision"))
        (success data))
      (catch error (or (nativeGet error "domain_result") (failure "forbidden")))))
  (defun resolveTarget (context args)
    (let ((scope nil) (id (nativeGet args "native_message_id")))
      (cond ((nativeGet args "outbound_id")
        (when id (must (failure "invalid_argument")))
        (let* ((record (js-call (nativeGet context "repository") :get "outbound" (nativeGet args "outbound_id")))
          (projection (and record (can context "outbound.inspect" record) (projectOutbound context record)))
          (ids (nativeGet projection "native_message_ids" (js-array))))
          (unless projection (must (failure "forbidden")))
          (unless (and (= (nativeGet record "state") "accepted") (= (js-length ids) 1)) (must (failure "ambiguous_target")))
          (setq scope (js-object :address (nativeGet record "destination") :identity_revision (nativeGet record "identity_revision")
            :native_message_id (aref ids 0)))))
        ((nativeGet args "conversation_ref")
          (unless id (must (failure "invalid_argument")))
          (let* ((resolved (must (resolveConversation context (nativeGet args "conversation_ref") "message.read")))
            (connection (nativeGet resolved "connection")))
            (setq scope (js-object :address (nativeGet resolved "address")
              :identity_revision (nativeGet connection "identity_revision" (nativeGet connection "revision")) :native_message_id id))))
        (t (when (and id (not (nativeGet args "context_ref"))) (must (failure "invalid_argument")))
          (when (and (nativeGet args "context_ref") (not id)) (must (failure "invalid_argument")))
          (setq scope (must (resolveScope context args)))))
      (unless (nativeGet scope "native_message_id") (must (failure "invalid_argument")))
      (currentConnection context (nativeGet scope "address") (nativeGet scope "identity_revision")) scope))
  (defasync nativeMessage (context scope)
    (let* ((address (nativeGet scope "address")) (port (imPort context (nativeGet address "connection_id"))))
      (unless (and (nativeGet port "history") (nativeGet port "messageAction")) (must (failure "unsupported")))
      (let* ((response (must (await (js-call port :history (js-object :message_id (nativeGet scope "native_message_id")) (nativeCallContext context)))))
        (rows (nativeGet response "messages")) (message (and (Array/isArray rows) (= (js-length rows) 1) (aref rows 0))))
        (currentConnection context address (nativeGet scope "identity_revision"))
        (unless (and message (= (nativeGet message "message_id") (nativeGet scope "native_message_id"))
          (= (nativeGet message "chat_id") (nativeGet address "native_chat_id"))
          (= (nativeGet message "thread_id" nil) (nativeGet address "native_thread_id" nil))) (must (failure "forbidden"))) message)))
  (defun reactionPage (response scope)
    (let ((rows (nativeGet response "items")))
      (unless (and (Array/isArray rows) (<= (js-length rows) 50) (= (nativeTypeOf (nativeGet response "has_more")) "boolean")
        (or (not (nativeGet response "has_more")) (nativeGet response "page_token"))) (must (failure "incompatible")))
      (js-object :connection_id (nativeGet (nativeGet scope "address") "connection_id") :identity_revision (nativeGet scope "identity_revision")
        :native_message_id (nativeGet scope "native_message_id") :has_more (nativeGet response "has_more") :page_token (nativeGet response "page_token" nil)
        :items (js-call rows :map (lambda (row)
          (js-object :reaction_id (nativeGet row "reaction_id" "") :emoji_type (nativeGet (nativeGet row "reaction_type") "emoji_type" "")
            :operator_id (nativeGet (nativeGet row "operator") "operator_id" "")
            :operator_type (nativeGet (nativeGet row "operator") "operator_type" "") :action_time (nativeGet row "action_time" "")))))))
  (defasync invoke (context scope command parameters)
    (let ((address (nativeGet scope "address")))
      (await (dispatchIm context (nativeGet address "connection_id") "messageAction"
        (js-array (js-object :connection_id (nativeGet address "connection_id") :identity_revision (nativeGet scope "identity_revision")
          :command command :parameters parameters) (nativeCallContext context))))))
  (defasync handleOperation (context operation args)
    (try
      (if (= operation "message.action.get")
        (let ((record (js-call (nativeGet context "repository") :get "operations" (nativeGet args "action_id"))))
          (must (requirePermission context "operation.inspect" record)) (projectAction context record))
        (let* ((scope (resolveTarget context args)) (address (nativeGet scope "address"))
          (revision (nativeGet scope "identity_revision")) (id (nativeGet scope "native_message_id"))
          (message (await (nativeMessage context scope)))
          (parameters (js-object :message_id id)) (command nil))
          (if (= operation "message.reaction.list")
            (progn
              (must (requirePermission context "message.read" address))
              (Object/assign parameters (js-object :emoji_type (nativeGet args "emoji_type") :limit (nativeGet args "limit" 50) :page_token (nativeGet args "page_token")))
              (let ((response (must (await (invoke context scope "reaction_list" parameters)))))
                (currentConnection context address revision)
                (success (reactionPage response scope) (js-object :evidence_level "native_protocol"))))
            (progn
              (must (requirePermission context "message.send" address))
              (when (and (nativeGet message "deleted") (not (= operation "message.recall"))) (must (failure "content_unavailable")))
              (setq command (cond ((= operation "message.recall") "recall") ((= operation "message.edit") "edit")
                ((= operation "message.reaction.add") "reaction_create") (t "reaction_delete")))
              (when (= command "edit")
                (unless (= (nativeGet message "msg_type") "text") (must (failure "unsupported")))
                (put parameters :text (nativeGet (nativeGet args "content") "text")))
              (when (nativeGet args "emoji_type") (put parameters :emoji_type (nativeGet args "emoji_type")))
              (when (nativeGet args "reaction_id") (put parameters :reaction_id (nativeGet args "reaction_id")))
              (let* ((created false)
                (accepted (js-call context :accept (lambda (tx operation-id)
                  (must (ownerGuard context)) (currentConnection context address revision)
                  (setq created t)
                  (success (js-object :action_id operation-id :operation operation :connection_id (nativeGet address "connection_id")
                    :identity_revision revision :destination address :native_message_id id :state "unknown" :confirmed false
                    :updated_at (utcNow context) :reaction_id (nativeGet args "reaction_id" nil) :emoji_type (nativeGet args "emoji_type" nil))))
                  (lambda (data) (js-array (typedRef "message_action" (nativeGet data "action_id")))))))
                (if (or (not (nativeGet accepted "ok")) (not created)) accepted
                  (let* ((data (Object/assign (js-object) (nativeGet accepted "data")))
                    (response (if (and (= command "recall") (nativeGet message "deleted")) (success (js-object))
                      (try (must (ownerGuard context)) (currentConnection context address revision)
                        (unless (can context "message.send" address) (must (failure "forbidden")))
                        (await (invoke context scope command parameters))
                        (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))))
                    (put data :updated_at (utcNow context))
                    (if (nativeGet response "ok")
                      (progn (put data :state "accepted")
                        (when (= command "reaction_create") (put data :reaction_id (nativeGet (nativeGet response "data") "reaction_id" nil)))
                        ;; Acknowledgement is distinct from a subsequent exact native readback.
                        (when (js-call (js-array "recall" "edit") :includes command)
                          (try (let ((latest (await (nativeMessage context scope))))
                            (put data :confirmed (if (= command "recall") (= (nativeGet latest "deleted") t)
                              (= (nativeGet latest "content") (nativeGet parameters "text")))))
                            (catch ignored nil))))
                      (let* ((error (nativeGet response "error")) (details (nativeGet error "details"))
                        (rejected (and (= (nativeGet details "reason") "native_api_rejected") (< (nativeGet details "http_status" 500) 500))))
                        (put data :state (if rejected "rejected" "unknown"))
                        (put data :error_code (nativeGet error "code" "unavailable"))
                        (when (Number/isInteger (nativeGet details "native_code")) (put data :native_code (nativeGet details "native_code")))
                        (put data :required_scopes (cond ((= command "recall") (js-array "im:message:recall"))
                          ((= command "edit") (js-array "im:message:update")) (t (js-array "im:message.reactions:write_only"))))))
                    (let ((saved (await (enqueueWrite context (lambda ()
                      (must (ownerGuard context)) (currentConnection context address revision)
                      (unless (can context "message.send" address) (must (failure "forbidden")))
                      (let* ((repository (nativeGet context "repository")) (record (js-call repository :get "operations" (nativeGet data "action_id"))))
                        (put record :safe_result (success data (js-object :operation_id (nativeGet data "action_id") :effect_state "recorded"
                          :evidence_level (if (nativeGet response "ok") "native_protocol" "service_record"))))
                        (must (js-call repository :replace "operations" record))
                        ;; Historical events and outbound receipts remain immutable audit evidence.
                        (when (and (nativeGet response "ok") (js-call (js-array "recall" "edit") :includes command))
                          (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                            "DELETE FROM context_messages WHERE connection_id=? AND identity_revision=? AND native_message_id=?")
                            :run (nativeGet address "connection_id") revision id))
                        (success data)))))))
                      (if (nativeGet saved "ok")
                        (success data (js-object :operation_id (nativeGet data "action_id") :effect_state "recorded"
                          :evidence_level (if (nativeGet response "ok") "native_protocol" "service_record"))) saved)))))))))
      (catch error (or (nativeGet error "domain_result") (failure "unavailable")))))
  (export handleOperation projectAction reactionPage))
