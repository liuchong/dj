                            (throw djReturn18Token)))
                        (must (outboundReady context current))
                        (put current :state "ready")
                        (put part :state "ready")
                        (put current :dispatch_key (nextId context "outbound_dispatch"))
                        (put part :dispatch_key (nativeGet current "dispatch_key"))
                        (put current :definite_not_sent false)
                        (put part :definite_not_sent false)
                        (put current :retryable false))
                      ((= operation "outbound.cancel")
                        (when
                          (js-call (js-array "submitting" "unknown") :includes state)
                          (progn
                            (setq
                              djReturn18Value
                              (failure
                                "outbound_unknown"
                                (js-object :effect_state "unknown")))
                            (throw djReturn18Token)))
                        (if
                          (js-call
                            (js-array "ready" "deferred" "blocked")
                            :includes
                            state)
                          (progn
                            (put current :state "cancelled")
                            (put part :state "cancelled"))
                          (progn
                            (setq
                              djReturn18Value
                              (success
                                (projectOutbound context current)
                                (js-object :warnings (js-array "already_submitted"))))
                            (throw djReturn18Token))))
                      ((= operation "outbound.resolve")
                        (unless (= state "unknown")
                          (progn
                            (setq djReturn18Value (failure "revision_conflict"))
                            (throw djReturn18Token)))
                        (put current :state "resolved")
                        (put part :state "resolved")
                        (put current :resolution (nativeGet args "resolution"))
                        (put current :reason (nativeGet args "reason"))
                        ;; No native ID or definite absence: the EchoGate deliberately
                        ;; remains, even after manual ledger closure.
                        (put current :evidence_level "manual")))
                    (put current :revision (nextRevision (nativeGet current "revision")))
                    (must (js-call repository :replace "outbound" current))
                    (must (js-call repository :replace "parts" part))
                    (success (projectOutbound context current)))
                  (catch djReturn18Error
                    (if (eq djReturn18Error djReturn18Token)
                      djReturn18Value
                      (throw djReturn18Error))))))
            (js-array (typedRef "outbound" (nativeGet record "outbound_id")))))
        (catch djReturn17Error
          (if (eq djReturn17Error djReturn17Token)
            djReturn17Value
            (throw djReturn17Error))))))
  (defasync handleOperation
    (context operation args)
    (let ((djReturn19Token (js-object)) (djReturn19Value nil))
      (try
        (cond ((= operation "message.reply_context") (currentReplyContext context (nativeGet args "delivery_id")))
          ((= operation "connection.list") (queryConnections context args))
          ((js-call (js-array "connection.get" "connection.probe") :includes operation)
            (let
              (
                (connection
                  (js-call
                    (nativeGet context "repository")
                    :get
                    "connections"
                    (nativeGet args "connection_id"))))
              (unless (and connection (can context "connection.inspect" connection))
                (progn
                  (setq djReturn19Value (failure "forbidden"))
                  (throw djReturn19Token)))
              (let
                ((projection (projectConnection context connection))
                  (port (imPort context (nativeGet connection "connection_id"))))
                (when (and (= operation "connection.probe") (nativeGet port "probe"))
                  (try
                    (let
                      (
                        (observation
                          (await
                            (js-call port :probe connection (nativeCallContext context)))))
                      (put
                        projection
                        :credential_state
                        (nativeGet observation "credential_state" "unknown"))
                      (when (nativeGet observation "event_source") (put projection :event_source (nativeGet observation "event_source")))
                      (put projection :checked_at (utcNow context)))
                    (catch unavailable
                      (when (eq unavailable djReturn19Token) (throw unavailable))
                      (put projection :credential_state "unknown"))))
                (success projection))))
          ((= operation "conversation.resolve")
            (let*
              (
                (connection
                  (js-call
                    (nativeGet context "repository")
                    :get
                    "connections"
                    (nativeGet args "connection_id")))
                (address
                  (addressOf connection (nativeGet args "chat_id") (nativeGet args "thread_id")))
                (revision
                  (nativeGet connection "identity_revision" (nativeGet connection "revision")))
                (port (imPort context (nativeGet args "connection_id"))))
              (unless
                (and
                  connection
                  (allowedAddress connection address)
                  (can context "conversation.discover" address))
                (progn
                  (setq djReturn19Value (failure "forbidden"))
                  (throw djReturn19Token)))
              (unless (= (nativeTypeOf (nativeGet port "resolveConversation")) "function")
                (progn
                  (setq djReturn19Value (failure "unsupported"))
                  (throw djReturn19Token)))
              (let
                (
                  (proof
                    (try
                      (await
                        (js-call
                          port
                          :resolveConversation
                          address
                          (nativeCallContext context)
                          context))
                      (catch unavailable
                        (when (eq unavailable djReturn19Token) (throw unavailable))
                        nil))))
                (unless
                  (and
                    (= (nativeGet proof "ok") t)
                    (= (stableJson (nativeGet proof "address")) (stableJson address)))
                  (progn
                    (setq djReturn19Value (failure "unavailable"))
                    (throw djReturn19Token)))
                (inTransaction
                  context
                  (lambda
                    (tx)
                    (let ((djReturn20Token (js-object)) (djReturn20Value nil))
                      (try
                        (let
                          (
                            (current
                              (js-call
                                (nativeGet context "repository")
                                :get
                                "connections"
                                (nativeGet args "connection_id"))))
                          (unless
                            (and
                              current
                              (=
                                revision
                                (nativeGet current "identity_revision" (nativeGet current "revision")))
                              (allowedAddress current address))
                            (progn
                              (setq djReturn20Value (failure "stale_reference"))
                              (throw djReturn20Token)))
                          (unless (can context "conversation.discover" address)
                            (progn
                              (setq djReturn20Value (failure "forbidden"))
                              (throw djReturn20Token)))
                          (success (projectConversation context current address)))
                        (catch djReturn20Error
                          (if (eq djReturn20Error djReturn20Token)
                            djReturn20Value
                            (throw djReturn20Error))))))))))
          ((= operation "conversation.list") (queryConversations context args))
          (
            (js-call
              (js-array "message.list" "message.search" "message.get")
              :includes
              operation)
            (queryMessages context operation args))
          ((= operation "message.acknowledge")
            (let ((reply (must (resolveReply context (nativeGet args "reply_context_id")))))
              (must (requirePermission context "message.reply" (nativeGet reply "destination")))
              (when (nativeGet reply "source_destination")
                (must (requirePermission context "message.reply" (nativeGet reply "source_destination"))))
              (js-call context :accept (lambda (tx operation-id)
                (queueAcknowledgement context (must (resolveReply context (nativeGet args "reply_context_id")))))
                (lambda (data) (js-array (typedRef "acknowledgement" (nativeGet data "acknowledgement_id")))))))
          ((js-call (js-array "message.send" "message.reply") :includes operation)
            (acceptOutbound context operation args))
          ((= operation "outbound.get")
            (let
              (
                (record
                  (js-call
                    (nativeGet context "repository")
                    :get
                    "outbound"
                    (nativeGet args "outbound_id"))))
              (unless (and record (can context "outbound.inspect" record))
                (progn
                  (setq djReturn19Value (failure "forbidden"))
                  (throw djReturn19Token)))
              (success (projectOutbound context record))))
          (
            (js-call
              (js-array
                "outbound.reconcile"
                "outbound.retry"
                "outbound.cancel"
                "outbound.resolve")
              :includes
              operation)
            (controlOutbound context operation args))
          (t (failure "invalid_argument")))
        (catch djReturn19Error
          (if (eq djReturn19Error djReturn19Token)
            djReturn19Value
            (throw djReturn19Error))))))
  (export
    queryMessages
    acceptOutbound
    dispatchOutbound
    reconcileOutbound
    projectOutbound
    projectEvent
    projectConnection
    resolveConversation
    sourceHealth
    finishOutbound
    handleOperation))
