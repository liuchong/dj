(module dj.messaging.service
  (import "../tasks/commands.eli" taskOutboundAllowed)
  (import "./topics.eli" topicOf trackedTopic)
  (import "../delivery/working.eli" finishWorking queueAcknowledgement)
  (import "../core/native.eli" nativeNullish nativeTypeOf nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli"
    conversationKey sourceReadAction
    stableJson
    addSeconds
    nextRevision
    utf8Bytes
    sliceUtf8
    hashValue
    encodeSeq)
  (import "../core/limits.eli" limits)
  (import "../application/context.eli"
    utcNow
    nextId
    currentPrincipal
    can
    requirePermission
    inTransaction
    must
    issueResourceHandle
    resolveResourceHandle
    nativeCallContext
    safeFields
    typedRef)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../policy/authorize.eli" authorize)
  (import "../ingestion/service.eli" allowedAddress)
  (import "../ingestion/visibility.eli" eventContentAvailable eventReadable)
  (import "../catalog/snapshots.eli" openSnapshot resumeSnapshot advanceSnapshot)
  (import "../connections/manager.eli" imPort dispatchIm)
  (defun addressOf
    (connection chat thread)
    (js-object
      :connection_id
      (nativeGet connection "connection_id")
      :native_chat_id
      chat
      :native_thread_id
      thread
      :thread_kind
      (if (nativeNullish thread) "main" "thread")))
  (defun configuredAddresses
    (connection)
    (if (= (nativeGet connection "platform") "lark")
      (js-call
        (nativeGet connection "watches" (js-array))
        :map
        (lambda
          (watch)
          (addressOf connection (nativeGet watch "chat_id") (nativeGet watch "thread_id" nil))))
      (js-call
        (nativeGet connection "allowed_chats" (js-array))
        :map
        (lambda
          (chat)
          (if (= (nativeTypeOf chat) "string")
            (addressOf connection chat nil)
            (addressOf connection (nativeGet chat "chat_id") (nativeGet chat "thread_id" nil)))))))
  (defun sourceHealth
    (context connection)
    (let*
      ((repository (nativeGet context "repository"))
        (id (nativeGet connection "connection_id"))
        (progress (js-call repository :get "source_progress" id))
        (addresses
          (js-call
            (configuredAddresses connection)
            :filter
            (lambda
              (address)
              (and
                (can context "connection.inspect" address)
                (can context "message.read" address)))))
        (rows
          (js-call
            addresses
            :map
            (lambda
              (address)
              (js-call
                repository
                :get
                "poll_checkpoints"
                (js-object
                  :connection_id
                  id
                  :conversation_key
                  (conversationKey address))))))
        (health
          (js-object
            :watch_count
            (js-length addresses)
            :gap_status
            (nativeGet progress "gap_status" "possible")
            :ack_control
            (= (nativeGet (nativeGet (imPort context id) "capabilities") "ack_control") t)
            :ready
            false
            :state
            "unknown"
            :reason_codes
            (js-array)))
        (reasons (new globalThis.Set)))
      (if (= (nativeGet connection "platform") "lark")
        (progn
          (js-call
            rows
            :forEach
            (lambda
              (row)
              (if row
                (js-call
                  (nativeGet row "reason_codes" (js-array))
                  :forEach
                  (lambda (code) (js-call reasons :add code)))
                (js-call reasons :add "not_observed"))))
          (js-call
            (js-array "last_success_at" "completed_until" "next_due_at")
            :forEach
            (lambda
              (field)
              (when
                (and
                  (> (js-length rows) 0)
                  (js-call rows :every (lambda (row) (nativeGet row field))))
                (put
                  health
                  field
                  (aref
                    (js-call (js-call rows :map (lambda (row) (nativeGet row field))) :sort)
                    0)))))
          (when (nativeGet health "completed_until")
            (let
              (
                (lag
                  (-
                    (Date/parse (utcNow context))
                    (Date/parse (nativeGet health "completed_until")))))
              (if (>= lag 0)
                (put health :lag_seconds (Math/floor (/ lag 1000)))
                (js-call reasons :add "clock_regressed"))))
          (when (> (js-length rows) 0)
            (put
              health
              :ready
              (and
                (not (nativeNullish (nativeGet health "last_success_at")))
                (= (nativeGet reasons "size") 0)))
            (put health :state (if (nativeGet health "ready") "online" "degraded"))))
        (when progress
          (put health :last_success_at (nativeGet progress "last_success_at"))
          (put health :ready (= (nativeGet progress "ready") t))
          (put health :state (if (nativeGet health "ready") "online" "degraded"))
          (js-call
            (nativeGet progress "reason_codes" (js-array))
            :forEach
            (lambda (code) (js-call reasons :add code)))))
      (put health :reason_codes (Array/from reasons))
      health))
  (defun projectConnection
    (context connection)
    (let
      (
        (projection
          (safeFields
            connection
            (js-array
              "connection_id"
              "platform"
              "tenant_ref"
              "account_ref"
              "display_name"
              "brand"
              "identity"
              "source_delivery"
              "revision"))))
      (put projection :source_health (sourceHealth context connection))
      (put projection :state (nativeGet (nativeGet projection "source_health") "state"))
      (put
        projection
        :capabilities
        (nativeGet (imPort context (nativeGet connection "connection_id")) "capabilities" (js-object)))
      projection))
  (defun projectConversation
    (context connection address)
    (let*
      ((revision (nativeGet connection "identity_revision" (nativeGet connection "revision")))
        (handle
          (must
            (issueResourceHandle
              context
              "conversation"
              (conversationKey address)
              (js-object
                :address
                address
                :source_revision
                revision
                :identity_revision
                revision)
              (nativeGet limits "handle_ttl_seconds")))))
      (js-object
        :conversation_ref
        (nativeGet handle "ref")
        :address
        address
        :source_revision
        revision
        :expires_at
        (nativeGet handle "expires_at"))))
  (defun resolveConversation
    (context ref action)
    (let ((djReturn1Token (js-object)) (djReturn1Value nil))
      (try
        (let ((resolved (resolveResourceHandle context ref "conversation")))
          (unless (nativeGet resolved "ok")
            (progn (setq djReturn1Value resolved) (throw djReturn1Token)))
          (let*
            ((handle (nativeGet resolved "data"))
              (address (nativeGet handle "address"))
              (connection
                (js-call
                  (nativeGet context "repository")
                  :get
                  "connections"
                  (nativeGet address "connection_id"))))
            (unless
              (and
                connection
                (allowedAddress connection address)
                (=
                  (nativeGet handle "source_revision")
                  (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
              (progn
                (setq djReturn1Value (failure "stale_reference"))
                (throw djReturn1Token)))
            (unless (can context action address)
              (progn (setq djReturn1Value (failure "forbidden")) (throw djReturn1Token)))
            (success (js-object :connection connection :address address))))
        (catch djReturn1Error
          (if (eq djReturn1Error djReturn1Token) djReturn1Value (throw djReturn1Error))))))
  (defun queryConnections
    (context args)
    (let ((djReturn2Token (js-object)) (djReturn2Value nil))
      (try
        (let*
          ((filters (nativeGet args "filters" (js-object)))
            (repository (nativeGet context "repository"))
            (opened
              (if (nativeGet args "cursor")
                (resumeSnapshot
                  context
                  (nativeGet args "cursor")
                  filters
                  args
                  "connection_id_asc")
                (openSnapshot context filters args "connection_id_asc"))))
          (unless (nativeGet opened "ok")
            (progn (setq djReturn2Value opened) (throw djReturn2Token)))
          (let*
            ((snapshot (nativeGet opened "data"))
              (options (js-object :limit 1000))
              (items (js-array))
              (keys (js-array))
              (last (nativeGet snapshot "last_scan_key"))
              (index 0))
            (when last (put options :after_key last))
            (let ((rows (js-call repository :page "connections" options)))
              (while
                (and
                  (< index (js-length rows))
                  (< (js-length items) (nativeGet args "limit" 50)))
                (let ((connection (aref rows index)))
                  (setq last (nativeGet connection "connection_id"))
                  (when (can context "connection.inspect" connection)
                    (let ((projection (projectConnection context connection)))
                      (when
                        (js-call
                          (Object/keys filters)
                          :every
                          (lambda
                            (field)
                            (= (nativeGet filters field) (nativeGet projection field))))
                        (js-call items :push projection)
                        (js-call keys :push (js-object :resource_key last))))))
                (setq index (1+ index)))
              (advanceSnapshot
                context
                snapshot
                (js-object
                  :items
                  items
                  :result_keys
                  keys
                  :next_scan_key
                  last
                  :complete
                  (and (= index (js-length rows)) (< (js-length rows) 1000))
                  :coverage_complete
                  t)))))
        (catch djReturn2Error
          (if (eq djReturn2Error djReturn2Token) djReturn2Value (throw djReturn2Error))))))
  (defun queryConversations
    (context args)
    (let ((djReturn3Token (js-object)) (djReturn3Value nil))
      (try
        (let*
          ((repository (nativeGet context "repository"))
            (connection
              (js-call repository :get "connections" (nativeGet args "connection_id")))
            (parent nil)
            (addresses (new globalThis.Map)))
          (unless (and connection (can context "conversation.discover" connection))
            (progn (setq djReturn3Value (failure "forbidden")) (throw djReturn3Token)))
          (when (nativeGet args "parent_ref")
            (let
              (
                (resolved
                  (resolveConversation
                    context
                    (nativeGet args "parent_ref")
                    "conversation.discover")))
              (unless (nativeGet resolved "ok")
                (progn (setq djReturn3Value resolved) (throw djReturn3Token)))
              (setq parent (nativeGet (nativeGet resolved "data") "address"))
              (unless
                (and
                  (= (nativeGet parent "connection_id") (nativeGet connection "connection_id"))
                  (nativeNullish (nativeGet parent "native_thread_id")))
                (progn
                  (setq djReturn3Value (failure "invalid_argument"))
                  (throw djReturn3Token)))))
          (js-call
            (configuredAddresses connection)
            :forEach
            (lambda
              (address)
              (js-call addresses :set (conversationKey address) address)))
          ;; Local known addresses only. Querying the gateway never polls IM history.
          (let
            (
              (rows
                (js-call
                  (js-call
                    (nativeGet (nativeGet context "store") "db")
                    :query
                    "SELECT DISTINCT conversation_key,json_extract(payload,'$.conversation') AS address FROM events WHERE connection_id=? ORDER BY conversation_key LIMIT 1000")
                  :all
                  (nativeGet connection "connection_id"))))
            (js-call
              rows
              :forEach
              (lambda
                (row)
                (js-call
                  addresses
                  :set
                  (nativeGet row "conversation_key")
                  (JSON/parse (nativeGet row "address"))))))
          (let*
            (
              (scope
                (js-object
                  :connection_id
                  (nativeGet connection "connection_id")
                  :parent
                  parent))
              (opened
                (if (nativeGet args "cursor")
                  (resumeSnapshot
                    context
                    (nativeGet args "cursor")
                    scope
                    args
                    "conversation_key_asc")
                  (openSnapshot context scope args "conversation_key_asc"))))
            (unless (nativeGet opened "ok")
              (progn (setq djReturn3Value opened) (throw djReturn3Token)))
            (let*
              ((snapshot (nativeGet opened "data"))
                (entries
                  (js-call
                    (Array/from (js-call addresses :entries))
                    :sort
                    (lambda
                      (a b)
                      (if (< (aref a 0) (aref b 0))
                        -1
                        (if (= (aref a 0) (aref b 0)) 0 1)))))
                (items (js-array))
                (keys (js-array))
                (index 0)
                (last (nativeGet snapshot "last_scan_key")))
              (while
                (and
                  (< index (js-length entries))
                  (< (js-length items) (nativeGet args "limit" 50)))
                (let*
                  ((entry (aref entries index))
                    (key (aref entry 0))
                    (address (aref entry 1)))
                  (when
                    (and
                      (or (not last) (> key last))
                      (allowedAddress connection address)
                      (or
                        (not parent)
                        (and
                          (= (nativeGet address "native_chat_id") (nativeGet parent "native_chat_id"))
                          (nativeGet address "native_thread_id")))
                      (can context "conversation.discover" address))
                    (js-call
                      items
                      :push
                      (projectConversation context connection address))
                    (js-call keys :push (js-object :resource_key key)))
                  (when (or (not last) (> key last)) (setq last key)))
                (setq index (1+ index)))
              (advanceSnapshot
                context
                snapshot
                (js-object
                  :items
                  items
                  :result_keys
                  keys
                  :next_scan_key
                  last
                  :complete
                  (= index (js-length entries))
                  :coverage_complete
                  false
                  :sources
                  (js-array
                    (js-object
                      :connection_id
                      (nativeGet connection "connection_id")
                      :coverage
                      "partial"
                      :reason
                      "configured_and_local_addresses")))))))
        (catch djReturn3Error
          (if (eq djReturn3Error djReturn3Token) djReturn3Value (throw djReturn3Error))))))
  (defun projectEvent
    (context event &optional offset maximum)
    (let ((djReturn4Token (js-object)) (djReturn4Value nil))
      (try
        (unless (eventReadable context event)
          (progn
            (setq djReturn4Value (failure "content_unavailable"))
            (throw djReturn4Token)))
        (let*
          (
            (page
              (sliceUtf8
                (nativeGet (nativeGet event "content") "text")
                (or offset 0)
                (or maximum (nativeGet limits "body_page_default_bytes"))))
            (handle nil)
            (projection
              (safeFields
                event
                (js-array
                  "event_id"
                  "native_message_id"
                  "event_kind"
                  "source_revision"
                  "connection_id"
                  "conversation"
                  "sender"
                  "mentions"
                  "people" "resource"
                  "reply_to"
                  "root_message_id"
                  "received_at"
                  "source_time"
                  "ingress_seq"
                  "attachments"))))
          (unless (nativeGet page "ok")
            (progn (setq djReturn4Value page) (throw djReturn4Token)))
          (setq
            handle
            (must
              (issueResourceHandle
                context
                "message"
                (nativeGet event "event_id")
                (js-object :identity_revision (nativeGet event "identity_revision"))
                (Math/max
                  1
                  (Math/min
                    (nativeGet limits "handle_ttl_seconds")
                    (Math/floor
                      (/
                        (-
                          (Date/parse (nativeGet event "body_expires_at"))
                          (Date/parse (utcNow context)))
                        1000)))))))
          (Object/assign
            projection
            (safeFields
              page
              (js-array
                "text"
                "offset_bytes"
                "next_offset_bytes"
                "complete"
                "total_bytes"))
            (js-object
              :message_ref
              (nativeGet handle "ref")
              :corpus
              "local"
              :deleted
              false
              :expired
              false
              :truncated
              (or
                (= (nativeGet (nativeGet event "content") "truncated") t)
                (not (nativeGet page "complete")))
              :original_bytes
              (nativeGet (nativeGet event "content") "original_bytes" (nativeGet page "total_bytes"))))
          (put projection :topic (trackedTopic context event))
          (put
            projection
            :content
            (js-object
              :kind
              "text"
              :text
              (nativeGet page "text")
              :truncated
              (nativeGet projection "truncated")
              :original_bytes
              (nativeGet projection "original_bytes")))
          (success projection))
        (catch djReturn4Error
          (if (eq djReturn4Error djReturn4Token) djReturn4Value (throw djReturn4Error))))))
  (defun getEvent
    (context args)
    (let ((djReturn5Token (js-object)) (djReturn5Value nil))
      (try
        (let ((id (nativeGet args "event_id")) (handle nil))
          (when (nativeGet args "message_ref")
            (let
              (
                (resolved
                  (resolveResourceHandle context (nativeGet args "message_ref") "message")))
              (unless (nativeGet resolved "ok")
                (progn (setq djReturn5Value resolved) (throw djReturn5Token)))
              (setq handle (nativeGet resolved "data") id (nativeGet handle "resource_key"))))
          (let*
            ((repository (nativeGet context "repository"))
              (event (js-call repository :get "events" id))
              (connection
                (and
                  event
                  (js-call repository :get "connections" (nativeGet event "connection_id")))))
            (unless
              (and
                event
                connection
                (can context (sourceReadAction (nativeGet event "conversation")) (nativeGet event "conversation")))
              (progn (setq djReturn5Value (failure "forbidden")) (throw djReturn5Token)))
            (unless
              (and
                (=
                  (nativeGet event "identity_revision")
                  (nativeGet connection "identity_revision" (nativeGet connection "revision")))
                (or
                  (not handle)
                  (= (nativeGet handle "identity_revision") (nativeGet event "identity_revision"))))
              (progn
                (setq djReturn5Value (failure "stale_reference"))
                (throw djReturn5Token)))
            (projectEvent
              context
              event
              (nativeGet args "offset_bytes" 0)
              (nativeGet args "max_bytes" (nativeGet limits "body_page_default_bytes")))))
        (catch djReturn5Error
          (if (eq djReturn5Error djReturn5Token) djReturn5Value (throw djReturn5Error))))))
  (defun queryMessages
    (context operation args)
    (let ((djReturn6Token (js-object)) (djReturn6Value nil))
      (try
        (when (= (nativeGet args "corpus") "native")
          (progn (setq djReturn6Value (failure "unsupported")) (throw djReturn6Token)))
        (when (= operation "message.get")
          (progn (setq djReturn6Value (getEvent context args)) (throw djReturn6Token)))
        (let*
          ((action (if (= operation "message.search") "message.search" "message.read"))
            (resolved (resolveConversation context (nativeGet args "conversation_ref") action)))
          (unless (nativeGet resolved "ok")
            (progn (setq djReturn6Value resolved) (throw djReturn6Token)))
          (let*
            ((address (nativeGet (nativeGet resolved "data") "address"))
              (opened
                (if (nativeGet args "cursor")
                  (resumeSnapshot
                    context
                    (nativeGet args "cursor")
                    address
                    args
                    "ingress_seq_asc")
                  (openSnapshot context address args "ingress_seq_asc"))))
            (unless (nativeGet opened "ok")
              (progn (setq djReturn6Value opened) (throw djReturn6Token)))
            (let*
              ((snapshot (nativeGet opened "data"))
                (repository (nativeGet context "repository"))
                (ceiling
                  (nativeGet
                    (nativeGet snapshot "source_checkpoint")
                    "ingress_ceiling"
                    (js-call repository :currentSequence "ingress")))
                (last (or (nativeGet snapshot "last_scan_key") "0"))
                (iterator
                  (js-call
                    (js-call
                      (nativeGet (nativeGet context "store") "db")
                      :query
                      "SELECT payload FROM events WHERE connection_id=? AND conversation_key=? AND ingress_seq>CAST(? AS INTEGER) AND ingress_seq<=CAST(? AS INTEGER) ORDER BY ingress_seq")
                    :iterate
                    (nativeGet address "connection_id")
                    (conversationKey address)
                    last
                    ceiling))
                (items (js-array))
                (keys (js-array))
                (bytes 0)
                (records 0)
                (complete false))
              (try
                (let ((djLoop1Break (js-object)))
                  (try
                    (while
                      (and
                        (< (js-length items) (nativeGet args "limit" 50))
                        (< records (nativeGet limits "search_scan_records")))
                      (let ((next (js-call iterator :next)))
                        (when (nativeGet next "done") (setq complete t) (throw djLoop1Break))
                        (let*
                          ((raw (nativeGet (nativeGet next "value") "payload"))
                            (size (utf8Bytes raw)))
                          (when (> (+ bytes size) (nativeGet limits "search_scan_bytes"))
                            (throw djLoop1Break))
                          (setq bytes (+ bytes size) records (1+ records))
                          (let*
                            ((event (JSON/parse raw))
                              (time (nativeGet event "source_time" (nativeGet event "received_at")))
                              (range (nativeGet args "time_range"))
                              (text (nativeGet (nativeGet event "content") "text" "")))
                            (setq last (encodeSeq (nativeGet event "ingress_seq")))
                            (when
                              (and
                                (eventReadable context event)
                                (or
                                  (not (nativeGet range "from"))
                                  (>= (Date/parse time) (Date/parse (nativeGet range "from"))))
                                (or
                                  (not (nativeGet range "to"))
                                  (< (Date/parse time) (Date/parse (nativeGet range "to"))))
                                (or
                                  (not (= operation "message.search"))
                                  (js-call text :includes (nativeGet args "query"))))
                              (js-call
                                items
                                :push
                                (must
                                  (projectEvent
                                    context
                                    event
                                    0
                                    (nativeGet limits "message_preview_bytes"))))
                              (js-call
                                keys
                                :push
                                (js-object :resource_key (nativeGet event "event_id"))))))))
                    (catch djLoop1Error
                      (unless (eq djLoop1Error djLoop1Break) (throw djLoop1Error)))))
                (finally (when (nativeGet iterator "return") (js-call iterator :return))))
              (advanceSnapshot
                context
                snapshot
                (js-object
                  :items
                  items
                  :result_keys
                  keys
                  :next_scan_key
                  last
                  :complete
                  complete
                  :source_checkpoint
                  (js-object :ingress_ceiling ceiling)
                  :coverage_complete
                  false
                  :sources
                  (js-array
                    (js-object
                      :connection_id
                      (nativeGet address "connection_id")
                      :coverage
                      "partial"
                      :reason
                      "local_created_events_only")))))))
        (catch djReturn6Error
          (if (eq djReturn6Error djReturn6Token) djReturn6Value (throw djReturn6Error))))))
  (defun textCapability
    (context address content &optional native-reply-to)
    (let ((djReturn7Token (js-object)) (djReturn7Value nil))
      (try
        (let*
          ((port (imPort context (nativeGet address "connection_id")))
            (caps (nativeGet port "capabilities"))
            (text (nativeGet content "text")))
          (unless (and port (not (= (nativeGet caps "send") "unsupported")))
            (progn (setq djReturn7Value (failure "unsupported")) (throw djReturn7Token)))
          (when
            (and
              (nativeGet address "native_thread_id")
              (not (= (nativeGet caps "reply_thread") "supported")))
            (progn (setq djReturn7Value (failure "unsupported")) (throw djReturn7Token)))
          (when
            (and
              (nativeGet address "native_thread_id")
              (=
                (nativeGet
                  (js-call
                    (nativeGet context "repository")
                    :get
                    "connections"
                    (nativeGet address "connection_id"))
                  "platform")
                "lark")
              (not native-reply-to))
            (progn (setq djReturn7Value (failure "unsupported")) (throw djReturn7Token)))
          (when (> (utf8Bytes text) (nativeGet caps "max_text_bytes" (nativeGet limits "text_bytes")))
            (progn
              (setq djReturn7Value (failure "limit_exceeded"))
              (throw djReturn7Token)))
          (when
            (and
              (nativeGet caps "max_text_characters")
              (> (js-length (Array/from text)) (nativeGet caps "max_text_characters")))
            (progn
              (setq djReturn7Value (failure "limit_exceeded"))
              (throw djReturn7Token)))
          (success nil))
        (catch djReturn7Error
          (if (eq djReturn7Error djReturn7Token) djReturn7Value (throw djReturn7Error))))))
  (defun resolveReply
    (context ref)
    (let ((djReturn8Token (js-object)) (djReturn8Value nil))
      (try
        (let ((resolved (resolveResourceHandle context ref "reply_context")))
          (unless (nativeGet resolved "ok")
            (progn
              (setq djReturn8Value (failure "reply_context_expired"))
              (throw djReturn8Token)))
          (let*
            ((repository (nativeGet context "repository"))
              (handle (nativeGet resolved "data"))
              (reply
                (js-call repository :get (if (nativeGet handle "inbox_id") "inbox_reply_contexts" "reply_contexts")
                  (nativeGet handle "resource_key")))
              (record
                (and
                  reply
                  (if (nativeGet handle "inbox_id")
                    (js-call repository :get "inbox_entries" (nativeGet handle "inbox_id"))
                    (js-call repository :get "deliveries" (nativeGet reply "delivery_id")))))
              (event
                (and reply (js-call repository :get "events" (nativeGet reply "event_id"))))
              (connection
                (and
                  reply
                  (js-call
                    repository
                    :get
                    "connections"
                    (nativeGet (nativeGet reply "destination") "connection_id")))))
