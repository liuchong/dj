(module dj.application.help
  (import "../core/native.eli" nativeGet)
  (import "../core/limits.eli" limits)
  (import "../triggers/predicate.eli" defaultSubscriptionRules)
  (defconst modelInstructions
    "DJ performs deterministic routing. Discover current tools with tools/list and service.status: visible_operations are exposed to this caller, unavailable_operations explain existing operations and required authority; missing tools do not prove missing product capability. Resource permissions and native capabilities are checked when called. Saving session.rules or instructions stores AI-readable text, not executable filters or outbound blocks. Use message.filter for trigger suppression and message.recipient_policy for outbound denial including automatic reactions; administrative access may be required. Read back structured policy before claiming it is active. Preserve recipient opt-outs and exact reply identity. Reuse typed references and inspect original operations after uncertain results. DJ does not select targets or generate answers.")
  (defconst summaries
    (js-object
      :message.recipient_policy.get "读取连接的结构化出站黑白名单及分页退订记录；需要operator身份与connection.manage，普通agent即使有该grant也不能调用。deny拦截文字及自动Typing/Get等新增表情，输入照常触发；session.rules文本不是此策略。"
      :message.recipient_policy.set "替换连接出站策略；需要operator身份与connection.manage。先get保留既有allow/deny，添加准确recipient_ids或chat_ids，set后get读回；新策略expected_revision=0。覆盖文字和自动/手动新增表情，不屏蔽输入。不同应用身份须分别配置对应连接；deny不能被allow解除，不能修改收件人退订。保存对话规则不等于设置本策略。"
      :message.attachment.get "按通知或消息返回的attachment_ref查询附件。corpus默认local；native在缓存缺失时沿原连接和身份补取。state=ready时local_path为实际可读文件；附件未就绪时仍给出原生资源定位。"
      :lark.api.read "用指定连接和identity_revision直连官方GET API；path为/open-apis/相对路径，query按原生文档填写，响应保留http_status/native_ok/response。bytes响应为base64，最多512KiB，分页显式续传原生page_token。"
      :lark.api.call "用指定连接身份调用官方POST/PUT/PATCH/DELETE API；支持JSON body或multipart form（文件含base64/filename/content_type）。必须幂等键，先落台账再调用，unknown不得重发；原生拒绝与权限详情见response。消息写入须使用message.send/reply/edit等受控操作；通用API不允许绕过收件人禁收。其他resource操作优先固定业务台账。"
      :lark.api.get "读取原生API写操作台账；accepted只表示平台受理，unknown表示结果未确定，同一幂等键不会再次执行。"
      :dispatch.context.get
      "读取消息投递的持续IM身份绑定；delivery.get.notification列出同一通知的来源副本与归并关系。交互上下文不是AI任务或负责人。"
      :dispatch.context.transfer
      "仅在用户明确要求身份转移时调用；传context_id、当前expected_binding_id、目标connection_id、explicit=true及reason。只改变之后的交互，不改旧投递快照、订阅或退订状态。"
      :message.reply_context "原接收者在原有效期内重新取得固定回复引用；重检当前授权和原身份，不改目标、不延长有效期。"
      :task.list "按当前管理员白名单或本人连接范围分页巡查任务；accepted 不代表完成。"
      :task.tree "展示原 IM 消息、准确 AI 会话与登记的子对话；未知关联明确标注。"
      :task.link "为已接收投递登记明确父子会话关系；未原生核验，不猜任务归属。"
      :subscription.group.create "创建成员组，members为准确agent_id，最多32个；priority越小越优先。组仅保存成员，不复制订阅。"
      :subscription.group.dispatches "按group_id查询该组唯一订阅槽位的组分发台账：selected为已选，accepted为原生受理，coalesced为已被单对话订阅先行占有并归并，unknown不改投，waiting_member保留待投。after_id/limit续扫。"
      :subscription.group.get "读取组成员、状态和并发校验计数。"
      :subscription.group.list "按group_id顺序列可管理组，after_id/limit续扫，返回next_after。"
      :subscription.group.update "整体更新name/members，需expected_revision；不会改投已经accepted/unknown的消息。"
      :subscription.group.delete "删除无在用订阅的组；在用时返回revision_conflict。"
      :agent.availability "只读查询准确Agent账户/模型可用观测，带时间和来源。unknown不是零额度，available不是任务完成保证。"
      :session.supervision.start "为准确原会话持续督工：prompt为续接指令，idle_seconds默认120、check_seconds默认30。按session.supervise权限登记并持久保存，空闲超时才经原实例接口续接；忙、等待许可、不确定送达不重复打断。完成或主动暂停必须cancel。"
      :session.supervision.get "读取准确会话督工状态、检查时间及最近投递。未登记返回inactive；active不代表原生Goal已恢复。"
      :session.supervision.cancel "持久取消督工及尚未提交的督工通知；已越过submitting的原生输入不能撤回，不停止当前任务。"
      :service.status
      "发现当前服务能力与权限：visible_operations为本主体暴露的操作，unavailable_operations列出其他已实现操作的required_action、reason及help；operator_required不能仅靠增加grant解除，grant_required表示当前目录权限不足。工具可见不保证具体资源或原生平台可用。规则文本不执行过滤；禁触发用message.filter，禁发及自动表情用message.recipient_policy。"
      :message.filter.get
      "读取服务级触发过滤，需要message.filter.inspect。仅限制通知AI，不改变收件、可见性或出站权限；只想禁止回复/表情而保留事件时用message.recipient_policy。"
      :message.filter.update
      "需要message.filter.manage，按当前revision替换完整rules/people并保留既有项；支持任意多条all/any/not条件及text、text.first_line、text.lines与eq/in/contains/prefix/suffix字面匹配，仅支持suppress_trigger，不补发历史。禁触发与禁发独立：不回复/不加自动表情但继续通知AI须配置message.recipient_policy，session.rules中的自然语言黑名单不会执行本操作。"
      :operation.get
      "按 operation_id，或原 operation+idempotency_key 查受理台账；not_found 不证明原请求不会提交。"
      :connection.list
      "列出当前有权查看的 IM 连接及来源保证。"
      :connection.get
      "读取一个已配置 IM 连接的安全身份、能力和源健康摘要。"
      :connection.probe
      "只读核对已配置连接；不改变账号、OAuth、webhook 或收件所有权。"
      :conversation.list
      "列出配置或本地已知且获准的 IM 对话/话题；不声明整个平台全量。"
      :conversation.resolve
      "按明确的连接、原生 chat_id 和显式 thread_id/null 核验精确 IM 地址。"
      :agent.whoami
      "读取认证主体与bound_agent_ids登记列表；一个身份可登记多个对话，须显式选择准确目标；宿主名称、cwd、标题不构成会话身份。"
      :agent.discover
      "在指定工具和配置实例范围机械发现会话，返回 candidate_ref；不创建或发送。"
      :agent.register
      "把候选精确目标登记为 AgentTarget；同一调用身份可登记多个准确对话；可选 target_constraint 收窄范围。查询返回准确会话的 subscriber 模型参考，未知字段不推测。"
      :agent.list
      "列举有权管理的已登记单会话目标；agent_id 不是工具父节点。"
      :agent.get
      "读取一个已登记目标及其绑定事实。"
      :agent.probe
      "核验已登记目标当前接收口并刷新本地观测/绑定。支持instance_epoch_refresh的existing实例（Codex、Cursor、OpenCode、Antigravity、Claude Desktop/Code、Kimi、DSH、Pi等实现活体探测契约的适配器）在原客户端重启后，以独立实例证明和原会话身份推进epoch；不需手工rebind或重建订阅，不覆盖显式停止，不重发accepted/unknown。不发送测试消息或新建进程。"
      :agent.rebind
      "为同一 tool/namespace/native_session 更新已核验 Binding；不能改绑到其他会话。"
      :agent.unregister
      "关闭登记并暂停该会话槽位的在用订阅、取消提交点前待投项；保留共享 route、unknown 和独立直发。"
      :subscription.preview
      "为目标（agent_id 或 group_id 二选一）预览唯一订阅逻辑线：spec.rules 支持 1..64 条分支（各带 id、enabled、sources、event_kinds、predicate 及可选 context_policy/instruction_policy；all/any/not 任意多条件组合及 text、text.first_line、text.lines 配合 eq/in/contains/prefix/suffix）。目标尚无订阅时 expected_revision 省略或传 0，已有订阅时传当前 revision；返回固定 preview_id、rule_sources 与样例命中分支 matched_rule_ids。"
      :subscription.set
      "凭固定 preview_id 与 expected_revision（首次为 0，更新为当前 revision）原子创建或替换该目标的唯一订阅槽位（session:<session_key> 或 group:<group_id>），旧 revision 未提交待投项自动取消。"
      :subscription.list
      "列出当前获准管理的目标唯一订阅。"
      :subscription.get
      "按 agent_id 或 group_id（严格二选一）读取该目标唯一订阅的当前 revision、rules、来源和状态。"
      :subscription.pause
      "按 agent_id 或 group_id 暂停该目标唯一订阅并取消提交点前待投项；不撤回已提交原生输入。"
      :subscription.resume
      "按 agent_id 或 group_id 以新 start_seq 恢复该目标唯一订阅；不补暂停期消息。"
      :subscription.delete
      "按 agent_id 或 group_id 删除该目标唯一订阅并取消提交点前待投项；直发与已提交项保持原生命周期。"
      :subscription.replay
      "按 agent_id 或 group_id、当前 expected_revision 与最多 16 个 event_ids 显式重放匹配该目标当前订阅规则。"
      :subscription.pull
      "按 agent_id（组订阅时另传 group_id）主动领取一条 pull 模式待办并返回短期 claim_ref。"
      :subscription.ack
      "凭 claim_ref 显式确认 pull 领取项（consumed 消费或 retry 释放）。"
      :message.list
      "读取获准 IM 对话的本地 created 事件；仅返回有界正文预览，native corpus 未启用。"
      :message.search
      "在获准本地 IM 正文中做区分大小写的字面子串检索；不是语义搜索。"
      :message.get
      "按 event_id 或 message_ref 读取仍可见正文，按 UTF-8 字节边界分页。"
      :resource.resolve
      "核验Lark文档/表格/Wiki准确地址，解析实际资源并发放受控读取与订阅来源引用。"
      :resource.read
      "默认读取DJ资源缓存；显式native读取官方文档、记录、表格范围、评论或子项。"
      :resource.recover
      "操作员按明确授权恢复准确表格记录快照；经原订阅触发，审计且去重，不代表实时事件。"
      :resource.watch
      "登记并请求原生文件事件订阅；subscribed只证明平台受理，不证明事件通道或AI订阅已就绪。"
      :message.context
      "按当前消息或context_ref读取前后文与引用链；native通过官方API补取，不触发订阅。"
      :message.history
      "在context_ref或conversation_ref绑定的会话内有界分页读取历史，区分local/native覆盖。"
      :message.recall "撤回准确连接中已发出的原生消息；不是取消待发送项。先持久登记，未知结果不自动重试，平台决定撤回权限与期限。"
      :message.edit "编辑准确连接中本人已发文本或Lark Markdown；content.type须与原生消息类型text/post相符，保留原生消息ID。平台决定期限；不在编辑时转换格式。"
      :message.reaction.add "为准确原生消息添加指定emoji_type表情，使用连接的本人或机器人身份。"
      :message.reaction.remove "按reaction_id撤销当前连接身份添加的表情；不删除其他人的表情。"
      :message.reaction.list "有界读取消息原生表情记录，返回reaction_id与添加者，has_more时按page_token续页。"
      :message.action.get "按action_id读取撤回、编辑、手动表情操作的持久结果；unknown不等于失败，不换键盲目重试。"
      :message.send
      "向destination_ref固定地址发送content={type:text|markdown,text:正文}。markdown目前仅Lark，使用原生post的md标签渲染链接/列表/表格；text不渲染Markdown。中文URL按组件编码，正文不是JSON字符串。force_send=true仅在用户明确要求时单条豁免收件人屏蔽，不改持久状态或身份约束。"
      :message.acknowledge
      "显式确认当前消息已理解或收录、暂时无需文字回复：按固定身份添加Get，同一事务结束当前delivery的Working；不结束其他消息或任务。原生Get存在须官方读回确认。"
      :message.acknowledge.get
      "读取收到确认的持久状态；native_acknowledged为true才已核实原生Get存在。"
      :message.reply
      "reply_context_id或outbound_id严格二选一：前者沿原投递固定身份回复，后者回复已accepted且只有一个原生消息ID的出站消息，继承原账号和来源身份约束，不需要先收到订阅事件。Lark可设reply_in_thread=true在普通群创建话题，已有话题始终沿原话题；不另传目的地。outbound.get返回native_reply_to/native_thread_id。force_send=true仅供用户明确要求的单次收件人屏蔽豁免，不绕过身份或平台权限。"
      :outbound.get
      "读取 IM 出站台账、parts 和原生消息 ID；accepted 仅表示平台接受。"
      :outbound.reconcile
      "核对原 Outbound/attempt 的原生事实；不重发，unknown 可保持 unknown。"
      :outbound.retry
      "仅重试已证 definite_not_sent 且 retryable 的未接受单位；不重发已接受或未知单位。"
      :outbound.cancel
      "取消提交点前的 IM 出站；submitting/unknown 不能被擦除。"
      :outbound.resolve
      "操作员以不重发选项人工结案 unknown；manual 不伪造原生证据或解除无 ID 回声屏障。"
      :delivery.list
      "按 origin/route/session/operation 等精确字段列举获准投递；两 origin 共用顺序。"
      :delivery.get
      "读取当前可见投递、命中订阅摘要（matched）、原生回执及可用回复引用。"
      :delivery.reconcile
      "核对原目标、原 attempt 和原关联键；不靠对话文本猜测、不重发。"
      :delivery.retry
      "只对已证未送达且 retryable 的失败投递重试；沿原 route/序号重检当前权限。"
      :delivery.cancel
      "取消自己的提交前直发或订阅投递；不能越主体取消其他主体拥有的订阅投递。"
      :delivery.resolve
      "仅操作员可对 unknown 不重发结案；后续输入仍须重新证明目标 idle。"
      :tool.list
      "列出工具适配器的配置、能力和限制；不扫描全机器或启动程序。"
      :tool.get
      "读取指定工具的安全能力声明；可用适配器不等于已验收某个运行实例。"
      :profile.list
      "列出获准启动的预配 profile/revision/workspace；不暴露 argv 或秘密。"
      :instance.list
      "按工具和归属列举配置/托管实例；不启动实例。"
      :instance.get
      "读取实例当前 epoch/revision/状态；历史 lifecycle.ready 不替代当前事实。"
      :catalog.refresh
      "受理有预算的只读原生目录/正文采集；不启动工具、输入消息或隐式无限续扫。"
      :catalog.get
      "读取目录采集状态、覆盖和 continuation；不会自行继续扫描。"
      :session.list
      "跨获准工具/实例/工作区列举机械会话目录；不要求登记或订阅。"
      :session.get
      "按稳定 session_key 或有效 session_ref 重取当前短期引用。"
      :session.resolve
      "按已知 instance_id 与原生 native_session_id 精确定位；不按标题选择。"
      :session.probe
      "核验精确会话并刷新本地epoch/绑定；实现existing实例活体探测契约（instance_epoch_refresh）的原生客户端重启后，独立验证实例及同一会话身份再恢复。显式停止不解除，旧引用失效后重新resolve；不创建、唤醒、重发或改订阅。"
      :session.search
      "按结构化范围与字面字段查询会话；空 items 有 cursor 时尚未扫描完。"
      :session.message.list
      "读取已索引且获准的 Agent 消息快照；不自动刷新原生历史。"
      :session.message.get
      "读取绑定内容版本的 session_message_ref，按 UTF-8 边界分页。"
      :session.message.search
      "在指定范围的已索引 Agent 正文中做字面检索，返回受控片段与引用。"
      :session.rules.get
      "读取准确原生对话保存的完整规则原文与 SHA256；JSON 仅是接口封装，读取 text 得到原文，不把整份响应当规则或最终回复。"
      :session.rules.update
      "完整保存本对话规则原文；建议易读Markdown与真实换行，get核对text和SHA256。文本只供AI阅读，不会设置订阅、禁触发或禁发，也不能阻止DJ自动Typing。相应机械行为须另调subscription、message.filter或message.recipient_policy接口并读回；不自动解析规则意图。"
      :session.send
      "向精确 Agent 会话输入纯文本；无需 IM/登记/订阅，不自动启动或新建，不自动回 IM。"
      :instance.start
      "显式启动获准预配 profile；先占持久 slot，unknown 不重新拉起。"
      :session.create
      "在已有运行实例中显式创建会话；可传 content 作为首条纯文本消息（另需 session.send），不登记或订阅。创建 ready 不代表首条消息送达：核对 initial_input_state、initial_delivery_id 和 delivery.get。先 instance.get 获取 epoch、workspace_scope 和 workspace_ref（需要 instance.inspect）。instance 范围可传绝对 directory 及其发现所得 workspace_ref；缺少 directory 时从同实例已发现会话解析。OpenCode 可传原生 model_selection；Antigravity model_id 使用精确 MODEL_* 或数字 enum。Cursor native_api 可创建不提交首条消息的本地对话；Codex 原生工具宿主接收端需明确非空 content，一次原生创建与首条输入受理后返回 native_queued 和 initial_input_receipt_key，不再重复投递；Claude Desktop 和 Pi 接收扩展可创建并改名，CLI inbox/普通 Bridge 以实际能力为准；不要求空对话，但不得捏造占位 prompt 或启动替代 Agent 进程。AI 可改用自身原生能力、其他可用接口或已安装 Skill 完成目标。"
      :session.rename
      "沿准确 session_ref 修改原生标题；独立 session.rename 权限，持久记账后写原接口并读回。同一幂等键不重复写；unknown 用 lifecycle.reconcile 只读核对。"
      :instance.stop
      "仅停止 DJ-owned managed 实例；先关 gate 再排空，期限到不强杀、不要求队列清空。"
      :instance.restart
      "显式重启现有 Cursor App；allow_interrupt=true 表示允许中断，先保存可见原会话快照再重启。ready 返回新 epoch，调用方 AI 决定续接原会话；unknown 仅核对，不重复重启。"
      :lifecycle.get
      "读取启动/创建/改名/重启/停止台账及当前实例，并为当前可见会话重签短期引用。"
      :lifecycle.reconcile
      "按原 launch token/创建关联键追加原生观察；不另起进程或再次创建。"
      :lifecycle.resolve
      "操作员对 unknown 生命周期不重发结案；没有原生 absence 不释放 slot。"))
  (defconst referenceSources
    (js-object
      :attachment_ref
      "原通知附件附录或 message.get/list/context/history 的 attachments"
      :conversation_ref
      "conversation.list/resolve"
      :destination_ref
      "conversation.list/resolve 的 conversation_ref"
      :candidate_ref
      "agent.discover"
      :preview_id
      "subscription.preview 的固定票据"
      :reply_context_id
      "external_message/delivery.get，绑定 recipient 与原话题"
      :agent_id
      "agent.register/list/get，代表单会话"
      :group_id
      "subscription.group.create/list/get，代表显式分发组"
      :target_key
      "subscription.set/list/get，唯一目标槽位（session:<session_key> 或 group:<group_id>）"
      :delivery_id
      "session.send/delivery.list/get"
      :outbound_id
      "message.send/reply"
      :operation_id
      "任意受理变更结果"
      :catalog_run_id
      "catalog.refresh"
      :lifecycle_id
      "instance.start/session.create/instance.stop"
      :profile_id
      "profile.list"
      :expected_profile_revision
      "profile.list 的当前 revision"
      :instance_id
      "instance.list/get/lifecycle.get"
      :expected_instance_epoch
      "instance.get 的当前 epoch"
      :session_ref
      "session.list/get/resolve"
      :session_key
      "session.list/get/lifecycle.get"
      :session_message_ref
      "session.message.list/search"
      :workspace_ref
      "profile.list/instance.get 的获准 workspace_refs"
      :expected_revision
      "相应对象 get 的当前 revision"
      :cursor
      "同操作、同范围、同主体的前一页 next_cursor"
      :idempotency_key
      "调用方为一次逻辑变更生成并保存，重放保持原键和原输入"))
  (defun defaultValues
    (name properties)
    (let ((defaults (js-object)))
      (when (object-has? properties :limit)
        (put defaults :limit (nativeGet limits "limit_default")))
      (when (object-has? properties :offset_bytes)
        (put defaults :offset_bytes 0)
        (put defaults :max_bytes (nativeGet limits "body_page_default_bytes")))
      (when (js-call (js-array "message.list" "message.search") :includes name)
        (put defaults :corpus "local"))
      (when (or (= name "resource.resolve") (= name "message.attachment.get")) (put defaults :corpus "local"))
      (when (= name "resource.read") (Object/assign defaults (js-object :corpus "local" :view "content" :limit 20)))
      (when (= name "message.context") (Object/assign defaults (js-object :corpus "local" :before 10 :after 0 :reference_depth 4 :max_bytes 16384)))
      (when (= name "message.history") (Object/assign defaults (js-object :corpus "local" :order "desc" :limit 20 :max_bytes 16384)))
      (when (= name "session.message.list") (put defaults :corpus "indexed"))
      (when (js-call (js-array "session.list" "session.search") :includes name)
        (put defaults :sort "session_key_asc"))
      (when (= name "session.send")
        (put
          defaults
          :delivery_policy
          (js-object
            :busy
            "steer"
            :offline
            "hold"
            :ttl_seconds
            (nativeGet limits "ttl_default_seconds"))))
      (when (= name "catalog.refresh")
        (put defaults :include_content false)
        (put
          defaults
          :budget
          (js-object
            :max_records
            (nativeGet limits "refresh_max_records")
            :max_messages
            (nativeGet limits "refresh_max_messages")
            :max_bytes
            (nativeGet limits "refresh_max_bytes")
            :max_seconds
            (nativeGet limits "refresh_max_seconds"))))
      (when (= name "subscription.preview")
        (put
          defaults
          :spec
          (js-object
            :rules
            (defaultSubscriptionRules)
            :start
            "now"
            :delivery_mode
            "push"
            :context_policy
            (js-object
              :mode
              "recent"
              :max_events
              10
              :max_bytes
              (nativeGet limits "text_bytes"))
            :delivery_policy
            (js-object
              :busy
              "steer"
              :offline
              "hold"
              :ttl_seconds
              (nativeGet limits "ttl_default_seconds")))))
      defaults))
  (defun limitReferences
    (properties)
    (let ((names (js-array "request_bytes")))
      (when (object-has? properties :limit)
        (js-call
          names
          :push
          "limit_default"
          "limit_max"
          "snapshot_results"
          "active_snapshots"))
      (when (object-has? properties :content) (js-call names :push "text_bytes"))
      (when (object-has? properties :query)
        (js-call names :push "query_bytes" "search_scan_records" "search_scan_bytes"))
      (when (object-has? properties :title) (js-call names :push "title_bytes"))
      (when (object-has? properties :max_bytes)
        (js-call names :push "body_page_default_bytes" "body_page_max_bytes"))
      (when (object-has? properties :delivery_policy)
        (js-call
          names
          :push
          "ttl_min_seconds"
          "ttl_max_seconds"
          "ttl_default_seconds"
          "route_queue"
          "global_queue"))
      (when (object-has? properties :spec)
        (js-call
          names
          :push
          "subscription_rules"
          "subscription_rule_leaves"
          "rule_depth"
          "rule_leaves"
          "rule_in_values"
          "sources"
          "text_bytes"))
      names))
  (defun operationHelp
    (name properties effect kind)
    (let ((refs (js-array)))
      (js-call
        (Object/keys properties)
        :forEach
        (lambda
          (field)
          (when (object-has? referenceSources field)
            (js-call refs :push (str field "←" (nativeGet referenceSources field))))))
      (str
        (nativeGet summaries name name)
        (if (> (js-length refs) 0) (str " 引用来源：" (js-call refs :join "；") "。") "")
        (if (= effect "accept")
          (str
            " 受理返回 operation_id 和 "
            kind
            " 资源；不代表外部完成。超时先按原键 operation.get，unknown 只核对原对象。")
          " 保留 coverage/stale/complete 与 cursor 的不同含义；不推断用户意图。"))))
  (defun capabilityGuards
    (name group)
    (cond
      ((= name "session.send")
        (js-array "start_idle" "exact_live_receiver" "native_input_frame"))
      ((= name "session.create") (js-array "session_create" "instance_gate_open"))
      ((= name "session.rename") (js-array "session_rename" "instance_gate_open"))
      ((= name "instance.start")
        (js-array "instance_start" "approved_profile" "managed_slot"))
      ((= name "instance.restart") (js-array "instance_restart" "explicit_interrupt" "native_resume_snapshot"))
      ((= name "instance.stop")
        (js-array "instance_stop" "verified_managed_ownership" "native_drain"))
      ((= group "message_actions") (js-array "exact_native_message" "same_connection_identity" "native_message_action"))
      ((js-call (js-array "message.send" "message.reply") :includes name)
        (js-array "send" "exact_thread" "text_or_lark_markdown"))
      ((= group "subscriptions")
        (js-array "created" "current" "steer" "hold" "recipient_binding"))
      ((= group "catalog") (js-array "configured_source"))
      ((= group "search") (js-array "literal" "indexed_content"))
      ((= group "refresh") (js-array "read_only_native_catalog" "bounded_native_frame"))
      (t (js-array))))
  (export modelInstructions operationHelp defaultValues limitReferences capabilityGuards referenceSources))
