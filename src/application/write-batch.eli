(module dj.application.write-batch
  (import "../core/native.eli" NativeGlobal nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure)
  (defconst batchLimit 64)
  (defun flushWrites (context state)
    (let* ((store (nativeGet context "store"))
      (items (js-call (nativeGet state "pending") :splice 0 batchLimit)))
      (put state :scheduled false)
      (let ((committed
        (js-call store :transaction (js-object) (lambda (tx)
          (let ((results (js-array)) (db (nativeGet tx "db")))
            (js-call items :forEach (lambda (item)
              (js-call db :run "SAVEPOINT dj_write_item")
              (let ((result nil))
                (try
                  (setq result (funcall (nativeGet item "mutate")))
                  (catch error
                    (let ((domain-result (nativeGet error "domain_result")))
                      (if (and domain-result
                        (= (nativeGet domain-result "ok") false)
                        (not (= (nativeTypeOf (nativeGet domain-result "then")) "function")))
                        (setq result domain-result)
                        (throw error)))))
                (unless (and result
                  (= (nativeTypeOf (nativeGet result "ok")) "boolean")
                  (not (= (nativeTypeOf (nativeGet result "then")) "function")))
                  (throw (new globalThis.TypeError "write batch requires synchronous Results")))
                (unless (nativeGet result "ok")
                  (js-call db :run "ROLLBACK TO SAVEPOINT dj_write_item"))
                (js-call db :run "RELEASE SAVEPOINT dj_write_item")
                (js-call results :push result))))
            (success results))))))
        ;; No caller may start native I/O before this shared commit succeeds.
        (js-call items :forEach (lambda (item index)
          (js-call item :resolve (if (nativeGet committed "ok")
            (aref (nativeGet committed "data") index) committed)))))))
  (defun enqueueWrite (context mutate)
    (let ((store (nativeGet context "store")) (runtime (nativeGet context "runtime")))
      (if (or (not runtime) (not store)
        (not (= (nativeTypeOf mutate) "function"))
        (= (nativeGet (nativeGet mutate "constructor") "name") "AsyncFunction")
        (js-call store :inTransaction))
        (Promise/resolve (failure "invalid_transaction"))
        (let ((state (nativeGet runtime "write_batch")))
          (unless state
            (setq state (js-object :pending (js-array) :scheduled false))
            (put runtime :write_batch state))
          (if (>= (js-length (nativeGet state "pending")) batchLimit)
            (Promise/resolve (failure "unavailable"))
            (new globalThis.Promise (lambda (resolve reject)
              (js-call (nativeGet state "pending") :push (js-object :mutate mutate :resolve resolve))
              (unless (nativeGet state "scheduled")
                (put state :scheduled t)
                (js-call NativeGlobal :queueMicrotask (lambda () (flushWrites context state)))))))))))
  (export enqueueWrite))
