(module dj.application.results
  (import "../core/native.eli" NativeNumber nativeTypeOf nativeGet)
  (import "../core/limits.eli" limits)
  (import "../core/instructions.eli" instructionPolicySchema)
  ;; Wire schemas describe safe projections. Storage records are never returned
  ;; wholesale; each business handler must independently project current grants.
  (defconst stringSchema (js-object :type "string"))
  (defconst nullableString (js-object :type (js-array "string" "null")))
  (defconst integerSchema
    (js-object :type "integer" :minimum 0 :maximum (nativeGet NativeNumber "MAX_SAFE_INTEGER")))
  (defconst boolSchema (js-object :type "boolean"))
  (defun arr (item) (js-object :type "array" :items item))
  (defun ref (name) (js-object :$ref (str "#/$defs/" name)))
  (defun obj
    (properties &optional required)
    (js-object
      :type
      "object"
      :properties
      properties
      :additionalProperties
      false
      :required
      (or required (js-array))))
  (defun nullable
    (schema)
    (js-object :anyOf (js-array schema (js-object :type "null"))))
  (defun strings
    (names &optional properties)
    (let ((result (or properties (js-object))))
      (js-call
        (js-call names :split " ")
        :forEach
        (lambda (name) (when (> (js-length name) 0) (put result name stringSchema))))
      result))
  (defun addTypedFields
    (properties names schema)
    (js-call
      (js-call names :split " ")
      :forEach
      (lambda (name) (when (> (js-length name) 0) (put properties name schema))))
    properties)
  (defconst definitions (js-object))
  (put definitions :resource (obj (strings "kind id") (js-array "kind" "id")))
  (put
    definitions
    :field_error
    (obj
      (strings "pointer code expected received_type")
      (js-array "pointer" "code" "expected" "received_type")))
  (put
    definitions
    :address
    (obj
      (js-object
        :scope stringSchema :kind stringSchema :resource_kind stringSchema :resource_token stringSchema :table_id nullableString :record_id nullableString
        :connection_id
        stringSchema
        :native_chat_id
        stringSchema
        :native_thread_id
        nullableString
        :thread_kind
        stringSchema
        :include_threads
        boolSchema
        :source_revision
        (js-object :type (js-array "string" "integer")))))
  (put
    definitions
    :delivery_source
    (obj
      (strings
        "kind connection_id native_chat_id thread_kind native_message_id resource_kind resource_token"
        (js-object :native_thread_id nullableString :table_id nullableString :record_id nullableString))))
  (put
    definitions
    :content
    (obj
      (js-object
        :message_ref stringSchema
        :type
        stringSchema
        :kind
        stringSchema
        :text
        stringSchema
        :truncated
        boolSchema
        :original_bytes
        integerSchema)))
  (put
    definitions
    :sender
    (obj (Object/assign (strings "id kind display_name principal_id principal_kind")
      (js-object :identities (arr (obj (strings "platform scope id") (js-array "platform" "scope" "id")))))))
  (put
    definitions
    :capability
    (obj
      (js-object
        :status
        stringSchema
        :evidence_kind
        stringSchema
        :checked_at
        stringSchema
        :limitations
        (arr stringSchema))))
  (let ((properties (js-object)))
    (js-call
      (js-call
        "receive_events send reply_thread replay native_history session_create session_send session_list session_messages session_probe instance_start instance_stop native_idempotency lookup_send lookup_create observe live_receiver managed_rpc start_idle"
        :split
        " ")
      :forEach
      (lambda
        (name)
        (put
          properties
          name
          (js-object :anyOf (js-array stringSchema (ref "capability"))))))
    (put properties :ack_control boolSchema)
    (js-call
      (js-array "max_text_bytes" "max_text_characters" "max_input_frame_bytes")
      :forEach
      (lambda (name) (put properties name integerSchema)))
    (put definitions :capabilities (obj properties)))
  (put
    definitions
    :source_health
    (obj
      (addTypedFields
        (addTypedFields
          (strings
            "state gap_status last_success_at next_due_at identity_revision completed_until window_start window_end reason")
          "pending_watches active_reads retry_count watch_count lag_seconds"
          integerSchema)
        "ack_control ready"
        boolSchema)))
  (put
    (nativeGet (nativeGet definitions "source_health") "properties")
    :reason_codes
    (arr stringSchema))
  (put
    definitions
    :coverage
    (obj
      (js-object
        :source_id
        stringSchema
        :instance_id
        stringSchema
        :connection_id
        stringSchema
        :tool
        stringSchema
        :coverage
        stringSchema
        :state
        stringSchema
        :reason
        stringSchema
        :last_observed_at
        nullableString
        :fields
        (arr stringSchema)
        :limitations
        (arr stringSchema)
        :include_content
        boolSchema
        :complete
        boolSchema
        :checked_at
        nullableString
        :content_range
        (nullable (obj (strings "from to"))))))
  (put
    definitions
    :receipt
    (obj
      (strings
        "receipt_id kind evidence_level native_ref attempt_id received_at"
        (js-object :definite_not_sent boolSchema :retryable boolSchema))))
  (put
    definitions
    :attachment
    (obj
      (strings
        "attachment_id kind file_name mime_type native_handle_ref"
        (js-object :size_bytes integerSchema))))
  (put
    definitions
    :part
    (obj
      (strings
        "part_id dispatch_key state native_message_id"
        (js-object
          :revision
          integerSchema
          :native_ref
          nullableString
          :definite_not_sent
          boolSchema))))
  (put
    definitions
    :contribution
    (obj
      (strings
        "delivery_id subscription_id expires_at state"
        (js-object
          :revision
          integerSchema
          :subscription_revision
          integerSchema
          :context_policy
          (ref "context_policy")
          :delivery_policy
          (ref "delivery_policy")))))
  (put
    definitions
    :context_policy
    (obj
      (js-object :mode stringSchema :max_events integerSchema :max_bytes integerSchema)))
  (put
    definitions
    :delivery_policy
    (obj
      (js-object :busy stringSchema :offline stringSchema :ttl_seconds integerSchema)))
  (put
    definitions
    :source
    (obj (js-object :conversation_ref stringSchema :include_threads boolSchema)))
  (put
    definitions
    :selector
    (obj (js-object :sources (arr (ref "source")) :event_kinds (arr stringSchema))))
  (put
    definitions
    :predicate
    (js-object
      :oneOf
      (js-array
        (obj (js-object :all (arr (ref "predicate"))) (js-array "all"))
        (obj (js-object :any (arr (ref "predicate"))) (js-array "any"))
        (obj (js-object :not (ref "predicate")) (js-array "not"))
        (obj
          (js-object
            :field
            stringSchema
            :op
            stringSchema
            :value
            (js-object
              :anyOf
              (js-array
                stringSchema
                boolSchema
                (arr (js-object :type (js-array "string" "boolean"))))))
          (js-array "field" "op" "value")))))
  (put definitions :mention (obj (strings "id name") (js-array "id")))
  (put definitions :reply_route (obj (strings "status identity connection_id" (js-object :mention_ids (arr stringSchema)))))
  (put definitions :reply_binding (obj (strings "source_connection_id mention_id reply_connection_id"
    (js-object :source_identity_revision integerSchema :reply_identity_revision integerSchema))))
  (put definitions :acknowledgement (obj (strings "acknowledgement_id emoji_type state reaction_id last_error"
    (js-object :delivery_id nullableString :native_acknowledged boolSchema))))
  (put definitions :working (obj (strings "delivery_id state reason expires_at cleanup_state last_error")))
  (put definitions :session_rules (obj (strings "session_key tool native_namespace native_session_id text sha256 updated_at updated_by"
    (js-object :revision integerSchema :reply_routes (arr (ref "reply_binding")))) (js-array "session_key" "tool" "native_namespace" "native_session_id" "text" "sha256" "revision")))
  (put definitions :conversation_rules (obj (strings "session_key text sha256" (js-object :revision integerSchema))
    (js-array "session_key" "revision" "sha256" "text")))
  (put definitions :message_filter (obj (js-object
    :policy_id stringSchema :schema_version integerSchema :scope stringSchema :revision integerSchema
    :updated_at stringSchema
    :people (arr (obj (js-object :id stringSchema :identities
      (arr (obj (strings "platform scope id") (js-array "platform" "scope" "id")))) (js-array "id" "identities")))
    :rules (arr (obj (js-object :id stringSchema :enabled boolSchema
      :effect stringSchema :predicate (ref "predicate")) (js-array "id" "enabled" "effect" "predicate"))))
    (js-array "policy_id" "schema_version" "scope" "revision" "rules")))
  (put
    definitions
    :spec
    (obj
      (js-object
        :agent_id
        stringSchema
        :selector
        (ref "selector")
        :predicate
        (ref "predicate")
        :context_policy
        (ref "context_policy")
        :delivery_policy
        (ref "delivery_policy")
        :instruction_policy
        instructionPolicySchema
        :delivery_mode stringSchema
        :start
        stringSchema)))
  (put definitions :issue (obj (strings "code pointer message")))
  (put
    definitions
    :sample
    (obj (strings "event_id result" (js-object :reason_codes (arr stringSchema)))))
  (put
    definitions
    :refresh_budget
    (obj
      (js-object
        :max_records
        integerSchema
        :max_messages
        integerSchema
        :max_bytes
        integerSchema
        :max_seconds
        integerSchema)))
  (put
    definitions
    :scope
    (obj
      (js-object
        :tools
        (arr stringSchema)
        :instance_ids
        (arr stringSchema)
        :workspace_refs
        (arr stringSchema)
        :agent_ids
        (arr stringSchema)
        :session_keys
        (arr stringSchema)
        :visibility
        (arr stringSchema)
        :runtime_states
        (arr stringSchema)
        :registered
        boolSchema
        :updated_range
        (obj (strings "from to")))))
  (put
    definitions
    :progress
    (obj
      (addTypedFields
        (js-object)
        "consumed_records consumed_messages consumed_bytes metadata_count content_index_bytes pending_native_work held_deliveries queued ready deferred blocked unknown deliveries events subscriptions targets connections"
        integerSchema)))
  (let ((properties (js-object)))
    (js-call
      (Object/keys limits)
      :forEach
      (lambda (name) (put properties name integerSchema)))
    (put definitions :limits (obj properties)))
  (put
    definitions
    :snippet
    (obj
