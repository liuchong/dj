              :visibility
              (arr stringSchema)
              :capabilities
              (ref "capabilities")
              :observations
              (arr (ref "coverage"))
              :matched_fields
              (arr stringSchema)
              :snippets
              (arr (ref "snippet"))))
          "registered live_receiver stale coverage_complete"
          boolSchema)
        "revision"
        integerSchema)))
