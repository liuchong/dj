          integerSchema
          :deadline_reached
          boolSchema
          :unknown_refs
          (arr (ref "resource"))
          :routing_metrics
          (ref "routing_metrics")
          :catalog_metrics
          (ref "catalog_metrics")
          :storage_metrics
          (ref "storage_metrics")))))
  (put
    definitions
    :action
    (obj
      (strings
        "operation"
        (js-object
          :arguments
          (obj
            (strings
              "operation_id delivery_id outbound_id lifecycle_id subscription_id agent_id session_key session_ref catalog_run_id"))
          :requires_user_decision
          boolSchema))))
  (put
    definitions
    :error
    (obj
      (js-object
        :code
        stringSchema
        :message
        stringSchema
        :retryable
        boolSchema
        :details
        (obj
          (strings
            "reason state operation_id delivery_id outbound_id lifecycle_id expected_kind capability"
            (js-object
              :resource_refs
              (arr (ref "resource"))
              :expected_revision
              integerSchema
              :current_revision
              integerSchema)))
        :field_errors
        (arr (ref "field_error"))
        :next_actions
        (arr (ref "action")))
      (js-array "code" "message" "retryable" "details" "field_errors" "next_actions")))
  (put definitions :context_reference (obj (strings "native_message_id relation status reason"
    (js-object :message (ref "message")))))
  (put definitions :message_context (obj (strings "context_ref as_of corpus scope coverage_reason"
    (js-object :resource (ref "lark_resource") :topic (ref "topic") :anchor (ref "message") :messages (arr (ref "message")) :references (arr (ref "context_reference"))
      :coverage_complete boolSchema :truncated boolSchema :query_available boolSchema :external_data boolSchema))))
  (put definitions :message_history (obj (strings "context_ref corpus as_of coverage_reason"
    (js-object :items (arr (ref "message")) :next_cursor nullableString :complete boolSchema
      :coverage_complete boolSchema :truncated boolSchema))))
  (defun pageSchema
    (name)
    (obj
      (js-object
        :items
        (arr (ref name))
        :next_cursor
        nullableString
        :complete
        boolSchema
        :snapshot_id
        stringSchema
        :as_of
        stringSchema
        :coverage_complete
        boolSchema
        :sources
        (arr (ref "coverage"))
        :stale
        boolSchema)
      (js-array "items" "next_cursor" "complete")))
  (defun dataSchemaFor
    (operation kind)
    (cond ((= operation "service.status") (ref "status"))
      ((= operation "operation.get") (ref "operation"))
      ((= operation "agent.whoami") (ref "principal"))
      ((= operation "subscription.preview") (ref "preview"))
      ((= operation "agent.discover") (pageSchema "candidate"))
      (
        (js-call
          (js-array
            "message.list"
            "message.search"
            "session.message.list"
            "session.message.search")
          :includes
          operation)
        (pageSchema "message"))
      ((js-call (js-array "message.get" "session.message.get") :includes operation)
        (ref "message"))
      ((or (js-call operation :endsWith ".list") (= operation "session.search"))
        (pageSchema kind))
      (t (ref kind))))
  (defun envelopeSchema
    (data)
    (let*
      (
        (common
          (js-object
            :request_id
            nullableString
            :operation_id
            stringSchema
            :warnings
            (arr (js-object :anyOf (js-array stringSchema (ref "issue"))))
            :evidence_level
            (js-object
              :enum
              (js-array
                "none"
                "service_record"
                "native_protocol"
                "agent_report"
                "manual"))
            :effect_state
            (js-object :enum (js-array "none" "recorded" "external_accepted" "unknown"))))
        (required
          (js-array "ok" "request_id" "warnings" "evidence_level" "effect_state")))
      (js-object
        :type
        "object"
        :oneOf
        (js-array
          (obj
            (Object/assign (js-object :ok (js-object :const t) :data data) common)
            (js-call required :concat (js-array "data")))
          (obj
            (Object/assign
              (js-object :ok (js-object :const false) :error (ref "error"))
              common)
            (js-call required :concat (js-array "error")))))))
  (put
    definitions
    :result
    (envelopeSchema
      (js-object
        :anyOf
        (js-call
          (js-array
            "session"
            "instance"
            "profile"
            "tool"
            "connection"
            "conversation"
            "candidate"
            "agent"
            "subscription"
            "preview"
            "message"
            "delivery"
            "outbound"
            "catalog"
            "lifecycle"
            "principal"
            "operation"
            "status")
          :map
          ref))))
  (defun reachableDefinitions
    (root)
    (let ((queue (js-array)) (seen (new globalThis.Set)) (result (js-object)) (index 0))
      (let ((visit nil))
        (setq
          visit
          (lambda
            (value)
            (when (and value (= (nativeTypeOf value) "object"))
              (if (Array/isArray value)
                (js-call value :forEach visit)
                (progn
                  (let ((reference (nativeGet value "$ref")))
                    (when
                      (and
                        (= (nativeTypeOf reference) "string")
                        (js-call reference :startsWith "#/$defs/"))
                      (let ((name (js-call reference :slice 8)))
                        (unless (js-call seen :has name)
                          (js-call seen :add name)
                          (js-call queue :push name)))))
                  (js-call (Object/values value) :forEach visit))))))
        (visit root)
        (while (< index (js-length queue))
          (let* ((name (aref queue index)) (definition (nativeGet definitions name)))
            (unless definition
              (throw (new globalThis.TypeError "unknown result-schema definition")))
            (put result name definition)
            (visit definition))
          (setq index (1+ index)))
        result)))
  (defun resultSchemaFor
    (operation kind)
    (let ((root (envelopeSchema (dataSchemaFor operation kind))))
      (Object/assign
        (js-object
          :$schema
          "https://json-schema.org/draft/2020-12/schema"
          :$defs
          (reachableDefinitions root))
        root)))
  (export resultSchemaFor))
