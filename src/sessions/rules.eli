(module dj.sessions.rules
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/errors.eli" success failure invalidField)
  (import "../core/types.eli" utf8Bytes nextRevision)
  (import "node:crypto" createHash)
  (import "../connections/replies.eli" normalizeReplyRoutes)
  (import "../application/context.eli" can requirePermission must utcNow currentPrincipal typedRef)
  (import "../catalog/service.eli" resolveSessionRecord)
  (defun rulesForSession (context target)
    (or (js-call (nativeGet context "repository") :get "session_rules" (nativeGet target "session_key"))
      (js-object :session_key (nativeGet target "session_key") :tool (nativeGet target "tool")
        :native_namespace (nativeGet target "native_namespace") :native_session_id (nativeGet target "native_session_id")
        :revision 1 :reply_routes (js-array) :text "" :sha256 (js-call (js-call (createHash "sha256") :update "") :digest "hex"))))
  (defun resolveRulesTarget (context args action)
    (let ((repository (nativeGet context "repository")) (key (nativeGet args "session_key")))
      (if (nativeGet args "session_ref") (resolveSessionRecord context args action)
        (progn
          (when (nativeGet args "agent_id")
            (let* ((agent (js-call repository :get "agents" (nativeGet args "agent_id")))
              (route (and agent (js-call repository :get "routes" (nativeGet agent "route_id")))))
              (setq key (nativeGet route "session_key"))))
          (let ((target (and key (or (js-call repository :get "sessions" key) (js-call repository :get "session_rules" key)))))
            (if (and target (can context action target)) (success target) (failure "forbidden")))))))
  (defun projectRules (context record)
    (if (or (can context "session.rules.read" record) (can context "session.rules.manage" record))
      (success record) (failure "forbidden")))
  (defun handleOperation (context operation args)
    (let* ((updating (= operation "session.rules.update"))
      (resolved (resolveRulesTarget context args (if updating "session.rules.manage" "session.rules.read")))
      (routes (if (object-has? args :reply_routes) (normalizeReplyRoutes context (nativeGet args "reply_routes")) (success nil)))
      (permission (and (nativeGet resolved "ok")
        (requirePermission context (if updating "session.rules.manage" "session.rules.read") (nativeGet resolved "data")))))
      (cond ((not (nativeGet resolved "ok")) resolved)
        ((not (nativeGet permission "ok")) permission)
        ((not (nativeGet routes "ok")) routes)
        ((not updating) (projectRules context (rulesForSession context (nativeGet resolved "data"))))
        ((or (not (= (nativeTypeOf (nativeGet args "text")) "string")) (> (utf8Bytes (nativeGet args "text")) 65536))
          (invalidField "/text" "a complete rule document at most 65536 UTF-8 bytes"))
        (t (js-call context :accept (lambda (tx operation-id)
          (let* ((target (must (resolveRulesTarget context args "session.rules.manage")))
            (repository (nativeGet context "repository")) (current (rulesForSession context target))
            (validated-routes (and (object-has? args :reply_routes) (must (normalizeReplyRoutes context (nativeGet args "reply_routes")))))
            (record (Object/assign (js-object) current (js-object :revision (nextRevision (nativeGet current "revision"))
              :text (nativeGet args "text") :sha256 (js-call (js-call (createHash "sha256") :update (nativeGet args "text")) :digest "hex")
              :updated_at (utcNow context) :updated_by (nativeGet (currentPrincipal context) "principal_id")))))
            (if (not (= (nativeGet current "revision") (nativeGet args "expected_revision")))
              (failure "revision_conflict")
              (progn
                (when (object-has? args :reply_routes) (put record :reply_routes validated-routes))
                (if (js-call repository :get "session_rules" (nativeGet target "session_key"))
                  (must (js-call repository :replace "session_rules" record (nativeGet current "revision")))
                  (js-call repository :insert "session_rules" record))
                (projectRules context record)))))
          (lambda (record) (js-array (typedRef "session_rules" (nativeGet record "session_key")))))))))
  (defun attachConversationRules (context target envelope)
    (let ((rules (rulesForSession context target)))
      (when (> (js-length (nativeGet rules "text")) 0)
        (put envelope :conversation_rules (js-object :session_key (nativeGet rules "session_key")
          :revision (nativeGet rules "revision") :sha256 (nativeGet rules "sha256") :text (nativeGet rules "text"))))
      envelope))
  (export handleOperation projectRules rulesForSession resolveRulesTarget attachConversationRules))
