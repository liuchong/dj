(module dj.sessions.supervision
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure invalidField)
  (import "../core/types.eli" addSeconds nextRevision utf8Bytes)
  (import "../application/context.eli" currentPrincipal can requirePermission inTransaction must utcNow nextId nativeCallContext agentPort)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../policy/authorize.eli" authorize)
  (import "../sessions/rules.eli" resolveRulesTarget)
  (defun owned (context record)
    (let ((principal (currentPrincipal context)))
      (or (= (nativeGet principal "kind") "operator")
        (= (nativeGet principal "principal_id") (nativeGet record "principal_id")))))
  (defun projectSupervision (context record)
    (if (and (owned context record) (can context "session.supervise"
      (or (js-call (nativeGet context "repository") :get "sessions" (nativeGet record "session_key")) record)))
      (success record) (failure "forbidden")))
  (defun cancelQueued (context key)
    ;; At most one wake is outstanding. Preserve attempts and the submitting cut.
    (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
      "UPDATE deliveries SET state='cancelled',revision=revision+1,payload=json_set(payload,'$.state','cancelled','$.revision',revision+1) WHERE json_extract(payload,'$.supervision_key')=? AND state IN ('ready','deferred','blocked')") :run key))
  (defun handleOperation (context operation args)
    (let* ((resolved (resolveRulesTarget context args "session.supervise"))
      (repository (nativeGet context "repository")))
      (if (not (nativeGet resolved "ok")) resolved
        (let* ((target (nativeGet resolved "data")) (key (nativeGet target "session_key"))
          (existing (js-call repository :get "session_supervisions" key))
          (permission (requirePermission context "session.supervise" target)))
          (cond
            ((not (nativeGet permission "ok")) permission)
            ((and existing (not (owned context existing))) (failure "forbidden"))
            ((= operation "session.supervision.get")
              (if existing (projectSupervision context existing)
                (success (js-object :session_key key :state "inactive" :status "not_registered"))))
            ((and (= operation "session.supervision.start") (> (utf8Bytes (nativeGet args "prompt")) 16384))
              (invalidField "/prompt" "at most 16384 UTF-8 bytes"))
            (t (js-call context :accept (lambda (tx operation-id)
              (let* ((session (must (resolveRulesTarget context args "session.supervise")))
                (previous (js-call repository :get "session_supervisions" key))
                (principal (currentPrincipal context)) (now (utcNow context))
                (starting (= operation "session.supervision.start")))
                (must (requirePermission context "session.supervise" session))
                (if (and previous (not (owned context previous))) (failure "forbidden")
                  (if (and starting (or (not previous) (not (= (nativeGet previous "state") "active")))
                    (>= (nativeGet (js-call (js-call (nativeGet tx "db") :query "SELECT COUNT(*) AS n FROM session_supervisions WHERE state='active'") :get) "n") 1000))
                    (failure "capacity_exceeded")
                    (let ((record (Object/assign (js-object) (or previous (js-object))
                      (js-object :session_key key :tool (nativeGet session "tool")
                        :native_namespace (nativeGet session "native_namespace") :native_session_id (nativeGet session "native_session_id")
                        :principal_id (if starting (nativeGet principal "principal_id") (nativeGet previous "principal_id" (nativeGet principal "principal_id")))
                        :authorization_revision (nativeGet principal "authorization_revision")
                        :revision (if previous (nextRevision (nativeGet previous "revision")) 1)
                        :generation (nextId context "supervision") :state (if starting "active" "cancelled")
                        :status (if starting "observing" "cancelled") :created_at (nativeGet previous "created_at" now)
                        :updated_at now :next_check_at now :idle_since now :delivery_id nil :pending_key nil
                        :wake_sequence 0 :failures 0 :last_error nil :last_wake_at nil
                        :prompt (if starting (nativeGet args "prompt") (nativeGet previous "prompt" ""))
                        :idle_seconds (if starting (nativeGet args "idle_seconds" 120) (nativeGet previous "idle_seconds" 120))
                        :check_seconds (if starting (nativeGet args "check_seconds" 30) (nativeGet previous "check_seconds" 30))))))
                      (cancelQueued context key)
                      (if previous (must (js-call repository :replace "session_supervisions" record (nativeGet previous "revision")))
                        (js-call repository :insert "session_supervisions" record))
                      (projectSupervision context record))))))
              (lambda (record) (js-array (js-object :kind "supervision" :id (nativeGet record "session_key")))))))))))
  (defun backoffSeconds (record)
    (Math/min 900 (* (nativeGet record "check_seconds") (Math/pow 2 (Math/min 6 (nativeGet record "failures" 0))))))
  (defun saveCheck (context record status patch &optional delay)
    (nativeGet (inTransaction context (lambda (tx)
      (let* ((repository (nativeGet context "repository"))
        (current (js-call repository :get "session_supervisions" (nativeGet record "session_key"))))
        (if (not (and current (= (nativeGet current "state") "active")
          (= (nativeGet current "generation") (nativeGet record "generation")))) (success nil)
          (let ((updated (Object/assign (js-object) current patch (js-object :status status :updated_at (utcNow context)
            :next_check_at (addSeconds (utcNow context) (or delay (nativeGet record "check_seconds")))
            :revision (nextRevision (nativeGet current "revision"))))))
            (must (js-call repository :replace "session_supervisions" updated (nativeGet current "revision")))
            (success updated)))))) "data"))
  (defun deferredCheck (context record reason)
    (saveCheck context record reason (js-object :idle_since nil :last_error reason
      :failures (Math/min 10 (1+ (nativeGet record "failures")))) (backoffSeconds record)))
  (defasync checkOne (context record)
    (let* ((repository (nativeGet context "repository")) (key (nativeGet record "session_key"))
      (session (js-call repository :get "sessions" key))
      (principal (configuredPrincipal (nativeGet (nativeGet context "config") "principals") (nativeGet record "principal_id")))
      (instance (and session (js-call repository :get "instances" (nativeGet session "instance_id"))))
      (port (and instance (agentPort context instance)))
      (delivery (and (nativeGet record "delivery_id") (js-call repository :get "deliveries" (nativeGet record "delivery_id")))))
      (cond
        ((not (and principal session (not (= (nativeGet session "tombstone") t))
          (= (nativeGet principal "authorization_revision") (nativeGet record "authorization_revision"))
          (nativeGet (authorize principal "session.supervise" session (nativeGet record "authorization_revision")) "allowed")))
          (deferredCheck context record "forbidden"))
        ((and delivery (js-call (js-array "ready" "deferred" "blocked" "submitting" "unknown") :includes (nativeGet delivery "state")))
          (saveCheck context record (if (= (nativeGet delivery "state") "unknown") "delivery_unknown" "delivery_pending") (js-object)))
        ((and delivery (= (nativeGet delivery "state") "accepted"))
          ;; Receipt means accepted input, not task completion. Continue watching.
          (saveCheck context record "wake_accepted" (js-object :delivery_id nil :idle_since (utcNow context))))
        ((not (and port (nativeGet port "probe"))) (deferredCheck context record "receiver_unavailable"))
        (t
          (let* ((call-context (nativeCallContext context (js-object :abort_signal (nativeGet (nativeGet (nativeGet context "runtime") "intake_abort") "signal"))))
            (observation nil))
            (try
              (setq observation (await (js-call port :probe session instance call-context)))
              (catch unavailable (setq observation (js-object :runtime_state "offline"))))
            (let ((state (nativeGet observation "runtime_state" "unknown")))
              (cond
                ((js-call (js-array "busy" "waiting_permission") :includes state)
                  (saveCheck context record state (js-object :idle_since nil :failures 0 :last_error nil)))
                ((not (and (= state "idle") (= (nativeGet observation "live_receiver") t)
                  (js-call (js-array "native_session_id" "native_namespace" "instance_epoch") :every
                    (lambda (field) (= (nativeGet session field) (nativeGet observation field))))))
                  (deferredCheck context record (if (= state "idle") "target_changed" state)))
                ((and (not (nativeGet record "pending_key"))
                  (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                    "SELECT 1 AS found FROM deliveries d JOIN routes r ON r.route_id=d.route_id WHERE r.session_key=? AND d.state IN ('ready','deferred','blocked','submitting','unknown') LIMIT 1") :get key))
                  (saveCheck context record "delivery_pending" (js-object :idle_since (utcNow context))))
                ((and (not (nativeGet record "pending_key"))
                  (or (not (nativeGet record "idle_since"))
                    (< (Date/parse (utcNow context)) (Date/parse (addSeconds (nativeGet record "idle_since")
                      (Math/max (nativeGet record "idle_seconds") (backoffSeconds record)))))))
                  (saveCheck context record "idle_grace" (js-object :idle_since (or (nativeGet record "idle_since") (utcNow context)) :last_error nil)))
                (t
                  (let* ((sequence (if (nativeGet record "pending_key") (nativeGet record "wake_sequence") (1+ (nativeGet record "wake_sequence"))))
                    (pending (or (nativeGet record "pending_key") (str "supervision:" (nativeGet record "generation") ":" sequence)))
                    (saved (saveCheck context record "preparing" (js-object :pending_key pending :wake_sequence sequence))))
                    (when saved
                      (let* ((args (js-object :idempotency_key pending
                        :content (js-object :type "text" :text (str "DJ 督工续接\n\n" (nativeGet record "prompt")
                          "\n\n请检查原任务并继续未完成的工作。完成或主动暂停时调用 session.supervision.cancel 取消本会话督工；普通最终回复不会取消。不要绕过授权、用户暂停或预算限制。"))
                        :delivery_policy (js-object :busy "queue" :offline "hold" :ttl_seconds 3600)))
                        (result (await (js-call context :sendSupervision saved args))))
                        (if (nativeGet result "ok")
                          (saveCheck context saved "delivery_pending" (js-object :pending_key nil
                            :delivery_id (nativeGet (nativeGet result "data") "delivery_id") :last_wake_at (utcNow context)
                            :last_error nil :failures (Math/min 10 (1+ (nativeGet saved "failures")))))
                          ;; Preserve the key across outages/crashes; replay only the ledger operation.
                          (saveCheck context saved "retrying" (js-object :last_error (nativeGet (nativeGet result "error") "code" "unavailable")
                            :failures (Math/min 10 (1+ (nativeGet saved "failures")))) (backoffSeconds saved))))))))))))))
  (defasync processSupervisions (context)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (rows (js-call (js-call db :query
        "SELECT payload FROM session_supervisions WHERE state='active' AND next_check_at<=? ORDER BY next_check_at,session_key LIMIT 4") :all (utcNow context)))
      (index 0))
      (while (and (< index (js-length rows)) (= (nativeGet (nativeGet context "runtime") "state") "ready")
        (not (nativeGet (nativeGet context "runtime") "storage_blocked")))
        (let ((record (JSON/parse (nativeGet (aref rows index) "payload"))))
          (try (await (checkOne context record))
            (catch unavailable
              (when (nativeGet unavailable "domain_result") (throw unavailable))
              (deferredCheck context record "receiver_unavailable"))))
        (setq index (1+ index)))
      (success nil)))
  (export handleOperation projectSupervision processSupervisions backoffSeconds))
