(module dj.dispatch.events
  (import "../core/native.eli" nativeGet nativeTypeOf NativeNumber)
  (import "../core/types.eli" hashValue)
  (import "../connections/network.eli" sameReplyNetwork replyNetworkKey canonicalReactionActor)
  (defun reactionEventDiscriminator (context source network chat event)
    (let* ((rx (nativeGet event "reaction"))
      (emoji (nativeGet rx "emoji_type"))
      (rid (nativeGet rx "native_reaction_id"))
      (has-rid (and (= (nativeTypeOf rid) "string") (> (js-length rid) 0)))
      (stamp (NativeNumber (nativeGet rx "action_time")))
      (actor-key (canonicalReactionActor context source (nativeGet rx "operator")))
      (db (nativeGet (nativeGet context "store") "db"))
      (canonical nil))
      (when db
        (let ((rows (js-call (js-call db :query
          "SELECT payload FROM events WHERE native_message_id=? AND event_kind='message.reaction.added' ORDER BY ingress_seq LIMIT 64")
          :all (nativeGet event "native_message_id"))))
          (js-call rows :some (lambda (row)
            (let* ((prior (JSON/parse (nativeGet row "payload")))
              (prior-source (js-call (nativeGet context "repository") :get "connections" (nativeGet prior "connection_id")))
              (prior-addr (nativeGet prior "conversation"))
              (prior-rx (nativeGet prior "reaction"))
              (prior-rid (nativeGet prior-rx "native_reaction_id"))
              (prior-has-rid (and (= (nativeTypeOf prior-rid) "string") (> (js-length prior-rid) 0)))
              (prior-stamp (NativeNumber (nativeGet prior-rx "action_time"))))
              (when (and prior-rx (sameReplyNetwork source prior-source)
                (= (nativeGet prior-addr "native_chat_id" nil) chat)
                (= (nativeGet prior-rx "emoji_type") emoji)
                (or (and has-rid prior-has-rid (= rid prior-rid))
                  (and (not (and has-rid prior-has-rid))
                    (Number/isFinite stamp) (Number/isFinite prior-stamp)
                    (<= (Math/abs (- stamp prior-stamp)) 500)
                    (= (JSON/stringify (canonicalReactionActor context prior-source (nativeGet prior-rx "operator")))
                      (JSON/stringify actor-key)))))
                (setq canonical (js-array "reaction" emoji
                  (canonicalReactionActor context prior-source (nativeGet prior-rx "operator"))
                  (nativeGet prior-rx "action_time")))
                t))))))
      (or canonical
        (if has-rid (js-array "reaction_id" rid)
          (js-array "reaction" emoji actor-key (nativeGet rx "action_time"))))))
  ;; A Lark HTTP first sighting may already carry the same edit observed by a peer.
  (defun messageSnapshotStamp (event)
    (or (nativeGet event "native_message_update_time") (Date/parse (nativeGet event "source_time"))))
  (defun larkMessageSnapshot (connection event)
    (and (= (nativeGet connection "platform") "lark")
      (js-call (js-array "message.created" "message.edited") :includes (nativeGet event "event_kind"))))
  (defun equivalentEventKinds (kind)
    (if (js-call (js-array "message.created" "message.edited") :includes kind)
      (js-array "message.created" "message.edited")
      (js-array kind kind)))
  ;; Native identifiers and platform namespaces only; never compare body text.
  (defun eventIdentity (context event)
    (let* ((source (js-call (nativeGet context "repository") :get "connections" (nativeGet event "connection_id")))
      (address (nativeGet event "conversation"))
      (network (replyNetworkKey context source address))
      (chat (nativeGet address "native_chat_id" nil))
      (original-kind (nativeGet event "event_kind"))
      (snapshot (larkMessageSnapshot source event))
      (stamp (and snapshot (messageSnapshotStamp event)))
      (kind (if (and stamp (> stamp (Date/parse (nativeGet event "source_time"))))
        "message.edited" original-kind))
      (discriminator (cond
        ((and snapshot (= kind "message.edited")) stamp)
        ((= kind "message.created") (nativeGet event "source_time" nil))
        ((and (= kind "message.pinned") (nativeGet event "pin"))
          (js-array "pin" (canonicalReactionActor context source (nativeGet (nativeGet event "pin") "operator"))
            (nativeGet (nativeGet event "pin") "action_time" (nativeGet event "source_time" nil))))
        ((and (= kind "message.reaction.added") (nativeGet event "reaction"))
          (reactionEventDiscriminator context source network chat event))
        (t (nativeGet event "source_key" (nativeGet event "event_id"))))))
      (js-object :network network :chat chat
          :source_time (if (and snapshot (= kind "message.edited"))
          (js-call (new globalThis.Date stamp) :toISOString) (nativeGet event "source_time"))
        :event_key (hashValue (js-array network chat (nativeGet event "native_message_id") kind discriminator)))))
  ;; A sent reply may never return as an inbox echo. Its native receipt still
  ;; links the quoted message to the original interaction without body matching.
  (defun sentParentAnchor (context event parent)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (rows (js-call (js-call db :query
        "SELECT o.payload FROM echo_index e JOIN outbound o ON o.outbound_id=e.outbound_id WHERE e.native_message_id=? AND json_extract(o.payload,'$.destination.native_chat_id')=? LIMIT 65")
        :all parent (nativeGet (nativeGet event "conversation") "native_chat_id")))
      (anchors (new globalThis.Set)))
      (when (<= (js-length rows) 64)
        (js-call rows :forEach (lambda (row)
          (let* ((outgoing (JSON/parse (nativeGet row "payload")))
            (connection (js-call repository :get "connections" (nativeGet outgoing "connection_id")))
            (ref (nativeGet outgoing "reply_record_id"))
            (reply (and ref (js-call repository :get (if (nativeGet outgoing "inbox_id") "inbox_reply_contexts" "reply_contexts") ref)))
            (id (nativeGet reply "dispatch_context_id"))
            (interaction (and id (js-call repository :get "dispatch_contexts" id))))
            (when (and interaction (sameReplyNetwork source connection)
              (= (nativeGet outgoing "identity_revision") (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
              (js-call anchors :add (nativeGet interaction "anchor")))))))
      (when (= (nativeGet anchors "size") 1) (nativeGet (js-call (js-call anchors :values) :next) "value"))))
  ;; Follow only native parent edges. Bounded traversal never guesses a task.
  (defun parentAnchor (context event)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (source (js-call repository :get "connections" (nativeGet event "connection_id")))
      (parent (nativeGet (nativeGet event "reply_to") "id" nil)) (anchor parent)
      (seen (new globalThis.Set)) (steps 0))
      (while (and db parent (< steps 32) (not (js-call seen :has parent)))
        (js-call seen :add parent)
        (let* ((rows (js-call (js-call db :query
          "SELECT payload FROM events WHERE native_message_id=? AND event_kind='message.created' AND json_extract(payload,'$.conversation.native_chat_id')=? ORDER BY ingress_seq LIMIT 64")
          :all parent (nativeGet (nativeGet event "conversation") "native_chat_id")))
          (record (js-call rows :map (lambda (row) (JSON/parse (nativeGet row "payload")))))
          (sent-anchor (sentParentAnchor context event parent))
          (prior (js-call record :find (lambda (item)
            (sameReplyNetwork source (js-call repository :get "connections" (nativeGet item "connection_id")))))))
          (setq parent nil)
          (if sent-anchor (setq anchor sent-anchor) (when prior
            (if (nativeGet prior "root_message_id")
              (setq anchor (nativeGet prior "root_message_id"))
              (progn (setq parent (nativeGet (nativeGet prior "reply_to") "id" nil))
                (when parent (setq anchor parent)))))))
        (setq steps (1+ steps))) anchor))
  (defun contextIdentity (context event)
    (let* ((identity (eventIdentity context event)) (address (nativeGet event "conversation"))
      (parent (nativeGet (nativeGet event "reply_to") "id" nil))
      (anchor (if (= (nativeGet event "chat_type") "p2p") "private"
        (or (nativeGet event "root_message_id") (and parent (parentAnchor context event)) (nativeGet address "native_thread_id") (nativeGet event "native_message_id")))))
      (put identity :context_id (str "interaction_" (hashValue (js-array (nativeGet identity "network") (nativeGet identity "chat") anchor))))
      (put identity :anchor anchor) identity))
  (defun eventOrder (context event)
    (let* ((db (nativeGet (nativeGet context "store") "db")) (key (nativeGet (eventIdentity context event) "event_key"))
      (kinds (equivalentEventKinds (nativeGet event "event_kind")))
      (value (js-call (str (nativeGet event "ingress_seq" "0")) :padStart 20 "0")))
      (when db
        (js-call (js-call (js-call db :query
          "SELECT payload FROM events WHERE native_message_id=? AND event_kind IN (?,?) ORDER BY ingress_seq LIMIT 64")
          :all (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1)) :forEach (lambda (row)
          (let ((prior (JSON/parse (nativeGet row "payload"))))
            (when (= key (nativeGet (eventIdentity context prior) "event_key"))
              (let ((sequence (js-call (str (nativeGet prior "ingress_seq" "0")) :padStart 20 "0")))
                (when (or (= value "00000000000000000000") (< (js-call sequence :localeCompare value) 0)) (setq value sequence)))))))) value))
  (export eventIdentity contextIdentity eventOrder equivalentEventKinds larkMessageSnapshot messageSnapshotStamp))
