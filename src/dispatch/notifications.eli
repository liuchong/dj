(module dj.dispatch.notifications
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" hashValue)
  (import "../application/context.eli" must utcNow)
  (import "./events.eli" equivalentEventKinds eventIdentity)
  (defun notificationKey (context event session-key)
    (str "notification_"
      (hashValue (js-array (nativeGet (eventIdentity context event) "event_key") session-key))))
  (defun addObservation (context slot record event)
    (let* ((id (nativeGet event "event_id"))
           (items (nativeGet slot "observations" (js-array))))
      (unless (js-call items :some (lambda (item) (= (nativeGet item "event_id") id)))
        (if (< (js-length items) 64)
          (js-call items :push
            (js-object
              :event_id id
              :connection_id (nativeGet event "connection_id")
              :delivery_id (nativeGet record "delivery_id" nil)
              :inbox_id (nativeGet record "inbox_id" nil)
              :target_key (nativeGet record "target_key" nil)))
          (put slot :has_more_sources t)))
      (put slot :observations items)))
  (defun existingSessionNotification (context event session-key route-id &optional agent-id)
    (let* ((repository (nativeGet context "repository"))
           (db (nativeGet (nativeGet context "store") "db"))
           (event-key (nativeGet (eventIdentity context event) "event_key"))
           (kinds (equivalentEventKinds (nativeGet event "event_kind")))
           (key (notificationKey context event session-key))
           (slot (js-call repository :get "dispatch_notifications" key))
           (slot-owner (and slot (js-call repository :get (nativeGet slot "owner_kind") (nativeGet slot "owner_id"))))
           (found nil))
      (when (and slot slot-owner
                 (if (= (nativeGet slot "owner_kind") "deliveries")
                   (js-call (js-array "ready" "deferred" "blocked" "submitting" "accepted" "unknown" "resolved")
                     :includes (nativeGet slot-owner "state"))
                   (and (js-call (js-array "ready" "claimed" "consumed") :includes (nativeGet slot-owner "state"))
                        (> (Date/parse (nativeGet slot-owner "expires_at")) (Date/parse (utcNow context))))))
        (setq found (nativeGet slot "owner_id")))
      (when (and (not found) route-id)
        (let ((rows (js-call (js-call db :query
                "SELECT d.delivery_seq AS seq,d.payload AS delivery,e.payload AS event FROM events e JOIN deliveries d INDEXED BY delivery_event_route ON d.event_id=e.event_id AND d.route_id=? WHERE (e.event_id=? OR (e.native_message_id=? AND e.event_kind IN (?,?))) AND d.origin='subscription_event' AND d.state IN ('ready','deferred','blocked','submitting','accepted','unknown','resolved') LIMIT 65")
                :all route-id (nativeGet event "event_id") (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1))))
          (js-call rows :sort (lambda (a b) (- (nativeGet a "seq") (nativeGet b "seq"))))
          (js-call rows :some (lambda (row)
            (when (= event-key (nativeGet (eventIdentity context (JSON/parse (nativeGet row "event"))) "event_key"))
              (setq found (nativeGet (JSON/parse (nativeGet row "delivery")) "delivery_id"))
              t)))))
      (when (and (not found) agent-id)
        (let ((rows (js-call (js-call db :query
                "SELECT i.payload AS entry,e.payload AS event FROM events e JOIN inbox_entries i ON i.event_id=e.event_id WHERE i.agent_id=? AND (e.event_id=? OR (e.native_message_id=? AND e.event_kind IN (?,?))) AND i.state IN ('ready','claimed','consumed') AND i.expires_at>? ORDER BY e.ingress_seq LIMIT 65")
                :all agent-id (nativeGet event "event_id") (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1) (utcNow context))))
          (js-call rows :some (lambda (row)
            (when (= event-key (nativeGet (eventIdentity context (JSON/parse (nativeGet row "event"))) "event_key"))
              (setq found (nativeGet (JSON/parse (nativeGet row "entry")) "inbox_id"))
              t)))))
      found))
  (defun notificationState (context record event session-key lane &optional reserve)
    (let* ((repository (nativeGet context "repository"))
           (key (notificationKey context event session-key))
           (kinds (equivalentEventKinds (nativeGet event "event_kind")))
           (id (or (nativeGet record "delivery_id") (nativeGet record "inbox_id")))
           (kind (if (nativeGet record "inbox_id") "inbox_entries" "deliveries"))
           (slot (js-call repository :get "dispatch_notifications" key)))
      ;; Existing durable receipts are evidence too, including work accepted before
      ;; this process started. This is not replay and does not alter those records.
      (when (and (not slot) (nativeGet record "route_id"))
        (let* ((db (nativeGet (nativeGet context "store") "db"))
               (rows (js-call (js-call db :query
                 "SELECT d.delivery_seq AS seq,d.payload AS delivery,e.payload AS event FROM events e JOIN deliveries d INDEXED BY delivery_event_route ON d.event_id=e.event_id AND d.route_id=? WHERE e.native_message_id=? AND e.event_kind IN (?,?) AND d.delivery_id<>? AND d.origin='subscription_event' AND d.state IN ('accepted','submitting','unknown','resolved') LIMIT 65")
                 :all (nativeGet record "route_id") (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1) (or id ""))))
          (js-call rows :sort (lambda (a b) (- (nativeGet a "seq") (nativeGet b "seq"))))
          (js-call rows :some (lambda (row)
            (let ((other (JSON/parse (nativeGet row "delivery")))
                  (source (JSON/parse (nativeGet row "event"))))
              (when (= key (notificationKey context source session-key))
                (setq slot (js-object :notification_key key :owner_id (nativeGet other "delivery_id")
                  :owner_kind "deliveries" :target_key session-key :created_at (utcNow context) :observations (js-array)))
                (addObservation context slot other source)
                (js-call repository :insert "dispatch_notifications" slot)
                t))))))
      (when (and (not slot) (nativeGet record "group_id"))
        (let* ((db (nativeGet (nativeGet context "store") "db"))
               (direct-deliveries (and (nativeGet record "route_id")
                 (js-call (js-call db :query
                   "SELECT d.delivery_seq AS seq,d.payload AS delivery,e.payload AS event FROM events e JOIN deliveries d INDEXED BY delivery_event_route ON d.event_id=e.event_id AND d.route_id=? WHERE (e.event_id=? OR (e.native_message_id=? AND e.event_kind IN (?,?))) AND d.delivery_id<>? AND d.origin='subscription_event' AND COALESCE(json_extract(d.payload,'$.distribution_key'),'')='' AND d.state IN ('ready','deferred','blocked','submitting','accepted','unknown','resolved') LIMIT 65")
                   :all (nativeGet record "route_id") (nativeGet event "event_id") (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1) (or id ""))))
               (direct-inboxes (and (nativeGet record "agent_id")
                 (js-call (js-call db :query
                   "SELECT i.payload AS entry,e.payload AS event FROM events e JOIN inbox_entries i ON i.event_id=e.event_id WHERE i.agent_id=? AND (e.event_id=? OR (e.native_message_id=? AND e.event_kind IN (?,?))) AND i.inbox_id<>? AND i.target_key GLOB 'session:*' AND i.state IN ('ready','claimed','consumed') AND i.expires_at>? ORDER BY e.ingress_seq LIMIT 65")
                   :all (nativeGet record "agent_id") (nativeGet event "event_id") (nativeGet event "native_message_id") (aref kinds 0) (aref kinds 1) (or id "") (utcNow context)))))
          (when direct-deliveries
            (js-call direct-deliveries :sort (lambda (a b) (- (nativeGet a "seq") (nativeGet b "seq"))))
            (js-call direct-deliveries :some (lambda (row)
              (let ((other (JSON/parse (nativeGet row "delivery")))
                    (source (JSON/parse (nativeGet row "event"))))
                (when (= key (notificationKey context source session-key))
                  (setq slot (js-object :notification_key key :owner_id (nativeGet other "delivery_id")
                    :owner_kind "deliveries" :target_key session-key :canonical_state "notified"
                    :created_at (utcNow context) :observations (js-array)))
                  (addObservation context slot other source)
                  (js-call repository :insert "dispatch_notifications" slot)
                  t)))))
          (when (and (not slot) direct-inboxes)
            (js-call direct-inboxes :some (lambda (row)
              (let ((other (JSON/parse (nativeGet row "entry")))
                    (source (JSON/parse (nativeGet row "event"))))
                (when (= key (notificationKey context source session-key))
                  (setq slot (js-object :notification_key key :owner_id (nativeGet other "inbox_id")
                    :owner_kind "inbox_entries" :target_key session-key :canonical_state "notified"
                    :created_at (utcNow context) :observations (js-array)))
                  (addObservation context slot other source)
                  (js-call repository :insert "dispatch_notifications" slot)
                  t)))))))
      (let* ((owner (and slot (js-call repository :get (nativeGet slot "owner_kind") (nativeGet slot "owner_id"))))
             (replaceable
               (or (and slot (not owner))
                   (and owner
                     (if (= (nativeGet slot "owner_kind") "deliveries")
                       (or (js-call (js-array "cancelled" "expired") :includes (nativeGet owner "state"))
                           (and (= (nativeGet owner "state") "failed") (= (nativeGet owner "definite_not_sent") t))
                           (and (nativeGet owner "group_id")
                                (not (nativeGet record "group_id"))
                                (js-call (js-array "ready" "deferred" "blocked") :includes (nativeGet owner "state"))))
                       (or (js-call (js-array "revoked" "suppressed" "coalesced") :includes (nativeGet owner "state"))
                           (<= (Date/parse (nativeGet owner "expires_at")) (Date/parse (utcNow context)))
                           (and (= (nativeGet owner "state") "ready")
                                (or (and (= kind "inbox_entries")
                                         (or (not (nativeGet record "group_id"))
                                             (nativeGet owner "group_id")))
                                    (and (nativeGet owner "group_id")
                                         (not (nativeGet record "group_id"))))))))))
             (same (and slot (= (nativeGet slot "owner_kind") kind) (= (nativeGet slot "owner_id") id))))
        (cond
          ((and slot (not same) (not replaceable))
            (when (js-call (js-array "accepted" "consumed" "claimed" "resolved") :includes (nativeGet owner "state"))
              (put slot :canonical_state (if (= (nativeGet owner "state") "resolved") "closed_no_retry" "notified")))
            (addObservation context slot record event)
            (must (js-call repository :replace "dispatch_notifications" slot))
            (put record :notification_key key)
            (put record :coalesced_into (nativeGet slot "owner_id"))
            (when (nativeGet owner "dispatch_context_id") (put record :dispatch_context_id (nativeGet owner "dispatch_context_id")))
            (when (nativeGet owner "identity_binding_id") (put record :identity_binding_id (nativeGet owner "identity_binding_id")))
            (if (js-call (js-array "notified" "closed_no_retry") :includes (nativeGet slot "canonical_state")) "coalesced" "pending"))
          (reserve
            (unless (js-call (nativeGet context "store") :inTransaction)
              (throw (new globalThis.TypeError "notification reservation requires transaction")))
            (let ((fresh (not slot)))
              (unless slot (setq slot (js-object :notification_key key :created_at (utcNow context) :observations (js-array))))
              (put slot :owner_id id)
              (put slot :owner_kind kind)
              (put slot :target_key session-key)
              (addObservation context slot record event)
              (if fresh
                (js-call repository :insert "dispatch_notifications" slot)
                (must (js-call repository :replace "dispatch_notifications" slot))))
            (put record :notification_key key)
            "owned")
          (t "available")))))
  (defun notificationSummary (context record)
    (let* ((repository (nativeGet context "repository"))
           (row (and (not (nativeGet record "notification_key")) (nativeGet record "delivery_id")
             (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
               "SELECT payload FROM dispatch_notifications WHERE owner_kind='deliveries' AND owner_id=? LIMIT 1")
               :get (nativeGet record "delivery_id"))))
           (slot (if row (JSON/parse (nativeGet row "payload"))
             (and (nativeGet record "notification_key")
                  (js-call repository :get "dispatch_notifications" (nativeGet record "notification_key"))))))
      (when slot
        (js-object
          :notification_key (nativeGet slot "notification_key")
          :owner_id (nativeGet slot "owner_id")
          :sources (nativeGet slot "observations")
          :has_more_sources (nativeGet slot "has_more_sources" false)))))
  (export notificationKey existingSessionNotification notificationState notificationSummary))
