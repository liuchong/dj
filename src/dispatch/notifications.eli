(module dj.dispatch.notifications
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" hashValue)
  (import "../application/context.eli" must utcNow)
  (import "./events.eli" eventIdentity)
  (defun notificationKey (context record event target lane)
    (str "notification_" (hashValue (js-array (nativeGet (eventIdentity context event) "event_key")
      target lane (nativeGet record "distribution_key" "")))))
  (defun addObservation (context slot record event contributions)
    (let* ((id (nativeGet event "event_id")) (items (nativeGet slot "observations" (js-array))))
      (unless (js-call items :some (lambda (item) (= (nativeGet item "event_id") id)))
        (if (< (js-length items) 64)
          (js-call items :push (js-object :event_id id :connection_id (nativeGet event "connection_id")
            :delivery_id (nativeGet record "delivery_id" nil) :inbox_id (nativeGet record "inbox_id" nil)
            :subscription_ids (js-call contributions :map (lambda (c) (nativeGet c "subscription_id")))))
          (put slot :has_more_sources t)))
      (put slot :observations items)))
  (defun notificationState (context record event target lane contributions &optional reserve)
    (let* ((repository (nativeGet context "repository")) (key (notificationKey context record event target lane))
      (id (or (nativeGet record "delivery_id") (nativeGet record "inbox_id")))
      (kind (if (nativeGet record "inbox_id") "inbox_entries" "deliveries"))
      (slot (js-call repository :get "dispatch_notifications" key)))
      ;; Existing durable receipts are evidence too, including work accepted before
      ;; this process started. This is not replay and does not alter those records.
      (when (and (not slot) (= lane "push") (nativeGet record "route_id"))
        (let* ((db (nativeGet (nativeGet context "store") "db"))
          (rows (js-call (js-call db :query
            "SELECT d.payload AS delivery,e.payload AS event FROM events e JOIN deliveries d ON d.event_id=e.event_id AND d.route_id=? WHERE e.native_message_id=? AND e.event_kind=? AND d.delivery_id<>? AND d.origin='subscription_event' AND d.state IN ('accepted','submitting','unknown') AND COALESCE(json_extract(d.payload,'$.distribution_key'),'')=? ORDER BY d.delivery_seq LIMIT 65")
            :all (nativeGet record "route_id") (nativeGet event "native_message_id") (nativeGet event "event_kind") id (nativeGet record "distribution_key" ""))))
          (js-call rows :some (lambda (row)
            (let ((other (JSON/parse (nativeGet row "delivery"))) (source (JSON/parse (nativeGet row "event"))))
              (when (= key (notificationKey context other source target lane))
                (setq slot (js-object :notification_key key :owner_id (nativeGet other "delivery_id")
                  :owner_kind "deliveries" :target_key target :created_at (utcNow context) :observations (js-array)))
                (addObservation context slot other source (js-array))
                (js-call repository :insert "dispatch_notifications" slot) t))))))
      (let* ((owner (and slot (js-call repository :get (nativeGet slot "owner_kind") (nativeGet slot "owner_id"))))
        (replaceable (and owner (or
          (and (= (nativeGet owner "state") "failed") (= (nativeGet owner "definite_not_sent") t))
          (and (= (nativeGet slot "owner_kind") "inbox_entries") (= (nativeGet owner "state") "ready")))))
        (same (and slot (= (nativeGet slot "owner_kind") kind) (= (nativeGet slot "owner_id") id))))
        (cond
          ((and slot (not same) (not replaceable))
            (when (js-call (js-array "accepted" "consumed" "claimed" "resolved") :includes (nativeGet owner "state"))
              (put slot :canonical_state (if (= (nativeGet owner "state") "resolved") "closed_no_retry" "notified")))
            (addObservation context slot record event contributions)
            (must (js-call repository :replace "dispatch_notifications" slot))
            (put record :notification_key key) (put record :coalesced_into (nativeGet slot "owner_id"))
            (when (nativeGet owner "dispatch_context_id") (put record :dispatch_context_id (nativeGet owner "dispatch_context_id")))
            (when (nativeGet owner "identity_binding_id") (put record :identity_binding_id (nativeGet owner "identity_binding_id")))
            (if (js-call (js-array "notified" "closed_no_retry") :includes (nativeGet slot "canonical_state")) "coalesced" "pending"))
          (reserve
            (unless (js-call (nativeGet context "store") :inTransaction) (throw (new globalThis.TypeError "notification reservation requires transaction")))
            (let ((fresh (not slot)))
              (unless slot (setq slot (js-object :notification_key key :created_at (utcNow context) :observations (js-array))))
              (put slot :owner_id id) (put slot :owner_kind kind) (put slot :target_key target)
              (addObservation context slot record event contributions)
              (if fresh (js-call repository :insert "dispatch_notifications" slot)
                (must (js-call repository :replace "dispatch_notifications" slot))))
            (put record :notification_key key) "owned")
          (t "available")))))
  (defun notificationSummary (context record)
    (let* ((repository (nativeGet context "repository"))
      (row (and (not (nativeGet record "notification_key")) (nativeGet record "delivery_id")
        (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
          "SELECT payload FROM dispatch_notifications WHERE owner_kind='deliveries' AND owner_id=? LIMIT 1")
          :get (nativeGet record "delivery_id"))))
      (slot (if row (JSON/parse (nativeGet row "payload"))
        (and (nativeGet record "notification_key") (js-call repository :get "dispatch_notifications" (nativeGet record "notification_key"))))))
      (when slot (js-object :notification_key (nativeGet slot "notification_key") :owner_id (nativeGet slot "owner_id")
        :sources (nativeGet slot "observations") :has_more_sources (nativeGet slot "has_more_sources" false)))))
  (export notificationKey notificationState notificationSummary))
