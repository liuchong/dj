(module dj.dispatch.contexts
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" hashValue)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" utcNow must)
  (import "../connections/network.eli" sameReplyNetwork)
  (import "./events.eli" contextIdentity eventOrder)
  (import "./evidence.eli" selectReplyRoute)
  (defun bindingSelection (context event binding)
    (let* ((repository (nativeGet context "repository"))
      (connection (js-call repository :get "connections" (nativeGet binding "connection_id")))
      (source (js-call repository :get "connections" (nativeGet event "connection_id"))))
      (if (and (sameReplyNetwork source connection)
        (= (nativeGet binding "identity_revision") (nativeGet connection "identity_revision" (nativeGet connection "revision"))))
        (js-object :status "ready" :connection connection :connection_id (nativeGet connection "connection_id")
          :identity (nativeGet connection "identity") :mention_ids (js-array) :basis "interaction_binding"
          :dispatch_context_id (nativeGet binding "context_id") :identity_binding_id (nativeGet binding "binding_id")
          :destination (Object/assign (js-object) (nativeGet event "conversation")
            (js-object :connection_id (nativeGet connection "connection_id"))))
        (js-object :status "stale_reference" :mention_ids (js-array) :basis "interaction_binding"))))
  (defun existingSelection (context record event session-key)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (identity (contextIdentity context event)) (order (eventOrder context event))
      (bound (and (nativeGet record "identity_binding_id") (js-call repository :get "dispatch_bindings" (nativeGet record "identity_binding_id"))))
      (exact (and db (js-call (js-call db :query
        "SELECT payload FROM dispatch_bindings WHERE context_id=? AND cause_key=? LIMIT 1")
        :get (nativeGet identity "context_id") (nativeGet identity "event_key"))))
      (previous (and db (js-call (js-call db :query
        "SELECT payload FROM dispatch_bindings WHERE context_id=? AND (source_time<? OR (source_time=? AND ingress_seq<=?)) ORDER BY source_time DESC,ingress_seq DESC,cause_key DESC LIMIT 1")
        :get (nativeGet identity "context_id") (nativeGet event "source_time" (utcNow context)) (nativeGet event "source_time" (utcNow context)) order)))
      (evidence (selectReplyRoute context event session-key))
      (explicit (or (js-call (js-array "native_mentions" "shared_native_message") :includes (nativeGet evidence "basis"))
        (and (= (nativeGet evidence "basis") "private_recipient") (= (nativeGet evidence "private_evidence") "incoming"))))
      (selected (cond
        (bound (bindingSelection context event bound))
        (exact (bindingSelection context event (JSON/parse (nativeGet exact "payload"))))
        ((and previous (not explicit)) (bindingSelection context event (JSON/parse (nativeGet previous "payload"))))
        (t evidence))))
      (put selected :session_key session-key) selected))
  ;; Called within the submission transaction, before its first native effect.
  (defun prepareIdentity (context record event session-key)
    (let* ((repository (nativeGet context "repository")) (selected (existingSelection context record event session-key)))
      (when (and (= (nativeGet selected "status") "ready") (not (nativeGet selected "identity_binding_id")))
        (unless (js-call (nativeGet context "store") :inTransaction) (throw (new globalThis.TypeError "identity binding requires transaction")))
        (let* ((identity (contextIdentity context event)) (id (nativeGet identity "context_id"))
          (current (js-call repository :get "dispatch_contexts" id)) (connection (nativeGet selected "connection"))
          (binding (js-object :binding_id (str "identity_" (hashValue (js-array id (nativeGet identity "event_key"))))
            :context_id id :cause_key (nativeGet identity "event_key") :ingress_seq (eventOrder context event) :source_time (nativeGet event "source_time" (utcNow context))
            :connection_id (nativeGet connection "connection_id") :identity (nativeGet connection "identity")
            :identity_revision (nativeGet connection "identity_revision" (nativeGet connection "revision"))
            :basis (nativeGet selected "basis") :state "reserved" :previous_binding_id (nativeGet current "binding_id" nil)
            :created_at (utcNow context))))
          (unless current
            (setq current (js-object :context_id id :source_connection_id (nativeGet event "connection_id")
              :anchor (nativeGet identity "anchor") :native_chat_id (nativeGet identity "chat") :binding_id nil :source_time ""))
            (js-call repository :insert "dispatch_contexts" current))
          (js-call repository :insert "dispatch_bindings" binding)
          (when (or (> (js-call (nativeGet binding "source_time") :localeCompare (nativeGet current "source_time" "")) 0)
            (and (= (nativeGet binding "source_time") (nativeGet current "source_time"))
              (or (> (js-call (nativeGet binding "ingress_seq") :localeCompare (nativeGet current "ingress_seq" "")) 0)
                (and (= (nativeGet binding "ingress_seq") (nativeGet current "ingress_seq" ""))
                  (> (js-call (nativeGet binding "cause_key") :localeCompare (nativeGet current "cause_key" "")) 0)))))
              (put current :binding_id (nativeGet binding "binding_id")) (put current :source_time (nativeGet binding "source_time"))
              (put current :cause_key (nativeGet binding "cause_key"))
              (put current :ingress_seq (nativeGet binding "ingress_seq"))
              (must (js-call repository :replace "dispatch_contexts" current)))
          (Object/assign selected (js-object :dispatch_context_id id :identity_binding_id (nativeGet binding "binding_id") :session_key session-key))))
      (when (nativeGet selected "identity_binding_id")
        (put record :identity_binding_id (nativeGet selected "identity_binding_id"))
        (put record :dispatch_context_id (nativeGet selected "dispatch_context_id"))) selected))
  (defun activateIdentity (context record)
    (when (nativeGet record "identity_binding_id")
      (let* ((repository (nativeGet context "repository")) (binding (js-call repository :get "dispatch_bindings" (nativeGet record "identity_binding_id"))))
        (when (and binding (not (= (nativeGet binding "state") "active")))
          (put binding :state "active") (must (js-call repository :replace "dispatch_bindings" binding))))))
  (defun checkReplyIdentity (context reply)
    (let* ((repository (nativeGet context "repository")) (event (js-call repository :get "events" (nativeGet reply "event_id")))
      (delivery (and (nativeGet reply "delivery_id") (js-call repository :get "deliveries" (nativeGet reply "delivery_id"))))
      (route (and delivery (js-call repository :get "routes" (nativeGet delivery "route_id"))))
      (session-key (or (nativeGet reply "session_key") (nativeGet route "session_key")))
      (selected (and event session-key (existingSelection context reply event session-key))))
      (if (and selected (= (nativeGet selected "status") "ready")
        (= (nativeGet selected "connection_id") (nativeGet (nativeGet reply "destination") "connection_id")))
        (success nil) (failure "reply_identity_unresolved" (js-object :details (js-object
          :reason (if (= (nativeGet selected "status") "ready") "frozen_identity_changed" (nativeGet selected "status" "unmapped_target"))))))))
  (export existingSelection prepareIdentity activateIdentity bindingSelection checkReplyIdentity))
