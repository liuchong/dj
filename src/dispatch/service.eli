(module dj.dispatch.service
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" hashValue)
  (import "../application/context.eli" can requirePermission utcNow must safeFields typedRef)
  (import "../delivery/service.eli" deliveryAccess)
  (import "../connections/network.eli" sameReplyNetwork)
  (defun projectContext (context record)
    (let* ((repository (nativeGet context "repository"))
      (connection (js-call repository :get "connections" (nativeGet record "source_connection_id")))
      (binding (and (nativeGet record "binding_id") (js-call repository :get "dispatch_bindings" (nativeGet record "binding_id")))))
      (if (not (can context "message.read" connection)) (failure "forbidden")
        (success (Object/assign (safeFields record (js-array "context_id" "anchor" "native_chat_id" "binding_id" "source_time"))
          (js-object :binding (if binding (safeFields binding (js-array "binding_id" "connection_id" "identity"
            "identity_revision" "basis" "state" "cause_key" "source_time" "previous_binding_id" "reason")) nil)))))))
  (defun handleOperation (context operation args)
    (let* ((repository (nativeGet context "repository"))
      (delivery (and (nativeGet args "delivery_id") (js-call repository :get "deliveries" (nativeGet args "delivery_id"))))
      (id (or (nativeGet args "context_id") (nativeGet delivery "dispatch_context_id")))
      (record (and id (js-call repository :get "dispatch_contexts" id))))
      (cond
        ((and (nativeGet args "delivery_id") (not (and delivery (deliveryAccess context delivery "delivery.inspect")))) (failure "forbidden"))
        ((not record) (failure "not_found"))
        ((= operation "dispatch.context.get") (projectContext context record))
        ((= operation "dispatch.context.transfer")
          (let* ((source (js-call repository :get "connections" (nativeGet record "source_connection_id")))
            (destination (js-call repository :get "connections" (nativeGet args "connection_id"))))
            (if (not (and (= (nativeGet args "explicit") t) (sameReplyNetwork source destination)
              (nativeGet (requirePermission context "message.reply" destination) "ok"))) (failure "forbidden")
              (js-call context :accept (lambda (tx operation-id)
                (let* ((current (js-call repository :get "dispatch_contexts" id))
                  (prior (nativeGet current "binding_id"))
                  (binding (js-object :binding_id (str "identity_" (hashValue operation-id)) :context_id id
                    :cause_key (str "transfer:" operation-id) :ingress_seq (js-call (js-call repository :currentSequence "ingress") :padStart 20 "0") :source_time (utcNow context) :created_at (utcNow context)
                    :connection_id (nativeGet destination "connection_id") :identity (nativeGet destination "identity")
                    :identity_revision (nativeGet destination "identity_revision" (nativeGet destination "revision"))
                    :basis "explicit_transfer" :state "active" :previous_binding_id prior :reason (nativeGet args "reason"))))
                  (unless (= prior (nativeGet args "expected_binding_id")) (must (failure "stale_reference")))
                  (js-call repository :insert "dispatch_bindings" binding)
                  (put current :binding_id (nativeGet binding "binding_id")) (put current :source_time (nativeGet binding "source_time"))
                  (put current :cause_key (nativeGet binding "cause_key"))
                  (put current :ingress_seq (nativeGet binding "ingress_seq"))
                  (must (js-call repository :replace "dispatch_contexts" current)) (projectContext context current)))
                (lambda (data) (js-array (typedRef "dispatch_context" (nativeGet data "context_id"))))))))
        (t (failure "invalid_argument")))))
  (export handleOperation projectContext))
