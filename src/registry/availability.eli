(module dj.registry.availability
  (import "../core/native.eli" nativeGet nativeNullish)
  (import "../core/types.eli" hashValue addSeconds)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" utcNow agentPort nativeCallContext inTransaction can)
  (defconst pending (new globalThis.WeakMap))
  (defun availabilityScope (session)
    (hashValue (js-array (nativeGet session "instance_id") (nativeGet session "instance_epoch")
      (nativeGet session "native_namespace")
      (let ((m (nativeGet session "model_selection")))
        (js-array (nativeGet m "provider_id" nil) (nativeGet m "model_id" nil)
          (nativeGet m "variant" nil) (nativeGet m "reasoning_effort" nil))))))
  (defun currentAvailability (context agent-id session)
    (let ((row (js-call (nativeGet context "repository") :get "agent_availability" (availabilityScope session))))
      (if (and row (= (nativeGet row "scope_key") (availabilityScope session))
        (> (Date/parse (nativeGet row "valid_until")) (Date/parse (utcNow context)))) row
        (js-object :agent_id agent-id :state "unknown" :reason "not_observed" :source "none"
          :observed_at (utcNow context) :valid_until (utcNow context) :reset_at nil))))
  (defun quotaObservation (raw session now)
    (let* ((scope (availabilityScope session)) (state (nativeGet raw "state" "unknown"))
      (reset (nativeGet raw "reset_at" nil)) (until (addSeconds now 60)))
      (unless (js-call (js-array "available" "exhausted" "unknown") :includes state) (setq state "unknown"))
      (when (and reset (or (not (Number/isFinite (Date/parse reset)))
        (<= (Date/parse reset) (Date/parse now))))
        (setq state "unknown" reset nil))
      (when (and reset (Number/isFinite (Date/parse reset)) (< (Date/parse reset) (Date/parse until)))
        (setq until (if (> (Date/parse reset) (Date/parse now)) reset now)))
      (js-object :scope_key scope :state state :observed_at now :valid_until until :reset_at reset
        :source (nativeGet raw "source" "unsupported") :reason (nativeGet raw "reason" "not_observed"))))
  (defasync refreshAvailability (context agent session)
    (let* ((repository (nativeGet context "repository")) (id (nativeGet agent "agent_id"))
      (cached (currentAvailability context id session)) (store (nativeGet context "store"))
      (calls (or (js-call pending :get store) (new globalThis.Map))) (key (availabilityScope session)))
      (if (> (Date/parse (nativeGet cached "valid_until")) (Date/parse (utcNow context))) cached
        (progn
          (js-call pending :set store calls)
          (unless (js-call calls :has key)
            (js-call calls :set key (funcall (async ()
              (let* ((instance (js-call repository :get "instances" (nativeGet session "instance_id")))
                (port (and instance (agentPort context instance))) (raw nil)
                (call (nativeCallContext context)))
                (put call :deadline (Math/min (nativeGet call "deadline")
                  (+ (js-call (nativeGet (nativeGet context "ports") "clock") :monoNow) 2000)))
                (try
                  (when (nativeGet port "availability") (setq raw (await (js-call port :availability session call))))
                  (catch unavailable (setq raw (js-object :state "unknown" :reason "query_failed" :source "native_protocol"))))
                (let ((observation (quotaObservation raw session (utcNow context))))
                  (put observation :agent_id id)
                  (inTransaction context (lambda (tx)
                    (let* ((route (js-call repository :get "routes" (nativeGet agent "route_id")))
                      (current (and route (js-call repository :get "sessions" (nativeGet route "session_key")))))
                      (when (and current (= (availabilityScope current) (availabilityScope session)))
                        (if (js-call repository :get "agent_availability" (availabilityScope session))
                          (js-call repository :replace "agent_availability" observation)
                          (js-call repository :insert "agent_availability" observation))))
                    (success nil))) observation))))))
          (try (await (js-call calls :get key)) (finally (js-call calls :delete key)))))))
  (defun noteAvailabilityFailure (context record signal)
    (when (and signal (js-call (js-array "exhausted" "unknown") :includes (nativeGet signal "state")))
      (let* ((repository (nativeGet context "repository"))
        (route (js-call repository :get "routes" (nativeGet record "route_id")))
        (session (and route (js-call repository :get "sessions" (nativeGet route "session_key")))))
        (when session
          (let ((row (quotaObservation signal session (utcNow context))))
            (put row :agent_id (nativeGet record "agent_id"))
            (if (js-call repository :get "agent_availability" (nativeGet row "scope_key"))
              (js-call repository :replace "agent_availability" row)
              (js-call repository :insert "agent_availability" row)))))))
  (defasync inspectAvailability (context args)
    (let* ((repository (nativeGet context "repository")) (agent (js-call repository :get "agents" (nativeGet args "agent_id")))
      (route (and agent (js-call repository :get "routes" (nativeGet agent "route_id"))))
      (session (and route (js-call repository :get "sessions" (nativeGet route "session_key")))))
      (if (and agent session (or (can context "agent.inspect" agent) (can context "agent.bind" agent)))
        (success (Object/assign (js-object) (await (refreshAvailability context agent session))
          (js-object :agent_id (nativeGet agent "agent_id")))) (failure "forbidden"))))
  (export availabilityScope currentAvailability quotaObservation refreshAvailability inspectAvailability noteAvailabilityFailure))
