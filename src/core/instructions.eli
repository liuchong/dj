(module dj.core.instructions
  (import "./native.eli" nativeGet nativeTypeOf nativeNullish)
  (import "./types.eli" utf8Bytes)
  (import "./limits.eli" limits)
  (import "./errors.eli" success invalidField)
  (defconst instructionPolicySchema
    (js-object :type "object" :additionalProperties false :minProperties 1
      :properties (js-object
        :prompt (js-object :type "string" :minLength 1 :maxLength 8192)
        :task_template (js-object :type "string" :minLength 1 :maxLength 8192))))
  (defconst templateFields
    (js-array "message.text" "event.id" "sender.id" "source.chat_id" "source.thread_id" "subscription.id"))
  (defun templateParts (text)
    (let ((parts (js-call text :split (new globalThis.RegExp "([{][{][^{}]*[}][}])" "g")))
          (result (js-array)) (slots 0))
      (js-call parts :forEach (lambda (part)
        (if (and (js-call part :startsWith "{{") (js-call part :endsWith "}}"))
          (let ((field (js-call part :slice 2 -2)))
            (setq slots (1+ slots))
            (unless (and (js-call templateFields :includes field) (<= slots (nativeGet limits "instruction_template_slots")))
              (throw (new globalThis.TypeError "unknown or excessive task template field")))
            (js-call result :push (js-object :field field)))
          (progn
            (when (or (js-call part :includes "{{") (js-call part :includes "}}"))
              (throw (new globalThis.TypeError "unbalanced task template field")))
            (js-call result :push (js-object :text part))))))
      result))
  (defun validateInstructionPolicy (policy)
    (if (nativeNullish policy) (success nil)
      (try
        (js-call (Object/keys policy) :forEach (lambda (field)
          (let ((text (nativeGet policy field)))
            (unless (and (js-call (js-array "prompt" "task_template") :includes field)
              (= (nativeTypeOf text) "string") (> (js-length text) 0)
              (<= (utf8Bytes text) (nativeGet limits "instruction_text_bytes")))
              (throw (new globalThis.TypeError "instruction text limit")))
            (when (= field "task_template") (templateParts text)))))
        (when (= (js-length (Object/keys policy)) 0) (throw (new globalThis.TypeError "empty instruction policy")))
        (success policy)
        (catch invalid (invalidField "/spec/instruction_policy"
          "prompt/task_template: 1..8192 UTF-8 bytes; at most 32 documented {{field}} substitutions")))))
  (defun renderTask (template event contribution body)
    (let* ((address (nativeGet event "conversation"))
           (values (js-object :message.text body :event.id (nativeGet event "event_id")
             :sender.id (nativeGet (nativeGet event "sender") "id")
             :source.chat_id (nativeGet address "native_chat_id")
             :source.thread_id (nativeGet address "native_thread_id")
             :subscription.id (nativeGet contribution "subscription_id")))
           (text "") (bytes 0) (overflow false))
      ;; Parse configuration once. Substituted external values are literal data:
      ;; never parse their braces, evaluate expressions or run a shell.
      (js-call (templateParts template) :forEach (lambda (part)
        (unless overflow
          (let* ((value (if (object-has? part :field) (nativeGet values (nativeGet part "field")) (nativeGet part "text")))
                 (piece (if (nativeNullish value) "" (str value))))
            ;; Count the assembled string: a surrogate pair can span a literal
            ;; and a substituted value, so per-piece UTF-8 sizes are not additive.
            (setq bytes (utf8Bytes (str text piece)))
            (if (> bytes (nativeGet limits "instruction_task_bytes"))
              (setq overflow t)
              (setq text (str text piece)))))))
      (js-object :text text :overflow overflow)))
  (defun composeInstructions (contributions event body)
    (let ((result (js-array)) (bytes 0))
      (js-call contributions :forEach (lambda (item)
        (let ((policy (nativeGet item "instruction_policy")))
          (when (and policy (not (nativeGet result "overflow")))
            (let ((entry (js-object :subscription_id (nativeGet item "subscription_id")
                     :subscription_revision (nativeGet item "revision"))))
              (when (nativeGet policy "prompt") (put entry :prompt (nativeGet policy "prompt")))
              (when (nativeGet policy "task_template")
                (let ((rendered (renderTask (nativeGet policy "task_template") event item body)))
                  (put entry :task_template (nativeGet policy "task_template"))
                  (put entry :task (nativeGet rendered "text"))
                  (when (nativeGet rendered "overflow") (put result :overflow t))))
              (setq bytes (+ bytes (utf8Bytes (JSON/stringify entry))))
              (when (> bytes (nativeGet limits "native_frame_max_bytes")) (put result :overflow t))
              (unless (nativeGet result "overflow") (js-call result :push entry)))))))
      result))
  (export instructionPolicySchema validateInstructionPolicy renderTask composeInstructions))
