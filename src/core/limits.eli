(module dj.core.limits
  (import "./native.eli" nativeGet)
  ;; Service budgets; none of these numbers claim a vendor protocol guarantee.
  (defconst limits
    (Object/freeze
      (js-object
        :text_bytes
        16384
        :instruction_text_bytes
        8192
        :instruction_task_bytes
        32768
        :instruction_template_slots
        32
        :event_body_bytes
        262144
        :message_preview_bytes
        1024
        :query_bytes
        1024
        :title_bytes
        256
        :body_page_default_bytes
        16384
        :body_page_max_bytes
        32768
        :request_bytes
        262144
        :api_response_bytes
        4194304
        :ttl_min_seconds
        60
        :ttl_max_seconds
        604800
        :ttl_default_seconds
        86400
        :limit_default
        50
        :limit_max
        200
        :rule_depth
        8
        :rule_leaves
        64
        :rule_in_values
        64
        :sources
        100
        :event_kinds
        5
        :preview_samples
        20
        :scope_tools
        32
        :scope_values
        100
        :match_batch_candidates
        128
        :match_batch_default_candidates
        64
        :match_character_visits
        10000000
        :compiled_rule_cache_entries
        2048
        :compiled_rule_cache_bytes
        8388608
        :predicate_memo_entries
        1024
        :routing_sample_count
        10000
        :route_queue
        1000
        :global_queue
        10000
        :snapshot_results
        10000
        :active_snapshots
        32
        :catalog_records
        100000
        :catalog_body_index_bytes
        536870912
        :database_max_bytes
        1073741824
        :database_reserve_bytes
        67108864
        :search_scan_records
        1000
        :search_scan_bytes
        4194304
        :refresh_turn_records
        100
        :refresh_turn_messages
        32
        :refresh_turn_bytes
        1048576
        :refresh_source_concurrency
        4
        :refresh_max_records
        10000
        :refresh_max_messages
        1000
        :refresh_max_bytes
        16777216
        :refresh_max_seconds
        60
        :native_response_max_bytes
        1048576
        :native_frame_max_bytes
        1048576
        :frame_drain_seconds
        5
        :handle_ttl_seconds
        600
        :reply_ttl_seconds
        86400
        :body_retention_seconds
        604800
        :audit_retention_seconds
        2592000
        :field_errors
        10
        :lark_read_concurrency
        2
        :lark_read_launches_per_second
        2
        :lark_read_launch_burst
        2
        :lark_read_timeout_seconds
        15
        :lark_poll_pages_per_turn
        20
        :lark_poll_turn_ms
        5000
        :lark_poll_overlap_seconds
        120
        :lark_poll_visibility_delay_seconds
        2)))
  (defun getLimit (name) (nativeGet limits name))
  (export limits getLimit))
