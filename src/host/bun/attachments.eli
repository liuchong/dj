(module dj.host.bun.attachments
  (import "../../core/native.eli" nativeBitAnd nativeGet nativeTypeOf)
  (import "node:crypto" createHash randomUUID)
  (import "node:path" resolve)
  (import "node:fs/promises" lstat mkdir open readFile readdir rename rm writeFile)

  (defconst fileLimit 104857600)
  (defconst cacheLimit 536870912)
  (defconst retentionMs 86400000)
  (defconst maxConcurrent 4)
  (defconst keyPattern (new globalThis.RegExp "^[0-9a-f]{64}$"))
  (defconst assetPattern (new globalThis.RegExp "^asset(?:[.][a-z0-9]{1,12})?$"))
  (defconst extensions (Object/freeze (Object/fromEntries (js-array
    (js-array "image/png" "png") (js-array "image/jpeg" "jpg") (js-array "image/webp" "webp")
    (js-array "image/gif" "gif") (js-array "application/pdf" "pdf") (js-array "audio/ogg" "ogg")
    (js-array "audio/mpeg" "mp3") (js-array "video/mp4" "mp4")))))

  (defun owned (info)
    (and (= (nativeGet info "uid") (js-call globalThis.process :getuid))
      (= (nativeBitAnd (nativeGet info "mode") 63) 0)))

  (defasync makePrivateDirectory (path)
    (try (await (mkdir path (js-object :mode 448)))
      (catch error (unless (= (nativeGet error "code") "EEXIST") (throw error))))
    (let ((info (await (lstat path))))
      (unless (and (js-call info :isDirectory) (owned info))
        (throw (new globalThis.Error "attachment cache directory is not private")))))

  (defasync readAsset (directory)
    (try
      (let* ((index (resolve directory "index.json"))
             (dir (await (lstat directory))) (meta (await (lstat index))))
        (when (and (js-call dir :isDirectory) (owned dir)
          (js-call meta :isFile) (owned meta) (< (nativeGet meta "size") 16384))
          (let* ((record (JSON/parse (await (readFile index "utf8"))))
                 (name (nativeGet record "stored_name")))
            (when (and (= (nativeTypeOf name) "string") (js-call assetPattern :test name))
              (let* ((path (resolve directory name)) (info (await (lstat path))))
                (when (and (js-call info :isFile) (owned info)
                  (= (nativeGet info "size") (nativeGet record "size_bytes")))
                  (let ((data (Object/assign (js-object :local_path path) record)))
                    (Reflect/deleteProperty data "stored_name")
                    data)))))))
      (catch error nil)))

  (defun nativeFileName (metadata)
    (let* ((header (nativeGet metadata "content_disposition" ""))
           (unicode (js-call (new globalThis.RegExp "filename[*]=UTF-8''([^;]+)" "i") :exec header))
           (quoted (js-call (new globalThis.RegExp "filename=(?:\"([^\"]+)\"|([^;]+))" "i") :exec header))
           (name (or (nativeGet metadata "file_name")
             (and unicode (try (globalThis.decodeURIComponent (aref unicode 1)) (catch invalid nil)))
             (and quoted (or (aref quoted 1) (aref quoted 2))))))
      (when (= (nativeTypeOf name) "string")
        (js-call (js-call name :replaceAll (new globalThis.RegExp "[/\\\\\\x00-\\x1f]" "g") "_") :slice 0 240))))

  (defun storedName (file-name metadata)
    (let* ((match (and file-name (js-call (new globalThis.RegExp "[.]([a-z0-9]{1,12})$" "i") :exec file-name)))
           (mime (js-call (aref (js-call (nativeGet metadata "mime_type" "application/octet-stream") :split ";") 0) :toLowerCase))
           (extension (or (nativeGet extensions mime) (nativeGet metadata "format") (and match (js-call (aref match 1) :toLowerCase)))))
      (if (and extension (js-call (new globalThis.RegExp "^[a-z0-9]{1,12}$") :test extension))
        (str "asset." extension) "asset")))

  (defun createAttachmentFiles (root)
    (let* ((directory (resolve root "attachments")) (active (new globalThis.Map))
           (pruning nil) (prepare nil) (download nil))
      (setq prepare (async ()
        (await (makePrivateDirectory directory))
        (unless pruning
          (setq pruning (funcall (async ()
            (let ((entries (await (readdir directory))) (records (js-array)) (bytes 0) (now (Date/now))
                  (cursor 0))
              (while (< cursor (js-length entries))
                (let* ((entry (aref entries cursor)) (path (resolve directory entry)))
                  (cond
                    ((and (js-call keyPattern :test entry) (not (js-call active :has entry)))
                      (let ((record (await (readAsset path))))
                        (if (and record (<= now (nativeGet record "expires_at_ms")))
                          (progn (setq bytes (+ bytes (nativeGet record "size_bytes")))
                            (js-call records :push (js-object :key entry :data record)))
                          (when (not (js-call active :has entry))
                            (await (rm path (js-object :recursive t :force t)))))))
                    ((js-call (new globalThis.RegExp "^[.]pending-[0-9a-f-]{36}$") :test entry)
                      (try (let ((info (await (lstat path))))
                        (when (and (owned info) (js-call info :isDirectory)
                          (> (- now (nativeGet info "mtimeMs")) retentionMs))
                          (await (rm path (js-object :recursive t :force t)))))
                        (catch absent nil)))))
                (setq cursor (1+ cursor)))
              (js-call records :sort (lambda (a b)
                (- (nativeGet (nativeGet a "data") "expires_at_ms") (nativeGet (nativeGet b "data") "expires_at_ms"))))
              (let ((index 0))
                (while (and (< index (js-length records))
                  (or (> bytes (- cacheLimit (* maxConcurrent fileLimit)))
                      (> (- (js-length records) index) 1024)))
                  (let* ((item (aref records index)) (key (nativeGet item "key")))
                    (unless (js-call active :has key)
                      (await (rm (resolve directory key) (js-object :recursive t :force t)))
                      (setq bytes (- bytes (nativeGet (nativeGet item "data") "size_bytes")))))
                  (setq index (1+ index)))))))))
        (try (await pruning) (finally (setq pruning nil)))))
      (setq download (async (key retrieve)
        (await (funcall prepare))
        (let* ((target (resolve directory key))
               (present (await (readAsset target)))
               (stage (resolve directory (str ".pending-" (randomUUID))))
               (part (resolve stage "part"))
               (file nil) (started false))
          (if (and present (< (Date/now) (nativeGet present "expires_at_ms")))
            (js-object :ok t :data present)
            (try
              (await (makePrivateDirectory stage))
              (setq started t file (await (open part "wx" 384)))
              (let* ((digest (createHash "sha256"))
                     (result (await (funcall retrieve (async (bytes)
                       (js-call digest :update bytes) (await (js-call file :writeFile bytes))) fileLimit))))
                (await (js-call file :close)) (setq file nil)
                (if (not (nativeGet result "ok"))
                  result
                  (let* ((metadata (nativeGet result "data"))
                         (file-name (nativeFileName metadata))
                         (stored (storedName file-name metadata))
                         (record (js-object :stored_name stored :file_name (or file-name stored)
                           :size_bytes (nativeGet metadata "size_bytes") :mime_type (nativeGet metadata "mime_type")
                           :format (nativeGet metadata "format" nil) :sha256 (js-call digest :digest "hex")
                           :expires_at_ms (+ (Date/now) retentionMs))))
                    (await (rename part (resolve stage stored)))
                    (await (writeFile (resolve stage "index.json") (JSON/stringify record) (js-object :mode 384 :flag "wx")))
                    (await (rm target (js-object :recursive t :force t)))
                    (await (rename stage target)) (setq started false)
                    (let ((data (await (readAsset target))))
                      (unless data (throw (new globalThis.Error "downloaded attachment is not readable")))
                      (js-object :ok t :data data)))))
              (finally
                (when file (await (js-call file :close)))
                (when started (await (rm stage (js-object :recursive t :force t))))))))))
      (js-object
        :inspect (async (key)
          (when (js-call keyPattern :test key)
            (let ((record (await (readAsset (resolve directory key)))))
              (when (and record (< (Date/now) (nativeGet record "expires_at_ms"))) record))))
        :fetch (async (key retrieve)
          (unless (js-call keyPattern :test key) (throw (new globalThis.TypeError "invalid attachment cache key")))
          (let ((pending (js-call active :get key)))
            (cond
              (pending (await pending))
              ((>= (nativeGet active "size") maxConcurrent)
                (js-object :ok false :error (js-object :code "unavailable"
                  :details (js-object :reason "attachment_fetch_capacity"))))
              (t
                (setq pending (funcall download key retrieve))
                (js-call active :set key pending)
                (try (await pending) (finally (js-call active :delete key))))))))))

  (export createAttachmentFiles))
