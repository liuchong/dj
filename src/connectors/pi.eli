(module dj.connectors.pi
  (import "../core/native.eli" nativeGet nativeTypeOf nativeBitAnd)
  (import "../core/types.eli" utf8Bytes)
  (import "../adapters/im/telegram.eli" readJson)
  (import "node:http" createServer)
  (import "node:stream" Readable)
  (import "node:fs/promises" mkdir lstat realpath writeFile unlink chmod)
  (import "node:path" resolve join)
  (import "node:os" homedir)
  (import "node:crypto" randomBytes randomUUID timingSafeEqual)
  (defasync ownedRemove (path inode)
    (try
      (let ((info (await (lstat path))))
        (when (and (= (nativeGet info "ino") inode)
                   (= (nativeGet info "uid") (js-call globalThis.process :getuid)))
          (await (unlink path))))
      (catch absent nil)))
  (defun sessionId (context)
    (js-call (nativeGet context "sessionManager") :getSessionId))
  (defun piText (message)
    (let ((content (nativeGet message "content")))
      (if (= (nativeTypeOf content) "string") content
        (if (Array/isArray content)
          (js-call (js-call (js-call content :filter
            (lambda (part) (and (= (nativeGet part "type") "text")
                                (= (nativeTypeOf (nativeGet part "text")) "string"))))
            :map (lambda (part) (nativeGet part "text"))) :join "\n") ""))))
  (defun recentMessages (context)
    (let* ((branch (js-call (nativeGet context "sessionManager") :getBranch))
           (index (1- (js-length branch))) (visited 0) (bytes 0) (rows (js-array)))
      (while (and (>= index 0) (< visited 256) (< (js-length rows) 128))
        (let* ((entry (aref branch index)) (message (nativeGet entry "message"))
               (role (nativeGet message "role")) (text (piText message)))
          (when (and (= (nativeGet entry "type") "message")
                     (js-call (js-array "user" "assistant") :includes role)
                     (= (nativeTypeOf (nativeGet entry "id")) "string")
                     (> (js-length text) 0) (<= (+ bytes (utf8Bytes text)) 524288))
            (setq bytes (+ bytes (utf8Bytes text)))
            (js-call rows :unshift (js-object :native_message_id (nativeGet entry "id")
              :role role :text text))))
        (setq index (1- index) visited (1+ visited)))
      rows))
  (defun activatePiReceiver (pi &optional options)
    (unless (and (= (nativeTypeOf (nativeGet pi "on")) "function")
                 (= (nativeTypeOf (nativeGet pi "sendUserMessage")) "function"))
      (throw (new globalThis.TypeError "Pi extension API is required")))
    (let ((active nil) (closing nil))
      (setq closing (async ()
        (when active
          (let ((record active))
            (setq active nil)
            (put record :closed t)
            (let ((server (nativeGet record "server")))
              (when server
                (await (new globalThis.Promise (lambda (done)
                  (js-call server :close (lambda () (funcall done)))
                  (when (nativeGet server "closeAllConnections") (js-call server :closeAllConnections)))))))
            (when (nativeGet record "manifest_inode")
              (await (ownedRemove (nativeGet record "manifest_path") (nativeGet record "manifest_inode"))))
            (when (nativeGet record "socket_inode")
              (await (ownedRemove (nativeGet record "socket_path") (nativeGet record "socket_inode"))))))))
      (js-call pi :on "session_shutdown" (async (event context) (await (funcall closing))))
      (js-call pi :on "agent_start" (lambda (event context)
        (when (and active (= (sessionId context) (nativeGet active "session_id")))
          (put active :pending false) (put active :running t))))
      (js-call pi :on "agent_end" (lambda (event context)
        (when (and active (= (sessionId context) (nativeGet active "session_id")))
          (put active :pending false) (put active :running (= (nativeGet event "willRetry") t)))))
      (js-call pi :on "session_start"
        (async (event context)
          (await (funcall closing))
          (when (js-call (js-array "tui" "rpc") :includes (nativeGet context "mode"))
            (let* ((id (sessionId context))
                   (directory (resolve (nativeGet context "cwd")))
                   (root (resolve (nativeGet options "root" (join (homedir) ".dj/pi-receivers"))))
                   (name (str (nativeGet globalThis.process "pid") "-" (randomUUID)))
                   (socket-path (join root (str name ".sock")))
                   (manifest-path (join root (str name ".json")))
                   (epoch (randomUUID)) (token (js-call (randomBytes 32) :toString "hex"))
                   (record (js-object :session_id id :closed false :pending false :running false
                             :socket_path socket-path :manifest_path manifest-path))
                   (server nil))
              (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0))
                (throw (new globalThis.TypeError "Pi has no native session identity")))
              (await (mkdir root (js-object :recursive t :mode 448)))
              (let ((info (await (lstat root))))
                (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
                             (= (await (realpath root)) root)
                             (= (nativeGet info "uid") (js-call globalThis.process :getuid))
                             (= (nativeBitAnd (nativeGet info "mode") 63) 0))
                  (throw (new globalThis.TypeError "Pi receiver directory must be private and owned"))))
              (setq active record)
              (try
                (setq server (createServer
                  (async (request response)
                    (let ((reply nil) (status 200))
                      (js-call request :on "error" (lambda (ignored) nil))
                      (js-call response :on "error" (lambda (ignored) nil))
                      (try
                        (let* ((headers (nativeGet request "headers"))
                               (authorization (nativeGet headers "authorization" ""))
                               (expected (str "Bearer " token)))
                          (unless (and (= (nativeGet request "method") "POST")
                                       (= (nativeGet request "url") "/")
                                       (not (nativeGet headers "origin"))
                                       (= (nativeTypeOf authorization) "string")
                                       (= (Buffer/byteLength authorization) (Buffer/byteLength expected))
                                       (timingSafeEqual (Buffer/from authorization) (Buffer/from expected)))
                            (throw (new globalThis.Error "unauthorized"))))
                        (let* ((body (await (readJson (new globalThis.Response (js-call Readable :toWeb request)) 1048576)))
                               (operation (nativeGet body "operation")))
                          (unless (and (not (nativeGet record "closed"))
                                       (= active record) (= (sessionId context) id)
                                       (= (nativeGet body "schema_version") 1)
                                       (= (nativeGet body "session_id") id)
                                       (= (nativeGet body "receiver_epoch") epoch))
                            (throw (new globalThis.Error "target_changed")))
                          (let* ((idle (and (not (nativeGet record "pending"))
                                        (not (nativeGet record "running"))
                                        (js-call context :isIdle) (not (js-call context :hasPendingMessages))))
                                 (data (js-object :session_id id :receiver_epoch epoch :directory directory
                                         :runtime_state (if idle "idle" "busy"))))
                            (cond
                              ((= operation "probe")
                                (let* ((manager (nativeGet context "sessionManager"))
                                       (title (if (= (nativeTypeOf (nativeGet manager "getSessionName")) "function")
                                                (js-call manager :getSessionName) "Pi")))
                                  (put data :title (if (= (nativeTypeOf title) "string")
                                    (js-call (js-call (Array/from title) :slice 0 64) :join "") "Pi"))))
                              ((= operation "messages")
                                (let* ((rows (recentMessages context))
                                       (cursor (nativeGet body "cursor")) (start 0)
                                       (maximum (nativeGet body "max_records" 32))
                                       (byte-limit (nativeGet body "max_bytes" 524288))
                                       (items (js-array)) (bytes 2) (full false))
                                  (unless (and (Number/isSafeInteger maximum) (> maximum 0) (<= maximum 128)
                                               (Number/isSafeInteger byte-limit) (> byte-limit 0) (<= byte-limit 524288))
                                    (throw (new globalThis.Error "invalid_budget")))
                                  (when cursor
                                    (let ((index (js-call rows :findIndex (lambda (row)
                                                   (= (nativeGet row "native_message_id") cursor)))))
                                      (when (< index 0) (throw (new globalThis.Error "stale_cursor")))
                                      (setq start (1+ index))))
                                  (while (and (not full) (< start (js-length rows)) (< (js-length items) maximum))
                                    (let* ((row (aref rows start)) (size (+ (utf8Bytes (JSON/stringify row)) (if (> (js-length items) 0) 1 0))))
                                      (if (> (+ bytes size) byte-limit)
                                        (if (= (js-length items) 0) (throw (new globalThis.Error "message_budget")) (setq full t))
                                        (progn (js-call items :push row) (setq bytes (+ bytes size) start (1+ start))))))
                                  (put data :items items)
                                  (put data :complete (= start (js-length rows)))
                                  (put data :coverage "partial")
                                  (put data :next_cursor (if (and (< start (js-length rows)) (> (js-length items) 0))
                                    (nativeGet (aref items (1- (js-length items))) "native_message_id") nil))))
                              ((= operation "submit")
                                (unless (and idle (= (nativeTypeOf (nativeGet body "text")) "string")
                                             (> (js-length (nativeGet body "text")) 0)
                                             (<= (utf8Bytes (nativeGet body "text")) 262144)
                                             (= (nativeTypeOf (nativeGet body "dispatch_key")) "string")
                                             (> (js-length (nativeGet body "dispatch_key")) 0)
                                             (<= (js-length (nativeGet body "dispatch_key")) 256))
                                  (throw (new globalThis.Error "not_sendable")))
                                (put record :pending t)
                                (try
                                  (await (js-call pi :sendUserMessage (nativeGet body "text")))
                                  (put data :state "accepted")
                                  (put data :native_receipt_key (str "pi:" (nativeGet body "dispatch_key")))
                                  (catch uncertain (put data :state "unknown"))))
                              (t (throw (new globalThis.Error "unsupported"))))
                            (setq reply (js-object :ok t :data data))))
                        (catch error
                          (setq status 400 reply (js-object :ok false :code "pi_receiver_rejected"))))
                      (when (> (utf8Bytes (JSON/stringify reply)) 1048576)
                        (setq status 413 reply (js-object :ok false :code "pi_receiver_limit")))
                      (try
                        (unless (or (nativeGet response "destroyed") (nativeGet response "writableEnded"))
                          (js-call response :writeHead status (js-object :content-type "application/json" :connection "close"))
                          (js-call response :end (JSON/stringify reply)))
                        (catch disconnected nil))))))
                (put record :server server)
                (put server :maxConnections 8)
                (put server :requestTimeout 5000)
                (put server :headersTimeout 5000)
                (await (new globalThis.Promise (lambda (done failed)
                  (js-call server :once "error" failed)
                  (js-call server :listen socket-path (lambda ()
                    (js-call server :removeListener "error" failed) (funcall done))))))
                (await (chmod socket-path 384))
                (put record :socket_inode (nativeGet (await (lstat socket-path)) "ino"))
                (await (writeFile manifest-path (str (JSON/stringify
                  (js-object :protocolVersion 1 :apiVersion "dj-pi-receiver-v1" :tool "pi"
                    :pid (nativeGet globalThis.process "pid") :token token :socketPath socket-path
                    :sessionId id :nativeNamespace "pi-local" :instanceEpoch epoch :directory directory)) "\n")
                  (js-object :flag "wx" :mode 384)))
                (put record :manifest_inode (nativeGet (await (lstat manifest-path)) "ino"))
                (when (nativeGet (nativeGet context "ui") "notify")
                  (js-call (nativeGet context "ui") :notify (str "DJ receiver: " manifest-path) "info"))
                (catch error (await (funcall closing)) (throw error)))))))
      (js-object :close closing)))
  (export activatePiReceiver))
