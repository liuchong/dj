(module dj.connectors.codex-supervision
  (import "../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout)
  (import "node:child_process" execFileSync spawn)
  (import "node:fs" existsSync)
  (import "node:fs/promises" lstat mkdir)
  (import "node:path" dirname join resolve)
  (import "node:os" homedir)
  (import "node:url" fileURLToPath)
  (defconst appOwnerPath (new globalThis.RegExp "/(?:ChatGPT|Codex)\\.app/Contents/MacOS/(?:ChatGPT|Codex)$"))
  (defconst pipePath (new globalThis.RegExp "^/tmp/codex-app-tools/[a-f0-9-]{36}\\.sock$"))
  (defun defaultProcessHelper ()
    (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../../libexec/dj-process-info"))
  (defun processIdentity (helper pid)
    (JSON/parse (execFileSync helper (js-array (str pid))
      (js-object :encoding "utf8" :timeout 1500 :maxBuffer 4096))))
  (defun appOwner (helper)
    (let* ((process globalThis.process)
           (uid (js-call process :getuid))
           (entry (processIdentity helper (nativeGet process "pid")))
           (parent (processIdentity helper (nativeGet entry "parent")))
           (row parent) (limit 8) (owner nil))
      (while (and row (> limit 0) (not owner))
        (when (= (nativeGet row "uid") uid)
          (if (js-call appOwnerPath :test (nativeGet row "executable"))
            (setq owner row)
            (let ((pid (nativeGet row "parent")))
              (setq row (if (> pid 1) (processIdentity helper pid) nil)))))
        (setq limit (1- limit)))
      (unless owner (throw (new globalThis.Error "codex_native_owner_missing")))
      (let ((bundle (dirname (dirname (nativeGet owner "executable")))))
        (unless (and (= (nativeGet entry "executable") (join bundle "Resources/cua_node/bin/node"))
                     (= (nativeGet parent "executable") (join bundle "Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex")))
          (throw (new globalThis.Error "codex_native_origin_unavailable"))))
      owner))
  (defun ownerPipe (owner)
    (let* ((result (execFileSync "/usr/sbin/lsof" (js-array "-a" "-p" (str (nativeGet owner "pid")) "-U" "-Fn")
                     (js-object :encoding "utf8" :timeout 3000 :maxBuffer 262144)))
           (found (new globalThis.Set)))
      (js-call (js-call result :split "\n") :forEach (lambda (line)
        (let ((candidate (js-call line :slice 1)))
          (when (and (js-call line :startsWith "n") (js-call pipePath :test candidate))
            (js-call found :add candidate)))))
      (unless (= (nativeGet found "size") 1) (throw (new globalThis.Error "codex_native_pipe_unavailable")))
      (nativeGet (js-call (js-call found :values) :next) "value")))
  (defun startLease (helper root owner &optional on-granted)
    ;; Kernel flock releases automatically on helper exit or stdin EOF even after SIGKILL.
    (let ((child (spawn helper (js-array "codex-receiver-lease"
                   (join root (str (nativeGet owner "pid") ".lock")))
                   (js-object :stdio (js-array "pipe" "pipe" "ignore"))))
          (granted false) (closed false))
      (js-call child :once "error" (lambda () (setq closed t)))
      (js-call child :once "exit" (lambda () (setq closed t)))
      (js-call (nativeGet child "stdin") :on "error" (lambda (ignored) nil))
      (js-call (nativeGet child "stdout") :once "data" (lambda (bytes)
        (when (= (aref bytes 0) 1)
          (setq granted t)
          (when on-granted (funcall on-granted)))))
      (js-object :granted (lambda () (and granted (not closed)))
        :closed (lambda () closed) :release (lambda ()
          (try (js-call (nativeGet child "stdin") :end) (catch ignored nil))
          (when (not closed) (try (js-call child :kill) (catch ignored nil)))))))
  (defasync supervise (options activate nativeProbe trace)
    (let* ((helper (or (nativeGet options "process_helper") (defaultProcessHelper)))
           (resolve-owner (or (nativeGet options "app_owner") (lambda () (appOwner helper))))
           (resolve-pipe (or (nativeGet options "owner_pipe") (lambda (current) (ownerPipe current))))
           (acquire-lease (or (nativeGet options "start_lease") (lambda (dir current on-granted) (startLease helper dir current on-granted))))
           (owner (funcall resolve-owner))
           (root (resolve (nativeGet options "root" (join (homedir) ".dj/codex-receivers"))))
           (process globalThis.process)
           (owner-pid (nativeGet owner "pid"))
           (owner-birth (nativeGet owner "birth"))
           (watch-ms (nativeGet options "watch_interval_ms" 1000))
           (probe-ms (nativeGet options "probe_interval_ms" 15000))
           (watchdog-ms (nativeGet options "watchdog_ms" 5000))
           (stop-control (nativeGet options "stop_control"))
           (receiver nil) (lease nil) (leader false) (stopping (and stop-control (= (nativeGet stop-control "stopped") t)))
           (reason (when stopping (or (nativeGet stop-control "reason") "supervisor_stopped")))
           (failure-now nil) (wake-wait nil)
           (parent-pid (nativeGet process "ppid")) (next-owner-check 0) (next-probe 0) (next-activate 0)
           (request-meta (nativeGet options "request_meta"))
           (resolve-caller (nativeGet options "resolve_caller"))
           (wake (lambda () (let ((cb wake-wait)) (when cb (setq wake-wait nil) (funcall cb)))))
           (stop (lambda (&optional why)
             (unless stopping
               (setq stopping t)
               (when why (setq reason why))
               (funcall wake)))))
      (when stop-control (put stop-control :stop stop))
      (await (mkdir root (js-object :recursive t :mode 448)))
      (let ((info (await (lstat root))))
        (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
                     (= (nativeGet info "uid") (js-call process :getuid)) (= (nativeGet info "mode") (+ 16384 448)))
          (throw (new globalThis.Error "private_native_receiver_directory_required"))))
      (js-call process :once "SIGTERM" stop)
      (js-call process :once "SIGINT" stop)
      (await (funcall trace root owner-pid nil "receiver_supervisor_started" nil))
      (try
        (while (and (not stopping) (not (and stop-control (= (nativeGet stop-control "stopped") t))))
          (let ((now (performance/now)))
            (when (or (not (= (nativeGet process "ppid") parent-pid)) (>= now next-owner-check))
              (let ((current (try (funcall resolve-owner) (catch unavailable nil))))
                (unless (and current (= (nativeGet current "pid") owner-pid) (= (nativeGet current "birth") owner-birth))
                  (setq stopping t reason "native_owner_changed")))
              (setq next-owner-check (+ now probe-ms)))
            (unless stopping
              (when (or (not lease) (js-call lease :closed))
                (when receiver (await (js-call receiver :close "receiver_lease_lost")) (setq receiver nil))
                (setq leader false lease (funcall acquire-lease root owner wake)))
              (when (and (not stopping) (js-call lease :granted))
                (unless leader
                  (setq leader t)
                  (await (funcall trace root owner-pid nil "receiver_supervisor_leader" nil)))
                (try
                  (if (and receiver (not (js-call receiver :isClosed)))
                    (when (>= now next-probe)
                      (await (funcall nativeProbe (nativeGet receiver "pipe_path") (nativeGet receiver "caller")))
                      (setq next-probe (+ now probe-ms)))
                    (when (>= now next-activate)
                      (let* ((env-pipe (nativeGet (nativeGet process "env") "CODEX_APP_TOOLS_PIPE_PATH"))
                             (pipe (or (nativeGet options "pipe_path")
                                       (when (and (= (nativeTypeOf env-pipe) "string") (js-call pipePath :test env-pipe) (existsSync env-pipe)) env-pipe)
                                       (funcall resolve-pipe owner)))
                             (meta (if (= (nativeTypeOf resolve-caller) "function")
                                     (await (funcall resolve-caller pipe owner-pid))
                                     request-meta)))
                        (unless meta (throw (new globalThis.Error "native_caller_unavailable")))
                        (setq receiver (await (funcall activate (js-object :root root :owner_pid owner-pid
                          :owner_birth owner-birth :pipe_path pipe
                          :request_meta meta :watchdog_ms watchdog-ms))))
                        (setq next-probe (+ now probe-ms) next-activate 0))))
                  (setq failure-now nil)
                  (catch unavailable
                    (when receiver (await (js-call receiver :close "native_pipe_lost")) (setq receiver nil))
                    (setq next-activate (+ (performance/now) (Math/min 2000 (* watch-ms 2))))
                    (unless failure-now
                      (setq failure-now t)
                      (await (funcall trace root owner-pid nil "receiver_supervisor_retry" "native_registration_unavailable"))))))
              (unless (or stopping (and stop-control (= (nativeGet stop-control "stopped") t)))
                (await (new globalThis.Promise (lambda (done)
                  (let ((timer nil) (finish nil))
                    (setq finish (lambda ()
                      (when timer (nativeClearTimeout timer) (setq timer nil))
                      (setq wake-wait nil)
                      (funcall done)))
                    (setq wake-wait finish timer (nativeSetTimeout finish watch-ms))))))))))
        (finally
          (setq wake-wait nil)
          (when stop-control (put stop-control :stop nil))
          (when receiver (await (js-call receiver :close (or reason "supervisor_stopped"))))
          (when lease (js-call lease :release))
          (await (funcall trace root owner-pid nil "receiver_supervisor_stopped" (or reason (and stop-control (nativeGet stop-control "reason")) "signal")))
          (js-call process :removeListener "SIGTERM" stop)
          (js-call process :removeListener "SIGINT" stop)))))
  (export supervise))
