(module dj.connectors.codex
  (import "../core/native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout nativeSetInterval nativeClearInterval)
  (import "../host/bun/response.eli" readJson)
  (import "./codex-supervision.eli" supervise)
  (import "node:net" createConnection)
  (import "node:http" createServer)
  (import "node:stream" Readable)
  (import "node:fs/promises" mkdir readdir lstat readFile writeFile open chmod unlink rename)
  (import "node:fs" constants)
  (import "node:path" resolve join)
  (import "node:os" homedir userInfo platform)
  (import "node:crypto" randomUUID randomBytes timingSafeEqual)
  (defconst appToolsAllowed (js-array "list_projects" "list_threads" "read_thread" "send_message_to_thread" "create_thread" "set_thread_title" "move_thread_to_project"))
  (defconst activeControls (new globalThis.Map))
  (defun processAlive (pid)
    (try (js-call globalThis.process :kill pid 0) t
      (catch error (not (= (nativeGet error "code") "ESRCH")))))
  (defasync probeSocketDead (path)
    (new globalThis.Promise (lambda (done)
      (let ((socket (createConnection path)) (settled false) (timer nil) (finish nil))
        (setq finish (lambda (dead)
          (unless settled
            (setq settled t)
            (when timer (nativeClearTimeout timer))
            (js-call socket :destroy)
            (funcall done dead))))
        (setq timer (nativeSetTimeout (lambda () (funcall finish false)) 150))
        (js-call socket :once "connect" (lambda () (funcall finish false)))
        (js-call socket :once "error" (lambda (error)
          (funcall finish (js-call (js-array "ECONNREFUSED" "ENOENT") :includes (nativeGet error "code")))))))))
  (defasync cleanupStaleReceivers (root owner-pid active-socket)
    (try
      (let* ((entries (await (readdir root)))
             (json-re (new globalThis.RegExp "^([0-9]+)\\.json$"))
             (sock-re (new globalThis.RegExp "^([0-9]+)(?:-[a-f0-9-]+)?\\.sock$"))
             (index 0))
        (while (< index (js-length entries))
          (let* ((name (aref entries index))
                 (jm (js-call json-re :exec name))
                 (sm (js-call sock-re :exec name)))
            (cond
              (jm
                (let ((pid (globalThis.Number (aref jm 1))))
                  (when (and (not (= pid owner-pid)) (not (processAlive pid)))
                    (try (await (unlink (join root name))) (catch ignored nil)))))
              (sm
                (let ((pid (globalThis.Number (aref sm 1))) (sock (join root name)))
                  (unless (= sock active-socket)
                    (when (or (and (not (= pid owner-pid)) (not (processAlive pid)))
                              (and (= pid owner-pid) (await (probeSocketDead sock))))
                      (try (await (unlink sock)) (catch ignored nil))))))))
          (setq index (1+ index))))
      (catch ignored nil)))
  ;; Load explicitly in the already running Codex native Node tool host. The
  ;; official pipe still authenticates the real signed peer on every request.
  ;; DJ never starts an App Server, impersonates a signature or sends prompt argv.
  (defun pipeCall (path method params)
    (new globalThis.Promise (lambda (done failed)
      (let ((socket (createConnection path)) (buffer (Buffer/alloc 0)) (settled false) (finish nil) (deadline nil))
        (setq finish (lambda (error value)
          (unless settled (setq settled t) (when deadline (nativeClearTimeout deadline)) (js-call socket :destroy)
            (if error (funcall failed error) (funcall done value)))))
        (setq deadline (nativeSetTimeout (lambda () (funcall finish (new globalThis.Error "native_pipe_timeout") nil)) 10000))
        (js-call socket :once "connect" (lambda ()
          (let* ((body (Buffer/from (JSON/stringify (js-object :id 1 :jsonrpc "2.0" :method method :params params))))
                 (header (Buffer/alloc 4)))
            (js-call header :writeUInt32LE (js-length body))
            (js-call socket :write (Buffer/concat (js-array header body))))))
        (js-call socket :on "data" (lambda (chunk)
          (setq buffer (Buffer/concat (js-array buffer chunk)))
          (if (or (> (js-length buffer) 8388612)
                  (and (>= (js-length buffer) 4) (> (js-call buffer :readUInt32LE 0) 8388608)))
            (funcall finish (new globalThis.Error "native_pipe_bound") nil)
            (when (and (>= (js-length buffer) 4) (>= (js-length buffer) (+ 4 (js-call buffer :readUInt32LE 0))))
              (try
                (let ((reply (JSON/parse (js-call (js-call buffer :subarray 4 (+ 4 (js-call buffer :readUInt32LE 0))) :toString "utf8"))))
                  (if (nativeGet reply "error") (funcall finish (new globalThis.Error "native_pipe_rejected") nil)
                    (funcall finish nil (nativeGet reply "result"))))
                (catch invalid (funcall finish (new globalThis.Error "native_pipe_invalid") nil)))))))
        (js-call socket :once "end" (lambda () (funcall finish (new globalThis.Error "native_peer_rejected") nil)))
        (js-call socket :once "error" (lambda (error) (funcall finish error nil)))))))
  (defun toolResult (result)
    (unless (= (nativeGet result "success") t) (throw (new globalThis.Error "native_tool_rejected")))
    (let* ((items (nativeGet result "contentItems"))
           (texts (js-call items :filter (lambda (item) (= (nativeGet item "type") "inputText")))))
      (unless (= (js-length texts) 1) (throw (new globalThis.Error "native_tool_shape")))
      (JSON/parse (nativeGet (aref texts 0) "text"))))
  (defun safeCodexThread (value)
    (let* ((status (nativeGet (nativeGet value "status") "type"))
           (runtime (cond ((= status "idle") "idle") ((= status "active") "busy")
                          ((= status "notLoaded") "idle") (t "unknown"))))
      (js-object :id (nativeGet value "id") :cwd (nativeGet value "cwd")
        :runtime_state runtime :title (nativeGet value "title" ""))))
  (defasync traceReceiver (root owner epoch code reason)
    (try
      (let* ((path (join root "receiver.ndjson"))
             (flags (+ (nativeGet constants "O_APPEND") (nativeGet constants "O_CREAT")
                       (nativeGet constants "O_WRONLY") (nativeGet constants "O_NOFOLLOW" 0)))
             (file (await (open path flags 384))))
        (try
          (let ((info (await (js-call file :stat))))
            (when (and (js-call info :isFile)
                       (= (nativeGet info "uid") (nativeGet (userInfo) "uid"))
                       (= (nativeGet info "mode") (+ 32768 384)))
              (when (>= (nativeGet info "size") 1048576) (await (rename path (str path ".previous"))))
              (await (js-call file :appendFile (str (JSON/stringify (js-object
                :at (js-call (new globalThis.Date) :toISOString) :code code :reason reason
                :owner_pid owner :receiver_pid (nativeGet globalThis.process "pid")
                :epoch epoch)) "\n")))))
          (finally (await (js-call file :close)))))
      (catch unavailable nil)))
  (defasync activateCodexControl (options)
    (let* ((meta (nativeGet options "request_meta")) (turn (nativeGet meta "x-codex-turn-metadata"))
           (caller (js-object :callerSource "codex" :namespace "codex_app" :hostId "local"
             :threadId (nativeGet turn "thread_id") :turnId (nativeGet turn "turn_id")))
           (pipe (nativeGet options "pipe_path")) (creations (new globalThis.Map)) (invoke nil)
           (root (resolve (nativeGet options "root" (join (homedir) ".dj/codex-receivers"))))
           (token (js-call (randomBytes 32) :toString "hex")) (epoch (randomUUID))
           (socket-path (join root (str (nativeGet options "owner_pid") "-" (js-call epoch :slice 0 13) ".sock")))
           (manifest-path (join root (str (nativeGet options "owner_pid") ".json")))
           (staging-path (join root (str ".register-" epoch)))
           (server nil) (socket-inode nil) (watchdog nil) (closed false) (close nil) (handle nil) (reported-error nil)
           (control-key (str root ":" (nativeGet options "owner_pid"))))
      (unless (and (Number/isSafeInteger (nativeGet options "owner_pid")) (> (nativeGet options "owner_pid") 0)
                   (= (nativeTypeOf (nativeGet options "owner_birth")) "string")
                   (> (js-length (nativeGet options "owner_birth")) 0)
                   (= (nativeTypeOf (nativeGet caller "threadId")) "string") (> (js-length (nativeGet caller "threadId")) 0)
                   (= (nativeTypeOf (nativeGet caller "turnId")) "string") (> (js-length (nativeGet caller "turnId")) 0))
        (throw (new globalThis.TypeError "actual Codex native tool request metadata required")))
      (unless pipe
        (let* ((directory (if (= (platform) "linux")
                           (str "/tmp/codex-app-tools-" (nativeGet (userInfo) "uid")) "/tmp/codex-app-tools"))
               (files (await (readdir directory))))
          (unless (= (js-length files) 1) (throw (new globalThis.TypeError "exact native app pipe required")))
          (setq pipe (join directory (aref files 0)))))
      (let ((info (await (lstat pipe))))
        (unless (and (js-call info :isSocket) (= (nativeGet info "uid") (nativeGet (userInfo) "uid")))
          (throw (new globalThis.TypeError "native app pipe ownership changed"))))
      (setq invoke (async (tool args)
        (let ((result (await (pipeCall pipe "tools/call"
                (Object/assign (js-object) caller (js-object :callId (randomUUID) :tool tool :arguments args))))))
          (if (js-call (js-array "set_thread_title" "send_message_to_thread") :includes tool)
            (if (= (nativeGet result "success") t) t (throw (new globalThis.Error "native_tool_rejected")))
            (toolResult result)))))
      (setq close (async (reason)
        (unless closed
          (setq closed t)
          (await (traceReceiver root (nativeGet options "owner_pid") epoch "receiver_closed" (or reason "requested")))
          (when watchdog (nativeClearInterval watchdog) (setq watchdog nil))
          (when (and handle (eq (js-call activeControls :get control-key) handle))
            (js-call activeControls :delete control-key))
          (when server
            (js-call server :closeAllConnections)
            (await (new globalThis.Promise (lambda (done) (js-call server :close done)))))
          ;; The manifest is a replaceable pointer shared by all registrations
          ;; for this App PID. Old owners must never unlink it during close.
          (when socket-inode
            (try
              (let ((info (await (lstat socket-path))))
                (when (= (nativeGet info "ino") socket-inode) (await (unlink socket-path))))
              (catch missing nil))))))
      (await (mkdir root (js-object :recursive t :mode 448)))
      (let ((info (await (lstat root))))
        (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
                     (= (nativeGet info "uid") (nativeGet (userInfo) "uid"))
                     (= (nativeGet info "mode") (+ 16384 448)))
          (throw (new globalThis.TypeError "private native receiver directory required"))))
      (try
        (setq server (createServer (async (request response)
          (let ((status 200) (reply nil))
            (try
              (let* ((headers (nativeGet request "headers")) (auth (nativeGet headers "authorization" "")) (expected (str "Bearer " token)))
                (unless (and (not closed) (= (nativeGet request "method") "POST") (= (nativeGet request "url") "/")
                  (not (nativeGet headers "origin")) (= (Buffer/byteLength auth) (Buffer/byteLength expected))
                  (timingSafeEqual (Buffer/from auth) (Buffer/from expected))) (throw (new globalThis.Error "unauthorized"))))
              (let* ((body (await (readJson (new globalThis.Response (js-call Readable :toWeb request)) 300000)))
                     (operation (nativeGet body "operation")) (key (nativeGet body "key")) (result nil))
                (unless (= (nativeGet body "receiver_epoch") epoch) (throw (new globalThis.Error "native_host_changed")))
                (cond
                  ((= operation "probe")
                    (let* ((id (nativeGet caller "threadId"))
                           (readback (await (funcall invoke "read_thread"
                             (js-object :threadId id :includeTurns false))))
                           (thread (nativeGet readback "thread")))
                      (unless (and (= (nativeGet thread "id") id) (= (nativeGet thread "hostId") "local")
                                   (= (nativeGet thread "kind") "codex"))
                        (throw (new globalThis.Error "native_caller_unavailable")))
                      (setq result (js-object :state "ready"))))
                  ((js-call (js-array "read" "send") :includes operation)
                    (let* ((id (nativeGet body "thread"))
                           (cwd (nativeGet body "directory"))
                           (readback (await (funcall invoke "read_thread"
                             (js-object :threadId id :includeTurns false))))
                           (thread (nativeGet readback "thread")))
                      (unless (and (= (nativeGet thread "id") id) (= (nativeGet thread "kind") "codex")
                                   (= (nativeGet thread "hostId") "local") (= (nativeGet thread "cwd") cwd))
                        (throw (new globalThis.Error "native_target_changed")))
                      (if (= operation "read")
                        (setq result (safeCodexThread thread))
                        (let ((prompt (nativeGet body "text")))
                          (unless (and (= (nativeTypeOf prompt) "string") (> (js-length prompt) 0))
                            (throw (new globalThis.Error "native_input_missing")))
                          (await (funcall invoke "send_message_to_thread" (js-object :threadId id :prompt prompt)))
                          (setq result (js-object :state "accepted"))))))
                  ((= operation "rename")
                    (await (funcall invoke "set_thread_title" (js-object :threadId (nativeGet body "thread") :title (nativeGet body "title"))))
                    (setq result (js-object :state "issued")))
                  ((or (= operation "create") (= operation "lookup_create"))
                    (unless (and (= (nativeTypeOf key) "string") (> (js-length key) 0) (<= (js-length key) 256))
                      (throw (new globalThis.TypeError "native_creation_key")))
                    (setq result (js-call creations :get key))
                    (when (and (not result) (= operation "create"))
                      (unless (< (nativeGet creations "size") 128) (throw (new globalThis.Error "native_creation_bound")))
                      (setq result (js-object :state "unknown")) (js-call creations :set key result)
                      (let* ((content (nativeGet body "content")) (directory (nativeGet body "directory"))
                             (selection (nativeGet body "model_selection"))
                             (projects (nativeGet (await (funcall invoke "list_projects" (js-object))) "projects"))
                             (matches (js-call projects :filter (lambda (project)
                               (and (= (nativeGet project "projectKind") "local") (= (nativeGet project "path") directory)))))
                             (args nil))
                        (unless (and (= (js-length matches) 1) (= (nativeGet content "type") "text")
                          (= (nativeTypeOf (nativeGet content "text")) "string") (> (js-length (js-call (nativeGet content "text") :trim)) 0))
                          (throw (new globalThis.TypeError "native_creation_requires_project_and_content")))
                        (setq args (js-object :prompt (nativeGet content "text") :title (nativeGet body "title" "DJ")
                          :target (js-object :type "project" :projectId (nativeGet (aref matches 0) "projectId") :environment (js-object :type "local"))))
                        (when selection
                          (when (or (nativeGet selection "variant")
                            (and (nativeGet selection "provider_id") (not (= (nativeGet selection "provider_id") "openai"))))
                            (throw (new globalThis.TypeError "native_model_selection")))
                          (when (nativeGet selection "model_id") (put args :model (nativeGet selection "model_id")))
                          (when (nativeGet selection "reasoning_effort") (put args :thinking (nativeGet selection "reasoning_effort"))))
                        ;; The key was reserved before the first await. Concurrent
                        ;; requests and broken replies cannot create a duplicate.
                        (let ((created (await (funcall invoke "create_thread" args))))
                          (when (and (= (nativeTypeOf (nativeGet created "threadId")) "string")
                                     (= (nativeGet created "hostId") "local"))
                            (setq result (js-object :state "ready" :thread_id (nativeGet created "threadId")
                              :initial_input_receipt_key (str "codex-create:" (nativeGet created "threadId"))
                              :directory directory))
                            (js-call creations :set key result)
                            (when (nativeGet body "title")
                              (await (funcall invoke "set_thread_title" (js-object :threadId (nativeGet created "threadId")
                                :title (nativeGet body "title")))))))))
                    (unless result (setq result (js-object :state "unknown"))))
                  ((= operation "app_tools")
                    (let ((method (nativeGet body "method")) (params (nativeGet body "params" (js-object))))
                      (cond
                        ((= method "tools/list")
                          (setq result (await (pipeCall pipe "tools/list" (js-object :threadStartKind "all")))))
                        ((= method "tools/call")
                          (let ((tool (nativeGet params "tool")) (args (nativeGet params "arguments" (js-object))))
                            (unless (and (= (nativeGet params "namespace") "codex_app")
                              (js-call appToolsAllowed :includes tool)
                              (= (nativeTypeOf args) "object") (not (Array/isArray args)))
                              (throw (new globalThis.TypeError "native_control_tool_forbidden")))
                            (setq result (await (pipeCall pipe "tools/call"
                              (Object/assign (js-object) caller (js-object :callId (randomUUID) :tool tool :arguments args)))))))
                        (t (throw (new globalThis.TypeError "native_control_method"))))))
                  (t (throw (new globalThis.TypeError "native_control_operation"))))
                (setq reply (js-object :ok t :data result)))
              (setq reported-error nil)
              (catch error
                (let ((cause (nativeGet error "code" (nativeGet error "message"))))
                  (when (and (not reported-error) (js-call (js-array "ENOENT" "ECONNREFUSED" "ECONNRESET" "native_pipe_timeout" "native_peer_rejected" "native_pipe_rejected" "native_tool_rejected" "native_pipe_invalid") :includes cause))
                    (setq reported-error t)
                    (await (traceReceiver root (nativeGet options "owner_pid") epoch "receiver_native_call_failed" cause))))
                (setq status 400 reply (js-object :ok false :code "native_control_rejected"))))
            (js-call response :writeHead status (js-object :content-type "application/json" :connection "close"))
            (js-call response :end (JSON/stringify reply))))))
        (await (cleanupStaleReceivers root (nativeGet options "owner_pid") socket-path))
        (put server :maxConnections 8) (put server :requestTimeout 15000) (put server :headersTimeout 5000)
        (await (new globalThis.Promise (lambda (done failed)
          (js-call server :once "error" failed) (js-call server :listen socket-path done))))
        (await (chmod socket-path 384)) (setq socket-inode (nativeGet (await (lstat socket-path)) "ino"))
        (await (writeFile staging-path (JSON/stringify (js-object :protocolVersion 1 :tool "codex"
          :apiVersion "dj-native-control" :process_role "native_app_owner" :pid (nativeGet options "owner_pid") :token token
          :processBirth (nativeGet options "owner_birth") :socketPath socket-path :instanceEpoch epoch
          :caller_thread_id (nativeGet caller "threadId")
          :capabilities (js-array "probe" "read" "send" "rename" "create" "lookup_create" "app_tools")))
          (js-object :flag "wx" :mode 384)))
        (await (rename staging-path manifest-path))
        (await (traceReceiver root (nativeGet options "owner_pid") epoch "receiver_registered" "native_host"))
        (setq watchdog (nativeSetInterval (async ()
          (if closed
            (when watchdog (nativeClearInterval watchdog) (setq watchdog nil))
            (let ((reason nil))
              (unless (processAlive (nativeGet options "owner_pid")) (setq reason "owner_exited"))
              (unless reason
                (try
                  (let ((info (await (lstat socket-path))))
                    (unless (= (nativeGet info "ino") socket-inode) (setq reason "socket_replaced")))
                  (catch missing (setq reason "socket_missing"))))
              (unless reason
                (try
                  (let ((current (JSON/parse (await (readFile manifest-path "utf8")))))
                    (unless (= (nativeGet current "instanceEpoch") epoch) (setq reason "registration_replaced")))
                  (catch unreadable
                    (setq reason (if (= (nativeGet unreadable "code") "ENOENT") "registration_missing" "registration_unreadable")))))
              (when (and reason (not closed))
                (try (await (funcall close reason)) (catch ignored nil))))))
          (nativeGet options "watchdog_ms" 15000)))
        (when (and watchdog (nativeGet watchdog "unref")) (js-call watchdog :unref))
        (setq handle (js-object :manifest_path manifest-path :socket_path socket-path :pipe_path pipe :epoch epoch
          :isClosed (lambda () closed) :close close))
        (js-call activeControls :set control-key handle)
        handle
        (catch error
          (try (await (unlink staging-path)) (catch absent nil))
          (await (funcall close)) (throw error)))))
  (defasync ensureCodexControl (options)
    (let* ((root (resolve (nativeGet options "root" (join (homedir) ".dj/codex-receivers"))))
           (key (str root ":" (nativeGet options "owner_pid")))
           (existing (js-call activeControls :get key))
           (pipe (nativeGet options "pipe_path")))
      (if (and existing (not (js-call existing :isClosed))
               (or (not pipe) (= (nativeGet existing "pipe_path") pipe))
               (not (await (probeSocketDead (nativeGet existing "socket_path")))))
        existing
        (progn
          (when existing (try (await (js-call existing :close)) (catch ignored nil)))
          (await (activateCodexControl options))))))
  (defasync superviseCodexControl (options)
    (let* ((meta (nativeGet options "request_meta"))
           (turn (nativeGet meta "x-codex-turn-metadata"))
           (caller (js-object :callerSource "codex" :namespace "codex_app" :hostId "local"
             :threadId (nativeGet turn "thread_id") :turnId (nativeGet turn "turn_id"))))
      (unless (and (= (nativeTypeOf (nativeGet caller "threadId")) "string")
                   (> (js-length (nativeGet caller "threadId")) 0)
                   (= (nativeTypeOf (nativeGet caller "turnId")) "string")
                   (> (js-length (nativeGet caller "turnId")) 0))
        (throw (new globalThis.TypeError "actual Codex native tool request metadata required")))
      (await (supervise options activateCodexControl (async (pipe)
        (let* ((reply (await (pipeCall pipe "tools/call" (Object/assign (js-object) caller
                 (js-object :callId (randomUUID) :tool "read_thread"
                   :arguments (js-object :threadId (nativeGet caller "threadId") :includeTurns false))))))
               (readback (toolResult reply))
               (thread (nativeGet readback "thread")))
          (unless (and (= (nativeGet thread "id") (nativeGet caller "threadId"))
                       (= (nativeGet thread "hostId") "local")
                       (= (nativeGet thread "kind") "codex"))
            (throw (new globalThis.Error "native_caller_unavailable")))
          t)) traceReceiver))))
  (export activateCodexControl ensureCodexControl superviseCodexControl pipeCall toolResult cleanupStaleReceivers traceReceiver))
