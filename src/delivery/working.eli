(module dj.delivery.working
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/types.eli" hashValue addSeconds)
  (import "../application/context.eli" utcNow inTransaction must currentPrincipal requirePermission can safeFields typedRef nativeCallContext)
  (import "../application/write-batch.eli" enqueueWrite)
  (import "../connections/manager.eli" imPort)
  (import "../service/ownership.eli" ownerGuard)
  (defun save (context table row)
    (if (= table "work_marks")
      (let ((revision (nativeGet row "revision")))
        (put row :revision (1+ revision))
        (must (js-call (nativeGet context "repository") :replace table row revision)))
      (must (js-call (nativeGet context "repository") :replace table row))))
  (defun trackWorking (context delivery)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (id (nativeGet delivery "delivery_id"))
      (row (and (= (nativeGet delivery "origin") "subscription_event")
        (js-call (js-call db :query "SELECT payload FROM reply_contexts WHERE delivery_id=? ORDER BY rowid DESC LIMIT 1") :get id)))
      (reply (and row (JSON/parse (nativeGet row "payload"))))
      (address (nativeGet reply "destination")) (connection (and reply (js-call repository :get "connections" (nativeGet address "connection_id"))))
      (port (and connection (imPort context (nativeGet connection "connection_id")))))
      (when (and reply (= (nativeGet connection "platform") "lark") (nativeGet port "reaction")
        (not (js-call repository :get "work_items" id)))
        (let* ((mark-id (hashValue (js-array (nativeGet address "connection_id") (nativeGet reply "identity_revision") (nativeGet reply "native_reply_to") "Typing")))
          (mark (js-call repository :get "work_marks" mark-id)))
          (when (and mark (= (nativeGet mark "state") "done"))
            (put mark :state "pending") (put mark :next_due_at (utcNow context))
            (put mark :attempted_create false) (put mark :reaction_id nil) (put mark :page_token nil)
            (put mark :owned false) (save context "work_marks" mark))
          (unless mark
            (js-call repository :insert "work_marks" (js-object :mark_id mark-id :revision 1 :state "pending" :next_due_at (utcNow context)
              :connection_id (nativeGet address "connection_id") :identity_revision (nativeGet reply "identity_revision")
              :native_message_id (nativeGet reply "native_reply_to") :attempted_create false :owned false)))
          (js-call repository :insert "work_items" (js-object :delivery_id id :mark_id mark-id
            :principal_id (nativeGet reply "recipient_principal_id") :state "active" :expires_at (addSeconds (utcNow context) 1800)))))))
  (defun finishWorking (context delivery-id reason)
    (let* ((repository (nativeGet context "repository")) (item (js-call repository :get "work_items" delivery-id)))
      (when (and item (= (nativeGet item "state") "active"))
        (put item :state "completed") (put item :reason reason) (save context "work_items" item)
        (let ((mark (js-call repository :get "work_marks" (nativeGet item "mark_id"))))
          (when mark (put mark :next_due_at (utcNow context)) (save context "work_marks" mark))))))
  (defun projectWorking (context item)
    (let* ((marked (not (nil? (nativeGet item "mark_id" nil))))
      (resource (if marked item (Object/assign (js-object) item (js-object :principal_id (nativeGet item "recipient_principal_id"))))))
      (if (not (can context "delivery.inspect" resource)) (failure "forbidden")
        (if (not marked) (success (js-object :delivery_id (nativeGet item "delivery_id") :state "not_marked" :cleanup_state "done"))
          (let* ((mark (js-call (nativeGet context "repository") :get "work_marks" (nativeGet item "mark_id")))
            (result (safeFields item (js-array "delivery_id" "state" "reason" "expires_at"))))
            (put result :cleanup_state (nativeGet mark "state" "done"))
            (when (nativeGet mark "last_error") (put result :last_error (nativeGet mark "last_error")))
            (success result))))))
  (defun handleOperation (context operation args)
    (let* ((repository (nativeGet context "repository")) (id (nativeGet args "delivery_id"))
      (delivery (js-call repository :get "deliveries" id)) (item (js-call repository :get "work_items" id))
      (actor (currentPrincipal context))
      (resource (Object/assign (js-object) (or item (js-object :delivery_id id :principal_id (nativeGet delivery "recipient_principal_id")))))
      (permission (and delivery (or (= (nativeGet actor "kind") "operator")
        (= (nativeGet actor "principal_id") (nativeGet delivery "recipient_principal_id")))
        (requirePermission context "delivery.inspect" resource))))
      (if (not (nativeGet permission "ok")) (failure "forbidden")
        (if (= operation "delivery.working")
          (if item (projectWorking context item) (success (js-object :delivery_id id :state "not_marked" :cleanup_state "done")))
          (js-call context :accept (lambda (tx operation-id)
            (finishWorking context id (nativeGet args "reason" "completed"))
            (let ((current (js-call repository :get "work_items" id)))
              (if current (projectWorking context current) (success (js-object :delivery_id id :state "not_marked" :cleanup_state "done")))))
            (lambda (data) (js-array (typedRef "working" id))))))))
  (defasync processMark (context id)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (mark (js-call repository :get "work_marks" id))
      (connection (js-call repository :get "connections" (nativeGet mark "connection_id")))
      (port (imPort context (nativeGet mark "connection_id")))
      (persist (lambda () (enqueueWrite context (lambda () (inTransaction context (lambda (tx)
        (must (ownerGuard context)) (save context "work_marks" mark) (success nil)))))))
      (live nil) (found nil) (complete false) (page (nativeGet mark "page_token" nil)) (pages 0)
      (parameters (js-object :message_id (nativeGet mark "native_message_id"))))
      (try
        (must (ownerGuard context))
        (unless (and (if (= (nativeGet connection "identity") "bot") (nativeGet connection "event_app_id") (nativeGet (nativeGet connection "user_identity") "open_id"))
          (not (nativeGet connection "disabled")) port (nativeGet port "reaction")
          (= (nativeGet connection "identity_revision" (nativeGet connection "revision")) (nativeGet mark "identity_revision")))
          (throw (new globalThis.Error "identity_changed")))
        (setq live (nativeGet (js-call (js-call db :query "SELECT count(*) AS n FROM work_items WHERE state='active' AND expires_at>? AND json_extract(payload,'$.mark_id')=?") :get (utcNow context) id) "n"))
        ;; Persist before the first external effect. A timeout never blindly POSTs again.
        (while (and (< pages 8) (not complete) (not found))
          (put parameters :page_token page)
          (let* ((response (await (js-call port :reaction "list" parameters (nativeCallContext context))))
            (data (nativeGet response "data")))
            (unless (and (nativeGet response "ok") (Array/isArray (nativeGet data "items"))
              (or (= (nativeGet data "has_more") t) (= (nativeGet data "has_more") false)))
              (put mark :native_error (nativeGet (nativeGet response "error") "details"))
              (throw (new globalThis.Error "reaction_list_failed")))
            (setq found (js-call (nativeGet data "items") :find (lambda (reaction)
              (and (= (nativeGet (nativeGet reaction "reaction_type") "emoji_type") "Typing")
                (if (nativeGet mark "reaction_id") (= (nativeGet reaction "reaction_id") (nativeGet mark "reaction_id"))
                  (and (= (nativeGet (nativeGet reaction "operator") "operator_type") (if (= (nativeGet connection "identity") "bot") "app" "user"))
                    (= (nativeGet (nativeGet reaction "operator") "operator_id")
                      (if (= (nativeGet connection "identity") "bot") (nativeGet connection "event_app_id") (nativeGet (nativeGet connection "user_identity") "open_id")))))))))
            (setq page (nativeGet data "page_token" nil) complete (not (= (nativeGet data "has_more") t)) pages (1+ pages))))
        (put mark :page_token (if found nil page))
        (cond
          ((and (not found) (not complete)) (put mark :next_due_at (addSeconds (utcNow context) 1)))
          ((and found (not (nativeGet mark "attempted_create")))
            ;; Never delete an operator's pre-existing Typing reaction.
            (put mark :state "done") (put mark :preexisting t))
          (found
            (put mark :reaction_id (nativeGet found "reaction_id")) (put mark :owned t)
            (if (> live 0) (progn (put mark :state "active") (put mark :next_due_at (addSeconds (utcNow context) 10)))
              (progn
                (put mark :state "removing") (must (await (funcall persist)))
                (put parameters :reaction_id (nativeGet mark "reaction_id"))
                (let ((response (await (js-call port :reaction "delete" parameters (nativeCallContext context)))))
                  (unless (nativeGet response "ok") (put mark :native_error (nativeGet (nativeGet response "error") "details"))))
                ;; Confirm absence on the next sweep, including DELETE timeout/restart.
                (put mark :next_due_at (utcNow context)))))
          ((nativeGet mark "reaction_id") (put mark :state "done") (put mark :removed_at (utcNow context)))
          ((and (> live 0) (not (nativeGet mark "attempted_create")))
            (put mark :attempted_create t) (put mark :state "posting") (must (await (funcall persist)))
            (let* ((response (await (js-call port :reaction "create" parameters (nativeCallContext context))))
              (reaction-id (nativeGet (nativeGet response "data") "reaction_id")))
              (if (and (nativeGet response "ok") reaction-id) (progn (put mark :reaction_id reaction-id) (put mark :owned t))
                (put mark :native_error (nativeGet (nativeGet response "error") "details"))))
            (put mark :next_due_at (utcNow context)))
          ((nativeGet mark "attempted_create")
            (put mark :state "reconciling") (put mark :next_due_at (addSeconds (utcNow context) 30)))
          (t (put mark :state "done")))
        (put mark :last_error nil)
        (catch unavailable
          (put mark :last_error "reaction_cleanup_pending")
          (put mark :next_due_at (addSeconds (utcNow context) 10))))
      (must (await (funcall persist))) (success nil)))
  (defasync processWorking (context)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
      (rows (js-call (js-call db :query "SELECT mark_id FROM work_marks WHERE state<>'done' AND next_due_at<=? ORDER BY next_due_at LIMIT 4") :all (utcNow context))))
      (when (> (js-length rows) 0) (must (await (enqueueWrite context (lambda () (inTransaction context (lambda (tx)
        (must (ownerGuard context))
        (js-call (js-call db :query "UPDATE work_items SET state='completed',payload=json_set(payload,'$.state','completed','$.reason','lease_expired') WHERE state='active' AND expires_at<=?") :run (utcNow context)) (success nil))))))))
      (let ((i 0)) (while (< i (js-length rows)) (await (processMark context (nativeGet (aref rows i) "mark_id"))) (setq i (1+ i))))
      (success nil)))
  (export trackWorking finishWorking handleOperation projectWorking processWorking))
