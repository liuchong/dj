(module dj.delivery.planning-scope
  (import "../core/native.eli" nativeGet nativeTypeOf nativeNullish)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" must)
  (import "../core/limits.eli" limits)
  ;; Mutable working records belong to this event and this synchronous write item.
  ;; They never enter the read-only contribution cache or survive a SAVEPOINT.
  (defun withEventPlans (context event work &optional complete-in-one-turn buffer-deliveries capacity-state)
    (let* ((store (nativeGet context "store"))
      (repository (nativeGet context "repository"))
      (db (nativeGet store "db"))
      (event-id (nativeGet event "event_id"))
      (routes (new globalThis.Map))
      (deliveries (new globalThis.Map))
      (created-records (js-array))
      (pending-route-counts (new globalThis.Map))
      (existing-delivery-seen false)
      (initial-ready (= complete-in-one-turn t))
      (buffered (= buffer-deliveries t))
      (finished false)
      (maximum (nativeGet limits "match_batch_candidates"))
      (global-count nil)
      (active t)
      (assert-active (lambda ()
        (unless (and active (not (and buffered finished)) (js-call store :inTransaction)
          (or (nativeNullish capacity-state) (= (nativeGet capacity-state "active") t)))
          (throw (new globalThis.TypeError "event planning scope is closed"))))))
      (unless (and (js-call store :inTransaction)
        (= (nativeTypeOf event-id) "string")
        (or (nativeNullish complete-in-one-turn)
          (= (nativeTypeOf complete-in-one-turn) "boolean"))
        (or (nativeNullish buffer-deliveries)
          (= (nativeTypeOf buffer-deliveries) "boolean"))
        (= (nativeTypeOf work) "function")
        (not (= (nativeGet (nativeGet work "constructor") "name") "AsyncFunction")))
        (throw (new globalThis.TypeError "event planning requires synchronous transaction work")))
      (unless (or (nativeNullish capacity-state)
        (and buffered (= (nativeTypeOf capacity-state) "object")
          (not (Array/isArray capacity-state))
          (eq (nativeGet capacity-state "store") store)
          (= (nativeGet capacity-state "active") t)
          (or (= (nativeGet capacity-state "count") nil)
            (and (Number/isSafeInteger (nativeGet capacity-state "count"))
              (>= (nativeGet capacity-state "count") 0)))))
        (throw (new globalThis.TypeError "invalid matching capacity scope")))
      (try
        (let* ((planning (Object/freeze (js-object
          :event_id event-id
          :initial_ready initial-ready
          :defer_insert buffered
          :route (lambda (id)
            (assert-active)
            (if (js-call routes :has id)
              (js-call routes :get id)
              (let ((route (js-call repository :get "routes" id)))
                (when (< (nativeGet routes "size") maximum) (js-call routes :set id route))
                route)))
          :delivery (lambda (route-id)
            (assert-active)
            (if (js-call deliveries :has route-id)
              (js-call deliveries :get route-id)
              (if (and buffered (js-call pending-route-counts :has route-id))
                ;; The normal read cache may be full of existing rows. Pending
                ;; rows still belong to this bounded event, not to the database.
                (js-call created-records :find
                  (lambda (delivery) (= (nativeGet delivery "route_id") route-id)))
                (let* ((row (js-call (js-call db :query
                    "SELECT payload FROM deliveries WHERE route_id=? AND event_id=? AND origin='subscription_event'")
                    :get route-id event-id))
                  (delivery (and row (JSON/parse (nativeGet row "payload")))))
                  (when delivery (setq existing-delivery-seen t))
                  (when (< (nativeGet deliveries "size") maximum)
                    (js-call deliveries :set route-id delivery))
                  delivery))))
          :capacity (lambda (route-id)
            (assert-active)
            (when (nativeNullish global-count)
              (setq global-count (+ (if (and capacity-state
                  (not (nativeNullish (nativeGet capacity-state "count"))))
                (nativeGet capacity-state "count")
                (nativeGet (js-call (js-call db :query
                  "SELECT COUNT(*) AS n FROM deliveries WHERE state IN ('ready','deferred','blocked','submitting','unknown')") :get) "n"))
                (if buffered (js-length created-records) 0))))
            (let ((route-count (+ (nativeGet (js-call (js-call db :query
              "SELECT COUNT(*) AS n FROM deliveries INDEXED BY deliveries_route_head WHERE route_id=? AND state IN ('ready','deferred','blocked','submitting','unknown')") :get route-id) "n")
              (if buffered (or (js-call pending-route-counts :get route-id) 0) 0))))
              (if (or (>= global-count (nativeGet limits "global_queue"))
                (>= route-count (nativeGet limits "route_queue")))
                (failure "limit_exceeded") (success nil))))
          :created (lambda (delivery)
            (assert-active)
            (when (>= (js-length created-records) maximum)
              (throw (new globalThis.TypeError "event creation exceeds candidate bound")))
            (unless (= (nativeGet delivery "event_id") event-id)
              (throw (new globalThis.TypeError "event planning cannot own another event")))
            (let ((route-id (nativeGet delivery "route_id")))
              (when (or (js-call deliveries :get route-id)
                (and buffered (js-call pending-route-counts :has route-id)))
                (throw (new globalThis.TypeError "event delivery was already planned")))
              (when (or (js-call deliveries :has route-id)
                (< (nativeGet deliveries "size") maximum))
                (js-call deliveries :set route-id delivery))
              (when buffered (js-call pending-route-counts :set route-id 1)))
            (js-call created-records :push delivery)
            (unless (nativeNullish global-count) (setq global-count (1+ global-count)))
            delivery)
          :finish (lambda (state)
            (assert-active)
            (if buffered
              (progn
                ;; Normalize only this item's new records before their first
                ;; INSERT; old rows remain subject to the original unlock SQL.
                (js-call created-records :forEach (lambda (delivery)
                  (when (or (= (nativeGet delivery "state") "ready")
                    (and (= (nativeGet delivery "state") "blocked")
                      (= (nativeGet delivery "blocked_reason") "routing_incomplete")))
                    (put delivery :state (if (= state "done") "ready" "blocked"))
                    (put delivery :blocked_reason (if (= state "done") nil "routing_incomplete"))
                    (put delivery :revision (if (= state "done") 2 1)))))
                (js-call repository :insertMany "deliveries" created-records)
                (setq finished t)
                (js-call pending-route-counts :clear))
              (when (and initial-ready (not (= state "done")))
                (js-call created-records :forEach (lambda (delivery)
                  (when (= (nativeGet delivery "state") "ready")
                    (put delivery :state "blocked")
                    (put delivery :blocked_reason "routing_incomplete")
                    (put delivery :revision 1)
                    (must (js-call repository :replace "deliveries" delivery)))))))
            (and (= state "done") (or (not initial-ready) existing-delivery-seen))))))
          (result (funcall work planning)))
          (when (= (nativeTypeOf (nativeGet result "then")) "function")
            (throw (new globalThis.TypeError "event planning cannot return a Future")))
          (when (and buffered (not finished) (not (= (nativeGet result "ok") false)))
            (throw (new globalThis.TypeError "buffered event planning requires finish")))
          ;; Publish only after this item's entire synchronous work succeeded.
          ;; A failed item is rolled back by write-batch before its neighbour runs.
          (when capacity-state
            (if (= (nativeGet result "ok") t)
              (if (not (nativeNullish global-count))
                (put capacity-state :count global-count)
                (when (> (js-length created-records) 0)
                  (put capacity-state :count nil)))
              (put capacity-state :count nil)))
          result)
        (catch error
          (when capacity-state (put capacity-state :count nil))
          (throw error))
        (finally
          (setq active false)
          (js-call created-records :splice 0)
          (js-call pending-route-counts :clear)
          (js-call routes :clear)
          (js-call deliveries :clear)))))
  (export withEventPlans))
