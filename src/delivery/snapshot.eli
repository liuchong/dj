(module dj.delivery.snapshot
  (import "../core/native.eli" nativeGet nativeTypeOf)
  (import "../core/types.eli" utf8Bytes)
  (import "./envelope.eli" encodeEnvelope)
  (import "node:crypto" createHash)
  (import "node:zlib" deflateRawSync inflateRawSync)
  (defconst snapshotMaxBytes 1048576)
  (defun digest (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun packEnvelope (envelope)
    (let* ((text (encodeEnvelope envelope snapshotMaxBytes))
      (raw (Buffer/from text "utf8"))
      (compressed (deflateRawSync raw (js-object :level 1))))
      (js-object :codec "deflate-raw-v1" :raw_bytes (nativeGet raw "length")
        :sha256 (digest raw) :data (js-call compressed :toString "base64"))))
  (defun unpackEnvelope (snapshot)
    (if (undefined? (nativeGet snapshot "codec"))
      (progn (encodeEnvelope snapshot snapshotMaxBytes) snapshot)
      (progn
        (unless (and (= (nativeGet snapshot "codec") "deflate-raw-v1")
          (Number/isSafeInteger (nativeGet snapshot "raw_bytes"))
          (> (nativeGet snapshot "raw_bytes") 0)
          (<= (nativeGet snapshot "raw_bytes") snapshotMaxBytes)
          (= (nativeTypeOf (nativeGet snapshot "data")) "string")
          (<= (utf8Bytes (nativeGet snapshot "data")) 1400832))
          (throw (new globalThis.TypeError "invalid envelope snapshot")))
        (let* ((encoded (nativeGet snapshot "data"))
          (bytes (Buffer/from encoded "base64")))
          (unless (= (js-call bytes :toString "base64") encoded)
            (throw (new globalThis.TypeError "invalid envelope snapshot encoding")))
          (let ((raw (inflateRawSync bytes (js-object :maxOutputLength snapshotMaxBytes))))
            (unless (and (= (nativeGet raw "length") (nativeGet snapshot "raw_bytes"))
              (= (digest raw) (nativeGet snapshot "sha256")))
              (throw (new globalThis.TypeError "envelope snapshot integrity mismatch")))
            (let ((envelope (JSON/parse (js-call raw :toString "utf8"))))
              (encodeEnvelope envelope snapshotMaxBytes)
              envelope))))))
  (export packEnvelope unpackEnvelope))
