(module dj.delivery.group-dispatch
  (import "../dispatch/events.eli" eventIdentity)
  (import "../core/native.eli" nativeGet)
  (import "../core/types.eli" addSeconds hashValue)
  (import "../core/errors.eli" success failure)
  (import "../application/context.eli" utcNow inTransaction must agentPort nativeCallContext nextId)
  (import "../subscriptions/groups.eli" groupFor groupMember)
  (import "../routing/group-selection.eli" chooseGroupMember quotaEligible)
  (import "../registry/availability.eli" refreshAvailability currentAvailability)
  (import "../service/ownership.eli" ownerGuard)
  (import "./service.eli" planContribution isContributionEffective)
  (import "node:crypto" randomInt)
  (import "../filtering/policy.eli" evaluateTriggerFilters)
  (defun queueGroupDispatch (tx event version decision)
    (let* ((context (nativeGet tx "context")) (repository (nativeGet context "repository"))
      (id (nativeGet version "subscription_id")) (eid (nativeGet event "event_id"))
      (filtered (nativeGet decision "trigger_filter")))
      (let ((filtered (evaluateTriggerFilters context event)))
        (if (nativeGet filtered "suppressed") (success nil)
          (progn
      (unless (js-call repository :get "group_dispatches" (js-object :subscription_id id :event_id eid))
        (let ((count (js-call (js-call (nativeGet tx "db") :query
          "SELECT COUNT(*) AS total,COALESCE(SUM(subscription_id=?),0) AS own FROM group_dispatches WHERE state IN ('waiting_member','selected','unknown')") :get id)))
          (when (or (>= (nativeGet count "total") 10000) (>= (nativeGet count "own") 1000))
            (must (failure "limit_exceeded")))))
      (let* ((identity (nativeGet (eventIdentity context event) "event_key"))
        (rows (js-call (js-call (nativeGet tx "db") :query
          "SELECT g.payload AS work,e.payload AS event FROM events e JOIN group_dispatches g ON g.event_id=e.event_id AND g.subscription_id=? WHERE e.native_message_id=? AND e.event_kind=? AND e.event_id<>? AND json_extract(g.payload,'$.revision')=? ORDER BY e.ingress_seq LIMIT 64")
          :all id (nativeGet event "native_message_id") (nativeGet event "event_kind") eid (nativeGet version "revision")))
        (prior (js-call rows :find (lambda (row) (= identity (nativeGet (eventIdentity context (JSON/parse (nativeGet row "event"))) "event_key"))))))
      (js-call repository :insertIfAbsent "group_dispatches"
        (js-object :subscription_id id :event_id eid :state (if prior "coalesced" "waiting_member")
          :coalesced_into_event_id (if prior (nativeGet (JSON/parse (nativeGet prior "work")) "event_id") nil) :next_check_at (utcNow context)
          :revision (nativeGet version "revision") :group_id (nativeGet version "group_id")
          :expires_at (addSeconds (nativeGet event "received_at") (nativeGet (nativeGet version "delivery_policy") "ttl_seconds"))
          :agent_id nil :delivery_id nil :inbox_id nil :excluded (js-array) :attempted (js-array)
          :selection_history (js-array) :algorithm (nativeGet (nativeGet version "distribution") "algorithm")))
      (success nil)))))))
  (defun revokeGroupSelection (context work)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (id (nativeGet work "delivery_id")) (inbox (nativeGet work "inbox_id")))
      (when id
        (js-call (js-call db :query "UPDATE contributions SET state='revoked',payload=json_set(payload,'$.state','revoked') WHERE delivery_id=? AND subscription_id=? AND revision=?")
          :run id (nativeGet work "subscription_id") (nativeGet work "revision"))
        (js-call (js-call db :query
          "UPDATE deliveries SET state='cancelled',revision=revision+1,payload=json_set(payload,'$.state','cancelled','$.revision',revision+1) WHERE delivery_id=? AND state IN ('ready','deferred','blocked','failed') AND NOT EXISTS(SELECT 1 FROM contributions c WHERE c.delivery_id=deliveries.delivery_id AND c.state IN ('active','effective'))") :run id))
      (when inbox
        (let ((entry (js-call repository :get "inbox_entries" inbox)))
          (when (and entry (= (nativeGet entry "state") "ready"))
            (put entry :state "revoked") (must (js-call repository :replace "inbox_entries" entry)))))
      (put work :delivery_id nil) (put work :inbox_id nil) (put work :agent_id nil)))
  (defun selectedState (context work)
    (let* ((repository (nativeGet context "repository"))
      (delivery (and (nativeGet work "delivery_id") (js-call repository :get "deliveries" (nativeGet work "delivery_id"))))
      (inbox (and (nativeGet work "inbox_id") (js-call repository :get "inbox_entries" (nativeGet work "inbox_id")))))
      (cond ((or (= (nativeGet delivery "state") "coalesced") (= (nativeGet inbox "state") "coalesced")) "coalesced")
        ((js-call (js-array "accepted" "resolved") :includes (nativeGet delivery "state")) "accepted")
        ((= (nativeGet inbox "state") "consumed") "accepted")
        ((or (js-call (js-array "submitting" "unknown") :includes (nativeGet delivery "state"))
          (= (nativeGet inbox "state") "claimed")) "unknown")
        ((= (nativeGet delivery "state") "failed")
          (let ((row (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
            "SELECT definite_not_sent FROM attempts WHERE delivery_id=? ORDER BY rowid DESC LIMIT 1")
            :get (nativeGet work "delivery_id"))))
            (if (= (nativeGet row "definite_not_sent") 1) "retry" "unknown")))
        ((or (= (nativeGet delivery "state") "cancelled") (= (nativeGet inbox "state") "revoked")) "retry")
        (t "selected"))))
  (defun groupContribution (version expires)
    (js-object :subscription_id (nativeGet version "subscription_id") :revision (nativeGet version "revision")
      :state "active" :expires_at expires :owner_principal_id (nativeGet version "owner_principal_id")
      :group_id (nativeGet version "group_id")))
  (defasync groupCandidates (context work version event)
    (let* ((repository (nativeGet context "repository")) (group (groupFor context (nativeGet version "group_id")))
      (policy (nativeGet (nativeGet version "distribution") "eligibility"))
      (eligible (js-array)) (excluded (js-array))
      (members (nativeGet group "members" (js-array))) (offset 0))
      (while (< offset (js-length members))
        (let ((batch (js-call members :slice offset (+ offset 4))))
          (await (Promise/all (js-call batch :map (async (member)
            (let* ((id (nativeGet member "agent_id")) (agent (js-call repository :get "agents" id))
              (route (and agent (js-call repository :get "routes" (nativeGet agent "route_id"))))
              (session (and route (js-call repository :get "sessions" (nativeGet route "session_key"))))
              (reason nil) (availability nil) (observation nil))
              (cond ((not (groupMember context (nativeGet version "group_id") id)) (setq reason "member_disabled"))
                ((not (and session (isContributionEffective context (groupContribution version (nativeGet work "expires_at")) event agent)))
                  (setq reason "target_not_authorized"))
                (t
                  (let* ((instance (js-call repository :get "instances" (nativeGet session "instance_id")))
                    (port (and instance (agentPort context instance))) (call (nativeCallContext context)))
                    (put call :deadline (Math/min (nativeGet call "deadline")
                      (+ (js-call (nativeGet (nativeGet context "ports") "clock") :monoNow) 2000)))
                    (try (when port (setq observation (await (js-call port :probe session session call))))
                      (catch unavailable (setq observation nil)))
                    (unless (and observation (nativeGet observation "live_receiver")
                      (= (nativeGet observation "native_session_id") (nativeGet session "native_session_id"))
                      (= (nativeGet observation "native_namespace") (nativeGet session "native_namespace"))
                      (= (nativeGet observation "instance_epoch") (nativeGet session "instance_epoch"))
                      (or (= (nativeGet observation "runtime_state") "idle")
                        (and (= (nativeGet observation "runtime_state") "busy")
                          (= (nativeGet (nativeGet version "delivery_policy") "busy") "steer")
                          (= (nativeGet (nativeGet port "capabilities") "message_during_run") "supported"))))
                      (setq reason "receiver_unavailable")))
                  (unless reason
                    (setq availability (if (= (nativeGet policy "quota") "ignore")
                      (currentAvailability context id session) (await (refreshAvailability context agent session))))
                    (unless (quotaEligible (nativeGet policy "quota") (nativeGet availability "state"))
                      (setq reason (if (= (nativeGet availability "state") "exhausted") "quota_exhausted" "quota_unknown"))))))
              (if reason (js-call excluded :push (js-object :agent_id id :reason reason))
                (js-call eligible :push (Object/assign (js-object) member
                  (js-object :scope (hashValue (js-array (nativeGet group "revision") (nativeGet session "instance_epoch") availability))))))))))))
        (setq offset (+ offset 4)))
      (js-object :eligible eligible :excluded excluded :group_revision (nativeGet group "revision" nil))))
  (defun selectAndPlan (context tx current version event candidates)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet tx "db"))
      (status (selectedState context current)) (eligible (nativeGet candidates "eligible"))
      (old-id (nativeGet current "agent_id"))
      (still-eligible (js-call eligible :some (lambda (member) (= (nativeGet member "agent_id") old-id)))))
      (if (and old-id still-eligible (not (= status "retry")))
        (put current :state "selected")
        (progn
          (when old-id
            (when (= status "retry")
              (put current :attempted (js-call (nativeGet current "attempted") :filter (lambda (x) (not (= (nativeGet x "agent_id") old-id)))))
              (js-call (nativeGet current "attempted") :push
                (js-object :agent_id old-id :scope (nativeGet current "selection_scope" nil) :next_try_at (addSeconds (utcNow context) 60))))
            (js-call (nativeGet current "selection_history") :push (js-object
              :agent_id old-id :delivery_id (nativeGet current "delivery_id" nil)
              :inbox_id (nativeGet current "inbox_id" nil) :at (utcNow context) :reason status))
            (when (> (js-length (nativeGet current "selection_history")) 64)
              (put current :selection_history (js-call (nativeGet current "selection_history") :slice -64)))
            (revokeGroupSelection context current))
          (setq eligible (js-call eligible :filter (lambda (member)
            (not (js-call (nativeGet current "attempted") :some (lambda (prior)
              (and (= (nativeGet prior "agent_id") (nativeGet member "agent_id"))
                (> (Date/parse (nativeGet prior "next_try_at")) (Date/parse (utcNow context))))))))))
          (let* ((cursor (js-call repository :get "group_cursors" (nativeGet current "subscription_id")))
            (chosen (chooseGroupMember eligible (nativeGet current "algorithm") (nativeGet cursor "last_agent_id" nil)
              (if (> (js-length eligible) 0) (randomInt (js-length eligible)) 0))))
            (put current :excluded (nativeGet candidates "excluded"))
            (put current :state "waiting_member")
            (when chosen
              (let* ((id (nativeGet chosen "agent_id")) (agent (js-call repository :get "agents" id))
                (resolved (Object/assign (js-object) version (js-object :agent_id id)))
                (existing-row (js-call (js-call db :query
                  "SELECT payload FROM deliveries WHERE route_id=? AND event_id=? AND origin='subscription_event' AND json_extract(payload,'$.distribution_key')=?")
                  :get (nativeGet agent "route_id") (nativeGet event "event_id") (nativeGet current "subscription_id")))
                (existing (and existing-row (JSON/parse (nativeGet existing-row "payload"))))
                (planned nil))
                (when (and existing (js-call (js-array "cancelled" "failed") :includes (nativeGet existing "state")))
                  (unless (js-call (js-call db :query
                    "SELECT 1 FROM attempts WHERE delivery_id=? AND definite_not_sent=0 LIMIT 1") :get (nativeGet existing "delivery_id"))
                    (put existing :dispatch_key (nextId context "dispatch"))
                    (put existing :state "ready") (put existing :revision (1+ (nativeGet existing "revision")))
                    (must (js-call repository :replaceProgress "deliveries" existing))))
                (setq planned (planContribution tx event resolved (js-object :reason_codes (js-array "group_selected"))))
                (when (nativeGet planned "ok")
                  (put current :delivery_id (nativeGet (nativeGet planned "data") "delivery_id" nil))
                  (put current :inbox_id (nativeGet (nativeGet planned "data") "inbox_id" nil))
                  (when (or (nativeGet current "delivery_id") (nativeGet current "inbox_id"))
                    (put current :agent_id id) (put current :selection_scope (nativeGet chosen "scope"))
                    (put current :state "selected")
                    (let ((next (js-object :subscription_id (nativeGet current "subscription_id") :last_agent_id id)))
                      (if cursor (js-call repository :replace "group_cursors" next)
                        (js-call repository :insert "group_cursors" next))))))))))))
  (defasync processGroupDispatches (context)
    (let* ((repository (nativeGet context "repository")) (db (nativeGet (nativeGet context "store") "db"))
      (rows (js-call (js-call db :query
        "SELECT payload FROM group_dispatches WHERE state IN ('waiting_member','selected','unknown') AND next_check_at<=? ORDER BY next_check_at,subscription_id,event_id LIMIT 4") :all (utcNow context))))
      (let ((index 0))
        (while (< index (js-length rows))
          (let* ((work (JSON/parse (nativeGet (aref rows index) "payload")))
            (version (js-call repository :get "subscriptions" (nativeGet work "subscription_id")))
            (event (js-call repository :get "events" (nativeGet work "event_id")))
            (routing (js-call repository :get "routing_work" (nativeGet work "event_id")))
            (status (if (nativeGet work "agent_id") (selectedState context work) "waiting_member"))
            (valid (and version event (= (nativeGet version "state") "active")
              (= (nativeGet version "revision") (nativeGet work "revision"))))
            (terminal (or (not valid) (<= (Date/parse (nativeGet work "expires_at")) (Date/parse (utcNow context)))))
            (candidates (when (and valid (not terminal) (= (nativeGet routing "state") "done")
              (not (js-call (js-array "accepted" "unknown" "coalesced") :includes status)))
              (await (groupCandidates context work version event)))))
            (inTransaction context (lambda (tx)
              (must (ownerGuard context))
              (unless (= (nativeGet (nativeGet context "runtime") "state") "ready") (must (failure "unavailable")))
              (let* ((current (js-call repository :get "group_dispatches" (js-object :subscription_id (nativeGet work "subscription_id") :event_id (nativeGet work "event_id"))))
                (sub (js-call repository :get "subscriptions" (nativeGet work "subscription_id")))
                (actual (if (nativeGet current "agent_id") (selectedState context current) "waiting_member")))
                (when (js-call (js-array "waiting_member" "selected" "unknown") :includes (nativeGet current "state"))
                  (put current :next_check_at (addSeconds (utcNow context) 5))
                  (cond
                    ((js-call (js-array "accepted" "unknown" "coalesced") :includes actual) (put current :state actual))
                    ((or terminal (not (= (nativeGet sub "state") "active"))
                      (not (= (nativeGet sub "revision") (nativeGet current "revision"))))
                      (revokeGroupSelection context current) (put current :state (if valid "expired" "cancelled")))
                    ((and candidates (= (nativeGet candidates "group_revision")
                      (nativeGet (groupFor context (nativeGet current "group_id")) "revision")))
                      (selectAndPlan context tx current sub event candidates)))
                  (must (js-call repository :replace "group_dispatches" current)))
                (success nil)))))
          (setq index (1+ index))))))
  (export queueGroupDispatch processGroupDispatches))
