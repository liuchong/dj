(module dj.delivery.service
  (import "../core/types.eli" sourceReadAction nextRevision addSeconds encodeSeq)
  (import "../dispatch/notifications.eli" notificationSummary)
  (import "../messaging/reply-context.eli" projectReplyAccess)
  (import "../core/native.eli" nativeGet)
  (import "../core/errors.eli" success failure)
  (import "../core/limits.eli" limits)
  (import "../storage/inbox.eli" planPullEntry)
  (import "../application/context.eli"
    utcNow
    nextId
    currentPrincipal
    can
    requirePermission
    must
    typedRef
    nativeCallContext
    agentPort
    safeFields)
  (import "../policy/principals.eli" configuredPrincipal)
  (import "../policy/authorize.eli" authorize targetAllowed)
  (import "../catalog/service.eli" resolveSessionRecord)
  (import "../catalog/records.eli" ensureRoute)
  (import "../catalog/snapshots.eli" openSnapshot resumeSnapshot advanceSnapshot)
  (import "../lifecycle/gates.eli" assertGate assertDirectAdmission supportsNativeEpochRefresh)
  (import "../ingestion/visibility.eli" eventContentAvailable)
  (import "./envelope.eli" encodeAgentInput)
  (import "../triggers/suppression.eli" evaluateTriggerFilters)
  (import "../subscriptions/groups.eli" groupMember)
  (defconst pendingStates
    (js-array "ready" "deferred" "blocked" "submitting" "unknown"))
  (defun queueCapacity (context route-id)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
           (global-count (nativeGet (js-call (js-call db :query
             "SELECT COUNT(*) AS n FROM deliveries WHERE state IN ('ready','deferred','blocked','submitting','unknown')") :get) "n"))
           (route-count (nativeGet (js-call (js-call db :query
             "SELECT COUNT(*) AS n FROM deliveries INDEXED BY deliveries_route_head WHERE route_id=? AND state IN ('ready','deferred','blocked','submitting','unknown')")
             :get route-id) "n")))
      (if (or (>= global-count (nativeGet limits "global_queue"))
              (>= route-count (nativeGet limits "route_queue")))
        (failure "limit_exceeded")
        (success nil))))
  (defun allocateSequence (context route)
    (let* ((db (nativeGet (nativeGet context "store") "db"))
           (row (js-call (js-call db :query
             "UPDATE routes SET next_delivery_seq=next_delivery_seq+1,payload=json_set(payload,'$.next_delivery_seq',CAST(next_delivery_seq+1 AS TEXT)) WHERE route_id=? AND next_delivery_seq<9223372036854775807 RETURNING CAST(next_delivery_seq AS TEXT) AS value")
             :get (nativeGet route "route_id"))))
      (unless row (must (failure "limit_exceeded")))
      (put route :next_delivery_seq (encodeSeq (nativeGet row "value")))
      (nativeGet row "value")))
  (defun minimalDelivery (record)
    (safeFields record (js-array "delivery_id" "origin" "state" "revision" "operation_id")))
  (defun deliveryAccess (context record action)
    (or (can context action record)
        (and (= (nativeGet record "origin") "subscription_event")
             (let* ((repository (nativeGet context "repository"))
                    (sub (and (nativeGet record "target_key")
                              (js-call repository :get "subscriptions" (nativeGet record "target_key"))))
                    (pid (nativeGet (currentPrincipal context) "principal_id")))
               (and sub
                    (= (nativeGet sub "owner_principal_id") pid)
                    (can context action
                      (Object/assign (js-object) record (js-object :owner_principal_id pid))))))))
  (defun isSubscriptionDeliveryEffective (context record event agent &optional read known-route)
    (let* ((repository (nativeGet context "repository"))
           (reader (or read (lambda (table key) (js-call repository :get table key))))
           (subscription (and (nativeGet record "target_key")
                              (if read
                                (funcall read "subscriptions" (nativeGet record "target_key"))
                                (js-call repository :getSubscriptionState (nativeGet record "target_key")))))
           (expected-revision (nativeGet record "subscription_revision" (nativeGet record "revision")))
           (owner (and subscription
                       (configuredPrincipal (nativeGet (nativeGet context "config") "principals")
                         (nativeGet subscription "owner_principal_id"))))
           (recipient (and agent
                           (configuredPrincipal (nativeGet (nativeGet context "config") "principals")
                             (nativeGet agent "recipient_principal_id"))))
           (connection (and event (funcall reader "connections" (nativeGet event "connection_id"))))
           (route (and agent
                       (if known-route
                         (and (= (nativeGet known-route "route_id") (nativeGet agent "route_id")) known-route)
                         (js-call repository :get "routes" (nativeGet agent "route_id")))))
           (target (and route (funcall reader "sessions" (nativeGet route "session_key")))))
      (and subscription
           (if (nativeGet subscription "group_id")
             (groupMember context (nativeGet subscription "group_id") (nativeGet agent "agent_id"))
             (= (nativeGet subscription "agent_id") (nativeGet agent "agent_id")))
           owner
           recipient
           connection
           target
           (targetAllowed recipient target)
           (= (nativeGet agent "state") "registered")
           (= (nativeGet subscription "state") "active")
           (= (nativeGet subscription "revision") expected-revision)
           (> (Date/parse (nativeGet record "expires_at")) (Date/parse (utcNow context)))
           (eventContentAvailable context event connection)
           (= (nativeGet event "identity_revision")
              (nativeGet connection "identity_revision" (nativeGet connection "revision")))
           (nativeGet (authorize owner (sourceReadAction (nativeGet event "conversation"))
             (nativeGet event "conversation") (nativeGet owner "authorization_revision")) "allowed")
           (nativeGet (authorize recipient (sourceReadAction (nativeGet event "conversation"))
             (nativeGet event "conversation") (nativeGet recipient "authorization_revision")) "allowed"))))
  (defun projectDelivery (context record)
    (let ((djReturn1Token (js-object)) (djReturn1Value nil))
      (try
        (unless (nativeGet context "principal")
          (setq djReturn1Value (minimalDelivery record))
          (throw djReturn1Token))
        (let* ((repository (nativeGet context "repository"))
               (route (js-call repository :get "routes" (nativeGet record "route_id")))
               (session (and route (js-call repository :get "sessions" (nativeGet route "session_key"))))
               (event (and (nativeGet record "event_id")
                           (js-call repository :get "events" (nativeGet record "event_id"))))
               (full (if (= (nativeGet record "origin") "direct")
                 (and session (can context "session.send" session))
                 (and event
                      (eventContentAvailable context event)
                      (can context "message.read" (nativeGet event "conversation"))))))
          (unless full
            (progn (setq djReturn1Value (minimalDelivery record)) (throw djReturn1Token)))
          (let ((projection
                  (safeFields record
                    (js-array
                      "delivery_id"
                      "route_id"
                      "origin"
                      "agent_id"
                      "group_id"
                      "target_key"
                      "subscription_revision"
                      "matched_rule_ids"
                      "event_id"
                      "delivery_seq"
                      "state"
                      "revision"
                      "expires_at"
                      "native_ref"
                      "reply_context_id"
                      "operation_id"
                      "principal_id"
                      "context_policy"
                      "delivery_policy"
                      "blocked_reason"
                      "receiver_reason"
                      "notification_key"
                      "coalesced_into"
                      "dispatch_context_id"
                      "identity_binding_id"
                      "submitted_at"
                      "accepted_at"
                      "retryable"
                      "definite_not_sent"
                      "resolution"
                      "evidence_level"))))
            (let ((summary (notificationSummary context record)))
              (when summary (put projection :notification summary)))
            (put projection :session_key (nativeGet route "session_key"))
            (put projection :allowed_actions (nativeGet record "allowed_actions" (js-array)))
            (if event
              (progn
                (put projection :source
                  (Object/assign (js-object :kind "im" :native_message_id (nativeGet event "native_message_id"))
                    (nativeGet event "conversation")))
                (let* ((subscription (and (nativeGet record "target_key")
                                          (js-call repository :get "subscriptions" (nativeGet record "target_key"))))
                       (agent (js-call repository :get "agents" (nativeGet record "agent_id"))))
                  (when (and subscription (can context "subscription.manage" subscription))
                    (put projection :matched
                      (js-object
                        :target_key (nativeGet record "target_key")
                        :subscription_revision (nativeGet record "subscription_revision")
                        :rule_ids (nativeGet record "matched_rule_ids" (js-array))
                        :state
                        (cond
                          ((js-call (js-array "submitting" "accepted" "unknown") :includes (nativeGet record "state")) "effective")
                          ((isSubscriptionDeliveryEffective context record event agent) "effective")
                          ((<= (Date/parse (nativeGet record "expires_at")) (Date/parse (utcNow context))) "expired")
                          (t "revoked")))))))
              (progn
                (put projection :content (nativeGet record "content"))
                (put projection :source (js-object :kind "api"))))
            (put projection :receipts
              (js-call (js-call (js-call (nativeGet (nativeGet context "store") "db") :query
                "SELECT r.payload FROM receipts r JOIN attempts a ON a.attempt_id=r.attempt_id WHERE a.delivery_id=? ORDER BY r.receipt_id LIMIT 1000")
                :all (nativeGet record "delivery_id"))
                :map (lambda (row)
                  (let* ((receipt (JSON/parse (nativeGet row "payload")))
                         (safe (safeFields receipt
                           (js-array "receipt_id" "attempt_id" "kind" "evidence_level" "native_ref" "definite_not_sent" "retryable"))))
                    (put safe :received_at (nativeGet receipt "observed_at"))
                    safe))))
            (projectReplyAccess context projection)))
        (catch djReturn1Error
          (if (eq djReturn1Error djReturn1Token) djReturn1Value (throw djReturn1Error))))))
  (defasync acceptDirect (context args)
    (let ((djReturn2Token (js-object)) (djReturn2Value nil))
      (try
        (let* ((repository (nativeGet context "repository"))
               (target-args args)
               (action (if (nativeGet context "supervision") "session.supervise" "session.send"))
               (alias nil))
          (when (nativeGet args "agent_id")
            (setq alias (js-call repository :get "agents" (nativeGet args "agent_id")))
            (unless (and alias (= (nativeGet alias "state") "registered"))
              (progn (setq djReturn2Value (failure "target_unbound")) (throw djReturn2Token)))
            (let ((route (js-call repository :get "routes" (nativeGet alias "route_id"))))
              (setq target-args (js-object :session_key (nativeGet route "session_key")))))
          (when (nativeGet context "creation")
            (setq target-args (js-object :session_key (nativeGet (nativeGet context "creation") "session_key"))))
          (when (nativeGet context "supervision")
            (setq target-args (js-object :session_key (nativeGet (nativeGet context "supervision") "session_key"))))
          (let ((resolved (resolveSessionRecord context target-args action)))
            (unless (nativeGet resolved "ok")
              (progn (setq djReturn2Value resolved) (throw djReturn2Token)))
            (let* ((session (nativeGet resolved "data"))
                   (instance (js-call repository :get "instances" (nativeGet session "instance_id")))
                   (port (agentPort context instance))
                   (recovery-allowed (and (not (nativeGet context "creation")) (not (nativeGet context "supervision"))
                     (= (nativeGet session "tool") "codex")
                     (= (nativeGet (nativeGet args "delivery_policy") "offline") "hold")
                     (supportsNativeEpochRefresh instance port)))
                   (permission (requirePermission context action session))
                   (id (nextId context "delivery"))
                   (dispatch (nextId context "dispatch"))
                   (envelope
                     (js-object
                       :schema_version 1
                       :kind "external_message"
                       :origin "direct"
                       :delivery_id id
                       :event_id nil
                       :source (js-object :kind "api")
                       :sender
                       (js-object
                         :principal_id (nativeGet (currentPrincipal context) "principal_id")
                         :principal_kind (nativeGet (currentPrincipal context) "kind"))
                       :content (nativeGet args "content")
                       :attachments (js-array)
                       :reply_context_id nil
                       :allowed_actions (js-array))))
              (when (and (nativeGet context "creation")
                         (not (= (nativeGet session "instance_epoch") (nativeGet (nativeGet context "creation") "instance_epoch"))))
                (setq djReturn2Value (failure "stale_reference"))
                (throw djReturn2Token))
              (unless (nativeGet permission "ok")
                (progn (setq djReturn2Value permission) (throw djReturn2Token)))
              (unless port
                (progn (setq djReturn2Value (failure "unsupported")) (throw djReturn2Token)))
              (let ((gate (assertDirectAdmission (nativeGet context "store") (nativeGet instance "instance_id")
                            (nativeGet session "instance_epoch") recovery-allowed)))
                (unless (nativeGet gate "ok")
                  (progn (setq djReturn2Value gate) (throw djReturn2Token))))
              (let ((maximum (nativeGet (nativeGet port "capabilities") "max_input_frame_bytes")))
                (when (and maximum
                           (> (nativeGet (encodeAgentInput (nativeGet session "tool") envelope dispatch) "frame_bytes") maximum))
                  (progn (setq djReturn2Value (failure "limit_exceeded")) (throw djReturn2Token))))
              (unless recovery-allowed
               (try
                (let ((observation (await (js-call port :probe session session (nativeCallContext context)))))
                  (when (and (nativeGet observation "instance_epoch")
                             (not (= (nativeGet observation "instance_epoch") (nativeGet session "instance_epoch"))))
                    (progn (setq djReturn2Value (failure "stale_reference")) (throw djReturn2Token)))
                  (when (= (nativeGet observation "runtime_state") "incompatible")
                    (progn (setq djReturn2Value (failure "incompatible")) (throw djReturn2Token))))
                (catch error (when (eq error djReturn2Token) (throw error)) nil)))
              (js-call context :accept
                (lambda (tx operation-id)
                  (let ((djReturn3Token (js-object)) (djReturn3Value nil))
                    (try
                      (let* ((current (js-call repository :get "sessions" (nativeGet session "session_key")))
                             (gate (assertDirectAdmission tx (nativeGet current "instance_id")
                               (nativeGet session "instance_epoch") recovery-allowed)))
                        (unless (= (nativeGet current "instance_epoch") (nativeGet session "instance_epoch"))
                          (setq djReturn3Value (failure "stale_reference")) (throw djReturn3Token))
                        (unless (nativeGet gate "ok")
                          (progn (setq djReturn3Value gate) (throw djReturn3Token)))
                        (unless (can context action current)
                          (progn (setq djReturn3Value (failure "forbidden")) (throw djReturn3Token)))
                        (let* ((route (ensureRoute context current))
                               (capacity (queueCapacity context (nativeGet route "route_id"))))
                          (unless (nativeGet capacity "ok")
                            (progn (setq djReturn3Value capacity) (throw djReturn3Token)))
                          (let ((record
                                  (js-object
                                    :delivery_id id
                                    :route_id (nativeGet route "route_id")
                                    :origin "direct"
                                    :principal_id (nativeGet (currentPrincipal context) "principal_id")
                                    :operation_id operation-id
                                    :agent_id (if alias (nativeGet alias "agent_id") nil)
                                    :event_id nil
                                    :session_key (nativeGet current "session_key")
                                    :delivery_seq (allocateSequence context route)
                                    :state "ready"
                                    :revision 1
                                    :expires_at (addSeconds (utcNow context) (nativeGet (nativeGet args "delivery_policy") "ttl_seconds"))
                                    :content (nativeGet args "content")
                                    :delivery_policy (nativeGet args "delivery_policy")
                                    :dispatch_key dispatch
                                    :authorization_revision (nativeGet (currentPrincipal context) "authorization_revision")
                                    :reply_context_id nil
                                    :allowed_actions (js-array))))
                            (when (nativeGet context "supervision")
                              (put record :supervision_key (nativeGet (nativeGet context "supervision") "session_key"))
                              (put record :supervision_generation (nativeGet (nativeGet context "supervision") "generation")))
                            (js-call repository :insert "deliveries" record)
                            (success (projectDelivery context record)))))
                      (catch djReturn3Error
                        (if (eq djReturn3Error djReturn3Token) djReturn3Value (throw djReturn3Error))))))
                (lambda (data) (js-array (typedRef "delivery" (nativeGet data "delivery_id"))))))))
        (catch djReturn2Error
          (if (eq djReturn2Error djReturn2Token) djReturn2Value (throw djReturn2Error))))))
  (defun supersedePendingGroupSelections (context db event agent-id)
    (let ((repository (nativeGet context "repository"))
          (rows (js-call (js-call db :query
            "SELECT g.payload FROM group_dispatches g JOIN events e ON e.event_id=g.event_id WHERE g.state='selected' AND json_extract(g.payload,'$.agent_id')=? AND (e.event_id=? OR (e.native_message_id=? AND e.event_kind=?))")
            :all agent-id (nativeGet event "event_id") (nativeGet event "native_message_id") (nativeGet event "event_kind"))))
      (js-call rows :forEach (lambda (row)
        (let* ((work (JSON/parse (nativeGet row "payload")))
               (del-id (nativeGet work "delivery_id"))
               (inb-id (nativeGet work "inbox_id"))
               (del (and del-id (js-call repository :get "deliveries" del-id)))
               (inb (and inb-id (js-call repository :get "inbox_entries" inb-id)))
               (revoked false))
          (when (and del (js-call (js-array "ready" "deferred" "blocked") :includes (nativeGet del "state")))
            (js-call (js-call db :query
              "UPDATE deliveries SET state='cancelled',revision=revision+1,payload=json_set(payload,'$.state','cancelled','$.revision',revision+1) WHERE delivery_id=? AND state IN ('ready','deferred','blocked')")
              :run del-id)
            (setq revoked t))
          (when (and inb (= (nativeGet inb "state") "ready"))
            (put inb :state "revoked")
            (must (js-call repository :replace "inbox_entries" inb))
            (setq revoked t))
          (when revoked
            (put work :delivery_id nil)
            (put work :inbox_id nil)
            (put work :agent_id nil)
            (put work :state "waiting_member")
            (put work :next_check_at (utcNow context))
            (must (js-call repository :replace "group_dispatches" work))))))))
  (defun planDelivery (tx event version decision &optional read planning)
    (let ((djReturn4Token (js-object)) (djReturn4Value nil))
      (try
        (let* ((context (nativeGet tx "context"))
               (repository (nativeGet context "repository"))
               (db (nativeGet tx "db"))
               (reader (or read (lambda (table key) (js-call repository :get table key))))
               (agent (funcall reader "agents" (nativeGet version "agent_id")))
               (route (and agent
                           (if planning
                             (js-call planning :route (nativeGet agent "route_id"))
                             (js-call repository :get "routes" (nativeGet agent "route_id")))))
               (plan
                 (js-object
                   :target_key (nativeGet version "target_key")
                   :subscription_revision (nativeGet version "revision")
                   :matched_rule_ids (nativeGet decision "matched_rule_ids" (js-array))
                   :context_policy (or (nativeGet decision "context_policy") (nativeGet version "context_policy"))
                   :delivery_policy (nativeGet version "delivery_policy")
                   :instruction_policies (nativeGet decision "instruction_policies" (js-array))
                   :expires_at (addSeconds (nativeGet event "received_at")
                     (nativeGet (nativeGet version "delivery_policy") "ttl_seconds"))
                   :owner_principal_id (nativeGet version "owner_principal_id")
                   :recipient_principal_id (nativeGet agent "recipient_principal_id")
                   :group_id (nativeGet version "group_id" nil))))
          (when (and planning (not (= (nativeGet planning "event_id") (nativeGet event "event_id"))))
            (throw (new globalThis.TypeError "event planning identity mismatch")))
          (let ((filtered (if (and planning (nativeGet planning "trigger_filter"))
                            (nativeGet planning "trigger_filter")
                            (evaluateTriggerFilters context event))))
            (when (nativeGet filtered "suppressed")
              (put decision :trigger_filter filtered)
              (put decision :reason_codes
                (js-call (or (nativeGet decision "reason_codes") (js-array)) :concat (js-array "trigger_suppressed")))
              (setq djReturn4Value (success (js-object :suppressed t)))
              (throw djReturn4Token)))
          (unless (isSubscriptionDeliveryEffective context plan event agent reader route)
            (progn (setq djReturn4Value (success nil)) (throw djReturn4Token)))
          (when (= (nativeGet version "delivery_mode" "push") "pull")
            (let ((pulled (planPullEntry context event plan agent)))
              (when (and (nativeGet pulled "ok")
                         (nativeGet pulled "data")
                         (not planning)
                         (not (nativeGet version "group_id")))
                (supersedePendingGroupSelections context db event (nativeGet agent "agent_id")))
              (setq djReturn4Value pulled)
              (throw djReturn4Token)))
          (let* ((distribution-key (if (nativeGet version "group_id") (nativeGet version "target_key") ""))
                 (existing (and (not planning)
                   (js-call (js-call db :query
                     "SELECT payload FROM deliveries WHERE route_id=? AND event_id=? AND origin='subscription_event' AND COALESCE(json_extract(payload,'$.distribution_key'),'')=?")
                     :get (nativeGet route "route_id") (nativeGet event "event_id") distribution-key)))
                 (delivery (if planning
                   (js-call planning :delivery (nativeGet route "route_id"))
                   (and existing (JSON/parse (nativeGet existing "payload"))))))
            (if delivery
              (when (and (not planning)
                         (js-call (js-array "ready" "deferred" "blocked") :includes (nativeGet delivery "state")))
                (Object/assign delivery plan (js-object :agent_id (nativeGet agent "agent_id")))
                (must (js-call repository :replace "deliveries" delivery)))
              (progn
                (let ((capacity (if planning
                                  (js-call planning :capacity (nativeGet route "route_id"))
                                  (queueCapacity context (nativeGet route "route_id")))))
                  (unless (nativeGet capacity "ok")
                    (progn (setq djReturn4Value capacity) (throw djReturn4Token))))
                (setq delivery
                  (Object/assign (js-object) plan
                    (js-object
                      :delivery_id (nextId context "delivery")
                      :route_id (nativeGet route "route_id")
                      :origin "subscription_event"
                      :principal_id nil
                      :operation_id nil
                      :agent_id (nativeGet agent "agent_id")
                      :event_id (nativeGet event "event_id")
                      :session_key (nativeGet route "session_key")
                      :delivery_seq (allocateSequence context route)
                      :state (if (nativeGet planning "initial_ready" false) "ready" "blocked")
                      :blocked_reason (if (nativeGet planning "initial_ready" false) nil "routing_incomplete")
                      :revision (if (nativeGet planning "initial_ready" false) 2 1)
                      :reply_context_id nil
                      :allowed_actions (js-array)
                      :dispatch_key (nextId context "dispatch"))))
                (when (nativeGet version "group_id")
                  (put delivery :distribution_key (nativeGet version "target_key")))
                (unless (nativeGet planning "defer_insert" false)
                  (js-call repository :insert "deliveries" delivery))
                (when planning (js-call planning :created delivery))))
            (when (and delivery (not planning) (not (nativeGet version "group_id")))
              (supersedePendingGroupSelections context db event (nativeGet agent "agent_id")))
            (success delivery)))
        (catch djReturn4Error
          (if (eq djReturn4Error djReturn4Token) djReturn4Value (throw djReturn4Error))))))
  (defun controlDelivery (context operation args)
    (let ((djReturn5Token (js-object)) (djReturn5Value nil))
      (try
        (let* ((repository (nativeGet context "repository"))
               (record (js-call repository :get "deliveries" (nativeGet args "delivery_id")))
               (action (if (= operation "delivery.resolve") operation "delivery.manage")))
          (unless (and record (deliveryAccess context record action))
            (progn (setq djReturn5Value (failure "forbidden")) (throw djReturn5Token)))
          (let ((permission (requirePermission context action
                  (if (can context action record)
                    record
                    (Object/assign (js-object) record
                      (js-object :owner_principal_id (nativeGet (currentPrincipal context) "principal_id")))))))
            (unless (nativeGet permission "ok")
              (progn (setq djReturn5Value permission) (throw djReturn5Token))))
          (js-call context :accept
            (lambda (tx operation-id)
              (let ((djReturn6Token (js-object)) (djReturn6Value nil))
                (try
                  (let* ((current (js-call repository :get "deliveries" (nativeGet record "delivery_id")))
                         (state (nativeGet current "state")))
                    (unless (= operation "delivery.reconcile")
                      (unless (= (nativeGet current "revision") (nativeGet args "expected_revision"))
                        (progn (setq djReturn6Value (failure "revision_conflict")) (throw djReturn6Token))))
                    (cond
                      ((= operation "delivery.reconcile")
                        (put current :reconcile_requested t)
                        (put current :reconcile_principal_id (nativeGet (currentPrincipal context) "principal_id")))
                      ((= operation "delivery.cancel")
                        (when (js-call (js-array "submitting" "unknown") :includes state)
                          (setq djReturn6Value (failure "delivery_unknown" (js-object :effect_state "unknown")))
                          (throw djReturn6Token))
                        (if (js-call (js-array "ready" "deferred" "blocked") :includes state)
                          (if (= (nativeGet current "origin") "direct")
                            (put current :state "cancelled")
                            (let* ((principal (currentPrincipal context))
                                   (sub (and (nativeGet current "target_key")
                                             (js-call repository :get "subscriptions" (nativeGet current "target_key"))))
                                   (allowed (or (= (nativeGet principal "kind") "operator")
                                                (= (nativeGet current "owner_principal_id") (nativeGet principal "principal_id"))
                                                (and sub (= (nativeGet sub "owner_principal_id") (nativeGet principal "principal_id"))))))
                              (unless allowed
                                (progn (setq djReturn6Value (failure "forbidden")) (throw djReturn6Token)))
                              (put current :state "cancelled")))
                          (progn
                            (setq djReturn6Value
                              (success (projectDelivery context current) (js-object :warnings (js-array "already_submitted"))))
                            (throw djReturn6Token))))
                      ((= operation "delivery.retry")
                        (unless (and (= state "failed")
                                     (= (nativeGet current "definite_not_sent") t)
                                     (= (nativeGet current "retryable") t))
                          (setq djReturn6Value
                            (failure "delivery_unknown" (js-object :effect_state (if (= state "unknown") "unknown" "none"))))
                          (throw djReturn6Token))
                        (let* ((route (js-call repository :get "routes" (nativeGet current "route_id")))
                               (session (js-call repository :get "sessions" (nativeGet route "session_key"))))
                          (when (and (= (nativeGet current "origin") "direct")
                                     (not (can context "session.send" session)))
                            (progn (setq djReturn6Value (failure "forbidden")) (throw djReturn6Token)))
                          (let ((capacity (queueCapacity context (nativeGet route "route_id"))))
                            (unless (nativeGet capacity "ok")
                              (progn (setq djReturn6Value capacity) (throw djReturn6Token))))
                          (must (assertGate tx (nativeGet session "instance_id") (nativeGet session "instance_epoch") "open")))
                        (put current :state "ready")
                        (put current :dispatch_key (nextId context "dispatch"))
                        (put current :definite_not_sent false)
                        (put current :retryable false))
                      ((= operation "delivery.resolve")
                        (unless (= state "unknown")
                          (progn (setq djReturn6Value (failure "revision_conflict")) (throw djReturn6Token)))
                        (put current :state "resolved")
                        (put current :resolution (nativeGet args "resolution"))
                        (put current :reason (nativeGet args "reason"))
                        (put current :evidence_level "manual")
                        (let ((route (js-call repository :get "routes" (nativeGet current "route_id"))))
                          (when (= (nativeGet route "unknown_delivery_id") (nativeGet current "delivery_id"))
                            (put route :unknown_delivery_id nil)
                            (must (js-call repository :replace "routes" route))))))
                    (put current :revision (nextRevision (nativeGet current "revision")))
                    (must (js-call repository :replace "deliveries" current))
                    (success (projectDelivery context current)))
                  (catch djReturn6Error
                    (if (eq djReturn6Error djReturn6Token) djReturn6Value (throw djReturn6Error))))))
            (js-array (typedRef "delivery" (nativeGet record "delivery_id")))))
        (catch djReturn5Error
          (if (eq djReturn5Error djReturn5Token) djReturn5Value (throw djReturn5Error))))))
  (defun listDeliveries (context args)
    (let ((djReturn7Token (js-object)) (djReturn7Value nil))
      (try
        (let* ((filters (nativeGet args "filters" (js-object)))
               (repository (nativeGet context "repository"))
               (opened (if (nativeGet args "cursor")
                 (resumeSnapshot context (nativeGet args "cursor") filters args "delivery_id_asc")
                 (openSnapshot context filters args "delivery_id_asc"))))
          (unless (nativeGet opened "ok")
            (progn (setq djReturn7Value opened) (throw djReturn7Token)))
          (let* ((snapshot (nativeGet opened "data"))
                 (options (js-object :limit 1000))
                 (last-key (nativeGet snapshot "last_scan_key"))
                 (items (js-array))
                 (keys (js-array))
                 (index 0)
                 (rows nil))
            (when last-key (put options :after_key last-key))
            (setq rows (js-call repository :page "deliveries" options))
            (while (and (< index (js-length rows)) (< (js-length items) (nativeGet args "limit" 50)))
              (let ((record (aref rows index)))
                (setq last-key (nativeGet record "delivery_id"))
                (when (and (deliveryAccess context record "delivery.inspect")
                           (js-call (Object/keys filters) :every
                             (lambda (field) (= (nativeGet filters field) (nativeGet record field)))))
                  (js-call items :push (projectDelivery context record))
                  (js-call keys :push (js-object :resource_key last-key))))
              (setq index (1+ index)))
            (advanceSnapshot context snapshot
              (js-object
                :items items
                :result_keys keys
                :next_scan_key last-key
                :complete (and (= index (js-length rows)) (< (js-length rows) 1000))
                :coverage_complete t))))
        (catch djReturn7Error
          (if (eq djReturn7Error djReturn7Token) djReturn7Value (throw djReturn7Error))))))
  (defasync handleOperation (context operation args)
    (let ((djReturn8Token (js-object)) (djReturn8Value nil))
      (try
        (cond
          ((= operation "session.send") (await (acceptDirect context args)))
          ((= operation "delivery.list") (listDeliveries context args))
          ((= operation "delivery.get")
            (let ((record (js-call (nativeGet context "repository") :get "deliveries" (nativeGet args "delivery_id"))))
              (unless (and record (deliveryAccess context record "delivery.inspect"))
                (progn (setq djReturn8Value (failure "forbidden")) (throw djReturn8Token)))
              (success (projectDelivery context record))))
          ((js-call (js-array "delivery.reconcile" "delivery.retry" "delivery.cancel" "delivery.resolve") :includes operation)
            (controlDelivery context operation args))
          (t (failure "invalid_argument")))
        (catch djReturn8Error
          (if (eq djReturn8Error djReturn8Token) djReturn8Value (throw djReturn8Error))))))
  (export
    acceptDirect
    planDelivery
    queueCapacity
    allocateSequence
    isSubscriptionDeliveryEffective
    projectDelivery
    deliveryAccess
    handleOperation))
