(module lark.http
  (import "./native.eli" nativeGet nativeTypeOf NativeNumber nativeSetTimeout nativeClearTimeout)
  (defconst methods (Object/freeze (js-array "GET" "POST" "PUT" "PATCH" "DELETE" "HEAD")))
  (defun apiUrl (brand path &optional query)
    (unless (js-call (js-array "lark" "feishu") :includes brand)
      (throw (new globalThis.TypeError "unknown Lark brand")))
    (unless (and (= (nativeTypeOf path) "string")
      (js-call path :startsWith "/open-apis/")
      (not (js-call (new globalThis.RegExp "[\\\\#\\x00-\\x20]") :test path)))
      (throw (new globalThis.TypeError "expected official /open-apis/ path")))
    (when (js-call (new globalThis.RegExp "(?:^|/)(?:\\.|%2e){1,2}(?:/|[?]|$)|%2f|%5c" "i") :test (aref (js-call path :split "?") 0))
      (throw (new globalThis.TypeError "invalid API path segments")))
    (let* ((base (if (= brand "feishu") "https://open.feishu.cn" "https://open.larksuite.com"))
      (url (new globalThis.URL path base)))
      (unless (and (= (nativeGet url "origin") base)
        (js-call (nativeGet url "pathname") :startsWith "/open-apis/")
        (not (js-call (new globalThis.RegExp "(?:^|/)(?:\\.|%2e){1,2}(?:/|$)|%2f|%5c" "i") :test (nativeGet url "pathname"))))
        (throw (new globalThis.TypeError "invalid API path")))
      (when query
        (unless (and (= (nativeTypeOf query) "object") (not (Array/isArray query)))
          (throw (new globalThis.TypeError "query must be an object")))
        (js-call (Object/entries query) :forEach (lambda (entry)
          (let ((key (aref entry 0)) (values (if (Array/isArray (aref entry 1)) (aref entry 1) (js-array (aref entry 1)))))
            (js-call (nativeGet url "searchParams") :delete key)
            (js-call values :forEach (lambda (value)
              (unless (or (eq value nil) (undefined? value))
                (unless (or (= (nativeTypeOf value) "string") (= (nativeTypeOf value) "boolean")
                  (and (= (nativeTypeOf value) "number") (Number/isFinite value)))
                  (throw (new globalThis.TypeError "query values must be scalars")))
                (js-call (nativeGet url "searchParams") :append key (str value)))))))))
      (js-call url :toString)))
  (defasync readBytes (response maximum)
    (let* ((stream (nativeGet response "body")) (declared (js-call (nativeGet response "headers") :get "content-length"))
      (chunks (js-array)) (size 0) (reader nil))
      (when (and declared (> (NativeNumber declared) maximum))
        (when stream (await (js-call stream :cancel)))
        (throw (new globalThis.RangeError "Lark response exceeds byte limit")))
      (if (not stream) (Buffer/alloc 0)
        (progn
          (setq reader (js-call stream :getReader))
          (try
            (let ((done false))
              (while (not done)
                (let ((part (await (js-call reader :read))))
                  (setq done (nativeGet part "done"))
                  (unless done
                    (setq size (+ size (js-length (nativeGet part "value"))))
                    (when (> size maximum) (throw (new globalThis.RangeError "Lark response exceeds byte limit")))
                    (js-call chunks :push (Buffer/from (nativeGet part "value")))))))
            (Buffer/concat chunks size)
            (finally
              (try (await (js-call reader :cancel)) (catch ignored nil))
              (js-call reader :releaseLock)))))))
  (defun requestBody (spec headers)
    (let ((body (nativeGet spec "body")) (form (nativeGet spec "form")) (raw (nativeGet spec "raw")))
      (when (> (+ (if (object-has? spec "body") 1 0) (if form 1 0) (if raw 1 0)) 1)
        (throw (new globalThis.TypeError "body, form and raw are exclusive")))
      (cond
        (form
          (unless (and (= (nativeTypeOf form) "object") (not (Array/isArray form)))
            (throw (new globalThis.TypeError "form must be an object")))
          (let ((data (new globalThis.FormData)))
            (js-call (Object/entries form) :forEach (lambda (entry)
              (let ((key (aref entry 0)) (value (aref entry 1)))
                (if (js* "value instanceof globalThis.Blob")
                  (js-call data :append key value (nativeGet value "name" "upload.bin"))
                  (if (or (= (nativeTypeOf value) "string") (= (nativeTypeOf value) "number") (= (nativeTypeOf value) "boolean"))
                    (js-call data :append key (str value))
                    (throw (new globalThis.TypeError "form values must be scalars or Blob/File"))))))) data))
        (raw (unless (or (js* "raw instanceof globalThis.Uint8Array") (js* "raw instanceof globalThis.Blob") (= (nativeTypeOf raw) "string"))
          (throw (new globalThis.TypeError "raw must be bytes, Blob or text"))) raw)
        ((object-has? spec "body")
          (js-call headers :set "content-type" "application/json; charset=utf-8") (JSON/stringify body))
        (t undefined))))
  (defun createHttp (brand host)
    (let ((active (new globalThis.Set)) (closed false))
      (js-object
        :request (async (spec bearer context)
          (when closed (throw (new globalThis.Error "Lark client closed")))
          (let* ((method (nativeGet spec "method" "GET"))
            (url (apiUrl brand (nativeGet spec "path") (nativeGet spec "query")))
            (headers (new globalThis.Headers)) (supplied (nativeGet spec "headers" (js-object)))
            (maximum (nativeGet spec "max_response_bytes" 1048576))
            (mode (nativeGet spec "response_mode" "json"))
            (controller (new globalThis.AbortController)) (parent (nativeGet context "abort_signal"))
            (abort (lambda () (js-call controller :abort))) (timer nil)
            (remaining (Math/min (nativeGet spec "timeout_ms" 15000)
              (- (nativeGet context "deadline" (+ (js-call host :monoNow) 15000)) (js-call host :monoNow)))))
            (unless (and (js-call methods :includes method) (js-call (js-array "json" "text" "bytes") :includes mode)
              (Number/isSafeInteger maximum) (> maximum 0) (<= maximum 536870912)
              (Number/isFinite remaining) (> remaining 0))
              (throw (new globalThis.TypeError "invalid request method, mode or budget")))
            (js-call (Object/entries supplied) :forEach (lambda (entry)
              (let ((key (js-call (aref entry 0) :toLowerCase)))
                (unless (js-call (js-array "accept" "content-type" "content-disposition" "range" "if-match" "if-none-match" "x-lark-request-id") :includes key)
                  (throw (new globalThis.TypeError "header is not caller controlled")))
                (js-call headers :set key (aref entry 1)))))
            (when bearer (js-call headers :set "authorization" (str "Bearer " bearer)))
            (let* ((body (requestBody spec headers))
              (options (js-object :method method :headers (Object/fromEntries (js-call headers :entries)) :redirect "error" :signal (nativeGet controller "signal"))))
              (unless (undefined? body)
                (when (js-call (js-array "GET" "HEAD") :includes method) (throw (new globalThis.TypeError "read requests cannot carry a body")))
                (put options :body body))
              (when (nativeGet parent "aborted") (throw (new globalThis.Error "Lark request cancelled")))
              (js-call active :add controller)
              (when parent (js-call parent :addEventListener "abort" abort (js-object :once t)))
              (setq timer (nativeSetTimeout abort remaining))
              (try
                (let* ((response (await (js-call host :fetch url options)))
                  (bytes (await (readBytes response maximum)))
                  (selected (js-object)) (retry 0)
                  (value (cond ((= mode "bytes") bytes)
                    (t (let ((text (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode bytes)))
                      (if (= mode "json") (if (> (js-length text) 0) (JSON/parse text) nil) text))))))
                  (js-call (js-array "content-type" "content-disposition" "content-range" "etag" "x-tt-logid" "x-request-id" "retry-after" "x-ogw-ratelimit-reset")
                    :forEach (lambda (key)
                      (let ((value (js-call (nativeGet response "headers") :get key)))
                        (when value (put selected key value)))))
                  (setq retry (Math/max 0 (or (NativeNumber (nativeGet selected "retry-after")) 0)
                    (or (NativeNumber (nativeGet selected "x-ogw-ratelimit-reset")) 0)))
                  (unless (Number/isFinite retry) (setq retry 5))
                  (js-object :status (nativeGet response "status") :headers selected :wire value :retry_after retry))
                (finally
                  (nativeClearTimeout timer)
                  (when parent (js-call parent :removeEventListener "abort" abort))
                  (js-call active :delete controller))))))
        :pendingWork (lambda () (nativeGet active "size"))
        :initialize (lambda () (setq closed false))
        :close (lambda () (setq closed t) (js-call active :forEach (lambda (controller) (js-call controller :abort)))))))
  (export apiUrl createHttp readBytes methods))
