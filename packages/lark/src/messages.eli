(module lark.messages
  (import "./native.eli" nativeGet nativeTypeOf)
  ;; Formatting is native post(md), not HTML, a card, or an external renderer.
  ;; Keep source Markdown and URL bytes unchanged; callers own destination URLs.
  (defun messagePayload (content)
    (let* ((markdown (= (nativeGet content "type") "markdown")) (text (nativeGet content "text")))
      (unless (and (or markdown (= (nativeGet content "type") "text")) (= (nativeTypeOf text) "string"))
        (throw (new globalThis.TypeError "message content requires text or markdown and a string body")))
      (js-object :msg_type (if markdown "post" "text") :content (JSON/stringify
        (if markdown
          (js-object :zh_cn (js-object :content (js-array (js-array (js-object :tag "md" :text text)))))
          (js-object :text text))))))
  (defun renderPostNode (node)
    (if (not (and node (= (nativeTypeOf node) "object") (not (Array/isArray node))))
      ""
      (let ((tag (nativeGet node "tag")) (text (nativeGet node "text")))
        (cond
          ((or (= tag "text") (= tag "md") (= tag "code_block"))
            (if (= (nativeTypeOf text) "string") text ""))
          ((= tag "a")
            (let ((href (nativeGet node "href")))
              (cond
                ((and (= (nativeTypeOf text) "string") (> (js-length text) 0)) text)
                ((= (nativeTypeOf href) "string") href)
                (t ""))))
          ((= tag "at")
            (let ((who (or (nativeGet node "user_name") (nativeGet node "name") (nativeGet node "user_id") "")))
              (if (> (js-length (str who)) 0) (str "@" who) "@")))
          ((= tag "emotion")
            (let ((emoji (nativeGet node "emoji_type")))
              (if (and (= (nativeTypeOf emoji) "string") (> (js-length emoji) 0)) (str "[" emoji "]") "")))
          ((= tag "img") "[image]")
          ((= tag "media") "[media]")
          ((= tag "hr") "---")
          ((= (nativeTypeOf text) "string") text)
          (t "")))))
  (defun extractLarkMessageText (msg-type raw-content)
    (let* ((kind (if (and (= (nativeTypeOf msg-type) "string") (> (js-length msg-type) 0)) msg-type "unknown"))
           (raw (if (= (nativeTypeOf raw-content) "string") raw-content ""))
           (text nil))
      (cond
        ((= kind "text")
          (try
            (let ((parsed (JSON/parse raw)))
              (when (and parsed (= (nativeTypeOf parsed) "object") (= (nativeTypeOf (nativeGet parsed "text")) "string"))
                (setq text (nativeGet parsed "text"))))
            (catch invalid nil)))
        ((= kind "post")
          (try
            (let* ((post (JSON/parse raw))
                   (locale (and post (= (nativeTypeOf post) "object")
                     (or (nativeGet post "zh_cn") (nativeGet post "en_us") (nativeGet post "ja_jp") post)))
                   (title (and locale (= (nativeTypeOf locale) "object") (nativeGet locale "title")))
                   (rows (and locale (= (nativeTypeOf locale) "object") (nativeGet locale "content"))))
              (when (Array/isArray rows)
                (let ((lines (js-array)))
                  (when (and (= (nativeTypeOf title) "string") (> (js-length title) 0))
                    (js-call lines :push title))
                  (js-call rows :forEach (lambda (row)
                    (when (Array/isArray row)
                      (js-call lines :push (js-call (js-call row :map renderPostNode) :join "")))))
                  (setq text (js-call lines :join "\n")))))
            (catch invalid nil))))
      (if (= (nativeTypeOf text) "string") text (str "[" kind "] " raw))))
  (export messagePayload extractLarkMessageText))
