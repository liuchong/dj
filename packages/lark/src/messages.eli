(module lark.messages
  (import "./native.eli" nativeGet nativeTypeOf)
  ;; Formatting is native post(md), not HTML, a card, or an external renderer.
  ;; Keep source Markdown and URL bytes unchanged; callers own destination URLs.
  (defun messagePayload (content)
    (let* ((markdown (= (nativeGet content "type") "markdown")) (text (nativeGet content "text")))
      (unless (and (or markdown (= (nativeGet content "type") "text")) (= (nativeTypeOf text) "string"))
        (throw (new globalThis.TypeError "message content requires text or markdown and a string body")))
      (js-object :msg_type (if markdown "post" "text") :content (JSON/stringify
        (if markdown
          (js-object :zh_cn (js-object :content (js-array (js-array (js-object :tag "md" :text text)))))
          (js-object :text text))))))
  (defun textValue (value)
    (if (= (nativeTypeOf value) "string") value ""))
  (defun readablePostNode (node)
    (if (not (and node (= (nativeTypeOf node) "object") (not (Array/isArray node))))
      ""
      (let ((tag (nativeGet node "tag")) (text (nativeGet node "text")))
        (cond
          ((or (= tag "text") (= tag "md") (= tag "code_block"))
            (if (= (nativeTypeOf text) "string") text ""))
          ((= tag "a")
            (let ((href (nativeGet node "href")))
              (cond
                ((and (= (nativeTypeOf text) "string") (> (js-length text) 0)) text)
                ((= (nativeTypeOf href) "string") href)
                (t ""))))
          ((= tag "at")
            (let ((who (or (nativeGet node "user_name") (nativeGet node "name") (nativeGet node "user_id") "")))
              (if (> (js-length (str who)) 0) (str "@" who) "@")))
          ((= tag "emotion")
            (let ((emoji (nativeGet node "emoji_type")))
              (if (and (= (nativeTypeOf emoji) "string") (> (js-length emoji) 0)) (str "[" emoji "]") "")))
          ((= tag "img") "[image]")
          ((= tag "media") "[media]")
          ((= tag "hr") "---")
          ((= (nativeTypeOf text) "string") text)
          (t "")))))
  (defun appendResource (message kind key name offset width)
    (when (and (= (nativeTypeOf key) "string") (> (js-length key) 0))
      (js-call (nativeGet message "resources") :push
        (js-object :kind kind :file_key key :file_name (or (textValue name) nil)
          :resource_type (if (or (= kind "image") (= kind "video_cover")) "image" "file")
          :offset offset :length width))))
  (defun mediaResources (message kind node offset width)
    (let ((name (nativeGet node "file_name")))
      (cond
        ((or (= kind "img") (= kind "image"))
          (appendResource message "image" (nativeGet node "image_key" (nativeGet node "img_key")) name offset width))
        ((or (= kind "media") (= kind "video"))
          (appendResource message "video" (nativeGet node "file_key") name offset width)
          (appendResource message "video_cover" (nativeGet node "image_key") nil offset width))
        ((or (= kind "audio") (= kind "file"))
          (appendResource message kind (nativeGet node "file_key") name offset width)))))
  (defun postLocale (post)
    (or (nativeGet post "zh_cn") (nativeGet post "en_us") (nativeGet post "ja_jp")
      (when (Array/isArray (nativeGet post "content")) post)
      (when (and post (= (nativeTypeOf post) "object"))
        (js-call (Object/values post) :find (lambda (item) (Array/isArray (nativeGet item "content")))))))
  (defun parsePost (message post)
    (let* ((locale (postLocale post)) (rows (nativeGet locale "content"))
           (title (textValue (nativeGet locale "title")))
           (pieces (js-array)) (offset 0) (has-line false))
      (when (Array/isArray rows)
        (when (> (js-length title) 0)
          (js-call pieces :push title) (setq offset (js-length title) has-line t))
        (js-call rows :forEach (lambda (row)
          (when (Array/isArray row)
            (when has-line (js-call pieces :push "\n") (setq offset (1+ offset)))
            (setq has-line t)
            (js-call row :forEach (lambda (node)
              (let* ((tag (nativeGet node "tag")) (text (readablePostNode node))
                     (width (js-length text)) (href (textValue (nativeGet node "href"))))
                (when (and (= tag "a") (> (js-length href) 0))
                  (js-call (nativeGet message "links") :push (js-object :href href :offset offset :length width)))
                (mediaResources message tag node offset width)
                (js-call pieces :push text) (setq offset (+ offset width))))))))
        (js-call pieces :join ""))))
  (defun cardResources (message node depth)
    (when (and node (= (nativeTypeOf node) "object") (< depth 12))
      (when (or (= (nativeGet node "tag") "img") (= (nativeGet node "tag") "image"))
        ;; Card elements need not have a linear textual position.
        (mediaResources message "image" node nil nil))
      (js-call (Object/values node) :forEach (lambda (child)
        (cardResources message child (1+ depth))))))
  (defun parseLarkMessage (msg-type raw-content)
    (let* ((label (textValue msg-type))
           (kind (if (> (js-length label) 0) label "unknown"))
           (raw (textValue raw-content))
           (parsed (try (JSON/parse raw) (catch invalid nil)))
           (message (js-object :msg_type kind :raw_content raw :resources (js-array) :links (js-array)))
           (text nil))
      (cond
        ((= kind "text") (setq text (nativeGet parsed "text")))
        ((= kind "post") (setq text (parsePost message parsed)))
        ((js-call (js-array "image" "file" "audio" "media" "video") :includes kind)
          (mediaResources message kind parsed nil nil)
          (let ((name (textValue (nativeGet parsed "file_name"))))
            (setq text (if (> (js-length name) 0) (str "[" kind "] " name) (str "[" kind "]")))))
        ((= kind "interactive")
          (cardResources message parsed 0)
          (let ((title (nativeGet (nativeGet parsed "header") "title")))
            (setq text (or (nativeGet title "content") (nativeGet parsed "title")))))
        (t (setq text (or (nativeGet parsed "summary") (nativeGet parsed "topic") (nativeGet parsed "text")))))
      (put message :text (if (= (nativeTypeOf text) "string") text (str "[" kind "] " raw)))
      message))
  (defun extractLarkMessageText (msg-type raw-content)
    (nativeGet (parseLarkMessage msg-type raw-content) "text"))
  (export messagePayload parseLarkMessage extractLarkMessageText))
