(module rack.index
  (import "./kernel.eli" Context createContext Service createService Inject Fiber FiberState ReflectService RegistryService EventsService LoggerService symbols)
  (import "./util.eli" DisposableList withProps joinPrototype getPropertyDescriptor buildOuterStack composeError constructable objectLike bailed)
  (import "./logger.eli" Logger LoggerLevel defaultFormatters c16 c256)
  (import "./errors.eli" RackError ValidationError)
  (import "./tracking.eli" getTraceable createCallable)
  (defconst isConstructor constructable)
  (defun isObject (value)
    (if (funcall globalThis.Boolean value) (objectLike value) value))
  (defconst isBailed bailed)
  (export isBailed RackError ValidationError getTraceable createCallable isConstructor isObject buildOuterStack composeError Fiber ReflectService RegistryService EventsService LoggerService Logger LoggerLevel defaultFormatters c16 c256 Context createContext Service createService Inject FiberState symbols DisposableList withProps joinPrototype getPropertyDescriptor))
