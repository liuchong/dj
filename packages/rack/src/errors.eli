(module rack.errors
  (import "./util.eli" field define)
  (defun RackError (code &optional message)
    (let ((error (new globalThis.Error (or message (if (= code "INACTIVE_EFFECT") "cannot create effect on inactive context" code)))))
      (Object/setPrototypeOf error (field RackError "prototype"))
      (put error :name "RackError") (put error :code code) error))
  (Object/setPrototypeOf (field RackError "prototype") (field globalThis.Error "prototype"))
  (put RackError :Code (Object/freeze (js-object :INACTIVE_EFFECT "cannot create effect on inactive context")))
  (defun ValidationError (issues)
    (let* ((lines (js-call issues :map (lambda (issue)
      (str "  - " (field issue "message") (if (field issue "path")
        (str " (at " (js-call (field issue "path") :join ".") ")") "")))))
      (error (new globalThis.TypeError (str "invalid config:\n" (js-call lines :join "\n")))))
      (Object/setPrototypeOf error (field ValidationError "prototype"))
      (put error :name "ValidationError") (put error :issues issues) error))
  (Object/setPrototypeOf (field ValidationError "prototype") (field globalThis.TypeError "prototype"))
  (define (field ValidationError "prototype") (js-call globalThis.Symbol :for "ValidationError") t)
  (export RackError ValidationError))
