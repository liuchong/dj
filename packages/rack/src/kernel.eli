(module rack.kernel
  (import "./util.eli" kind field objectLike thenable bailed invoke constructable define accessor symbols DisposableList withProps joinPrototype getPropertyDescriptor)
  (import "./effects.eli" createEffect runDisposable getEffectRecord)
  (import "./errors.eli" RackError ValidationError)
  (import "./tracking.eli" getTraceable createCallable hostMethod)
  (import "./logger.eli" Logger)
  (defconst FiberState (Object/freeze (js-object :PENDING 0 :LOADING 1 :ACTIVE 2 :FAILED 3 :DISPOSED 4 :UNLOADING 5)))
  (defconst stateNames (js-array "pending" "loading" "active" "failed" "disposed" "unloading"))
  (defun engineOf (context) (field context "_rack"))
  (defun labelOf (context name) (field (field context (field symbols "isolate")) name))
  (defun implementation (context name &optional loose)
    (let ((record (js-call (field (engineOf context) "services") :get (labelOf context name))))
      (if (and record (or loose (= (field (field record "owner") "state") (field FiberState "ACTIVE")))) record undefined)))
  (defun refreshDependencies (fiber &optional names filter)
    (let ((context (field fiber "ctx")))
      (js-call (Object/keys (field fiber "inject")) :forEach (lambda (name)
        (when (and (or (not names) (js-call names :includes name)) (or (not filter) (funcall filter context name)))
          (let ((record (implementation context name)))
            (when (and record (field record "check"))
              (try
                (unless (funcall globalThis.Boolean (invoke (field record "check")
                  (getTraceable context (field record "value")) (js-array))) (setq record undefined))
                (catch error (report (engineOf context) error context) (setq record undefined))))
            (if record (put (field fiber "available") name record)
              (Reflect/deleteProperty (field fiber "available") name))))))))
  (defun report (engine error &optional context)
    (js-call (field engine "errors") :push error)
    (let ((caller (or context (field engine "context"))))
      (when caller (js-call (field caller "logger") :error error)))
    (when (field engine "onError") (funcall (field engine "onError") error)))
  (defun normalizeInject (value &optional supplied)
    (let ((result (or supplied (Object/create nil))))
      (cond ((Array/isArray value) (js-call value :forEach (lambda (name) (put result name nil))))
        ((objectLike value)
          (when (Reflect/has value (field symbols "checkProto"))
            (normalizeInject (Object/getPrototypeOf value) result))
          (js-call (Object/keys value) :forEach (lambda (name)
            (let ((answer (field value name)))
              (put result name (if (or (nil? answer) (undefined? answer)) nil answer))))))) result))
  (defun pluginCallback (plugin)
    (cond ((= (kind plugin) "function") plugin)
      ((= (kind (field plugin "apply")) "function") (field plugin "apply"))
      (t (throw (new globalThis.TypeError "Plugin must be a function, constructor or apply object")))))
  (defun resolveConfig (runtime config)
    (let ((schema (field runtime "Config")))
      (if (not schema) config
        (let ((answer (js-call (field schema "~standard") :validate config)))
          (when (Reflect/has answer "then") (throw (new globalThis.TypeError "Async config validation is not supported")))
          (when (field answer "issues") (throw (ValidationError (field answer "issues"))))
          (field answer "value")))))
  (defun traceValue (context value) (getTraceable context value))
  (defun storedImplementation (context name)
    (let* ((origin (field context (field symbols "shadow") context))
      (cursor (field origin "fiber")) (wanted (labelOf context name)) (record undefined) (done false))
      (while (and cursor (not done))
        (setq record (field (field cursor "store") name))
        (cond (record (setq done t))
          ((or (object-has? (field cursor "inject") name) (not (field cursor "runtime"))) (setq done t))
          ((not (eq wanted (labelOf (field cursor "parent") name))) (setq done t))
          (t (setq cursor (field (field cursor "parent") "fiber"))))) record))
  (defun serviceRead (context name)
    (let ((record (storedImplementation context name)))
      (unless record (throw (RackError "MISSING_INJECTION" (str "Required service is not available in this context: " name))))
      (getTraceable context (field record "value"))))
  (defun dispatchListeners (context mode supplied)
    (let* ((args (js-call supplied :slice))
      (receiver (if (or (nil? (aref args 0)) (objectLike (aref args 0))) (js-call args :shift) nil))
      (name (js-call args :shift))
      (engine (engineOf context)) (hooks (or (js-call (field engine "hooks") :get name) (js-array)))
      (filter (field receiver (field symbols "filter"))))
      (unless (or (= (kind name) "string") (= (kind name) "symbol"))
        (throw (new globalThis.TypeError "Event name must be a string or symbol")))
      (when (and (= (kind name) "string") (not (js-call name :startsWith "internal/")))
        (emitEvent context "emit" (js-array "internal/dispatch" (if (= mode "parallel") "emit" mode) name args receiver)))
      (js-object :name name :receiver receiver :args args
        :listeners (js-call (js-call hooks :slice) :filter (lambda (hook)
          (and (not (field hook "removed"))
            (or (field hook "global") (not filter) (invoke filter receiver (js-array (field hook "ctx"))))))))))
  (defun emitEvent (context mode supplied)
    (let* ((dispatch (dispatchListeners context mode supplied)) (hooks (field dispatch "listeners"))
      (receiver (field dispatch "receiver")) (args (field dispatch "args")))
      (cond
        ((= mode "parallel")
          (js-call (Promise/allSettled (js-call hooks :map (async (hook)
            (invoke (field hook "callback") receiver args)))) :then (lambda (results)
            (let ((errors (js-call (js-call results :filter (lambda (row) (= (field row "status") "rejected")))
              :map (lambda (row) (field row "reason")))))
              (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "Parallel event failed")))))))
        ((= mode "serial") (funcall (async ()
          (let ((i 0) (answer undefined) (stop false))
            (while (and (< i (js-length hooks)) (not stop))
              (setq answer (await (invoke (field (aref hooks i) "callback") receiver args)))
              (setq stop (bailed answer) i (1+ i))) (if stop answer undefined)))))
        ((= mode "waterfall")
          (let ((next nil) (i 0) (last (js-call args :pop)))
            (unless (= (kind last) "function") (throw (new globalThis.TypeError "Waterfall requires a continuation")))
            (setq next (lambda ()
              (if (>= i (js-length hooks)) (invoke last receiver (js-call (js-call args :slice) :concat (js-array next)))
                (let ((hook (aref hooks i))) (setq i (1+ i))
                  (invoke (field hook "callback") receiver (js-call (js-call args :slice) :concat (js-array next)))))))
            (funcall next)))
        (t (let ((i 0) (answer undefined) (stop false))
          (while (and (< i (js-length hooks)) (not stop))
            (setq answer (invoke (field (aref hooks i) "callback") receiver args))
            (setq stop (and (= mode "bail") (bailed answer)) i (1+ i)))
          (if (and (= mode "bail") stop) answer undefined))))))
  (defun bindCallback (context callback)
    (new globalThis.Proxy callback (js-object
      :apply (lambda (target receiver args)
        (invoke target (getTraceable context receiver)
          (js-call args :map (lambda (item) (getTraceable context item)))))
      :construct (lambda (target args constructor)
        (Reflect/construct target (js-call args :map (lambda (item) (getTraceable context item))) constructor)))))
  (defun registerListener (context hooks callback options label)
    (js-call (field context "fiber") :effect (lambda ()
      (let ((hook (Object/assign (js-object :ctx context :callback callback) options)))
        (if (field options "prepend") (js-call hooks :unshift hook) (js-call hooks :push hook))
        (lambda () (unregisterListener hooks callback)))) label))
  (defun unregisterListener (hooks callback)
    (let ((index (js-call hooks :findIndex (lambda (hook) (eq (field hook "callback") callback)))))
      (if (>= index 0) (progn (js-call hooks :splice index 1) t) undefined)))
  (defun onEvent (context name callback supplied &optional once)
    (js-call (field context "fiber") :assertActive)
    (let* ((engine (engineOf context))
      (options (if (and supplied (= (kind supplied) "object")) supplied (js-object :prepend supplied)))
      (remove nil) (listener callback))
      (when once (setq listener (hostMethod (lambda (receiver args)
        (funcall remove) (invoke callback receiver args)))))
      (setq listener (bindCallback context listener))
      (let ((result (emitEvent context "bail" (js-array context "internal/listener" name listener options))))
        (if (funcall globalThis.Boolean result) (setq remove result)
          (let ((hooks (or (js-call (field engine "hooks") :get name) (js-array))))
            (js-call (field engine "hooks") :set name hooks)
            (setq remove (registerListener context hooks listener options (str "listener:" name)))))) remove))
  (defun initializeEvents (context)
    (let* ((engine (engineOf context)) (hooks (field engine "hooks"))
      (listener (hostMethod (lambda (receiver args)
        (when (and (= (aref args 0) "internal/update") (not (field (aref args 2) "global")))
          (let* ((owner (field receiver "fiber")) (local (field owner "_hooks"))
            (items (or (field local "internal/update") (js-array))))
            (put local "internal/update" items)
            (registerListener receiver items (aref args 1) (aref args 2) "update listener"))))))
      (update (hostMethod (lambda (receiver args)
        (let* ((items (js-call (or (field (field receiver "_hooks") "internal/update") (js-array)) :slice))
          (position 0) (next nil))
          (setq next (lambda ()
            (if (>= position (js-length items)) (invoke (aref args 2) receiver (js-array))
              (let ((hook (aref items position))) (setq position (1+ position))
                (invoke (field hook "callback") receiver (js-array (aref args 0) (aref args 1) next))))))
          (funcall next))))))
      (js-call hooks :set "internal/listener" (js-array (js-object :ctx context :callback listener)))
      (js-call hooks :set "internal/update" (js-array (js-object :ctx context :callback update :global t :prepend t)))))
  (defun dependencySignature (fiber)
    (let ((parts (js-array)) (ready t))
      (js-call (Object/keys (field fiber "inject")) :forEach (lambda (name)
        (let ((record (field (field fiber "available") name)))
          (if record (js-call parts :push (str name ":" (field (field record "owner") "uid")))
            (setq ready false)))))
      (when ready (js-call (js-call parts :concat (js-array (field fiber "revision"))) :join "|"))))
  (defun notifyScope (context names &optional suppliedFilter)
    (let* ((engine (engineOf context)) (affected (js-array))
      (filter (or suppliedFilter (lambda (target name) (eq (labelOf target name) (labelOf context name))))))
      (js-call (field engine "fibers") :forEach (lambda (fiber)
        (when (and (not (eq (field fiber "uid") nil))
          (js-call names :some (lambda (name)
            (and (object-has? (field fiber "inject") name) (funcall filter (field fiber "ctx") name)))))
          (refreshDependencies fiber names filter)
          (when (not (eq (dependencySignature fiber) (field fiber "signature"))) (requestFiber fiber))
          (js-call affected :push fiber))))
      (js-call names :forEach (lambda (name)
        (let ((receiver (js-call context :extend)))
          (put receiver (field symbols "filter") (lambda (target) (funcall filter target name)))
          (emitEvent context "emit" (js-array receiver "internal/service" name
            (field (implementation context name t) "value")))))) affected))
  (defun setState (fiber state)
    (unless (= (field fiber "state") state)
      (let ((old (field fiber "state")) (context (field fiber "ctx")))
        (put fiber :state state)
        (try
          (emitEvent context "emit" (js-array "internal/status" fiber old))
          (when (or (= old (field FiberState "ACTIVE")) (= state (field FiberState "ACTIVE")))
            (notifyScope context (Array/from (field fiber "provided"))))
          (catch error (report (engineOf context) error context))))))
  (defasync unloadFiber (fiber)
    (setState fiber (field FiberState "UNLOADING"))
    (let ((records (js-call (Array/from (field fiber "effects")) :reverse)))
      (await (Promise/all (js-call records :map (async (record)
        (try (await (funcall (field record "dispose")))
          (catch error (report (engineOf (field fiber "ctx")) error (field fiber "ctx")))))))))
    (put fiber :store undefined) (put fiber :signature nil) (put fiber :started false))
  (defasync driveFiber (fiber)
    (let ((engine (engineOf (field fiber "ctx"))) (done false))
      (while (not done)
        (put fiber :requested false)
        (let ((desired (and (not (eq (field fiber "uid") nil)) (dependencySignature fiber))))
          (when (and (field fiber "started") (not (eq desired (field fiber "signature"))))
            (await (unloadFiber fiber)))
          (cond
            ((eq (field fiber "uid") nil)
              (when (> (field (field fiber "effects") "size") 0) (await (unloadFiber fiber)))
              (setState fiber (field FiberState "DISPOSED")))
            ((not desired) (setState fiber (field FiberState "PENDING")))
            ((and (= (field fiber "state") (field FiberState "FAILED")) (= desired (field fiber "attempt"))) nil)
            ((not (= desired (field fiber "signature")))
              (put fiber :attempt desired) (put fiber :signature desired) (put fiber :started t)
              (put fiber :store (Object/assign (Object/create nil) (field fiber "available")))
              (setState fiber (field FiberState "LOADING"))
              (try
                (put fiber :config (js-call fiber :resolveConfig (field fiber "rawConfig")))
                (let* ((runtime (field fiber "runtime")) (callback (field runtime "callback"))
                  (acquisition (js-call fiber :effect (lambda ()
                    (if (constructable callback)
                      (let ((instance (Reflect/construct callback (js-array (field fiber "ctx") (field fiber "config")))))
                        (js-call (or (field instance (field symbols "initHooks")) (js-array)) :forEach (lambda (hook) (funcall hook)))
                        (let ((init (field instance (field symbols "init"))))
                          (when init (invoke init instance (js-array)))))
                      (invoke callback runtime (js-array (field fiber "ctx") (field fiber "config"))))) "activation" (field fiber "outer"))))
                  (put (getEffectRecord acquisition) :activation t)
                  (await acquisition)
                  (when (= (js-length (field (getEffectRecord acquisition) "children")) 0)
                    ;; A no-resource activation does not appear as an owned effect.
                    (put (getEffectRecord acquisition) :hidden t)))
                (when (and (not (eq (field fiber "uid") nil)) (= desired (dependencySignature fiber)))
                  (put fiber :error nil) (setState fiber (field FiberState "ACTIVE")))
                (catch error
                  (put fiber :error error) (await (unloadFiber fiber))
                  (setState fiber (if (eq (field fiber "uid") nil) (field FiberState "DISPOSED") (field FiberState "FAILED")))
                  (report engine error (field fiber "ctx"))))))
          (when (and (= (field fiber "state") (field FiberState "LOADING"))
            (or (eq (field fiber "uid") nil) (not (= desired (dependencySignature fiber)))))
            (await (unloadFiber fiber)) (put fiber :requested t)))
        (setq done (not (field fiber "requested"))))) fiber)
  (defun requestFiber (fiber)
    (put fiber :requested t)
    (unless (field fiber "inertia")
      (let* ((engine (engineOf (field fiber "ctx")))
        (task (js-call (Promise/resolve) :then (lambda () (driveFiber fiber)))))
        (put fiber :inertia task) (js-call (field engine "tasks") :add task)
        (let ((desired (dependencySignature fiber)))
          (cond ((and (not (eq (field fiber "uid") nil)) desired
            (not (field fiber "started"))) (setState fiber (field FiberState "LOADING")))
            ((field fiber "started") (setState fiber (field FiberState "UNLOADING")))))
        (js-call task :then (lambda ()
          (put fiber :inertia undefined) (js-call (field engine "tasks") :delete task)
          (when (field fiber "requested") (requestFiber fiber)))
          (lambda (error)
            (put fiber :inertia undefined) (js-call (field engine "tasks") :delete task)
            (put fiber :error error) (setState fiber (field FiberState "FAILED")) (report engine error (field fiber "ctx"))))))
    (field fiber "inertia"))
  (defasync awaitFiber (fiber)
    (while (field fiber "inertia") (await (field fiber "inertia")))
    (when (field fiber "error") (throw (field fiber "error"))) fiber)
  (defun effectMetadata (fiber)
    (let ((items (js-array)))
      (js-call (field fiber "effects") :forEach (lambda (record)
        (if (field record "activation")
          (js-call (field record "children") :forEach (lambda (child) (js-call items :push child)))
          (when (field (field record "public") (field symbols "effect"))
            (js-call items :push (field (field record "public") (field symbols "effect"))))))) items))
  (defun publishDisposed (context fiber)
    (let ((dispatch (dispatchListeners context "emit" (js-array "internal/plugin" fiber))))
      (js-call (field dispatch "listeners") :forEach (lambda (hook)
        (try
          (js-call (Promise/resolve (invoke (field hook "callback") (field dispatch "receiver") (field dispatch "args")))
            :catch (lambda (error) (report (engineOf context) error context)))
          (catch error (report (engineOf context) error context)))))))
  (defun fiberName (fiber)
    (let ((cursor fiber) (name undefined))
      (while (and cursor (not name))
        (setq name (field (field cursor "runtime") "name"))
        (let ((next (and (field cursor "parent") (field (field cursor "parent") "fiber"))))
          (setq cursor (unless (eq next cursor) next))))
      (or name "root")))
  (defun createFiber (parent plugin config &optional suppliedRuntime outer)
    (js-call (field parent "fiber") :assertActive)
    (let* ((engine (engineOf parent)) (callback (pluginCallback plugin))
      (registry (field engine "registry")) (runtime (or suppliedRuntime (js-call registry :get callback)))
      (fiber (Object/assign (Object/create (field Fiber "prototype"))
        (js-object :uid (1+ (field engine "counter")) :plugin plugin :rawConfig config :config undefined :revision 0
          :parent parent :outer outer :inject (normalizeInject (field plugin "inject")) :provided (new globalThis.Set)
          :available (Object/create nil) :store (Object/create nil) :_hooks (Object/create nil)
          :effects (new globalThis.Set) :errors (js-array) :state (field FiberState "PENDING") :error nil
          :inertia undefined :signature nil :attempt nil :requested false :started false)))
      (context (makeContext engine parent fiber)) (closed false) (disposal nil))
      (put engine :counter (field fiber "uid")) (put fiber :ctx context)
      (js-call (Object/entries (field fiber "inject")) :forEach (lambda (pair)
        (unless (or (nil? (aref pair 1)) (undefined? (aref pair 1)))
          (put (field context (field symbols "intercept")) (aref pair 0) (aref pair 1)))))
      (unless runtime
        (setq runtime (js-object :name (if (= (field plugin "name") "apply") undefined (field plugin "name"))
          :callback callback :Config (field plugin "Config") :fibers (DisposableList)))
        (js-call registry :set callback runtime))
      (put fiber :runtime runtime)
      (accessor fiber "name" (lambda () (fiberName fiber)))
      (let ((remove (js-call (field runtime "fibers") :push fiber)))
        (put fiber :dispose (js-call (field parent "fiber") :effect (lambda () (async ()
          (unless closed
            (setq closed t) (put fiber :uid nil) (publishDisposed context fiber) (funcall remove)
            (when (and (= (field (field runtime "fibers") "length") 0) (eq (js-call registry :get callback) runtime))
              (js-call registry :delete callback))
            (js-call (field engine "fibers") :delete fiber)
            (setq disposal (requestFiber fiber)))
          (when disposal (await disposal))
          (while (field fiber "inertia") (await (field fiber "inertia"))))) "child plugin")))
      (put fiber :effect (lambda (execute &optional label outer) (createEffect fiber execute label outer)))
      (put fiber :resolveConfig (lambda (candidate)
        (resolveConfig runtime (emitEvent context "waterfall" (js-array fiber "internal/config" candidate (lambda () candidate))))))
      (accessor fiber "effectiveConfig" (lambda () (field fiber "config")))
      (put fiber :await (lambda () (awaitFiber fiber)))
      (put fiber :restart (async ()
        (js-call fiber :assertActive)
        (put fiber :revision (1+ (field fiber "revision"))) (put fiber :error nil)
        (requestFiber fiber) (await (awaitFiber fiber)) undefined))
      (put fiber :update (lambda (candidate &optional noSave)
        (js-call fiber :assertActive) (put fiber :rawConfig candidate)
        (if (not (= (field fiber "state") (field FiberState "ACTIVE")))
          (progn (put fiber :error nil) (put fiber :revision (1+ (field fiber "revision"))) (requestFiber fiber))
          (let ((resolved (js-call fiber :resolveConfig candidate)))
            (emitEvent context "waterfall" (js-array fiber "internal/update" resolved (if (or (nil? noSave) (undefined? noSave)) false noSave)
              (lambda () (put fiber :config resolved) (put fiber :error nil) (js-call fiber :restart)))))) undefined))
      (put fiber :getEffects (lambda () (effectMetadata fiber)))
      (put fiber :assertActive (lambda () (when (eq (field fiber "uid") nil) (throw (RackError "INACTIVE_EFFECT")))))
      (js-call (field engine "fibers") :add fiber)
      (try (emitEvent parent "emit" (js-array "internal/plugin" fiber))
        (catch error (js-call (Promise/resolve (js-call fiber :dispose)) :catch (lambda (error) (report engine error (field fiber "ctx")))) (throw error)))
      (unless closed (refreshDependencies fiber) (requestFiber fiber))
      (let ((handle (Object/create fiber)))
        (put handle :then (lambda (resolve reject) (js-call (awaitFiber fiber) :then resolve reject))) handle)))
  (defun Fiber (parent config inject runtime &optional outer)
    (if runtime
      (Object/getPrototypeOf (createFiber parent
        (js-object :name (field runtime "name") :apply (field runtime "callback") :Config (field runtime "Config") :inject inject)
        config runtime outer))
      (let ((owner (Object/assign (Object/create (field Fiber "prototype"))
        (js-object :uid 0 :name "root" :state (field FiberState "ACTIVE") :parent parent :ctx parent
          :runtime nil :inject inject :rawConfig config :config undefined :store (Object/create nil)
          :available (Object/create nil) :_hooks (Object/create nil) :provided (new globalThis.Set)
          :effects (new globalThis.Set) :errors (js-array)))))
        (put owner :assertActive (lambda () nil))
        (put owner :effect (lambda (execute &optional label stack) (createEffect owner execute label stack)))
        (put owner :getEffects (lambda () (effectMetadata owner)))
        (put owner :resolveConfig (lambda (candidate) candidate))
        (put owner :await (async () (when (field owner "inertia") (await (field owner "inertia"))) owner))
        (put owner :restart (async ()
          (let ((task (unloadFiber owner)))
            (put owner :inertia task) (await task) (put owner :inertia undefined)
            (put owner :store (Object/create nil)) (setState owner (field FiberState "ACTIVE")))))
        (put owner :dispose (field owner "restart")) owner)))
  (defun provideService (context name value check)
    (let ((scope (field (field context "root") (field symbols "isolate"))))
      (unless (field scope name) (put scope name (funcall globalThis.Symbol name))))
    (let* ((engine (engineOf context)) (owner (field context "fiber")) (key (labelOf context name))
      (services (field engine "services")) (declarations (field engine "declarations")))
      (js-call owner :effect (lambda ()
        (when (and (js-call declarations :has name) (not (= (field (js-call declarations :get name) "type") "service")))
          (throw (RackError "PROPERTY_CONFLICT" (str "Context property is already declared: " name))))
        (js-call declarations :set name (js-object :type "service"))
        (when (js-call services :has key) (throw (RackError "DUPLICATE_SERVICE" (str "Service already provided: " name))))
        (let ((record (js-object :name name :value value :check check :owner owner :fiber owner)))
          (js-call services :set key record) (put (field owner "store") name record)
          (js-call (field owner "provided") :add name)
          (when (= (field owner "state") (field FiberState "ACTIVE")) (notifyScope context (js-array name)))
          (async ()
            (when (eq (js-call services :get key) record) (js-call services :delete key))
            (let ((affected (notifyScope context (js-array name))))
              (await (Promise/allSettled (js-call affected :map (lambda (fiber) (js-call fiber :await))))))
            (when (field owner "store") (Reflect/deleteProperty (field owner "store") name))
            (js-call (field owner "provided") :delete name)))) (str "provide:" name))))
  (defun loggerOptions (context requested)
    (let ((cursor (field context (field symbols "intercept"))) (parts (js-array)) (settings (js-object)))
      (while cursor
        (when (object-has? cursor "logger") (js-call parts :unshift (field cursor "logger")))
        (setq cursor (Object/getPrototypeOf cursor)))
      (js-call parts :forEach (lambda (part) (Object/assign settings part)))
      (put settings :name (if (and (not (nil? requested)) (not (undefined? requested))) requested (or (field settings "name")
        (js-call (field (field (field context (field symbols "shadow") context) "fiber") "name" "root")
          :replace (new globalThis.RegExp "[A-Z]" "g") (lambda (letter index) (str (if (> index 0) "-" "") (js-call letter :toLowerCase)))))))
      (put settings :meta (Object/assign (js-object :fiber (new globalThis.WeakRef (field context "fiber"))) (field settings "meta"))) settings))
  (defun makeLogger (context)
    (let* ((engine (engineOf context)) (service nil))
      (setq service (hostMethod (lambda (receiver args)
        (let ((caller (field service "ctx"))) (Logger (loggerOptions caller (aref args 0)) engine)))))
      (define service "ctx" context)
      (define service (field symbols "tracker") (js-object :property "ctx" :noShadow t))
      (define service (field symbols "invoke") (hostMethod (lambda (receiver args)
        (Logger (loggerOptions (field receiver "ctx") (aref args 0)) engine))))
      (js-call (js-array "error" "info" "warn" "debug") :forEach (lambda (key)
        (put service key (hostMethod (lambda (receiver args)
          (let ((named (Logger (loggerOptions (field receiver "ctx") undefined) engine)))
            (invoke (field named key) named args)))))))
      (put service :exporter (hostMethod (lambda (receiver args)
        (let ((id (1+ (field engine "exporterSerial"))) (caller (field receiver "ctx")))
          (put engine :exporterSerial id)
          (js-call (field caller "fiber") :effect (lambda ()
