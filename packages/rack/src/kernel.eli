(module rack.kernel
  (import "./util.eli" kind field objectLike thenable bailed invoke constructable define accessor rackError symbols DisposableList withProps joinPrototype getPropertyDescriptor)
  (import "./effects.eli" createEffect)
  (import "./logger.eli" Logger)
  (defconst FiberState (Object/freeze (js-object :PENDING "pending" :LOADING "loading" :ACTIVE "active"
    :UNLOADING "unloading" :FAILED "failed" :DISPOSED "disposed")))
  ;; Native receiver preservation is intentionally confined to this bridge.
  (defconst hostMethod (js* "(work) => function (...args) { return work(this, args); }"))
  (defun engineOf (context) (field context "_rack"))
  (defun labelOf (context name)
    (let* ((engine (engineOf context)) (labels (field engine "labels"))
      (isolated (field (field context "_scope") name)))
      (unless (js-call labels :has name) (js-call labels :set name (funcall globalThis.Symbol name)))
      (or isolated (js-call labels :get name))))
  (defun implementation (context name &optional loose)
    (let ((record (js-call (field (engineOf context) "services") :get (labelOf context name))))
      (when (and record (or loose (= (field (field record "owner") "state") "active")))
        (if (field record "check")
          (try (when (invoke (field record "check") (traceValue context (field record "value")) (js-array)) record)
            (catch error (report (engineOf context) error) nil))
          record))))
  (defun report (engine error)
    (js-call (field engine "errors") :push error)
    (when (field engine "onError") (funcall (field engine "onError") error)))
  (defun normalizeInject (value)
    (let ((result (Object/create nil)))
      (cond ((Array/isArray value) (js-call value :forEach (lambda (name) (put result name nil))))
        ((objectLike value)
          (let ((chain (js-array)) (cursor value))
            (while (and cursor (not (eq cursor (field globalThis.Object "prototype"))))
              (js-call chain :unshift cursor) (setq cursor (Object/getPrototypeOf cursor)))
            (js-call chain :forEach (lambda (part) (Object/assign result part)))))) result))
  (defun pluginCallback (plugin)
    (cond ((= (kind plugin) "function") plugin)
      ((= (kind (field plugin "apply")) "function") (field plugin "apply"))
      (t (throw (new globalThis.TypeError "Plugin must be a function, constructor or apply object")))))
  (defun validateConfig (plugin config)
    (let* ((schema (field plugin "Config")) (standard (field schema "~standard")))
      (if (not schema) config
        (progn
          (unless (= (kind (field standard "validate")) "function")
            (throw (new globalThis.TypeError "Config requires a standard-schema validator")))
          (let ((result (js-call standard :validate config)))
            (when (thenable result) (throw (new globalThis.TypeError "Asynchronous config validation is not supported")))
            (when (field result "issues")
              (let ((error (new globalThis.TypeError "Invalid plugin configuration")))
                (put error :name "ValidationError") (put error :issues (field result "issues")) (throw error)))
            (field result "value"))))))
  (defun traceValue (context value)
    (let ((tracker (field value (field symbols "tracker"))))
      (if (not tracker) value
        (let* ((cache (field context "_trace")) (known (js-call cache :get value)))
          (or known
            (let ((proxy nil))
              (setq proxy (new globalThis.Proxy value (js-object
                :get (lambda (target key receiver)
                  (cond ((eq key (field symbols "original")) target)
                    ((eq key (field tracker "property"))
                      (makeContext (engineOf context) context (field context "fiber")
                        (js-object :_origin (field target (field tracker "property")))))
                    (t (let ((member (Reflect/get target key receiver)))
                      (if (= (kind member) "function")
                        (new globalThis.Proxy member (js-object :apply (lambda (method self args)
                          (traceValue context (invoke method (if (eq self receiver) proxy self) args)))))
                        (traceValue context member))))))
                :set (lambda (target key answer receiver)
                  (if (or (eq key (field symbols "original")) (eq key (field tracker "property"))) false
                    (Reflect/set target key answer receiver)))
                :apply (lambda (target receiver args)
                  (let ((body (field target (field symbols "invoke"))))
                    (traceValue context (invoke (or body target) (if body proxy receiver) args)))))))
              (js-call cache :set value proxy) proxy))))))
  (defun storedImplementation (context name)
    (let ((cursor (field context "fiber")) (wanted (labelOf context name)) (record nil) (finished false))
      (while (and cursor (not finished))
        (when (eq wanted (labelOf (field cursor "ctx") name))
          (setq record (js-call (field cursor "store") :get name)))
        (if record (setq finished t)
          (progn
            (when (object-has? (field cursor "inject") name) (setq finished t))
            (setq cursor (field cursor "parent"))))) record))
  (defun serviceRead (context name &optional optional)
    (if optional
      (let ((record (implementation context name))) (if record (traceValue context (field record "value")) undefined))
      (let* ((record (storedImplementation context name)) (origin (field context "_origin")))
        (when (and (not record) origin (eq (labelOf context name) (labelOf origin name)))
          (setq record (storedImplementation origin name)))
        (unless record (throw (rackError "MISSING_INJECTION" (str "Required service is not available in this context: " name))))
        (traceValue context (field record "value")))))
  (defun dispatchListeners (context mode supplied)
    (let* ((args (js-call supplied :slice))
      (receiver (if (objectLike (aref args 0)) (js-call args :shift) undefined))
      (name (js-call args :shift))
      (engine (engineOf context)) (hooks (or (js-call (field engine "hooks") :get name) (js-array)))
      (filter (field receiver (field symbols "filter"))))
      (unless (or (= (kind name) "string") (= (kind name) "symbol"))
        (throw (new globalThis.TypeError "Event name must be a string or symbol")))
      (when (and (= (kind name) "string") (not (js-call name :startsWith "internal/")))
        (emitEvent context "emit" (js-array "internal/dispatch" mode name args receiver)))
      (js-object :name name :receiver receiver :args args
        :listeners (js-call (js-call hooks :slice) :filter (lambda (hook)
          (and (not (field hook "removed"))
            (or (not (= name "internal/update")) (field hook "global")
              (eq (field (field hook "ctx") "fiber") receiver))
            (or (field hook "global") (not filter) (invoke filter receiver (js-array (field hook "ctx"))))))))))
  (defun emitEvent (context mode supplied)
    (let* ((dispatch (dispatchListeners context mode supplied)) (hooks (field dispatch "listeners"))
      (receiver (field dispatch "receiver")) (args (field dispatch "args")))
      (cond
        ((= mode "parallel")
          (js-call (Promise/allSettled (js-call hooks :map (async (hook)
            (invoke (field hook "callback") receiver args)))) :then (lambda (results)
            (let ((errors (js-call (js-call results :filter (lambda (row) (= (field row "status") "rejected")))
              :map (lambda (row) (field row "reason")))))
              (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "Parallel event failed")))))))
        ((= mode "serial") (funcall (async ()
          (let ((i 0) (answer undefined) (stop false))
            (while (and (< i (js-length hooks)) (not stop))
              (setq answer (await (invoke (field (aref hooks i) "callback") receiver args)))
              (setq stop (bailed answer) i (1+ i))) (if stop answer undefined)))))
        ((= mode "waterfall")
          (let ((next nil) (i 0) (last (js-call args :pop)))
            (unless (= (kind last) "function") (throw (new globalThis.TypeError "Waterfall requires a continuation")))
            (setq next (lambda ()
              (if (>= i (js-length hooks)) (invoke last receiver (js-array))
                (let ((hook (aref hooks i))) (setq i (1+ i))
                  (invoke (field hook "callback") receiver (js-call (js-call args :slice) :concat (js-array next)))))))
            (funcall next)))
        (t (let ((i 0) (answer undefined) (stop false))
          (while (and (< i (js-length hooks)) (not stop))
            (setq answer (invoke (field (aref hooks i) "callback") receiver args))
            (setq stop (and (= mode "bail") (bailed answer)) i (1+ i)))
          (if (and (= mode "bail") stop) answer undefined))))))
  (defun onEvent (context name callback options &optional once)
    (unless (= (kind callback) "function") (throw (new globalThis.TypeError "Listener must be callable")))
    (let* ((engine (engineOf context)) (owner (field context "fiber"))
      (hooks (or (js-call (field engine "hooks") :get name) (js-array)))
      (hook (js-object :ctx context :callback callback :global (field options "global") :removed false))
      (cleanup nil))
      (when once
        (put hook :callback (hostMethod (lambda (receiver args)
          (unless (field hook "removed")
            (put hook :removed t) (when cleanup (funcall cleanup)) (invoke callback receiver args))))))
      (setq cleanup (js-call owner :effect (lambda ()
        (js-call (field engine "hooks") :set name hooks)
        (if (or (eq options t) (field options "prepend")) (js-call hooks :unshift hook) (js-call hooks :push hook))
        (lambda () (put hook :removed t)
          (let ((index (js-call hooks :indexOf hook))) (when (>= index 0) (js-call hooks :splice index 1)))))))
      cleanup))
  (defun dependencySignature (fiber)
    (let ((parts (js-array)) (ready t) (context (field fiber "ctx")))
      (js-call (Object/keys (field fiber "inject")) :forEach (lambda (name)
        (let ((record (implementation context name)))
          (if record (js-call parts :push (str name ":" (field (field record "owner") "uid")))
            (setq ready false)))))
      (when ready (js-call (js-call parts :concat (js-array (field fiber "revision"))) :join "|"))))
  (defun setState (fiber state)
    (unless (= (field fiber "state") state)
      (let ((old (field fiber "state")))
        (put fiber :state state)
        (try (emitEvent (field fiber "ctx") "emit" (js-array "internal/status" fiber old))
          (catch error (report (engineOf (field fiber "ctx")) error))))))
  (defasync unloadFiber (fiber)
    (setState fiber "unloading")
    (let* ((records (js-call (Array/from (field fiber "effects")) :reverse))
      (results (await (Promise/allSettled (js-call records :map (lambda (record) (funcall (field record "dispose"))))))))
      (js-call results :forEach (lambda (result)
        (when (= (field result "status") "rejected")
          (report (engineOf (field fiber "ctx")) (field result "reason")))))
      (js-call (field fiber "store") :clear)
      (put fiber :signature nil)))
  (defasync driveFiber (fiber)
    (let ((engine (engineOf (field fiber "ctx"))) (done false))
      (while (not done)
        (put fiber :requested false)
        (let* ((desired (and (not (eq (field fiber "uid") nil)) (dependencySignature fiber)))
          (active (or (= (field fiber "state") "active") (= (field fiber "state") "loading"))))
          (when (and active (not (eq desired (field fiber "signature")))) (await (unloadFiber fiber)))
          (cond
            ((eq (field fiber "uid") nil) (await (unloadFiber fiber)) (setState fiber "disposed"))
            ((not desired) (setState fiber "pending"))
            ((and (= (field fiber "state") "failed") (= desired (field fiber "attempt"))) nil)
            ((not (= desired (field fiber "signature")))
              (put fiber :attempt desired) (put fiber :signature desired)
              (js-call (Object/keys (field fiber "inject")) :forEach (lambda (name)
                (js-call (field fiber "store") :set name (implementation (field fiber "ctx") name))))
              (setState fiber "loading")
              (try
                (put fiber :config (js-call fiber :resolveConfig (field fiber "rawConfig")))
                (let* ((plugin (field fiber "plugin")) (callback (pluginCallback plugin))
                  (cleanup (js-call fiber :effect (lambda ()
                    (cond
                      ((= (kind plugin) "function")
                        (if (constructable plugin)
                          (let ((instance (Reflect/construct plugin (js-array (field fiber "ctx") (field fiber "config")))))
                            (js-call (or (field instance (field symbols "initHooks")) (js-array)) :forEach
                              (lambda (hook) (funcall hook)))
                            (let ((init (field instance (field symbols "init"))))
                              (when init (invoke init instance (js-array)))))
                          (invoke callback undefined (js-array (field fiber "ctx") (field fiber "config")))))
                      (t (invoke callback plugin (js-array (field fiber "ctx") (field fiber "config")))))))))
                  (await cleanup))
                (when (and (not (eq (field fiber "uid") nil)) (= desired (dependencySignature fiber)))
                  (put fiber :error nil) (setState fiber "active"))
                (catch error
                  (put fiber :error error) (await (unloadFiber fiber))
                  (setState fiber "failed") (report engine error)))
              (notifyServices engine)))
          (when (and (= (field fiber "state") "loading")
            (or (eq (field fiber "uid") nil) (not (= desired (dependencySignature fiber)))))
            (await (unloadFiber fiber)) (put fiber :requested t)))
        (setq done (not (field fiber "requested")))))
    fiber)
  (defun requestFiber (fiber)
    (put fiber :requested t)
    (unless (field fiber "task")
      (let* ((engine (engineOf (field fiber "ctx")))
        (task (js-call (Promise/resolve) :then (lambda () (driveFiber fiber)))))
        (put fiber :task task)
        (js-call (field engine "tasks") :add task)
        (js-call task :then
          (lambda ()
            (put fiber :task nil) (js-call (field engine "tasks") :delete task)
            (when (field fiber "requested") (requestFiber fiber)))
          (lambda (error)
            (put fiber :task nil) (js-call (field engine "tasks") :delete task)
            (put fiber :error error) (setState fiber "failed") (report engine error)))))
    (field fiber "task"))
  (defun notifyServices (engine)
    (js-call (field engine "fibers") :forEach (lambda (fiber)
      (when (and (not (eq (field fiber "uid") nil))
        (not (eq (dependencySignature fiber) (field fiber "signature")))) (requestFiber fiber)))))
  (defasync awaitFiber (fiber)
    (while (field fiber "task") (await (field fiber "task")))
    (when (field fiber "error") (throw (field fiber "error"))) fiber)
  (defun createFiber (parent plugin config)
    (let* ((engine (engineOf parent)) (callback (pluginCallback plugin))
      (fiber (js-object :uid (1+ (field engine "counter")) :plugin plugin :name (or (field plugin "name") "anonymous")
        :rawConfig config :config undefined :revision 0 :parent (field parent "fiber")
        :inject (normalizeInject (field plugin "inject")) :provided (new globalThis.Set)
        :store (new globalThis.Map) :effects (new globalThis.Set) :errors (js-array) :state "pending" :error nil
        :task nil :signature nil :attempt nil :requested false))
      (context (makeContext engine parent fiber)) (disposal nil) (closed false)
      (registry (field engine "registry")) (runtime (js-call registry :get callback)))
      (put engine :counter (field fiber "uid")) (put fiber :ctx context)
      (js-call (Object/entries (field fiber "inject")) :forEach (lambda (pair)
        (unless (nil? (aref pair 1)) (put (field context "_intercepts") (aref pair 0) (aref pair 1)))))
      (unless runtime
        (setq runtime (js-object :name (field plugin "name") :callback callback :Config (field plugin "Config") :fibers (DisposableList)))
        (js-call registry :set callback runtime))
      (let ((remove (js-call (field runtime "fibers") :push fiber)))
        (put fiber :dispose (lambda ()
          (unless closed
            (setq closed t) (put fiber :uid nil) (funcall remove)
            (when (= (field (field runtime "fibers") "length") 0) (js-call registry :delete callback))
            (js-call (field engine "fibers") :delete fiber)
            (setq disposal (js-call (requestFiber fiber) :then (lambda () fiber)))) disposal)))
      (put fiber :effect (lambda (execute &optional label) (createEffect fiber execute label)))
      (put fiber :resolveConfig (lambda (candidate)
        (emitEvent context "waterfall" (js-array fiber "internal/config" candidate
          (lambda () (validateConfig plugin candidate))))))
      (accessor fiber "effectiveConfig" (lambda () (field fiber "config")))
      (put fiber :await (lambda () (awaitFiber fiber)))
      (put fiber :restart (lambda ()
        (when closed (throw (rackError "INACTIVE_EFFECT" "Plugin is disposed")))
        (put fiber :revision (1+ (field fiber "revision"))) (put fiber :error nil)
        (requestFiber fiber) (awaitFiber fiber)))
      (put fiber :update (lambda (candidate &optional noSave)
        (when closed (throw (rackError "INACTIVE_EFFECT" "Plugin is disposed")))
        (when (= (field fiber "state") "active") (js-call fiber :resolveConfig candidate))
        (emitEvent context "waterfall" (js-array fiber "internal/update" candidate noSave (lambda ()
          (put fiber :rawConfig candidate) (js-call fiber :restart))))))
      (put fiber :getEffects (lambda () (js-call (Array/from (field fiber "effects")) :map
        (lambda (record) (js-object :label (field record "label") :children (field record "children"))))))
      (put fiber :assertActive (lambda ()
        (when (or closed (= (field fiber "state") "unloading"))
          (throw (rackError "INACTIVE_EFFECT" "Plugin is inactive")))))
      (let ((close (field fiber "dispose")))
        (put fiber :dispose (js-call (field parent "fiber") :effect (lambda () close) "child plugin")))
      (js-call (field engine "fibers") :add fiber)
      (try (emitEvent parent "emit" (js-array "internal/plugin" fiber))
        (catch error (js-call fiber :dispose) (throw error)))
      (unless closed (requestFiber fiber))
      ;; A non-thenable handle is returned from the await bridge to avoid assimilation.
      (let ((handle (Object/create fiber)))
        (put handle :then (lambda (resolve reject)
          (js-call (awaitFiber fiber) :then (lambda () (funcall resolve fiber)) reject))) handle)))
  (defun provideService (context name value check)
    (let* ((engine (engineOf context)) (owner (field context "fiber")) (key (labelOf context name))
      (services (field engine "services")) (declarations (field engine "declarations")))
      (when (and (js-call declarations :has name)
        (not (= (field (js-call declarations :get name) "type") "service")))
        (throw (rackError "PROPERTY_CONFLICT" (str "Context property is already declared: " name))))
      (js-call owner :effect (lambda ()
        (when (js-call services :has key) (throw (rackError "DUPLICATE_SERVICE" (str "Service already provided: " name))))
        (let ((record (js-object :name name :value value :check check :owner owner)))
          (js-call declarations :set name (js-object :type "service"))
          (js-call services :set key record)
          (js-call (field owner "store") :set name record)
          (js-call (field owner "provided") :add name)
          (notifyServices engine)
          (async ()
            (when (eq (js-call services :get key) record) (js-call services :delete key))
            (notifyServices engine)
            (let ((tasks (js-array)))
              (js-call (field engine "fibers") :forEach (lambda (fiber)
                (when (and (not (eq fiber owner)) (object-has? (field fiber "inject") name) (field fiber "task"))
                  (js-call tasks :push (field fiber "task")))))
              (await (Promise/allSettled tasks)))
            (js-call (field owner "store") :delete name)
            (js-call (field owner "provided") :delete name)))) (str "provide:" name))))
  (defun makeLogger (context &optional requested)
    (let* ((engine (engineOf context)) (intercepts (field context "_intercepts"))
      (configs (js-array)) (service nil) (settings (js-object)))
      (while intercepts
        (when (object-has? intercepts "logger") (js-call configs :unshift (field intercepts "logger")))
        (setq intercepts (Object/getPrototypeOf intercepts)))
      (js-call configs :forEach (lambda (part) (Object/assign settings part)))
      (setq service (hostMethod (lambda (receiver args) (makeLogger context (aref args 0)))))
      (let ((named (Logger (js-object :name (or requested (field settings "name")
          (field (field context "fiber") "name") "root")
        :level (field settings "level") :meta (js-object :fiber (new globalThis.WeakRef (field context "fiber")))) engine)))
        (js-call (js-array "error" "info" "warn" "debug" "extend") :forEach
          (lambda (key) (put service key (field named key)))))
      (put service :exporter (lambda (exporter)
        (let ((id (1+ (field engine "exporterSerial"))))
          (put engine :exporterSerial id)
          (js-call (field context "fiber") :effect (lambda ()
            (js-call (field engine "exporters") :set id exporter)
            (lambda () (js-call (field engine "exporters") :delete id)))))))
      (put service :exporters (field engine "exporters"))
      (accessor service "buffer" (lambda () (field engine "logBuffer")))
      (accessor service "bufferSize" (lambda () (field engine "logBufferSize"))
        (lambda (size) (put engine :logBufferSize size)))
      service))
  (defun makeContext (engine parent owner &optional metadata)
    (let* ((target (Object/create (if parent (field parent "_target") nil)))
      (scope (Object/create (if parent (field parent "_scope") nil)))
      (intercepts (Object/create (if parent (field parent "_intercepts") nil)))
      (context nil) (reflection (js-object)) (registry (js-object)))
      (Object/assign target (js-object :_rack engine :_scope scope :_intercepts intercepts
        :_origin (field metadata "_origin" (and parent (field parent "_origin"))) :_trace (new globalThis.WeakMap) :fiber owner :root (if parent (field parent "root") nil)))
      (define target "_target" target)
      (when metadata (Object/defineProperties target (Object/getOwnPropertyDescriptors metadata)))
      (put target (field symbols "brand") t)
      (put target (field symbols "isolate") scope)
      (put target (field symbols "intercept") intercepts)
      (setq context (new globalThis.Proxy target (js-object
        :get (lambda (raw key receiver)
          (cond ((Reflect/has raw key) (Reflect/get raw key receiver))
            ((or (= key "then") (= key "toJSON")) undefined)
            ((= (kind key) "symbol") undefined)
            (t (let ((declared (js-call (field engine "declarations") :get key)))
              (if (= (field declared "type") "accessor")
                (invoke (field declared "get") context (js-array context (new globalThis.Error)))
                (if (= (field owner "uid") 0) (js-call target :get key false)
                  (emitEvent context "waterfall" (js-array "internal/get" context key (new globalThis.Error)
                    (lambda () (serviceRead context key false))))))))))
        :set (lambda (raw key value receiver)
          (let ((declared (js-call (field engine "declarations") :get key)))
            (cond ((and declared (= (field declared "type") "service"))
              (emitEvent context "waterfall" (js-array "internal/set" context key value (new globalThis.Error)
                (lambda () (js-call reflection :set key value)))))
              ((and declared (= (field declared "type") "accessor"))
                (if (field declared "set") (invoke (field declared "set") context (js-array value context (new globalThis.Error))) false))
              ((or (Reflect/has raw key) (= (field owner "uid") 0) (= (kind key) "symbol")) (Reflect/set raw key value receiver))
              (t (throw (rackError "MISSING_PROVIDER" (str "Context property must be provided: " key)))))))
        :has (lambda (raw key) (or (Reflect/has raw key) (js-call (field engine "declarations") :has key))))))
      (unless parent (put target :root context))
      (put target :extend (lambda (&optional meta) (makeContext engine context owner meta)))
      (put target :isolate (lambda (name &optional label)
        (let ((child (makeContext engine context owner)))
          (put (field child "_scope") name (or label (funcall globalThis.Symbol name))) child)))
      (put target :intercept (lambda (name config)
        (let ((child (makeContext engine context owner))) (put (field child "_intercepts") name config) child)))
      (put target :get (lambda (name &optional strict)
        (let ((record (implementation context name (eq strict false))))
          (if record (traceValue context (field record "value")) undefined))))
      (put target :provide (lambda (name &optional value check) (provideService context name value check)))
      (put target :effect (lambda (execute &optional label) (js-call owner :effect execute label)))
      (put target :plugin (lambda (plugin &rest configs) (createFiber context plugin (aref configs 0))))
      (put target :inject (lambda (dependencies callback)
        (createFiber context (js-object :name (or (field callback "name") "injection") :inject dependencies :apply callback) undefined)))
      (put target :on (lambda (name callback &optional options) (onEvent context name callback options false)))
      (put target :once (lambda (name callback &optional options) (onEvent context name callback options t)))
      (js-call (js-array "emit" "parallel" "serial" "bail" "waterfall") :forEach (lambda (mode)
        (put target mode (lambda (&rest args) (emitEvent context mode args)))))
      (put reflection :get (field target "get"))
      (put reflection :provide (field target "provide"))
      (put reflection :trace (lambda (value) (traceValue context value)))
      (put reflection :bind (lambda (callback)
        (new globalThis.Proxy callback (js-object
          :apply (lambda (fn receiver args)
            (invoke fn (traceValue context receiver) (js-call args :map (lambda (arg) (traceValue context arg)))))
          :construct (lambda (fn args ctor)
            (Reflect/construct fn (js-call args :map (lambda (arg) (traceValue context arg))) ctor))))))
      (put reflection :set (lambda (name value &optional error)
        (let ((record (implementation context name t)))
          (unless (and record (eq (field record "owner") owner))
            (throw (rackError "MISSING_PROVIDER" (str "Only the owning plugin may write service: " name))))
          (put record :value value) t)))
      (put reflection :accessor (lambda (name options)
        (js-call owner :effect (lambda ()
          (when (js-call (field engine "declarations") :has name) (throw (rackError "PROPERTY_CONFLICT" name)))
          (js-call (field engine "declarations") :set name (Object/assign (js-object :type "accessor") options))
          (lambda () (js-call (field engine "declarations") :delete name))))))
      (put reflection :mixin (lambda (source names)
        (let ((cleanups (js-array))
          (entries (if (Array/isArray names) (js-call names :map (lambda (name) (js-array name name))) (Object/entries names))))
          (js-call entries :forEach (lambda (entry)
            (let ((from (aref entry 0)) (to (aref entry 1)))
              (js-call cleanups :push (js-call reflection :accessor to (js-object
                :get (hostMethod (lambda (receiver args)
                  (let* ((service (if (= (kind source) "string") (Reflect/get receiver source) source))
                    (value (field service from)))
                    (if (= (kind value) "function") (js-call value :bind service) value))))
                :set (hostMethod (lambda (receiver args)
