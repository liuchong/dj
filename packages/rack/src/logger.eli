(module rack.logger
  (import "./util.eli" kind field invoke define)
  (import "./tracking.eli" hostMethod)
  (defconst LoggerLevel (Object/freeze (js-object :ERROR 0 :INFO 1 :WARN 2 :DEBUG 3)))
  (defconst c16 (js-array 6 2 3 4 5 1))
  (defconst c256 (js-array 20 21 26 27 32 33 38 39 40 41 42 43 44 45 56 57 62 63 68 69 74 75 76 77 78 79 80 81 92 93 98 99 112 113 129 134 135 148 149 160 161 162 163 164 165 166 167 168 169 170 171 172 173 178 179 184 185 196 197 198 199 200 201 202 203 204 205 206 207 208 209 214 215 220 221))
  (defun color (exporter code value &optional decoration)
    (if (not (> (field exporter "colors" 0) 0)) (str value)
      (str "\u001b[3" (if (< code 8) code (str "8;5;" code))
        (if (>= (field exporter "colors") 2) (or decoration "") "") "m" value "\u001b[0m")))
  (defun code (name &optional level)
    (let ((hash 0) (index 0) (palette (if (>= level 2) c256 c16)))
      (while (< index (js-length name))
        (setq hash (Math/imul (+ (* hash 7) (js-call name :charCodeAt index) 13) 1) index (1+ index)))
      (when (> level 0) (aref palette (% (Math/abs hash) (js-length palette))))))
  (defconst defaultFormatters (js-object
    :s (lambda (value) (str value)) :d (lambda (value) (Math/trunc (funcall globalThis.Number value)))
    :i (lambda (value) (Math/trunc (funcall globalThis.Number value))) :f (lambda (value) (funcall globalThis.Number value))
    :o (lambda (value) (JSON/stringify value)) :O (lambda (value) (JSON/stringify value))
    :c (lambda () "") :C (lambda (value exporter message)
      (color exporter (code (field message "name") (field exporter "colors")) value))))
  (defun format (exporter message)
    (let* ((args (js-call (field message "args") :slice)) (head (aref args 0)) (text ""))
      (cond ((js-call globalThis.Error globalThis.Symbol.hasInstance head)
        (js-call args :splice 0 1 (or (field head "stack") (field head "message"))) (js-call args :unshift "%s"))
        ((not (= (kind head) "string")) (js-call args :unshift "%o")))
      (setq text (js-call (js-call args :shift) :replace (new globalThis.RegExp "%([a-zA-Z%])" "g")
        (lambda (match letter)
          (if (= letter "%") "%"
            (let ((formatter (field (field exporter "formatters") letter (field defaultFormatters letter))))
              (if (= (kind formatter) "function")
                (funcall formatter (js-call args :shift) exporter message) match))))))
      (js-call args :forEach (lambda (arg)
        (setq text (str text " " (if (and arg (= (kind arg) "object"))
          (funcall (field (field exporter "formatters") "o" (field defaultFormatters "o")) arg exporter message) arg)))))
      (js-call (js-call (js-call text :split (new globalThis.RegExp "\\r?\\n" "g")) :map
        (lambda (line) (let ((maximum (field exporter "maxLength" 10240)))
          (str (js-call line :slice 0 maximum) (if (> (js-length line) maximum) "..." ""))))) :join "\n")))
  (defun send (self severity level args)
    (let ((first (aref args 0)) (service (field self "_service")))
      (when (and (= (js-length args) 1) (js-call globalThis.Error globalThis.Symbol.hasInstance first))
        (cond ((field first "cause") (send self severity level (js-array (field first "cause"))))
          ((Array/isArray (field first "errors"))
            (js-call (field first "errors") :forEach (lambda (error) (send self severity level (js-array error))))
            (setq args nil))))
      (when args
        (put service :_snMessage (1+ (field service "_snMessage" 0)))
        (let ((serial (field service "_snMessage")) (timestamp (Date/now)))
          (js-call (field service "exporters") :forEach (lambda (exporter)
            (let* ((levels (field exporter "levels"))
              (threshold (field levels (field self "name") (field levels "default" (field self "level" 1)))))
              (when (>= threshold level)
                (js-call exporter :export (Object/assign
                  (js-object :sn serial :ts timestamp :type severity :level level :name (field self "name"))
                  (field self "meta") (js-object :args args)))))))))))
  (defun Logger (options service)
    (let ((self (Object/assign (Object/create (field Logger "prototype"))
      (js-object :_service service) options)))
      (js-call (js-array "error" "info" "warn" "debug") :forEach (lambda (severity level)
        (put self severity (lambda (&rest args) (send self severity level args))))) self))
  (js-call (js-array "error" "info" "warn" "debug") :forEach (lambda (severity level)
    (define (field Logger "prototype") severity (hostMethod (lambda (receiver args) (send receiver severity level args))))))
  (define (field Logger "prototype") "extend" (hostMethod (lambda (receiver args)
    (Logger (Object/assign (js-object) receiver (js-object :name (str (field receiver "name") ":" (aref args 0)))) (field receiver "_service")))))
  (put Logger :format format) (put Logger :code code) (put Logger :color color)
  (export Logger LoggerLevel defaultFormatters c16 c256))
