(module rack.util
  (defun kind (value) (js* "typeof value"))
  (defun field (object key &rest defaults)
    (let ((fallback (aref defaults 0)))
      (if (or (nil? object) (undefined? object)) fallback
        (let ((value (Reflect/get (funcall globalThis.Object object) key)))
          (if (undefined? value) fallback value)))))
  (defun objectLike (value)
    (and (not (nil? value)) (not (undefined? value))
      (or (= (kind value) "object") (= (kind value) "function"))))
  (defun thenable (value) (and (objectLike value) (= (kind (field value "then")) "function")))
  (defun bailed (value) (and (not (nil? value)) (not (undefined? value)) (not (eq value false))))
  (defun invoke (callback receiver args) (Reflect/apply callback receiver args))
  (defun constructable (callback)
    (if (and (= (kind callback) "function") (field callback "prototype"))
      (try (Reflect/construct globalThis.String (js-array) callback) t (catch error false)) false))
  (defun define (target key value)
    (Object/defineProperty target key (js-object :value value :configurable t :writable t)))
  (defun accessor (target key read &optional write)
    (let ((descriptor (js-object :get read :configurable t :enumerable t)))
      (when write (put descriptor :set write)) (Object/defineProperty target key descriptor)))
  (defconst symbols (Object/freeze (js-object
    :shadow (js-call globalThis.Symbol :for "rack.shadow")
    :receiver (js-call globalThis.Symbol :for "rack.receiver")
    :checkProto (js-call globalThis.Symbol :for "rack.checkProto")
    :brand (js-call globalThis.Symbol :for "rack.context") :effect (js-call globalThis.Symbol :for "rack.effect")
    :filter (js-call globalThis.Symbol :for "rack.filter") :isolate (js-call globalThis.Symbol :for "rack.isolate")
    :intercept (js-call globalThis.Symbol :for "rack.intercept") :tracker (js-call globalThis.Symbol :for "rack.tracker")
    :original (js-call globalThis.Symbol :for "rack.original") :init (js-call globalThis.Symbol :for "rack.init")
    :check (js-call globalThis.Symbol :for "rack.check") :invoke (js-call globalThis.Symbol :for "rack.invoke")
    :config (js-call globalThis.Symbol :for "rack.config") :extend (js-call globalThis.Symbol :for "rack.extend")
    :resolveConfig (js-call globalThis.Symbol :for "rack.resolveConfig") :initHooks (js-call globalThis.Symbol :for "rack.initHooks")
    :metadata (js-call globalThis.Symbol :for "rack.metadata"))))
  (defun DisposableList ()
    (let ((values (new globalThis.Map)) (weak (new globalThis.WeakMap)) (serial 0) (self (js-object)))
      (put self :push (lambda (value)
        (setq serial (1+ serial))
        (let ((id serial)) (js-call values :set id value) (js-call weak :set value id) (lambda () (js-call values :delete id)))))
      (put self :delete (lambda (value)
        (let ((id (js-call weak :get value))) (if id (js-call values :delete id) false))))
      (put self :clear (lambda ()
        (let ((result (js-call (Array/from (js-call values :values)) :reverse)))
          (js-call values :clear) result)))
      (put self globalThis.Symbol.iterator (lambda () (js-call values :values)))
      (put self (js-call globalThis.Symbol :for "nodejs.util.inspect.custom") (lambda () (Array/from self)))
      (accessor self "length" (lambda () (field values "size"))) self))
  (defun joinPrototype (primary fallback)
    (if (or (nil? primary) (eq primary (field globalThis.Object "prototype"))) fallback
      (let ((result (Object/create (joinPrototype (Object/getPrototypeOf primary) fallback))))
        (Object/defineProperties result (Object/getOwnPropertyDescriptors primary)) result)))
  (defun getPropertyDescriptor (target key)
    (let ((cursor target) (descriptor nil))
      (while (and cursor (not descriptor))
        (setq descriptor (Object/getOwnPropertyDescriptor cursor key) cursor (Object/getPrototypeOf cursor))) descriptor))
  (defun withProps (target properties)
    (if (not properties) target
      (new globalThis.Proxy target (js-object
        :get (lambda (object key receiver)
          (Reflect/get (if (and (not (= key "constructor")) (Reflect/has properties key)) properties object) key receiver))
        :set (lambda (object key value receiver)
          (Reflect/set (if (and (not (= key "constructor")) (Reflect/has properties key)) properties object) key value receiver))))))
  (defun buildOuterStack (&optional offset)
    (let ((error (new globalThis.Error)))
      (lambda () (js-call (js-call (field error "stack" "") :split "\n") :slice (+ 3 (or offset 0))))))
  (defun composeError (callback &optional supplied)
    (let* ((outer (or supplied (buildOuterStack))) (info (js-object :offset 1 :error (new globalThis.Error)))
      (fail (lambda (reason)
        (let* ((valid (= (kind (field reason "stack")) "string"))
          (error (if valid reason (new globalThis.Error reason)))
          (lines (js-call (field error "stack" "") :split "\n"))
          (needle (aref (js-call (field (field info "error") "stack" "") :split "\n") 2))
          (index (if valid (js-call lines :indexOf needle) 1)))
          (when (>= index 0)
            (when valid (setq index (- index (field info "offset"))))
            (while (and (> index 0) (js-call (aref lines (- index 1)) :endsWith " (<anonymous>)"))
              (setq index (- index 1)))
            (let ((frames (js-call (js-call lines :slice 0 index) :concat (funcall outer))))
              (put error :stack (js-call frames :join "\n"))))
          (throw error)))))
      (try
        (let ((answer (funcall callback info)))
          (if (and (objectLike answer) (Reflect/has answer "then"))
            (js-call answer :then undefined fail) answer))
        (catch reason (funcall fail reason)))))
  (export kind field objectLike thenable bailed invoke constructable define accessor symbols DisposableList withProps joinPrototype getPropertyDescriptor buildOuterStack composeError))
