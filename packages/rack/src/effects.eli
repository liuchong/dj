(module rack.effects
  (import "./util.eli" kind field objectLike thenable invoke define symbols composeError buildOuterStack)
  (import "./errors.eli" RackError)
  (defconst inertia (new globalThis.WeakMap))
  (defconst records (new globalThis.WeakMap))
  (defun getEffectRecord (dispose) (js-call records :get dispose))
  (defun runDisposable (dispose)
    (let ((result (funcall dispose)) (join (js-call inertia :get dispose)))
      (if join (or (funcall join) result) result)))
  (defun reportCleanup (owner error)
    (js-call (field owner "errors") :push error)
    (when (field owner "ctx") (js-call (field (field owner "ctx") "logger") :error error)))
  (defun createEffect (owner execute label &optional outer)
    (when (or (eq (field owner "uid") nil) (= (field owner "state") 5))
      (throw (RackError "INACTIVE_EFFECT")))
    (unless (= (kind execute) "function") (throw (new globalThis.TypeError "Effect setup must be callable")))
    (let ((steps (js-array)) (live t) (executing t) (failed false)
      (cleaning false) (cleanupTask undefined) (inflight undefined) (setupTask undefined)
      (barrier nil) (release nil) (reject nil) (dispose nil) (finish nil) (clean nil)
      (record (js-object :owner owner :label (or label "anonymous") :children (js-array)))
      (setupOuter (or outer (buildOuterStack))))
      (setq clean (lambda ()
        (unless cleaning
          (setq cleaning t)
          (let ((pending undefined) (items (js-call (js-call steps :splice 0) :reverse)))
            (js-call items :forEach (lambda (cleanup)
              (if pending (setq pending (js-call pending :then (lambda () (runDisposable cleanup))))
                (let ((answer (runDisposable cleanup)))
                  (when (thenable answer) (setq pending answer))))))
            (setq cleanupTask pending))) cleanupTask))
      (setq finish (lambda (callback)
        (try
          (let ((answer (funcall callback)))
            (if (thenable answer)
              (let ((pending nil))
                (setq pending (js-call (Promise/resolve answer) :finally (lambda ()
                  (js-call (field owner "effects") :delete record)
                  (when (eq inflight pending) (setq inflight undefined)))))
                (setq inflight pending) pending)
              (progn (js-call (field owner "effects") :delete record) answer)))
          (catch error (js-call (field owner "effects") :delete record) (throw error)))))
      (setq dispose (lambda ()
        (if (not live) (if failed inflight undefined)
          (progn
            (setq live false)
            (funcall finish (lambda ()
              (let ((setup (if executing
                (progn
                  (unless barrier (setq barrier (new globalThis.Promise (lambda (resolve rejectSetup)
                    (setq release resolve reject rejectSetup))))) barrier)
                setupTask)))
                (if setup
                  (js-call (Promise/resolve setup) :then clean (async (error) (await (funcall clean)) (throw error)))
                  (funcall clean)))))))))
      (put record :dispose (lambda () (runDisposable dispose)))
      (define dispose (field symbols "effect") (js-object :label (field record "label") :children (field record "children")))
      (js-call inertia :set dispose (lambda () inflight))
      (put record :public dispose) (js-call records :set dispose record)
      (js-call (field owner "effects") :add record)
      (let ((collect (lambda (cleanup)
        (unless (or (nil? cleanup) (undefined? cleanup))
          (unless (= (kind cleanup) "function") (throw (new globalThis.TypeError "Invalid effect cleanup")))
          (js-call steps :push cleanup)
          (let ((child (getEffectRecord cleanup)))
            (when (and child (eq (field child "owner") owner))
              (js-call (field owner "effects") :delete child)))
          (when (field cleanup (field symbols "effect"))
            (js-call (field record "children") :push (field cleanup (field symbols "effect"))))))))
        (try
          (setq setupTask (composeError (lambda (info)
            (let ((value (invoke execute owner (js-array))))
              (cond ((= (kind value) "function") (funcall collect value) undefined)
                ((or (nil? value) (undefined? value)) undefined)
                ((and (objectLike value) (Reflect/has value "then"))
                  (js-call value :then (lambda (answer) (funcall collect answer) undefined)))
                ((= (kind (field value globalThis.Symbol.iterator)) "function")
                  (let ((iterator (js-call value globalThis.Symbol.iterator)) (done false))
                    (while (not done)
                      (let ((row (js-call iterator :next)))
                        (funcall collect (field row "value")) (setq done (field row "done"))))) undefined)
                ((= (kind (field value globalThis.Symbol.asyncIterator)) "function")
                  (funcall (async ()
                    (await (Promise/resolve))
                    (let ((iterator (js-call value globalThis.Symbol.asyncIterator)) (done false))
                      (while (and live (not done))
                        (let ((row (await (js-call iterator :next))))
                          (funcall collect (field row "value")) (setq done (field row "done"))))))))
                (t (throw (new globalThis.TypeError "Invalid effect setup result")))))) setupOuter))
          (catch error
            (setq executing false failed t live false)
            (try
              (let ((rollback (funcall finish clean)))
                (when (thenable rollback) (js-call rollback :catch (lambda (failure)
                  (reportCleanup owner failure)))))
              (finally (when reject (funcall reject error))))
            (throw error))))
      (setq executing false)
      (when barrier (js-call (Promise/resolve setupTask) :then release reject))
      (when (thenable setupTask)
        (js-call (js-call setupTask :catch (lambda ()
          (if live (funcall finish clean) (funcall clean)))) :catch (lambda (error)
            (reportCleanup owner error))))
      (put dispose :then (lambda (resolve rejectSetup)
        (js-call (js-call (Promise/resolve setupTask) :then (lambda ()
          (lambda () (when live (setq live false) (funcall finish clean))))) :then resolve rejectSetup)))
      dispose))
  (export createEffect runDisposable getEffectRecord))
