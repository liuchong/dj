(module rack.effects
  (import "./util.eli" kind field objectLike thenable invoke rackError symbols)
  (defun createEffect (owner execute label)
    (when (or (eq (field owner "uid") nil) (= (field owner "state") "unloading"))
      (throw (rackError "INACTIVE_EFFECT" "Cannot register resources on an inactive plugin")))
    (unless (= (kind execute) "function") (throw (new globalThis.TypeError "Effect setup must be callable")))
    (let ((collected (js-array)) (setup nil)
      (closing false) (inflight nil) (setupError nil) (resolveSetup nil)
      (record (js-object :label (or label "anonymous") :children (js-array))) (dispose nil))
      ;; Install ownership before executing setup, including reentrant unload.
      (setq setup (new globalThis.Promise (lambda (resolve) (setq resolveSetup resolve))))
      (put record :setup setup)
      (setq dispose (lambda ()
        (unless closing
          (setq closing t)
          (setq inflight (js-call setup :then (async ()
            (let ((failures (js-array)) (i (- (js-length collected) 1)))
              (while (>= i 0)
                (try (await (funcall (aref collected i))) (catch error (js-call failures :push error)))
                (setq i (- i 1)))
              (js-call (field owner "effects") :delete record)
              (when (> (js-length failures) 0)
                (throw (new globalThis.AggregateError failures "Resource cleanup failed")))
              (when setupError (throw setupError)))))))
        inflight))
      (put record :dispose dispose)
      (put dispose (field symbols "effect") record)
      (js-call (field owner "effects") :add record)
      (let ((collect nil) (consume nil))
        (setq collect (lambda (cleanup)
          (unless (or (nil? cleanup) (undefined? cleanup))
            (unless (= (kind cleanup) "function")
              (throw (new globalThis.TypeError "An effect must produce cleanup functions")))
            (js-call collected :push cleanup)
            (when (field cleanup (field symbols "effect"))
              (let ((child (field cleanup (field symbols "effect"))))
                (js-call (field owner "effects") :delete child)
                (js-call (field record "children") :push child))))))
        (setq consume (lambda (value)
          (cond ((or (nil? value) (undefined? value)) nil)
            ((= (kind value) "function") (collect value))
            ((thenable value) (js-call value :then (lambda (answer) (consume answer))))
            ((= (kind (field value globalThis.Symbol.asyncIterator)) "function")
              (funcall (async ()
                (let ((iterator (js-call value globalThis.Symbol.asyncIterator)) (done false))
                  (while (and (not done) (not closing))
                    (let ((next (await (js-call iterator :next))))
                      (setq done (field next "done")) (collect (field next "value"))))
                  (when (and (not done) (field iterator "return"))
                    (collect (field (await (js-call iterator :return)) "value")))))))
            ((= (kind (field value globalThis.Symbol.iterator)) "function")
              (let ((iterator (js-call value globalThis.Symbol.iterator)) (done false))
                (while (not done)
                  (let ((next (js-call iterator :next)))
                    (setq done (field next "done")) (collect (field next "value"))))))
            (t (throw (new globalThis.TypeError "Invalid effect setup result"))))))
        (try
          (let ((answer (consume (funcall execute))))
            (if (thenable answer)
              (js-call (Promise/resolve answer) :then
                (lambda () (funcall resolveSetup))
                (lambda (error) (setq setupError error) (funcall resolveSetup)
                  (js-call (funcall dispose) :catch (lambda (failure) (js-call (field owner "errors") :push failure)))))
              (progn (funcall resolveSetup))))
          (catch error
            (setq setupError error) (funcall resolveSetup)
            (js-call (funcall dispose) :catch (lambda (failure) (js-call (field owner "errors") :push failure)))
            (throw error))))
      ;; Awaiting a disposer waits for acquisition; calling it starts cleanup.
      (put dispose :then (lambda (resolve reject)
        (js-call setup :then (lambda () (if setupError (funcall reject setupError) (let ((answer (lambda () (funcall dispose))))
                  (put answer (field symbols "effect") record) (funcall resolve answer)))))))
      dispose))
  (export createEffect))
