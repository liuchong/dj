(module rack.loader
  (import "./util.eli" field kind objectLike rackError)
  (defun validateEntries (entries)
    (unless (Array/isArray entries) (throw (new globalThis.TypeError "Plugin configuration must be an array")))
    (let ((ids (new globalThis.Set)) (index 0))
      (while (< index (js-length entries))
        (let ((entry (aref entries index)))
          (unless (and (object-has? entries index) (objectLike entry) (not (Array/isArray entry))
            (= (kind (field entry "id")) "string") (> (js-length (field entry "id")) 0)
            (not (js-call ids :has (field entry "id"))))
            (throw (new globalThis.TypeError "Plugin entries require unique nonempty ids")))
          (js-call ids :add (field entry "id"))
          (when (field entry "plugins") (validateEntries (field entry "plugins"))))
        (setq index (1+ index))) entries))
  (defun applyEntryPatches (entries patches)
    (validateEntries entries)
    (unless (Array/isArray patches) (throw (new globalThis.TypeError "Patches must be an array")))
    (let ((result (js-call entries :map (lambda (entry) (Object/assign (js-object) entry)))))
      (js-call patches :forEach (lambda (patch)
        (unless (and (objectLike patch) (not (Array/isArray patch)))
          (throw (new globalThis.TypeError "Invalid entry patch")))
        (let* ((id (field patch "id")) (index (js-call result :findIndex (lambda (entry) (= (field entry "id") id)))))
          (cond
            ((field patch "insert")
              (let* ((added (field patch "insert")) (items (if (Array/isArray added) added (js-array added)))
                (before (field patch "before")) (after (field patch "after"))
                (anchor (or before after))
                (found (if anchor (js-call result :findIndex (lambda (entry) (= (field entry "id") anchor))) (js-length result)))
                (at (+ found (if after 1 0))))
                (when (< found 0) (throw (rackError "UNKNOWN_ENTRY" "Patch insertion target is absent")))
                (js-call items :forEach (lambda (entry offset)
                  (js-call result :splice (+ at offset) 0 (Object/assign (js-object) entry))))))
            ((< index 0) (throw (rackError "UNKNOWN_ENTRY" (str "Unknown plugin entry: " id))))
            ((field patch "remove") (js-call result :splice index 1))
            (t (let ((entry (Object/assign (js-object) (aref result index) patch)))
              (Reflect/deleteProperty entry "remove") (js-call result :splice index 1 entry)))))
          (validateEntries result))) result))
  (defun createLoader (context &optional options)
    (let ((records (new globalThis.Map)) (serial (Promise/resolve)) (closed false) (closing nil)
      (resolveModule (or (field options "resolve") (async (specifier) (js* "import(specifier)"))))
      (resolveEntries nil) (applyPrepared nil) (enqueue nil))
      (setq resolveEntries (async (entries)
        (validateEntries entries)
        (let ((prepared (js-array)) (index 0))
          ;; Recursively preflight the entire candidate before mutating live fibers.
          (while (< index (js-length entries))
            (let* ((entry (aref entries index)) (plugin (field entry "plugin")) (children nil))
              (unless (field entry "disabled")
                (if (field entry "plugins") (setq children (await (resolveEntries (field entry "plugins"))))
                  (progn
                    (unless plugin
                      (unless (= (kind (field entry "name")) "string")
                        (throw (new globalThis.TypeError "A plugin entry needs a plugin or module name")))
                      (let ((module (await (funcall resolveModule (field entry "name")))))
                        (setq plugin (field module "default" module))))
                    (unless (or (= (kind plugin) "function") (= (kind (field plugin "apply")) "function"))
                      (throw (new globalThis.TypeError "Resolved module has no plugin entrypoint"))))))
              (js-call prepared :push (js-object :entry entry :plugin plugin :children children)))
            (setq index (1+ index))) prepared)))
      (setq applyPrepared (async (prepared)
        (let ((wanted (new globalThis.Map)))
          (js-call prepared :forEach (lambda (row) (js-call wanted :set (field (field row "entry") "id") row)))
          (let ((old (js-call (Array/from (js-call records :entries)) :reverse)))
            (let ((index 0))
              (while (< index (js-length old))
                (let* ((pair (aref old index)) (id (aref pair 0)) (record (aref pair 1))
                  (candidate (js-call wanted :get id)) (entry (field candidate "entry")))
                  (when (or (not candidate) (field entry "disabled")
                    (not (eq (field record "plugin") (field candidate "plugin")))
                    (not (eq (field (field record "entry") "isolate") (field entry "isolate")))
                    (not (eq (field (field record "entry") "plugins") (field entry "plugins"))))
                    (await (js-call (field record "fiber") :dispose)) (js-call records :delete id)))
                (setq index (1+ index)))))
          (let ((index 0))
            (while (< index (js-length prepared))
              (let* ((row (aref prepared index)) (entry (field row "entry")) (id (field entry "id"))
                (existing (js-call records :get id)))
                (unless (field entry "disabled")
                  (if existing
                    (unless (eq (field existing "config") (field entry "config"))
                      (await (js-call (field existing "fiber") :update (field entry "config")))
                      (put existing :config (field entry "config")))
                    (let ((scope context))
                      (js-call (or (field entry "isolate") (js-array)) :forEach
                        (lambda (name) (setq scope (js-call scope :isolate name))))
                      (let* ((nested (field row "children"))
                        (plugin (if nested
                          (js-object :name id :apply (async (ctx config)
                            (let ((child (createLoader ctx options)))
                              (js-call ctx :effect (lambda () (lambda () (js-call child :close))))
                              (await (js-call child :applyPrepared nested)) nil)))
                          (field row "plugin")))
                        (fiber (js-call scope :plugin plugin (field entry "config"))))
                        (js-call records :set id (js-object :entry entry :plugin (field row "plugin")
                          :config (field entry "config") :fiber fiber)))))))
              (setq index (1+ index))))
          (await (Promise/all (js-call (Array/from (js-call records :values)) :map
            (lambda (record) (js-call (field record "fiber") :await)))))
          (Array/from (js-call records :keys)))))
      (setq enqueue (lambda (prepare)
        (when closed (throw (rackError "LOADER_CLOSED" "Loader is closed")))
        (let ((result (js-call (js-call serial :catch (lambda (error) nil)) :then
          (async () (await (applyPrepared (await (funcall prepare))))))))
          (setq serial result) result)))
      (js-object
        :apply (lambda (entries) (funcall enqueue (lambda () (resolveEntries entries))))
        :applyPrepared (lambda (prepared) (funcall enqueue (lambda () prepared)))
        :inspect (lambda () (js-call (Array/from (js-call records :entries)) :map (lambda (pair)
          (js-object :id (aref pair 0) :state (field (field (aref pair 1) "fiber") "state")))))
        :close (lambda ()
          (unless closing
            (setq closed t closing (funcall (async ()
              (await (js-call serial :catch (lambda (error) nil)))
              (let ((values (js-call (Array/from (js-call records :values)) :reverse)) (index 0))
                (while (< index (js-length values))
                  (await (js-call (field (aref values index) "fiber") :dispose)) (setq index (1+ index))))
              (js-call records :clear))))) closing))))
  (export createLoader applyEntryPatches validateEntries))
