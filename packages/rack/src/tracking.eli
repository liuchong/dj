(module rack.tracking
  (import "./util.eli" field kind objectLike invoke define getPropertyDescriptor symbols withProps)
  (defconst hostMethod (js* "(work) => function (...args) { return work(this, args); }"))
  (defun withProp (target key value)
    (let ((overlay (Object/create nil)))
      (Object/defineProperty overlay key (js-object :value value :writable false))
      (withProps target overlay)))
  (defun shadowReceiver (context target property receiver)
    (let* ((descriptor (and property (Object/getOwnPropertyDescriptor target property)))
      (origin (field descriptor "value")))
      (if (not origin) receiver
        (withProp receiver property (js-call context :extend (js-object (field symbols "shadow") origin))))))
  (defun invokeTraceable (proxy target receiver args)
    (let ((body (field target (field symbols "invoke"))))
      (if body (invoke body proxy args) (invoke target receiver args))))
  (defun createTraceable (supplied value tracker)
    (let ((context supplied) (proxy nil))
      (when (and (field context (field symbols "shadow")) (not (field tracker "noShadow")))
        (setq context (Object/getPrototypeOf context)))
      (setq proxy (new globalThis.Proxy value (js-object
        :get (lambda (target key receiver)
          (cond
            ((eq key (field symbols "original")) target)
            ((eq key (field tracker "property")) context)
            ((= (kind key) "symbol") (Reflect/get target key receiver))
            (t (let* ((associated (field tracker "associate"))
              (name (and associated (str associated "." key)))
              (props (and name (field (field context "reflect") "props"))))
              (if (and name (field props name))
                (Reflect/get context name (withProp context (field symbols "receiver") receiver))
                (let* ((descriptor (getPropertyDescriptor target key)) (shadow nil)
                  (member (if (and descriptor (object-has? descriptor "value")) (field descriptor "value")
                    (progn (setq shadow (shadowReceiver context target (field tracker "property") receiver))
                      (Reflect/get target key shadow)))))
                  (cond ((field member (field symbols "tracker"))
                    (createTraceable context member (field member (field symbols "tracker"))))
                    ((and (not (field tracker "noShadow")) (= (kind member) "function"))
                      (unless shadow (setq shadow (shadowReceiver context target (field tracker "property") receiver)))
                      (new globalThis.Proxy member (js-object :apply (lambda (method self args)
                        (getTraceable context (invoke method (if (eq self receiver) shadow self) args))))))
                    (t member))))))))
        :set (lambda (target key answer receiver)
          (cond ((or (eq key (field symbols "original")) (eq key (field tracker "property"))) false)
            ((= (kind key) "symbol") (Reflect/set target key answer receiver))
            (t (let* ((associated (field tracker "associate")) (name (and associated (str associated "." key))))
              (if (and name (field (field (field context "reflect") "props") name))
                (Reflect/set context name answer (withProp context (field symbols "receiver") receiver))
                (Reflect/set target key answer (shadowReceiver context target (field tracker "property") receiver)))))))
        :apply (lambda (target receiver args) (invokeTraceable proxy target receiver args))))) proxy))
  (defun getTraceable (context value)
    (cond ((not (objectLike value)) value)
      ((object-has? value (field symbols "shadow")) (Object/getPrototypeOf value))
      ((field value (field symbols "tracker")) (createTraceable context value (field value (field symbols "tracker"))))
      (t value)))
  (defun createCallable (name prototype tracker)
    (let ((self nil))
      (setq self (hostMethod (lambda (receiver args)
        (invokeTraceable (createTraceable (field self "ctx") self tracker) self receiver args))))
      (define self "name" name) (Object/setPrototypeOf self prototype)))
  (export getTraceable createCallable hostMethod))
