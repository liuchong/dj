(module rack.tests.integration
  (import "../src/index.eli" createContext createService Service Context symbols Logger FiberState)
  (import "../src/loader.eli" createLoader applyEntryPatches)
  (import "../src/util.eli" field)
  (import "bun:test" test expect)
  (import "bun:sqlite" Database)
  (import "node:fs/promises" mkdir mkdtemp rm)
  (import "node:path" resolve)
  (defun equal (actual expected) (js-call (expect actual) :toEqual expected))
  (defun is (actual expected) (js-call (expect actual) :toBe expected))
  (defasync rejects (work)
    (let ((caught false)) (try (await (funcall work)) (catch error (setq caught t))) (is caught t)))
  (defun throws (work) (js-call (expect work) :toThrow))
  (test "Rack R01 dependency arrival, replacement, loss and child ownership" (async ()
    (let* ((app (createContext)) (starts (js-array)) (stops (js-array))
      (feature (js-call app :plugin (js-object :name "feature" :inject (js-array "database")
        :apply (lambda (ctx config)
          (let ((value (field (field ctx "database") "value")))
            (js-call starts :push value)
            (lambda () (js-call stops :push value)))))))
      (provider nil))
      (try
        (await feature) (is (field feature "state") (field FiberState "PENDING"))
        (setq provider (js-call app :plugin (js-object :name "database" :apply
          (lambda (ctx config) (js-call ctx :provide "database" (js-object :value 1))))))
        (await provider) (await (js-call app :settle))
        (is (field feature "state") (field FiberState "ACTIVE")) (equal starts (js-array 1))
        (await (js-call provider :dispose)) (await (js-call app :settle))
        (is (field feature "state") (field FiberState "PENDING")) (equal stops (js-array 1))
        (setq provider (js-call app :plugin (js-object :name "replacement" :apply
          (lambda (ctx config) (js-call ctx :provide "database" (js-object :value 2))))))
        (await provider) (await (js-call app :settle))
        (equal starts (js-array 1 2))
        (await (js-call app :dispose))
        (equal stops (js-array 1 2)) (is (field feature "state") (field FiberState "DISPOSED"))
        (throws (lambda () (js-call (field feature "ctx") :effect (lambda () nil))))
        (finally (await (js-call app :dispose)))))) 5000)
  (defun subscribe ()
    (let ((self (js* "this")))
      (is (field (field (field self "ctx") "clock") "value") 42)
      (js-call (field self "ctx") :on "message" (lambda () nil))))
  (test "Rack R02 isolation, inherited metadata and caller-owned tracked resources" (async ()
    (let* ((app (createContext)) (left (js-call app :isolate "number")) (right (js-call app :isolate "number"))
      (consumer nil) (bus nil))
      (try
        (js-call left :provide "number" 1) (js-call right :provide "number" 2)
        (is (js-call left :get "number") 1) (is (js-call right :get "number") 2)
        (is (js-call app :get "number") undefined)
        (let* ((meta (js-call app :extend (js-object :custom "inherited")))
          (child (js-call meta :extend))) (is (field child "custom") "inherited"))
        (js-call app :provide "clock" (js-object :value 42))
        (setq bus (js-call app :plugin (js-object :name "bus" :inject (js-array "clock")
          :apply (lambda (ctx config) (createService ctx "bus" (js-object :subscribe subscribe)) nil))))
        (await bus)
        (setq consumer (js-call app :plugin (js-object :name "consumer" :inject (js-array "bus")
          :apply (lambda (ctx config) (js-call (field ctx "bus") :subscribe) nil))))
        (await consumer)
        (is (js-length (js-call (field app "events") :dispatch "emit" (js-array "message"))) 1)
        (await (js-call consumer :dispose))
        (is (js-length (js-call (field app "events") :dispatch "emit" (js-array "message"))) 0)
        (throws (lambda () (put (field bus "ctx") :clock 7)))
        (finally (await (js-call app :dispose)))))) 5000)
  (test "Rack R03 reentrant asynchronous acquisition and shared disposal" (async ()
    (let ((app (createContext)) (release nil) (cleaned 0) (disposal nil) (effect nil))
      (setq effect (js-call app :effect (lambda ()
        (setq disposal (js-call app :dispose))
        (new globalThis.Promise (lambda (resolve)
          (setq release (lambda () (funcall resolve (lambda () (setq cleaned (1+ cleaned)))))))))))
      (is cleaned 0) (funcall release)
      (await disposal) (await (funcall effect)) (await (funcall effect)) (is cleaned 1)
      (is (field (field app "fiber") "state") (field FiberState "DISPOSED")))) 5000)
  (test "Rack R03 failed initialization rolls back partial listeners and resources" (async ()
    (let* ((errors (js-array)) (app (createContext (js-object :onError (lambda (error) (js-call errors :push error)))))
      (cleaned 0) (feature (js-call app :plugin (js-object :name "broken"
        :apply (lambda (ctx config)
          (js-call ctx :on "leak" (lambda () nil))
          (js-call ctx :effect (lambda () (async () (setq cleaned (1+ cleaned)))))
          (throw (new globalThis.Error "intentional startup failure")))))))
      (try
        (await (rejects (lambda () (js-call feature :await))))
        (await (js-call app :settle))
        (is cleaned 1) (is (field feature "state") (field FiberState "FAILED"))
        (is (js-length (js-call (field app "events") :dispatch "emit" (js-array "leak"))) 0)
        (is (> (js-length errors) 0) t)
        (finally (await (js-call app :dispose)))))) 5000)
  (test "Rack R04 event modes, once reentrancy, scope filters and update interception" (async ()
    (let ((app (createContext)) (order (js-array)) (count 0) (feature nil))
      (try
        (js-call app :on "ordered" (lambda () (js-call order :push "last")))
        (js-call app :on "ordered" (lambda () (js-call order :push "first")) t)
        (js-call app :emit "ordered") (equal order (js-array "first" "last"))
        (js-call app :once "once" (lambda () (setq count (1+ count)) (js-call app :emit "once")))
        (js-call app :emit "once") (is count 1)
        (js-call app :on "bail" (lambda () false)) (js-call app :on "bail" (lambda () 0))
        (js-call app :on "bail" (lambda () (throw (new globalThis.Error "must not run"))))
        (is (js-call app :bail "bail") 0) (is (await (js-call app :serial "bail")) 0)
        (js-call app :on "around" (lambda (next) (str "a" (funcall next) "c")))
        (is (js-call app :waterfall "around" (lambda () "b")) "abc")
        (js-call app :on "parallel" (async () (throw (new globalThis.Error "one"))))
        (js-call app :on "parallel" (async () (setq count (1+ count)) (throw (new globalThis.Error "two"))))
        (await (rejects (lambda () (js-call app :parallel "parallel")))) (is count 2)
        (let ((receiver (js-object)))
          (put receiver (field symbols "filter") (lambda (ctx) false))
          (js-call app :on "filtered" (lambda () (setq count (+ count 100))))
          (js-call app :on "filtered" (lambda () (setq count (1+ count))) (js-object :global t))
          (js-call app :emit receiver "filtered") (is count 3))
        (setq feature (js-call app :plugin (js-object :name "update-hook"
          :apply (lambda (ctx config) (js-call ctx :on "internal/update" (lambda (candidate noSave next) false))))))
        (await feature) (await (js-call feature :update (js-object :ignored t)))
        (equal (field feature "rawConfig") (js-object :ignored t))
        (finally (await (js-call app :dispose)))))) 5000)
  (test "Rack R05 config composition, nested replacement and preflight failures" (async ()
    (let* ((app (createContext)) (seen (js-array)) (stops (js-array))
      (loader (createLoader app (js-object :resolve (async (name) (throw (new globalThis.Error "absent module"))))))
      (feature (js-object :name "configured" :Config (js-object :~standard (js-object :validate
        (lambda (config) (if (field config "bad") (js-object :issues (js-array (js-object :message "bad")))
          (js-object :value config)))))
        :apply (lambda (ctx config)
          (js-call seen :push (field config "value")) (lambda () (js-call stops :push (field config "value"))))))
      (entries (js-array (js-object :id "group" :plugins (js-array (js-object :id "inner" :plugin feature :config (js-object :value 1)))))))
      (try
        (await (js-call loader :apply entries)) (equal seen (js-array 1))
        (await (js-call loader :apply (js-array (js-object :id "group" :plugins
          (js-array (js-object :id "inner" :plugin feature :config (js-object :value 2)))))))
        (equal seen (js-array 1 2)) (equal stops (js-array 1))
        (await (rejects (lambda () (js-call loader :apply (js-array (js-object :id "missing" :name "missing"))))))
        (equal stops (js-array 1))
        (let ((patched (applyEntryPatches (js-array (js-object :id "a" :plugin feature))
          (js-array (js-object :insert (js-object :id "b" :plugin feature) :after "a")
            (js-object :id "b" :config (js-object :value 9))))))
          (is (field (field (aref patched 1) "config") "value") 9))
        (throws (lambda () (applyEntryPatches entries (js-array (js-object :insert (js-object :id "x") :after "missing")))))
        (await (rejects (lambda () (js-call loader :apply
          (js-array (js-object :id "invalid" :plugin feature :config (js-object :bad t)))))))
        (finally (await (js-call loader :close)) (await (js-call app :dispose)))))) 5000)
  (test "Rack R06 real HTTP, timer and SQLite resources close before storage disposal" (async ()
    (await (mkdir (resolve ".local/rack-acceptance") (js-object :recursive t)))
    (let* ((directory (await (mkdtemp (resolve ".local/rack-acceptance/resources-"))))
      (app (createContext)) (server nil) (db nil) (timer nil) (cleanup (js-array))
      (feature (js-call app :plugin (js-object :name "resources" :apply (lambda (ctx config)
        (setq db (new Database (resolve directory "data.sqlite")))
        (js-call db :exec "CREATE TABLE calls(value TEXT)")
        (setq server (Bun/serve (js-object :port 0 :hostname "127.0.0.1"
          :fetch (lambda (request)
            (js-call (js-call db :query "INSERT INTO calls VALUES (?)") :run "request")
            (new globalThis.Response "ready")))))
        (setq timer (globalThis/setInterval (lambda () nil) 1000))
        (js-call ctx :effect (lambda () (js-array
          (lambda () (js-call db :close) (js-call cleanup :push "storage"))
          (lambda () (js-call server :stop t) (js-call cleanup :push "server"))
          (lambda () (globalThis/clearInterval timer) (js-call cleanup :push "timer"))))) nil)))))
      (try
        (await feature)
        (let ((response (await (globalThis/fetch (str "http://127.0.0.1:" (field server "port") "/")))))
          (is (await (js-call response :text)) "ready"))
        (is (field (js-call (js-call db :query "SELECT COUNT(*) AS n FROM calls") :get) "n") 1)
        (await (js-call app :dispose)) (equal cleanup (js-array "timer" "server" "storage"))
        (finally (await (js-call app :dispose)) (await (rm directory (js-object :recursive t :force t))))))) 5000)
  (test "Rack R07 logger exporters, formatting, accessors and mixins" (async ()
    (let ((app (createContext)) (logs (js-array)) (value 3))
      (try
        (js-call (field app "logger") :exporter (js-object :levels (js-object :default 3)
          :export (lambda (message) (js-call logs :push message))))
        (js-call (js-call app :logger "feature") :debug "value %d: %s" 3 "ready")
        (is (js-length logs) 1)
        (is (js-call Logger :format (js-object) (aref logs 0)) "value 3: ready")
        (js-call app :accessor "computed" (js-object :get (lambda () value) :set (lambda (next) (setq value next))))
        (is (field app "computed") 3) (put app :computed 4) (is value 4)
        (js-call app :provide "math" (js-object :twice (lambda (n) (* n 2))))
        (js-call app :mixin "math" (js-object :twice "double")) (is (js-call app :double 3) 6)
        (is (js-call Context :is app) t)
        (finally (await (js-call app :dispose)))))) 5000))
