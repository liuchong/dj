(module rack.tests.behavior
  (import "../src/index.eli" Context createContext createService Service Inject Fiber FiberState symbols Logger
    ReflectService RegistryService EventsService LoggerService RackError ValidationError
    getTraceable createCallable isConstructor isObject DisposableList withProps composeError)
  (import "../src/util.eli" field)
  (import "bun:test" test expect)
  (defun is (value expected) (js-call (expect value) :toBe expected))
  (defun equal (value expected) (js-call (expect value) :toEqual expected))
  (defun throws (work) (js-call (expect work) :toThrow))
  (defasync rejects (work)
    (let ((caught false)) (try (await (funcall work)) (catch error (setq caught t))) (is caught t)))
  (test "Rack B01 context descriptors, special keys, reflection records and helpers" (async ()
    (let* ((app (createContext)) (metadata (js-object)) (token (funcall globalThis.Symbol "test")) (child nil))
      (try
        (Object/defineProperty metadata "hidden" (js-object :value 7 :enumerable false))
        (put metadata token 9) (setq child (js-call app :extend metadata))
        (is (Object/getPrototypeOf child) app) (is (field child "hidden") 7) (is (field child token) 9)
        (is (field app "hidden") undefined)
        (is (js-call Context :is (field Context "prototype")) t)
        (is (field child (field Context "is")) t)
        (js-call app :provide "ready" 1 (lambda () false))
        (is (js-call app :get "ready") 1) (put app :ready 2) (is (js-call app :get "ready") 2)
        (is (field (field (field app "reflect") "props") "ready") (field (field (field child "reflect") "props") "ready"))
        (let* ((label (field (field app (field symbols "isolate")) "ready"))
          (impl (field (field (field app "reflect") "store") label)))
          (is (field impl "value") 2) (is (field impl "fiber") (field app "fiber")))
        (let ((fiber (js-call app :plugin (lambda (ctx config)
          (put ctx :_local 3) (put ctx "0" 4) (put ctx :prototype 5)
          (is (field ctx "_local") 3) (is (field ctx "0") 4) (is (field ctx "prototype") 5)
          (throws (lambda () (put ctx :hidden 8))) nil))))
          (await fiber) (is (field fiber "parent") app) (is (js-call Fiber globalThis.Symbol.hasInstance fiber) t))
        (is (js-call ReflectService globalThis.Symbol.hasInstance (field app "reflect")) t)
        (is (js-call RegistryService globalThis.Symbol.hasInstance (field app "registry")) t)
        (is (js-call EventsService globalThis.Symbol.hasInstance (field app "events")) t)
        (is (js-call LoggerService globalThis.Symbol.hasInstance (field app "logger")) t)
        (is (isObject (lambda () nil)) t) (is (isConstructor (lambda () nil)) false)
        (let* ((value (js-object :key 1)) (overlay (js-object)))
          (Object/defineProperty overlay "key" (js-object :value 2 :writable false))
          (let ((proxy (withProps value overlay))) (is (field proxy "key") 2) (is (Reflect/set proxy "key" 3) false) (is (field value "key") 1)))
        (throws (lambda () (composeError (lambda (info) (throw "failure")))))
        (is (field (RackError "INACTIVE_EFFECT") "code") "INACTIVE_EFFECT")
        (is (js-call globalThis.TypeError globalThis.Symbol.hasInstance (ValidationError (js-array (js-object :message "invalid")))) t)
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B02 readiness is dependency-only, scopes and loading visibility" (async ()
    (let ((app (createContext)) (available false) (count 0) (provider nil) (consumer nil) (release nil))
      (try
        (setq consumer (js-call app :inject (js-array "data") (lambda (ctx config) (setq count (1+ count)) nil)))
        (setq provider (js-call app :plugin (js-object :name "provider" :apply (lambda (ctx config)
          (js-call ctx :provide "data" (js-object :n 1) (lambda () available))
          (is (field (field ctx "data") "n") 1)
          (is (js-call ctx :get "data") undefined)
          (new globalThis.Promise (lambda (done) (setq release done)))))))
        (await (Promise/resolve))
        (is (field (field app "data") "n") 1) (is (js-call app :get "data") undefined)
        (funcall release nil) (await provider) (await consumer)
        (is count 0) (is (field (js-call app :get "data") "n") 1)
        (setq available t)
        (is (js-length (js-call (field app "reflect") :notify (js-array "data"))) 1)
        (await (js-call app :settle)) (is count 1)
        (let* ((label (funcall globalThis.Symbol "joined")) (a (js-call app :isolate "data" label)) (b (js-call app :isolate "data" label)))
          (js-call a :provide "data" 8) (is (js-call b :get "data") 8) (is (field (js-call app :get "data") "n") 1))
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B03 raw config, resolution before validation, local veto and pending update" (async ()
    (let ((app (createContext)) (starts (js-array)) (checks 0) (globalCalls 0) (feature nil) (pending nil))
      (try
        (js-call app :on "internal/config" (lambda (raw next) (js-object :n (field raw "n") :bad (field raw "bad"))))
        (js-call app :on "internal/update" (lambda (config noSave next) (setq globalCalls (1+ globalCalls)) (funcall next)) (js-object :global t))
        (let ((plugin (js-object :name "configured" :Config (js-object :~standard (js-object :validate (lambda (config)
          (setq checks (1+ checks)) (if (field config "bad") (js-object :issues (js-array (js-object :message "bad"))) (js-object :value config)))))
          :apply (lambda (ctx config)
            (js-call starts :push (field config "n"))
            (js-call ctx :on "internal/update" (lambda (nextConfig noSave next) (unless (= (field nextConfig "n") 2) (funcall next))))))))
          (setq feature (js-call app :plugin plugin (js-object :n 1))))
        (await feature) (is (js-call feature :update (js-object :n 2)) undefined)
        (is (field (field feature "rawConfig") "n") 2) (is (field (field feature "effectiveConfig") "n") 1)
        (is globalCalls 0)
        (throws (lambda () (js-call feature :update (js-object :n 9 :bad t))))
        (is (field (field feature "rawConfig") "bad") t) (equal starts (js-array 1))
        (is (js-call feature :update (js-object :n 3)) undefined) (await (js-call feature :await))
        (equal starts (js-array 1 3)) (is globalCalls 1)
        (setq pending (js-call app :plugin (js-object :inject (js-array "late") :Config (js-object :~standard (js-object :validate
          (lambda (value) (setq checks (1+ checks)) (js-object :value value)))) :apply (lambda (ctx config) nil)) (js-object :n 0)))
        (await pending) (let ((before checks)) (js-call pending :update (js-object :n 4)) (await (js-call pending :await)) (is checks before))
        (js-call app :provide "late" t) (await (js-call app :settle))
        (is (field (field pending "effectiveConfig") "n") 4)
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B04 synchronous cleanup, async owner join, iterator rollback and disposal before startup" (async ()
    (let ((app (createContext)) (count 0) (release nil) (closing nil) (ran 0))
      (try
        (let ((dispose (js-call app :effect (lambda () (lambda () (setq count (1+ count)))))))
          (is (funcall dispose) undefined) (is count 1) (is (funcall dispose) undefined))
        (let ((dispose (js-call app :effect (lambda () (async ()
          (await (new globalThis.Promise (lambda (done) (setq release done)))) (setq count (1+ count)))))))
          (setq closing (funcall dispose)) (is (funcall dispose) undefined)
          (let ((ownerClosing (js-call (field app "fiber") :dispose)))
            (funcall release) (await ownerClosing) (await closing) (is count 2)))
        (let ((feature (js-call app :plugin (lambda (ctx config) (setq ran (1+ ran)) nil))))
          (await (js-call feature :dispose)) (is ran 0))
        (let ((iterator (js-object)) (step 0))
          (put iterator globalThis.Symbol.iterator (lambda () iterator))
          (put iterator :next (lambda () (setq step (1+ step))
            (if (= step 1) (js-object :value (lambda () (setq count (1+ count))) :done false)
              (throw (new globalThis.Error "partial")))))
          (throws (lambda () (js-call app :effect (lambda () iterator)))) (is count 3))
        (await (rejects (lambda () (js-call app :effect (lambda () (Promise/resolve (js-array (lambda () nil))))))))
        (finally (await (js-call app :dispose)))))) 3000)
  (defun callbackContext (value)
    (let ((self (js* "this"))) (is (field self "ctx") (field value "ctx"))))
  (test "Rack B05 event interception, callback tracing, snapshots and payload continuations" (async ()
    (let ((app (createContext)) (order (js-array)) (remove nil) (seen nil) (feature nil))
      (try
        (js-call app :on "snapshot" (lambda () (funcall remove) (js-call order :push 1)))
        (setq remove (js-call app :on "snapshot" (lambda () (js-call order :push 2))))
        (js-call app :emit "snapshot") (equal order (js-array 1 2))
        (js-call app :on "payload" (lambda (payload next) (str payload (funcall next))))
        (is (js-call app :waterfall nil "payload" "x" (lambda (payload next) payload)) "xx")
        (js-call app :on "internal/dispatch" (lambda (mode name args receiver) (setq seen mode)))
        (await (js-call app :parallel "custom")) (is seen "emit")
        (let ((service (createService app "tracked" (js-object))))
          (setq feature (js-call app :plugin (lambda (ctx config) (js-call ctx :on "trace" callbackContext) nil)))
          (await feature) (js-call app :emit service "trace" service))
        (let ((intercepted false))
          (js-call app :on "internal/listener" (lambda (name callback options)
            (when (= name "override") (setq intercepted t) (lambda () nil))))
          (js-call app :on "override" (lambda () (throw (new globalThis.Error "not installed"))))
          (is intercepted t) (js-call app :emit "override"))
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B06 lifecycle notification ordering, registry identity and teardown observer failure" (async ()
    (let* ((app (createContext)) (states (js-array)) (removed 0) (cleaned 0) (feature nil) (plugin (js-object :name "shared" :apply (lambda (ctx config)
      (lambda () (setq cleaned (1+ cleaned)))))))
      (try
        (js-call app :on "internal/plugin" (lambda (fiber)
          (if (nil? (field fiber "uid")) (progn (setq removed (1+ removed)) (throw (new globalThis.Error "observer")))
            (js-call states :push (field fiber "state")))))
        (setq feature (js-call app :plugin plugin)) (is (aref states 0) (field FiberState "PENDING"))
        (is (field feature "state") (field FiberState "LOADING")) (await feature)
        (is (field (field feature "ctx") "runtime") (field feature "runtime"))
        (is (js-call (field app "registry") :get plugin) (field feature "runtime"))
        (js-call (field app "registry") :delete plugin)
        (is (js-call (field app "registry") :has plugin) false)
        (await (js-call app :settle)) (is removed 1) (is cleaned 1)
        (is (field feature "store") undefined)
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B07 logger runtime intercept, exporter isolation, levels and mutable buffer" (async ()
    (let ((app (createContext)) (rows (js-array)) (feature nil))
      (try
        (js-call (field app "logger") :exporter (js-object :levels (js-object :default 3) :export (lambda (message) (put message :name "mutated"))))
        (js-call (field app "logger") :exporter (js-object :levels (js-object :default 3) :export (lambda (message) (js-call rows :push message))))
        (setq feature (js-call app :plugin (js-object :name "NamedFeature"
          :apply (lambda (ctx config)
            (put (field ctx (field symbols "intercept")) "logger" (js-object :level 3))
            (js-call (field ctx "logger") :debug "active") nil))))
        (await feature) (is (field (aref rows 0) "name") "named-feature")
        (js-call (field app "logger") :info "one")
        (is (field (aref rows 1) "name") "root")
        (let ((named (js-call app :logger "named"))) (is (js-call Logger globalThis.Symbol.hasInstance named) t))
        (let ((scope (js-call app :intercept "logger" (js-object :level 0))))
          (let ((before (js-length (field (field app "logger") "buffer"))))
            (js-call (field scope "logger") :debug "skip default buffer")
            (is (js-length (field (field app "logger") "buffer")) before)))
        (put (field app "logger") :bufferSize 1) (put (field app "logger") :buffer (js-array))
        (js-call (field app "logger") :info "a") (js-call (field app "logger") :info "b")
        (is (js-length (field (field app "logger") "buffer")) 1)
        (await (js-call feature :dispose))
        (finally (await (js-call app :dispose)))))) 3000)
  (test "Rack B08 atomic mixin rollback and associated service member receiver" (async ()
    (let ((app (createContext)) (service nil))
      (try
        (setq service (createService app "counter" (js-object :count 1)))
        (js-call app :accessor "counter.current" (js-object :get (lambda (receiver error) (field receiver "count"))
          :set (lambda (value receiver error) (put receiver :count value) t)))
        (let ((tracked (js-call app :get "counter")))
          (is (field tracked "current") 1) (put tracked :current 2) (is (field service "count") 2))
        (js-call app :accessor "reject-write" (js-object :get (lambda () 1) :set (lambda () false)))
        (is (Reflect/set app "reject-write" 2) false)
        (js-call app :accessor "taken" (js-object :get (lambda () 3)))
        (throws (lambda () (js-call app :mixin (js-object :a 1 :b 2) (js-object :a "temporary" :b "taken"))))
        (is (field (field (field app "reflect") "props") "temporary") undefined)
        (finally (await (js-call app :dispose)))))) 3000)

  (test "Rack B09 direct fiber construction and callable helper" (async ()
    (let* ((app (createContext)) (ran 0) (runtime (js-object :name "direct" :callback (lambda (ctx config) (setq ran (1+ ran)) nil)
      :fibers (DisposableList))) (direct (new Fiber app (js-object :n 1) (js-object) runtime)))
      (try
        (await (js-call direct :await)) (is (field direct "runtime") runtime) (is ran 1)
        (let ((root (new Fiber app (js-object) (js-object) nil)))
          (is (field root "uid") 0) (is (field root "ctx") app)
          (await (js-call root :dispose)) (is (field root "state") (field FiberState "ACTIVE")))
        (let* ((proto (js-object)) (callable (createCallable "action" proto (js-object :property "ctx"))))
          (put callable :ctx app) (put callable (field symbols "invoke") (lambda (n) (+ n 1)))
          (is (field callable "name") "action") (is (funcall callable 2) 3))
        (await (js-call direct :dispose))
        (finally (await (js-call app :dispose)))))) 3000))
