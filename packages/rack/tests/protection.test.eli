(module rack.tests.protection
  (import "../src/index.eli" createContext Service Inject symbols Logger FiberState isBailed)
  (import "../src/util.eli" field invoke)
  (import "bun:test" test expect)
  (defun is (actual expected) (js-call (expect actual) :toBe expected))
  (defun equal (actual expected) (js-call (expect actual) :toEqual expected))
  (defun Greeter (ctx config)
    (let ((self (Reflect/construct Service (js-array ctx "greeter") Greeter)))
      (put self :value (field (field ctx "clock") "value")) self))
  (Object/setPrototypeOf (field Greeter "prototype") (field Service "prototype"))
  (funcall (Inject "clock") Greeter (js-object :kind "class"))
  (test "Rack P01 context extension never writes through to the parent" (async ()
    (let* ((app (createContext)) (before (field app "fiber"))
      (first (js-call app :extend (js-object :x 1)))
      (second (js-call first :extend (js-object :x 2))))
      (try
        (is (field before "parent") app) (is (await (js-call before :await)) before)
        (let ((keys (Object/keys (field app (field symbols "isolate")))))
          (js-call app :get "not-provided")
          (equal (Object/keys (field app (field symbols "isolate"))) keys))
        (is (field app "fiber") before) (is (field app "x") undefined)
        (is (field first "x") 1) (is (field second "x") 2)
        (put second :x 3) (is (field first "x") 1)
        (let ((left (js-call app :isolate "key")) (right (js-call app :isolate "key")))
          (js-call left :provide "key" 1) (js-call right :provide "key" 2)
          (is (js-call left :get "key") 1) (is (js-call right :get "key") 2))
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P02 constructor service, inherited injection and initialization" (async ()
    (let ((app (createContext)) (feature nil))
      (try
        (js-call app :provide "clock" (js-object :value 42))
        (setq feature (js-call app :plugin Greeter)) (await feature)
        (is (field (js-call app :get "greeter") "value") 42)
        (await (js-call feature :dispose)) (is (js-call app :get "greeter") undefined)
        (is (js-length (js-call (field app "fiber") :getEffects)) 1)
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P03 nested disposer ordering, concurrent joins and async generators" (async ()
    (let ((app (createContext)) (order (js-array)) (release nil) (closing nil) (other nil))
      (try
        (let* ((inner (js-call app :effect (lambda () (lambda () (js-call order :push "inner")))))
          (outer (js-call app :effect (lambda () (js-array inner (lambda () (js-call order :push "outer")))))))
          (await (funcall outer)) (equal order (js-array "outer" "inner")))
        (let ((effect (js-call app :effect (lambda () (async ()
          (await (new globalThis.Promise (lambda (done) (setq release done)))) (js-call order :push "joined"))))))
          (setq closing (funcall effect) other (funcall effect))
          (is other undefined)
          ;; Let setup's cleanup continuation begin before releasing its barrier.
          (await (Promise/resolve)) (funcall release)
          (await closing) (await other)
          (equal order (js-array "outer" "inner" "joined")))
        (let* ((iterator (js-object)) (step 0))
          (put iterator globalThis.Symbol.asyncIterator (lambda () iterator))
          (put iterator :next (async ()
            (setq step (1+ step))
            (js-object :done (> step 2) :value (when (<= step 2)
              (let ((n step)) (lambda () (js-call order :push n)))))))
          (let ((effect (js-call app :effect (lambda () iterator))))
            (await effect) (await (funcall effect))
            (equal (js-call order :slice -2) (js-array 2 1))))
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P04 config rejection leaves the running configuration intact" (async ()
    (let* ((app (createContext)) (starts 0)
      (feature (js-call app :plugin (js-object :name "validated"
        :Config (js-object :~standard (js-object :validate (lambda (value)
          (if (field value "bad") (js-object :issues (js-array (js-object :message "rejected")))
            (js-object :value value)))))
        :apply (lambda (ctx config) (setq starts (1+ starts)) nil)) (js-object :value 1))))
      (try
        (await feature)
        (js-call (expect (lambda () (js-call feature :update (js-object :bad t)))) :toThrow)
        (is starts 1) (is (field feature "state") (field FiberState "ACTIVE"))
        (is (field (field feature "effectiveConfig") "value") 1)
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P05 availability checks explicitly refresh dependent fibers" (async ()
    (let* ((app (createContext)) (available false) (starts 0) (stops 0)
      (consumer (js-call app :plugin (js-object :name "available" :inject (js-array "ready")
        :apply (lambda (ctx config) (setq starts (1+ starts))
          (lambda () (is (field (field ctx "ready") "value") 7) (setq stops (1+ stops))))))))
      (try
        (js-call app :provide "ready" (js-object :value 7) (lambda () available))
        (await consumer) (is (field consumer "state") (field FiberState "PENDING"))
        (setq available t) (js-call (field app "reflect") :notify (js-array "ready"))
        (await (js-call app :settle)) (is starts 1)
        (setq available false) (js-call (field app "reflect") :notify (js-array "ready"))
        (await (js-call app :settle)) (is (field consumer "state") (field FiberState "PENDING")) (is stops 1)
        (finally (await (js-call app :dispose)))))) 2000)

  (defun Voice (ctx config)
    (let ((self (Reflect/construct Service (js-array ctx "voice") Voice)))
      (put self :prefix "hello") self))
  (Object/setPrototypeOf Voice Service)
  (Object/setPrototypeOf (field Voice "prototype") (field Service "prototype"))
  (defun voiceInvoke (name)
    (let ((self (js* "this"))) (str (field self "prefix") " " name)))
  (put (field Voice "prototype") (field symbols "invoke") voiceInvoke)
  (test "Rack P06 callable services preserve call, bind and derived configuration" (async ()
    (let ((app (createContext)) (feature nil))
      (try
        (setq feature (js-call app :plugin Voice)) (await feature)
        (let* ((voice (js-call app :get "voice"))
          (derived (js-call voice (field symbols "extend") (js-object :prefix "goodbye"))))
          (is (funcall voice "world") "hello world")
          (is (funcall (js-call voice :bind nil "bound")) "hello bound")
          (is (funcall derived "world") "goodbye world")
          (is (js-call Service globalThis.Symbol.hasInstance voice) t))
        (finally (await (js-call app :dispose)))))) 2000)

  (defun Delayed (ctx config)
    (let ((self (Reflect/construct Service (js-array ctx "delayed") Delayed)))
      (put self :events (field config "events"))
      (js-call (field config "initializers") :forEach (lambda (init) (invoke init self (js-array))))
      (put self :constructed t) self))
  (Object/setPrototypeOf (field Delayed "prototype") (field Service "prototype"))
  (defun delayedMethod ()
    (let ((self (js* "this")))
      (is (field self "constructed") t)
      (js-call (field self "events") :push (field (field (field self "ctx") "clock") "value")) nil))
  (test "Rack P07 method decorators defer until construction and retain parent ownership" (async ()
    (let ((app (createContext)) (initializers (js-array)) (events (js-array)) (feature nil) (remove nil))
      (try
        (is (funcall (Inject "clock") delayedMethod
          (js-object :kind "method" :addInitializer (lambda (hook) (js-call initializers :push hook)))) undefined)
        (setq feature (js-call app :plugin Delayed (js-object :initializers initializers :events events)))
        (await feature) (equal events (js-array))
        (setq remove (js-call app :provide "clock" (js-object :value 1)))
        (await (js-call app :settle)) (equal events (js-array 1))
        (await (funcall remove)) (js-call app :provide "clock" (js-object :value 2))
        (await (js-call app :settle)) (equal events (js-array 1 2))
        (await (js-call feature :dispose)) (is (field (field app "registry") "size") 0)
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P08 cleanup failure isolates other effects and async iteration stops on release" (async ()
    (let ((app (createContext)) (order (js-array)) (nexts 0) (returned 0) (iterator (js-object)))
      (try
        (put iterator globalThis.Symbol.asyncIterator (lambda () iterator))
        (put iterator :next (async () (setq nexts (1+ nexts)) (js-object :done t)))
        (put iterator :return (lambda () (setq returned (1+ returned))))
        (let ((dispose (js-call app :effect (lambda () iterator))))
          (await (funcall dispose)) (is nexts 0) (is returned 0))
        (js-call app :effect (lambda () (js-array
          (lambda () (js-call order :push "skipped"))
          (lambda () (throw (new globalThis.Error "cleanup"))))))
        (js-call app :effect (lambda () (lambda () (js-call order :push "independent"))))
        (await (js-call app :dispose)) (equal order (js-array "independent"))
        (finally (await (js-call app :dispose)))))) 2000)
  (test "Rack P09 detached logger methods, empty names, zero thresholds and bail values" (async ()
    (let* ((app (createContext)) (logs (js-array)) (logger (js-call app :logger "")) (info (field logger "info")))
      (try
        (js-call (field app "logger") :exporter (js-object :levels (js-object :default 0)
          :export (lambda (message) (js-call logs :push message))))
        (funcall info "hidden") (is (js-length logs) 0)
        (let ((error (field logger "error"))) (funcall error "error"))
        (is (js-length logs) 1) (is (field (aref logs 0) "name") "")
        (is (isBailed 0) t) (is (isBailed "") t) (is (isBailed false) false)
        (finally (await (js-call app :dispose)))))) 2000))
