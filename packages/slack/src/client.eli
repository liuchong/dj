(module slack.client
  (import "./native.eli" nativeGet nativeTypeOf NativeNumber nativeSetTimeout nativeClearTimeout)
  (defun apiUrl (method)
    (unless (and (= (nativeTypeOf method) "string")
      (js-call (new globalThis.RegExp "^[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$") :test method))
      (throw (new globalThis.TypeError "expected a Slack Web API method name")))
    (str "https://slack.com/api/" method))
  (defasync readJson (response maximum)
    (let ((reader (js-call (nativeGet response "body") :getReader)) (chunks (js-array)) (size 0) (done false))
      (try
        (while (not done)
          (let ((part (await (js-call reader :read))))
            (setq done (nativeGet part "done"))
            (unless done
              (setq size (+ size (js-length (nativeGet part "value"))))
              (when (> size maximum) (throw (new globalThis.RangeError "Slack response budget exceeded")))
              (js-call chunks :push (Buffer/from (nativeGet part "value"))))))
        (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode (Buffer/concat chunks size)))
        (finally (try (await (js-call reader :cancel)) (catch ignored nil)) (js-call reader :releaseLock)))))
  ;; One host-wide budget per workspace/app/method, shared by user and bot clients.
  (defconst hostBudgets (new globalThis.WeakMap))
  (defun createSlackClient (config host)
    (let* ((active (new globalThis.Set)) (closed false) (checked-until 0) (checked-token nil)
      (request nil) (identity nil) (authorize nil) (budgets (js-call hostBudgets :get (nativeGet host "budget_owner" host))))
      (unless budgets (setq budgets (new globalThis.Map)) (js-call hostBudgets :set (nativeGet host "budget_owner" host) budgets))
      (setq request (async (method parameters token context)
        (let* ((url (apiUrl method)) (now (js-call host :monoNow))
          (key (str (nativeGet config "tenant_ref") ":" (nativeGet config "event_app_id") ":" method))
          (until (js-call budgets :get key)))
          (when (or closed (not (= (nativeTypeOf token) "string")) (= (js-length token) 0))
            (throw (new globalThis.Error "Slack credentials unavailable")))
          (if (and until (< now until))
            (js-object :status 429 :wire (js-object :ok false :error "ratelimited") :retry_after (/ (- until now) 1000))
            (let* ((controller (new globalThis.AbortController)) (parent (nativeGet context "abort_signal"))
              (abort (lambda () (js-call controller :abort)))
              (remaining (- (nativeGet context "deadline" (+ now 15000)) now))
              (timer (nativeSetTimeout abort (Math/max 1 (Math/min 15000 remaining)))))
              (when (or (<= remaining 0) (nativeGet parent "aborted")) (funcall abort))
              (when parent (js-call parent :addEventListener "abort" abort (js-object :once t)))
              (js-call active :add controller)
              (when (js-call (js-array "conversations.history" "conversations.replies") :includes method)
                (js-call budgets :set key (+ now (* 1000 (nativeGet config "history_poll_seconds" 60)))))
              (try
                (let* ((response (await (js-call host :fetch url (js-object :method "POST" :redirect "error"
                  :signal (nativeGet controller "signal") :headers (js-object :authorization (str "Bearer " token) :content-type "application/json")
                  :body (JSON/stringify parameters)))))
                  (wire (await (readJson response 1048576)))
                  (raw-retry (NativeNumber (js-call (nativeGet response "headers") :get "retry-after")))
                  (retry (if (and (Number/isFinite raw-retry) (> raw-retry 0)) raw-retry 60)))
                  (when (= (nativeGet response "status") 429) (js-call budgets :set key (+ (js-call host :monoNow) (* 1000 retry))))
                  (js-object :status (nativeGet response "status") :wire wire :retry_after retry))
                (finally (nativeClearTimeout timer) (js-call active :delete controller)
                  (when parent (js-call parent :removeEventListener "abort" abort)))))))))
      (setq authorize (async (context)
        (let* ((credential (await (js-call (nativeGet host "credentials") :resolve (nativeGet config "credential_ref"))))
          (token (nativeGet credential "access_token")))
          (unless (and (= (nativeGet credential "app_id") (nativeGet config "event_app_id"))
            (= (nativeGet credential "team_id") (nativeGet config "tenant_ref"))
            (= (nativeTypeOf token) "string") (> (js-length token) 0))
            (throw (new globalThis.Error "Slack credential workspace/application mismatch")))
          (when (or (not (= token checked-token)) (>= (js-call host :monoNow) checked-until))
            (let* ((reply (await (funcall request "auth.test" (js-object) token context))) (wire (nativeGet reply "wire")))
              (unless (and (= (nativeGet reply "status") 200) (= (nativeGet wire "ok") t)
                (= (nativeGet wire "team_id") (nativeGet config "tenant_ref"))
                (= (nativeGet wire "user_id") (nativeGet config "event_subject_id"))
                (= (not (not (nativeGet wire "bot_id"))) (= (nativeGet config "identity") "bot")))
                (throw (new globalThis.Error "Slack authenticated identity mismatch")))
              (setq identity wire checked-token token checked-until (+ (js-call host :monoNow) 60000))))
          credential)))
      (js-object
        :request (async (method parameters context)
          (apiUrl method)
          (let ((credential (await (funcall authorize context))))
            (await (funcall request method parameters (nativeGet credential "access_token") context))))
        :socketUrl (async (context)
          (let* ((credential (await (funcall authorize context)))
            (response (await (funcall request "apps.connections.open" (js-object) (nativeGet credential "app_token") context)))
            (wire (nativeGet response "wire")))
            (unless (and (= (nativeGet response "status") 200) (= (nativeGet wire "ok") t))
              (throw (new globalThis.Error "Slack Socket Mode unavailable")))
            (let ((url (new globalThis.URL (nativeGet wire "url"))))
              (unless (and (= (nativeGet url "protocol") "wss:")
                (js-call (nativeGet url "hostname") :endsWith ".slack.com")
                (= (nativeGet url "username") "") (= (nativeGet url "password") "")
                (js-call (js-array "" "443") :includes (nativeGet url "port")))
                (throw (new globalThis.TypeError "invalid Slack WebSocket endpoint")))
              (js-call url :toString))))
        :identity (lambda () identity)
        :pendingWork (lambda () (nativeGet active "size"))
        :close (lambda () (setq closed t checked-token nil checked-until 0)
          (js-call active :forEach (lambda (controller) (js-call controller :abort)))))))
  (export createSlackClient apiUrl))
