(module slack.socket
  (import "./native.eli" nativeGet nativeTypeOf nativeSetTimeout nativeClearTimeout)
  ;; One app stream, many identity consumers. Slack distributes envelopes between
  ;; sockets; independent per-identity sockets would silently lose events.
  (defun createSlackSocket (client host)
    (let ((listeners (new globalThis.Map)) (socket nil) (running nil) (closed false)
      (state "connecting") (reason nil) (timer nil) (wake nil) (chain (Promise/resolve))
      (queued 0) (bytes 0) (loop nil))
      (setq loop (async ()
        (while (not closed)
          (try
            (setq state "connecting" reason nil)
            (let* ((url (await (js-call client :socketUrl (js-object))))
              (open-socket (if (nativeGet host "webSocket") (js-call host :webSocket url) (new globalThis.WebSocket url))))
              (setq socket open-socket)
              (let ((finished (new globalThis.Promise (lambda (resolve)
                (setq timer (nativeSetTimeout (lambda () (js-call open-socket :close)) 20000))
                (js-call open-socket :addEventListener "open" (lambda ()
                  (nativeClearTimeout timer) (setq state "connected")
                  ;; A bounded connection lifetime also recovers half-open links
                  ;; without inventing a heartbeat frame outside Slack's protocol.
                  (setq timer (nativeSetTimeout (lambda () (js-call open-socket :close 1000 "refresh")) 300000))))
                (js-call open-socket :addEventListener "close" (lambda () (funcall resolve nil)) (js-object :once t))
                (js-call open-socket :addEventListener "error" (lambda () (js-call open-socket :close)))))))
                (js-call open-socket :addEventListener "message" (lambda (message)
                  (let* ((text (nativeGet message "data")) (size (if (= (nativeTypeOf text) "string") (Buffer/byteLength text) 1048577)))
                    (if (or (> size 1048576) (>= queued 32) (> (+ bytes size) 4194304))
                      (progn (setq reason "event_backpressure") (js-call open-socket :close 1013 "backpressure"))
                      (progn
                        (setq queued (1+ queued) bytes (+ bytes size))
                        (setq chain (js-call chain :then (async ()
                          (let* ((wire (JSON/parse text)) (kind (nativeGet wire "type")) (id (nativeGet wire "envelope_id")))
                            (cond
                              ((= kind "disconnect") (js-call open-socket :close 1000 "refresh"))
                              ((= kind "events_api")
                                (unless (and (= (nativeTypeOf id) "string") (> (js-length id) 0))
                                  (throw (new globalThis.TypeError "invalid Socket Mode envelope")))
                                (let ((work (js-array)))
                                  (js-call listeners :forEach (lambda (listener) (js-call work :push (funcall listener (nativeGet wire "payload")))))
                                  ;; Only ACK after every selected consumer commits its durable inbox.
                                  (await (Promise/all work)))
                                (when (= (nativeGet open-socket "readyState") 1)
                                  (js-call open-socket :send (JSON/stringify (js-object :envelope_id id))))))))))
                        (setq chain (js-call chain :catch (lambda (error)
                          (setq reason "event_persistence_failed") (js-call open-socket :close 1011 "event processing failed"))))
                        (setq chain (js-call chain :finally (lambda () (setq queued (1- queued) bytes (- bytes size))))))))))
                (await finished) (unless closed (setq state "disconnected")) (await chain)))
            (catch error (unless closed (setq state "disconnected" reason (or reason "socket_unavailable"))))
            (finally (when timer (nativeClearTimeout timer)) (setq timer nil)
              (when socket (js-call socket :close)) (setq socket nil)))
          (unless closed (await (new globalThis.Promise (lambda (resolve)
            (setq wake resolve timer (nativeSetTimeout resolve 3000)))))))))
      (js-object
        :subscribe (lambda (id listener)
          (js-call listeners :set id listener)
          (unless running (setq running (funcall loop))))
        :unsubscribe (async (id)
          (js-call listeners :delete id)
          (when (= (nativeGet listeners "size") 0)
            (setq closed t state "stopped")
            (when timer (nativeClearTimeout timer)) (when wake (funcall wake nil))
            (when socket (js-call socket :close 1000 "service stopping"))
            (when running (await running)) (js-call client :close)))
        :status (lambda () (js-object :state state :reason reason :queued queued)))))
  (export createSlackSocket))
