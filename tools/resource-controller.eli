(module dj.tools.resource-controller
  (import "../src/core/native.eli" NativeBun nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout)
  (import "./resource-capture.eli" validateCaptureRequest validateCaptureBinding captureOwnedDeployment openNativeProcessReader)
  (import "node:fs/promises" lstat open)
  (import "node:fs" constants)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (defasync loadCaptureBinding (root ref)
    (unless (and (= (nativeTypeOf ref) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}$") :test ref))
      (throw (new globalThis.TypeError "resource_binding_reference_invalid")))
    (let* ((directory (await (lstat root))) (uid (js-call globalThis.process :getuid))
           (path (resolve root ref)) (info (await (lstat path))) (handle nil))
      (unless (and (js-call directory :isDirectory) (not (js-call directory :isSymbolicLink))
        (= (nativeGet directory "uid") uid) (= (nativeBitAnd (nativeGet directory "mode") 63) 0)
        (js-call info :isFile) (not (js-call info :isSymbolicLink))
        (= (nativeGet info "uid") uid) (= (nativeBitAnd (nativeGet info "mode") 63) 0)
        (<= (nativeGet info "size") 65536))
        (throw (new globalThis.Error "resource_binding_protection_required")))
      (try
        (setq handle (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))
        (let ((actual (await (js-call handle :stat))))
          (unless (and (js-call actual :isFile) (= (nativeGet actual "uid") uid)
            (= (nativeBitAnd (nativeGet actual "mode") 63) 0) (<= (nativeGet actual "size") 65536))
            (throw (new globalThis.Error "resource_binding_protection_required"))))
        (let ((bytes (await (js-call handle :readFile))))
          (when (> (nativeGet bytes "byteLength") 65536)
            (throw (new globalThis.Error "resource_binding_size_limit")))
          (validateCaptureBinding (JSON/parse (js-call bytes :toString "utf8"))))
        (finally (when handle (await (js-call handle :close)))))))
  (defasync readCaptureRequest (stream)
    (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t)))
          (size 0) (text "") (done false))
      (try
        (while (not done)
          (let ((part (await (js-call reader :read))))
            (setq done (nativeGet part "done"))
            (unless done
              (setq size (+ size (nativeGet (nativeGet part "value") "byteLength")))
              (when (> size 65536) (throw (new globalThis.Error "resource_request_size_limit")))
              (setq text (str text (js-call decoder :decode (nativeGet part "value") (js-object :stream t)))))))
        (validateCaptureRequest (JSON/parse (str text (js-call decoder :decode))))
        (finally
          (unless done (await (js-call reader :cancel)))
          (js-call reader :releaseLock)))))
  (defasync handleResourceRequest (request binding runtime)
    (let* ((normalized (validateCaptureRequest request))
           (data (await (captureOwnedDeployment binding runtime))))
      (js-object :schema_version 1 :request_id (nativeGet normalized "request_id")
        :operation (nativeGet normalized "operation") :run_id (nativeGet normalized "run_id") :ok t :data data)))
  (defasync main ()
    (let ((request nil) (reader nil))
      (try
        (setq request (await (readCaptureRequest (js-call (nativeGet NativeBun "stdin") :stream))))
        (unless (= (js-length (nativeGet globalThis.process "argv")) 3)
          (throw (new globalThis.Error "resource_binding_reference_required")))
        (let ((binding (await (loadCaptureBinding (js-call globalThis.process :cwd)
                         (aref (nativeGet globalThis.process "argv") 2)))))
          (setq reader (openNativeProcessReader))
          (let* ((response (await (handleResourceRequest request binding
                    (js-object :reader reader :uid (js-call globalThis.process :getuid)
                      :capture_id (str "capture_" (randomUUID)) :now (lambda () (performance/now))
                      :sleep (async (ms) (await (new globalThis.Promise
                        (lambda (done reject) (nativeSetTimeout done ms)))))))))
                 (text (str (JSON/stringify response) "\n")))
            (when (> (Buffer/byteLength text "utf8") 8388608)
              (throw (new globalThis.Error "resource_response_size_limit")))
            (js-call (nativeGet globalThis.process "stdout") :write text)))
        (catch failure
          (js-call (nativeGet globalThis.process "stdout") :write
            (str (JSON/stringify (js-object :schema_version 1 :request_id (nativeGet request "request_id" nil)
              :operation (nativeGet request "operation" nil) :run_id (nativeGet request "run_id" nil)
              :ok false :error (js-object :code "resource_capture_unavailable"))) "\n"))
          (js-call (nativeGet globalThis.process "stderr") :write "resource_controller_failed\n")
          (put globalThis.process :exitCode 1))
        (finally (when reader (js-call reader :close))))))
  (when (js-call (or (aref (nativeGet globalThis.process "argv") 1) "") :endsWith "/tools/resource-controller.mjs") (main))
  (export loadCaptureBinding readCaptureRequest handleResourceRequest))
