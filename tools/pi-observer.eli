(module dj.tools.pi-observer
  (import "../src/core/native.eli" NativeGlobal nativeGet nativeTypeOf)
  (import "node:path" isAbsolute)
  (defun piFail () (throw (new globalThis.Error "native_observation_unavailable")))
  (defun piPlain (value)
    (and value (= (nativeTypeOf value) "object") (not (Array/isArray value))
      (or (= (Object/getPrototypeOf value) nil)
        (= (Object/getPrototypeOf value) (nativeGet (nativeGet NativeGlobal "Object") "prototype")))))
  (defun piId (value)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_.:-]{1,256}$") :test value)))
  (defun piDense (items maximum)
    (and (Array/isArray items) (<= (js-length items) maximum)
      (let ((index 0) (valid t))
        (while (< index (js-length items))
          (unless (object-has? items index) (setq valid false))
          (setq index (1+ index))) valid)))
  (defun piTimestamp (value)
    (and (= (nativeTypeOf value) "string") (> (js-length value) 0) (Number/isFinite (Date/parse value))))
  (defun validatePiObserverRequest (request)
    (let ((p (nativeGet request "parameters")) (op (nativeGet request "operation")) (run (nativeGet request "run_id")))
      (unless (and (piPlain request) (= (nativeGet request "schema_version") 1)
        (piId (nativeGet request "request_id")) (piId run)
        (js-call (js-array "observe-direct-input" "observe-native-start") :includes op)
        (piPlain p) (= (nativeGet p "tool") "pi") (= (nativeGet p "run_id") run)
        (piId (nativeGet p "native_session_id")) (piId (nativeGet p "delivery_id"))) (piFail))
      (Object/freeze (js-object :schema_version 1 :request_id (nativeGet request "request_id")
        :operation op :run_id run :parameters (Object/freeze (js-object :tool "pi"
          :native_session_id (nativeGet p "native_session_id") :delivery_id (nativeGet p "delivery_id") :run_id run))))))
  (defun validatePiObserverBinding (binding)
    (let ((targets (nativeGet binding "targets")) (ids (new globalThis.Set)) (paths (new globalThis.Set)) (safe (js-array)))
      (unless (and (piPlain binding) (= (nativeGet binding "schema_version") 1)
        (= (nativeGet binding "authorized") t) (piDense targets 16) (> (js-length targets) 0)) (piFail))
      (js-call targets :forEach (lambda (target)
        (let ((id (nativeGet target "native_session_id")) (cwd (nativeGet target "cwd")) (path (nativeGet target "log_path")))
          (unless (and (piPlain target) (piId id) (= (nativeTypeOf cwd) "string") (isAbsolute cwd)
            (= (nativeTypeOf path) "string") (isAbsolute path) (js-call path :endsWith ".jsonl")
            (not (js-call ids :has id)) (not (js-call paths :has path))) (piFail))
          (js-call ids :add id) (js-call paths :add path)
          (js-call safe :push (Object/freeze (js-object :native_session_id id :cwd cwd :log_path path))))))
      (Object/freeze (js-object :schema_version 1 :authorized t :targets (Object/freeze safe)))))
  (defun piUserText (message)
    (let ((content (nativeGet message "content")))
      (cond
        ((= (nativeTypeOf content) "string") content)
        ((and (Array/isArray content) (piDense content (js-length content)))
          (let ((text "") (valid t))
            (js-call content :forEach (lambda (block)
              (if (and (piPlain block) (= (nativeGet block "type") "text") (= (nativeTypeOf (nativeGet block "text")) "string"))
                (setq text (str text (nativeGet block "text"))) (setq valid false))))
            (if valid text nil)))
        (t nil))))
  (defun piEnvelope (row request)
    (let* ((message (nativeGet row "message")) (text (piUserText message)) (envelope nil)
           (p (nativeGet request "parameters")))
      (when (= (nativeTypeOf text) "string")
        (try (setq envelope (JSON/parse text)) (catch invalid (setq envelope nil))))
      (when (and (piPlain envelope) (= (nativeGet envelope "schema_version") 1)
        (= (nativeGet envelope "kind") "external_message")
        (= (nativeGet envelope "origin") (if (= (nativeGet request "operation") "observe-direct-input") "direct" "subscription_event"))
        (= (nativeGet envelope "delivery_id") (nativeGet p "delivery_id"))
        (= (nativeTypeOf (nativeGet (nativeGet envelope "content") "text")) "string")
        (js-call (nativeGet (nativeGet envelope "content") "text") :includes (nativeGet request "run_id"))) envelope)))
  (defun piDescendsFrom (candidate user records positions)
    (let ((current candidate) (steps 0) (seen (new globalThis.Set)) (found false) (running t))
      (while (and running (< steps 8192))
        (let* ((id (nativeGet current "id")) (parent (nativeGet current "parentId"))
               (previous (js-call records :get parent)))
          (setq steps (1+ steps))
          (if (or (js-call seen :has id) (not previous)
            (>= (js-call positions :get parent) (js-call positions :get id)))
            (setq running false)
            (progn
              (js-call seen :add id)
              (if (and (= (nativeGet previous "type") "message") (= (nativeGet (nativeGet previous "message") "role") "user"))
                (progn (setq found (= parent (nativeGet user "id"))) (setq running false))
                (setq current previous)))))) found))
  (defun observePiLog (request binding snapshot)
    (let* ((r (validatePiObserverRequest request)) (b (validatePiObserverBinding binding))
           (p (nativeGet r "parameters"))
           (target (js-call (nativeGet b "targets") :find (lambda (row) (= (nativeGet row "native_session_id") (nativeGet p "native_session_id")))))
           (header-text (nativeGet snapshot "header_text")) (text (nativeGet snapshot "entries_text")))
      (unless (and target (piPlain snapshot) (= (nativeTypeOf header-text) "string") (= (nativeTypeOf text) "string")
        (<= (Buffer/byteLength header-text "utf8") 65535) (<= (Buffer/byteLength text "utf8") 8388608)
        (= (nativeTypeOf (nativeGet snapshot "prefix_truncated")) "boolean")
        (= (nativeTypeOf (nativeGet snapshot "trailing_fragment_discarded")) "boolean")
        (js-call text :endsWith "\n")) (piFail))
      (let* ((header (JSON/parse header-text)) (lines (js-call (js-call text :slice 0 -1) :split "\n"))
             (records (new globalThis.Map)) (positions (new globalThis.Map)) (rows (js-array)) (users (js-array)))
        (unless (and (piPlain header) (= (nativeGet header "type") "session") (= (nativeGet header "version") 3)
          (= (nativeGet header "id") (nativeGet target "native_session_id")) (= (nativeGet header "cwd") (nativeGet target "cwd"))
          (piTimestamp (nativeGet header "timestamp")) (<= (js-length lines) 8192)) (piFail))
        ;; Validate the entire retained window before accepting a proof near its start.
        (js-call lines :forEach (lambda (line index)
          (when (or (= (js-length line) 0) (> (Buffer/byteLength line "utf8") 1048576)) (piFail))
          (let* ((row (JSON/parse line)) (id (nativeGet row "id")) (parent (nativeGet row "parentId")) (type (nativeGet row "type")))
            (unless (and (piPlain row) (= (nativeTypeOf type) "string") (> (js-length type) 0) (not (= type "session"))
              (piId id) (not (js-call records :has id)) (or (= parent nil) (piId parent))
              (piTimestamp (nativeGet row "timestamp"))) (piFail))
            (when (= type "message")
              (unless (and (piPlain (nativeGet row "message")) (= (nativeTypeOf (nativeGet (nativeGet row "message") "role")) "string")) (piFail)))
            (js-call records :set id row) (js-call positions :set id index) (js-call rows :push row))))
        (js-call rows :forEach (lambda (row)
          (when (and (= (nativeGet row "type") "message") (= (nativeGet (nativeGet row "message") "role") "user") (piEnvelope row r))
            (js-call users :push row))))
        (unless (= (js-length users) 1) (piFail))
        (let* ((user (aref users 0)) (event user))
          (when (= (nativeGet r "operation") "observe-native-start")
            (setq event (js-call rows :find (lambda (row)
              (and (= (nativeGet row "type") "message") (= (nativeGet (nativeGet row "message") "role") "assistant")
                (> (js-call positions :get (nativeGet row "id")) (js-call positions :get (nativeGet user "id")))
                (piDescendsFrom row user records positions)))))
            (unless event (piFail)))
          (js-object :schema_version 1 :request_id (nativeGet r "request_id") :operation (nativeGet r "operation")
            :run_id (nativeGet r "run_id") :ok t :data (js-object
              :native_session_id (nativeGet header "id") :native_message_id (nativeGet user "id") :native_event_id (nativeGet event "id")
              :observed_delivery_id (nativeGet (piEnvelope user r) "delivery_id") :observation_source "pi_session_jsonl_v3"
              :session_format_version 3 :instance_identity_source "authorized_session_log_binding" :history_coverage "bounded_tail"))))))
  (export validatePiObserverRequest validatePiObserverBinding observePiLog))
