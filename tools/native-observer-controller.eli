(module dj.tools.native-observer-controller
  (import "../src/core/native.eli" NativeBun NativeNumber nativeGet nativeTypeOf nativeBitAnd nativeFetch)
  (import "./pi-observer.eli" validatePiObserverRequest validatePiObserverBinding observePiLog)
  (import "./opencode-observer.eli" validateObserverRequest observeOpenCode)
  (import "./opencode-observer-controller.eli" loadObserverBinding)
  (import "node:fs/promises" lstat open)
  (import "node:fs" constants)
  (import "node:path" resolve)
  (defun nativeObserverFail () (throw (new globalThis.Error "native_observation_unavailable")))
  (defun nativeBindingRef (ref)
    (and (= (nativeTypeOf ref) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}$") :test ref)))
  (defun validateNativeBinding (binding)
    (unless (and binding (= (nativeTypeOf binding) "object") (not (Array/isArray binding))
      (= (nativeGet binding "schema_version") 1) (= (nativeGet binding "authorized") t)
      (nativeBindingRef (nativeGet binding "opencode_binding_ref")) (nativeBindingRef (nativeGet binding "pi_binding_ref")))
      (nativeObserverFail))
    (Object/freeze (js-object :schema_version 1 :authorized t
      :opencode_binding_ref (nativeGet binding "opencode_binding_ref") :pi_binding_ref (nativeGet binding "pi_binding_ref"))))
  (defun nativeRequest (request)
    (if (= (nativeGet (nativeGet request "parameters") "tool") "pi")
      (validatePiObserverRequest request) (validateObserverRequest request)))
  (defun nativeFingerprint (info)
    (js-call (js-array (str (nativeGet info "dev")) (str (nativeGet info "ino")) (str (nativeGet info "size"))
      (str (nativeGet info "mtimeNs")) (str (nativeGet info "ctimeNs"))) :join ":"))
  (defasync nativeBindingJson (root ref)
    (unless (nativeBindingRef ref) (nativeObserverFail))
    (let* ((directory (await (lstat root))) (path (resolve root ref)) (uid (js-call globalThis.process :getuid))
           (before (await (lstat path (js-object :bigint t)))) (handle nil))
      (unless (and (js-call directory :isDirectory) (not (js-call directory :isSymbolicLink))
        (= (nativeGet directory "uid") uid) (= (nativeBitAnd (nativeGet directory "mode") 63) 0)
        (js-call before :isFile) (not (js-call before :isSymbolicLink))
        (= (funcall NativeNumber (nativeGet before "uid")) uid)
        (= (nativeBitAnd (funcall NativeNumber (nativeGet before "mode")) 63) 0)) (nativeObserverFail))
      (let ((size (funcall NativeNumber (nativeGet before "size"))))
        (unless (and (Number/isSafeInteger size) (> size 0) (<= size 65536)) (nativeObserverFail))
        (try
          (setq handle (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))
          (unless (= (nativeFingerprint before) (nativeFingerprint (await (js-call handle :stat (js-object :bigint t))))) (nativeObserverFail))
          (let ((buffer (Buffer/alloc size)) (offset 0))
            (while (< offset size)
              (let* ((part (await (js-call handle :read buffer offset (- size offset) offset))) (count (nativeGet part "bytesRead")))
                (unless (and (Number/isInteger count) (> count 0) (<= count (- size offset))) (nativeObserverFail))
                (setq offset (+ offset count))))
            (unless (and (= (nativeFingerprint before) (nativeFingerprint (await (js-call handle :stat (js-object :bigint t)))))
              (= (nativeFingerprint before) (nativeFingerprint (await (lstat path (js-object :bigint t)))))) (nativeObserverFail))
            (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode buffer)))
          (finally (when handle (await (js-call handle :close))))))))
  (defasync loadNativeObserverBinding (root ref) (validateNativeBinding (await (nativeBindingJson root ref))))
  (defasync loadPiObserverBinding (root ref) (validatePiObserverBinding (await (nativeBindingJson root ref))))
  (defasync readNativeObserverRequest (stream)
    (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t)))
          (size 0) (text "") (done false))
      (try
        (while (not done)
          (let ((part (await (js-call reader :read))))
            (setq done (nativeGet part "done"))
            (unless done
              (setq size (+ size (nativeGet (nativeGet part "value") "byteLength")))
              (when (> size 65536) (nativeObserverFail))
              (setq text (str text (js-call decoder :decode (nativeGet part "value") (js-object :stream t)))))))
        (nativeRequest (JSON/parse (str text (js-call decoder :decode))))
        (finally (unless done (await (js-call reader :cancel))) (js-call reader :releaseLock)))))
  (defun piReadDeadline (runtime started)
    (let ((now (funcall (nativeGet runtime "now"))))
      (unless (and (Number/isFinite started) (Number/isFinite now) (>= now started) (< (- now started) 25000))
        (nativeObserverFail))))
  (defun piLogStat (info)
    (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
      (= (funcall NativeNumber (nativeGet info "uid")) (js-call globalThis.process :getuid))
      (= (nativeBitAnd (funcall NativeNumber (nativeGet info "mode")) 18) 0)
      (Number/isSafeInteger (funcall NativeNumber (nativeGet info "size")))
      (>= (funcall NativeNumber (nativeGet info "size")) 0)) (nativeObserverFail)))
  (defasync piReadBytes (handle position length runtime started)
    (let ((buffer (Buffer/alloc length)) (offset 0))
      (while (< offset length)
        (piReadDeadline runtime started)
        (let* ((wanted (Math/min 65536 (- length offset)))
               (part (await (js-call handle :read buffer offset wanted (+ position offset)))) (count (nativeGet part "bytesRead")))
          (piReadDeadline runtime started)
          (unless (and (Number/isInteger count) (= count wanted)) (nativeObserverFail))
          (setq offset (+ offset count)))) buffer))
  (defasync readPiSnapshot (target &optional ports)
    (let* ((runtime (or ports (js-object :lstat lstat :open open :now (lambda () (performance/now)))))
           (started (funcall (nativeGet runtime "now"))) (path (nativeGet target "log_path")) (handle nil))
      (piReadDeadline runtime started)
      (let ((before (await (funcall (nativeGet runtime "lstat") path (js-object :bigint t)))))
        (piReadDeadline runtime started) (piLogStat before)
        (try
          (setq handle (await (funcall (nativeGet runtime "open") path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))
          (piReadDeadline runtime started)
          (let ((opened (await (js-call handle :stat (js-object :bigint t)))))
            (piLogStat opened)
            (unless (= (nativeFingerprint before) (nativeFingerprint opened)) (nativeObserverFail)))
          (let* ((size (funcall NativeNumber (nativeGet before "size")))
                 (initial (await (piReadBytes handle 0 (Math/min size 65536) runtime started)))
                 (header-end (js-call initial :indexOf 10)))
            (unless (and (>= header-end 0) (<= header-end 65535)) (nativeObserverFail))
            (let* ((body-start (1+ header-end)) (tail-start (Math/max body-start (- size 8388608)))
                   (bytes (await (piReadBytes handle tail-start (- size tail-start) runtime started)))
                   (prefix (> tail-start body-start)) (fragment false))
              (when prefix
                (let ((preceding (await (piReadBytes handle (- tail-start 1) 1 runtime started))))
                  (unless (= (aref preceding 0) 10)
                    (let ((first-lf (js-call bytes :indexOf 10)))
                      (setq bytes (js-call bytes :subarray (if (>= first-lf 0) (1+ first-lf) (nativeGet bytes "length"))))))))
              (unless (or (= (nativeGet bytes "length") 0) (= (aref bytes (- (nativeGet bytes "length") 1)) 10))
                (setq fragment t)
                (setq bytes (js-call bytes :subarray 0 (1+ (js-call bytes :lastIndexOf 10)))))
              (let ((after (await (js-call handle :stat (js-object :bigint t))))
                    (current (await (funcall (nativeGet runtime "lstat") path (js-object :bigint t)))))
                (piReadDeadline runtime started) (piLogStat after) (piLogStat current)
                (unless (and (= (nativeFingerprint before) (nativeFingerprint after))
                  (= (nativeFingerprint before) (nativeFingerprint current))) (nativeObserverFail)))
              (let ((decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t))))
                (js-object :header_text (js-call decoder :decode (js-call initial :subarray 0 header-end))
                  :entries_text (js-call decoder :decode bytes) :prefix_truncated prefix :trailing_fragment_discarded fragment))))
          (finally (when handle (await (js-call handle :close))))))))
  (defasync executeNativeObservation (request root binding &optional runtime)
    (let* ((r (nativeRequest request)) (b (validateNativeBinding binding))
           (ports (or runtime (js-object :loadO loadObserverBinding :observeO observeOpenCode :loadPi loadPiObserverBinding
             :readPi readPiSnapshot :fetch nativeFetch :now (lambda () (performance/now))))))
      (if (= (nativeGet (nativeGet r "parameters") "tool") "pi")
        (let* ((pb (validatePiObserverBinding (await (funcall (nativeGet ports "loadPi") root (nativeGet b "pi_binding_ref")))))
               (target (js-call (nativeGet pb "targets") :find (lambda (row)
                 (= (nativeGet row "native_session_id") (nativeGet (nativeGet r "parameters") "native_session_id"))))))
          (unless target (nativeObserverFail))
          (observePiLog r pb (await (funcall (nativeGet ports "readPi") target))))
        (let ((ob (await (funcall (nativeGet ports "loadO") root (nativeGet b "opencode_binding_ref")))))
          (await (funcall (nativeGet ports "observeO") r ob (js-object :fetch (nativeGet ports "fetch") :now (nativeGet ports "now"))))))))
  (defasync main ()
    (let ((request nil))
      (try
        (setq request (await (readNativeObserverRequest (js-call (nativeGet NativeBun "stdin") :stream))))
        (unless (= (js-length (nativeGet globalThis.process "argv")) 3) (nativeObserverFail))
        (let* ((root (js-call globalThis.process :cwd))
               (binding (await (loadNativeObserverBinding root (aref (nativeGet globalThis.process "argv") 2))))
               (response (await (executeNativeObservation request root binding))) (text (str (JSON/stringify response) "\n")))
          (when (> (Buffer/byteLength text "utf8") 1048576) (nativeObserverFail))
          (js-call (nativeGet globalThis.process "stdout") :write text))
        (catch failure
          (js-call (nativeGet globalThis.process "stdout") :write
            (str (JSON/stringify (js-object :schema_version 1 :request_id (nativeGet request "request_id" nil)
              :operation (nativeGet request "operation" nil) :run_id (nativeGet request "run_id" nil)
              :ok false :error (js-object :code "native_observation_unavailable"))) "\n"))
          (js-call (nativeGet globalThis.process "stderr") :write "native_observer_failed\n")
          (put globalThis.process :exitCode 1)))))
  (when (js-call (or (aref (nativeGet globalThis.process "argv") 1) "") :endsWith "/tools/native-observer-controller.mjs") (main))
  (export readNativeObserverRequest loadNativeObserverBinding loadPiObserverBinding readPiSnapshot executeNativeObservation))
