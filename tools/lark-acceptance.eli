(module dj.tools.lark-acceptance
  (import "../src/core/native.eli" NativeGlobal nativeGet nativeTypeOf nativeNullish)
  (import "../src/core/types.eli" hashValue)
  (import "node:path" isAbsolute basename)
  (defun larkFail () (throw (new globalThis.Error "native_lark_acceptance_unavailable")))
  (defun larkPlain (value)
    (and value (= (nativeTypeOf value) "object") (not (Array/isArray value))
      (or (= (Object/getPrototypeOf value) nil)
        (= (Object/getPrototypeOf value) (nativeGet (nativeGet NativeGlobal "Object") "prototype")))))
  (defun larkId (value &optional prefix)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_.:-]{1,256}$") :test value)
      (or (not prefix) (and (js-call value :startsWith prefix) (> (js-length value) (js-length prefix))))))
  (defun larkDense (rows maximum)
    (and (Array/isArray rows) (<= (js-length rows) maximum)
      (let ((index 0) (valid t))
        (while (< index (js-length rows))
          (unless (object-has? rows index) (setq valid false))
          (setq index (1+ index))) valid)))
  (defun larkThread (value)
    (if (nativeNullish value) nil
      (progn (unless (or (larkId value "om_") (larkId value "omt_")) (larkFail)) value)))
  (defun larkRef (value)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}$") :test value)))
  (defun validateLarkRequest (request)
    (let* ((op (nativeGet request "operation")) (p (nativeGet request "parameters"))
           (run (nativeGet request "run_id")))
      (unless (and (larkPlain request) (= (nativeGet request "schema_version") 1)
        (larkId (nativeGet request "request_id")) (larkId run) (larkPlain p)
        (js-call (js-array "stimulus-lark" "observe-reply-lark") :includes op)
        (= (nativeGet p "run_id") run) (larkId (nativeGet p "connection_id"))
        (larkId (nativeGet p "chat_id") "oc_")) (larkFail))
      (let ((safe (js-object :connection_id (nativeGet p "connection_id") :chat_id (nativeGet p "chat_id")
              :thread_id (larkThread (nativeGet p "thread_id" nil)) :run_id run)))
        (if (= op "stimulus-lark")
          (progn
            (unless (= (nativeGet p "text") (str "DJ acceptance " run ": use DJ message.reply to return this exact marker.")) (larkFail))
            (put safe :text (nativeGet p "text")))
          (let ((ids (nativeGet p "native_message_ids")) (seen (new globalThis.Set)) (copy (js-array)))
            (unless (and (larkDense ids 50) (> (js-length ids) 0)
              (larkId (nativeGet p "reply_to_message_id") "om_")) (larkFail))
            (js-call ids :forEach (lambda (id)
              (unless (and (larkId id "om_") (not (js-call seen :has id))) (larkFail))
              (js-call seen :add id) (js-call copy :push id)))
            (put safe :native_message_ids (Object/freeze copy))
            (put safe :reply_to_message_id (nativeGet p "reply_to_message_id"))))
        (Object/freeze (js-object :schema_version 1 :request_id (nativeGet request "request_id")
          :operation op :run_id run :parameters (Object/freeze safe))))))
  (defun validateLarkBinding (binding)
    (let ((ops (nativeGet binding "operations")) (targets (nativeGet binding "targets"))
          (seen (new globalThis.Set)) (safe-ops (js-array)) (safe-targets (js-array)))
      (unless (and (larkPlain binding) (= (nativeGet binding "schema_version") 1)
        (= (nativeGet binding "authorized") t) (larkDense ops 2) (> (js-length ops) 0)
        (larkDense targets 16) (> (js-length targets) 0)
        (larkRef (nativeGet binding "credential_ref")) (larkId (nativeGet binding "expected_app_id") "cli_")
        (larkId (nativeGet binding "expected_user_open_id") "ou_") (larkRef (nativeGet binding "state_ref"))) (larkFail))
      (js-call ops :forEach (lambda (op)
        (unless (and (js-call (js-array "stimulus-lark" "observe-reply-lark") :includes op)
          (not (js-call seen :has op))) (larkFail))
        (js-call seen :add op) (js-call safe-ops :push op)))
      (js-call seen :clear)
      (js-call targets :forEach (lambda (target)
        (unless (and (larkPlain target) (larkId (nativeGet target "connection_id"))
          (larkId (nativeGet target "chat_id") "oc_")) (larkFail))
        (let* ((thread (larkThread (nativeGet target "thread_id" nil)))
               (root (nativeGet target "thread_root_message_id" nil))
               (key (JSON/stringify (js-array (nativeGet target "connection_id") (nativeGet target "chat_id") thread))))
          (unless (and (if thread (larkId root "om_") (= root nil)) (not (js-call seen :has key))) (larkFail))
          (js-call seen :add key)
          (js-call safe-targets :push (Object/freeze (js-object :connection_id (nativeGet target "connection_id")
            :chat_id (nativeGet target "chat_id") :thread_id thread :thread_root_message_id root))))))
      (Object/freeze (js-object :schema_version 1 :authorized t :operations (Object/freeze safe-ops)
        :credential_ref (nativeGet binding "credential_ref") :expected_app_id (nativeGet binding "expected_app_id")
        :expected_user_open_id (nativeGet binding "expected_user_open_id") :state_ref (nativeGet binding "state_ref")
        :targets (Object/freeze safe-targets)))))
  (defun larkIntentIdentity (request binding)
    (let* ((r (validateLarkRequest request)) (b (validateLarkBinding binding)) (p (nativeGet r "parameters"))
           (scope (js-array (nativeGet r "run_id") (nativeGet p "connection_id") (nativeGet p "chat_id") (nativeGet p "thread_id")))
           (digest (hashValue scope)))
      (Object/freeze (js-object :intent_key (str "intent_" digest)
        :payload_hash (hashValue (js-array scope (nativeGet b "credential_ref") (nativeGet b "expected_app_id")
          (nativeGet b "expected_user_open_id") (nativeGet p "text")))
        :native_key (str "dj-test-" (js-call digest :slice 0 40))))))
  (defasync larkRequest (runtime state path method body)
    (let* ((elapsed (- (funcall (nativeGet runtime "now")) (nativeGet state "started")))
           (remaining (- 30000 elapsed)))
      (unless (and (Number/isFinite elapsed) (>= elapsed 0) (> remaining 0)) (larkFail))
      (let* ((response (await (funcall (nativeGet runtime "request") path method body (Math/min 10000 remaining))))
             (wire (nativeGet response "wire")))
        (unless (and (= (nativeGet response "status") 200) (= (nativeGet wire "code") 0)
          (larkPlain (nativeGet wire "data"))) (larkFail))
        (put state :bytes (+ (nativeGet state "bytes") (Buffer/byteLength (JSON/stringify wire) "utf8")))
        (when (> (nativeGet state "bytes") 8388608) (larkFail))
        (nativeGet wire "data"))))
  (defasync larkApi (binding runtime state path parameters)
    (let ((query (new globalThis.URLSearchParams)))
      (js-call (Object/entries parameters) :forEach (lambda (entry)
        (let ((value (aref entry 1)))
          (if (Array/isArray value)
            (js-call value :forEach (lambda (item) (js-call query :append (aref entry 0) (str item))))
            (js-call query :set (aref entry 0) (str value))))))
      (await (larkRequest runtime state (str path "?" (js-call query :toString)) "GET" nil))))
  (defasync larkPreflight (binding runtime state)
    (let ((meta (await (larkRequest runtime state "/open-apis/authen/v1/user_info" "GET" nil))))
      (unless (= (nativeGet meta "open_id") (nativeGet binding "expected_user_open_id")) (larkFail))))
  (defun larkNativeThread (row)
    (let ((thread (nativeGet row "thread_id" nil))) (if (= thread "") nil (larkThread thread))))
  (defun larkNativeScope (row target &optional allow-root)
    (unless (and (larkPlain row) (larkId (nativeGet row "message_id") "om_")
      (= (nativeGet row "chat_id") (nativeGet target "chat_id"))
      (or (= (larkNativeThread row) (nativeGet target "thread_id"))
        (and allow-root (= (nativeGet target "thread_id") nil))
        (and allow-root (= (nativeGet row "message_id") (nativeGet target "thread_root_message_id"))))) (larkFail)))
  (defun larkTextProof (row binding target parent text exact)
    (larkNativeScope row target)
    (let* ((sender (nativeGet row "sender")) (content (nativeGet (nativeGet row "body") "content")))
      (unless (and (not (= (nativeGet row "deleted") t)) (= (nativeGet row "msg_type") "text")
        (= (nativeGet sender "sender_type") "user") (= (nativeGet sender "id_type") "open_id")
        (= (nativeGet sender "id") (nativeGet binding "expected_user_open_id"))
        (= (or (nativeGet row "parent_id" nil) nil) parent) (= (nativeTypeOf content) "string")) (larkFail))
      (let ((body (JSON/parse content)))
        (unless (and (larkPlain body) (= (nativeTypeOf (nativeGet body "text")) "string")
          (if exact (= (nativeGet body "text") text) (js-call (nativeGet body "text") :includes text))) (larkFail)))))
  (defasync larkMget (binding runtime state id)
    (let* ((data (await (larkApi binding runtime state "/open-apis/im/v1/messages/mget" (js-object :message_ids (js-array id)))))
           (items (nativeGet data "items")))
      (unless (and (larkDense items 1) (= (js-length items) 1) (= (nativeGet (aref items 0) "message_id") id)) (larkFail))
      (aref items 0)))
  (defun larkRecord (identity status id)
    (js-object :intent_key (nativeGet identity "intent_key") :payload_hash (nativeGet identity "payload_hash")
      :state status :native_message_id id))
  (defun larkValidRecord (row identity)
    (and (larkPlain row) (= (nativeGet row "intent_key") (nativeGet identity "intent_key"))
      (= (nativeGet row "payload_hash") (nativeGet identity "payload_hash"))
      (js-call (js-array "unknown" "confirmed") :includes (nativeGet row "state"))
      (if (= (nativeGet row "state") "confirmed") (larkId (nativeGet row "native_message_id") "om_")
        (or (= (nativeGet row "native_message_id") nil) (larkId (nativeGet row "native_message_id") "om_")))))
  (defasync larkStimulus (request binding target runtime state)
    (let* ((p (nativeGet request "parameters")) (identity (larkIntentIdentity request binding))
           (key (nativeGet identity "intent_key")) (old (funcall (nativeGet runtime "readIntent") key))
           (id nil) (already-confirmed false))
      (when old
        (unless (larkValidRecord old identity) (larkFail))
        (setq id (nativeGet old "native_message_id"))
        (setq already-confirmed (= (nativeGet old "state") "confirmed"))
        (unless id (larkFail)))
      (await (larkPreflight binding runtime state))
      (unless old
        (when (nativeGet target "thread_id")
          (let ((root (await (larkMget binding runtime state (nativeGet target "thread_root_message_id")))))
            (larkNativeScope root target)
            (when (= (nativeGet root "deleted") t) (larkFail))))
        (unless (= (funcall (nativeGet runtime "createIntent") key (larkRecord identity "unknown" nil)) t) (larkFail))
        (let* ((thread (nativeGet target "thread_id"))
                (path (if thread (str "/open-apis/im/v1/messages/" (nativeGet target "thread_root_message_id") "/reply")
                  "/open-apis/im/v1/messages?receive_id_type=chat_id"))
                (body (js-object :msg_type "text" :content (JSON/stringify (js-object :text (nativeGet p "text")))
                  :uuid (nativeGet identity "native_key"))))
          (if thread (put body :reply_in_thread t) (put body :receive_id (nativeGet target "chat_id")))
          (let ((data (await (larkRequest runtime state path "POST" body))))
            (unless (and (larkId (nativeGet data "message_id") "om_")
              (= (nativeGet data "chat_id") (nativeGet target "chat_id"))) (larkFail))
            (setq id (nativeGet data "message_id"))
            (unless (= (funcall (nativeGet runtime "updateIntent") key (larkRecord identity "unknown" id)) t) (larkFail)))))
      (let ((row (await (larkMget binding runtime state id))))
        (larkTextProof row binding target (if (nativeGet target "thread_id") (nativeGet target "thread_root_message_id") nil)
          (nativeGet p "text") t)
        (unless already-confirmed
          (unless (= (funcall (nativeGet runtime "updateIntent") key (larkRecord identity "confirmed" id)) t) (larkFail)))
        (js-object :native_message_id (nativeGet row "message_id") :chat_id (nativeGet row "chat_id")
          :thread_id (larkNativeThread row) :identity "user" :observation_source "lark_openapi_v1"))))
  (defasync larkObserve (request binding target runtime state)
    (await (larkPreflight binding runtime state))
    (let* ((p (nativeGet request "parameters")) (wanted (nativeGet p "native_message_ids"))
           (found (new globalThis.Map)) (seen (new globalThis.Set)) (tokens (new globalThis.Set))
           (token nil) (page 0) (count 0) (more t))
      (while (and more (< page 8) (< (nativeGet found "size") (js-length wanted)))
        (let ((query (js-object :container_id_type (if (nativeGet target "thread_id") "thread" "chat")
                :container_id (or (nativeGet target "thread_id") (nativeGet target "chat_id"))
                :sort_type "ByCreateTimeDesc" :page_size 50)))
          (when token (put query :page_token token))
          (let* ((data (await (larkApi binding runtime state "/open-apis/im/v1/messages" query)))
                 (rows (nativeGet data "items")) (has-more (nativeGet data "has_more")) (next (nativeGet data "page_token")))
            (unless (and (larkDense rows 50) (= (nativeTypeOf has-more) "boolean")) (larkFail))
            (when has-more
              (unless (and (> (js-length rows) 0) (= (nativeTypeOf next) "string") (> (js-length next) 0)
                (<= (js-length next) 4096) (not (js-call tokens :has next))) (larkFail))
              (js-call tokens :add next))
            (setq count (+ count (js-length rows))) (when (> count 400) (larkFail))
            (js-call rows :forEach (lambda (row)
              (larkNativeScope row target t)
              (let ((id (nativeGet row "message_id")))
                (when (js-call seen :has id) (larkFail)) (js-call seen :add id)
                (when (js-call wanted :includes id)
                  (larkTextProof row binding target (nativeGet p "reply_to_message_id") (nativeGet request "run_id") false)
                  (js-call found :set id row)))))
            (setq more has-more) (setq token next) (setq page (1+ page)))))
      (unless (= (nativeGet found "size") (js-length wanted)) (larkFail))
      (let* ((first (js-call found :get (aref wanted 0))) (ids (js-array)))
        (js-call wanted :forEach (lambda (id) (js-call ids :push (nativeGet (js-call found :get id) "message_id"))))
        (js-object :native_message_ids ids :chat_id (nativeGet first "chat_id") :thread_id (larkNativeThread first)
          :reply_to_message_id (nativeGet first "parent_id") :identity "user" :observation_source "lark_openapi_v1"))))
  (defasync executeLarkAcceptance (request binding runtime)
    (try
      (let* ((r (validateLarkRequest request)) (b (validateLarkBinding binding)) (p (nativeGet r "parameters"))
             (target (js-call (nativeGet b "targets") :find (lambda (candidate)
               (and (= (nativeGet candidate "connection_id") (nativeGet p "connection_id"))
                 (= (nativeGet candidate "chat_id") (nativeGet p "chat_id"))
                 (= (nativeGet candidate "thread_id") (nativeGet p "thread_id")))))))
        (unless (and target (js-call (nativeGet b "operations") :includes (nativeGet r "operation"))) (larkFail))
        (let* ((state (js-object :started (funcall (nativeGet runtime "now")) :bytes 0))
               (data (if (= (nativeGet r "operation") "stimulus-lark")
                 (await (larkStimulus r b target runtime state)) (await (larkObserve r b target runtime state)))))
          (js-object :schema_version 1 :request_id (nativeGet r "request_id") :run_id (nativeGet r "run_id")
            :operation (nativeGet r "operation") :ok t :data data)))
      (catch failure (larkFail))))
  (export validateLarkRequest validateLarkBinding larkIntentIdentity executeLarkAcceptance))
