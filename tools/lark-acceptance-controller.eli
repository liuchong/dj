(module dj.tools.lark-acceptance-controller
  (import "../src/core/native.eli" NativeBun nativeGet nativeTypeOf nativeBitAnd nativeSetTimeout nativeClearTimeout)
  (import "./lark-acceptance.eli" validateLarkRequest validateLarkBinding executeLarkAcceptance)
  (import "node:fs/promises" lstat open)
  (import "node:fs" constants)
  (import "node:path" resolve)
  (import "bun:sqlite" Database)
  (import "../src/adapters/im/lark-http.eli" createLarkHttpTransport)
  (import "../src/host/bun/io.eli" createHostPorts)
  (defun controllerFail () (throw (new globalThis.Error "native_lark_acceptance_unavailable")))
  (defun controllerRef (ref)
    (and (= (nativeTypeOf ref) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,79}$") :test ref)))
  (defasync controllerRoot (root)
    (let ((info (await (lstat root))))
      (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink))
        (= (nativeGet info "uid") (js-call globalThis.process :getuid))
        (= (nativeBitAnd (nativeGet info "mode") 63) 0)) (controllerFail))))
  (defun controllerPrivate (info maximum)
    (unless (and (js-call info :isFile) (not (js-call info :isSymbolicLink))
      (= (nativeGet info "uid") (js-call globalThis.process :getuid))
      (= (nativeBitAnd (nativeGet info "mode") 63) 0) (<= (nativeGet info "size") maximum)) (controllerFail)))
  (defasync controllerReadPrivate (root ref)
    (unless (controllerRef ref) (controllerFail))
    (await (controllerRoot root))
    (let* ((path (resolve root ref)) (info (await (lstat path))) (handle nil))
      (controllerPrivate info 65536)
      (try
        (setq handle (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))
        (controllerPrivate (await (js-call handle :stat)) 65536)
        (let ((bytes (await (js-call handle :readFile))))
          (when (> (nativeGet bytes "byteLength") 65536) (controllerFail))
          (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode bytes)))
        (finally (when handle (await (js-call handle :close)))))))
  (defasync loadLarkBinding (root ref)
    (let ((binding (validateLarkBinding (await (controllerReadPrivate root ref)))))
      (when (or (= ref (nativeGet binding "state_ref")) (= ref (nativeGet binding "credential_ref"))
        (= (nativeGet binding "state_ref") (nativeGet binding "credential_ref"))) (controllerFail))
      (let ((credential (await (controllerReadPrivate root (nativeGet binding "credential_ref")))))
        (unless (= (nativeGet credential "app_id") (nativeGet binding "expected_app_id")) (controllerFail)))
      binding))
  (defasync readLarkRequest (stream)
    (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t)))
          (bytes 0) (text "") (done false))
      (try
        (while (not done)
          (let ((part (await (js-call reader :read))))
            (setq done (nativeGet part "done"))
            (unless done
              (setq bytes (+ bytes (nativeGet (nativeGet part "value") "byteLength")))
              (when (> bytes 65536) (controllerFail))
              (setq text (str text (js-call decoder :decode (nativeGet part "value") (js-object :stream t)))))))
        (validateLarkRequest (JSON/parse (str text (js-call decoder :decode))))
        (finally
          (unless done (await (js-call reader :cancel))) (js-call reader :releaseLock)))))
  (defun intentRow (key row)
    (unless (and row (= (nativeGet row "intent_key") key)
      (= (nativeTypeOf key) "string") (js-call (new globalThis.RegExp "^intent_[0-9a-f]{64}$") :test key)
      (= (nativeTypeOf (nativeGet row "payload_hash")) "string")
      (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (nativeGet row "payload_hash"))
      (js-call (js-array "unknown" "confirmed") :includes (nativeGet row "state"))
      (if (= (nativeGet row "native_message_id") nil) (= (nativeGet row "state") "unknown")
        (and (= (nativeTypeOf (nativeGet row "native_message_id")) "string")
          (js-call (new globalThis.RegExp "^om_[A-Za-z0-9_.:-]{1,253}$") :test (nativeGet row "native_message_id"))))) (controllerFail))
    (js-object :intent_key key :payload_hash (nativeGet row "payload_hash") :state (nativeGet row "state")
      :native_message_id (nativeGet row "native_message_id")))
  (defasync openLarkIntentStore (root ref)
    (unless (controllerRef ref) (controllerFail))
    (await (controllerRoot root))
    (let ((path (resolve root ref)) (handle nil) (created false) (db nil) (closed false))
      (try
        (try
          (setq handle (await (open path (+ (nativeGet constants "O_RDWR") (nativeGet constants "O_CREAT")
            (nativeGet constants "O_EXCL") (nativeGet constants "O_NOFOLLOW")) 384)))
          (setq created t)
          (catch failure
            (unless (= (nativeGet failure "code") "EEXIST") (throw failure))
            (controllerPrivate (await (lstat path)) 67108864)
            (setq handle (await (open path (+ (nativeGet constants "O_RDONLY") (nativeGet constants "O_NOFOLLOW")))))))
        (controllerPrivate (await (js-call handle :stat)) 67108864)
        (unless created
          (let* ((header (Buffer/alloc 100)) (part (await (js-call handle :read header 0 100 0))))
            (unless (and (= (nativeGet part "bytesRead") 100)
              (= (js-call header :toString "utf8" 0 16) "SQLite format 3\u0000")
              (= (js-call header :readUInt32BE 68) 1145719883) (= (js-call header :readUInt32BE 60) 1)) (controllerFail))))
        (await (js-call handle :close)) (setq handle nil)
        (setq db (new Database path (js-object :create false :strict t)))
        (if created
          (progn
            (js-call db :exec "PRAGMA journal_mode=DELETE; PRAGMA synchronous=FULL; PRAGMA busy_timeout=1000;")
            (js-call db :exec "BEGIN IMMEDIATE")
            (try
              (js-call db :exec "PRAGMA application_id=1145719883; PRAGMA user_version=1; CREATE TABLE dj_lark_test_intents(intent_key TEXT PRIMARY KEY,payload_hash TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN ('unknown','confirmed')),native_message_id TEXT,payload TEXT NOT NULL CHECK(json_valid(payload))) STRICT;")
              (js-call db :exec "COMMIT")
              (catch failure (js-call db :exec "ROLLBACK") (throw failure))))
          (progn
            (unless (and (= (nativeGet (js-call (js-call db :query "PRAGMA application_id") :get) "application_id") 1145719883)
              (= (nativeGet (js-call (js-call db :query "PRAGMA user_version") :get) "user_version") 1)) (controllerFail))
            (js-call db :exec "PRAGMA synchronous=FULL; PRAGMA busy_timeout=1000;")))
        (let ((read-row (lambda (key)
                (when closed (controllerFail))
                (let ((row (js-call (js-call db :query "SELECT intent_key,payload_hash,state,native_message_id,payload FROM dj_lark_test_intents WHERE intent_key=?") :get key)))
                  (if (not row) nil
                    (let ((payload (intentRow key (JSON/parse (nativeGet row "payload")))))
                      (js-call (js-array "intent_key" "payload_hash" "state" "native_message_id") :forEach (lambda (field)
                        (unless (= (nativeGet row field) (nativeGet payload field)) (controllerFail))))
                      payload))))))
          (js-object
            :readIntent read-row
            :createIntent (lambda (key row)
              (when closed (controllerFail))
              (let ((safe (intentRow key row)))
                (unless (and (= (nativeGet safe "state") "unknown") (= (nativeGet safe "native_message_id") nil)) (controllerFail))
                (= (nativeGet (js-call (js-call db :query "INSERT INTO dj_lark_test_intents(intent_key,payload_hash,state,native_message_id,payload) VALUES(?,?,?,?,?) ON CONFLICT(intent_key) DO NOTHING")
                  :run key (nativeGet safe "payload_hash") "unknown" nil (JSON/stringify safe)) "changes") 1)))
            :updateIntent (lambda (key row)
              (when closed (controllerFail))
              (let* ((safe (intentRow key row)) (old (funcall read-row key)))
                (if (not (and old (= (nativeGet old "payload_hash") (nativeGet safe "payload_hash"))
                  (if (= (nativeGet old "state") "confirmed")
                    (and (= (nativeGet safe "state") "confirmed") (= (nativeGet old "native_message_id") (nativeGet safe "native_message_id")))
                    (if (= (nativeGet old "native_message_id") nil)
                      (= (nativeGet safe "state") "unknown")
                      (= (nativeGet old "native_message_id") (nativeGet safe "native_message_id")))))) false
                  (= (nativeGet (js-call (js-call db :query "UPDATE dj_lark_test_intents SET state=?,native_message_id=?,payload=? WHERE intent_key=? AND payload_hash=? AND state=? AND native_message_id IS ?")
                    :run (nativeGet safe "state") (nativeGet safe "native_message_id") (JSON/stringify safe)
                    key (nativeGet old "payload_hash") (nativeGet old "state") (nativeGet old "native_message_id")) "changes") 1))))
            :close (lambda () (unless closed (setq closed t) (js-call db :close)))))
        (catch failure (when db (js-call db :close)) (throw failure))
        (finally (when handle (await (js-call handle :close)))))))
  (defasync main ()
    (let* ((request nil) (store nil) (transport nil) (controller (new globalThis.AbortController))
           (stop (lambda () (js-call controller :abort))))
      (js-call globalThis.process :on "SIGTERM" stop) (js-call globalThis.process :on "SIGINT" stop)
      (try
        (setq request (await (readLarkRequest (js-call (nativeGet NativeBun "stdin") :stream))))
        (unless (= (js-length (nativeGet globalThis.process "argv")) 3) (controllerFail))
        (let* ((root (js-call globalThis.process :cwd))
               (binding (await (loadLarkBinding root (aref (nativeGet globalThis.process "argv") 2)))))
          (when (= (nativeGet request "operation") "stimulus-lark")
            (setq store (await (openLarkIntentStore root (nativeGet binding "state_ref")))))
          (setq transport (createLarkHttpTransport (js-object :identity "user" :brand "lark"
            :credential_ref (resolve root (nativeGet binding "credential_ref"))
            :user_identity (js-object :app_id (nativeGet binding "expected_app_id")
              :open_id (nativeGet binding "expected_user_open_id"))) (createHostPorts)))
          (let* ((runtime (Object/assign (js-object :now (lambda () (performance/now))
                    :request (async (path method body timeout)
                      (js-call transport :request path method body (js-object :abort_signal (nativeGet controller "signal")
                        :deadline (+ (performance/now) timeout))))) (or store (js-object))))
                 (response (await (executeLarkAcceptance request binding runtime)))
                 (text (str (JSON/stringify response) "\n")))
            (when (> (Buffer/byteLength text "utf8") 1048576) (controllerFail))
            (js-call (nativeGet globalThis.process "stdout") :write text)))
        (catch failure
          (js-call (nativeGet globalThis.process "stdout") :write (str (JSON/stringify (js-object :schema_version 1
            :request_id (nativeGet request "request_id" nil) :run_id (nativeGet request "run_id" nil)
            :operation (nativeGet request "operation" nil) :ok false
            :error (js-object :code "native_lark_acceptance_unavailable"))) "\n"))
          (js-call (nativeGet globalThis.process "stderr") :write "lark_acceptance_failed\n")
          (put globalThis.process :exitCode 1))
        (finally
          (when transport (js-call transport :close))
          (when store (js-call store :close))
          (js-call globalThis.process :removeListener "SIGTERM" stop)
          (js-call globalThis.process :removeListener "SIGINT" stop)))))
  (when (js-call (or (aref (nativeGet globalThis.process "argv") 1) "") :endsWith "/tools/lark-acceptance-controller.mjs") (main))
  (export loadLarkBinding readLarkRequest openLarkIntentStore))
