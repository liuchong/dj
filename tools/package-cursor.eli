(module dj.tools.package-cursor
  (import "node:fs/promises" mkdir copyFile readFile writeFile)
  (import "node:path" resolve)
  (import "node:crypto" randomUUID)
  (import "./build-inputs.eli" assertBuildBinding sha256)
  (import "../src/core/native.eli" nativeGet)
  (defasync packageCursorControl ()
    (await (assertBuildBinding (JSON/parse (await (readFile ".local/build/manifest.json" "utf8")))))
    (let* ((out (resolve ".local/packages" (str "dj-cursor-control-" (randomUUID))))
           (extension (resolve out "extension"))
           (built nil) (files (js-object)))
      (await (mkdir extension (js-object :recursive t :mode 448)))
      (setq built (await (Bun/build (js-object
        :entrypoints (js-array "dist/src/adapters/agent/cursor-control.mjs")
        :outdir extension :naming "control.cjs" :target "node" :format "cjs" :minify false))))
      (unless (nativeGet built "success") (throw (new globalThis.Error "cursor_control_bundle_failed")))
      (let ((names (js-array "package.json" "extension.cjs" "README.md")) (index 0))
        (while (< index (js-length names))
          (let ((name (aref names index)))
            (await (copyFile (str "connectors/cursor/" name) (resolve extension name)))
            (put files name (sha256 (await (readFile (resolve extension name))))))
          (setq index (1+ index))))
      (put files "control.cjs" (sha256 (await (readFile (resolve extension "control.cjs")))))
      (await (copyFile "connectors/cursor/extension.vsixmanifest" (resolve out "extension.vsixmanifest")))
      (await (copyFile "connectors/cursor/[Content_Types].xml" (resolve out "[Content_Types].xml")))
      (let ((zip (Bun/spawnSync (js-array "zip" "-q" "-r" "dj-cursor-control.vsix"
                    "extension" "extension.vsixmanifest" "[Content_Types].xml")
                  (js-object :cwd out :stdout "pipe" :stderr "pipe"))))
        (unless (= (nativeGet zip "exitCode") 0)
          (throw (new globalThis.Error "cursor_control_archive_failed"))))
      (put files "dj-cursor-control.vsix" (sha256 (await (readFile (resolve out "dj-cursor-control.vsix")))))
      (await (writeFile (resolve out "package-manifest.json") (JSON/stringify
        (js-object :version 1 :kind "dj-cursor-create-only" :files files)) (js-object :mode 384)))
      (js-object :output out :files (js-length (Object/keys files)))))
  (defasync main ()
    (try
      (js-call globalThis.console :log (JSON/stringify (await (packageCursorControl))))
      (catch invalid
        (js-call globalThis.console :error "Cursor connector package failed")
        (put globalThis.process :exitCode 1))))
  (when (js-call (or (aref (nativeGet globalThis.process "argv") 1) "") :endsWith "/tools/package-cursor.mjs")
    (main))
  (export packageCursorControl))
