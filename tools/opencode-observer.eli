(module dj.tools.opencode-observer
  (import "../src/core/native.eli" NativeGlobal nativeGet nativeTypeOf nativeEncodeURIComponent nativeSetTimeout nativeClearTimeout)
  (import "../src/core/types.eli" stableSessionKey)
  (import "node:path" isAbsolute)
  (defun observerFail () (throw (new globalThis.Error "native_observation_unavailable")))
  (defun observerPlain (value)
    (and value (= (nativeTypeOf value) "object") (not (Array/isArray value))
      (or (= (Object/getPrototypeOf value) nil)
        (= (Object/getPrototypeOf value) (nativeGet (nativeGet NativeGlobal "Object") "prototype")))))
  (defun observerId (value)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_.:-]{1,256}$") :test value)))
  (defun observerDense (items maximum)
    (and (Array/isArray items) (<= (js-length items) maximum)
      (let ((index 0) (valid t))
        (while (< index (js-length items))
          (unless (object-has? items index) (setq valid false))
          (setq index (1+ index))) valid)))
  (defun validateObserverRequest (request)
    (let* ((operation (nativeGet request "operation")) (parameters (nativeGet request "parameters"))
           (run (nativeGet request "run_id")) (empty (= operation "observe-empty-opencode")))
      (unless (and (observerPlain request) (= (nativeGet request "schema_version") 1)
        (observerId (nativeGet request "request_id")) (observerId run)
        (js-call (js-array "observe-direct-input" "observe-native-start" "observe-empty-opencode") :includes operation)
        (observerPlain parameters) (= (nativeGet parameters "run_id") run)
        (observerId (nativeGet parameters "native_session_id"))) (observerFail))
      (let ((safe (js-object :run_id run :native_session_id (nativeGet parameters "native_session_id"))))
        (if empty
          (progn
            (unless (and (observerId (nativeGet parameters "instance_id"))
              (not (object-has? parameters "tool"))
              (= (nativeTypeOf (nativeGet parameters "session_key")) "string")
              (js-call (new globalThis.RegExp "^session_[0-9a-f]{64}$") :test (nativeGet parameters "session_key")))
              (observerFail))
            (put safe :instance_id (nativeGet parameters "instance_id"))
            (put safe :session_key (nativeGet parameters "session_key")))
          (progn
            (unless (and (= (nativeGet parameters "tool") "opencode")
              (observerId (nativeGet parameters "delivery_id"))) (observerFail))
            (put safe :tool "opencode") (put safe :delivery_id (nativeGet parameters "delivery_id"))))
        (Object/freeze (js-object :schema_version 1 :request_id (nativeGet request "request_id")
          :operation operation :run_id run :parameters (Object/freeze safe))))))
  (defun validateObserverBinding (binding)
    (let* ((endpoint (nativeGet binding "endpoint")) (auth (nativeGet binding "auth"))
           (targets (nativeGet binding "targets")) (seen (new globalThis.Set)))
      (unless (and (observerPlain binding) (= (nativeGet binding "schema_version") 1)
        (= (nativeGet binding "authorized") t) (observerPlain endpoint) (observerPlain auth)
        (= (nativeTypeOf (nativeGet endpoint "base_url")) "string")
        (= (nativeTypeOf (nativeGet endpoint "directory")) "string")
        (isAbsolute (nativeGet endpoint "directory"))
        (observerId (nativeGet endpoint "native_namespace")) (observerId (nativeGet endpoint "instance_id"))
        (observerId (nativeGet endpoint "native_instance_id")) (observerDense targets 16)) (observerFail))
      (let* ((url (new globalThis.URL (nativeGet endpoint "base_url")))
             (safe-auth (js-object :type (nativeGet auth "type"))))
        (unless (and (= (nativeGet url "username") "") (= (nativeGet url "password") "")
          (= (nativeGet url "search") "") (= (nativeGet url "hash") "") (= (nativeGet url "pathname") "/")
          (js-call (js-array "http:" "https:") :includes (nativeGet url "protocol"))
          (js-call (js-array "127.0.0.1" "[::1]" "localhost") :includes (nativeGet url "hostname"))) (observerFail))
        (unless (js-call (js-array "none" "basic") :includes (nativeGet auth "type")) (observerFail))
        (when (= (nativeGet auth "type") "basic")
          (let ((username (nativeGet auth "username")) (password (nativeGet auth "password")))
            (unless (and (= (nativeTypeOf username) "string") (> (js-length username) 0) (<= (js-length username) 4096)
              (= (nativeTypeOf password) "string") (> (js-length password) 0) (<= (js-length password) 4096)
              (not (js-call (new globalThis.RegExp "[:\\r\\n]") :test username))
              (not (js-call (new globalThis.RegExp "[\\r\\n]") :test password))) (observerFail))
            (put safe-auth :username username) (put safe-auth :password password)))
        (js-call targets :forEach (lambda (id)
          (unless (and (observerId id) (not (js-call seen :has id))) (observerFail))
          (js-call seen :add id)))
        (Object/freeze (js-object :schema_version 1 :authorized t
          :endpoint (Object/freeze (js-object :base_url (str (nativeGet url "origin") "/")
            :directory (nativeGet endpoint "directory") :native_namespace (nativeGet endpoint "native_namespace")
            :instance_id (nativeGet endpoint "instance_id") :native_instance_id (nativeGet endpoint "native_instance_id")))
          :auth (Object/freeze safe-auth) :targets (Object/freeze (js-call targets :slice)))))))
  (defun observerRemaining (runtime state)
    (let ((now (funcall (nativeGet runtime "now"))))
      (unless (and (Number/isFinite now) (>= now (nativeGet state "started"))
        (< (- now (nativeGet state "started")) 25000)) (observerFail))
      (- 25000 (- now (nativeGet state "started")))) )
  (defasync observerJson (binding runtime state path &optional cursor messages)
    (let* ((endpoint (nativeGet binding "endpoint")) (auth (nativeGet binding "auth"))
           (url (new globalThis.URL path (nativeGet endpoint "base_url")))
           (headers (new globalThis.Headers)) (controller (new globalThis.AbortController))
           (reader nil) (done false) (timer nil) (response nil))
      (js-call (nativeGet url "searchParams") :set "directory" (nativeGet endpoint "directory"))
      (when messages (js-call (nativeGet url "searchParams") :set "limit" "64"))
      (when cursor (js-call (nativeGet url "searchParams") :set "before" cursor))
      (when (= (nativeGet auth "type") "basic")
        (js-call headers :set "authorization" (str "Basic "
          (js-call (Buffer/from (str (nativeGet auth "username") ":" (nativeGet auth "password")) "utf8") :toString "base64"))))
      (try
        (setq timer (nativeSetTimeout (lambda () (js-call controller :abort))
          (Math/min 5000 (observerRemaining runtime state))))
        (setq response (await (funcall (nativeGet runtime "fetch") (str url)
          (js-object :method "GET" :headers headers :redirect "error" :signal (nativeGet controller "signal")))))
        (unless (= (nativeGet response "status") 200) (observerFail))
        (setq reader (js-call (nativeGet response "body") :getReader))
        (let ((decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t))) (size 0) (text ""))
          (while (not done)
            (let ((part (await (js-call reader :read))))
              (observerRemaining runtime state)
              (setq done (nativeGet part "done"))
              (unless done
                (setq size (+ size (nativeGet (nativeGet part "value") "byteLength")))
                (put state :bytes (+ (nativeGet state "bytes") (nativeGet (nativeGet part "value") "byteLength")))
                (when (or (> size 2097152) (> (nativeGet state "bytes") 8388608)) (observerFail))
                (setq text (str text (js-call decoder :decode (nativeGet part "value") (js-object :stream t)))))))
          (observerRemaining runtime state)
          (js-object :data (JSON/parse (str text (js-call decoder :decode)))
            :cursor (js-call (nativeGet response "headers") :get "X-Next-Cursor")))
        (finally
          (when timer (nativeClearTimeout timer))
          (if reader
            (progn (unless done (await (js-call reader :cancel))) (js-call reader :releaseLock))
            (when (and response (nativeGet response "body")) (await (js-call (nativeGet response "body") :cancel))))))))
  (defun observerSession (native endpoint session)
    (unless (and (observerPlain native) (= (nativeGet native "id") session)
      (= (nativeGet native "projectID") (nativeGet endpoint "native_namespace"))
      (= (nativeGet native "directory") (nativeGet endpoint "directory"))) (observerFail)))
  (defasync observeOpenCode (request binding runtime)
    (let* ((r (validateObserverRequest request)) (b (validateObserverBinding binding))
           (p (nativeGet r "parameters")) (endpoint (nativeGet b "endpoint"))
           (operation (nativeGet r "operation")) (empty (= operation "observe-empty-opencode"))
           (session (nativeGet p "native_session_id")) (path (str "/session/" (nativeEncodeURIComponent session)))
           (started (funcall (nativeGet runtime "now"))) (state (js-object :started started :bytes 0))
           (rows (js-array)) (seen (new globalThis.Set)) (cursors (new globalThis.Set))
           (cursor nil) (pages 0) (complete false) (candidates (js-array)))
      (unless (and (Number/isFinite started) (>= started 0)) (observerFail))
      (if empty
        (unless (and (= (nativeGet p "instance_id") (nativeGet endpoint "instance_id"))
          (= (nativeGet p "session_key") (stableSessionKey (js-object :tool "opencode"
            :native_namespace (nativeGet endpoint "native_namespace") :native_session_id session)))) (observerFail))
        (unless (js-call (nativeGet b "targets") :includes session) (observerFail)))
      (let ((health (nativeGet (await (observerJson b runtime state "/global/health")) "data")))
        (unless (and (= (nativeGet health "healthy") t) (= (nativeGet health "version") "1.18.30")) (observerFail)))
      (observerSession (nativeGet (await (observerJson b runtime state path)) "data") endpoint session)
      (while (not complete)
        (when (>= pages 16) (observerFail))
        (let* ((page (await (observerJson b runtime state (str path "/message") cursor t)))
               (items (nativeGet page "data")) (next (nativeGet page "cursor")))
          (unless (and (observerDense items 64) (<= (+ (js-length rows) (js-length items)) 1024)) (observerFail))
          (js-call items :forEach (lambda (row)
            (let ((info (nativeGet row "info")) (parts (nativeGet row "parts")))
              (unless (and (observerPlain row) (observerPlain info) (observerId (nativeGet info "id"))
                (= (nativeGet info "sessionID") session)
                (js-call (js-array "user" "assistant") :includes (nativeGet info "role"))
                (observerDense parts 1048576) (not (js-call seen :has (nativeGet info "id")))) (observerFail))
              (js-call seen :add (nativeGet info "id"))
              (js-call parts :forEach (lambda (part)
                (unless (and (observerPlain part) (= (nativeGet part "sessionID") session)
                  (= (nativeGet part "messageID") (nativeGet info "id"))
                  (= (nativeTypeOf (nativeGet part "type")) "string")) (observerFail))))
              (js-call rows :push row))))
          (setq pages (1+ pages))
          (if (= next nil)
            (setq complete t)
            (progn
              (unless (and (= (nativeTypeOf next) "string") (> (js-length next) 0) (<= (js-length next) 2048)
                (> (js-length items) 0) (not (js-call cursors :has next))) (observerFail))
              (js-call cursors :add next) (setq cursor next)))))
      (let ((data (js-object :native_session_id session :observation_source "opencode_http_v1" :native_version "1.18.30")))
        (if empty
          (progn
            (unless (= (js-length rows) 0) (observerFail))
            (Object/assign data (js-object :native_event_id session :session_key (nativeGet p "session_key") :prompt_count 0
              :native_instance_id (nativeGet endpoint "native_instance_id") :instance_identity_source "authorized_endpoint_binding")))
          (progn
            (js-call rows :forEach (lambda (row)
              (when (= (nativeGet (nativeGet row "info") "role") "user")
                (js-call (nativeGet row "parts") :forEach (lambda (part)
                  (when (and (= (nativeGet part "type") "text") (= (nativeTypeOf (nativeGet part "text")) "string"))
                    (let ((envelope nil))
                      (try (setq envelope (JSON/parse (nativeGet part "text"))) (catch failure (setq envelope nil)))
                      (when (and (observerPlain envelope) (= (nativeGet envelope "schema_version") 1)
                        (= (nativeGet envelope "kind") "external_message")
                        (= (nativeGet envelope "origin") (if (= operation "observe-direct-input") "direct" "subscription_event"))
                        (= (nativeGet envelope "delivery_id") (nativeGet p "delivery_id"))
                        (= (nativeTypeOf (nativeGet (nativeGet envelope "content") "text")) "string")
                        (js-call (nativeGet (nativeGet envelope "content") "text") :includes (nativeGet r "run_id")))
                        (js-call candidates :push (nativeGet (nativeGet row "info") "id"))))))))))
            (unless (= (js-length candidates) 1) (observerFail))
            (let* ((user (aref candidates 0)) (event user))
              (when (= operation "observe-native-start")
                (let ((assistant (js-call rows :find (lambda (row)
                  (and (= (nativeGet (nativeGet row "info") "role") "assistant")
                    (= (nativeGet (nativeGet row "info") "parentID") user))))))
                  (unless assistant (observerFail))
                  (setq event (nativeGet (nativeGet assistant "info") "id"))))
              (Object/assign data (js-object :native_message_id user :native_event_id event :observed_delivery_id (nativeGet p "delivery_id"))))))
        (observerSession (nativeGet (await (observerJson b runtime state path)) "data") endpoint session)
        (js-object :schema_version 1 :request_id (nativeGet r "request_id") :operation operation
          :run_id (nativeGet r "run_id") :ok t :data data))))
  (export validateObserverRequest validateObserverBinding observeOpenCode))
