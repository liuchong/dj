(module dj.tools.build
  (import "../src/core/native.eli" nativeTypeOf NativeBun nativeGet)
  (import "node:fs/promises" readFile writeFile mkdir readdir realpath rm rename)
  (import "node:path" resolve relative)
  (import "./build-inputs.eli" sha256 requiredBuildInputs)
  (import "./process-helper.eli" buildProcessHelper buildCodexLoader buildCursorRestart)
  (defasync readJson (path) (JSON/parse (await (readFile path "utf8"))))

  (defasync collectPackageDigests (root folder records)
    (let ((entries (await (readdir folder (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index))
               (path (resolve folder (nativeGet entry "name"))))
          (cond
            ((js-call entry :isDirectory) (await (collectPackageDigests root path records)))
            ((js-call entry :isFile)
              (js-call records :push (str (relative root path) "\0" (sha256 (await (readFile path))) "\n")))
            (t (throw (new globalThis.Error "Eliscript package contains a non-regular artifact")))))
        (setq index (1+ index)))))

  (defasync bindCompiler ()
    (let* ((lock (await (readJson "config/toolchain.lock.json")))
           (bun (nativeGet lock "bun"))
           (compiler (nativeGet lock "compiler"))
           (root (await (realpath "node_modules/eliscript")))
           (metadata (await (readJson (resolve root "package.json"))))
           (records (js-array)))
      (unless (and (= (nativeGet metadata "name") (nativeGet compiler "package"))
                   (= (nativeGet metadata "version") (nativeGet compiler "version"))
                   (= (nativeGet NativeBun "version") (nativeGet bun "version"))
                   (= (nativeGet globalThis.process "platform") (nativeGet bun "platform"))
                   (= (nativeGet globalThis.process "arch") (nativeGet bun "arch")))
        (throw (new globalThis.Error "installed Eliscript or Bun identity does not match the toolchain lock")))
      (await (collectPackageDigests root root records))
      (let* ((digest (sha256 (js-call (js-call records :sort) :join "")))
             (receipt (sha256 (await (readFile (resolve root "dist/stage3-release.json")))))
             (artifact (sha256 (await (readFile (resolve root "dist/compiler-artifact.json"))))))
        (unless (and (= (js-length records) (nativeGet compiler "file_count"))
                     (= digest (nativeGet compiler "files_sha256"))
                     (= receipt (nativeGet compiler "stage3_sha256"))
                     (= artifact (nativeGet compiler "artifact_sha256")))
          (throw (new globalThis.Error "installed Eliscript files do not match the verified release")))
        (js-object :root root :entry (resolve root (nativeGet compiler "entry"))
          :package (nativeGet compiler "package") :version (nativeGet compiler "version")
          :source_commit (nativeGet compiler "source_commit") :package_files_sha256 digest
          :receipt_sha256 receipt :metadata_sha256 artifact))))
  (defasync buildEntries
    (&optional selection)
    (unless (or (undefined? selection) (= selection "all"))
      (throw
        (new
          globalThis.Error
          "the source-bound acceptance build requires all three entry groups")))
    (let*
      ((compiler (await (bindCompiler)))
        (sources (js-array))
        (input-paths (await (requiredBuildInputs)))
        (index 0)
        (configs
          (js-array "eliscript.json" "eliscript.tests.json" "eliscript.tools.json"))
        (outputs (js-array)))
      (while (< index (js-length input-paths))
        (let ((path (aref input-paths index)))
          (js-call
            sources
            :push
            (js-object :path path :sha256 (sha256 (await (readFile path))))))
        (setq index (1+ index)))
      ;; Invalidate the old receipt before replacing any owned build output.
      (await (mkdir ".local/build" (js-object :recursive t :mode 448)))
      (await (rm ".local/build/manifest.json" (js-object :force t)))
      (setq index 0)
      (while (< index (js-length configs))
        (let*
          ((name (aref configs index))
            (config (await (readJson name)))
            (directory (nativeGet config "outDir")))
          (unless
            (js-call (js-array "dist" "dist-tests" "dist-tools") :includes directory)
            (throw
              (new
                globalThis.Error
                "build output is outside the owned generated directories")))
          (await (rm directory (js-object :recursive t :force t)))
          (let*
            (
              (env
                (Object/assign
                  (js-object)
                  (nativeGet globalThis.process "env")
                  (js-object
                    :ELISCRIPT_JS_RUNTIME
                    (nativeGet globalThis.process "execPath")
                    :ELISCRIPT_BOOTSTRAP_MODULE_DIR
                    (resolve (nativeGet compiler "root") "dist/bootstrap"))))
              (child
                (Bun/spawn
                  (js-array (nativeGet globalThis.process "execPath") (nativeGet compiler "entry") "--json" "--config" name)
                  (js-object
                    :env
                    env
                    :stdin
                    "ignore"
                    :stdout
                    "inherit"
                    :stderr
                    "inherit"))))
            (unless (= (await (nativeGet child "exited")) 0)
              (throw (new globalThis.Error "Eliscript multi-entry build failed"))))
          (let ((collect nil))
            (setq
              collect
              (async
                (folder)
                (let
                  ((entries (await (readdir folder (js-object :withFileTypes t))))
                    (entry-index 0))
                  (while (< entry-index (js-length entries))
                    (let*
                      ((entry (aref entries entry-index))
                        (path (str folder "/" (nativeGet entry "name"))))
                      (cond
                        ((js-call entry :isSymbolicLink)
                          (throw
                            (new globalThis.Error "generated output contains a symlink")))
                        ((js-call entry :isDirectory) (await (collect path)))
                        ((js-call entry :isFile)
                          (js-call
                            outputs
                            :push
                            (js-object
                              :path
                              path
                              :sha256
                              (sha256 (await (readFile path))))))))
                    (setq entry-index (1+ entry-index))))))
            (await (collect directory))))
        (setq index (1+ index)))
      (js-call outputs :push (await (buildProcessHelper)))
      (js-call outputs :push (await (buildCodexLoader)))
      (js-call outputs :push (await (buildCursorRestart)))
      (setq index 0)
      (while (< index (js-length sources))
        (let ((row (aref sources index)))
          (unless (= (sha256 (await (readFile (nativeGet row "path")))) (nativeGet row "sha256"))
            (throw
              (new
                globalThis.Error
                "source changed during the build; no acceptance receipt emitted"))))
        (setq index (1+ index)))
      (Reflect/deleteProperty compiler "root")
      (Reflect/deleteProperty compiler "entry")
      (let
        (
          (manifest
            (js-object
              :schema_version
              1
              :sources
              sources
              :outputs
              outputs
              :compiler
              compiler
              :bun_version
              (nativeGet NativeBun "version")
              :built_at
              (js-call (new globalThis.Date) :toISOString))))
        (await
          (writeFile
            ".local/build/manifest.json.next"
            (str (JSON/stringify manifest nil 2) "\n")
            (js-object :mode 384)))
        (await (rename ".local/build/manifest.json.next" ".local/build/manifest.json"))
        manifest)))
  (when
    (and
      (nativeGet globalThis.process "argv")
      (js-call (nativeGet (nativeGet globalThis.process "argv") 1 "") :endsWith "/tools/build.mjs"))
    (funcall (async ()
(try
      (let ((args (js-call (nativeGet globalThis.process "argv") :slice 2)))
        (unless
          (or
            (= (js-length args) 0)
            (and (= (js-length args) 1) (= (aref args 0) "all"))
            (and
              (= (js-length args) 2)
              (= (aref args 0) "--scope")
              (= (aref args 1) "all")))
          (throw (new globalThis.Error "usage: build --scope all")))
        (await (buildEntries "all")))
      (catch error
        (js-call
          (nativeGet globalThis.process "stderr")
          :write
          (str "DJ build: " (nativeGet error "message") "\n"))
        (put globalThis.process :exitCode 1))))))
  (export bindCompiler buildEntries))
