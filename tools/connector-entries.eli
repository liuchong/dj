(module dj.tools.connector-entries
  (import "../src/core/native.eli" nativeGet)
  (import "node:fs/promises" mkdir writeFile readFile)
  (import "node:path" dirname)
  (import "./build-inputs.eli" sha256)
  ;; Host loader syntax only. The implementations are Eliscript modules.
  (defconst entries (Object/freeze (js-object
    :pi (js-object :format "esm" :module "../../dist/src/connectors/pi.mjs" :symbol "activatePiReceiver")
    :cursor (js-object :format "cjs" :module "./control.cjs" :symbol "activateCursorControl" :host "vscode"))))
  (defun connectorEntry (kind)
    (let ((entry (nativeGet entries kind)))
      (unless entry (throw (new globalThis.TypeError "unknown connector entry")))
      (let ((module (JSON/stringify (nativeGet entry "module"))) (symbol (nativeGet entry "symbol")))
        (str "// Generated by the DJ Eliscript build; no connector business logic.\n"
          (if (= (nativeGet entry "format") "esm")
            (str "import { " symbol " } from " module ";\nexport default function (host) { " symbol "(host); }\n")
            (str "exports.activate = async (context) => {\n  const { " symbol " } = require(" module ");\n  return " symbol "(require(" (JSON/stringify (nativeGet entry "host")) "), context);\n};\n"))))))
  (defasync writeConnectorEntry (kind output)
    (let ((source (connectorEntry kind)))
      (await (mkdir (dirname output) (js-object :recursive t :mode 448)))
      (await (writeFile output source (js-object :flag "wx" :mode 384)))
      (js-object :path output :sha256 (sha256 (await (readFile output))))))
  (export connectorEntry writeConnectorEntry))
