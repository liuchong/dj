(module dj.tools.runtime
  (import "../src/core/native.eli" nativeGet)
  (import "node:fs/promises" readdir readFile writeFile mkdir lstat)
  (import "node:path" resolve dirname)
  (import "./build-inputs.eli" sha256)

  ;; The language project's generated shim exposes only the default numeric
  ;; imports. DJ also emits literal/collection imports, so materialize the
  ;; fixed compiler's maintained runtime into each owned output graph.
  (defasync copyRuntimeModules (source destination files prefix)
    (let ((entries (await (readdir source (js-object :withFileTypes t)))) (index 0))
      (await (mkdir destination (js-object :recursive t :mode 448)))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (nativeGet entry "name"))
               (from (resolve source name)) (to (resolve destination name))
               (relative (str prefix "/" name)))
          (cond
            ((js-call entry :isSymbolicLink)
             (throw (new globalThis.Error "fixed runtime contains an unsupported link")))
            ((js-call entry :isDirectory)
             (await (copyRuntimeModules from to files relative)))
            ((and (js-call entry :isFile) (js-call name :endsWith ".mjs"))
             (let ((bytes (await (readFile from))))
               (await (writeFile to bytes (js-object :mode 384)))
               (js-call files :push (js-object :path relative :sha256 (sha256 bytes)))))))
        (setq index (1+ index)))))

  (defasync installFixedRuntime (compiler directory)
    (let* ((root (resolve directory "node_modules/eliscript")) (files (js-array)) (exports (js-object))
           (info (await (lstat root))))
      (unless (and (js-call info :isDirectory) (not (js-call info :isSymbolicLink)))
        (throw (new globalThis.Error "owned output runtime shim is not a directory")))
      (await (copyRuntimeModules (resolve (nativeGet compiler "root") "runtime") (resolve root "runtime") files "runtime"))
      (await (copyRuntimeModules (resolve (nativeGet compiler "root") "platform") (resolve root "platform") files "platform"))
      (js-call files :sort (lambda (left right) (js-call (nativeGet left "path") :localeCompare (nativeGet right "path"))))
      (put exports "./runtime/*" "./runtime/*.mjs")
      (put exports "./runtime/*.mjs" "./runtime/*.mjs")
      (put exports "./platform/*" "./platform/*.mjs")
      (put exports "./platform/*.mjs" "./platform/*.mjs")
      (await (writeFile (resolve root "package.json")
        (str (JSON/stringify (js-object :name "eliscript" :type "module" :private t
          :exports exports)) "\n")
        (js-object :mode 384)))
      (await (writeFile (resolve root "eliscript-runtime.json")
        (str (JSON/stringify (js-object :schema_version 1 :source_commit (nativeGet compiler "source_commit")
          :source_inputs_sha256 (nativeGet compiler "source_inputs_sha256") :compiler_receipt_sha256 (nativeGet compiler "receipt_sha256")
          :files files) nil 2) "\n") (js-object :mode 384)))
      (js-object :files (js-length files) :compiler_required_at_runtime false)))
  (export installFixedRuntime))
