(module dj.tools.resource-capture
  (import "../src/core/native.eli" NativeGlobal NativeBigInt nativeGet nativeTypeOf)
  (import "node:path" isAbsolute)
  (import "bun:ffi" dlopen ptr toArrayBuffer)
  (defun captureError (code &optional native-code)
    (let ((failure (new globalThis.Error code)))
      (when native-code (put failure :code native-code))
      (throw failure)))
  (defun plain (value)
    (and value (= (nativeTypeOf value) "object") (not (Array/isArray value))
      (or (= (Object/getPrototypeOf value) nil)
        (= (Object/getPrototypeOf value) (nativeGet (nativeGet NativeGlobal "Object") "prototype")))))
  (defun dense (items maximum)
    (and (Array/isArray items) (<= (js-length items) maximum)
      (let ((index 0) (valid t))
        (while (< index (js-length items))
          (unless (object-has? items index) (setq valid false))
          (setq index (1+ index))) valid)))
  (defun safePid (pid) (and (Number/isSafeInteger pid) (> pid 0) (<= pid 2147483647)))
  (defun birthString (value)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[1-9][0-9]{0,19}$") :test value)
      (or (< (js-length value) 20) (<= (js-call value :localeCompare "18446744073709551615") 0))))
  (defun identifier (value)
    (and (= (nativeTypeOf value) "string")
      (js-call (new globalThis.RegExp "^[A-Za-z0-9_.:-]{1,256}$") :test value)))
  (defun validateCaptureRequest (request)
    (let ((parameters (nativeGet request "parameters")))
      (unless (and (plain request) (= (nativeGet request "schema_version") 1)
        (= (nativeGet request "operation") "measure-owned-deployment")
        (identifier (nativeGet request "request_id")) (identifier (nativeGet request "run_id"))
        (plain parameters) (= (nativeGet parameters "run_id") (nativeGet request "run_id"))
        (= (nativeGet parameters "duration_ms") 60000) (= (nativeGet parameters "interval_ms") 100))
        (throw (new globalThis.TypeError "resource_capture_request_invalid")))
      (Object/freeze (js-object :schema_version 1 :operation "measure-owned-deployment"
        :request_id (nativeGet request "request_id") :run_id (nativeGet request "run_id")
        :parameters (Object/freeze (js-object :run_id (nativeGet request "run_id") :duration_ms 60000 :interval_ms 100))))))
  (defun validateCaptureBinding (binding)
    (unless (and (plain binding) (= (nativeGet binding "schema_version") 1)
      (= (nativeGet binding "authorized") t))
      (captureError "resource_capture_authorization_required"))
    (let ((roots (nativeGet binding "roots")) (normalized (js-array))
          (seen (new globalThis.Set)) (coverage (new globalThis.Set)))
      (unless (and (dense roots 16) (> (js-length roots) 0))
        (throw (new globalThis.TypeError "resource_capture_roots_invalid")))
      (js-call roots :forEach (lambda (root)
        (let ((pid (nativeGet root "pid")) (roles (nativeGet root "roles"))
              (category (nativeGet root "category")) (executable (nativeGet root "executable"))
              (role-seen (new globalThis.Set)))
          (unless (and (plain root) (safePid pid) (not (js-call seen :has pid))
            (birthString (nativeGet root "start_abstime"))
            (= (nativeTypeOf executable) "string") (> (js-length executable) 0)
            (<= (js-length executable) 4096) (isAbsolute executable)
            (js-call (js-array "dj" "external_agent") :includes category)
            (dense roles 3) (> (js-length roles) 0))
            (throw (new globalThis.TypeError "resource_capture_root_invalid")))
          (js-call roles :forEach (lambda (role)
            (unless (and (not (js-call role-seen :has role))
              (if (= category "dj") (js-call (js-array "dj" "lark_websocket" "mcp_proxy") :includes role)
                (= role "external_agent")))
              (throw (new globalThis.TypeError "resource_capture_role_invalid")))
            (js-call role-seen :add role) (js-call coverage :add role)))
          (js-call seen :add pid)
          (js-call normalized :push (Object/freeze (js-object :pid pid :start_abstime (nativeGet root "start_abstime")
            :executable executable :category category :roles (Object/freeze (js-call roles :slice))))))))
      (js-call (js-array "dj" "lark_websocket" "mcp_proxy" "external_agent") :forEach
        (lambda (role) (unless (js-call coverage :has role)
          (throw (new globalThis.TypeError "resource_capture_role_missing")))))
      (Object/freeze (js-object :schema_version 1 :authorized t :roots (Object/freeze normalized)))))
  (defun decodeNativeUsage (bytes)
    (unless (and bytes (= (nativeGet bytes "constructor") (nativeGet NativeGlobal "Uint8Array"))
      (= (nativeGet bytes "byteLength") 144))
      (throw (new globalThis.TypeError "resource_native_layout_invalid")))
    (let* ((view (new globalThis.DataView (nativeGet bytes "buffer") (nativeGet bytes "byteOffset") 144))
           (rss (Number/parseInt (js-call (js-call view :getBigUint64 64 t) :toString) 10))
           (physical (Number/parseInt (js-call (js-call view :getBigUint64 72 t) :toString) 10))
           (birth (js-call (js-call view :getBigUint64 80 t) :toString))
           (exit (js-call (js-call view :getBigUint64 88 t) :toString)))
      (unless (and (Number/isSafeInteger rss) (>= rss 0)
        (Number/isSafeInteger physical) (>= physical 0) (birthString birth))
        (throw (new globalThis.TypeError "resource_native_value_invalid")))
      (js-object :rss_bytes rss :physical_footprint_bytes physical :start_abstime birth :exit_abstime exit)))
  (defun openNativeProcessReader ()
    (unless (= (nativeGet globalThis.process "platform") "darwin")
      (captureError "resource_native_platform_unavailable"))
    (let* ((library (dlopen "libproc.dylib" (js-object
               :proc_pid_rusage (js-object :args (js-array "i32" "i32" "ptr") :returns "i32")
               :proc_pidinfo (js-object :args (js-array "i32" "i32" "u64" "ptr" "i32") :returns "i32")
               :proc_pidpath (js-object :args (js-array "i32" "ptr" "u32") :returns "i32")
               :proc_listchildpids (js-object :args (js-array "i32" "ptr" "i32") :returns "i32")
               :__error (js-object :args (js-array) :returns "ptr"))))
           (closed false) (result nil))
      (try
        (let* ((symbols (nativeGet library "symbols"))
               (errno-view (new globalThis.DataView (toArrayBuffer (js-call symbols :__error) 0 4)))
               (usage (new globalThis.Uint8Array 144)) (bsd (new globalThis.Uint8Array 136))
               (path (new globalThis.Uint8Array 4096)) (children (new globalThis.Int32Array 33))
               (assert-open (lambda (pid)
                 (when closed (captureError "resource_native_reader_closed"))
                 (unless (safePid pid) (throw (new globalThis.TypeError "resource_native_pid_invalid"))))))
          (setq result (js-object
            :read (lambda (pid)
              (funcall assert-open pid)
              (try
                (js-call errno-view :setInt32 0 0 t)
                (unless (= (js-call symbols :proc_pid_rusage pid 1 (ptr usage)) 0)
                  (captureError "resource_native_usage_unavailable"
                    (if (= (js-call errno-view :getInt32 0 t) 3) "ESRCH" nil)))
                (let ((first (decodeNativeUsage usage)))
                  (if (not (= (nativeGet first "exit_abstime") "0")) nil
                    (progn
                      (js-call errno-view :setInt32 0 0 t)
                      (unless (= (js-call symbols :proc_pidinfo pid 3 (NativeBigInt "0") (ptr bsd) 136) 136)
                        (captureError "resource_native_identity_unavailable"
                          (if (= (js-call errno-view :getInt32 0 t) 3) "ESRCH" nil)))
                      (js-call path :fill 0)
                      (js-call errno-view :setInt32 0 0 t)
                      (unless (> (js-call symbols :proc_pidpath pid (ptr path) 4096) 0)
                        (captureError "resource_native_path_unavailable"
                          (if (= (js-call errno-view :getInt32 0 t) 3) "ESRCH" nil)))
                      (js-call errno-view :setInt32 0 0 t)
                      (unless (= (js-call symbols :proc_pid_rusage pid 1 (ptr usage)) 0)
                        (captureError "resource_native_identity_unavailable"
                          (if (= (js-call errno-view :getInt32 0 t) 3) "ESRCH" nil)))
                      (let* ((last (decodeNativeUsage usage))
                             (info (new globalThis.DataView (nativeGet bsd "buffer")))
                             (end (js-call path :indexOf 0)))
                        (when (or (not (= (nativeGet first "start_abstime") (nativeGet last "start_abstime")))
                          (not (= (nativeGet last "exit_abstime") "0")))
                          (captureError "resource_native_identity_departed" "ESRCH"))
                        (unless (and (= (js-call info :getUint32 12 t) pid) (> end 0))
                          (captureError "resource_native_identity_changed"))
                        (Object/assign first (js-object :pid pid :ppid (js-call info :getUint32 16 t)
                          :uid (js-call info :getUint32 20 t)
                          :executable (js-call (new globalThis.TextDecoder) :decode (js-call path :subarray 0 end))))))))
                (catch failure
                  ;; A proven departure is nil at every syscall stage; callers
                  ;; still decide whether the departed identity was a fatal root.
                  (if (= (nativeGet failure "code") "ESRCH") nil (throw failure)))))
            :children (lambda (pid)
              (funcall assert-open pid)
              (js-call errno-view :setInt32 0 0 t)
              (let ((count (js-call symbols :proc_listchildpids pid (ptr children) 132)) (rows (js-array)) (i 0))
                (when (or (< count 0) (and (= count 0) (not (= (js-call errno-view :getInt32 0 t) 0))))
                  (captureError "resource_native_children_unavailable"
                    (if (= (js-call errno-view :getInt32 0 t) 3) "ESRCH" nil)))
                (when (>= count 33) (captureError "resource_native_children_truncated"))
                (while (< i count)
                  (let ((child (aref children i)))
                    (unless (safePid child) (captureError "resource_native_child_invalid"))
                    (js-call rows :push child))
                  (setq i (1+ i))) rows))
            :close (lambda () (unless closed (setq closed t) (js-call library :close)))))
          result)
        (catch failure
          (unless closed (setq closed t) (js-call library :close))
          (throw failure)))))
  (defun checkedProcess (row pid uid)
    (unless (and (plain row) (= (nativeGet row "pid") pid)
      (= (nativeGet row "uid") uid) (Number/isSafeInteger uid) (>= uid 0)
      (Number/isSafeInteger (nativeGet row "ppid")) (>= (nativeGet row "ppid") 0)
      (birthString (nativeGet row "start_abstime")) (= (nativeGet row "exit_abstime") "0")
      (= (nativeTypeOf (nativeGet row "executable")) "string") (isAbsolute (nativeGet row "executable"))
      (Number/isSafeInteger (nativeGet row "rss_bytes")) (>= (nativeGet row "rss_bytes") 0)
      (Number/isSafeInteger (nativeGet row "physical_footprint_bytes")) (>= (nativeGet row "physical_footprint_bytes") 0))
      (captureError "resource_capture_process_unverified")) row)
  (defun collectOwnedSample (registry reader uid)
    (let ((current (new globalThis.Map)) (queue (js-array)) (index 0) (rows (js-array)))
      (js-call registry :forEach (lambda (meta pid)
        (let ((row (js-call reader :read pid)))
          (if (or (not row) (not (= (nativeGet row "start_abstime") (nativeGet meta "start_abstime"))))
            (if (nativeGet meta "root") (captureError "resource_capture_root_changed") (js-call registry :delete pid))
            (progn
              (checkedProcess row pid uid)
              (when (and (nativeGet meta "root") (not (= (nativeGet row "executable") (nativeGet meta "executable"))))
                (captureError "resource_capture_root_changed"))
              (js-call current :set pid row) (js-call queue :push pid))))))
      (while (< index (js-length queue))
        (let* ((pid (aref queue index)) (parent (js-call current :get pid))
               (meta (js-call registry :get pid)) (children nil) (children-error nil) (after nil))
          (try (setq children (js-call reader :children pid))
            (catch failure
              ;; Only an explicit ESRCH may be reconciled by a second identity read.
              ;; Permissions, truncation, and unknown native errors remain fatal.
              (if (= (nativeGet failure "code") "ESRCH") (setq children-error failure) (throw failure))))
          (unless (or children-error (dense children 32))
            (captureError "resource_capture_children_truncated"))
          (setq after (js-call reader :read pid))
          (if (or (not after) (not (= (nativeGet after "start_abstime") (nativeGet parent "start_abstime"))))
            (if (nativeGet meta "root") (captureError "resource_capture_root_changed")
              (progn
                ;; Remove this departed identity only; registered descendants are
                ;; independently checked in this queue even after reparenting.
                (js-call registry :delete pid) (js-call current :delete pid)))
            (progn
              (checkedProcess after pid uid)
              (when (and (nativeGet meta "root") (not (= (nativeGet after "executable") (nativeGet meta "executable"))))
                (captureError "resource_capture_root_changed"))
              (when children-error (throw children-error))
              (js-call children :forEach (lambda (child)
                (unless (and (safePid child) (not (= child pid))) (captureError "resource_capture_child_invalid"))
                (let* ((existing (js-call registry :get child))
                       (row (or (js-call current :get child) (js-call reader :read child))))
                  (when row
                    (checkedProcess row child uid)
                    (unless (= (nativeGet row "ppid") pid) (captureError "resource_capture_ancestry_changed"))
                    (if existing
                      (unless (or (nativeGet existing "root")
                        (= (nativeGet existing "category") (nativeGet meta "category")))
                        (captureError "resource_capture_category_conflict"))
                      (js-call registry :set child (js-object :root false :pid child
                        :start_abstime (nativeGet row "start_abstime") :executable (nativeGet row "executable")
                        :category (nativeGet meta "category") :roles (js-array))))
                    (unless (js-call current :has child)
                      (js-call current :set child row) (js-call queue :push child))
                    (when (> (nativeGet current "size") 32) (captureError "resource_capture_process_limit"))))))))
        (setq index (1+ index))))
      (js-call current :forEach (lambda (row pid)
        (let ((meta (js-call registry :get pid)))
          (js-call rows :push (js-object :pid pid :start_abstime (nativeGet row "start_abstime")
            :category (nativeGet meta "category") :roles (nativeGet meta "roles") :ownership_verified t
            :physical_footprint_bytes (nativeGet row "physical_footprint_bytes") :rss_bytes (nativeGet row "rss_bytes"))))))
      (js-call rows :sort (lambda (a b) (- (nativeGet a "pid") (nativeGet b "pid")))) rows))
  (defasync captureOwnedDeployment (binding runtime)
    (let* ((normalized (validateCaptureBinding binding)) (reader (nativeGet runtime "reader"))
           (now (nativeGet runtime "now")) (sleep (nativeGet runtime "sleep")) (uid (nativeGet runtime "uid"))
           (registry (new globalThis.Map)) (samples (js-array)) (index 0) (previous nil))
      (unless (and (= (nativeTypeOf now) "function") (= (nativeTypeOf sleep) "function")
        (= (nativeTypeOf (nativeGet reader "read")) "function") (= (nativeTypeOf (nativeGet reader "children")) "function")
        (Number/isSafeInteger uid) (>= uid 0) (identifier (nativeGet runtime "capture_id")))
        (throw (new globalThis.TypeError "resource_capture_runtime_invalid")))
      (js-call (nativeGet normalized "roots") :forEach (lambda (root)
        (js-call registry :set (nativeGet root "pid") (Object/assign (js-object :root t) root))))
      (let ((origin (funcall now)) (done false))
        (unless (and (Number/isFinite origin) (>= origin 0)) (captureError "resource_capture_clock_invalid"))
        (while (not done)
          (when (>= index 602) (captureError "resource_capture_sample_limit"))
          (let ((target (+ origin (* index 100))) (at (if (= index 0) origin (funcall now))) (waits 0))
            (while (< at target)
              (when (>= waits 1024) (captureError "resource_capture_clock_stalled"))
              (await (funcall sleep (- target at)))
              (setq at (funcall now) waits (1+ waits))
              (unless (and (Number/isFinite at) (>= at origin)) (captureError "resource_capture_clock_invalid")))
            (setq at (- at origin))
            (unless (and (Number/isFinite at) (>= at 0)
              (if (= previous nil) (= at 0) (and (> at previous) (<= (- at previous) 200))))
              (captureError "resource_capture_clock_gap"))
            (js-call samples :push (js-object :elapsed_ms at :processes (collectOwnedSample registry reader uid)))
            (setq previous at done (>= at 60000) index (1+ index))))
        (js-object :measurement_source "proc_pid_rusage" :complete t :native_capture_id (nativeGet runtime "capture_id")
          :duration_ms previous :interval_ms 100 :samples samples))))
  (export validateCaptureRequest validateCaptureBinding decodeNativeUsage captureOwnedDeployment openNativeProcessReader))
