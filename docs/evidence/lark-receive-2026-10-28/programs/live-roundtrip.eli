(module dj.private.live-roundtrip
  (import "node:fs/promises" readFile writeFile)
  (import "node:child_process" execFileSync)
  (import "node:path" join)
  (import "bun:sqlite" Database)
  (defconst host (js* "globalThis"))
  (defun field (object key) (js* "object == null ? undefined : object[key]"))
  (defconst main (async ()
    (let* ((home (field (field globalThis.process "env") "HOME"))
           (root (join home ".dj")) (directory (field (field globalThis.process "argv") 2))
           (runtime (join root "runtime/bun-1.4.4/bin/bun"))
           (cli (join root "current/dist/src/interfaces/cli.mjs"))
           (db (new Database (join root "state/dj.sqlite") (js-object :readonly t)))
           (group-mode (= (field (field globalThis.process "argv") 3) "group"))
           (marker (if group-mode "DJ-WS-LIVE-20261028-B1" "DJ-WS-LIVE-20261028-A1"))
           (start (Date/now))
           (maximum (field (js-call (js-call db :query "SELECT COALESCE(MAX(ingress_seq),0) AS n FROM events") :get) "n"))
           (seen (new globalThis.Set)) (call nil) (save nil)
           (report (js-object :marker marker :started_at (js-call (new globalThis.Date start) :toISOString)
             :transport "existing production WebSockets; no extra consumer"
             :history_recovery false :subscription_replay false :sent (js-array)
             :received (js-array) :observed (js-array) :probes (js-array))))
      (setq call (lambda (operation arguments)
        (JSON/parse (execFileSync runtime
          (js-call (js-array cli) :concat (js-call operation :split ".") (js-array "--input" "-" "--json"))
          (js-object :input (JSON/stringify arguments) :encoding "utf8" :timeout 30000 :maxBuffer 1048576)))))
      (setq save (async ()
        (await (writeFile (join directory "live-results.private.json")
          (str (JSON/stringify report nil 2) "\n") (js-object :mode 384)))))
      (try
        (js-call (js-array "lark-user-b" "lark-bot-a") :forEach (lambda (id)
          (let ((result (funcall call "connection.probe" (js-object :connection_id id))))
            (js-call (field report "probes") :push (js-object :phase "before" :connection_id id :result result)))))
        (let ((ids (if group-mode (js-array "lark-user-b") (js-array "lark-user-b" "lark-bot-a"))) (position 0))
        (while (< position (js-length ids))
          (let* ((id (aref ids position))
                 (target (JSON/parse (await (readFile (join directory (str id (if group-mode "-group.private.json" "-dm.private.json"))) "utf8"))))
                 (direction (if group-mode "调试群双连接接收对照" (if (= id "lark-user-b") "本人→机器人" "机器人→本人")))
                 (message (str "🤖 DJ 实时收件验证 [" marker "] " direction "。仅核对传输，无需回复或执行任务。"))
                 (request (js-object :destination_ref (field (field target "data") "conversation_ref")
                   :content (js-object :type "text" :text message)
                   :idempotency_key (str marker ":" id)))
                 (result (funcall call "message.send" request)))
            (js-call (field report "sent") :push (js-object :connection_id id :direction direction :result result))
            (await (funcall save))
            (js-call globalThis.console :log (JSON/stringify
              (js-object :phase "send" :connection id :ok (field result "ok") :data (field result "data")))))
          (setq position (1+ position))))
        (let ((turn 0))
          (while (< (- (Date/now) start) (if group-mode 65000 125000))
            (let ((rows (js-call (js-call db :query
              "SELECT event_id,connection_id,native_message_id,received_at,payload FROM events WHERE ingress_seq>? ORDER BY ingress_seq LIMIT 256") :all maximum)))
              (js-call rows :forEach (lambda (row)
                (unless (js-call seen :has (field row "event_id"))
                  (js-call seen :add (field row "event_id"))
                  (let* ((event (JSON/parse (field row "payload")))
                         (text (or (field (field event "content") "text") ""))
                         (match (js-call text :includes marker))
                         (summary (js-object :event_id (field row "event_id")
                           :connection_id (field row "connection_id")
                           :native_message_id (field row "native_message_id")
                           :received_at (field row "received_at") :source_time (field event "source_time")
                           :sender_kind (field (field event "sender") "kind")
                           :conversation (field event "conversation") :test_marker_matches match)))
                    (js-call (field report "observed") :push summary)
                    (when match
                      (js-call (field report "received") :push summary)
                      (js-call globalThis.console :log (JSON/stringify (js-object :phase "received" :event summary)))))))))
            (when (= (% turn 20) 0)
              (await (funcall save))
              (js-call globalThis.console :log (JSON/stringify (js-object :phase "monitor"
                :seconds (Math/floor (/ (- (Date/now) start) 1000))
                :test_events (js-length (field report "received")) :all_new_events (js-length (field report "observed"))))))
            (setq turn (1+ turn))
            (await (new globalThis.Promise (lambda (resolve) (js-call host :setTimeout resolve 1000))))))
        (js-call (field report "sent") :forEach (lambda (sent)
          (let ((id (field (field (field sent "result") "data") "outbound_id")))
            (when id (put sent :final_outbound (funcall call "outbound.get" (js-object :outbound_id id)))))))
        (js-call (js-array "lark-user-b" "lark-bot-a") :forEach (lambda (id)
          (js-call (field report "probes") :push (js-object :phase "after" :connection_id id
            :result (funcall call "connection.probe" (js-object :connection_id id))))))
        (put report :finished_at (js-call (new globalThis.Date) :toISOString))
        (await (funcall save))
        (js-call globalThis.console :log (JSON/stringify (js-object :phase "finished"
          :test_events (js-length (field report "received")) :all_new_events (js-length (field report "observed")))))
        (finally (js-call db :close))))))
  (funcall main))
